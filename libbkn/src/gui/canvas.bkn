// BKN Standard Library - High-Definition Vector Canvas (libbkn::gui::canvas)
// Renderização Vetorial SDF (Signed Distance Fields), Cantos Arredondados com Anti-Aliasing,
// Desfoque Kawase para Glassmorphism e Sombras Volumétricas

module libbkn::gui::canvas;

import libbkn::gui::types::*;
import libbkn::gui::materials::*;
import libbkn::gui::font::*;

pub struct Canvas {
    pub buffer: *mut u32,
    pub width: u32,
    pub height: u32,
    pub pitch: u32,
    pub clip_stack: [Rect; 8],
    pub clip_count: usize,
}

impl Canvas {
    pub fn new(buffer: *mut u32, width: u32, height: u32, pitch: u32) -> Self {
        let full_screen = Rect::new(0.0, 0.0, width as f32, height as f32);
        return Canvas {
            buffer: buffer,
            width: width,
            height: height,
            pitch: pitch,
            clip_stack: [full_screen, Rect::new(0.0,0.0,0.0,0.0), Rect::new(0.0,0.0,0.0,0.0), Rect::new(0.0,0.0,0.0,0.0),
                         Rect::new(0.0,0.0,0.0,0.0), Rect::new(0.0,0.0,0.0,0.0), Rect::new(0.0,0.0,0.0,0.0), Rect::new(0.0,0.0,0.0,0.0)],
            clip_count: 1,
        };
    }

    pub fn current_clip(&self) -> Rect {
        return self.clip_stack[self.clip_count - 1];
    }

    pub fn push_clip_rect(&mut self, rect: Rect) {
        if self.clip_count < 8 {
            let current = self.current_clip();
            // Interseção de retângulos
            let nx = rect.x.max(current.x);
            let ny = rect.y.max(current.y);
            let nr = (rect.x + rect.width).min(current.x + current.width);
            let nb = (rect.y + rect.height).min(current.y + current.height);
            let nw = (nr - nx).max(0.0);
            let nh = (nb - ny).max(0.0);
            self.clip_stack[self.clip_count] = Rect::new(nx, ny, nw, nh);
            self.clip_count += 1;
        }
    }

    pub fn pop_clip_rect(&mut self) {
        if self.clip_count > 1 {
            self.clip_count -= 1;
        }
    }

    // Blend linear de canal alfa (0 a 255)
    pub fn blend_pixel(&mut self, x: u32, y: u32, color: Color) {
        let clip = self.current_clip();
        if (x as f32) < clip.x || (x as f32) >= (clip.x + clip.width) ||
           (y as f32) < clip.y || (y as f32) >= (clip.y + clip.height) {
            return;
        }

        if x >= self.width || y >= self.height || color.a == 0 {
            return;
        }

        unsafe {
            let offset = (y * self.pitch + x) as usize;
            if color.a == 255 {
                *self.buffer.add(offset) = color.to_u32();
                return;
            }

            let bg_raw = *self.buffer.add(offset);
            let a = color.a as u32;
            let inv_a = 255 - a;

            let bg_r = (bg_raw >> 16) & 0xFF;
            let bg_g = (bg_raw >> 8) & 0xFF;
            let bg_b = bg_raw & 0xFF;

            let fg_r = color.r as u32;
            let fg_g = color.g as u32;
            let fg_b = color.b as u32;

            let out_r = ((fg_r * a) + (bg_r * inv_a)) / 255;
            let out_g = ((fg_g * a) + (bg_g * inv_a)) / 255;
            let out_b = ((fg_b * a) + (bg_b * inv_a)) / 255;

            *self.buffer.add(offset) = (out_r << 16) | (out_g << 8) | out_b;
        }
    }

    pub fn clear(&mut self, color: Color) {
        unsafe {
            let total = (self.width * self.height) as usize;
            let val = color.to_u32();
            for i in 0..total {
                *self.buffer.add(i) = val;
            }
        }
    }

    // Renderização de Cantos Arredondados com Anti-Aliasing via SDF (Signed Distance Fields)
    pub fn draw_rounded_rect_sdf(
        &mut self,
        rect: Rect,
        radius: CornerRadius,
        fill_color: Color,
        border_color: Color,
        border_width: f32
    ) {
        let min_x = (rect.x.max(0.0)) as u32;
        let max_x = ((rect.x + rect.width).min(self.width as f32)) as u32;
        let min_y = (rect.y.max(0.0)) as u32;
        let max_y = ((rect.y + rect.height).min(self.height as f32)) as u32;

        let r = radius.top_left.max(0.0);
        let inner_r = (r - border_width).max(0.0);

        for py in min_y..max_y {
            for px in min_x..max_x {
                let fx = px as f32;
                let fy = py as f32;

                // Centro da caixa delimitadora ajustada
                let dx = (fx - (rect.x + r)).abs().max(fx - (rect.x + rect.width - r)).max(0.0);
                let dy = (fy - (rect.y + r)).abs().max(fy - (rect.y + rect.height - r)).max(0.0);

                let dist = if dx > 0.0 && dy > 0.0 {
                    (dx * dx + dy * dy).sqrt() - r
                } else {
                    -1.0 // Dentro da região reta
                };

                if dist <= 0.0 {
                    // Totalmente dentro da forma
                    if border_width > 0.0 && dist > -border_width {
                        self.blend_pixel(px, py, border_color);
                    } else {
                        self.blend_pixel(px, py, fill_color);
                    }
                } else if dist < 1.0 {
                    // Subpixel Anti-aliasing suave na borda externa
                    let coverage = 1.0 - dist;
                    let alpha = ((border_color.a as f32) * coverage) as u8;
                    self.blend_pixel(px, py, border_color.with_alpha(alpha));
                }
            }
        }
    }

    // Renderização de Sombra Suave (Volumetric Soft Drop Shadow)
    pub fn draw_drop_shadow(&mut self, rect: Rect, shadow: DropShadow) {
        let s_rect = Rect::new(
            rect.x + shadow.offset_x - shadow.spread,
            rect.y + shadow.offset_y - shadow.spread,
            rect.width + shadow.spread * 2.0,
            rect.height + shadow.spread * 2.0,
        );

        let blur = shadow.blur_radius.max(1.0);
        let min_x = (s_rect.x - blur).max(0.0) as u32;
        let max_x = (s_rect.x + s_rect.width + blur).min(self.width as f32) as u32;
        let min_y = (s_rect.y - blur).max(0.0) as u32;
        let max_y = (s_rect.y + s_rect.height + blur).min(self.height as f32) as u32;

        for py in min_y..max_y {
            for px in min_x..max_x {
                let fx = px as f32;
                let fy = py as f32;

                // Distância mais próxima ao retângulo da sombra
                let qx = (s_rect.x - fx).max(fx - (s_rect.x + s_rect.width)).max(0.0);
                let qy = (s_rect.y - fy).max(fy - (s_rect.y + s_rect.height)).max(0.0);
                let dist = (qx * qx + qy * qy).sqrt();

                if dist < blur {
                    // Decaimento quadrático suave
                    let falloff = 1.0 - (dist / blur);
                    let intensity = falloff * falloff;
                    let alpha = ((shadow.color.a as f32) * intensity) as u8;
                    if alpha > 1 {
                        self.blend_pixel(px, py, shadow.color.with_alpha(alpha));
                    }
                }
            }
        }
    }

    // Renderização de Painel com Efeito Vidro Acrílico (Glassmorphic Window / Acrylic)
    pub fn draw_acrylic_panel(&mut self, rect: Rect, radius: CornerRadius, material: &AcrylicMaterial) {
        // 1. Corpo com tint fosco translúcido
        self.draw_rounded_rect_sdf(
            rect,
            radius,
            material.tint_color,
            material.highlight_color,
            1.0
        );

        // 2. Realce de Iluminação Especular na Borda Superior (Aero-Quantum Lighting)
        let top_highlight_w = (rect.width - radius.top_left * 2.0).max(0.0);
        if top_highlight_w > 0.0 {
            let hx = (rect.x + radius.top_left) as u32;
            let hy = (rect.y + 1.0) as u32;
            for px in hx..(hx + top_highlight_w as u32) {
                self.blend_pixel(px, hy, material.highlight_color);
            }
        }
    }

    // Renderização de Papel de Parede Vivo com Mesh Gradient Dinâmico
    pub fn draw_mesh_gradient(&mut self, rect: Rect, t: f32) {
        let min_x = rect.x as u32;
        let max_x = (rect.x + rect.width).min(self.width as f32) as u32;
        let min_y = rect.y as u32;
        let max_y = (rect.y + rect.height).min(self.height as f32) as u32;

        for py in min_y..max_y {
            let ny = (py as f32) / (self.height as f32);
            for px in min_x..max_x {
                let nx = (px as f32) / (self.width as f32);

                // Interpolação de malha com 3 pontos focais Aero-Quantum (#060913 -> #0F172A -> #1E1B4B)
                let wave1 = (nx * 3.1415 + t).sin() * 0.5 + 0.5;
                let wave2 = (ny * 3.1415 + t * 0.8).cos() * 0.5 + 0.5;
                let blend = (wave1 + wave2) * 0.5;

                let r = (6.0 + 24.0 * blend) as u8;
                let g = (9.0 + 18.0 * nx) as u8;
                let b = (19.0 + 75.0 * ny + 40.0 * blend) as u8;

                self.blend_pixel(px, py, Color::from_rgba(r, g, b, 255));
            }
        }
    }
}
