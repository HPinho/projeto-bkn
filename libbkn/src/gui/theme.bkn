// BKN Standard Library - Design Tokens & Theme Engine (libbkn::gui::theme)
// Sistema de Temas Dinâmicos, Paletas de Cores Aero-Quantum e Tokens de Interface

module libbkn::gui::theme;

import libbkn::gui::types::*;
import libbkn::gui::font::*;

pub struct ThemeColors {
    pub background: Color,
    pub surface: Color,
    pub surface_hover: Color,
    pub surface_pressed: Color,
    pub accent: Color,
    pub accent_hover: Color,
    pub text_primary: Color,
    pub text_secondary: Color,
    pub border: Color,
    pub border_highlight: Color,
    pub glow: Color,
    pub error: Color,
    pub success: Color,
}

pub struct ThemeFonts {
    pub body: Font,
    pub title: Font,
    pub code: Font,
}

pub struct Theme {
    pub is_dark: bool,
    pub colors: ThemeColors,
    pub fonts: ThemeFonts,
    pub default_corner_radius: f32,
    pub animations_enabled: bool,
}

impl Theme {
    pub fn quantum_dark() -> Self {
        return Theme {
            is_dark: true,
            colors: ThemeColors {
                background: Color::from_hex(0x060913),
                surface: Color::from_rgba(15, 23, 42, 225),
                surface_hover: Color::from_rgba(30, 41, 59, 240),
                surface_pressed: Color::from_rgba(51, 65, 85, 255),
                accent: Color::from_hex(0x00E5FF),          // Ciano Elétrico
                accent_hover: Color::from_hex(0x38BDF8),    // Sky Blue
                text_primary: Color::from_rgba(248, 250, 252, 255),
                text_secondary: Color::from_rgba(148, 163, 184, 255),
                border: Color::from_rgba(99, 102, 241, 100), // Índigo translúcido
                border_highlight: Color::from_rgba(0, 229, 255, 160),
                glow: Color::from_rgba(0, 229, 255, 120),
                error: Color::from_hex(0xEF4444),
                success: Color::from_hex(0x10B981),
            },
            fonts: ThemeFonts {
                body: Font::default_body(),
                title: Font::default_title(),
                code: Font::default_code(),
            },
            default_corner_radius: 10.0,
            animations_enabled: true,
        };
    }

    pub fn light() -> Self {
        return Theme {
            is_dark: false,
            colors: ThemeColors {
                background: Color::from_hex(0xF1F5F9),
                surface: Color::from_rgba(255, 255, 255, 230),
                surface_hover: Color::from_rgba(241, 245, 249, 255),
                surface_pressed: Color::from_rgba(226, 232, 240, 255),
                accent: Color::from_hex(0x2563EB),
                accent_hover: Color::from_hex(0x1D4ED8),
                text_primary: Color::from_rgba(15, 23, 42, 255),
                text_secondary: Color::from_rgba(71, 85, 105, 255),
                border: Color::from_rgba(203, 213, 225, 200),
                border_highlight: Color::from_rgba(37, 99, 235, 140),
                glow: Color::from_rgba(37, 99, 235, 80),
                error: Color::from_hex(0xDC2626),
                success: Color::from_hex(0x059669),
            },
            fonts: ThemeFonts {
                body: Font::default_body(),
                title: Font::default_title(),
                code: Font::default_code(),
            },
            default_corner_radius: 8.0,
            animations_enabled: true,
        };
    }
}
