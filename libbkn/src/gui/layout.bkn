// BKN Standard Library - Responsive Layout Engine (libbkn::gui::layout)
// Algoritmo de Duas Passadas (Measure / Arrange), FlexBox, StackPanel e Grid Proporcional

module libbkn::gui::layout;

import libbkn::gui::types::*;

pub struct BoxConstraints {
    pub min_width: f32,
    pub max_width: f32,
    pub min_height: f32,
    pub max_height: f32,
}

impl BoxConstraints {
    pub fn tight(size: Size) -> Self {
        return BoxConstraints {
            min_width: size.width,
            max_width: size.width,
            min_height: size.height,
            max_height: size.height,
        };
    }

    pub fn loose(size: Size) -> Self {
        return BoxConstraints {
            min_width: 0.0,
            max_width: size.width,
            min_height: 0.0,
            max_height: size.height,
        };
    }

    pub fn constrain(&self, size: Size) -> Size {
        return Size {
            width: size.width.clamp(self.min_width, self.max_width),
            height: size.height.clamp(self.min_height, self.max_height),
        };
    }
}

pub enum GridLengthType {
    Fixed,
    Star,
    Auto,
}

pub struct GridLength {
    pub length_type: GridLengthType,
    pub value: f32,
}

impl GridLength {
    pub fn fixed(px: f32) -> Self {
        return GridLength { length_type: GridLengthType::Fixed, value: px };
    }

    pub fn star(weight: f32) -> Self {
        return GridLength { length_type: GridLengthType::Star, value: weight };
    }

    pub fn auto() -> Self {
        return GridLength { length_type: GridLengthType::Auto, value: 0.0 };
    }
}

pub struct StackLayout {
    pub orientation: Orientation,
    pub spacing: f32,
    pub padding: Thickness,
    pub alignment: Alignment,
}

impl StackLayout {
    pub fn vertical(spacing: f32) -> Self {
        return StackLayout {
            orientation: Orientation::Vertical,
            spacing: spacing,
            padding: Thickness::all(0.0),
            alignment: Alignment::Stretch,
        };
    }

    pub fn horizontal(spacing: f32) -> Self {
        return StackLayout {
            orientation: Orientation::Horizontal,
            spacing: spacing,
            padding: Thickness::all(0.0),
            alignment: Alignment::Center,
        };
    }
}

pub struct GridLayoutSolver {
    pub column_count: usize,
    pub row_count: usize,
    pub columns: [GridLength; 8],
    pub rows: [GridLength; 8],
}

impl GridLayoutSolver {
    pub fn new() -> Self {
        return GridLayoutSolver {
            column_count: 0,
            row_count: 0,
            columns: [GridLength::auto(), GridLength::auto(), GridLength::auto(), GridLength::auto(),
                      GridLength::auto(), GridLength::auto(), GridLength::auto(), GridLength::auto()],
            rows: [GridLength::auto(), GridLength::auto(), GridLength::auto(), GridLength::auto(),
                   GridLength::auto(), GridLength::auto(), GridLength::auto(), GridLength::auto()],
        };
    }

    pub fn add_column(&mut self, length: GridLength) {
        if self.column_count < 8 {
            self.columns[self.column_count] = length;
            self.column_count += 1;
        }
    }

    pub fn add_row(&mut self, length: GridLength) {
        if self.row_count < 8 {
            self.rows[self.row_count] = length;
            self.row_count += 1;
        }
    }

    pub fn calculate_column_offsets(&self, total_width: f32, out_widths: &mut [f32; 8], out_x: &mut [f32; 8]) {
        let mut fixed_sum: f32 = 0.0;
        let mut total_stars: f32 = 0.0;

        for i in 0..self.column_count {
            match self.columns[i].length_type {
                GridLengthType::Fixed => { fixed_sum += self.columns[i].value; },
                GridLengthType::Star => { total_stars += self.columns[i].value; },
                GridLengthType::Auto => { fixed_sum += 50.0; }, // Estimativa base
            }
        }

        let remaining_w = (total_width - fixed_sum).max(0.0);
        let star_unit = if total_stars > 0.0 { remaining_w / total_stars } else { 0.0 };

        let mut current_x: f32 = 0.0;
        for i in 0..self.column_count {
            let col_w = match self.columns[i].length_type {
                GridLengthType::Fixed => self.columns[i].value,
                GridLengthType::Star => self.columns[i].value * star_unit,
                GridLengthType::Auto => 50.0,
            };
            out_widths[i] = col_w;
            out_x[i] = current_x;
            current_x += col_w;
        }
    }
}
