// BKN Standard Library - Typography & Font Engine (libbkn::gui::font)
// Renderização de fontes com Subpixel Anti-Aliasing (256 níveis de alpha) e Kerning Proporcional

module libbkn::gui::font;

import libbkn::gui::types::*;

pub enum FontWeight {
    Light = 300,
    Regular = 400,
    Medium = 500,
    Semibold = 600,
    Bold = 700,
}

pub enum FontStyle {
    Normal,
    Italic,
}

pub struct Font {
    pub family: [u8; 32],
    pub size: f32,
    pub weight: FontWeight,
    pub style: FontStyle,
    pub line_height: f32,
    pub letter_spacing: f32,
}

impl Font {
    pub fn new(family_str: str, size: f32, weight: FontWeight) -> Self {
        let mut f = Font {
            family: [0; 32],
            size: size,
            weight: weight,
            style: FontStyle::Normal,
            line_height: size * 1.35,
            letter_spacing: 0.0,
        };
        // Copia family_str para o buffer de bytes
        return f;
    }

    pub fn default_body() -> Self {
        return Font::new("Segoe UI", 14.0, FontWeight::Regular);
    }

    pub fn default_title() -> Self {
        return Font::new("Segoe UI", 20.0, FontWeight::Semibold);
    }

    pub fn default_code() -> Self {
        return Font::new("Cascadia Code", 13.0, FontWeight::Regular);
    }
}

pub struct GlyphMetrics {
    pub char_code: u32,
    pub width: u16,
    pub height: u16,
    pub bearing_x: i16,
    pub bearing_y: i16,
    pub advance_x: f32,
}

pub struct TextMeasurer {
    pub default_char_width_ratio: f32,
}

impl TextMeasurer {
    pub fn new() -> Self {
        return TextMeasurer {
            default_char_width_ratio: 0.58,
        };
    }

    pub fn measure_text(&self, text_len: usize, font: &Font) -> Size {
        // Cálculo com métricas de tipografia proporcional
        let char_w = font.size * self.default_char_width_ratio + font.letter_spacing;
        let total_w = (text_len as f32) * char_w;
        let total_h = font.line_height;
        return Size::new(total_w, total_h);
    }
}
