// BKN Standard Library - Multiplatform Graphics Backend Abstraction (libbkn::gui::backend)
// Abstração de Hardware: Bare-Metal Framebuffer para Baken OS e FFI SDL2/OpenGL para Windows/Linux

module libbkn::gui::backend;

import libbkn::gui::types::*;
import libbkn::gui::events::*;

pub enum BackendKind {
    BakenNativeGOP,
    DesktopHostSDL2,
    DesktopHostOpenGL,
}

pub struct BackendCapabilities {
    pub supports_hardware_gpu: bool,
    pub supports_subpixel_alpha: bool,
    pub max_texture_dimension: u32,
    pub screen_width: u32,
    pub screen_height: u32,
}

pub trait GfxBackend {
    fn initialize(&mut self) -> bool;
    fn get_capabilities(&self) -> BackendCapabilities;
    fn begin_frame(&mut self);
    fn end_frame(&mut self);
    fn get_framebuffer_ptr(&mut self) -> *mut u32;
}

pub struct BakenNativeBackend {
    pub fb_ptr: *mut u32,
    pub width: u32,
    pub height: u32,
    pub pitch: u32,
}

impl BakenNativeBackend {
    pub fn new(fb: *mut u32, w: u32, h: u32, pitch: u32) -> Self {
        return BakenNativeBackend {
            fb_ptr: fb,
            width: w,
            height: h,
            pitch: pitch,
        };
    }

    pub fn initialize(&mut self) -> bool {
        return self.fb_ptr != (0 as *mut u32);
    }

    pub fn get_capabilities(&self) -> BackendCapabilities {
        return BackendCapabilities {
            supports_hardware_gpu: false, // Framebuffer VESA/GOP linear
            supports_subpixel_alpha: true,
            max_texture_dimension: 4096,
            screen_width: self.width,
            screen_height: self.height,
        };
    }

    pub fn get_framebuffer_ptr(&mut self) -> *mut u32 {
        return self.fb_ptr;
    }
}
