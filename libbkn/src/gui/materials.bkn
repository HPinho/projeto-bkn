// BKN Standard Library - Modern Materials & Brushes (libbkn::gui::materials)
// Glassmorphism, Materiais Acrílico/Mica, Gradientes Lineares/Radiais e Sombras Volumétricas

module libbkn::gui::materials;

import libbkn::gui::types::*;

pub struct ColorStop {
    pub position: f32, // 0.0 a 1.0
    pub color: Color,
}

impl ColorStop {
    pub fn new(position: f32, color: Color) -> Self {
        return ColorStop { position: position, color: color };
    }
}

pub struct LinearGradient {
    pub start: Point,
    pub end: Point,
    pub stop_count: usize,
    pub stops: [ColorStop; 4],
}

impl LinearGradient {
    pub fn new(start: Point, end: Point, stop1: ColorStop, stop2: ColorStop) -> Self {
        return LinearGradient {
            start: start,
            end: end,
            stop_count: 2,
            stops: [stop1, stop2, ColorStop::new(1.0, Color::transparent()), ColorStop::new(1.0, Color::transparent())],
        };
    }

    pub fn sample_at(&self, t: f32) -> Color {
        if self.stop_count == 0 { return Color::transparent(); }
        if self.stop_count == 1 { return self.stops[0].color; }
        
        let t_clamped = t.clamp(0.0, 1.0);
        if t_clamped <= self.stops[0].position {
            return self.stops[0].color;
        }
        if t_clamped >= self.stops[self.stop_count - 1].position {
            return self.stops[self.stop_count - 1].color;
        }

        for i in 0..(self.stop_count - 1) {
            let s1 = &self.stops[i];
            let s2 = &self.stops[i + 1];
            if t_clamped >= s1.position && t_clamped <= s2.position {
                let range = s2.position - s1.position;
                let factor = if range > 0.0001 { (t_clamped - s1.position) / range } else { 0.0 };
                return s1.color.lerp(s2.color, factor);
            }
        }
        return self.stops[0].color;
    }
}

pub struct RadialGradient {
    pub center: Point,
    pub radius: f32,
    pub inner_color: Color,
    pub outer_color: Color,
}

pub struct AcrylicMaterial {
    pub tint_color: Color,
    pub opacity: f32,
    pub blur_radius: f32,
    pub highlight_color: Color,
}

impl AcrylicMaterial {
    pub fn default_dark() -> Self {
        return AcrylicMaterial {
            tint_color: Color::from_rgba(15, 23, 42, 220),
            opacity: 0.85,
            blur_radius: 16.0,
            highlight_color: Color::from_rgba(255, 255, 255, 40),
        };
    }

    pub fn aero_quantum() -> Self {
        return AcrylicMaterial {
            tint_color: Color::from_rgba(6, 9, 19, 235),
            opacity: 0.92,
            blur_radius: 20.0,
            highlight_color: Color::from_rgba(0, 229, 255, 80), // Ciano Glow
        };
    }
}

pub struct MicaMaterial {
    pub tint_color: Color,
    pub opacity: f32,
}

pub enum Brush {
    Solid(Color),
    Linear(LinearGradient),
    Radial(RadialGradient),
    Acrylic(AcrylicMaterial),
    Mica(MicaMaterial),
}

pub struct DropShadow {
    pub offset_x: f32,
    pub offset_y: f32,
    pub blur_radius: f32,
    pub spread: f32,
    pub color: Color,
}

impl DropShadow {
    pub fn soft_window() -> Self {
        return DropShadow {
            offset_x: 0.0,
            offset_y: 8.0,
            blur_radius: 24.0,
            spread: 2.0,
            color: Color::from_rgba(0, 0, 0, 140),
        };
    }

    pub fn quantum_glow(glow_color: Color) -> Self {
        return DropShadow {
            offset_x: 0.0,
            offset_y: 0.0,
            blur_radius: 16.0,
            spread: 4.0,
            color: glow_color.with_alpha(100),
        };
    }
}

pub struct Border {
    pub color: Color,
    pub width: f32,
    pub radius: CornerRadius,
}

impl Border {
    pub fn subtle(color: Color, radius: f32) -> Self {
        return Border {
            color: color,
            width: 1.0,
            radius: CornerRadius::all(radius),
        };
    }
}
