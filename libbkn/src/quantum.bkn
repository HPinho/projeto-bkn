// libbkn - Módulo de Computação Quântica Nativa
// Implementação de Algoritmos Quânticos Padrão: Bell, Teletransporte, QFT e Grover

module libbkn::quantum;

import libbkn::core::*;

// Prepara um par de Bell entrelaçado (|00> + |11>) / sqrt(2)
@quantum
pub fn create_bell_pair(mut reg: qreg[2]) {
    quantum {
        H(reg[0]);
        CNOT(reg[0], reg[1]);
    }
}

// Protocolo de Teletransporte Quântico de Estados Arbitrários
@quantum
pub fn teleport_state(source_qubit: qubit, mut bell_resource: qreg[2]) -> (u8, u8) {
    quantum {
        // Cria canal quântico entrelaçado
        create_bell_pair(bell_resource);

        // Operação de Bell no transmissor (Alice)
        CNOT(source_qubit, bell_resource[0]);
        H(source_qubit);
    }

    // Medição clássica de colapso
    let m_source = measure(source_qubit);
    let m_resource = measure(bell_resource[0]);

    // Correção unitária de Pauli no receptor (Bob)
    quantum {
        if (m_resource == 1) {
            X(bell_resource[1]);
        }
        if (m_source == 1) {
            Z(bell_resource[1]);
        }
    }

    return (m_source, m_resource);
}

// Transformada Quântica de Fourier (QFT) para N qubits
@quantum
pub fn quantum_fourier_transform(mut reg: qreg[4]) {
    quantum {
        // Qubit 0
        H(reg[0]);
        PHASE(reg[1], 1.5707963267948966); // pi / 2
        PHASE(reg[2], 0.7853981633974483); // pi / 4
        PHASE(reg[3], 0.3926990816987241); // pi / 8

        // Qubit 1
        H(reg[1]);
        PHASE(reg[2], 1.5707963267948966);
        PHASE(reg[3], 0.7853981633974483);

        // Qubit 2
        H(reg[2]);
        PHASE(reg[3], 1.5707963267948966);

        // Qubit 3
        H(reg[3]);

        // Inversão de ordem de bits (SWAP)
        SWAP(reg[0], reg[3]);
        SWAP(reg[1], reg[2]);
    }
}
