{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sotlas",
  "scopeName": "source.sotlas",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#char_literals" },
    { "include": "#attributes" },
    { "include": "#keywords" },
    { "include": "#storage_modifiers" },
    { "include": "#constants_language" },
    { "include": "#variables_language" },
    { "include": "#types_primitive" },
    { "include": "#function_definition" },
    { "include": "#function_call" },
    { "include": "#types_user" },
    { "include": "#constants_caps" },
    { "include": "#pointers" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#bit_accessors" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.sotlas",
          "match": "//.*$"
        },
        {
          "name": "comment.block.sotlas",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.block.parenthesis.sotlas",
          "begin": "\\(\\*",
          "end": "\\*\\)"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.sotlas",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.sotlas",
          "match": "\\\\([nrtbf0\"'\\\\]|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]+\\})"
        }
      ]
    },
    "char_literals": {
      "name": "string.quoted.single.sotlas",
      "match": "'([^'\\\\]|\\\\.)'"
    },
    "attributes": {
      "patterns": [
        {
          "name": "entity.name.function.decorator.sotlas",
          "match": "@[a-zA-Z0-9_]+"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.sotlas",
          "match": "\\b(if|else|for|while|return|break|continue|in|match|guard|defer)\\b"
        },
        {
          "name": "keyword.declaration.sotlas",
          "match": "\\b(module|import|pub|priv|internal|fn|trapfn|struct|enum|class|mesh|spec|adopts|moldable|reshape|barecore|const|static|let|var|unsafe|as|where)\\b"
        },
        {
          "name": "keyword.srg.sotlas",
          "match": "\\b(handover|quarantine|rebound|clinch|revert|quench|gate|emit)\\b"
        }
      ]
    },
    "storage_modifiers": {
      "patterns": [
        {
          "name": "storage.modifier.sotlas",
          "match": "\\b(mut|sole|island|whisper|direct|co-owned)\\b"
        }
      ]
    },
    "constants_language": {
      "patterns": [
        {
          "name": "constant.language.sotlas",
          "match": "\\b(true|false|null|nil)\\b"
        }
      ]
    },
    "variables_language": {
      "patterns": [
        {
          "name": "variable.language.self.sotlas",
          "match": "\\b(self)\\b"
        }
      ]
    },
    "types_primitive": {
      "patterns": [
        {
          "name": "support.type.primitive.sotlas",
          "match": "\\b(u8|u16|u32|u64|i8|i16|i32|i64|f32|f64|usize|isize|bool|void|str|char)\\b"
        },
        {
          "name": "support.type.sotlas",
          "match": "\\b(Int8|Int16|Int32|Int64|UInt8|UInt16|UInt32|UInt64|Float32|Float64|USize|ISize|Bool|Void|String)\\b"
        }
      ]
    },
    "function_definition": {
      "match": "\\b(fn|trapfn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.sotlas" },
        "2": { "name": "entity.name.function.sotlas" }
      }
    },
    "function_call": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.sotlas" }
      }
    },
    "types_user": {
      "patterns": [
        {
          "name": "entity.name.type.sotlas",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "constants_caps": {
      "patterns": [
        {
          "name": "constant.other.caps.sotlas",
          "match": "\\b[A-Z][A-Z0-9_]{2,}\\b"
        }
      ]
    },
    "pointers": {
      "patterns": [
        {
          "name": "storage.type.pointer.sotlas",
          "match": "\\*(const|mut|rawphys|virtmap|portwire|dmazone|voidzero)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.sotlas",
          "match": "\\b0x[0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.sotlas",
          "match": "\\b0b[01_]+\\b"
        },
        {
          "name": "constant.numeric.float.sotlas",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?(f32|f64)?\\b"
        },
        {
          "name": "constant.numeric.integer.sotlas",
          "match": "\\b[0-9][0-9_]*(u8|u16|u32|u64|i8|i16|i32|i64|usize)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.sotlas",
          "match": "(::|->|=>|\\.\\.|\\+|-|\\*|/|%|==|!=|<=|>=|<|>|&&|\\|\\||!|&|\\||\\^|<<|>>|=|\\+=|-=|\\*=|/=)"
        }
      ]
    },
    "bit_accessors": {
      "patterns": [
        {
          "name": "support.function.bit.sotlas",
          "match": "\\.(slit|notch|strand)\\b"
        }
      ]
    }
  }
}
