{
  "name": "baken-cq",
  "displayName": "Baken Cq",
  "publisher": "bakenos",
  "description": "Realce de sintaxe para o subconjunto Cq do Baken OS",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "baken-cq",
        "aliases": [
          "Baken Cq",
          "cq"
        ],
        "extensions": [
          ".cq",
          ".cqh"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "baken-cq",
        "scopeName": "source.cq",
        "path": "./syntaxes/cq.tmLanguage.json"
      }
    ]
  }
}
