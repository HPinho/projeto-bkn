{
  "name": "bkn-language-support",
  "displayName": "BKN Language & Quantum Tooling",
  "description": "Suporte nativo oficial para a Linguagem BKN, circuitos quânticos e depuração Baken OS no VS Code, Antigravity e Claude Code.",
  "version": "1.0.0",
  "publisher": "baken-corp",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bkn.runQuantumSimulator",
        "title": "BKN: Executar Circuito no Q-HAL Simulator",
        "category": "Baken OS"
      },
      {
        "command": "bkn.showBlochSphere",
        "title": "BKN: Abrir Visualizador de Esfera de Bloch",
        "category": "Baken OS"
      },
      {
        "command": "bkn.compileNative",
        "title": "BKN: Compilar para .bkn_exec (Assinatura Pós-Quântica)",
        "category": "Baken OS"
      }
    ],
    "languages": [
      {
        "id": "bkn",
        "aliases": ["BKN", "bkn", "baken"],
        "extensions": [".bkn", ".bkn_qir"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bkn",
        "scopeName": "source.bkn",
        "path": "./syntaxes/bkn.tmLanguage.json"
      }
    ]
  }
}
