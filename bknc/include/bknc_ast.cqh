/*
 * BKNC - protótipo hospedeiro do frontend Cq.
 * AST mínimo para análise textual; não é o compilador oficial nem um runtime.
 */

#ifndef BKNC_AST_H
#define BKNC_AST_H

#include <stdint.h>
#include <stdbool.h>
#include <stdlib.h>

typedef enum {
    TYPE_U8, TYPE_U16, TYPE_U32, TYPE_U64, TYPE_U128, TYPE_USIZE,
    TYPE_I8, TYPE_I16, TYPE_I32, TYPE_I64, TYPE_I128, TYPE_ISIZE,
    TYPE_F32, TYPE_F64,
    TYPE_BOOL, TYPE_CHAR, TYPE_VOID,
    TYPE_POINTER, TYPE_REFERENCE,
    TYPE_STRUCT, TYPE_CUSTOM
} BknTypeKind;

typedef struct BknType {
    BknTypeKind kind;
    bool is_mutable;
    struct BknType* inner_type; // Para ponteiros, referencias e arrays
    char* custom_name;
} BknType;

typedef enum {
    EXPR_IDENTIFIER,
    EXPR_NUMBER,
    EXPR_STRING,
    EXPR_BINARY_OP,
    EXPR_UNARY_OP,
    EXPR_CALL,
    EXPR_FIELD_ACCESS,
    EXPR_INDEX,
    EXPR_CAST
} BknExprKind;

typedef struct BknExpr {
    BknExprKind kind;
    BknType inferred_type;
    union {
        char* identifier;
        int64_t int_val;
        double float_val;
        char* str_val;
        struct {
            char op[4];
            struct BknExpr* left;
            struct BknExpr* right;
        } binary;
        struct {
            char op[4];
            struct BknExpr* operand;
        } unary;
        struct {
            char* callee;
            struct BknExpr** args;
            size_t arg_count;
        } call;
        struct {
            struct BknExpr* object;
            char* field_name;
        } field;
        struct {
            struct BknExpr* target;
            struct BknExpr* index;
        } index_access;
    } data;
} BknExpr;

typedef enum {
    STMT_LET,
    STMT_ASSIGN,
    STMT_IF,
    STMT_WHILE,
    STMT_FOR,
    STMT_RETURN,
    STMT_EXPR,
    STMT_INLINE_ASM
} BknStmtKind;

typedef struct BknAstNode {
    BknStmtKind kind;
    BknType type;
    union {
        struct {
            char* var_name;
            bool is_mut;
            BknType var_type;
            BknExpr* init_expr;
        } let_stmt;

        struct {
            BknExpr* target;
            BknExpr* value;
        } assign_stmt;

        struct {
            BknExpr* condition;
            struct BknAstNode* then_branch;
            struct BknAstNode* else_branch;
        } if_stmt;

        struct {
            BknExpr* condition;
            struct BknAstNode* body;
        } while_stmt;

        struct {
            BknExpr* return_val;
        } return_stmt;

        struct {
            BknExpr* expr;
        } expr_stmt;

        struct {
            char* asm_instruction;
        } inline_asm;
    } data;
    struct BknAstNode* next;
} BknAstNode;

typedef struct BknParam {
    char* name;
    BknType type;
    bool is_mut;
} BknParam;

typedef struct BknFunction {
    char* name;
    bool is_public;
    bool is_system_mode;   // @system (bare metal)
    BknParam* params;
    size_t param_count;
    BknType return_type;
    BknAstNode* body_head;
    struct BknFunction* next;
} BknFunction;

typedef struct BknStructField {
    char* name;
    BknType type;
    bool is_public;
} BknStructField;

typedef struct BknStruct {
    char* name;
    bool is_public;
    BknStructField* fields;
    size_t field_count;
    struct BknStruct* next;
} BknStruct;

typedef struct BknModule {
    char* name;
    BknStruct* structs;
    BknFunction* functions;
} BknModule;

#endif // BKNC_AST_H
