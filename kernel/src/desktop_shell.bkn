// Baken OS - Desktop Shell Soberano em BKN Puro (@system)
// Layout 1:1 com a Área de Trabalho:
// 1. Papel de parede Mesh Gradient (Ciano -> Lilás/Rosa -> Dourado)
// 2. Barra superior translúcida com menus, Q-HAL AI, Voz, Privacidade e Relógio
// 3. Grade vertical de 2 colunas de pastas/apps na esquerda (10 ícones)
// 4. Painel direito com os 5 Widgets (Clima, Player Symphonia, Calendário, Hardware e Notas)
// 5. Doca flutuante inferior em cápsula de vidro com 15 apps e perfil HP (Hiago Pinho - Ring 0 Sovereign)

module kernel::desktop_shell;

import kernel::graphics_engine::*;
import kernel::baken_rasterizer::*;
import kernel::baken_animation::*;
import kernel::window_manager::*;
import kernel::rtc::*;

extern "C" {
    pub fn bkn_draw_vector_folder(x: u32, y: u32, label: *const u8, color: u32);
    pub fn bkn_draw_system_core_card(x: u32, y: u32);
    pub fn bkn_draw_weather_sun(cx: u32, cy: u32);
    pub fn bkn_draw_dock_app_glyph(cx: u32, cy: u32, app_id: i32);
}

// ========================================================================
// 1. ESTADO GLOBAL DO SHELL
// ========================================================================

pub struct DesktopShellState {
    pub screen_w: u32,
    pub screen_h: u32,
    pub time_tick: u32,
    pub cursor_x: i32,
    pub cursor_y: i32,
}

static mut SHELL: DesktopShellState = DesktopShellState {
    screen_w: 1280,
    screen_h: 720,
    time_tick: 0,
    cursor_x: 640,
    cursor_y: 360,
};

// ========================================================================
// 2. INICIALIZAÇÃO
// ========================================================================

@system
pub fn desktop_shell_init(w: u32, h: u32) {
    unsafe {
        SHELL.screen_w = w;
        SHELL.screen_h = h;
        SHELL.time_tick = 0;
        SHELL.cursor_x = (w / 2) as i32;
        SHELL.cursor_y = (h / 2) as i32;
    }
}

// ========================================================================
// 3. BARRA SUPERIOR (TOP BAR)
// ========================================================================

@system
pub fn render_top_bar() {
    unsafe {
        let sw = SHELL.screen_w;

        // Fundo translúcido branco suave
        gfx_draw_rect_alpha(0, 0, sw, 36, 0x00FFFFFF, 130);
        gfx_draw_rect_alpha(0, 35, sw, 1, 0x00FFFFFF, 190);

        // Logo Vortex
        sdf_render_circle(22, 17, 10, 0x00000000, 255);
        sdf_render_circle(22, 17, 7, 0x0000E5FF, 255);
        sdf_render_circle(22, 17, 4, 0x00000000, 255);
        sdf_render_circle(22, 17, 2, 0x0000E5FF, 255);

        // Título e Menus
        gfx_draw_text(40, 10, b"Baken OS\0".as_ptr(), 0x000F172A, 1);
        gfx_draw_text(118, 10, b"Arquivo\0".as_ptr(), 0x00334155, 1);
        gfx_draw_text(184, 10, b"Editar\0".as_ptr(), 0x00334155, 1);
        gfx_draw_text(242, 10, b"Exibir\0".as_ptr(), 0x00334155, 1);
        gfx_draw_text(300, 10, b"Janela\0".as_ptr(), 0x00334155, 1);
        gfx_draw_text(358, 10, b"Ajuda\0".as_ptr(), 0x00334155, 1);

        // Badges e Pílulas da Direita
        // Q-HAL AI
        sdf_render_smooth_card(sw - 436, 5, 88, 25, 12, 0x0000E5FF, 220, 0x008B5CF6, 1.2);
        gfx_draw_text(sw - 428, 9, b"* Q-HAL AI\0".as_ptr(), 0x00FFFFFF, 1);

        // Botão de Voz
        sdf_render_smooth_card(sw - 342, 5, 54, 25, 12, 0x00FFFFFF, 200, 0x00888888, 1.0);
        gfx_draw_text(sw - 332, 9, b"Voz\0".as_ptr(), 0x000284C7, 1);

        // Escudo de Privacidade Verde
        sdf_render_smooth_card(sw - 280, 5, 25, 25, 12, 0x0010B981, 240, 0x00059669, 1.0);
        gfx_draw_text(sw - 274, 9, b"o\0".as_ptr(), 0x00FFFFFF, 1);

        // Idioma PT-BR
        sdf_render_smooth_card(sw - 248, 5, 72, 25, 12, 0x00FFFFFF, 180, 0x00666666, 1.0);
        gfx_draw_text(sw - 240, 9, b"PT-BR\0".as_ptr(), 0x001E293B, 1);

        // Relógio
        gfx_draw_text(sw - 166, 10, b"10:36 AM  26/08\0".as_ptr(), 0x000F172A, 1);
    }
}

// ========================================================================
// 4. ÍCONES E PASTAS DO DESKTOP (2 COLUNAS NA ESQUERDA)
// ========================================================================

@system
pub fn render_desktop_vector_folder(x: u32, y: u32, label: *const u8, color: u32) {
    unsafe {
        bkn_draw_vector_folder(x, y, label, color);
    }
}

@system
pub fn render_desktop_icons() {
    // Coluna 1 (X = 36)
    render_desktop_vector_folder(36, 60, b"BakenFS\0".as_ptr(), 0x00C084FC);
    render_desktop_vector_folder(36, 150, b"Web Browser\0".as_ptr(), 0x0038BDF8);

    // System Core (Card escuro com anéis de vórtice)
    unsafe {
        bkn_draw_system_core_card(36, 244);
    }

    render_desktop_vector_folder(36, 330, b"Writer\0".as_ptr(), 0x0060A5FA);
    render_desktop_vector_folder(36, 420, b"Sheets\0".as_ptr(), 0x0034D399);
    render_desktop_vector_folder(36, 510, b"Presenter\0".as_ptr(), 0x00FBBF24);

    // Coluna 2 (X = 146)
    render_desktop_vector_folder(146, 60, b"3D Studio\0".as_ptr(), 0x0038BDF8);
    render_desktop_vector_folder(146, 150, b"Paint 2D\0".as_ptr(), 0x00F43F5E);
    render_desktop_vector_folder(146, 240, b"Hi-Res Media\0".as_ptr(), 0x00A855F7);
    render_desktop_vector_folder(146, 330, b"Synth DAW\0".as_ptr(), 0x00F97316);
}

// ========================================================================
// 5. PAINEL DOS 5 WIDGETS LATERAIS (DIREITA)
// ========================================================================

@system
pub fn render_widgets_column() {
    unsafe {
        let sw = SHELL.screen_w;
        let wx = sw - 236;

        // WIDGET 1: CLIMA (Teresina, Piauí - 32°C Ensolarado)
        sdf_render_smooth_card(wx, 50, 224, 84, 14, 0x00FFFFFF, 200, 0x00888888, 1.2);
        gfx_draw_text(wx + 12, 58, b"Teresina, Piaui\0".as_ptr(), 0x00EA580C, 1);
        bkn_draw_weather_sun(wx + 24, 88);
        gfx_draw_text(wx + 44, 76, b"32*C\0".as_ptr(), 0x000F172A, 1);
        gfx_draw_text(wx + 94, 78, b"Ensolarado\0".as_ptr(), 0x00059669, 1);
        gfx_draw_text(wx + 12, 106, b"Umid: 68% | Vento: 14km/h\0".as_ptr(), 0x00475569, 1);

        // WIDGET 2: MUSIC PLAYER (Sovereign Symphonia)
        sdf_render_smooth_card(wx, 142, 224, 86, 14, 0x000F172A, 230, 0x0038BDF8, 1.2);
        sdf_render_smooth_card(wx + 10, 150, 30, 30, 8, 0x0038BDF8, 255, 0x00FFFFFF, 1.0);
        gfx_draw_text(wx + 19, 156, b">\0".as_ptr(), 0x00000000, 1);
        gfx_draw_text(wx + 46, 150, b"Sovereign Symphonia\0".as_ptr(), 0x00FFFFFF, 1);
        gfx_draw_text(wx + 46, 168, b"Baken Synthesizer\0".as_ptr(), 0x0094A3B8, 1);
        // Barra de progresso do player
        sdf_render_smooth_card(wx + 46, 184, 160, 4, 2, 0x001E293B, 200, 0x00333333, 1.0);
        sdf_render_smooth_card(wx + 46, 184, 72, 4, 2, 0x0000E5FF, 255, 0x00FFFFFF, 0.5);
        gfx_draw_text(wx + 72, 196, b"|<   ||   >|\0".as_ptr(), 0x0038BDF8, 1);

        // WIDGET 3: CALENDÁRIO (Agosto 2026)
        sdf_render_smooth_card(wx, 236, 224, 120, 14, 0x00FFFFFF, 200, 0x00888888, 1.2);
        gfx_draw_text(wx + 12, 244, b"Agosto 2026     Baken OS\0".as_ptr(), 0x000F172A, 1);
        gfx_draw_text(wx + 14, 264, b" D  S  T  Q  Q  S  S\0".as_ptr(), 0x0064748B, 1);
        gfx_draw_text(wx + 14, 282, b" 2  3  4  5  6  7  8\0".as_ptr(), 0x00334155, 1);
        gfx_draw_text(wx + 14, 298, b" 9 10 11 12 13 14 15\0".as_ptr(), 0x00334155, 1);
        gfx_draw_text(wx + 14, 314, b"16 17 18 19 20 21 22\0".as_ptr(), 0x00334155, 1);
        // Destaque do dia 26
        sdf_render_smooth_card(wx + 110, 326, 24, 20, 6, 0x000284C7, 255, 0x0000E5FF, 1.0);
        gfx_draw_text(wx + 14, 330, b"23 24 25      27 28 29\0".as_ptr(), 0x00334155, 1);
        gfx_draw_text(wx + 114, 328, b"26\0".as_ptr(), 0x00FFFFFF, 1);

        // WIDGET 4: HARDWARE LIVE MONITOR (Ryzen 7 7700X, Radeon, RAM, NVMe)
        sdf_render_smooth_card(wx, 364, 224, 110, 14, 0x00090D18, 240, 0x0010B981, 1.2);
        gfx_draw_text(wx + 12, 372, b"Hardware Live Monitor\0".as_ptr(), 0x0034D399, 1);
        gfx_draw_text(wx + 12, 392, b"CPU: Ryzen 7 7700X 18%\0".as_ptr(), 0x00E2E8F0, 1);
        sdf_render_smooth_card(wx + 12, 404, 200, 3, 1, 0x001E293B, 200, 0, 0.0);
        sdf_render_smooth_card(wx + 12, 404, 36, 3, 1, 0x0010B981, 255, 0, 0.0);
        gfx_draw_text(wx + 12, 412, b"GPU: Radeon   120 FPS\0".as_ptr(), 0x0038BDF8, 1);
        gfx_draw_text(wx + 12, 428, b"RAM: 8.9 GB / 32 GB\0".as_ptr(), 0x00FCD34D, 1);
        gfx_draw_text(wx + 12, 446, b"NVMe Gen5: 74 GB/512GB\0".as_ptr(), 0x00A78BFA, 1);

        // WIDGET 5: NOTAS RÁPIDAS
        sdf_render_smooth_card(wx, 482, 224, 82, 14, 0x00FEF08A, 230, 0x00FACC15, 1.2);
        gfx_draw_text(wx + 12, 490, b"* Notas Rapidas\0".as_ptr(), 0x00854D0E, 1);
        gfx_draw_text(wx + 12, 508, b"Lembrete Baken OS:\0".as_ptr(), 0x00713F12, 1);
        gfx_draw_text(wx + 12, 524, b"- Compilacao BKNC v2.0\0".as_ptr(), 0x00713F12, 1);
        gfx_draw_text(wx + 12, 540, b"- Q-HAL 20 Fases 100%\0".as_ptr(), 0x00713F12, 1);
    }
}

// ========================================================================
// 6. DOCA FLUTUANTE INFERIOR (DOCK COM 15 APPS E PERFIL HIAGO PINHO)
// ========================================================================

@system
pub fn render_floating_dock() {
    unsafe {
        let sw = SHELL.screen_w;
        let sh = SHELL.screen_h;

        let dock_w: u32 = 880;
        let dock_h: u32 = 54;
        let dock_x = (sw - dock_w) / 2;
        let dock_y = sh - 64;

        // Cápsula de vidro fosco translúcida
        sdf_render_smooth_card(dock_x, dock_y, dock_w, dock_h, 18, 0x00FFFFFF, 180, 0x00888888, 1.5);

        // Botão Iniciar Vortex
        sdf_render_circle(dock_x + 28, dock_y + 27, 16, 0x00000000, 255);
        sdf_render_circle(dock_x + 28, dock_y + 27, 12, 0x0000E5FF, 255);
        sdf_render_circle(dock_x + 28, dock_y + 27, 6, 0x00000000, 255);
        sdf_render_circle(dock_x + 28, dock_y + 27, 3, 0x0000E5FF, 255);

        // 15 Blocos coloridos dos Aplicativos
        let tile_colors: [u32; 15] = [
            0x00C084FC, 0x0038BDF8, 0x00A855F7, 0x00F97316, 0x00F43F5E,
            0x0000E5FF, 0x0060A5FA, 0x0034D399, 0x00FBBF24, 0x001E293B,
            0x008B5CF6, 0x0064748B, 0x000284C7, 0x0010B981, 0x00F59E0B
        ];

        for i in 0..15 {
            let tx = dock_x + 56 + (i as u32 * 42);
            sdf_render_smooth_card(tx, dock_y + 8, 36, 36, 10, tile_colors[i], 255, 0x00FFFFFF, 1.2);
            bkn_draw_dock_app_glyph(tx + 18, dock_y + 26, i as i32);
        }

        // Pílula de Perfil do Usuário
        let prof_x = dock_x + dock_w - 150;
        sdf_render_smooth_card(prof_x, dock_y + 6, 140, 42, 14, 0x00FFFFFF, 200, 0x00666666, 1.0);

        // Avatar HP
        sdf_render_circle(prof_x + 22, dock_y + 27, 14, 0x0000E5FF, 255);
        gfx_draw_text(prof_x + 14, dock_y + 19, b"HP\0".as_ptr(), 0x00FFFFFF, 1);

        // Nome e Titulação
        gfx_draw_text(prof_x + 44, dock_y + 12, b"Hiago Pinho\0".as_ptr(), 0x000F172A, 1);
        gfx_draw_text(prof_x + 44, dock_y + 27, b"Ring 0 Sovereign\0".as_ptr(), 0x0064748B, 1);
    }
}

// ========================================================================
// 7. LOOP PRINCIPAL DE RENDERIZAÇÃO
// ========================================================================

@system
pub fn desktop_shell_render_frame() {
    unsafe {
        SHELL.time_tick = (SHELL.time_tick + 1) % 3600;

        // 1. Papel de parede Mesh Gradient
        gfx_draw_mesh_wallpaper();

        // 2. Pastas e ícones do Desktop (Esquerda)
        render_desktop_icons();

        // 3. Painel lateral com os 5 Widgets (Direita)
        render_widgets_column();

        // 4. Barra Superior Translúcida (Top Bar)
        render_top_bar();

        // 5. Doca Flutuante com 15 Apps e Perfil HP (Inferior)
        render_floating_dock();

        // 6. Janelas e notificações ativas
        wm_render_windows();

        // 7. Cursor do mouse
        render_cursor();

        // 8. Swap do Framebuffer (120 FPS VSync)
        gfx_swap_buffers();
    }
}
