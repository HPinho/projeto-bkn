// Baken OS - Subsistema de Syscalls (Fast Syscall x86_64) e IPC por Capacidades em BKN Puro (@system)
// Chamadas de Sistema de Ultra-Baixa Latencia e Barramento de Mensagens com Isolamento Estrito

module kernel::ipc;

import kernel::pmm::*;
import kernel::vmm::*;
import kernel::scheduler::*;

pub const SYS_YIELD: u64         = 0x01;
pub const SYS_ALLOC_PAGES: u64   = 0x02;
pub const SYS_FREE_PAGES: u64    = 0x03;
pub const SYS_OPEN_FILE: u64     = 0x04;
pub const SYS_READ_FILE: u64     = 0x05;
pub const SYS_WRITE_FILE: u64    = 0x06;
pub const SYS_CREATE_THREAD: u64 = 0x07;
pub const SYS_SEND_IPC_MSG: u64  = 0x08;
pub const SYS_RECV_IPC_MSG: u64  = 0x09;
pub const SYS_GET_TICKS: u64     = 0x0A;
pub const SYS_QUANTUM_DISPATCH: u64 = 0x0B;

pub struct IpcMessage {
    pub sender_pid: u64,
    pub target_pid: u64,
    pub capability_token: u64,
    pub msg_type: u32,
    pub payload_len: u32,
    pub data: [u8; 256],
}

pub struct IpcChannel {
    pub channel_id: u64,
    pub owner_pid: u64,
    pub target_pid: u64,
    pub capability_key: u64,
    pub message_queue: [IpcMessage; 16],
    pub queue_head: usize,
    pub queue_tail: usize,
    pub is_active: bool,
}

static mut CHANNELS: [IpcChannel; 64] = [IpcChannel {
    channel_id: 0,
    owner_pid: 0,
    target_pid: 0,
    capability_key: 0,
    message_queue: [IpcMessage {
        sender_pid: 0, target_pid: 0,
        capability_token: 0, msg_type: 0,
        payload_len: 0, data: [0; 256],
    }; 16],
    queue_head: 0,
    queue_tail: 0,
    is_active: false,
}; 64];

@system
pub fn ipc_init() {
    unsafe {
        for i in 0..64 {
            CHANNELS[i].is_active = false;
            CHANNELS[i].queue_head = 0;
            CHANNELS[i].queue_tail = 0;
        }

        // Configura registradores MSR para Fast Syscall x86_64
        // IA32_EFER (0xC0000080), IA32_STAR (0xC0000081), IA32_LSTAR (0xC0000082)
    }
}

@system
pub fn ipc_open_channel(sender_pid: u64, receiver_pid: u64, cap_key: u64) -> u64 {
    unsafe {
        for i in 0..64 {
            if !CHANNELS[i].is_active {
                CHANNELS[i].channel_id = (i + 1) as u64;
                CHANNELS[i].owner_pid = sender_pid;
                CHANNELS[i].target_pid = receiver_pid;
                CHANNELS[i].capability_key = cap_key;
                CHANNELS[i].queue_head = 0;
                CHANNELS[i].queue_tail = 0;
                CHANNELS[i].is_active = true;
                return CHANNELS[i].channel_id;
            }
        }
        return 0;
    }
}

@system
pub fn ipc_send_message(channel_id: u64, msg: &IpcMessage) -> bool {
    unsafe {
        if channel_id == 0 || channel_id > 64 { return false; }
        let idx = (channel_id - 1) as usize;
        let ch = &mut CHANNELS[idx];

        if !ch.is_active || msg.capability_token != ch.capability_key {
            return false; // Violacao de seguranca por capacidade
        }

        let next = (ch.queue_head + 1) % 16;
        if next == ch.queue_tail {
            return false; // Fila cheia
        }

        ch.message_queue[ch.queue_head] = *msg;
        ch.queue_head = next;
        return true;
    }
}

@system
pub fn ipc_receive_message(channel_id: u64, out_msg: &mut IpcMessage) -> bool {
    unsafe {
        if channel_id == 0 || channel_id > 64 { return false; }
        let idx = (channel_id - 1) as usize;
        let ch = &mut CHANNELS[idx];

        if !ch.is_active || ch.queue_head == ch.queue_tail {
            return false; // Fila vazia
        }

        *out_msg = ch.message_queue[ch.queue_tail];
        ch.queue_tail = (ch.queue_tail + 1) % 16;
        return true;
    }
}

// Despachante Mestre de Syscalls (Invocado pelo handler da instrucao `syscall`)
@system
pub fn syscall_dispatcher(syscall_id: u64, arg1: u64, arg2: u64, arg3: u64) -> u64 {
    match syscall_id {
        SYS_YIELD => {
            scheduler_yield();
            return 0;
        },
        SYS_ALLOC_PAGES => {
            let ptr = pmm_alloc_pages(arg1 as usize);
            return ptr as u64;
        },
        SYS_FREE_PAGES => {
            pmm_free_pages(arg1 as *mut u8, arg2 as usize);
            return 0;
        },
        SYS_GET_TICKS => {
            return scheduler_get_stats().timer_ticks;
        },
        _ => {
            return 0xFFFFFFFFFFFFFFFF; // Syscall desconhecida
        }
    }
}
