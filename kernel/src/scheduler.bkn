// Baken OS - Escalonador Preemptivo Hibrido em BKN Puro (@system)
// Multitarefa Preemptiva com 4 Niveis de Prioridade, Quantum Dinamico e Troca de Contexto x86_64

module kernel::scheduler;

import kernel::pmm::*;
import kernel::vmm::*;

pub const MAX_THREADS: usize = 256;
pub const DEFAULT_QUANTUM_TICKS: u32 = 10; // 10 ticks = 10ms

pub enum ThreadStatus {
    Ready = 1,
    Running = 2,
    Sleeping = 3,
    BlockedIpc = 4,
    SuspendedQuantum = 5,
    Terminated = 6,
}

pub enum PriorityLevel {
    Realtime = 0, // Threads do Kernel e Simulador Quantico Q-HAL
    High = 1,     // Compositor Grafico e Motor de Renderizacao
    Normal = 2,   // Aplicativos do Usuario (Shell, IDE, Terminal)
    Idle = 3,     // Tarefa ociosa (HLT loop)
}

pub struct CpuRegisters {
    pub rax: u64, pub rbx: u64, pub rcx: u64, pub rdx: u64,
    pub rsi: u64, pub rdi: u64, pub rbp: u64, pub rsp: u64,
    pub r8:  u64, pub r9:  u64, pub r10: u64, pub r11: u64,
    pub r12: u64, pub r13: u64, pub r14: u64, pub r15: u64,
    pub rip: u64, pub rflags: u64, pub cr3: u64,
}

pub struct KernelThread {
    pub id: u64,
    pub name: [u8; 32],
    pub priority: PriorityLevel,
    pub status: ThreadStatus,
    pub context: CpuRegisters,
    pub stack_base: u64,
    pub stack_size: usize,
    pub remaining_quantum: u32,
    pub sleep_ticks_left: u64,
    pub total_cpu_ticks: u64,
    pub quantum_job_id: u64,
    pub next: *mut KernelThread,
}

pub struct SchedulerStats {
    pub total_threads: usize,
    pub context_switches: u64,
    pub timer_ticks: u64,
    pub active_thread_id: u64,
}

// Filas de prioridade multinivel (MLFQ simplificado)
static mut PRIO_HEADS: [*mut KernelThread; 4] = [0 as *mut KernelThread; 4];
static mut PRIO_TAILS: [*mut KernelThread; 4] = [0 as *mut KernelThread; 4];

static mut SLEEP_LIST_HEAD: *mut KernelThread = 0 as *mut KernelThread;
static mut CURRENT_THREAD: *mut KernelThread = 0 as *mut KernelThread;
static mut IDLE_THREAD: *mut KernelThread = 0 as *mut KernelThread;
static mut NEXT_THREAD_ID: u64 = 1;

static mut STATS: SchedulerStats = SchedulerStats {
    total_threads: 0,
    context_switches: 0,
    timer_ticks: 0,
    active_thread_id: 0,
};

static mut THREAD_POOL: [KernelThread; MAX_THREADS] = [KernelThread {
    id: 0,
    name: [0; 32],
    priority: PriorityLevel::Normal,
    status: ThreadStatus::Terminated,
    context: CpuRegisters {
        rax: 0, rbx: 0, rcx: 0, rdx: 0,
        rsi: 0, rdi: 0, rbp: 0, rsp: 0,
        r8:  0, r9:  0, r10: 0, r11: 0,
        r12: 0, r13: 0, r14: 0, r15: 0,
        rip: 0, rflags: 0x202, cr3: 0,
    },
    stack_base: 0,
    stack_size: 0,
    remaining_quantum: DEFAULT_QUANTUM_TICKS,
    sleep_ticks_left: 0,
    total_cpu_ticks: 0,
    quantum_job_id: 0,
    next: 0 as *mut KernelThread,
}; MAX_THREADS];

@system
fn idle_task_loop() {
    loop {
        unsafe {
            asm!("hlt");
        }
    }
}

@system
pub fn scheduler_init() {
    unsafe {
        for i in 0..4 {
            PRIO_HEADS[i] = 0 as *mut KernelThread;
            PRIO_TAILS[i] = 0 as *mut KernelThread;
        }

        SLEEP_LIST_HEAD = 0 as *mut KernelThread;
        CURRENT_THREAD = 0 as *mut KernelThread;
        NEXT_THREAD_ID = 1;
        STATS.total_threads = 0;
        STATS.context_switches = 0;
        STATS.timer_ticks = 0;

        // Cria thread Idle
        IDLE_THREAD = scheduler_create_thread(
            b"idle_task\0".as_ptr(),
            idle_task_loop as u64,
            PriorityLevel::Idle,
            4096
        );
    }
}

@system
pub fn scheduler_create_thread(
    name_ptr: *const u8,
    entry_point: u64,
    priority: PriorityLevel,
    stack_size: usize
) -> *mut KernelThread {
    unsafe {
        // Encontra slot livre no pool
        let mut slot_idx: usize = MAX_THREADS;
        for i in 0..MAX_THREADS {
            if THREAD_POOL[i].status == ThreadStatus::Terminated {
                slot_idx = i;
                break;
            }
        }

        if slot_idx == MAX_THREADS {
            return 0 as *mut KernelThread; // Pool cheio
        }

        let thread = &mut THREAD_POOL[slot_idx] as *mut KernelThread;
        (*thread).id = NEXT_THREAD_ID;
        NEXT_THREAD_ID += 1;

        // Copia nome
        let mut i: usize = 0;
        while i < 31 {
            let ch = *name_ptr.add(i);
            if ch == 0 { break; }
            (*thread).name[i] = ch;
            i += 1;
        }
        (*thread).name[i] = 0;

        (*thread).priority = priority;
        (*thread).status = ThreadStatus::Ready;
        (*thread).remaining_quantum = DEFAULT_QUANTUM_TICKS;
        (*thread).sleep_ticks_left = 0;
        (*thread).total_cpu_ticks = 0;
        (*thread).quantum_job_id = 0;
        (*thread).next = 0 as *mut KernelThread;

        // Aloca pilha propria
        let stack_pages = (stack_size + PAGE_SIZE - 1) / PAGE_SIZE;
        let stack_mem = pmm_alloc_pages(0); // 4KB basico
        let stack_top = (stack_mem as u64) + (stack_pages * PAGE_SIZE) as u64 - 16;

        (*thread).stack_base = stack_mem as u64;
        (*thread).stack_size = stack_pages * PAGE_SIZE;

        // Contexto inicial
        (*thread).context.rip = entry_point;
        (*thread).context.rsp = stack_top;
        (*thread).context.rbp = stack_top;
        (*thread).context.rflags = 0x202; // IF (Interrupt Enable) ativado
        (*thread).context.cr3 = vmm_get_current_cr3();

        STATS.total_threads += 1;

        if priority != PriorityLevel::Idle {
            scheduler_enqueue(thread);
        }

        return thread;
    }
}

@system
pub fn scheduler_enqueue(thread: *mut KernelThread) {
    if thread == (0 as *mut KernelThread) { return; }

    unsafe {
        (*thread).status = ThreadStatus::Ready;
        (*thread).next = 0 as *mut KernelThread;

        let prio_idx = (*thread).priority as usize;
        if PRIO_TAILS[prio_idx] == (0 as *mut KernelThread) {
            PRIO_HEADS[prio_idx] = thread;
            PRIO_TAILS[prio_idx] = thread;
        } else {
            (*PRIO_TAILS[prio_idx]).next = thread;
            PRIO_TAILS[prio_idx] = thread;
        }
    }
}

@system
pub fn scheduler_dequeue_highest() -> *mut KernelThread {
    unsafe {
        // Percorre as filas por ordem de prioridade (0: Realtime, 1: High, 2: Normal)
        for p in 0..3 {
            if PRIO_HEADS[p] != (0 as *mut KernelThread) {
                let thread = PRIO_HEADS[p];
                PRIO_HEADS[p] = (*thread).next;
                if PRIO_HEADS[p] == (0 as *mut KernelThread) {
                    PRIO_TAILS[p] = 0 as *mut KernelThread;
                }
                (*thread).next = 0 as *mut KernelThread;
                return thread;
            }
        }
        return IDLE_THREAD;
    }
}

// Chamado a cada interrupcao do Timer de Hardware (PIT/APIC)
@system
pub fn scheduler_tick(saved_regs: *mut CpuRegisters) {
    unsafe {
        STATS.timer_ticks += 1;

        // 1. Atualiza lista de threads adormecidas
        let mut curr_sleep = SLEEP_LIST_HEAD;
        let mut prev_sleep = 0 as *mut KernelThread;

        while curr_sleep != (0 as *mut KernelThread) {
            let next_sleep = (*curr_sleep).next;
            if (*curr_sleep).sleep_ticks_left > 0 {
                (*curr_sleep).sleep_ticks_left -= 1;
            }

            if (*curr_sleep).sleep_ticks_left == 0 {
                // Acorda thread e reinsere na fila de prontos
                if prev_sleep != (0 as *mut KernelThread) {
                    (*prev_sleep).next = next_sleep;
                } else {
                    SLEEP_LIST_HEAD = next_sleep;
                }
                scheduler_enqueue(curr_sleep);
            } else {
                prev_sleep = curr_sleep;
            }
            curr_sleep = next_sleep;
        }

        // 2. Decrementa o quantum da thread atual
        if CURRENT_THREAD != (0 as *mut KernelThread) && (*CURRENT_THREAD).status == ThreadStatus::Running {
            (*CURRENT_THREAD).total_cpu_ticks += 1;
            if (*CURRENT_THREAD).remaining_quantum > 0 {
                (*CURRENT_THREAD).remaining_quantum -= 1;
            }

            if (*CURRENT_THREAD).remaining_quantum == 0 {
                // Quantum expirou: Preempcao!
                scheduler_preempt(saved_regs);
            }
        } else {
            scheduler_schedule_next(saved_regs);
        }
    }
}

@system
pub fn scheduler_preempt(saved_regs: *mut CpuRegisters) {
    unsafe {
        if CURRENT_THREAD != (0 as *mut KernelThread) {
            // Salva o contexto dos registradores
            (*CURRENT_THREAD).context = *saved_regs;
            (*CURRENT_THREAD).remaining_quantum = DEFAULT_QUANTUM_TICKS;

            if (*CURRENT_THREAD).priority != PriorityLevel::Idle {
                scheduler_enqueue(CURRENT_THREAD);
            }
        }

        scheduler_schedule_next(saved_regs);
    }
}

@system
pub fn scheduler_schedule_next(saved_regs: *mut CpuRegisters) {
    unsafe {
        let next_thread = scheduler_dequeue_highest();
        CURRENT_THREAD = next_thread;
        (*CURRENT_THREAD).status = ThreadStatus::Running;
        STATS.active_thread_id = (*CURRENT_THREAD).id;
        STATS.context_switches += 1;

        // Restaura registradores da nova thread
        *saved_regs = (*CURRENT_THREAD).context;

        if (*CURRENT_THREAD).context.cr3 != 0 {
            vmm_switch_pml4((*CURRENT_THREAD).context.cr3);
        }
    }
}

@system
pub fn scheduler_yield() {
    unsafe {
        asm!("int 0x20"); // Dispara interrupcao de software para ceder a CPU
    }
}

@system
pub fn scheduler_sleep_ms(ms: u64) {
    unsafe {
        if CURRENT_THREAD != (0 as *mut KernelThread) {
            (*CURRENT_THREAD).status = ThreadStatus::Sleeping;
            (*CURRENT_THREAD).sleep_ticks_left = ms;

            // Insere na lista de sleep
            (*CURRENT_THREAD).next = SLEEP_LIST_HEAD;
            SLEEP_LIST_HEAD = CURRENT_THREAD;

            scheduler_yield();
        }
    }
}

@system
pub fn scheduler_get_stats() -> SchedulerStats {
    unsafe {
        return STATS;
    }
}
