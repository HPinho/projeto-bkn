// Baken OS — planejamento e leitura FAT32 nativos para a EFI System Partition.
//
// O planner calcula BPB/FAT geometry sem tocar mídia. O runtime lê o Volume
// Boot Record, FSInfo, Backup Boot e metadados FAT da ESP publicada pelo parser GPT
// exclusivamente pela Block Device API nativa, publicando cada gate somente após validação real.

module kernel::storage::fat32;

import kernel::arch::x86_64::serial::*;
import kernel::storage::block_device::*;
import kernel::storage::gpt_redundancy::*;
import kernel::storage::crc32::*;
import kernel::memory::dma::*;

pub const FAT32_FAT_COUNT: u32 = 2;
pub const FAT32_RESERVED_SECTORS: u32 = 32;
pub const FAT32_ROOT_CLUSTER: u32 = 2;
pub const FAT32_FSINFO_SECTOR: u32 = 1;
pub const FAT32_BACKUP_BOOT_SECTOR: u32 = 6;
pub const FAT32_RUNTIME_BLOCK_SIZE: u32 = 512;
pub const FAT32_RUNTIME_BUFFER_SIZE: u64 = 4096;
pub const FAT32_MIN_CLUSTERS: u64 = 65525;
pub const FAT32_MAX_CLUSTERS: u64 = 0x0FFFFFF5;
pub const FAT32_FSINFO_LEAD_SIGNATURE: u32 = 0x41615252;
pub const FAT32_FSINFO_STRUCT_SIGNATURE: u32 = 0x61417272;
pub const FAT32_FSINFO_TRAIL_SIGNATURE: u32 = 0xAA550000;
pub const FAT32_FSINFO_UNKNOWN: u32 = 0xFFFFFFFF;
pub const FAT32_ENTRY_MASK: u32 = 0x0FFFFFFF;
pub const FAT32_EOC_MIN: u32 = 0x0FFFFFF8;
pub const FAT32_ATTR_LONG_NAME: u8 = 0x0F;
pub const FAT32_ATTR_VOLUME_ID: u8 = 0x08;
pub const FAT32_ATTR_DIRECTORY: u8 = 0x10;

static mut FAT32_RUNTIME_READY: bool = false;
static mut FAT32_RUNTIME_PARTITION_FIRST_LBA: u64 = 0;
static mut FAT32_RUNTIME_PARTITION_LAST_LBA: u64 = 0;
static mut FAT32_RUNTIME_TOTAL_SECTORS: u64 = 0;
static mut FAT32_RUNTIME_BYTES_PER_SECTOR: u32 = 0;
static mut FAT32_RUNTIME_SECTORS_PER_CLUSTER: u32 = 0;
static mut FAT32_RUNTIME_RESERVED_SECTORS: u32 = 0;
static mut FAT32_RUNTIME_FAT_COUNT: u32 = 0;
static mut FAT32_RUNTIME_FAT_SIZE_SECTORS: u32 = 0;
static mut FAT32_RUNTIME_DATA_START_LBA: u64 = 0;
static mut FAT32_RUNTIME_CLUSTER_COUNT: u64 = 0;
static mut FAT32_RUNTIME_ROOT_CLUSTER: u32 = 0;
static mut FAT32_RUNTIME_FSINFO_SECTOR: u32 = 0;
static mut FAT32_RUNTIME_BACKUP_BOOT_SECTOR: u32 = 0;
static mut FAT32_RUNTIME_FSINFO_READY: bool = false;
static mut FAT32_RUNTIME_FSINFO_LBA: u64 = 0;
static mut FAT32_RUNTIME_FSINFO_FREE_COUNT: u32 = FAT32_FSINFO_UNKNOWN;
static mut FAT32_RUNTIME_FSINFO_NEXT_FREE: u32 = FAT32_FSINFO_UNKNOWN;
static mut FAT32_RUNTIME_BACKUP_BOOT_READY: bool = false;
static mut FAT32_RUNTIME_BACKUP_BOOT_LBA: u64 = 0;
static mut FAT32_RUNTIME_ROOT_FILE_READY: bool = false;
static mut FAT32_RUNTIME_ROOT_FILE_ENTRY_LBA: u64 = 0;
static mut FAT32_RUNTIME_ROOT_FILE_ENTRY_OFFSET: u32 = 0;
static mut FAT32_RUNTIME_ROOT_FILE_FIRST_CLUSTER: u32 = 0;
static mut FAT32_RUNTIME_ROOT_FILE_SIZE: u32 = 0;
static mut FAT32_RUNTIME_ROOT_FILE_ATTRIBUTES: u32 = 0;
static mut FAT32_RUNTIME_ROOT_FILE_CONTENT_READY: bool = false;
static mut FAT32_RUNTIME_ROOT_FILE_CONTENT_BYTES: u32 = 0;
static mut FAT32_RUNTIME_ROOT_FILE_CONTENT_CRC32: u32 = 0;
static mut FAT32_RUNTIME_SECTOR: DmaBuffer = DmaBuffer {
    virtual_address: null as *mut u8,
    physical_address: 0,
    size: 0,
    alignment: 0,
    owner: DMA_OWNER_CPU,
    fence: 0,
    valid: false
};
static mut FAT32_RUNTIME_BACKUP_SECTOR: DmaBuffer = DmaBuffer {
    virtual_address: null as *mut u8,
    physical_address: 0,
    size: 0,
    alignment: 0,
    owner: DMA_OWNER_CPU,
    fence: 0,
    valid: false
};

pub struct Fat32Layout {
    pub valid: bool;
    pub bytes_per_sector: u32;
    pub sectors_per_cluster: u32;
    pub reserved_sectors: u32;
    pub fat_count: u32;
    pub fat_size_sectors: u32;
    pub total_sectors: u64;
    pub data_start_sector: u64;
    pub data_sectors: u64;
    pub cluster_count: u64;
    pub root_cluster: u32;
    pub fsinfo_sector: u32;
    pub backup_boot_sector: u32;
}

@system
fn fat32_is_power_of_two(v: u32) -> bool {
    if v == 0 { return false; }
    return (v & (v - 1)) == 0;
}

@system
fn fat32_read_u8(base: *const u8, offset: usize) -> u8 {
    if base == (null as *const u8) { return 0; }
    unsafe { return base[offset]; }
}

@system
fn fat32_read_u16(base: *const u8, offset: usize) -> u16 {
    if base == (null as *const u8) { return 0; }
    unsafe {
        return (base[offset] as u16) | ((base[offset + 1] as u16) << 8);
    }
}

@system
fn fat32_read_u32(base: *const u8, offset: usize) -> u32 {
    if base == (null as *const u8) { return 0; }
    unsafe {
        return (base[offset] as u32) |
            ((base[offset + 1] as u32) << 8) |
            ((base[offset + 2] as u32) << 16) |
            ((base[offset + 3] as u32) << 24);
    }
}

@system
fn fat32_runtime_sector_buffer() -> *mut u8 {
    unsafe {
        if dma_buffer_cpu_owned(&FAT32_RUNTIME_SECTOR) {
            return FAT32_RUNTIME_SECTOR.virtual_address;
        }
    }
    let buffer = dma_alloc(FAT32_RUNTIME_BUFFER_SIZE, DMA_DEFAULT_ALIGNMENT);
    if !dma_buffer_cpu_owned(&buffer) { return null as *mut u8; }
    unsafe {
        FAT32_RUNTIME_SECTOR = buffer;
        return FAT32_RUNTIME_SECTOR.virtual_address;
    }
}

@system
fn fat32_runtime_backup_sector_buffer() -> *mut u8 {
    unsafe {
        if dma_buffer_cpu_owned(&FAT32_RUNTIME_BACKUP_SECTOR) {
            return FAT32_RUNTIME_BACKUP_SECTOR.virtual_address;
        }
    }
    let buffer = dma_alloc(FAT32_RUNTIME_BUFFER_SIZE, DMA_DEFAULT_ALIGNMENT);
    if !dma_buffer_cpu_owned(&buffer) { return null as *mut u8; }
    unsafe {
        FAT32_RUNTIME_BACKUP_SECTOR = buffer;
        return FAT32_RUNTIME_BACKUP_SECTOR.virtual_address;
    }
}

@system
fn fat32_choose_sectors_per_cluster(bytes_per_sector: u32, total_sectors: u64) -> u32 {
    let total_bytes = total_sectors * (bytes_per_sector as u64);
    let cluster_bytes: u32 = if total_bytes <= 8589934592 {
        4096
    } else if total_bytes <= 17179869184 {
        8192
    } else if total_bytes <= 34359738368 {
        16384
    } else {
        32768
    };

    let mut spc = cluster_bytes / bytes_per_sector;
    if spc == 0 { spc = 1; }
    if spc > 128 { spc = 128; }
    if !fat32_is_power_of_two(spc) { return 0; }
    return spc;
}

@system
pub fn fat32_plan_layout(bytes_per_sector: u32, total_sectors: u64) -> Fat32Layout {
    let mut out = Fat32Layout {
        valid: false,
        bytes_per_sector: bytes_per_sector,
        sectors_per_cluster: 0,
        reserved_sectors: FAT32_RESERVED_SECTORS,
        fat_count: FAT32_FAT_COUNT,
        fat_size_sectors: 0,
        total_sectors: total_sectors,
        data_start_sector: 0,
        data_sectors: 0,
        cluster_count: 0,
        root_cluster: FAT32_ROOT_CLUSTER,
        fsinfo_sector: FAT32_FSINFO_SECTOR,
        backup_boot_sector: FAT32_BACKUP_BOOT_SECTOR,
    };

    if bytes_per_sector < 512 || bytes_per_sector > 4096 || !fat32_is_power_of_two(bytes_per_sector) { return out; }
    if total_sectors <= FAT32_RESERVED_SECTORS as u64 { return out; }

    let spc = fat32_choose_sectors_per_cluster(bytes_per_sector, total_sectors);
    if spc == 0 { return out; }

    let mut fat_size: u64 = 1;
    for mut pass in 0..16 {
        let overhead = (FAT32_RESERVED_SECTORS as u64) + (FAT32_FAT_COUNT as u64) * fat_size;
        if total_sectors <= overhead { return out; }
        let data_sectors = total_sectors - overhead;
        let clusters = data_sectors / (spc as u64);
        let fat_entries = clusters + 2;
        let fat_bytes = fat_entries * 4;
        let needed = (fat_bytes + (bytes_per_sector as u64) - 1) / (bytes_per_sector as u64);
        if needed == fat_size { break; }
        fat_size = needed;
    }

    let data_start = (FAT32_RESERVED_SECTORS as u64) + (FAT32_FAT_COUNT as u64) * fat_size;
    if total_sectors <= data_start { return out; }
    let data_sectors = total_sectors - data_start;
    let clusters = data_sectors / (spc as u64);

    if clusters < FAT32_MIN_CLUSTERS || clusters > FAT32_MAX_CLUSTERS { return out; }
    if fat_size > 0xFFFFFFFF { return out; }

    out.sectors_per_cluster = spc;
    out.fat_size_sectors = fat_size as u32;
    out.data_start_sector = data_start;
    out.data_sectors = data_sectors;
    out.cluster_count = clusters;
    out.valid = true;
    return out;
}

@system
fn fat32_probe_fsinfo_runtime(
    first_lba: u64,
    last_lba: u64,
    reserved_sectors: u32,
    fsinfo_sector: u32,
    cluster_count: u64
) -> bool {
    unsafe {
        FAT32_RUNTIME_FSINFO_READY = false;
        FAT32_RUNTIME_FSINFO_LBA = 0;
        FAT32_RUNTIME_FSINFO_FREE_COUNT = FAT32_FSINFO_UNKNOWN;
        FAT32_RUNTIME_FSINFO_NEXT_FREE = FAT32_FSINFO_UNKNOWN;
    }

    if !block_device_has_native_target() || block_device_block_size() != FAT32_RUNTIME_BLOCK_SIZE {
        return false;
    }
    if fsinfo_sector == 0 || fsinfo_sector >= reserved_sectors { return false; }

    let fsinfo_lba = first_lba + (fsinfo_sector as u64);
    if fsinfo_lba < first_lba || fsinfo_lba > last_lba { return false; }

    let sector = fat32_runtime_sector_buffer();
    if sector == (null as *mut u8) || !block_device_read_sector(fsinfo_lba, sector) { return false; }
    let base = sector as *const u8;
    let lead_signature = fat32_read_u32(base, 0);
    let structure_signature = fat32_read_u32(base, 484);
    let free_count = fat32_read_u32(base, 488);
    let next_free = fat32_read_u32(base, 492);
    let trail_signature = fat32_read_u32(base, 508);

    if lead_signature != FAT32_FSINFO_LEAD_SIGNATURE ||
       structure_signature != FAT32_FSINFO_STRUCT_SIGNATURE ||
       trail_signature != FAT32_FSINFO_TRAIL_SIGNATURE { return false; }
    if free_count != FAT32_FSINFO_UNKNOWN && (free_count as u64) > cluster_count { return false; }
    if next_free != FAT32_FSINFO_UNKNOWN &&
       (next_free < 2 || (next_free as u64) > cluster_count + 1) { return false; }

    unsafe {
        FAT32_RUNTIME_FSINFO_LBA = fsinfo_lba;
        FAT32_RUNTIME_FSINFO_FREE_COUNT = free_count;
        FAT32_RUNTIME_FSINFO_NEXT_FREE = next_free;
        FAT32_RUNTIME_FSINFO_READY = true;
    }
    x86_serial_write_stage_marker('u' as u8);
    return true;
}

@system
fn fat32_probe_backup_boot_runtime(
    first_lba: u64,
    last_lba: u64,
    reserved_sectors: u32,
    backup_boot_sector: u32
) -> bool {
    unsafe {
        FAT32_RUNTIME_BACKUP_BOOT_READY = false;
        FAT32_RUNTIME_BACKUP_BOOT_LBA = 0;
    }

    if !fat32_runtime_fsinfo_is_ready() || !block_device_has_native_target() ||
       block_device_block_size() != FAT32_RUNTIME_BLOCK_SIZE { return false; }
    if backup_boot_sector == 0 || backup_boot_sector >= reserved_sectors { return false; }

    let backup_lba = first_lba + (backup_boot_sector as u64);
    if backup_lba < first_lba || backup_lba > last_lba { return false; }

    let primary_sector = fat32_runtime_sector_buffer();
    let backup_sector = fat32_runtime_backup_sector_buffer();
    if primary_sector == (null as *mut u8) || backup_sector == (null as *mut u8) { return false; }
    if !block_device_read_sector(first_lba, primary_sector) { return false; }
    if !block_device_read_sector(backup_lba, backup_sector) { return false; }

    let primary = primary_sector as *const u8;
    let backup = backup_sector as *const u8;
    if fat32_read_u8(primary, 510) != 0x55 || fat32_read_u8(primary, 511) != 0xAA ||
       fat32_read_u8(backup, 510) != 0x55 || fat32_read_u8(backup, 511) != 0xAA { return false; }

    let mut offset: usize = 0;
    while offset < (FAT32_RUNTIME_BLOCK_SIZE as usize) {
        if fat32_read_u8(primary, offset) != fat32_read_u8(backup, offset) { return false; }
        offset += 1;
    }

    unsafe {
        FAT32_RUNTIME_BACKUP_BOOT_LBA = backup_lba;
        FAT32_RUNTIME_BACKUP_BOOT_READY = true;
    }
    x86_serial_write_stage_marker('z' as u8);
    return true;
}

@system
fn fat32_probe_fat_head_runtime(
    first_lba: u64,
    last_lba: u64,
    reserved_sectors: u32,
    fat_count: u32,
    fat_size_sectors: u32,
    root_cluster: u32,
    cluster_count: u64
) -> bool {
    if !fat32_runtime_backup_boot_is_ready() || !block_device_has_native_target() ||
       block_device_block_size() != FAT32_RUNTIME_BLOCK_SIZE { return false; }
    if fat_count != 2 || fat_size_sectors == 0 || root_cluster < 2 { return false; }

    let fat0_lba = first_lba + (reserved_sectors as u64);
    let fat1_lba = fat0_lba + (fat_size_sectors as u64);
    if fat0_lba < first_lba || fat0_lba > last_lba || fat1_lba <= fat0_lba || fat1_lba > last_lba {
        return false;
    }
    let fat1_last_lba = fat1_lba + (fat_size_sectors as u64) - 1;
    if fat1_last_lba < fat1_lba || fat1_last_lba > last_lba { return false; }

    let fat0_sector = fat32_runtime_sector_buffer();
    let fat1_sector = fat32_runtime_backup_sector_buffer();
    if fat0_sector == (null as *mut u8) || fat1_sector == (null as *mut u8) { return false; }
    if !block_device_read_sector(fat0_lba, fat0_sector) ||
       !block_device_read_sector(fat1_lba, fat1_sector) { return false; }

    let fat0 = fat0_sector as *const u8;
    let fat1 = fat1_sector as *const u8;
    let mut offset: usize = 0;
    while offset < (FAT32_RUNTIME_BLOCK_SIZE as usize) {
        if fat32_read_u8(fat0, offset) != fat32_read_u8(fat1, offset) { return false; }
        offset += 1;
    }

    let entry0 = fat32_read_u32(fat0, 0) & FAT32_ENTRY_MASK;
    let entry1 = fat32_read_u32(fat0, 4) & FAT32_ENTRY_MASK;
    if (entry0 & 0x0FFFFF00) != 0x0FFFFF00 || (entry0 & 0xFF) < 0xF0 ||
       entry1 < FAT32_EOC_MIN { return false; }

    let entries_per_sector: u32 = FAT32_RUNTIME_BLOCK_SIZE / 4;
    let root_sector_index = root_cluster / entries_per_sector;
    if root_sector_index >= fat_size_sectors { return false; }
    let root_offset = ((root_cluster % entries_per_sector) * 4) as usize;
    let root_fat0_lba = fat0_lba + (root_sector_index as u64);
    let root_fat1_lba = fat1_lba + (root_sector_index as u64);
    if root_fat0_lba > last_lba || root_fat1_lba > last_lba { return false; }

    if !block_device_read_sector(root_fat0_lba, fat0_sector) ||
       !block_device_read_sector(root_fat1_lba, fat1_sector) { return false; }
    let root_fat0 = fat0_sector as *const u8;
    let root_fat1 = fat1_sector as *const u8;
    offset = 0;
    while offset < (FAT32_RUNTIME_BLOCK_SIZE as usize) {
        if fat32_read_u8(root_fat0, offset) != fat32_read_u8(root_fat1, offset) { return false; }
        offset += 1;
    }

    let root_next = fat32_read_u32(root_fat0, root_offset) & FAT32_ENTRY_MASK;
    if root_next < FAT32_EOC_MIN &&
       (root_next < 2 || (root_next as u64) > cluster_count + 1) { return false; }

    x86_serial_write_stage_marker('x' as u8);
    return true;
}

@system
fn fat32_probe_root_directory_cluster_runtime(
    last_lba: u64,
    data_start_lba: u64,
    sectors_per_cluster: u32,
    root_cluster: u32,
    cluster_count: u64
) -> bool {
    if !block_device_has_native_target() || block_device_block_size() != FAT32_RUNTIME_BLOCK_SIZE {
        return false;
    }
    if sectors_per_cluster == 0 || root_cluster < 2 ||
       (root_cluster as u64) > cluster_count + 1 { return false; }

    let cluster_index = (root_cluster as u64) - 2;
    if cluster_index >= cluster_count { return false; }
    let cluster_offset = cluster_index * (sectors_per_cluster as u64);
    let root_lba = data_start_lba + cluster_offset;
    if root_lba < data_start_lba || root_lba > last_lba { return false; }
    let root_last_lba = root_lba + (sectors_per_cluster as u64) - 1;
    if root_last_lba < root_lba || root_last_lba > last_lba { return false; }

    let sector = fat32_runtime_sector_buffer();
    if sector == (null as *mut u8) { return false; }

    let mut sector_index: u32 = 0;
    let mut saw_directory_end = false;
    while sector_index < sectors_per_cluster {
        let lba = root_lba + (sector_index as u64);
        if lba > root_last_lba || !block_device_read_sector(lba, sector) { return false; }
        let base = sector as *const u8;
        let mut offset: usize = 0;
        while offset < (FAT32_RUNTIME_BLOCK_SIZE as usize) {
            let first = fat32_read_u8(base, offset);
            if first == 0 {
                saw_directory_end = true;
                break;
            }
            if first != 0xE5 {
                let attributes = fat32_read_u8(base, offset + 11);
                if (attributes & 0xC0) != 0 { return false; }
            }
            offset += 32;
        }
        if saw_directory_end { break; }
        sector_index += 1;
    }
    if !saw_directory_end { return false; }

    x86_serial_write_stage_marker('o' as u8);
    return true;
}

// Lê novamente o RootCluster e publica a primeira entrada 8.3 de arquivo regular
// não vazio. LFN, volume labels, diretórios e entradas deletadas são ignorados.
// O cluster inicial e o tamanho vêm dos bytes reais da entrada de diretório.
@system
fn fat32_probe_first_root_file_entry_runtime(
    last_lba: u64,
    data_start_lba: u64,
    sectors_per_cluster: u32,
    root_cluster: u32,
    cluster_count: u64
) -> bool {
    unsafe {
        FAT32_RUNTIME_ROOT_FILE_READY = false;
        FAT32_RUNTIME_ROOT_FILE_ENTRY_LBA = 0;
        FAT32_RUNTIME_ROOT_FILE_ENTRY_OFFSET = 0;
        FAT32_RUNTIME_ROOT_FILE_FIRST_CLUSTER = 0;
        FAT32_RUNTIME_ROOT_FILE_SIZE = 0;
        FAT32_RUNTIME_ROOT_FILE_ATTRIBUTES = 0;
    }

    if !block_device_has_native_target() || block_device_block_size() != FAT32_RUNTIME_BLOCK_SIZE {
        return false;
    }
    if sectors_per_cluster == 0 || root_cluster < 2 ||
       (root_cluster as u64) > cluster_count + 1 { return false; }

    let root_index = (root_cluster as u64) - 2;
    if root_index >= cluster_count { return false; }
    let root_lba = data_start_lba + root_index * (sectors_per_cluster as u64);
    if root_lba < data_start_lba || root_lba > last_lba { return false; }
    let root_last_lba = root_lba + (sectors_per_cluster as u64) - 1;
    if root_last_lba < root_lba || root_last_lba > last_lba { return false; }

    let sector = fat32_runtime_sector_buffer();
    if sector == (null as *mut u8) { return false; }

    let mut sector_index: u32 = 0;
    while sector_index < sectors_per_cluster {
        let lba = root_lba + (sector_index as u64);
        if lba > root_last_lba || !block_device_read_sector(lba, sector) { return false; }
        let base = sector as *const u8;
        let mut offset: usize = 0;
        while offset < (FAT32_RUNTIME_BLOCK_SIZE as usize) {
            let first = fat32_read_u8(base, offset);
            if first == 0 { return false; }
            if first != 0xE5 {
                let attributes = fat32_read_u8(base, offset + 11);
                if (attributes & 0xC0) != 0 { return false; }
                if attributes != FAT32_ATTR_LONG_NAME &&
                   (attributes & (FAT32_ATTR_VOLUME_ID | FAT32_ATTR_DIRECTORY)) == 0 {
                    let mut name_index: usize = 0;
                    let mut has_name = false;
                    while name_index < 11 {
                        if fat32_read_u8(base, offset + name_index) != 0x20 {
                            has_name = true;
                        }
                        name_index += 1;
                    }
                    if !has_name { return false; }

                    let high = fat32_read_u16(base, offset + 20) as u32;
                    let low = fat32_read_u16(base, offset + 26) as u32;
                    let first_cluster = (high << 16) | low;
                    let file_size = fat32_read_u32(base, offset + 28);
                    if file_size == 0 || first_cluster < 2 ||
                       (first_cluster as u64) > cluster_count + 1 { return false; }

                    let file_index = (first_cluster as u64) - 2;
                    if file_index >= cluster_count { return false; }
                    let file_lba = data_start_lba + file_index * (sectors_per_cluster as u64);
                    if file_lba < data_start_lba || file_lba > last_lba { return false; }
                    let file_last_lba = file_lba + (sectors_per_cluster as u64) - 1;
                    if file_last_lba < file_lba || file_last_lba > last_lba { return false; }

                    unsafe {
                        FAT32_RUNTIME_ROOT_FILE_ENTRY_LBA = lba;
                        FAT32_RUNTIME_ROOT_FILE_ENTRY_OFFSET = offset as u32;
                        FAT32_RUNTIME_ROOT_FILE_FIRST_CLUSTER = first_cluster;
                        FAT32_RUNTIME_ROOT_FILE_SIZE = file_size;
                        FAT32_RUNTIME_ROOT_FILE_ATTRIBUTES = attributes as u32;
                        FAT32_RUNTIME_ROOT_FILE_READY = true;
                    }
                    x86_serial_write_stage_marker('l' as u8);
                    return true;
                }
            }
            offset += 32;
        }
        sector_index += 1;
    }
    return false;
}

// Lê o payload do primeiro arquivo regular encontrado no diretório raiz. Este
// gate é deliberadamente de arquivo de um único cluster: percorre os setores
// necessários pela Block Device API e calcula CRC32 somente sobre file_size bytes.
// O valor é emitido no serial antes do STEP=_ para a CI comparar com o disco raw.
@system
fn fat32_probe_root_file_content_runtime(
    last_lba: u64,
    data_start_lba: u64,
    sectors_per_cluster: u32,
    cluster_count: u64
) -> bool {
    unsafe {
        FAT32_RUNTIME_ROOT_FILE_CONTENT_READY = false;
        FAT32_RUNTIME_ROOT_FILE_CONTENT_BYTES = 0;
        FAT32_RUNTIME_ROOT_FILE_CONTENT_CRC32 = 0;
    }

    if !fat32_runtime_root_file_is_ready() || !block_device_has_native_target() ||
       block_device_block_size() != FAT32_RUNTIME_BLOCK_SIZE { return false; }
    if sectors_per_cluster == 0 { return false; }

    let first_cluster = fat32_runtime_root_file_first_cluster();
    let file_size = fat32_runtime_root_file_size();
    if first_cluster < 2 || file_size == 0 ||
       (first_cluster as u64) > cluster_count + 1 { return false; }

    let cluster_bytes = (sectors_per_cluster as u64) * (FAT32_RUNTIME_BLOCK_SIZE as u64);
    if (file_size as u64) > cluster_bytes { return false; }

    let file_index = (first_cluster as u64) - 2;
    if file_index >= cluster_count { return false; }
    let file_lba = data_start_lba + file_index * (sectors_per_cluster as u64);
    if file_lba < data_start_lba || file_lba > last_lba { return false; }
    let file_last_lba = file_lba + (sectors_per_cluster as u64) - 1;
    if file_last_lba < file_lba || file_last_lba > last_lba { return false; }

    let sector = fat32_runtime_sector_buffer();
    if sector == (null as *mut u8) { return false; }

    let mut crc = crc32_ieee_begin();
    let mut remaining = file_size as u64;
    let mut sector_index: u32 = 0;
    while remaining > 0 {
        if sector_index >= sectors_per_cluster { return false; }
        let lba = file_lba + (sector_index as u64);
        if lba > file_last_lba || !block_device_read_sector(lba, sector) { return false; }
        let bytes_this_sector: u64 = if remaining > (FAT32_RUNTIME_BLOCK_SIZE as u64) {
            FAT32_RUNTIME_BLOCK_SIZE as u64
        } else {
            remaining
        };
        crc = crc32_ieee_update(crc, sector as *const u8, bytes_this_sector as usize);
        remaining -= bytes_this_sector;
        sector_index += 1;
    }

    let computed = crc32_ieee_finish(crc);
    unsafe {
        FAT32_RUNTIME_ROOT_FILE_CONTENT_BYTES = file_size;
        FAT32_RUNTIME_ROOT_FILE_CONTENT_CRC32 = computed;
        FAT32_RUNTIME_ROOT_FILE_CONTENT_READY = true;
    }
    if !x86_serial_write_hex32_marker('_' as u8, computed) { return false; }
    x86_serial_write_stage_marker('_' as u8);
    return true;
}

@system
pub fn fat32_probe_esp_bpb() -> bool {
    unsafe {
        FAT32_RUNTIME_READY = false;
        FAT32_RUNTIME_PARTITION_FIRST_LBA = 0;
        FAT32_RUNTIME_PARTITION_LAST_LBA = 0;
        FAT32_RUNTIME_TOTAL_SECTORS = 0;
        FAT32_RUNTIME_BYTES_PER_SECTOR = 0;
        FAT32_RUNTIME_SECTORS_PER_CLUSTER = 0;
        FAT32_RUNTIME_RESERVED_SECTORS = 0;
        FAT32_RUNTIME_FAT_COUNT = 0;
        FAT32_RUNTIME_FAT_SIZE_SECTORS = 0;
        FAT32_RUNTIME_DATA_START_LBA = 0;
        FAT32_RUNTIME_CLUSTER_COUNT = 0;
        FAT32_RUNTIME_ROOT_CLUSTER = 0;
        FAT32_RUNTIME_FSINFO_SECTOR = 0;
        FAT32_RUNTIME_BACKUP_BOOT_SECTOR = 0;
        FAT32_RUNTIME_FSINFO_READY = false;
        FAT32_RUNTIME_FSINFO_LBA = 0;
        FAT32_RUNTIME_FSINFO_FREE_COUNT = FAT32_FSINFO_UNKNOWN;
        FAT32_RUNTIME_FSINFO_NEXT_FREE = FAT32_FSINFO_UNKNOWN;
        FAT32_RUNTIME_BACKUP_BOOT_READY = false;
        FAT32_RUNTIME_BACKUP_BOOT_LBA = 0;
        FAT32_RUNTIME_ROOT_FILE_READY = false;
        FAT32_RUNTIME_ROOT_FILE_ENTRY_LBA = 0;
        FAT32_RUNTIME_ROOT_FILE_ENTRY_OFFSET = 0;
        FAT32_RUNTIME_ROOT_FILE_FIRST_CLUSTER = 0;
        FAT32_RUNTIME_ROOT_FILE_SIZE = 0;
        FAT32_RUNTIME_ROOT_FILE_ATTRIBUTES = 0;
        FAT32_RUNTIME_ROOT_FILE_CONTENT_READY = false;
        FAT32_RUNTIME_ROOT_FILE_CONTENT_BYTES = 0;
        FAT32_RUNTIME_ROOT_FILE_CONTENT_CRC32 = 0;
    }

    if !gpt_partition_is_ready() || !block_device_has_native_target() ||
       block_device_block_size() != FAT32_RUNTIME_BLOCK_SIZE { return false; }

    let first_lba = gpt_partition_first_lba();
    let last_lba = gpt_partition_last_lba();
    if first_lba == 0 || last_lba < first_lba || last_lba > block_device_last_lba() {
        return false;
    }
    let partition_sectors = last_lba - first_lba + 1;

    let sector = fat32_runtime_sector_buffer();
    if sector == (null as *mut u8) || !block_device_read_sector(first_lba, sector) { return false; }
    let base = sector as *const u8;
    let jump = fat32_read_u8(base, 0);
    if jump != 0xEB && jump != 0xE9 { return false; }
    if fat32_read_u8(base, 510) != 0x55 || fat32_read_u8(base, 511) != 0xAA { return false; }

    let bytes_per_sector = fat32_read_u16(base, 11) as u32;
    let sectors_per_cluster = fat32_read_u8(base, 13) as u32;
    let reserved_sectors = fat32_read_u16(base, 14) as u32;
    let fat_count = fat32_read_u8(base, 16) as u32;
    let root_entry_count = fat32_read_u16(base, 17) as u32;
    let total_sectors16 = fat32_read_u16(base, 19) as u32;
    let fat_size16 = fat32_read_u16(base, 22) as u32;
    let total_sectors32 = fat32_read_u32(base, 32);
    let fat_size32 = fat32_read_u32(base, 36);
    let fs_version = fat32_read_u16(base, 42) as u32;
    let root_cluster = fat32_read_u32(base, 44);
    let fsinfo_sector = fat32_read_u16(base, 48) as u32;
    let backup_boot_sector = fat32_read_u16(base, 50) as u32;

    if bytes_per_sector != block_device_block_size() ||
       sectors_per_cluster == 0 || sectors_per_cluster > 128 ||
       !fat32_is_power_of_two(sectors_per_cluster) || reserved_sectors == 0 ||
       fat_count == 0 || fat_count > 2 || root_entry_count != 0 ||
       total_sectors16 != 0 || fat_size16 != 0 || total_sectors32 == 0 ||
       fat_size32 == 0 || fs_version != 0 || root_cluster < 2 { return false; }
    if fsinfo_sector == 0 || fsinfo_sector >= reserved_sectors ||
       backup_boot_sector == 0 || backup_boot_sector >= reserved_sectors { return false; }

    let total_sectors = total_sectors32 as u64;
    if total_sectors > partition_sectors { return false; }
    let overhead = (reserved_sectors as u64) + (fat_count as u64) * (fat_size32 as u64);
    if total_sectors <= overhead { return false; }
    let data_sectors = total_sectors - overhead;
    let cluster_count = data_sectors / (sectors_per_cluster as u64);
    if cluster_count < FAT32_MIN_CLUSTERS || cluster_count > FAT32_MAX_CLUSTERS { return false; }
    if (root_cluster as u64) > cluster_count + 1 { return false; }

    let data_start_lba = first_lba + overhead;
    if data_start_lba > last_lba || first_lba + total_sectors - 1 > last_lba { return false; }

    unsafe {
        FAT32_RUNTIME_PARTITION_FIRST_LBA = first_lba;
        FAT32_RUNTIME_PARTITION_LAST_LBA = last_lba;
        FAT32_RUNTIME_TOTAL_SECTORS = total_sectors;
        FAT32_RUNTIME_BYTES_PER_SECTOR = bytes_per_sector;
        FAT32_RUNTIME_SECTORS_PER_CLUSTER = sectors_per_cluster;
        FAT32_RUNTIME_RESERVED_SECTORS = reserved_sectors;
        FAT32_RUNTIME_FAT_COUNT = fat_count;
        FAT32_RUNTIME_FAT_SIZE_SECTORS = fat_size32;
        FAT32_RUNTIME_DATA_START_LBA = data_start_lba;
        FAT32_RUNTIME_CLUSTER_COUNT = cluster_count;
        FAT32_RUNTIME_ROOT_CLUSTER = root_cluster;
        FAT32_RUNTIME_FSINFO_SECTOR = fsinfo_sector;
        FAT32_RUNTIME_BACKUP_BOOT_SECTOR = backup_boot_sector;
        FAT32_RUNTIME_READY = true;
    }
    x86_serial_write_stage_marker('y' as u8);

    if !fat32_probe_fsinfo_runtime(
        first_lba,
        last_lba,
        reserved_sectors,
        fsinfo_sector,
        cluster_count
    ) { return false; }
    if !fat32_probe_backup_boot_runtime(
        first_lba,
        last_lba,
        reserved_sectors,
        backup_boot_sector
    ) { return false; }
    if !fat32_probe_fat_head_runtime(
        first_lba,
        last_lba,
        reserved_sectors,
        fat_count,
        fat_size32,
        root_cluster,
        cluster_count
    ) { return false; }
    if !fat32_probe_root_directory_cluster_runtime(
        last_lba,
        data_start_lba,
        sectors_per_cluster,
        root_cluster,
        cluster_count
    ) { return false; }
    if !fat32_probe_first_root_file_entry_runtime(
        last_lba,
        data_start_lba,
        sectors_per_cluster,
        root_cluster,
        cluster_count
    ) || !fat32_runtime_root_file_is_ready() { return false; }
    if !fat32_probe_root_file_content_runtime(
        last_lba,
        data_start_lba,
        sectors_per_cluster,
        cluster_count
    ) || !fat32_runtime_root_file_content_is_ready() { return false; }
    return true;
}

@system
pub fn fat32_runtime_is_ready() -> bool { unsafe { return FAT32_RUNTIME_READY; } }
@system
pub fn fat32_runtime_partition_first_lba() -> u64 { unsafe { return FAT32_RUNTIME_PARTITION_FIRST_LBA; } }
@system
pub fn fat32_runtime_partition_last_lba() -> u64 { unsafe { return FAT32_RUNTIME_PARTITION_LAST_LBA; } }
@system
pub fn fat32_runtime_total_sectors() -> u64 { unsafe { return FAT32_RUNTIME_TOTAL_SECTORS; } }
@system
pub fn fat32_runtime_bytes_per_sector() -> u32 { unsafe { return FAT32_RUNTIME_BYTES_PER_SECTOR; } }
@system
pub fn fat32_runtime_sectors_per_cluster() -> u32 { unsafe { return FAT32_RUNTIME_SECTORS_PER_CLUSTER; } }
@system
pub fn fat32_runtime_reserved_sectors() -> u32 { unsafe { return FAT32_RUNTIME_RESERVED_SECTORS; } }
@system
pub fn fat32_runtime_fat_count() -> u32 { unsafe { return FAT32_RUNTIME_FAT_COUNT; } }
@system
pub fn fat32_runtime_fat_size_sectors() -> u32 { unsafe { return FAT32_RUNTIME_FAT_SIZE_SECTORS; } }
@system
pub fn fat32_runtime_data_start_lba() -> u64 { unsafe { return FAT32_RUNTIME_DATA_START_LBA; } }
@system
pub fn fat32_runtime_cluster_count() -> u64 { unsafe { return FAT32_RUNTIME_CLUSTER_COUNT; } }
@system
pub fn fat32_runtime_root_cluster() -> u32 { unsafe { return FAT32_RUNTIME_ROOT_CLUSTER; } }
@system
pub fn fat32_runtime_fsinfo_sector() -> u32 { unsafe { return FAT32_RUNTIME_FSINFO_SECTOR; } }
@system
pub fn fat32_runtime_backup_boot_sector() -> u32 { unsafe { return FAT32_RUNTIME_BACKUP_BOOT_SECTOR; } }
@system
pub fn fat32_runtime_fsinfo_is_ready() -> bool { unsafe { return FAT32_RUNTIME_FSINFO_READY; } }
@system
pub fn fat32_runtime_fsinfo_lba() -> u64 { unsafe { return FAT32_RUNTIME_FSINFO_LBA; } }
@system
pub fn fat32_runtime_fsinfo_free_count() -> u32 { unsafe { return FAT32_RUNTIME_FSINFO_FREE_COUNT; } }
@system
pub fn fat32_runtime_fsinfo_next_free() -> u32 { unsafe { return FAT32_RUNTIME_FSINFO_NEXT_FREE; } }
@system
pub fn fat32_runtime_backup_boot_is_ready() -> bool { unsafe { return FAT32_RUNTIME_BACKUP_BOOT_READY; } }
@system
pub fn fat32_runtime_backup_boot_lba() -> u64 { unsafe { return FAT32_RUNTIME_BACKUP_BOOT_LBA; } }
@system
pub fn fat32_runtime_root_file_is_ready() -> bool { unsafe { return FAT32_RUNTIME_ROOT_FILE_READY; } }
@system
pub fn fat32_runtime_root_file_entry_lba() -> u64 { unsafe { return FAT32_RUNTIME_ROOT_FILE_ENTRY_LBA; } }
@system
pub fn fat32_runtime_root_file_entry_offset() -> u32 { unsafe { return FAT32_RUNTIME_ROOT_FILE_ENTRY_OFFSET; } }
@system
pub fn fat32_runtime_root_file_first_cluster() -> u32 { unsafe { return FAT32_RUNTIME_ROOT_FILE_FIRST_CLUSTER; } }
@system
pub fn fat32_runtime_root_file_size() -> u32 { unsafe { return FAT32_RUNTIME_ROOT_FILE_SIZE; } }
@system
pub fn fat32_runtime_root_file_attributes() -> u32 { unsafe { return FAT32_RUNTIME_ROOT_FILE_ATTRIBUTES; } }
@system
pub fn fat32_runtime_root_file_content_is_ready() -> bool { unsafe { return FAT32_RUNTIME_ROOT_FILE_CONTENT_READY; } }
@system
pub fn fat32_runtime_root_file_content_bytes() -> u32 { unsafe { return FAT32_RUNTIME_ROOT_FILE_CONTENT_BYTES; } }
@system
pub fn fat32_runtime_root_file_content_crc32() -> u32 { unsafe { return FAT32_RUNTIME_ROOT_FILE_CONTENT_CRC32; } }
