// Baken OS — planejamento e leitura GPT nativos independentes de firmware.
//
// A geometria continua pura e reutilizável. O runtime lê o backup GPT Header e
// o Partition Entry Array pelo Block Device API já provado; não usa UEFI Block
// I/O e não grava armazenamento.

module kernel::storage::gpt;

import kernel::storage::crc32::*;
import kernel::storage::block_device::*;
import kernel::memory::dma::*;

pub const GPT_HEADER_MIN_SIZE: u32 = 92;
pub const GPT_DEFAULT_ENTRY_SIZE: u32 = 128;
pub const GPT_DEFAULT_ENTRY_COUNT: u32 = 128;
pub const GPT_MIN_USABLE_ALIGNMENT_BYTES: u64 = 1048576;
pub const GPT_RUNTIME_BLOCK_SIZE: u32 = 512;
pub const GPT_RUNTIME_BUFFER_SIZE: u64 = 4096;
pub const GPT_REVISION_1_0: u32 = 0x00010000;

static mut GPT_RUNTIME_READY: bool = false;
static mut GPT_RUNTIME_ENTRIES_READY: bool = false;
static mut GPT_RUNTIME_CURRENT_LBA: u64 = 0;
static mut GPT_RUNTIME_BACKUP_LBA: u64 = 0;
static mut GPT_RUNTIME_FIRST_USABLE_LBA: u64 = 0;
static mut GPT_RUNTIME_LAST_USABLE_LBA: u64 = 0;
static mut GPT_RUNTIME_ENTRIES_LBA: u64 = 0;
static mut GPT_RUNTIME_ENTRY_COUNT: u32 = 0;
static mut GPT_RUNTIME_ENTRY_SIZE: u32 = 0;
static mut GPT_RUNTIME_ENTRIES_CRC32: u32 = 0;
static mut GPT_RUNTIME_ENTRIES_CRC32_COMPUTED: u32 = 0;
static mut GPT_RUNTIME_SECTOR: DmaBuffer = DmaBuffer {
    virtual_address: null as *mut u8,
    physical_address: 0,
    size: 0,
    alignment: 0,
    owner: DMA_OWNER_CPU,
    fence: 0,
    valid: false
};

pub struct GptLayout {
    pub valid: bool;
    pub block_size: u32;
    pub total_lbas: u64;
    pub primary_header_lba: u64;
    pub primary_entries_lba: u64;
    pub primary_entries_blocks: u64;
    pub first_usable_lba: u64;
    pub last_usable_lba: u64;
    pub backup_entries_lba: u64;
    pub backup_header_lba: u64;
    pub entry_count: u32;
    pub entry_size: u32;
}

@system
fn gpt_div_ceil_u64(value: u64, divisor: u64) -> u64 {
    if divisor == 0 { return 0; }
    return (value + divisor - 1) / divisor;
}

@system
fn gpt_align_up_lba(lba: u64, block_size: u32, alignment_bytes: u64) -> u64 {
    if block_size == 0 || alignment_bytes == 0 { return lba; }
    let alignment_lbas = gpt_div_ceil_u64(alignment_bytes, block_size as u64);
    if alignment_lbas <= 1 { return lba; }
    return gpt_div_ceil_u64(lba, alignment_lbas) * alignment_lbas;
}

@system
fn gpt_read_u32(base: *const u8, offset: usize) -> u32 {
    if base == (null as *const u8) { return 0; }
    unsafe {
        return (base[offset] as u32) |
            ((base[offset + 1] as u32) << 8) |
            ((base[offset + 2] as u32) << 16) |
            ((base[offset + 3] as u32) << 24);
    }
}

@system
fn gpt_read_u64(base: *const u8, offset: usize) -> u64 {
    if base == (null as *const u8) { return 0; }
    let low = gpt_read_u32(base, offset) as u64;
    let high = gpt_read_u32(base, offset + 4) as u64;
    return low | (high << 32);
}

@system
fn gpt_runtime_sector_buffer() -> *mut u8 {
    unsafe {
        if dma_buffer_cpu_owned(&GPT_RUNTIME_SECTOR) {
            return GPT_RUNTIME_SECTOR.virtual_address;
        }
    }
    let buffer = dma_alloc(GPT_RUNTIME_BUFFER_SIZE, DMA_DEFAULT_ALIGNMENT);
    if !dma_buffer_cpu_owned(&buffer) { return null as *mut u8; }
    unsafe {
        GPT_RUNTIME_SECTOR = buffer;
        return GPT_RUNTIME_SECTOR.virtual_address;
    }
}

@system
pub fn gpt_plan_layout(block_size: u32, last_lba: u64, entry_count: u32, entry_size: u32) -> GptLayout {
    let mut result = GptLayout {
        valid: false,
        block_size: block_size,
        total_lbas: if last_lba < 0xFFFFFFFFFFFFFFFF { last_lba + 1 } else { 0 },
        primary_header_lba: 1,
        primary_entries_lba: 2,
        primary_entries_blocks: 0,
        first_usable_lba: 0,
        last_usable_lba: 0,
        backup_entries_lba: 0,
        backup_header_lba: last_lba,
        entry_count: entry_count,
        entry_size: entry_size,
    };

    if block_size < 512 || entry_count == 0 || entry_size < GPT_DEFAULT_ENTRY_SIZE { return result; }
    if (entry_size % 8) != 0 { return result; }
    if last_lba < 16 { return result; }

    let entries_bytes = (entry_count as u64) * (entry_size as u64);
    let entries_blocks = gpt_div_ceil_u64(entries_bytes, block_size as u64);
    if entries_blocks == 0 { return result; }

    // Protective MBR ocupa LBA0, primary header LBA1 e array inicia no LBA2.
    let first_after_primary = 2 + entries_blocks;
    let first_usable = gpt_align_up_lba(first_after_primary, block_size, GPT_MIN_USABLE_ALIGNMENT_BYTES);

    // Backup header fica no último LBA e o backup entry array imediatamente
    // antes dele. Não assumimos 512 B nem os LBAs fixos 2..33.
    if last_lba <= entries_blocks + 1 { return result; }
    let backup_entries = last_lba - entries_blocks;
    if backup_entries <= first_usable { return result; }

    let last_usable = backup_entries - 1;
    if last_usable <= first_usable { return result; }

    result.primary_entries_blocks = entries_blocks;
    result.first_usable_lba = first_usable;
    result.last_usable_lba = last_usable;
    result.backup_entries_lba = backup_entries;
    result.valid = true;
    return result;
}

@system
pub fn gpt_plan_default(block_size: u32, last_lba: u64) -> GptLayout {
    return gpt_plan_layout(block_size, last_lba, GPT_DEFAULT_ENTRY_COUNT, GPT_DEFAULT_ENTRY_SIZE);
}

@system
pub fn gpt_crc32(data: *const u8, length: usize) -> u32 {
    return crc32_ieee(data, length);
}

// Lê o backup header no último LBA através do dispatch genérico de bloco e
// valida assinatura, revisão, geometria e Header CRC32. O array de entradas é
// validado separadamente para que cada gate tenha uma prova de hardware clara.
@system
pub fn gpt_probe_backup_header() -> bool {
    unsafe {
        GPT_RUNTIME_READY = false;
        GPT_RUNTIME_ENTRIES_READY = false;
        GPT_RUNTIME_CURRENT_LBA = 0;
        GPT_RUNTIME_BACKUP_LBA = 0;
        GPT_RUNTIME_FIRST_USABLE_LBA = 0;
        GPT_RUNTIME_LAST_USABLE_LBA = 0;
        GPT_RUNTIME_ENTRIES_LBA = 0;
        GPT_RUNTIME_ENTRY_COUNT = 0;
        GPT_RUNTIME_ENTRY_SIZE = 0;
        GPT_RUNTIME_ENTRIES_CRC32 = 0;
        GPT_RUNTIME_ENTRIES_CRC32_COMPUTED = 0;
    }

    if !block_device_has_native_target() || block_device_block_size() != GPT_RUNTIME_BLOCK_SIZE {
        return false;
    }
    let last_lba = block_device_last_lba();
    if last_lba < 16 { return false; }

    let sector = gpt_runtime_sector_buffer();
    if sector == (null as *mut u8) { return false; }
    if !block_device_read_sector(last_lba, sector) { return false; }

    unsafe {
        if *sector != ('E' as u8) ||
           *(((sector as usize) + 1) as *const u8) != ('F' as u8) ||
           *(((sector as usize) + 2) as *const u8) != ('I' as u8) ||
           *(((sector as usize) + 3) as *const u8) != (' ' as u8) ||
           *(((sector as usize) + 4) as *const u8) != ('P' as u8) ||
           *(((sector as usize) + 5) as *const u8) != ('A' as u8) ||
           *(((sector as usize) + 6) as *const u8) != ('R' as u8) ||
           *(((sector as usize) + 7) as *const u8) != ('T' as u8) { return false; }
    }

    let base = sector as *const u8;
    let revision = gpt_read_u32(base, 8);
    let header_size = gpt_read_u32(base, 12);
    let expected_crc = gpt_read_u32(base, 16);
    let reserved = gpt_read_u32(base, 20);
    if revision != GPT_REVISION_1_0 || header_size < GPT_HEADER_MIN_SIZE ||
       header_size > GPT_RUNTIME_BLOCK_SIZE || expected_crc == 0 || reserved != 0 { return false; }

    unsafe {
        let crc0 = ((sector as usize) + 16) as *mut u8;
        let crc1 = ((sector as usize) + 17) as *mut u8;
        let crc2 = ((sector as usize) + 18) as *mut u8;
        let crc3 = ((sector as usize) + 19) as *mut u8;
        let saved16 = *crc0;
        let saved17 = *crc1;
        let saved18 = *crc2;
        let saved19 = *crc3;
        *crc0 = 0;
        *crc1 = 0;
        *crc2 = 0;
        *crc3 = 0;
        let computed_crc = gpt_crc32(base, header_size as usize);
        *crc0 = saved16;
        *crc1 = saved17;
        *crc2 = saved18;
        *crc3 = saved19;
        if computed_crc != expected_crc { return false; }
    }

    let current_lba = gpt_read_u64(base, 24);
    let backup_lba = gpt_read_u64(base, 32);
    let first_usable = gpt_read_u64(base, 40);
    let last_usable = gpt_read_u64(base, 48);
    let entries_lba = gpt_read_u64(base, 72);
    let entry_count = gpt_read_u32(base, 80);
    let entry_size = gpt_read_u32(base, 84);
    let entries_crc32 = gpt_read_u32(base, 88);

    if current_lba != last_lba || backup_lba != 1 { return false; }
    if first_usable < 2 || first_usable > last_usable || last_usable >= current_lba { return false; }
    if entries_lba <= last_usable || entries_lba >= current_lba { return false; }
    if entry_count == 0 || entry_size < GPT_DEFAULT_ENTRY_SIZE || (entry_size % 8) != 0 { return false; }

    let entries_bytes = (entry_count as u64) * (entry_size as u64);
    let entries_blocks = gpt_div_ceil_u64(entries_bytes, GPT_RUNTIME_BLOCK_SIZE as u64);
    if entries_blocks == 0 || entries_blocks > (current_lba - entries_lba) { return false; }
    if entries_lba + entries_blocks != current_lba { return false; }

    unsafe {
        GPT_RUNTIME_CURRENT_LBA = current_lba;
        GPT_RUNTIME_BACKUP_LBA = backup_lba;
        GPT_RUNTIME_FIRST_USABLE_LBA = first_usable;
        GPT_RUNTIME_LAST_USABLE_LBA = last_usable;
        GPT_RUNTIME_ENTRIES_LBA = entries_lba;
        GPT_RUNTIME_ENTRY_COUNT = entry_count;
        GPT_RUNTIME_ENTRY_SIZE = entry_size;
        GPT_RUNTIME_ENTRIES_CRC32 = entries_crc32;
        GPT_RUNTIME_READY = true;
    }
    return true;
}

// Lê todos os bytes do backup Partition Entry Array, setor por setor, usando
// somente block_device_read_sector(). O CRC é incremental, portanto arrays
// maiores que a página de scratch não exigem buffer sintético ou firmware.
@system
pub fn gpt_probe_backup_entries() -> bool {
    unsafe {
        GPT_RUNTIME_ENTRIES_READY = false;
        GPT_RUNTIME_ENTRIES_CRC32_COMPUTED = 0;
    }
    if !gpt_runtime_is_ready() || !block_device_has_native_target() ||
       block_device_block_size() != GPT_RUNTIME_BLOCK_SIZE { return false; }

    let entries_lba = gpt_runtime_entries_lba();
    let entry_count = gpt_runtime_entry_count();
    let entry_size = gpt_runtime_entry_size();
    let current_lba = gpt_runtime_current_lba();
    if entries_lba == 0 || entry_count == 0 || entry_size == 0 || current_lba <= entries_lba {
        return false;
    }

    let entries_bytes = (entry_count as u64) * (entry_size as u64);
    if entries_bytes == 0 { return false; }
    let entries_blocks = gpt_div_ceil_u64(entries_bytes, GPT_RUNTIME_BLOCK_SIZE as u64);
    if entries_blocks == 0 || entries_lba + entries_blocks != current_lba { return false; }

    let sector = gpt_runtime_sector_buffer();
    if sector == (null as *mut u8) { return false; }

    let mut crc = crc32_ieee_begin();
    let mut remaining = entries_bytes;
    let mut block: u64 = 0;
    while block < entries_blocks {
        let lba = entries_lba + block;
        if lba >= current_lba || !block_device_read_sector(lba, sector) { return false; }
        let bytes_this_sector = if remaining > (GPT_RUNTIME_BLOCK_SIZE as u64) {
            GPT_RUNTIME_BLOCK_SIZE as u64
        } else {
            remaining
        };
        crc = crc32_ieee_update(crc, sector as *const u8, bytes_this_sector as usize);
        remaining -= bytes_this_sector;
        block += 1;
    }
    if remaining != 0 { return false; }

    let computed = crc32_ieee_finish(crc);
    let expected = unsafe { GPT_RUNTIME_ENTRIES_CRC32 };
    if computed != expected { return false; }

    unsafe {
        GPT_RUNTIME_ENTRIES_CRC32_COMPUTED = computed;
        GPT_RUNTIME_ENTRIES_READY = true;
    }
    return true;
}

@system
pub fn gpt_runtime_is_ready() -> bool { unsafe { return GPT_RUNTIME_READY; } }
@system
pub fn gpt_runtime_entries_are_ready() -> bool { unsafe { return GPT_RUNTIME_ENTRIES_READY; } }
@system
pub fn gpt_runtime_current_lba() -> u64 { unsafe { return GPT_RUNTIME_CURRENT_LBA; } }
@system
pub fn gpt_runtime_backup_lba() -> u64 { unsafe { return GPT_RUNTIME_BACKUP_LBA; } }
@system
pub fn gpt_runtime_first_usable_lba() -> u64 { unsafe { return GPT_RUNTIME_FIRST_USABLE_LBA; } }
@system
pub fn gpt_runtime_last_usable_lba() -> u64 { unsafe { return GPT_RUNTIME_LAST_USABLE_LBA; } }
@system
pub fn gpt_runtime_entries_lba() -> u64 { unsafe { return GPT_RUNTIME_ENTRIES_LBA; } }
@system
pub fn gpt_runtime_entry_count() -> u32 { unsafe { return GPT_RUNTIME_ENTRY_COUNT; } }
@system
pub fn gpt_runtime_entry_size() -> u32 { unsafe { return GPT_RUNTIME_ENTRY_SIZE; } }
@system
pub fn gpt_runtime_entries_crc32() -> u32 { unsafe { return GPT_RUNTIME_ENTRIES_CRC32; } }
@system
pub fn gpt_runtime_entries_crc32_computed() -> u32 { unsafe { return GPT_RUNTIME_ENTRIES_CRC32_COMPUTED; } }

// Protective MBR usa um campo de 32 bits para número de setores. Discos cujo
// último LBA excede o representável devem publicar 0xFFFFFFFF conforme GPT.
@system
pub fn gpt_protective_mbr_sector_count(last_lba: u64) -> u32 {
    if last_lba >= 0xFFFFFFFF { return 0xFFFFFFFF; }
    return last_lba as u32;
}
