// Read-only FAT32 lookup. Caller supplies a bounded UTF-16 path; ASCII case
// folding is supported, non-ASCII code units match exactly (no locale tables).
// No heap allocation per entry; LFN state survives sector/cluster boundaries.
module kernel::storage::fat32_path;
import kernel::storage::fat32::*;
import kernel::storage::block_device::*;
import kernel::storage::crc32::*;
import kernel::memory::dma::*;

pub struct Fat32File {
    pub valid: bool;
    pub cluster: u32;
    pub size: u32;
    pub attributes: u8;
}

@system
fn fat_path_invalid() -> Fat32File {
    return Fat32File { valid: false, cluster: 0, size: 0, attributes: 0 };
}
@system
fn fat_path_byte(base: *const u8, offset: usize) -> u8 {
    unsafe { return *(((base as usize) + offset) as *const u8); }
}
@system
fn fat_path_word(base: *const u8, offset: usize) -> u16 {
    return (fat_path_byte(base, offset) as u16) | ((fat_path_byte(base, offset + 1) as u16) << 8);
}
@system
fn fat_path_dword(base: *const u8, offset: usize) -> u32 {
    return (fat_path_word(base, offset) as u32) | ((fat_path_word(base, offset + 2) as u32) << 16);
}
@system
fn fat_path_fold(value: u16) -> u16 {
    if value >= 97 && value <= 122 { return value - 32; }
    return value;
}
@system
fn fat_path_checksum(base: *const u8) -> u8 {
    let mut value: u32 = 0;
    let mut i: usize = 0;
    while i < 11 {
        value = (((value & 1) << 7) + (value >> 1) + (fat_path_byte(base, i) as u32)) & 255;
        i += 1;
    }
    return value as u8;
}

@system
fn fat_path_find(directory: u32, name: *const u16, length: usize, buffer: *mut u8) -> Fat32File {
    if length == 0 || length > 255 || name == (null as *const u16) { return fat_path_invalid(); }
    let count = fat32_chain_length(directory);
    if count == 0 { return fat_path_invalid(); }
    let mut lfn: [u16; 260] = [0; 260];
    let offsets: [usize; 13] = [1,3,5,7,9,14,16,18,20,22,24,28,30];
    let mut expected: u8 = 0;
    let mut checksum: u8 = 0;
    let mut slots: usize = 0;
    let mut lfn_valid = false;
    let mut cluster = directory;
    let mut step: u64 = 0;
    while step < count {
        let first_lba = fat32_runtime_data_start_lba() + ((cluster as u64) - 2) * (fat32_runtime_sectors_per_cluster() as u64);
        let mut sector: u32 = 0;
        while sector < fat32_runtime_sectors_per_cluster() {
            let lba = first_lba + (sector as u64);
            if lba > fat32_runtime_partition_last_lba() || !block_device_read_sector(lba, buffer) { return fat_path_invalid(); }
            let mut offset: usize = 0;
            while offset < 512 {
                let entry = ((buffer as usize) + offset) as *const u8;
                let first = fat_path_byte(entry, 0);
                let attr = fat_path_byte(entry, 11);
                if first == 0 { return fat_path_invalid(); }
                if first == 0xE5 { lfn_valid = false; }
                else if attr == 0x0F {
                    let ordinal = first & 0x1F;
                    if (first & 0x40) != 0 {
                        lfn_valid = ordinal > 0 && ordinal <= 20;
                        expected = ordinal;
                        slots = (ordinal as usize) * 13;
                        checksum = fat_path_byte(entry, 13);
                    }
                    if ordinal == 0 || ordinal != expected || (first & 0xA0) != 0 ||
                       fat_path_byte(entry, 12) != 0 || fat_path_word(entry, 26) != 0 ||
                       fat_path_byte(entry, 13) != checksum { lfn_valid = false; }
                    if lfn_valid {
                        let mut j: usize = 0;
                        while j < 13 {
                            lfn[((ordinal as usize) - 1) * 13 + j] = fat_path_word(entry, offsets[j]);
                            j += 1;
                        }
                        expected -= 1;
                    }
                } else {
                    if (attr & 0xC8) == 0 {
                        let mut matches = false;
                        if lfn_valid && expected == 0 && checksum == fat_path_checksum(entry) {
                            let mut n: usize = 0;
                            while n < slots && lfn[n] != 0 && lfn[n] != 0xFFFF { n += 1; }
                            matches = n == length && n <= 255;
                            let mut j: usize = 0;
                            while j < slots {
                                if j < n {
                                    if j < length {
                                        unsafe {
                                            if fat_path_fold(lfn[j]) != fat_path_fold(*(((name as usize) + j * 2) as *const u16)) { matches = false; }
                                        }
                                    }
                                    // Reject unpaired UTF-16 surrogates.
                                    if lfn[j] >= 0xD800 && lfn[j] <= 0xDBFF {
                                        if j + 1 >= n { matches = false; }
                                        else if lfn[j + 1] < 0xDC00 || lfn[j + 1] > 0xDFFF { matches = false; }
                                    }
                                    if lfn[j] >= 0xDC00 && lfn[j] <= 0xDFFF {
                                        if j == 0 { matches = false; }
                                        else if lfn[j - 1] < 0xD800 || lfn[j - 1] > 0xDBFF { matches = false; }
                                    }
                                } else if j == n {
                                    if lfn[j] != 0 { matches = false; }
                                } else if lfn[j] != 0xFFFF { matches = false; }
                                j += 1;
                            }
                        }
                        // Always retain the canonical short-name alias.
                        let mut short: [u16; 12] = [0; 12];
                        let mut n: usize = 0;
                        let mut j: usize = 0;
                        while j < 8 && fat_path_byte(entry, j) != 32 {
                            short[n] = fat_path_byte(entry, j) as u16;
                            n += 1; j += 1;
                        }
                        if fat_path_byte(entry, 8) != 32 {
                            short[n] = 46; n += 1;
                            j = 8;
                            while j < 11 && fat_path_byte(entry, j) != 32 {
                                short[n] = fat_path_byte(entry, j) as u16;
                                n += 1; j += 1;
                            }
                        }
                        let mut short_matches = n == length;
                        j = 0;
                        while j < n && j < length {
                            unsafe {
                                if fat_path_fold(short[j]) != fat_path_fold(*(((name as usize) + j * 2) as *const u16)) { short_matches = false; }
                            }
                            j += 1;
                        }
                        if matches || short_matches {
                            let first_cluster = ((fat_path_word(entry, 20) as u32) << 16) | (fat_path_word(entry, 26) as u32);
                            let size = fat_path_dword(entry, 28);
                            if !fat32_data_cluster_valid(first_cluster) && !(size == 0 && first_cluster == 0 && (attr & 0x10) == 0) { return fat_path_invalid(); }
                            return Fat32File { valid: true, cluster: first_cluster, size: size, attributes: attr };
                        }
                    }
                    lfn_valid = false;
                }
                offset += 32;
            }
            sector += 1;
        }
        step += 1;
        if step < count {
            cluster = fat32_next_cluster(cluster);
            if !fat32_data_cluster_valid(cluster) { return fat_path_invalid(); }
        }
    }
    return fat_path_invalid();
}

// Absolute paths only. Reject dot traversal instead of silently escaping the
// supplied root. The length is explicit, so missing NUL cannot overread input.
@system
pub fn fat32_lookup(path: *const u16, length: usize) -> Fat32File {
    if !fat32_runtime_is_ready() || path == (null as *const u16) || length < 2 || length > 4096 { return fat_path_invalid(); }
    unsafe { if *path != 47 { return fat_path_invalid(); } }
    let mut buffer = dma_alloc(4096, 4096);
    if !dma_buffer_cpu_owned(&buffer) { return fat_path_invalid(); }
    let mut result = Fat32File { valid: true, cluster: fat32_runtime_root_cluster(), size: 0, attributes: 0x10 };
    let mut start: usize = 1;
    while start < length {
        let mut end = start;
        unsafe { while end < length && *(((path as usize) + end * 2) as *const u16) != 47 { end += 1; } }
        let n = end - start;
        let component = ((path as usize) + start * 2) as *const u16;
        let mut dot = false;
        unsafe { dot = n == 1 && *component == 46; if n == 2 && *component == 46 && *(((component as usize) + 2) as *const u16) == 46 { dot = true; } }
        if n == 0 || dot || (result.attributes & 0x10) == 0 { result = fat_path_invalid(); break; }
        result = fat_path_find(result.cluster, component, n, buffer.virtual_address);
        if !result.valid { break; }
        start = end + 1;
        if end < length && start == length && (result.attributes & 0x10) == 0 { result = fat_path_invalid(); }
    }
    if !dma_release(&mut buffer) { return fat_path_invalid(); }
    return result;
}

@system
pub fn fat32_file_crc(file: Fat32File, output: *mut u32) -> bool {
    if !file.valid || (file.attributes & 0x10) != 0 || output == (null as *mut u32) { return false; }
    if file.size == 0 { unsafe { *output = 0; } return file.cluster == 0; }
    let bytes = (fat32_runtime_sectors_per_cluster() as u64) * 512;
    if bytes == 0 || fat32_chain_length(file.cluster) != ((file.size as u64) + bytes - 1) / bytes { return false; }
    let mut buffer = dma_alloc(4096, 4096);
    if !dma_buffer_cpu_owned(&buffer) { return false; }
    let mut crc = crc32_ieee_begin();
    let mut remaining = file.size as u64;
    let mut cluster = file.cluster;
    let mut ok = true;
    while remaining > 0 && ok {
        let base = fat32_runtime_data_start_lba() + ((cluster as u64) - 2) * (fat32_runtime_sectors_per_cluster() as u64);
        let mut sector: u32 = 0;
        while sector < fat32_runtime_sectors_per_cluster() && remaining > 0 {
            if !block_device_read_sector(base + (sector as u64), buffer.virtual_address) { ok = false; break; }
            let take: u64 = if remaining < 512 { remaining } else { 512 };
            crc = crc32_ieee_update(crc, buffer.virtual_address as *const u8, take as usize);
            remaining -= take;
            sector += 1;
        }
        if remaining > 0 && ok { cluster = fat32_next_cluster(cluster); if !fat32_data_cluster_valid(cluster) { ok = false; } }
    }
    if !dma_release(&mut buffer) { return false; }
    if !ok { return false; }
    unsafe { *output = crc32_ieee_finish(crc); }
    return true;
}
