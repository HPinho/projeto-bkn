// Baken OS — entrada x86-64 executada somente após ExitBootServices.
//
// Ordem: CR3/tabelas CPU -> PMM -> VMM -> ACPI/MADT -> LAPIC/IOAPIC -> IRQs -> timer mascarado.
// STI continua proibido até fontes de IRQ serem explicitamente desmascaradas.

module kernel::arch::x86_64::post_cutover;

import kernel::arch::x86_64::cpu::*;
import kernel::arch::x86_64::gdt::*;
import kernel::arch::x86_64::tss::*;
import kernel::arch::x86_64::idt::*;
import kernel::arch::x86_64::serial::*;
import kernel::memory::mmu_activate::*;
import kernel::memory::direct_map::*;
import kernel::memory::pmm::*;
import kernel::memory::pmm_allocator::*;
import kernel::memory::vmm::*;
import kernel::memory::active_page_tables::*;
import kernel::arch::x86_64::paging::*;
import kernel::acpi::tables::*;
import kernel::acpi::madt::*;
import kernel::interrupts::lapic::*;
import kernel::interrupts::ioapic::*;
import kernel::interrupts::irq::*;
import kernel::interrupts::lapic_timer::*;
import kernel::interrupts::interrupt_enable::*;

@repr(C)
pub struct PostCutoverContext {
    pub root_physical: u64;
    pub stack_top: u64;
    pub framebuffer_base: u64;
    pub framebuffer_size: u64;
    pub screen_width: u32;
    pub screen_height: u32;
    pub pixels_per_scanline: u32;
    pub reserved0: u32;
    pub memory_map_base: u64;
    pub memory_map_size: u64;
    pub memory_descriptor_size: u64;
    pub acpi_rsdp: u64;
    pub page_table_arena_physical_base: u64;
    pub page_table_arena_page_count: u64;
    pub page_table_pages_used: u64;
    pub valid: bool;
}

static mut POST_CUTOVER_CPU_TABLES_ACTIVE: bool = false;
static mut POST_CUTOVER_PMM_ACTIVE: bool = false;
static mut POST_CUTOVER_VMM_ACTIVE: bool = false;
static mut POST_CUTOVER_ACPI_READY: bool = false;
static mut POST_CUTOVER_INTERRUPT_CONTROLLERS_READY: bool = false;
static mut POST_CUTOVER_IRQS_READY: bool = false;
static mut POST_CUTOVER_TIMER_READY: bool = false;

@system
pub fn post_cutover_memory_map_virtual(context: *const PostCutoverContext) -> *const u8 {
    if context == (null as *const PostCutoverContext) || context.memory_map_base == 0 {
        return null as *const u8;
    }
    let virtual_address = direct_map_virtual_address(context.memory_map_base);
    if virtual_address == 0 { return null as *const u8; }
    return virtual_address as *const u8;
}

@system
pub fn post_cutover_acpi_rsdp_virtual(context: *const PostCutoverContext) -> *const u8 {
    if context == (null as *const PostCutoverContext) || context.acpi_rsdp == 0 {
        return null as *const u8;
    }
    let virtual_address = direct_map_virtual_address(context.acpi_rsdp);
    if virtual_address == 0 { return null as *const u8; }
    return virtual_address as *const u8;
}

@system
pub fn post_cutover_context_valid(context: *const PostCutoverContext) -> bool {
    if context == (null as *const PostCutoverContext) { return false; }
    if !context.valid { return false; }
    if context.root_physical == 0 || !x86_page_aligned(context.root_physical) { return false; }
    if context.stack_top == 0 || (context.stack_top & 15) != 0 { return false; }
    if context.framebuffer_base == 0 || context.framebuffer_size == 0 { return false; }
    if context.screen_width == 0 || context.screen_height == 0 { return false; }
    if context.pixels_per_scanline < context.screen_width { return false; }
    if context.memory_map_base == 0 || context.memory_map_size == 0 { return false; }
    if context.memory_descriptor_size < 40 { return false; }
    if post_cutover_memory_map_virtual(context) == (null as *const u8) { return false; }
    if context.acpi_rsdp == 0 || post_cutover_acpi_rsdp_virtual(context) == (null as *const u8) { return false; }
    if context.page_table_arena_physical_base == 0 ||
       !x86_page_aligned(context.page_table_arena_physical_base) { return false; }
    if context.page_table_arena_page_count == 0 || context.page_table_pages_used == 0 ||
       context.page_table_pages_used > context.page_table_arena_page_count { return false; }
    return true;
}

@system
pub fn post_cutover_activate_cpu(context: *const PostCutoverContext) -> bool {
    if !post_cutover_context_valid(context) { return false; }
    // Subetapas do primeiro cutover: 0=contexto, 1=CR3, 2=tabelas prontas,
    // 3=segmentos/TSS/IDT carregados. COM1 já foi inicializada pela entrada.
    x86_serial_write_stage_marker('0' as u8);
    if !x86_mmu_activate_root(context.root_physical) { return false; }
    x86_serial_write_stage_marker('1' as u8);

    tss_prepare_default_stacks();
    if !tss_is_prepared() { return false; }
    gdt_prepare();
    gdt_set_tss_descriptor(tss_base(), tss_limit());
    if !gdt_is_prepared() { return false; }
    if !idt_prepare_exceptions() || !idt_exceptions_ready() { return false; }
    x86_serial_write_stage_marker('2' as u8);

    let gdt_address = gdt_base() as u64;
    let idt_address = idt_base() as u64;
    if gdt_address == 0 || idt_address == 0 { return false; }

    x86_gdt_activate_segments_raw(gdt_address, gdt_limit(), GDT_KERNEL_CODE_SELECTOR, GDT_KERNEL_DATA_SELECTOR);
    x86_ltr_raw(GDT_TSS_SELECTOR);
    x86_lidt_table_raw(idt_address, idt_limit());
    x86_serial_write_stage_marker('3' as u8);
    unsafe { POST_CUTOVER_CPU_TABLES_ACTIVE = true; }
    return true;
}

@system
pub fn post_cutover_cpu_tables_active() -> bool { unsafe { return POST_CUTOVER_CPU_TABLES_ACTIVE; } }

@system
pub fn post_cutover_activate_pmm(context: *const PostCutoverContext) -> bool {
    if !post_cutover_cpu_tables_active() || !post_cutover_context_valid(context) { return false; }
    let memory_map = post_cutover_memory_map_virtual(context);
    if memory_map == (null as *const u8) { return false; }
    if !pmm_inventory_init(memory_map, context.memory_map_size as usize, context.memory_descriptor_size as usize) { return false; }
    if !pmm_allocator_activate_after_exit_boot_services() || !pmm_allocator_is_active() { return false; }
    unsafe { POST_CUTOVER_PMM_ACTIVE = true; }
    return true;
}

@system
pub fn post_cutover_pmm_active() -> bool { unsafe { return POST_CUTOVER_PMM_ACTIVE; } }

@system
pub fn post_cutover_activate_vmm(context: *const PostCutoverContext) -> bool {
    if !post_cutover_pmm_active() || !post_cutover_context_valid(context) { return false; }
    if !vmm_activate_current_tables(context.root_physical, BAKEN_DIRECT_MAP_BASE) || !vmm_is_active() { return false; }
    if !active_page_tables_resume(
        context.root_physical,
        context.page_table_arena_physical_base,
        context.page_table_arena_page_count,
        context.page_table_pages_used
    ) { return false; }
    if !active_page_tables_is_ready() { return false; }
    unsafe { POST_CUTOVER_VMM_ACTIVE = true; }
    return true;
}

@system
pub fn post_cutover_vmm_active() -> bool { unsafe { return POST_CUTOVER_VMM_ACTIVE; } }

@system
pub fn post_cutover_activate_acpi(context: *const PostCutoverContext) -> bool {
    if !post_cutover_vmm_active() || !post_cutover_context_valid(context) { return false; }
    let rsdp = post_cutover_acpi_rsdp_virtual(context);
    if rsdp == (null as *const u8) { return false; }
    if !acpi_init_post_cutover(rsdp) || !acpi_is_ready() { return false; }
    if !acpi_uses_post_cutover_direct_map() { return false; }
    if !madt_init() || !madt_is_ready() { return false; }
    unsafe { POST_CUTOVER_ACPI_READY = true; }
    return true;
}

@system
pub fn post_cutover_acpi_ready() -> bool { unsafe { return POST_CUTOVER_ACPI_READY; } }

@system
pub fn post_cutover_activate_interrupt_controllers() -> bool {
    if !post_cutover_acpi_ready() { return false; }
    let local_apic = madt_lapic_address();
    if local_apic == 0 { return false; }
    if !lapic_init_masked(local_apic) || !lapic_is_ready() { return false; }
    if !ioapic_init_all_masked() || !ioapic_is_ready() { return false; }
    unsafe { POST_CUTOVER_INTERRUPT_CONTROLLERS_READY = true; }
    return true;
}

@system
pub fn post_cutover_interrupt_controllers_ready() -> bool {
    unsafe { return POST_CUTOVER_INTERRUPT_CONTROLLERS_READY; }
}

@system
pub fn post_cutover_prepare_irqs() -> bool {
    if !post_cutover_interrupt_controllers_ready() { return false; }
    if !irq_prepare_idt() || !irq_idt_ready() { return false; }
    if !irq_prepare_masked_ioapic_routes() || !irq_routes_ready() { return false; }
    unsafe { POST_CUTOVER_IRQS_READY = true; }
    return true;
}

@system
pub fn post_cutover_irqs_ready() -> bool { unsafe { return POST_CUTOVER_IRQS_READY; } }

@system
pub fn post_cutover_prepare_timer() -> bool {
    if !post_cutover_irqs_ready() { return false; }
    if !lapic_timer_calibrate_masked_from_pm() || !lapic_timer_is_ready() { return false; }
    unsafe { POST_CUTOVER_TIMER_READY = true; }
    return true;
}

@system
pub fn post_cutover_timer_ready() -> bool { unsafe { return POST_CUTOVER_TIMER_READY; } }

@system
@export
pub fn sotlas_x86_post_cutover_entry(argument: u64) -> ! {
    let context = argument as *const PostCutoverContext;
    // COM1 é I/O de porta e não depende de Boot Services, de CR3 novo ou de
    // tabelas de descritor. Este primeiro marcador separa falha no trampoline
    // ou no contexto de falha da ativação de CPU propriamente dita.
    let serial_ready = x86_serial_init();
    if serial_ready { x86_serial_write_stage_marker('B' as u8); }

    // Cada marcador é emitido antes da próxima etapa: o último visto no QEMU
    // identifica o subsistema que falhou sem tocar em serviços UEFI.
    if !post_cutover_activate_cpu(context) { loop {} }
    if serial_ready { x86_serial_write_stage_marker('C' as u8); }

    if !post_cutover_activate_pmm(context) { loop {} }
    if serial_ready { x86_serial_write_stage_marker('P' as u8); }

    if !post_cutover_activate_vmm(context) { loop {} }
    if serial_ready { x86_serial_write_stage_marker('V' as u8); }

    if !post_cutover_activate_acpi(context) { loop {} }
    if serial_ready { x86_serial_write_stage_marker('A' as u8); }

    if !post_cutover_activate_interrupt_controllers() { loop {} }
    if serial_ready { x86_serial_write_stage_marker('I' as u8); }

    if !post_cutover_prepare_irqs() { loop {} }
    if serial_ready { x86_serial_write_stage_marker('R' as u8); }

    if !post_cutover_prepare_timer() { loop {} }

    // Diagnóstico best-effort: não é pré-requisito de hardware do kernel.
    if serial_ready {
        x86_serial_write_timer_ready_marker();
    }

    // interrupt_enable_timer_only() existe e compila, mas permanece deliberadamente
    // desconectada até esta base passar suíte, cross-build e smoke QEMU.
    loop {}
}
