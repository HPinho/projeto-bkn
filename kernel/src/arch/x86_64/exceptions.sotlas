// Baken OS - x86_64 exception dispatcher foundation.
//
// Os stubs 0-31 salvam todos os GPRs e normalizam vector/error/IRET frame.
// Falhas de CPL3 encerram apenas a thread culpada; falhas de CPL0 seguem
// terminais para não ocultar corrupção da fundação do kernel.

module kernel::arch::x86_64::exceptions;

import kernel::arch::x86_64::cpu::*;
import kernel::arch::x86_64::serial::*;
import kernel::arch::x86_64::smp::*;
import kernel::interrupts::irq::*;
import kernel::process::registry::*;
import kernel::scheduler::core::*;

pub const EXCEPTION_VECTOR_COUNT: u16 = 32;
pub const EXCEPTION_DIVIDE_ERROR: u64 = 0;
pub const EXCEPTION_DEBUG: u64 = 1;
pub const EXCEPTION_NMI: u64 = 2;
pub const EXCEPTION_BREAKPOINT: u64 = 3;
pub const EXCEPTION_OVERFLOW: u64 = 4;
pub const EXCEPTION_BOUND_RANGE: u64 = 5;
pub const EXCEPTION_INVALID_OPCODE: u64 = 6;
pub const EXCEPTION_DEVICE_NOT_AVAILABLE: u64 = 7;
pub const EXCEPTION_DOUBLE_FAULT: u64 = 8;
pub const EXCEPTION_INVALID_TSS: u64 = 10;
pub const EXCEPTION_SEGMENT_NOT_PRESENT: u64 = 11;
pub const EXCEPTION_STACK_SEGMENT: u64 = 12;
pub const EXCEPTION_GENERAL_PROTECTION: u64 = 13;
pub const EXCEPTION_PAGE_FAULT: u64 = 14;
pub const EXCEPTION_X87_FLOATING_POINT: u64 = 16;
pub const EXCEPTION_ALIGNMENT_CHECK: u64 = 17;
pub const EXCEPTION_MACHINE_CHECK: u64 = 18;
pub const EXCEPTION_SIMD_FLOATING_POINT: u64 = 19;
pub const EXCEPTION_VIRTUALIZATION: u64 = 20;
pub const EXCEPTION_CONTROL_PROTECTION: u64 = 21;

pub const PAGE_FAULT_PRESENT: u64 = 1;
pub const PAGE_FAULT_WRITE: u64 = 2;
pub const PAGE_FAULT_USER: u64 = 4;
pub const PAGE_FAULT_RESERVED_BIT: u64 = 8;
pub const PAGE_FAULT_INSTRUCTION_FETCH: u64 = 16;
pub const PAGE_FAULT_PROTECTION_KEY: u64 = 32;
pub const PAGE_FAULT_SHADOW_STACK: u64 = 64;

@repr(C)
@packed
pub struct ExceptionSavedFrame {
    pub r15: u64;
    pub r14: u64;
    pub r13: u64;
    pub r12: u64;
    pub r11: u64;
    pub r10: u64;
    pub r9: u64;
    pub r8: u64;
    pub rdi: u64;
    pub rsi: u64;
    pub rbp: u64;
    pub rbx: u64;
    pub rdx: u64;
    pub rcx: u64;
    pub rax: u64;
    pub vector: u64;
    pub error_code: u64;
    pub rip: u64;
    pub cs: u64;
    pub rflags: u64;
    pub rsp: u64;
    pub ss: u64;
}

pub struct ExceptionSnapshot {
    pub vector: u64;
    pub error_code: u64;
    pub rip: u64;
    pub cs: u64;
    pub rflags: u64;
    pub cr2: u64;
    pub user: bool;
    pub process_id: u64;
    pub valid: bool;
}

static mut CPU_LAST_EXCEPTIONS: [ExceptionSnapshot; SCHEDULER_CPU_SLOT_COUNT] = [
    ExceptionSnapshot {
        vector: 0,
        error_code: 0,
        rip: 0,
        cs: 0,
        rflags: 0,
        cr2: 0,
        user: false,
        process_id: 0,
        valid: false
    };
    SCHEDULER_CPU_SLOT_COUNT
];

@system
fn exception_current_cpu_slot() -> usize {
    // O registro SMP já existe antes de liberar os APs ao scheduler, portanto
    // também mantém snapshots privados durante o bring-up per-CPU.
    let smp_slot = smp_current_cpu_slot();
    if smp_slot < SCHEDULER_CPU_SLOT_COUNT { return smp_slot; }
    let scheduler_slot = scheduler_current_cpu_slot();
    if scheduler_slot < SCHEDULER_CPU_SLOT_COUNT { return scheduler_slot; }
    // Antes da descoberta SMP, a única CPU executando é o BSP.
    return 0;
}

@system
pub fn exception_state_reset_for_cpu(cpu_slot: usize) -> void {
    if cpu_slot >= SCHEDULER_CPU_SLOT_COUNT { return; }
    unsafe {
        CPU_LAST_EXCEPTIONS[cpu_slot].valid = false;
        __dma_fence();
        CPU_LAST_EXCEPTIONS[cpu_slot].vector = 0;
        CPU_LAST_EXCEPTIONS[cpu_slot].error_code = 0;
        CPU_LAST_EXCEPTIONS[cpu_slot].rip = 0;
        CPU_LAST_EXCEPTIONS[cpu_slot].cs = 0;
        CPU_LAST_EXCEPTIONS[cpu_slot].rflags = 0;
        CPU_LAST_EXCEPTIONS[cpu_slot].cr2 = 0;
        CPU_LAST_EXCEPTIONS[cpu_slot].user = false;
        CPU_LAST_EXCEPTIONS[cpu_slot].process_id = 0;
    }
}

@system
pub fn exception_state_reset() -> void {
    exception_state_reset_for_cpu(exception_current_cpu_slot());
}

@system
pub fn exception_cpu_has_snapshot(cpu_slot: usize) -> bool {
    if cpu_slot >= SCHEDULER_CPU_SLOT_COUNT { return false; }
    unsafe {
        if !CPU_LAST_EXCEPTIONS[cpu_slot].valid { return false; }
        __dma_fence();
        return true;
    }
}

@system
pub fn exception_has_snapshot() -> bool {
    return exception_cpu_has_snapshot(exception_current_cpu_slot());
}

@system
pub fn exception_cpu_last_vector(cpu_slot: usize) -> u64 {
    if cpu_slot >= SCHEDULER_CPU_SLOT_COUNT { return 0; }
    unsafe { return CPU_LAST_EXCEPTIONS[cpu_slot].vector; }
}

@system
pub fn exception_last_vector() -> u64 {
    return exception_cpu_last_vector(exception_current_cpu_slot());
}

@system
pub fn exception_cpu_last_error_code(cpu_slot: usize) -> u64 {
    if cpu_slot >= SCHEDULER_CPU_SLOT_COUNT { return 0; }
    unsafe { return CPU_LAST_EXCEPTIONS[cpu_slot].error_code; }
}

@system
pub fn exception_last_error_code() -> u64 {
    return exception_cpu_last_error_code(exception_current_cpu_slot());
}

@system
pub fn exception_last_rip() -> u64 {
    let slot = exception_current_cpu_slot();
    unsafe { return CPU_LAST_EXCEPTIONS[slot].rip; }
}

@system
pub fn exception_last_cr2() -> u64 {
    let slot = exception_current_cpu_slot();
    unsafe { return CPU_LAST_EXCEPTIONS[slot].cr2; }
}

@system
pub fn exception_cpu_last_was_user(cpu_slot: usize) -> bool {
    if cpu_slot >= SCHEDULER_CPU_SLOT_COUNT { return false; }
    unsafe {
        return CPU_LAST_EXCEPTIONS[cpu_slot].valid && CPU_LAST_EXCEPTIONS[cpu_slot].user;
    }
}

@system
pub fn exception_last_was_user() -> bool {
    return exception_cpu_last_was_user(exception_current_cpu_slot());
}

@system
pub fn exception_cpu_last_process_id(cpu_slot: usize) -> u64 {
    if cpu_slot >= SCHEDULER_CPU_SLOT_COUNT { return 0; }
    unsafe { return CPU_LAST_EXCEPTIONS[cpu_slot].process_id; }
}

@system
pub fn exception_last_process_id() -> u64 {
    return exception_cpu_last_process_id(exception_current_cpu_slot());
}

// Somente exceções síncronas que podem ser atribuídas ao fluxo CPL3 são
// recuperáveis. NMI, double fault, machine check e vetores reservados nunca
// viram simples encerramento de processo, mesmo se o CS interrompido for CPL3.
@system
pub fn exception_user_fault_recoverable(vector: u64) -> bool {
    return vector == EXCEPTION_DIVIDE_ERROR || vector == EXCEPTION_DEBUG ||
           vector == EXCEPTION_BREAKPOINT || vector == EXCEPTION_OVERFLOW ||
           vector == EXCEPTION_BOUND_RANGE || vector == EXCEPTION_INVALID_OPCODE ||
           vector == EXCEPTION_DEVICE_NOT_AVAILABLE || vector == EXCEPTION_INVALID_TSS ||
           vector == EXCEPTION_SEGMENT_NOT_PRESENT || vector == EXCEPTION_STACK_SEGMENT ||
           vector == EXCEPTION_GENERAL_PROTECTION || vector == EXCEPTION_PAGE_FAULT ||
           vector == EXCEPTION_X87_FLOATING_POINT || vector == EXCEPTION_ALIGNMENT_CHECK ||
           vector == EXCEPTION_SIMD_FLOATING_POINT || vector == EXCEPTION_VIRTUALIZATION ||
           vector == EXCEPTION_CONTROL_PROTECTION;
}

@system
pub fn page_fault_was_protection_violation(error_code: u64) -> bool {
    return (error_code & PAGE_FAULT_PRESENT) != 0;
}

@system
pub fn page_fault_was_write(error_code: u64) -> bool {
    return (error_code & PAGE_FAULT_WRITE) != 0;
}

@system
pub fn page_fault_was_user(error_code: u64) -> bool {
    return (error_code & PAGE_FAULT_USER) != 0;
}

@system
pub fn page_fault_has_reserved_bit(error_code: u64) -> bool {
    return (error_code & PAGE_FAULT_RESERVED_BIT) != 0;
}

@system
pub fn page_fault_was_instruction_fetch(error_code: u64) -> bool {
    return (error_code & PAGE_FAULT_INSTRUCTION_FETCH) != 0;
}

@system
pub fn page_fault_has_protection_key(error_code: u64) -> bool {
    return (error_code & PAGE_FAULT_PROTECTION_KEY) != 0;
}

@system
pub fn page_fault_was_shadow_stack(error_code: u64) -> bool {
    return (error_code & PAGE_FAULT_SHADOW_STACK) != 0;
}

// Diagnóstico terminal usa o frame que causou a exceção, não um frame global
// preparado anteriormente pelo scheduler. Isso evita atribuir #GP a uma thread
// diferente em SMP e torna o gate fail-closed acionável em uma única execução.
@system
fn exception_terminal(vector: u64, frame_address: u64) -> u64 {
    x86_serial_write_hex32_marker('E' as u8, vector as u32);
    if frame_address != 0 {
        let frame = unsafe { frame_address as *const ExceptionSavedFrame };
        if frame != (null as *const ExceptionSavedFrame) {
            unsafe {
                x86_serial_write_hex32_marker('e' as u8, frame.error_code as u32);
                x86_serial_write_hex32_marker('i' as u8, frame.rip as u32);
                x86_serial_write_hex32_marker('c' as u8, frame.cs as u32);
                x86_serial_write_hex32_marker('f' as u8, frame.rflags as u32);
            }
            x86_serial_write_hex32_marker('q' as u8, exception_current_cpu_slot() as u32);
            if scheduler_is_active() {
                x86_serial_write_hex32_marker('t' as u8, scheduler_current_thread_id() as u32);
            }
        }
    }
    return 0;
}

@system
fn exception_write_user_exit_marker() -> void {
    if !x86_serial_is_ready() { return; }
    let marker: [u8; 22] = [
        66,65,75,69,78,58,85,83,69,82,95,70,65,85,76,84,95,69,88,73,84,10
    ];
    let mut index: usize = 0;
    while index < 22 {
        if !x86_serial_write_byte(marker[index]) { return; }
        index += 1;
    }
}

// ABI genérica do backend: retorna um frame normalizado do scheduler para
// IRETQ, ou zero para manter a exceção terminal em CPL0.
@system
@export
pub fn sotlas_x86_exception_dispatch(frame_address: u64) -> u64 {
    let frame = unsafe { frame_address as *const ExceptionSavedFrame };

    if frame == (null as *const ExceptionSavedFrame) {
        return exception_terminal(0xFFFFFFFFFFFFFFFF, 0);
    }

    let cpu_slot = exception_current_cpu_slot();
    let mut user = false;
    let mut pid: u64 = 0;
    let mut vector: u64 = 0;
    unsafe {
        CPU_LAST_EXCEPTIONS[cpu_slot].valid = false;
        vector = frame.vector;
        CPU_LAST_EXCEPTIONS[cpu_slot].vector = vector;
        CPU_LAST_EXCEPTIONS[cpu_slot].error_code = frame.error_code;
        CPU_LAST_EXCEPTIONS[cpu_slot].rip = frame.rip;
        CPU_LAST_EXCEPTIONS[cpu_slot].cs = frame.cs;
        CPU_LAST_EXCEPTIONS[cpu_slot].rflags = frame.rflags;
        CPU_LAST_EXCEPTIONS[cpu_slot].cr2 = 0;

        if vector == EXCEPTION_PAGE_FAULT {
            CPU_LAST_EXCEPTIONS[cpu_slot].cr2 = x86_read_cr2();
        }
        user = (frame.cs & 3) == 3;
        if user { pid = process_current_id(); }
        CPU_LAST_EXCEPTIONS[cpu_slot].user = user;
        CPU_LAST_EXCEPTIONS[cpu_slot].process_id = pid;
        __dma_fence();
        CPU_LAST_EXCEPTIONS[cpu_slot].valid = true;
    }

    if user && exception_user_fault_recoverable(vector) && pid != 0 &&
       scheduler_terminate_current() {
        let selected = irq_schedule_terminated_current(frame_address);
        if selected != 0 {
            exception_write_user_exit_marker();
            return selected;
        }
    }
    return exception_terminal(vector, frame_address);
}
