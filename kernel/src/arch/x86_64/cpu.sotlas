// Baken OS - wrappers x86-64 privilegiados do backend Sotlas.
//
// Estes wrappers existem no grafo canônico para que o build produza e valide
// as instruções reais. Carregar GDT/IDT/TSS continua proibido enquanto o kernel
// depender de UEFI Boot Services.

module kernel::arch::x86_64::cpu;

@system
pub fn x86_lgdt_raw(descriptor_address: u64) -> void {
    __lgdt(descriptor_address);
}

@system
pub fn x86_lidt_raw(descriptor_address: u64) -> void {
    __lidt(descriptor_address);
}

@system
pub fn x86_ltr_raw(selector: u16) -> void {
    __ltr(selector);
}

@system
pub fn x86_read_cr2() -> u64 {
    return __read_cr2();
}

@system
pub fn x86_invlpg(address: u64) -> void {
    __invlpg(address);
}

// Mecanismo genérico de arquitetura. A política de qual vetor usar e como
// configurar o gate pertence à IDT do kernel, não ao backend Python.
@system
pub fn x86_exception_stub_address(vector: u16) -> u64 {
    return __exception_stub_address(vector);
}
