// Baken OS - wrappers x86-64 privilegiados do backend Sotlas.
//
// Estes wrappers existem no grafo canonico para que o build produza e valide
// as instrucoes reais. Carregar GDT/IDT/TSS, substituir CR3, tocar MMIO ou abrir
// interrupcoes so e permitido pelo caminho pos-ExitBootServices validado.

module kernel::arch::x86_64::cpu;

@system
pub fn x86_lgdt_raw(descriptor_address: u64) -> void { __lgdt(descriptor_address); }

@system
pub fn x86_lidt_raw(descriptor_address: u64) -> void { __lidt(descriptor_address); }

@system
pub fn x86_gdt_activate_segments_raw(base: u64,
                                     limit: u16,
                                     code_selector: u16,
                                     data_selector: u16) -> void {
    __gdt_activate_segments(base, limit, code_selector, data_selector);
}

@system
pub fn x86_lidt_table_raw(base: u64, limit: u16) -> void { __lidt_table(base, limit); }

@system
pub fn x86_ltr_raw(selector: u16) -> void { __ltr(selector); }

@system
pub fn x86_read_cr2() -> u64 { return __read_cr2(); }

@system
pub fn x86_read_cr3_raw() -> u64 { return __read_cr3(); }

@system
pub fn x86_write_cr3_raw(root_physical: u64) -> void { __write_cr3(root_physical); }

@system
pub fn x86_read_msr(msr: u32) -> u64 { return __rdmsr(msr); }

@system
pub fn x86_write_msr(msr: u32, value: u64) -> void { __wrmsr(msr, value); }

@system
pub fn x86_stack_switch_to_post_cutover_raw(stack_top: u64, argument: u64) -> void {
    __stack_switch_to_post_cutover(stack_top, argument);
}

@system
pub fn x86_scheduler_thread_trampoline_address() -> u64 {
    return __scheduler_thread_trampoline_address();
}

@system
pub fn x86_scheduler_exit_probe_entry_address() -> u64 {
    return __scheduler_exit_probe_entry_address();
}

@system
pub fn x86_scheduler_idle_entry_address() -> u64 {
    return __scheduler_idle_entry_address();
}

@system
pub fn x86_smp_ap_runtime_entry_address() -> u64 {
    return __smp_ap_runtime_entry_address();
}

@system
pub fn x86_scheduler_smp_probe_entry_address() -> u64 {
    return __scheduler_smp_probe_entry_address();
}

@system
pub fn x86_scheduler_wait_probe_entry_address() -> u64 {
    return __scheduler_wait_probe_entry_address();
}

@system
pub fn x86_scheduler_wake_probe_entry_address() -> u64 {
    return __scheduler_wake_probe_entry_address();
}

@system
pub fn x86_scheduler_yield_interrupt() -> void { __scheduler_yield_interrupt(); }

@system
pub fn x86_scheduler_block_switch() -> void { __scheduler_block_switch(); }

@system
pub fn x86_interrupts_enabled() -> bool { return __interrupts_enabled(); }

@system
pub fn x86_irq_save_disable() -> u64 { return __irq_save_disable(); }

@system
pub fn x86_irq_restore(flags: u64) -> void { __irq_restore(flags); }

@system
pub fn x86_cpu_pause() -> void { __cpu_pause(); }

@system
pub fn x86_atomic_exchange_u32(address: u64, value: u32) -> u32 {
    return __atomic_exchange_u32(address, value);
}

@system
pub fn x86_invlpg(address: u64) -> void { __invlpg(address); }

@system
pub fn x86_mmio_read32(address: u64) -> u32 { return __mmio_read32(address); }

@system
pub fn x86_mmio_write32(address: u64, value: u32) -> void { __mmio_write32(address, value); }

@system
pub fn x86_cli_raw() -> void { __cli(); }

@system
pub fn x86_sti_raw() -> void { __sti(); }

@system
pub fn x86_exception_stub_address(vector: u16) -> u64 {
    return __exception_stub_address(vector);
}

@system
pub fn x86_irq_stub_address(vector: u16) -> u64 {
    return __irq_stub_address(vector);
}
