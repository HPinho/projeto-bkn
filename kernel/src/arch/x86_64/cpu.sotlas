// Baken OS - wrappers x86-64 privilegiados do backend Sotlas.
//
// Estes wrappers existem no grafo canônico para que o build produza e valide
// as instruções reais. Carregar GDT/IDT/TSS ou substituir CR3 continua proibido
// enquanto o kernel depender de UEFI Boot Services.

module kernel::arch::x86_64::cpu;

@system
pub fn x86_lgdt_raw(descriptor_address: u64) -> void {
    __lgdt(descriptor_address);
}

@system
pub fn x86_lidt_raw(descriptor_address: u64) -> void {
    __lidt(descriptor_address);
}

// Ativação completa da GDT em long mode: LGDT + DS/ES/SS + recarga far de CS.
// Deve ser chamada somente após ExitBootServices, numa stack própria válida.
@system
pub fn x86_gdt_activate_segments_raw(base: u64,
                                     limit: u16,
                                     code_selector: u16,
                                     data_selector: u16) -> void {
    __gdt_activate_segments(base, limit, code_selector, data_selector);
}

@system
pub fn x86_lidt_table_raw(base: u64, limit: u16) -> void {
    __lidt_table(base, limit);
}

@system
pub fn x86_ltr_raw(selector: u16) -> void {
    __ltr(selector);
}

@system
pub fn x86_read_cr2() -> u64 {
    return __read_cr2();
}

@system
pub fn x86_read_cr3_raw() -> u64 {
    return __read_cr3();
}

@system
pub fn x86_write_cr3_raw(root_physical: u64) -> void {
    __write_cr3(root_physical);
}

@system
pub fn x86_stack_switch_to_post_cutover_raw(stack_top: u64, argument: u64) -> void {
    __stack_switch_to_post_cutover(stack_top, argument);
}

@system
pub fn x86_invlpg(address: u64) -> void {
    __invlpg(address);
}

// Mecanismo genérico de arquitetura. A política de qual vetor usar e como
// configurar o gate pertence à IDT do kernel, não ao backend Python.
@system
pub fn x86_exception_stub_address(vector: u16) -> u64 {
    return __exception_stub_address(vector);
}
