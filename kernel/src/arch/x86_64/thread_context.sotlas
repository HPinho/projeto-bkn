// Baken OS — contexto x86-64 unificado para kernel threads e threads CPL3.
//
// O scheduler usa o frame salvo pelo IRQ como unidade de retomada. O layout
// coincide com o common stub: 15 GPRs, vetor e o frame arquitetural IRETQ.
// Quando a origem é CPL3, o hardware fornece também RSP/SS, totalizando 21 qwords.

module kernel::arch::x86_64::thread_context;

import kernel::arch::x86_64::gdt::*;
import kernel::arch::x86_64::cpu::*;
import kernel::arch::x86_64::serial::*;

pub const X86_KERNEL_THREAD_FRAME_QWORDS: u64 = 21;
pub const X86_KERNEL_THREAD_FRAME_BYTES: u64 = 168;
pub const X86_KERNEL_THREAD_INITIAL_RFLAGS: u64 = 0x2;
pub const X86_USER_THREAD_INITIAL_RFLAGS: u64 = 0x202;
pub const X86_KERNEL_THREAD_STACK_ALIGNMENT_MASK: u64 = 0xFFFFFFFFFFFFFFF0;

@repr(C)
pub struct X86KernelThreadFrame {
    pub r15: u64;
    pub r14: u64;
    pub r13: u64;
    pub r12: u64;
    pub r11: u64;
    pub r10: u64;
    pub r9: u64;
    pub r8: u64;
    pub rdi: u64;
    pub rsi: u64;
    pub rbp: u64;
    pub rbx: u64;
    pub rdx: u64;
    pub rcx: u64;
    pub rax: u64;
    pub vector: u64;
    pub rip: u64;
    pub cs: u64;
    pub rflags: u64;
    pub rsp: u64;
    pub ss: u64;
}

static mut X86_KERNEL_THREAD_LAST_PREPARED_FRAME: u64 = 0;

@system
pub fn x86_kernel_thread_frame_address_valid(frame_address: u64) -> bool {
    if frame_address == 0 { return false; }
    return (frame_address & 7) == 0;
}

@system
pub fn x86_kernel_thread_last_prepared_frame() -> u64 {
    unsafe { return X86_KERNEL_THREAD_LAST_PREPARED_FRAME; }
}

@system
pub fn x86_saved_frame(frame_address: u64) -> *mut X86KernelThreadFrame {
    if !x86_kernel_thread_frame_address_valid(frame_address) {
        return null as *mut X86KernelThreadFrame;
    }
    return unsafe { frame_address as *mut X86KernelThreadFrame };
}

@system
pub fn x86_saved_frame_cs(frame_address: u64) -> u64 {
    let frame = x86_saved_frame(frame_address);
    if frame == (null as *mut X86KernelThreadFrame) { return 0; }
    unsafe { return (*frame).cs; }
}

@system
pub fn x86_saved_frame_is_user(frame_address: u64) -> bool {
    return (x86_saved_frame_cs(frame_address) & 3) == 3;
}

@system
pub fn x86_saved_frame_syscall_number(frame_address: u64) -> u64 {
    let frame = x86_saved_frame(frame_address);
    if frame == (null as *mut X86KernelThreadFrame) { return 0xFFFFFFFFFFFFFFFF; }
    unsafe { return (*frame).rax; }
}

@system
pub fn x86_saved_frame_arg0(frame_address: u64) -> u64 {
    let frame = x86_saved_frame(frame_address);
    if frame == (null as *mut X86KernelThreadFrame) { return 0; }
    unsafe { return (*frame).rdi; }
}

@system
pub fn x86_saved_frame_arg1(frame_address: u64) -> u64 {
    let frame = x86_saved_frame(frame_address);
    if frame == (null as *mut X86KernelThreadFrame) { return 0; }
    unsafe { return (*frame).rsi; }
}

@system
pub fn x86_saved_frame_set_result(frame_address: u64, value: u64) -> bool {
    let frame = x86_saved_frame(frame_address);
    if frame == (null as *mut X86KernelThreadFrame) { return false; }
    unsafe { (*frame).rax = value; }
    return true;
}

@system
pub fn x86_kernel_thread_dump_last_prepared_frame() -> bool {
    let frame_address = x86_kernel_thread_last_prepared_frame();
    if !x86_kernel_thread_frame_address_valid(frame_address) { return false; }
    let frame = unsafe { frame_address as *const X86KernelThreadFrame };
    if frame == (null as *const X86KernelThreadFrame) { return false; }

    unsafe {
        if !x86_serial_write_hex32_marker('F' as u8, frame_address as u32) { return false; }
        if !x86_serial_write_hex32_marker('K' as u8, (*frame).r10 as u32) { return false; }
        if !x86_serial_write_hex32_marker('N' as u8, (*frame).r11 as u32) { return false; }
        if !x86_serial_write_hex32_marker('R' as u8, (*frame).rip as u32) { return false; }
        if !x86_serial_write_hex32_marker('S' as u8, (*frame).cs as u32) { return false; }
        if !x86_serial_write_hex32_marker('L' as u8, (*frame).rflags as u32) { return false; }
        if !x86_serial_write_hex32_marker('P' as u8, (*frame).rsp as u32) { return false; }
        if !x86_serial_write_hex32_marker('D' as u8, (*frame).ss as u32) { return false; }
    }
    return true;
}

@system
fn x86_thread_zero_frame(frame: *mut X86KernelThreadFrame) -> bool {
    if frame == (null as *mut X86KernelThreadFrame) { return false; }
    unsafe {
        (*frame).r15 = 0; (*frame).r14 = 0; (*frame).r13 = 0; (*frame).r12 = 0;
        (*frame).r11 = 0; (*frame).r10 = 0; (*frame).r9 = 0; (*frame).r8 = 0;
        (*frame).rdi = 0; (*frame).rsi = 0; (*frame).rbp = 0; (*frame).rbx = 0;
        (*frame).rdx = 0; (*frame).rcx = 0; (*frame).rax = 0; (*frame).vector = 0;
        (*frame).rip = 0; (*frame).cs = 0; (*frame).rflags = 0; (*frame).rsp = 0; (*frame).ss = 0;
    }
    return true;
}

@system
pub fn x86_kernel_thread_prepare_frame(stack_top: u64, entry_rip: u64) -> u64 {
    if stack_top == 0 || entry_rip == 0 { return 0; }
    let aligned_top = stack_top & X86_KERNEL_THREAD_STACK_ALIGNMENT_MASK;
    if aligned_top <= X86_KERNEL_THREAD_FRAME_BYTES { return 0; }
    let trampoline_rip = x86_scheduler_thread_trampoline_address();
    if trampoline_rip == 0 { return 0; }
    let frame_address = aligned_top - X86_KERNEL_THREAD_FRAME_BYTES;
    if !x86_kernel_thread_frame_address_valid(frame_address) { return 0; }
    let frame = unsafe { frame_address as *mut X86KernelThreadFrame };
    if !x86_thread_zero_frame(frame) { return 0; }
    unsafe {
        (*frame).r11 = entry_rip;
        (*frame).r10 = aligned_top;
        (*frame).rip = trampoline_rip;
        (*frame).cs = GDT_KERNEL_CODE_SELECTOR as u64;
        (*frame).rflags = X86_KERNEL_THREAD_INITIAL_RFLAGS;
        (*frame).rsp = aligned_top;
        (*frame).ss = GDT_KERNEL_DATA_SELECTOR as u64;
        X86_KERNEL_THREAD_LAST_PREPARED_FRAME = frame_address;
    }
    return frame_address;
}

// Constrói o primeiro frame de uma thread CPL3 em uma kernel-entry stack.
// Código e stack de usuário já devem ter sido validados/mapeados pelo loader.
@system
pub fn x86_user_thread_prepare_frame(kernel_stack_top: u64,
                                     user_entry: u64,
                                     user_stack_top: u64) -> u64 {
    if kernel_stack_top == 0 || user_entry == 0 || user_stack_top == 0 { return 0; }
    if (GDT_USER_CODE_SELECTOR & 3) != 3 || (GDT_USER_DATA_SELECTOR & 3) != 3 { return 0; }
    let kernel_top = kernel_stack_top & X86_KERNEL_THREAD_STACK_ALIGNMENT_MASK;
    let user_top = user_stack_top & X86_KERNEL_THREAD_STACK_ALIGNMENT_MASK;
    if kernel_top <= X86_KERNEL_THREAD_FRAME_BYTES || user_top == 0 { return 0; }
    let frame_address = kernel_top - X86_KERNEL_THREAD_FRAME_BYTES;
    if !x86_kernel_thread_frame_address_valid(frame_address) { return 0; }
    let frame = unsafe { frame_address as *mut X86KernelThreadFrame };
    if !x86_thread_zero_frame(frame) { return 0; }
    unsafe {
        (*frame).rip = user_entry;
        (*frame).cs = GDT_USER_CODE_SELECTOR as u64;
        (*frame).rflags = X86_USER_THREAD_INITIAL_RFLAGS;
        (*frame).rsp = user_top;
        (*frame).ss = GDT_USER_DATA_SELECTOR as u64;
        X86_KERNEL_THREAD_LAST_PREPARED_FRAME = frame_address;
    }
    return frame_address;
}
