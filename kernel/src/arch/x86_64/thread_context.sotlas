// Baken OS — contexto de thread CPL0 compatível com o frame real de IRQ x86-64.
//
// O scheduler usa o frame salvo pelo IRQ como unidade de retomada. Para uma
// thread nova, o mesmo shape carrega um contrato de primeira entrada explícito:
// R10 = topo da stack, R11 = entry Sotlas e RIP = trampoline nativo. O trampoline
// restaura RSP antes de tocar memória, habilita IRQs só depois de a stack estar
// válida e então faz uma CALL ABI-correta.

module kernel::arch::x86_64::thread_context;

import kernel::arch::x86_64::gdt::*;
import kernel::arch::x86_64::cpu::*;
import kernel::arch::x86_64::serial::*;

pub const X86_KERNEL_THREAD_FRAME_QWORDS: u64 = 19;
pub const X86_KERNEL_THREAD_FRAME_BYTES: u64 = 152;
// Primeira entrada deliberadamente começa com IF=0. O trampoline restaura RSP
// e executa STI somente depois de a stack e o shadow space estarem válidos.
pub const X86_KERNEL_THREAD_INITIAL_RFLAGS: u64 = 0x2;
pub const X86_KERNEL_THREAD_STACK_ALIGNMENT_MASK: u64 = 0xFFFFFFFFFFFFFFF0;

@repr(C)
pub struct X86KernelThreadFrame {
    pub r15: u64;
    pub r14: u64;
    pub r13: u64;
    pub r12: u64;
    pub r11: u64;
    pub r10: u64;
    pub r9: u64;
    pub r8: u64;
    pub rdi: u64;
    pub rsi: u64;
    pub rbp: u64;
    pub rbx: u64;
    pub rdx: u64;
    pub rcx: u64;
    pub rax: u64;
    pub vector: u64;
    pub rip: u64;
    pub cs: u64;
    pub rflags: u64;
}

// Durante o bring-up mantemos somente o endereço do último frame sintético
// preparado. Antes da primeira troca bootstrap -> idle este é precisamente o
// frame que o IRQ common tentará restaurar por IRETQ. O diagnóstico não altera
// o frame e não participa da política do scheduler.
static mut X86_KERNEL_THREAD_LAST_PREPARED_FRAME: u64 = 0;

@system
pub fn x86_kernel_thread_frame_address_valid(frame_address: u64) -> bool {
    if frame_address == 0 { return false; }
    return (frame_address & 7) == 0;
}

@system
pub fn x86_kernel_thread_last_prepared_frame() -> u64 {
    unsafe { return X86_KERNEL_THREAD_LAST_PREPARED_FRAME; }
}

// Dump fail-safe sem formatação/heap: cada tag usa o marcador hexadecimal já
// validado pelo bring-up. O objetivo é saber se RIP/CS/RFLAGS foram corrompidos
// entre prepare_frame() e o IRETQ que dispara #GP.
@system
pub fn x86_kernel_thread_dump_last_prepared_frame() -> bool {
    let frame_address = x86_kernel_thread_last_prepared_frame();
    if !x86_kernel_thread_frame_address_valid(frame_address) { return false; }
    let frame = frame_address as *const X86KernelThreadFrame;
    if frame == (null as *const X86KernelThreadFrame) { return false; }

    unsafe {
        if !x86_serial_write_hex32_marker('F' as u8, frame_address as u32) { return false; }
        if !x86_serial_write_hex32_marker('K' as u8, (*frame).r10 as u32) { return false; }
        if !x86_serial_write_hex32_marker('N' as u8, (*frame).r11 as u32) { return false; }
        if !x86_serial_write_hex32_marker('R' as u8, (*frame).rip as u32) { return false; }
        if !x86_serial_write_hex32_marker('S' as u8, (*frame).cs as u32) { return false; }
        if !x86_serial_write_hex32_marker('L' as u8, (*frame).rflags as u32) { return false; }
    }
    return true;
}

@system
pub fn x86_kernel_thread_prepare_frame(stack_top: u64, entry_rip: u64) -> u64 {
    if stack_top == 0 || entry_rip == 0 { return 0; }

    let aligned_top = stack_top & X86_KERNEL_THREAD_STACK_ALIGNMENT_MASK;
    if aligned_top <= X86_KERNEL_THREAD_FRAME_BYTES { return 0; }
    let trampoline_rip = x86_scheduler_thread_trampoline_address();
    if trampoline_rip == 0 { return 0; }

    let frame_address = aligned_top - X86_KERNEL_THREAD_FRAME_BYTES;
    if !x86_kernel_thread_frame_address_valid(frame_address) { return 0; }

    let frame = frame_address as *mut X86KernelThreadFrame;
    unsafe {
        (*frame).r15 = 0;
        (*frame).r14 = 0;
        (*frame).r13 = 0;
        (*frame).r12 = 0;
        // Primeira ativação: o trampoline consome estes registradores antes de
        // qualquer operação de stack. Depois da primeira preempção, ambos viram
        // registradores normais salvos/restaurados pelo IRQ common.
        (*frame).r11 = entry_rip;
        (*frame).r10 = aligned_top;
        (*frame).r9 = 0;
        (*frame).r8 = 0;
        (*frame).rdi = 0;
        (*frame).rsi = 0;
        (*frame).rbp = 0;
        (*frame).rbx = 0;
        (*frame).rdx = 0;
        (*frame).rcx = 0;
        (*frame).rax = 0;
        (*frame).vector = 0;
        (*frame).rip = trampoline_rip;
        (*frame).cs = GDT_KERNEL_CODE_SELECTOR as u64;
        (*frame).rflags = X86_KERNEL_THREAD_INITIAL_RFLAGS;
        X86_KERNEL_THREAD_LAST_PREPARED_FRAME = frame_address;
    }
    return frame_address;
}
