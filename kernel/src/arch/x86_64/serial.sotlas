// Baken OS — diagnóstico serial x86-64 mínimo, independente de UEFI.
//
// Usado pelo bring-up para transformar o smoke QEMU em prova de progresso real.
// Não faz parte da UI e nunca espera indefinidamente por hardware ausente.
// Escritas multi-byte são serializadas entre CPUs para preservar framing dos
// checkpoints mesmo depois que Application Processors passam a executar trabalho.
//
// O boot log em RAM é o sink autoritativo de diagnóstico. COM1/UART é apenas
// um transporte opcional de espelhamento para QEMU/CI e nunca pode decidir se
// o kernel continua em hardware físico sem UART legado. Quando disponibilidade
// do transporte importar, consulte x86_serial_is_ready() explicitamente.

module kernel::arch::x86_64::serial;

import kernel::arch::x86_64::cpu::*;
import kernel::sync::spinlock::*;

pub const X86_SERIAL_COM1: u16 = 0x3F8;
pub const X86_SERIAL_MAX_SPINS: u32 = 100000;

static mut X86_SERIAL_READY: bool = false;
static mut X86_SERIAL_LOCK: SpinLock = SpinLock { state: 0 };
pub const X86_BOOT_LOG_CAPACITY: usize = 65536;
static mut X86_BOOT_LOG: [u8; X86_BOOT_LOG_CAPACITY] = [0; X86_BOOT_LOG_CAPACITY];
static mut X86_BOOT_LOG_HEAD: usize = 0;
static mut X86_BOOT_LOG_SIZE: usize = 0;
static mut X86_BOOT_LOG_FROZEN: bool = false;

// Called with the serial lock held. UART availability never controls capture.
@system
fn x86_boot_log_append(value: u8) -> void {
    unsafe {
        if X86_BOOT_LOG_FROZEN { return; }
        X86_BOOT_LOG[X86_BOOT_LOG_HEAD] = value;
        X86_BOOT_LOG_HEAD = (X86_BOOT_LOG_HEAD + 1) % X86_BOOT_LOG_CAPACITY;
        if X86_BOOT_LOG_SIZE < X86_BOOT_LOG_CAPACITY { X86_BOOT_LOG_SIZE += 1; }
    }
}

@system
pub fn x86_boot_log_freeze() -> void {
    let flags = x86_irq_save_disable();
    unsafe {
        if spinlock_lock(&mut X86_SERIAL_LOCK) {
            X86_BOOT_LOG_FROZEN = true;
            spinlock_unlock(&mut X86_SERIAL_LOCK);
        }
    }
    x86_irq_restore(flags);
}

@system
pub fn x86_boot_log_size() -> usize { unsafe { return X86_BOOT_LOG_SIZE; } }

// Chronological view of the frozen ring, for screen rendering/export.
@system
pub fn x86_boot_log_byte(index: usize) -> u8 {
    unsafe {
        if !X86_BOOT_LOG_FROZEN || index >= X86_BOOT_LOG_SIZE { return 0; }
        let start = (X86_BOOT_LOG_HEAD + X86_BOOT_LOG_CAPACITY - X86_BOOT_LOG_SIZE) % X86_BOOT_LOG_CAPACITY;
        return X86_BOOT_LOG[(start + index) % X86_BOOT_LOG_CAPACITY];
    }
}

// Inicializa a infraestrutura diagnóstica. O retorno representa disponibilidade
// do boot log/lock, não a presença física de COM1. A saúde do transporte UART é
// publicada separadamente por x86_serial_is_ready(). Isso permite que callers
// como post_cutover preservem checkpoints em RAM mesmo em PCs sem UART legado.
@system
pub fn x86_serial_init() -> bool {
    unsafe {
        X86_SERIAL_READY = false;
        if !spinlock_init(&mut X86_SERIAL_LOCK) { return false; }
    }

    __outb(X86_SERIAL_COM1 + 1, 0x00);
    __outb(X86_SERIAL_COM1 + 3, 0x80);
    __outb(X86_SERIAL_COM1 + 0, 0x03);
    __outb(X86_SERIAL_COM1 + 1, 0x00);
    __outb(X86_SERIAL_COM1 + 3, 0x03);
    __outb(X86_SERIAL_COM1 + 2, 0xC7);
    __outb(X86_SERIAL_COM1 + 4, 0x0B);

    // Um UART ausente costuma retornar 0xFF. Bridges LPC modernas também podem
    // retornar 0x00 sem UART funcional. Nenhum dos casos invalida o boot log.
    let status = __inb(X86_SERIAL_COM1 + 5);
    if status != 0xFF && (status & 0x20) != 0 {
        unsafe { X86_SERIAL_READY = true; }
    }
    return true;
}

@system
pub fn x86_serial_is_ready() -> bool {
    unsafe { return X86_SERIAL_READY; }
}

@system
fn x86_serial_write_byte_unlocked(value: u8) -> bool {
    let mut spins: u32 = 0;
    while spins < X86_SERIAL_MAX_SPINS {
        if (__inb(X86_SERIAL_COM1 + 5) & 0x20) != 0 {
            __outb(X86_SERIAL_COM1, value);
            return true;
        }
        spins += 1;
    }
    unsafe { X86_SERIAL_READY = false; }
    return false;
}

// Uma escrita isolada também é protegida. O valor de retorno significa que o
// diagnóstico foi capturado no boot log em RAM. Se COM1 estiver disponível,
// ele é espelhado em best-effort; falha/ausência do UART não torna o boot fatal.
@system
pub fn x86_serial_write_byte(value: u8) -> bool {
    let flags = x86_irq_save_disable();
    unsafe {
        if !spinlock_lock(&mut X86_SERIAL_LOCK) {
            x86_irq_restore(flags);
            return false;
        }
    }

    x86_boot_log_append(value);
    if x86_serial_is_ready() {
        // Uma falha de transporte apenas desativa X86_SERIAL_READY em
        // x86_serial_write_byte_unlocked(); a cópia em RAM já está segura.
        x86_serial_write_byte_unlocked(value);
    }

    unsafe { spinlock_unlock(&mut X86_SERIAL_LOCK); }
    x86_irq_restore(flags);
    return true;
}

// Transação diagnóstica multi-byte. O lock cobre a linha inteira e as
// interrupções locais ficam desabilitadas enquanto o lock está em posse deste
// CPU, evitando reentrada e interleaving. O boot log em RAM é obrigatório;
// UART/COM1 é somente um espelho opcional para QEMU/CI.
@system
pub fn x86_serial_write_buffer(bytes: *const u8, length: usize) -> bool {
    if length == 0 { return true; }
    if bytes == (null as *const u8) { return false; }

    let flags = x86_irq_save_disable();
    unsafe {
        if !spinlock_lock(&mut X86_SERIAL_LOCK) {
            x86_irq_restore(flags);
            return false;
        }
    }

    let mut index: usize = 0;
    unsafe {
        while index < length {
            x86_boot_log_append(bytes[index]);
            index += 1;
        }

        // Só tenta o transporte legado se ele realmente foi detectado. Uma
        // falha no meio da linha desativa o UART para chamadas seguintes, mas
        // não invalida a linha que já foi capturada integralmente em RAM.
        if x86_serial_is_ready() {
            index = 0;
            while index < length {
                if !x86_serial_write_byte_unlocked(bytes[index]) { break; }
                index += 1;
            }
        }
        spinlock_unlock(&mut X86_SERIAL_LOCK);
    }
    x86_irq_restore(flags);
    return true;
}

@system
fn x86_serial_hex_digit(value: u8) -> u8 {
    if value < 10 { return ('0' as u8) + value; }
    return ('A' as u8) + (value - 10);
}

// Diagnóstico numérico sem alocação/formatação: BAKEN:HEX=<tag>:XXXXXXXX.
@system
pub fn x86_serial_write_hex32_marker(tag: u8, value: u32) -> bool {
    let mut marker: [u8; 21] = [
        66,65,75,69,78,58,72,69,88,61,0,58,
        48,48,48,48,48,48,48,48,10
    ];
    marker[10] = tag;
    let mut shift: i32 = 28;
    let mut index: usize = 12;
    while shift >= 0 {
        let nibble = ((value >> (shift as u32)) & 0x0F) as u8;
        marker[index] = x86_serial_hex_digit(nibble);
        index += 1;
        shift -= 4;
    }
    unsafe { return x86_serial_write_buffer(&marker[0], 21); }
}

// Checkpoint curto e delimitado para o bring-up pós-cutover. Um único
// caractere de etapa evita depender de alocação, formatação ou framebuffer
// enquanto a MMU, o PMM e os controladores de interrupção são validados.
// Convenção: C=CPU, P=PMM, V=VMM, A=ACPI, I=APIC/IOAPIC, R=rotas IRQ.
@system
pub fn x86_serial_write_stage_marker(stage: u8) -> bool {
    let mut marker: [u8; 13] = [66,65,75,69,78,58,83,84,69,80,61,0,10];
    marker[11] = stage;
    unsafe { return x86_serial_write_buffer(&marker[0], 13); }
}

@system
pub fn x86_serial_write_timer_ready_marker() -> bool {
    let marker: [u8; 18] = [
        66,65,75,69,78,58,84,73,77,69,82,95,82,69,65,68,89,10
    ];
    unsafe { return x86_serial_write_buffer(&marker[0], 18); }
}

// Prova nominal do heap para os gates QEMU; não usa formatação nem alocação.
@system
pub fn x86_serial_write_heap_ready_marker() -> bool {
    let marker: [u8; 17] = [
        66,65,75,69,78,58,72,69,65,80,95,82,69,65,68,89,10
    ];
    unsafe { return x86_serial_write_buffer(&marker[0], 17); }
}

// Contrato final do bring-up: emitido somente depois que todos os gates
// bare-metal obrigatórios passaram e imediatamente antes do runtime nativo.
@system
pub fn x86_serial_write_bare_metal_ready_marker() -> bool {
    let marker: [u8; 23] = [
        66,65,75,69,78,58,66,65,82,69,95,77,
        69,84,65,76,95,82,69,65,68,89,10
    ];
    unsafe { return x86_serial_write_buffer(&marker[0], 23); }
}
