// Baken OS - x86_64 Interrupt Descriptor Table foundation.
//
// Constroi gates de 16 bytes em memoria. O backend ja possui LIDT real e entry
// stubs 0-31, mas o carregamento permanece bloqueado enquanto o kernel depende
// de UEFI Boot Services.

module kernel::arch::x86_64::idt;

import kernel::arch::x86_64::gdt::*;
import kernel::arch::x86_64::cpu::*;

pub const IDT_VECTOR_COUNT: usize = 256;
pub const IDT_EXCEPTION_COUNT: u16 = 32;
pub const IDT_GATE_INTERRUPT: u8 = 0x8E;
pub const IDT_GATE_TRAP: u8 = 0x8F;

pub const IDT_VECTOR_NMI: u16 = 2;
pub const IDT_VECTOR_BREAKPOINT: u16 = 3;
pub const IDT_VECTOR_OVERFLOW: u16 = 4;
pub const IDT_VECTOR_DOUBLE_FAULT: u16 = 8;
pub const IDT_VECTOR_MACHINE_CHECK: u16 = 18;

@repr(C)
@packed
pub struct IdtGate {
    pub offset_low: u16;
    pub selector: u16;
    pub ist: u8;
    pub type_attr: u8;
    pub offset_mid: u16;
    pub offset_high: u32;
    pub zero: u32;
}

@repr(C)
@packed
pub struct IdtDescriptorTablePointer {
    pub limit: u16;
    pub base: u64;
}

static mut IDT: [IdtGate; IDT_VECTOR_COUNT] = [
    IdtGate {
        offset_low: 0,
        selector: 0,
        ist: 0,
        type_attr: 0,
        offset_mid: 0,
        offset_high: 0,
        zero: 0,
    };
    IDT_VECTOR_COUNT
];

static mut IDT_PREPARED: bool = false;
static mut IDT_EXCEPTIONS_READY: bool = false;

@system
pub fn idt_set_gate(vector: u16, handler: u64, selector: u16, ist: u8, type_attr: u8) -> bool {
    if vector >= 256 { return false; }
    if handler == 0 { return false; }
    let idx: usize = vector as usize;
    unsafe {
        IDT[idx].offset_low = (handler & 0xFFFF) as u16;
        IDT[idx].selector = selector;
        IDT[idx].ist = ist & 7;
        IDT[idx].type_attr = type_attr;
        IDT[idx].offset_mid = ((handler >> 16) & 0xFFFF) as u16;
        IDT[idx].offset_high = ((handler >> 32) & 0xFFFFFFFF) as u32;
        IDT[idx].zero = 0;
    }
    return true;
}

@system
pub fn idt_exception_ist(vector: u16) -> u8 {
    if vector == IDT_VECTOR_DOUBLE_FAULT { return 1; }
    if vector == IDT_VECTOR_NMI { return 2; }
    if vector == IDT_VECTOR_MACHINE_CHECK { return 3; }
    return 0;
}

@system
pub fn idt_exception_type_attr(vector: u16) -> u8 {
    if vector == IDT_VECTOR_BREAKPOINT || vector == IDT_VECTOR_OVERFLOW {
        return IDT_GATE_TRAP;
    }
    return IDT_GATE_INTERRUPT;
}

@system
pub fn idt_set_exception_gate(vector: u16, handler: u64) -> bool {
    if vector >= IDT_EXCEPTION_COUNT { return false; }
    return idt_set_gate(
        vector,
        handler,
        GDT_KERNEL_CODE_SELECTOR,
        idt_exception_ist(vector),
        idt_exception_type_attr(vector)
    );
}

// Popula os vetores 0..31 com os stubs gerados pelo backend x86. Isso apenas
// escreve a tabela em RAM: LIDT continua proibido durante a fase UEFI híbrida.
@system
pub fn idt_prepare_exceptions() -> bool {
    idt_prepare_empty();
    let vector: u16 = 0;
    while vector < IDT_EXCEPTION_COUNT {
        let handler: u64 = x86_exception_stub_address(vector);
        if handler == 0 { return false; }
        if !idt_set_exception_gate(vector, handler) { return false; }
        vector = vector + 1;
    }
    unsafe { IDT_EXCEPTIONS_READY = true; }
    return true;
}

@system
pub fn idt_prepare_empty() -> void {
    // Zero-init estatico garante que vetores nao registrados permanecam non-present.
    unsafe {
        IDT_PREPARED = true;
        IDT_EXCEPTIONS_READY = false;
    }
}

@system
pub fn idt_base() -> *const IdtGate {
    unsafe { return &IDT[0]; }
}

@system
pub fn idt_limit() -> u16 {
    return ((IDT_VECTOR_COUNT * 16) - 1) as u16;
}

@system
pub fn idt_is_prepared() -> bool {
    unsafe { return IDT_PREPARED; }
}

@system
pub fn idt_exceptions_ready() -> bool {
    unsafe { return IDT_EXCEPTIONS_READY; }
}
