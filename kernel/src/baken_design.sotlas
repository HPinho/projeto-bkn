// Baken Lua Design — tokens canônicos, densidade e acessibilidade.
// Tema Claro (Light Theme) macOS Liquid Glass padrão e exclusivo.

module kernel::baken_design;

import kernel::sotlas_graphics::*;

pub const BAKEN_SPACE_1: u32 = 4;
pub const BAKEN_SPACE_2: u32 = 8;
pub const BAKEN_SPACE_3: u32 = 12;
pub const BAKEN_SPACE_4: u32 = 16;
pub const BAKEN_SPACE_5: u32 = 24;
pub const BAKEN_SPACE_6: u32 = 32;

pub const BAKEN_RADIUS_CONTROL: u32 = 10;
pub const BAKEN_RADIUS_CARD: u32 = 18;
pub const BAKEN_RADIUS_WINDOW: u32 = 22;

pub const BAKEN_MIN_HIT_TARGET: u32 = 36;
pub const BAKEN_MIN_TEXT_CONTRAST: u32 = 112;

pub const BAKEN_MOTION_FAST_MS: u32 = 120;
pub const BAKEN_MOTION_STANDARD_MS: u32 = 200;
pub const BAKEN_MOTION_SLOW_MS: u32 = 320;

// Paleta Canônica do Tema Claro (macOS Light Aesthetic)
pub const BAKEN_LIGHT_BG_CANVAS: u32 = 0x00F8FAFC;
pub const BAKEN_LIGHT_CARD_SURFACE: u32 = 0x00FFFFFF;
pub const BAKEN_LIGHT_CARD_SURFACE_MUTED: u32 = 0x00F1F5F9;
pub const BAKEN_LIGHT_BORDER_SUBTLE: u32 = 0x00E2E8F0;
pub const BAKEN_LIGHT_BORDER_SPECULAR: u32 = 0x00FFFFFF;

pub const BAKEN_LIGHT_TEXT_PRIMARY: u32 = 0x000F172A;
pub const BAKEN_LIGHT_TEXT_SECONDARY: u32 = 0x00334155;
pub const BAKEN_LIGHT_TEXT_MUTED: u32 = 0x0064748B;
pub const BAKEN_LIGHT_TEXT_INVERTED: u32 = 0x00FFFFFF;

pub const BAKEN_ACCENT_BLUE_PRIMARY: u32 = 0x000284C7;
pub const BAKEN_ACCENT_BLUE_HOVER: u32 = 0x000EA5E9;
pub const BAKEN_ACCENT_BLUE_TINT: u32 = 0x00E0F2FE;
pub const BAKEN_ACCENT_EMERALD: u32 = 0x0010B981;
pub const BAKEN_ACCENT_AMBER: u32 = 0x00F59E0B;

pub struct BakenMaterialToken {
    pub fill: Color;
    pub border: Color;
    pub shadow: Color;
    pub corner_radius: u32;
    pub elevation: u32;
}

pub fn baken_material_glass_light() -> BakenMaterialToken {
    return BakenMaterialToken {
        fill: color_rgba(255, 255, 255, 215),
        border: color_rgba(255, 255, 255, 240),
        shadow: color_rgba(15, 23, 42, 35),
        corner_radius: BAKEN_RADIUS_CARD,
        elevation: 2,
    };
}

pub fn baken_material_glass_dark() -> BakenMaterialToken {
    // Redireciona para o tema claro conforme solicitação estrita
    return baken_material_glass_light();
}

pub const MACOS_TRAFFIC_RED: u32 = 0x00FF5F56;
pub const MACOS_TRAFFIC_YELLOW: u32 = 0x00FFBD2E;
pub const MACOS_TRAFFIC_GREEN: u32 = 0x0027C93F;

pub fn baken_material_macos_sheet_light() -> BakenMaterialToken {
    return BakenMaterialToken {
        fill: color_rgba(255, 255, 255, 195),
        border: color_rgba(255, 255, 255, 240),
        shadow: color_rgba(15, 23, 42, 32),
        corner_radius: BAKEN_RADIUS_WINDOW,
        elevation: 3,
    };
}

pub fn baken_material_macos_sheet() -> BakenMaterialToken {
    return baken_material_macos_sheet_light();
}

pub fn baken_material_macos_button(is_primary: bool, is_hover: bool) -> BakenMaterialToken {
    if is_primary {
        return BakenMaterialToken {
            fill: if is_hover { color_rgba(14, 165, 233, 255) } else { color_rgba(2, 132, 199, 255) },
            border: color_rgba(255, 255, 255, 120),
            shadow: color_rgba(2, 132, 199, 65),
            corner_radius: 12,
            elevation: 2,
        };
    } else {
        return BakenMaterialToken {
            fill: if is_hover { color_rgba(255, 255, 255, 245) } else { color_rgba(255, 255, 255, 210) },
            border: if is_hover { color_rgba(148, 163, 184, 180) } else { color_rgba(203, 213, 225, 160) },
            shadow: color_rgba(15, 23, 42, 20),
            corner_radius: 12,
            elevation: 1,
        };
    }
}

// Contraste simples e determinístico para impedir texto apagado em cards.
pub fn baken_text_is_legible(foreground: Color, background: Color) -> bool {
    let fg = (foreground.r as u32 * 54 + foreground.g as u32 * 183 + foreground.b as u32 * 19) / 256;
    let bg = (background.r as u32 * 54 + background.g as u32 * 183 + background.b as u32 * 19) / 256;
    let delta = if fg > bg { fg - bg } else { bg - fg };
    return delta >= BAKEN_MIN_TEXT_CONTRAST;
}
