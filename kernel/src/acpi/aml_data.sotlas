// Baken OS — AML-3: data objects estruturais e skip grammar-aware.
//
// Esta camada reconhece somente produções de dados necessárias ao futuro loader
// de namespace. Não executa TermArg, métodos ou opcodes desconhecidos. Todo
// cursor permanece limitado ao PkgLength original e o trabalho é limitado por
// profundidade e orçamento de objetos para firmware malformado não prender o
// kernel.

module kernel::acpi::aml_data;

import kernel::acpi::aml_decoder::*;
import kernel::arch::x86_64::serial::*;

pub const AML_STRING_PREFIX: u8 = 0x0D;
pub const AML_BUFFER_OP: u8 = 0x11;
pub const AML_PACKAGE_OP: u8 = 0x12;
pub const AML_VAR_PACKAGE_OP: u8 = 0x13;

pub const AML_DATA_KIND_INTEGER: u8 = 1;
pub const AML_DATA_KIND_STRING: u8 = 2;
pub const AML_DATA_KIND_BUFFER: u8 = 3;
pub const AML_DATA_KIND_PACKAGE: u8 = 4;
pub const AML_DATA_KIND_VAR_PACKAGE: u8 = 5;
pub const AML_DATA_KIND_NAME_REFERENCE: u8 = 6;

pub const AML_DATA_MAX_DEPTH: usize = 8;
pub const AML_DATA_MAX_OBJECTS: usize = 1024;
pub const AML_DATA_MAX_PACKAGE_ELEMENTS: usize = 255;
pub const AML_DATA_MAX_STRING_BYTES: usize = 4096;

pub struct AmlDataObject {
    pub kind: u8;
    pub integer_value: u64;
    // String: primeiro byte de conteúdo, sem terminador.
    // Buffer: ByteList bruto.
    // Package/VarPackage: início do corpo delimitado pelo PkgLength.
    pub data: *const u8;
    pub data_length: usize;
    pub element_count: usize;
    pub encoded_bytes: usize;
    pub valid: bool;
}

static mut AML_DATA_READY: bool = false;

@system
fn aml_data_invalid() -> AmlDataObject {
    return AmlDataObject {
        kind: 0,
        integer_value: 0,
        data: null as *const u8,
        data_length: 0,
        element_count: 0,
        encoded_bytes: 0,
        valid: false
    };
}

@system
fn aml_data_fail(cursor: *mut AmlCursor) -> void {
    if cursor == (null as *mut AmlCursor) { return; }
    unsafe { (*cursor).valid = false; }
}

@system
fn aml_data_pointer_at(cursor: *const AmlCursor, offset: usize) -> *const u8 {
    if cursor == (null as *const AmlCursor) { return null as *const u8; }
    unsafe {
        if !(*cursor).valid || offset > (*cursor).length {
            return null as *const u8;
        }
        let base = (*cursor).base as u64;
        let delta = offset as u64;
        if delta > 0xFFFFFFFFFFFFFFFF - base {
            return null as *const u8;
        }
        return (base + delta) as *const u8;
    }
}

@system
fn aml_data_consume_budget(cursor: *mut AmlCursor, budget: *mut usize) -> bool {
    if budget == (null as *mut usize) {
        aml_data_fail(cursor);
        return false;
    }
    unsafe {
        if (*budget) == 0 {
            aml_data_fail(cursor);
            return false;
        }
        (*budget) -= 1;
    }
    return true;
}

@system
fn aml_data_is_integer_opcode(opcode: u8) -> bool {
    return opcode == AML_ZERO_OP || opcode == AML_ONE_OP ||
        opcode == AML_ONES_OP || opcode == AML_BYTE_PREFIX ||
        opcode == AML_WORD_PREFIX || opcode == AML_DWORD_PREFIX ||
        opcode == AML_QWORD_PREFIX;
}

@system
fn aml_data_is_name_start(opcode: u8) -> bool {
    return opcode == AML_ROOT_CHAR || opcode == AML_PARENT_PREFIX_CHAR ||
        opcode == AML_DUAL_NAME_PREFIX || opcode == AML_MULTI_NAME_PREFIX ||
        opcode == '_' as u8 || (opcode >= 'A' as u8 && opcode <= 'Z' as u8);
}

@system
fn aml_decode_string_internal(cursor: *mut AmlCursor) -> AmlDataObject {
    if cursor == (null as *mut AmlCursor) ||
       aml_cursor_remaining(cursor as *const AmlCursor) == 0 ||
       aml_cursor_peek_u8(cursor as *const AmlCursor) != AML_STRING_PREFIX {
        aml_data_fail(cursor);
        return aml_data_invalid();
    }

    let start = unsafe { (*cursor).offset };
    aml_cursor_read_u8(cursor);
    let content_offset = unsafe { (*cursor).offset };
    let mut length: usize = 0;
    let mut terminated = false;
    while length <= AML_DATA_MAX_STRING_BYTES &&
          aml_cursor_remaining(cursor as *const AmlCursor) != 0 {
        let value = aml_cursor_read_u8(cursor);
        if value == 0 {
            terminated = true;
            break;
        }
        length += 1;
    }
    if !terminated || length > AML_DATA_MAX_STRING_BYTES {
        aml_data_fail(cursor);
        return aml_data_invalid();
    }
    let data = aml_data_pointer_at(cursor as *const AmlCursor, content_offset);
    if data == (null as *const u8) {
        aml_data_fail(cursor);
        return aml_data_invalid();
    }
    let end = unsafe { (*cursor).offset };
    return AmlDataObject {
        kind: AML_DATA_KIND_STRING,
        integer_value: 0,
        data: data,
        data_length: length,
        element_count: 0,
        encoded_bytes: end - start,
        valid: true
    };
}

@system
fn aml_decode_term_arg_constant_internal(cursor: *mut AmlCursor) -> AmlInteger {
    // AML-3 não avalia TermArg. Aceita somente Integer constante, suficiente
    // para BufferSize e VarNumElements de objetos estáticos.
    return aml_decode_integer(cursor);
}

@system
fn aml_decode_value_internal(cursor: *mut AmlCursor,
                             depth: usize,
                             budget: *mut usize,
                             allow_name: bool) -> AmlDataObject {
    if cursor == (null as *mut AmlCursor) || depth >= AML_DATA_MAX_DEPTH ||
       aml_cursor_remaining(cursor as *const AmlCursor) == 0 {
        aml_data_fail(cursor);
        return aml_data_invalid();
    }
    if !aml_data_consume_budget(cursor, budget) { return aml_data_invalid(); }

    let opcode = aml_cursor_peek_u8(cursor as *const AmlCursor);
    let start = unsafe { (*cursor).offset };

    if aml_data_is_integer_opcode(opcode) {
        let integer = aml_decode_integer(cursor);
        if !integer.valid { return aml_data_invalid(); }
        return AmlDataObject {
            kind: AML_DATA_KIND_INTEGER,
            integer_value: integer.value,
            data: null as *const u8,
            data_length: 0,
            element_count: 0,
            encoded_bytes: integer.encoded_bytes,
            valid: true
        };
    }

    if opcode == AML_STRING_PREFIX {
        return aml_decode_string_internal(cursor);
    }

    if allow_name && aml_data_is_name_start(opcode) {
        let name = aml_decode_name_string(cursor);
        if !name.valid || name.segment_count == 0 {
            aml_data_fail(cursor);
            return aml_data_invalid();
        }
        let end = unsafe { (*cursor).offset };
        return AmlDataObject {
            kind: AML_DATA_KIND_NAME_REFERENCE,
            integer_value: 0,
            data: null as *const u8,
            data_length: 0,
            element_count: name.segment_count,
            encoded_bytes: end - start,
            valid: true
        };
    }

    if opcode != AML_BUFFER_OP && opcode != AML_PACKAGE_OP &&
       opcode != AML_VAR_PACKAGE_OP {
        aml_data_fail(cursor);
        return aml_data_invalid();
    }

    aml_cursor_read_u8(cursor);
    let package = aml_decode_pkg_length(cursor);
    if !package.valid {
        aml_data_fail(cursor);
        return aml_data_invalid();
    }
    let mut body = aml_cursor_take(cursor, package.body_bytes);
    if !body.valid {
        aml_data_fail(cursor);
        return aml_data_invalid();
    }

    if opcode == AML_BUFFER_OP {
        let size = aml_decode_term_arg_constant_internal(&mut body);
        if !size.valid {
            aml_data_fail(cursor);
            return aml_data_invalid();
        }
        let data_offset = body.offset;
        let data_length = aml_cursor_remaining(&body);
        let data = aml_data_pointer_at(&body, data_offset);
        if data == (null as *const u8) && data_length != 0 {
            aml_data_fail(cursor);
            return aml_data_invalid();
        }
        let end = unsafe { (*cursor).offset };
        return AmlDataObject {
            kind: AML_DATA_KIND_BUFFER,
            integer_value: size.value,
            data: data,
            data_length: data_length,
            element_count: 0,
            encoded_bytes: end - start,
            valid: true
        };
    }

    let mut element_count: usize = 0;
    if opcode == AML_PACKAGE_OP {
        if aml_cursor_remaining(&body) == 0 {
            aml_data_fail(cursor);
            return aml_data_invalid();
        }
        element_count = aml_cursor_read_u8(&mut body) as usize;
    } else {
        let count = aml_decode_term_arg_constant_internal(&mut body);
        if !count.valid || count.value > AML_DATA_MAX_PACKAGE_ELEMENTS as u64 {
            aml_data_fail(cursor);
            return aml_data_invalid();
        }
        element_count = count.value as usize;
    }
    if element_count > AML_DATA_MAX_PACKAGE_ELEMENTS {
        aml_data_fail(cursor);
        return aml_data_invalid();
    }

    let mut element: usize = 0;
    while element < element_count {
        let nested = aml_decode_value_internal(&mut body, depth + 1, budget, true);
        if !nested.valid {
            aml_data_fail(cursor);
            return aml_data_invalid();
        }
        element += 1;
    }
    // A lista declarada deve consumir exatamente o corpo do PkgLength. Não
    // existe scan heurístico nem tolerância silenciosa a bytes desconhecidos.
    if aml_cursor_remaining(&body) != 0 {
        aml_data_fail(cursor);
        return aml_data_invalid();
    }

    let end = unsafe { (*cursor).offset };
    return AmlDataObject {
        kind: if opcode == AML_PACKAGE_OP {
            AML_DATA_KIND_PACKAGE
        } else {
            AML_DATA_KIND_VAR_PACKAGE
        },
        integer_value: 0,
        data: body.base,
        data_length: body.length,
        element_count: element_count,
        encoded_bytes: end - start,
        valid: true
    };
}

@system
pub fn aml_decode_term_arg_constant(cursor: *mut AmlCursor) -> AmlInteger {
    return aml_decode_term_arg_constant_internal(cursor);
}

@system
pub fn aml_decode_data_object(cursor: *mut AmlCursor) -> AmlDataObject {
    let mut budget: usize = AML_DATA_MAX_OBJECTS;
    let result = aml_decode_value_internal(cursor, 0, &mut budget, false);
    if result.valid && result.kind == AML_DATA_KIND_NAME_REFERENCE {
        aml_data_fail(cursor);
        return aml_data_invalid();
    }
    return result;
}

@system
pub fn aml_skip_data_ref_object(cursor: *mut AmlCursor) -> bool {
    let mut budget: usize = AML_DATA_MAX_OBJECTS;
    let result = aml_decode_value_internal(cursor, 0, &mut budget, false);
    return result.valid && result.kind != AML_DATA_KIND_NAME_REFERENCE;
}

@system
pub fn aml_skip_package_element(cursor: *mut AmlCursor) -> bool {
    let mut budget: usize = AML_DATA_MAX_OBJECTS;
    return aml_decode_value_internal(cursor, 0, &mut budget, true).valid;
}

@system
pub fn aml_data_is_ready() -> bool {
    unsafe { return AML_DATA_READY; }
}

@system
pub fn aml_data_self_test() -> bool {
    unsafe { AML_DATA_READY = false; }

    let string_bytes: [u8; 5] = [AML_STRING_PREFIX,66,75,78,0];
    let mut string_cursor = aml_cursor_new(&string_bytes[0], 5);
    let string_object = aml_decode_data_object(&mut string_cursor);
    if !string_object.valid || string_object.kind != AML_DATA_KIND_STRING ||
       string_object.data_length != 3 || string_object.encoded_bytes != 5 ||
       string_cursor.offset != 5 {
        return false;
    }

    // Buffer(3) { AA, BB, CC }; PkgLength 6 = 1 byte de length + 5 de corpo.
    let buffer_bytes: [u8; 7] = [
        AML_BUFFER_OP,0x06,AML_BYTE_PREFIX,0x03,0xAA,0xBB,0xCC
    ];
    let mut buffer_cursor = aml_cursor_new(&buffer_bytes[0], 7);
    let buffer_object = aml_decode_data_object(&mut buffer_cursor);
    if !buffer_object.valid || buffer_object.kind != AML_DATA_KIND_BUFFER ||
       buffer_object.integer_value != 3 || buffer_object.data_length != 3 ||
       buffer_object.encoded_bytes != 7 || buffer_cursor.offset != 7 {
        return false;
    }

    // Package(2) { ByteConst(0x2A), "X" }.
    let package_bytes: [u8; 8] = [
        AML_PACKAGE_OP,0x07,0x02,AML_BYTE_PREFIX,0x2A,AML_STRING_PREFIX,88,0
    ];
    let mut package_cursor = aml_cursor_new(&package_bytes[0], 8);
    let package_object = aml_decode_data_object(&mut package_cursor);
    if !package_object.valid || package_object.kind != AML_DATA_KIND_PACKAGE ||
       package_object.element_count != 2 || package_object.encoded_bytes != 8 ||
       package_cursor.offset != 8 {
        return false;
    }

    // VarPackage(ByteConst(2)) { Zero, One }.
    let var_package_bytes: [u8; 6] = [
        AML_VAR_PACKAGE_OP,0x05,AML_BYTE_PREFIX,0x02,AML_ZERO_OP,AML_ONE_OP
    ];
    let mut var_package_cursor = aml_cursor_new(&var_package_bytes[0], 6);
    let var_package_object = aml_decode_data_object(&mut var_package_cursor);
    if !var_package_object.valid ||
       var_package_object.kind != AML_DATA_KIND_VAR_PACKAGE ||
       var_package_object.element_count != 2 ||
       var_package_cursor.offset != 6 {
        return false;
    }

    // Package aninhado: Package(1) { Package(1) { Zero } }.
    let nested_bytes: [u8; 7] = [
        AML_PACKAGE_OP,0x06,0x01,AML_PACKAGE_OP,0x03,0x01,AML_ZERO_OP
    ];
    let mut nested_cursor = aml_cursor_new(&nested_bytes[0], 7);
    let nested_object = aml_decode_data_object(&mut nested_cursor);
    if !nested_object.valid || nested_object.kind != AML_DATA_KIND_PACKAGE ||
       nested_object.element_count != 1 || nested_cursor.offset != 7 {
        return false;
    }

    // NameString é PackageElement válido, mas não DataObject isolado.
    let name_element_bytes: [u8; 4] = [95,72,73,68];
    let mut name_element_cursor = aml_cursor_new(&name_element_bytes[0], 4);
    if !aml_skip_package_element(&mut name_element_cursor) ||
       name_element_cursor.offset != 4 {
        return false;
    }

    let standalone_name_bytes: [u8; 4] = [95,83,84,65];
    let mut standalone_name_cursor = aml_cursor_new(&standalone_name_bytes[0], 4);
    if aml_skip_data_ref_object(&mut standalone_name_cursor) {
        return false;
    }

    // String truncada e opcode fora do subconjunto devem falhar fechados.
    let truncated_string: [u8; 2] = [AML_STRING_PREFIX,65];
    let mut truncated_cursor = aml_cursor_new(&truncated_string[0], 2);
    if aml_decode_data_object(&mut truncated_cursor).valid ||
       truncated_cursor.valid {
        return false;
    }

    let unsupported_bytes: [u8; 1] = [0x5B];
    let mut unsupported_cursor = aml_cursor_new(&unsupported_bytes[0], 1);
    if aml_skip_data_ref_object(&mut unsupported_cursor) ||
       unsupported_cursor.valid {
        return false;
    }

    unsafe {
        __dma_fence();
        AML_DATA_READY = true;
    }
    return true;
}

@system
pub fn aml_data_emit_ready_marker() -> bool {
    if !aml_data_is_ready() { return false; }
    let marker: [u8; 26] = [
        66,65,75,69,78,58,65,67,80,73,95,65,77,76,95,68,65,84,65,95,
        82,69,65,68,89,10
    ];
    unsafe { return x86_serial_write_buffer(&marker[0], 26); }
}
