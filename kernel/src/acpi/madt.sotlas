// Baken OS — parser read-only da MADT (APIC Multiple APIC Description Table).
//
// Descobre LAPIC, IOAPICs e Interrupt Source Overrides. Não habilita APIC,
// não escreve MMIO e não programa redirection entries nesta fase.

module kernel::acpi::madt;

import kernel::acpi::tables::*;

pub const MADT_ENTRY_LOCAL_APIC: u8 = 0;
pub const MADT_ENTRY_IO_APIC: u8 = 1;
pub const MADT_ENTRY_INTERRUPT_OVERRIDE: u8 = 2;
pub const MADT_ENTRY_LOCAL_APIC_ADDRESS_OVERRIDE: u8 = 5;

pub const MADT_MAX_IOAPICS: usize = 8;
pub const MADT_MAX_OVERRIDES: usize = 32;

pub struct MadtIoApic {
    pub id: u8;
    pub mmio_address: u32;
    pub gsi_base: u32;
    pub valid: bool;
}

pub struct MadtInterruptOverride {
    pub bus: u8;
    pub source_irq: u8;
    pub gsi: u32;
    pub flags: u16;
    pub valid: bool;
}

static mut MADT_READY: bool = false;
static mut MADT_LAPIC_ADDRESS: u64 = 0;
static mut MADT_FLAGS: u32 = 0;
static mut MADT_IOAPIC_COUNT: u32 = 0;
static mut MADT_OVERRIDE_COUNT: u32 = 0;

static mut MADT_IOAPICS: [MadtIoApic; MADT_MAX_IOAPICS] = [
    MadtIoApic { id: 0, mmio_address: 0, gsi_base: 0, valid: false };
    MADT_MAX_IOAPICS
];

static mut MADT_OVERRIDES: [MadtInterruptOverride; MADT_MAX_OVERRIDES] = [
    MadtInterruptOverride { bus: 0, source_irq: 0, gsi: 0, flags: 0, valid: false };
    MADT_MAX_OVERRIDES
];

@system
fn madt_read_u16(base: *const u8, offset: usize) -> u16 {
    unsafe {
        return (base[offset] as u16) | ((base[offset + 1] as u16) << 8);
    }
}

@system
fn madt_read_u32(base: *const u8, offset: usize) -> u32 {
    unsafe {
        return (base[offset] as u32) |
            ((base[offset + 1] as u32) << 8) |
            ((base[offset + 2] as u32) << 16) |
            ((base[offset + 3] as u32) << 24);
    }
}

@system
fn madt_read_u64(base: *const u8, offset: usize) -> u64 {
    return (madt_read_u32(base, offset) as u64) |
        ((madt_read_u32(base, offset + 4) as u64) << 32);
}

@system
pub fn madt_init() -> bool {
    unsafe {
        MADT_READY = false;
        MADT_LAPIC_ADDRESS = 0;
        MADT_FLAGS = 0;
        MADT_IOAPIC_COUNT = 0;
        MADT_OVERRIDE_COUNT = 0;
        for mut i in 0..MADT_MAX_IOAPICS {
            MADT_IOAPICS[i].valid = false;
        }
        for mut i in 0..MADT_MAX_OVERRIDES {
            MADT_OVERRIDES[i].valid = false;
        }
    }

    let table = acpi_madt();
    if table == (null as *const u8) { return false; }

    let total_length = madt_read_u32(table, 4) as usize;
    if total_length < 44 || total_length > ACPI_MAX_SDT_LENGTH { return false; }

    unsafe {
        MADT_LAPIC_ADDRESS = madt_read_u32(table, 36) as u64;
        MADT_FLAGS = madt_read_u32(table, 40);
    }

    let mut offset: usize = 44;
    while offset + 2 <= total_length {
        let mut entry_type: u8 = 0;
        let mut entry_length: usize = 0;
        unsafe {
            entry_type = table[offset];
            entry_length = table[offset + 1] as usize;
        }
        if entry_length < 2 || offset + entry_length > total_length { return false; }

        if entry_type == MADT_ENTRY_IO_APIC && entry_length >= 12 {
            unsafe {
                if MADT_IOAPIC_COUNT < MADT_MAX_IOAPICS as u32 {
                    let idx = MADT_IOAPIC_COUNT as usize;
                    MADT_IOAPICS[idx].id = table[offset + 2];
                    MADT_IOAPICS[idx].mmio_address = madt_read_u32(table, offset + 4);
                    MADT_IOAPICS[idx].gsi_base = madt_read_u32(table, offset + 8);
                    MADT_IOAPICS[idx].valid = true;
                    MADT_IOAPIC_COUNT += 1;
                }
            }
        } else if entry_type == MADT_ENTRY_INTERRUPT_OVERRIDE && entry_length >= 10 {
            unsafe {
                if MADT_OVERRIDE_COUNT < MADT_MAX_OVERRIDES as u32 {
                    let idx = MADT_OVERRIDE_COUNT as usize;
                    MADT_OVERRIDES[idx].bus = table[offset + 2];
                    MADT_OVERRIDES[idx].source_irq = table[offset + 3];
                    MADT_OVERRIDES[idx].gsi = madt_read_u32(table, offset + 4);
                    MADT_OVERRIDES[idx].flags = madt_read_u16(table, offset + 8);
                    MADT_OVERRIDES[idx].valid = true;
                    MADT_OVERRIDE_COUNT += 1;
                }
            }
        } else if entry_type == MADT_ENTRY_LOCAL_APIC_ADDRESS_OVERRIDE && entry_length >= 12 {
            unsafe {
                MADT_LAPIC_ADDRESS = madt_read_u64(table, offset + 4);
            }
        }

        offset += entry_length;
    }

    unsafe {
        MADT_READY = MADT_LAPIC_ADDRESS != 0 && MADT_IOAPIC_COUNT > 0;
        return MADT_READY;
    }
}

@system
pub fn madt_is_ready() -> bool { unsafe { return MADT_READY; } }

@system
pub fn madt_lapic_address() -> u64 { unsafe { return MADT_LAPIC_ADDRESS; } }

@system
pub fn madt_flags() -> u32 { unsafe { return MADT_FLAGS; } }

@system
pub fn madt_ioapic_count() -> u32 { unsafe { return MADT_IOAPIC_COUNT; } }

@system
pub fn madt_ioapic(index: u32) -> *const MadtIoApic {
    unsafe {
        if index >= MADT_IOAPIC_COUNT { return null as *const MadtIoApic; }
        if !MADT_IOAPICS[index as usize].valid { return null as *const MadtIoApic; }
        return &MADT_IOAPICS[index as usize];
    }
}

@system
pub fn madt_irq_to_gsi(irq: u8) -> u32 {
    unsafe {
        for mut index in 0..MADT_OVERRIDE_COUNT {
            let entry = &MADT_OVERRIDES[index as usize];
            if entry.valid && entry.bus == 0 && entry.source_irq == irq {
                return entry.gsi;
            }
        }
    }
    return irq as u32;
}

@system
pub fn madt_irq_flags(irq: u8) -> u16 {
    unsafe {
        for mut index in 0..MADT_OVERRIDE_COUNT {
            let entry = &MADT_OVERRIDES[index as usize];
            if entry.valid && entry.bus == 0 && entry.source_irq == irq {
                return entry.flags;
            }
        }
    }
    return 0;
}
