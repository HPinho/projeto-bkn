// Baken OS — AML-5: descoberta estática e read-only de dispositivos ACPI.
//
// Consome exclusivamente o namespace já publicado pelo AML-4. Não executa
// Method, não toca OperationRegion e não inicializa hardware. Objetos dinâmicos
// são registrados como dependentes do evaluator futuro (AML-6). ResourceTemplate
// estático é validado estruturalmente com limites fixos e EndTag obrigatório.

module kernel::acpi::aml_discovery;

import kernel::acpi::aml_decoder::*;
import kernel::acpi::aml_data::*;
import kernel::acpi::aml_namespace::*;
import kernel::acpi::aml_loader::*;
import kernel::arch::x86_64::serial::*;

pub const AML_DISCOVERY_MAX_DEVICES: usize = 512;
pub const AML_DISCOVERY_MAX_COMPAT_IDS: usize = 1024;
pub const AML_DISCOVERY_MAX_COMPAT_IDS_PER_DEVICE: usize = 32;
pub const AML_DISCOVERY_MAX_RESOURCES: usize = 4096;
pub const AML_DISCOVERY_MAX_ID_BYTES: usize = 64;

pub const AML_DISCOVERY_ID_NONE: u8 = 0;
pub const AML_DISCOVERY_ID_INTEGER: u8 = 1;
pub const AML_DISCOVERY_ID_STRING: u8 = 2;

pub const AML_RESOURCE_KIND_SMALL: u8 = 1;
pub const AML_RESOURCE_KIND_LARGE: u8 = 2;

pub const AML_NAME_HID: u32 = 0x4449485F;
pub const AML_NAME_CID: u32 = 0x4449435F;
pub const AML_NAME_UID: u32 = 0x4449555F;
pub const AML_NAME_ADR: u32 = 0x5244415F;
pub const AML_NAME_STA: u32 = 0x4154535F;
pub const AML_NAME_CRS: u32 = 0x5352435F;

pub const AML_STA_DEFAULT: u32 = 0x0000000F;
pub const AML_STA_VALID_MASK: u32 = 0x0000001F;
pub const AML_RESOURCE_END_TAG_NAME: u8 = 0x0F;
pub const AML_RESOURCE_END_TAG_LENGTH: usize = 1;

const AML_DISCOVERY_ERROR_NAMESPACE: u8 = 1;
const AML_DISCOVERY_ERROR_CAPACITY: u8 = 2;
const AML_DISCOVERY_ERROR_HID: u8 = 3;
const AML_DISCOVERY_ERROR_CID: u8 = 4;
const AML_DISCOVERY_ERROR_UID: u8 = 5;
const AML_DISCOVERY_ERROR_ADR: u8 = 6;
const AML_DISCOVERY_ERROR_STA: u8 = 7;
const AML_DISCOVERY_ERROR_CRS: u8 = 8;
const AML_DISCOVERY_ERROR_RESOURCE: u8 = 9;

pub struct AmlDiscoveryId {
    pub kind: u8;
    pub integer_value: u64;
    pub data: *const u8;
    pub data_length: usize;
    pub valid: bool;
}

pub struct AmlResourceDescriptor {
    pub device_slot: usize;
    pub offset: usize;
    pub kind: u8;
    pub item_name: u8;
    pub payload: *const u8;
    pub payload_length: usize;
    pub valid: bool;
}

pub struct AmlDiscoveredDevice {
    pub namespace_index: usize;
    pub parent_namespace_index: usize;

    pub hid_kind: u8;
    pub hid_integer: u64;
    pub hid_data: *const u8;
    pub hid_length: usize;
    pub hid_requires_evaluator: bool;

    pub cid_start: usize;
    pub cid_count: usize;
    pub cid_requires_evaluator: bool;

    pub uid_kind: u8;
    pub uid_integer: u64;
    pub uid_data: *const u8;
    pub uid_length: usize;
    pub uid_requires_evaluator: bool;

    pub has_adr: bool;
    pub adr: u64;

    pub status_known: bool;
    pub status_requires_evaluator: bool;
    pub status: u32;

    pub crs_static: bool;
    pub crs_requires_evaluator: bool;
    pub crs_data: *const u8;
    pub crs_length: usize;
    pub resource_start: usize;
    pub resource_count: usize;

    pub valid: bool;
}

static mut AML_DISCOVERY_DEVICES: [AmlDiscoveredDevice; AML_DISCOVERY_MAX_DEVICES] = [
    AmlDiscoveredDevice {
        namespace_index: AML_NAMESPACE_INVALID_INDEX,
        parent_namespace_index: AML_NAMESPACE_INVALID_INDEX,
        hid_kind: AML_DISCOVERY_ID_NONE,
        hid_integer: 0,
        hid_data: null as *const u8,
        hid_length: 0,
        hid_requires_evaluator: false,
        cid_start: 0,
        cid_count: 0,
        cid_requires_evaluator: false,
        uid_kind: AML_DISCOVERY_ID_NONE,
        uid_integer: 0,
        uid_data: null as *const u8,
        uid_length: 0,
        uid_requires_evaluator: false,
        has_adr: false,
        adr: 0,
        status_known: false,
        status_requires_evaluator: false,
        status: 0,
        crs_static: false,
        crs_requires_evaluator: false,
        crs_data: null as *const u8,
        crs_length: 0,
        resource_start: 0,
        resource_count: 0,
        valid: false
    };
    AML_DISCOVERY_MAX_DEVICES
];

static mut AML_DISCOVERY_COMPAT_IDS: [AmlDiscoveryId; AML_DISCOVERY_MAX_COMPAT_IDS] = [
    AmlDiscoveryId {
        kind: AML_DISCOVERY_ID_NONE,
        integer_value: 0,
        data: null as *const u8,
        data_length: 0,
        valid: false
    };
    AML_DISCOVERY_MAX_COMPAT_IDS
];

static mut AML_DISCOVERY_RESOURCES: [AmlResourceDescriptor; AML_DISCOVERY_MAX_RESOURCES] = [
    AmlResourceDescriptor {
        device_slot: 0,
        offset: 0,
        kind: 0,
        item_name: 0,
        payload: null as *const u8,
        payload_length: 0,
        valid: false
    };
    AML_DISCOVERY_MAX_RESOURCES
];

static mut AML_DISCOVERY_DEVICE_COUNT: usize = 0;
static mut AML_DISCOVERY_COMPAT_ID_COUNT: usize = 0;
static mut AML_DISCOVERY_RESOURCE_COUNT: usize = 0;
static mut AML_DISCOVERY_READY: bool = false;
static mut AML_DISCOVERY_LAST_ERROR: u32 = 0;
static mut AML_DISCOVERY_LAST_OFFSET: usize = 0;

@system
fn aml_discovery_fail(reason: u8, namespace_index: usize, offset: usize) -> bool {
    unsafe {
        AML_DISCOVERY_LAST_ERROR = ((reason as u32) << 24) |
            ((namespace_index & 0x00FFFFFF) as u32);
        AML_DISCOVERY_LAST_OFFSET = offset;
    }
    return false;
}

@system
fn aml_discovery_reset() -> void {
    unsafe {
        AML_DISCOVERY_DEVICE_COUNT = 0;
        AML_DISCOVERY_COMPAT_ID_COUNT = 0;
        AML_DISCOVERY_RESOURCE_COUNT = 0;
        AML_DISCOVERY_READY = false;
        AML_DISCOVERY_LAST_ERROR = 0;
        AML_DISCOVERY_LAST_OFFSET = 0;

        let mut index: usize = 0;
        while index < AML_DISCOVERY_MAX_DEVICES {
            AML_DISCOVERY_DEVICES[index].namespace_index = AML_NAMESPACE_INVALID_INDEX;
            AML_DISCOVERY_DEVICES[index].parent_namespace_index = AML_NAMESPACE_INVALID_INDEX;
            AML_DISCOVERY_DEVICES[index].hid_kind = AML_DISCOVERY_ID_NONE;
            AML_DISCOVERY_DEVICES[index].hid_integer = 0;
            AML_DISCOVERY_DEVICES[index].hid_data = null as *const u8;
            AML_DISCOVERY_DEVICES[index].hid_length = 0;
            AML_DISCOVERY_DEVICES[index].hid_requires_evaluator = false;
            AML_DISCOVERY_DEVICES[index].cid_start = 0;
            AML_DISCOVERY_DEVICES[index].cid_count = 0;
            AML_DISCOVERY_DEVICES[index].cid_requires_evaluator = false;
            AML_DISCOVERY_DEVICES[index].uid_kind = AML_DISCOVERY_ID_NONE;
            AML_DISCOVERY_DEVICES[index].uid_integer = 0;
            AML_DISCOVERY_DEVICES[index].uid_data = null as *const u8;
            AML_DISCOVERY_DEVICES[index].uid_length = 0;
            AML_DISCOVERY_DEVICES[index].uid_requires_evaluator = false;
            AML_DISCOVERY_DEVICES[index].has_adr = false;
            AML_DISCOVERY_DEVICES[index].adr = 0;
            AML_DISCOVERY_DEVICES[index].status_known = false;
            AML_DISCOVERY_DEVICES[index].status_requires_evaluator = false;
            AML_DISCOVERY_DEVICES[index].status = 0;
            AML_DISCOVERY_DEVICES[index].crs_static = false;
            AML_DISCOVERY_DEVICES[index].crs_requires_evaluator = false;
            AML_DISCOVERY_DEVICES[index].crs_data = null as *const u8;
            AML_DISCOVERY_DEVICES[index].crs_length = 0;
            AML_DISCOVERY_DEVICES[index].resource_start = 0;
            AML_DISCOVERY_DEVICES[index].resource_count = 0;
            AML_DISCOVERY_DEVICES[index].valid = false;
            index += 1;
        }

        index = 0;
        while index < AML_DISCOVERY_MAX_COMPAT_IDS {
            AML_DISCOVERY_COMPAT_IDS[index].kind = AML_DISCOVERY_ID_NONE;
            AML_DISCOVERY_COMPAT_IDS[index].integer_value = 0;
            AML_DISCOVERY_COMPAT_IDS[index].data = null as *const u8;
            AML_DISCOVERY_COMPAT_IDS[index].data_length = 0;
            AML_DISCOVERY_COMPAT_IDS[index].valid = false;
            index += 1;
        }

        index = 0;
        while index < AML_DISCOVERY_MAX_RESOURCES {
            AML_DISCOVERY_RESOURCES[index].device_slot = 0;
            AML_DISCOVERY_RESOURCES[index].offset = 0;
            AML_DISCOVERY_RESOURCES[index].kind = 0;
            AML_DISCOVERY_RESOURCES[index].item_name = 0;
            AML_DISCOVERY_RESOURCES[index].payload = null as *const u8;
            AML_DISCOVERY_RESOURCES[index].payload_length = 0;
            AML_DISCOVERY_RESOURCES[index].valid = false;
            index += 1;
        }
    }
}

@system
fn aml_discovery_pointer_add(base: *const u8, offset: usize) -> *const u8 {
    if base == (null as *const u8) { return null as *const u8; }
    let address = base as u64;
    let delta = offset as u64;
    if delta > 0xFFFFFFFFFFFFFFFF - address { return null as *const u8; }
    unsafe { return (address + delta) as *const u8; }
}

@system
fn aml_discovery_ascii_upper(value: u8) -> bool {
    return value >= 'A' as u8 && value <= 'Z' as u8;
}

@system
fn aml_discovery_ascii_digit(value: u8) -> bool {
    return value >= '0' as u8 && value <= '9' as u8;
}

@system
fn aml_discovery_ascii_hex(value: u8) -> bool {
    return aml_discovery_ascii_digit(value) ||
        (value >= 'A' as u8 && value <= 'F' as u8);
}

@system
fn aml_discovery_string_printable(data: *const u8, length: usize) -> bool {
    if data == (null as *const u8) || length == 0 ||
       length > AML_DISCOVERY_MAX_ID_BYTES { return false; }
    let mut index: usize = 0;
    while index < length {
        let value = unsafe { data[index] };
        if value < 0x20 || value > 0x7E { return false; }
        index += 1;
    }
    return unsafe { data[0] != '*' as u8 };
}

@system
fn aml_discovery_hid_string_valid(data: *const u8, length: usize) -> bool {
    if data == (null as *const u8) { return false; }
    if length == 7 {
        let mut index: usize = 0;
        while index < 3 {
            if !aml_discovery_ascii_upper(unsafe { data[index] }) { return false; }
            index += 1;
        }
        while index < 7 {
            if !aml_discovery_ascii_hex(unsafe { data[index] }) { return false; }
            index += 1;
        }
        return true;
    }
    if length == 8 {
        let mut index: usize = 0;
        while index < 4 {
            let value = unsafe { data[index] };
            if !aml_discovery_ascii_upper(value) && !aml_discovery_ascii_digit(value) {
                return false;
            }
            index += 1;
        }
        while index < 8 {
            if !aml_discovery_ascii_hex(unsafe { data[index] }) { return false; }
            index += 1;
        }
        return true;
    }
    return false;
}

@system
fn aml_discovery_swap_u32(value: u32) -> u32 {
    return ((value & 0x000000FF) << 24) |
        ((value & 0x0000FF00) << 8) |
        ((value & 0x00FF0000) >> 8) |
        ((value & 0xFF000000) >> 24);
}

@system
fn aml_discovery_eisa_id_valid(value: u64) -> bool {
    if value > 0xFFFFFFFF { return false; }
    let swapped = aml_discovery_swap_u32(value as u32);
    let first = ((swapped >> 26) & 0x1F) as u8;
    let second = ((swapped >> 21) & 0x1F) as u8;
    let third = ((swapped >> 16) & 0x1F) as u8;
    return first >= 1 && first <= 26 &&
        second >= 1 && second <= 26 && third >= 1 && third <= 26;
}

@system
fn aml_discovery_hex_char(value: u8) -> u8 {
    if value < 10 { return ('0' as u8) + value; }
    return ('A' as u8) + (value - 10);
}

@system
pub fn aml_discovery_eisa_id_to_string(value: u64, output: *mut u8,
                                       capacity: usize) -> bool {
    if output == (null as *mut u8) || capacity < 8 ||
       !aml_discovery_eisa_id_valid(value) { return false; }
    let swapped = aml_discovery_swap_u32(value as u32);
    unsafe {
        output[0] = 0x40 + (((swapped >> 26) & 0x1F) as u8);
        output[1] = 0x40 + (((swapped >> 21) & 0x1F) as u8);
        output[2] = 0x40 + (((swapped >> 16) & 0x1F) as u8);
        output[3] = aml_discovery_hex_char(((swapped >> 12) & 0x0F) as u8);
        output[4] = aml_discovery_hex_char(((swapped >> 8) & 0x0F) as u8);
        output[5] = aml_discovery_hex_char(((swapped >> 4) & 0x0F) as u8);
        output[6] = aml_discovery_hex_char((swapped & 0x0F) as u8);
        output[7] = 0;
    }
    return true;
}

@system
fn aml_discovery_node_id(node: *const AmlNamespaceNode,
                         strict_hid: bool) -> AmlDiscoveryId {
    let mut result = AmlDiscoveryId {
        kind: AML_DISCOVERY_ID_NONE,
        integer_value: 0,
        data: null as *const u8,
        data_length: 0,
        valid: false
    };
    if node == (null as *const AmlNamespaceNode) { return result; }
    unsafe {
        if !(*node).valid || (*node).kind != AML_NAMESPACE_KIND_NAME { return result; }
        if (*node).value_kind == AML_NAMESPACE_VALUE_INTEGER {
            if !aml_discovery_eisa_id_valid((*node).integer_value) { return result; }
            result.kind = AML_DISCOVERY_ID_INTEGER;
            result.integer_value = (*node).integer_value;
            result.valid = true;
            return result;
        }
        if (*node).value_kind == AML_NAMESPACE_VALUE_STRING {
            let valid_string = if strict_hid {
                aml_discovery_hid_string_valid((*node).aml_body, (*node).aml_body_length)
            } else {
                aml_discovery_string_printable((*node).aml_body, (*node).aml_body_length)
            };
            if !valid_string { return result; }
            result.kind = AML_DISCOVERY_ID_STRING;
            result.data = (*node).aml_body;
            result.data_length = (*node).aml_body_length;
            result.valid = true;
            return result;
        }
    }
    return result;
}

@system
fn aml_discovery_append_compat_id(id: *const AmlDiscoveryId) -> bool {
    if id == (null as *const AmlDiscoveryId) { return false; }
    unsafe {
        if !(*id).valid || AML_DISCOVERY_COMPAT_ID_COUNT >= AML_DISCOVERY_MAX_COMPAT_IDS {
            return false;
        }
        let index = AML_DISCOVERY_COMPAT_ID_COUNT;
        AML_DISCOVERY_COMPAT_IDS[index].kind = (*id).kind;
        AML_DISCOVERY_COMPAT_IDS[index].integer_value = (*id).integer_value;
        AML_DISCOVERY_COMPAT_IDS[index].data = (*id).data;
        AML_DISCOVERY_COMPAT_IDS[index].data_length = (*id).data_length;
        AML_DISCOVERY_COMPAT_IDS[index].valid = true;
        AML_DISCOVERY_COMPAT_ID_COUNT += 1;
    }
    return true;
}

@system
fn aml_discovery_parse_cid_package(node: *const AmlNamespaceNode,
                                   device_slot: usize) -> bool {
    if node == (null as *const AmlNamespaceNode) { return false; }
    unsafe {
        if !(*node).valid || (*node).kind != AML_NAMESPACE_KIND_NAME ||
           ((*node).value_kind != AML_NAMESPACE_VALUE_PACKAGE &&
            (*node).value_kind != AML_NAMESPACE_VALUE_VAR_PACKAGE) ||
           (*node).aml_body == (null as *const u8) || (*node).aml_body_length == 0 {
            return false;
        }
        let mut cursor = aml_cursor_new((*node).aml_body, (*node).aml_body_length);
        let mut count: usize = 0;
        if (*node).value_kind == AML_NAMESPACE_VALUE_PACKAGE {
            if aml_cursor_remaining(&cursor) == 0 { return false; }
            count = aml_cursor_read_u8(&mut cursor) as usize;
        } else {
            let count_object = aml_decode_term_arg_constant(&mut cursor);
            if !count_object.valid || count_object.value > AML_DISCOVERY_MAX_COMPAT_IDS_PER_DEVICE as u64 {
                return false;
            }
            count = count_object.value as usize;
        }
        if count == 0 || count > AML_DISCOVERY_MAX_COMPAT_IDS_PER_DEVICE { return false; }
        if AML_DISCOVERY_COMPAT_ID_COUNT + count > AML_DISCOVERY_MAX_COMPAT_IDS { return false; }

        let first = AML_DISCOVERY_COMPAT_ID_COUNT;
        let mut element: usize = 0;
        while element < count {
            let data = aml_decode_data_object(&mut cursor);
            if !data.valid { return false; }
            let mut id = AmlDiscoveryId {
                kind: AML_DISCOVERY_ID_NONE,
                integer_value: 0,
                data: null as *const u8,
                data_length: 0,
                valid: false
            };
            if data.kind == AML_DATA_KIND_INTEGER {
                if !aml_discovery_eisa_id_valid(data.integer_value) { return false; }
                id.kind = AML_DISCOVERY_ID_INTEGER;
                id.integer_value = data.integer_value;
                id.valid = true;
            } else if data.kind == AML_DATA_KIND_STRING {
                if !aml_discovery_string_printable(data.data, data.data_length) { return false; }
                id.kind = AML_DISCOVERY_ID_STRING;
                id.data = data.data;
                id.data_length = data.data_length;
                id.valid = true;
            } else {
                return false;
            }
            if !aml_discovery_append_compat_id(&id) { return false; }
            element += 1;
        }
        if aml_cursor_remaining(&cursor) != 0 { return false; }
        AML_DISCOVERY_DEVICES[device_slot].cid_start = first;
        AML_DISCOVERY_DEVICES[device_slot].cid_count = count;
    }
    return true;
}

@system
fn aml_discovery_resource_checksum_valid(data: *const u8, length: usize,
                                         checksum: u8) -> bool {
    if checksum == 0 { return true; }
    if data == (null as *const u8) || length == 0 { return false; }
    let mut sum: u32 = 0;
    let mut index: usize = 0;
    while index < length {
        sum = sum + (unsafe { data[index] } as u32);
        index += 1;
    }
    return (sum & 0xFF) == 0;
}

@system
fn aml_discovery_append_resource(device_slot: usize, offset: usize,
                                 kind: u8, item_name: u8,
                                 payload: *const u8, payload_length: usize) -> bool {
    unsafe {
        if AML_DISCOVERY_RESOURCE_COUNT >= AML_DISCOVERY_MAX_RESOURCES { return false; }
        if payload == (null as *const u8) && payload_length != 0 { return false; }
        let index = AML_DISCOVERY_RESOURCE_COUNT;
        AML_DISCOVERY_RESOURCES[index].device_slot = device_slot;
        AML_DISCOVERY_RESOURCES[index].offset = offset;
        AML_DISCOVERY_RESOURCES[index].kind = kind;
        AML_DISCOVERY_RESOURCES[index].item_name = item_name;
        AML_DISCOVERY_RESOURCES[index].payload = payload;
        AML_DISCOVERY_RESOURCES[index].payload_length = payload_length;
        AML_DISCOVERY_RESOURCES[index].valid = true;
        AML_DISCOVERY_RESOURCE_COUNT += 1;
    }
    return true;
}

@system
fn aml_discovery_parse_resource_template(data: *const u8, length: usize,
                                         device_slot: usize) -> bool {
    if data == (null as *const u8) || length < 2 { return false; }
    let first_resource = unsafe { AML_DISCOVERY_RESOURCE_COUNT };
    let mut offset: usize = 0;
    let mut ended = false;
    while offset < length && !ended {
        let tag = unsafe { data[offset] };
        let mut header_length: usize = 0;
        let mut payload_length: usize = 0;
        let mut item_name: u8 = 0;
        let mut kind: u8 = 0;

        if (tag & 0x80) == 0 {
            header_length = 1;
            payload_length = (tag & 0x07) as usize;
            item_name = (tag >> 3) & 0x0F;
            kind = AML_RESOURCE_KIND_SMALL;
        } else {
            if length - offset < 3 { return false; }
            header_length = 3;
            item_name = tag & 0x7F;
            kind = AML_RESOURCE_KIND_LARGE;
            payload_length = (unsafe { data[offset + 1] } as usize) |
                ((unsafe { data[offset + 2] } as usize) << 8);
        }

        if header_length > length - offset ||
           payload_length > length - offset - header_length { return false; }
        let payload = aml_discovery_pointer_add(data, offset + header_length);
        if !aml_discovery_append_resource(
            device_slot, offset, kind, item_name, payload, payload_length
        ) { return false; }

        let total = header_length + payload_length;
        offset += total;

        if kind == AML_RESOURCE_KIND_SMALL && item_name == AML_RESOURCE_END_TAG_NAME {
            if payload_length != AML_RESOURCE_END_TAG_LENGTH || offset != length {
                return false;
            }
            let checksum = unsafe { data[offset - 1] };
            if !aml_discovery_resource_checksum_valid(data, length, checksum) {
                return false;
            }
            ended = true;
        }
    }
    if !ended || offset != length { return false; }
    unsafe {
        AML_DISCOVERY_DEVICES[device_slot].resource_start = first_resource;
        AML_DISCOVERY_DEVICES[device_slot].resource_count =
            AML_DISCOVERY_RESOURCE_COUNT - first_resource;
    }
    return true;
}

@system
fn aml_discovery_read_device(namespace_index: usize, device_slot: usize) -> bool {
    let node = aml_namespace_node(namespace_index);
    if node == (null as *const AmlNamespaceNode) { return false; }
    unsafe {
        if !(*node).valid || (*node).kind != AML_NAMESPACE_KIND_DEVICE { return false; }
        AML_DISCOVERY_DEVICES[device_slot].namespace_index = namespace_index;
        AML_DISCOVERY_DEVICES[device_slot].parent_namespace_index = (*node).parent;
        AML_DISCOVERY_DEVICES[device_slot].cid_start = AML_DISCOVERY_COMPAT_ID_COUNT;
        AML_DISCOVERY_DEVICES[device_slot].resource_start = AML_DISCOVERY_RESOURCE_COUNT;
    }

    let hid_index = aml_namespace_find_child(namespace_index, AML_NAME_HID);
    if hid_index != AML_NAMESPACE_INVALID_INDEX {
        let hid_node = aml_namespace_node(hid_index);
        if hid_node == (null as *const AmlNamespaceNode) {
            return aml_discovery_fail(AML_DISCOVERY_ERROR_HID, namespace_index, 0);
        }
        unsafe {
            if (*hid_node).kind == AML_NAMESPACE_KIND_METHOD {
                AML_DISCOVERY_DEVICES[device_slot].hid_requires_evaluator = true;
            } else {
                let id = aml_discovery_node_id(hid_node, true);
                if !id.valid {
                    return aml_discovery_fail(AML_DISCOVERY_ERROR_HID, namespace_index, 0);
                }
                AML_DISCOVERY_DEVICES[device_slot].hid_kind = id.kind;
                AML_DISCOVERY_DEVICES[device_slot].hid_integer = id.integer_value;
                AML_DISCOVERY_DEVICES[device_slot].hid_data = id.data;
                AML_DISCOVERY_DEVICES[device_slot].hid_length = id.data_length;
            }
        }
    }

    let cid_index = aml_namespace_find_child(namespace_index, AML_NAME_CID);
    if cid_index != AML_NAMESPACE_INVALID_INDEX {
        let cid_node = aml_namespace_node(cid_index);
        if cid_node == (null as *const AmlNamespaceNode) {
            return aml_discovery_fail(AML_DISCOVERY_ERROR_CID, namespace_index, 0);
        }
        unsafe {
            if (*cid_node).kind == AML_NAMESPACE_KIND_METHOD {
                AML_DISCOVERY_DEVICES[device_slot].cid_requires_evaluator = true;
            } else if (*cid_node).kind == AML_NAMESPACE_KIND_NAME &&
                      ((*cid_node).value_kind == AML_NAMESPACE_VALUE_INTEGER ||
                       (*cid_node).value_kind == AML_NAMESPACE_VALUE_STRING) {
                let id = aml_discovery_node_id(cid_node, false);
                if !id.valid || !aml_discovery_append_compat_id(&id) {
                    return aml_discovery_fail(AML_DISCOVERY_ERROR_CID, namespace_index, 0);
                }
                AML_DISCOVERY_DEVICES[device_slot].cid_count = 1;
            } else if (*cid_node).kind == AML_NAMESPACE_KIND_NAME &&
                      ((*cid_node).value_kind == AML_NAMESPACE_VALUE_PACKAGE ||
                       (*cid_node).value_kind == AML_NAMESPACE_VALUE_VAR_PACKAGE) {
                if !aml_discovery_parse_cid_package(cid_node, device_slot) {
                    return aml_discovery_fail(AML_DISCOVERY_ERROR_CID, namespace_index, 0);
                }
            } else {
                return aml_discovery_fail(AML_DISCOVERY_ERROR_CID, namespace_index, 0);
            }
        }
    }

    let uid_index = aml_namespace_find_child(namespace_index, AML_NAME_UID);
    if uid_index != AML_NAMESPACE_INVALID_INDEX {
        let uid_node = aml_namespace_node(uid_index);
        if uid_node == (null as *const AmlNamespaceNode) {
            return aml_discovery_fail(AML_DISCOVERY_ERROR_UID, namespace_index, 0);
        }
        unsafe {
            if (*uid_node).kind == AML_NAMESPACE_KIND_METHOD {
                AML_DISCOVERY_DEVICES[device_slot].uid_requires_evaluator = true;
            } else if (*uid_node).kind == AML_NAMESPACE_KIND_NAME &&
                      (*uid_node).value_kind == AML_NAMESPACE_VALUE_INTEGER {
                AML_DISCOVERY_DEVICES[device_slot].uid_kind = AML_DISCOVERY_ID_INTEGER;
                AML_DISCOVERY_DEVICES[device_slot].uid_integer = (*uid_node).integer_value;
            } else if (*uid_node).kind == AML_NAMESPACE_KIND_NAME &&
                      (*uid_node).value_kind == AML_NAMESPACE_VALUE_STRING &&
                      aml_discovery_string_printable((*uid_node).aml_body,
                                                     (*uid_node).aml_body_length) {
                AML_DISCOVERY_DEVICES[device_slot].uid_kind = AML_DISCOVERY_ID_STRING;
                AML_DISCOVERY_DEVICES[device_slot].uid_data = (*uid_node).aml_body;
                AML_DISCOVERY_DEVICES[device_slot].uid_length = (*uid_node).aml_body_length;
            } else {
                return aml_discovery_fail(AML_DISCOVERY_ERROR_UID, namespace_index, 0);
            }
        }
    }

    let adr_index = aml_namespace_find_child(namespace_index, AML_NAME_ADR);
    if adr_index != AML_NAMESPACE_INVALID_INDEX {
        let adr_node = aml_namespace_node(adr_index);
        if adr_node == (null as *const AmlNamespaceNode) {
            return aml_discovery_fail(AML_DISCOVERY_ERROR_ADR, namespace_index, 0);
        }
        unsafe {
            if (*adr_node).kind != AML_NAMESPACE_KIND_NAME ||
               (*adr_node).value_kind != AML_NAMESPACE_VALUE_INTEGER {
                return aml_discovery_fail(AML_DISCOVERY_ERROR_ADR, namespace_index, 0);
            }
            AML_DISCOVERY_DEVICES[device_slot].has_adr = true;
            AML_DISCOVERY_DEVICES[device_slot].adr = (*adr_node).integer_value;
        }
    }

    let sta_index = aml_namespace_find_child(namespace_index, AML_NAME_STA);
    if sta_index == AML_NAMESPACE_INVALID_INDEX {
        unsafe {
            AML_DISCOVERY_DEVICES[device_slot].status_known = true;
            AML_DISCOVERY_DEVICES[device_slot].status = AML_STA_DEFAULT;
        }
    } else {
        let sta_node = aml_namespace_node(sta_index);
        if sta_node == (null as *const AmlNamespaceNode) {
            return aml_discovery_fail(AML_DISCOVERY_ERROR_STA, namespace_index, 0);
        }
        unsafe {
            if (*sta_node).kind == AML_NAMESPACE_KIND_METHOD {
                AML_DISCOVERY_DEVICES[device_slot].status_requires_evaluator = true;
            } else if (*sta_node).kind == AML_NAMESPACE_KIND_NAME &&
                      (*sta_node).value_kind == AML_NAMESPACE_VALUE_INTEGER {
                let status = (*sta_node).integer_value;
                if status > AML_STA_VALID_MASK as u64 ||
                   (status & 0x03) == 0x02 {
                    return aml_discovery_fail(AML_DISCOVERY_ERROR_STA, namespace_index, 0);
                }
                AML_DISCOVERY_DEVICES[device_slot].status_known = true;
                AML_DISCOVERY_DEVICES[device_slot].status = status as u32;
            } else {
                return aml_discovery_fail(AML_DISCOVERY_ERROR_STA, namespace_index, 0);
            }
        }
    }

    let crs_index = aml_namespace_find_child(namespace_index, AML_NAME_CRS);
    if crs_index != AML_NAMESPACE_INVALID_INDEX {
        let crs_node = aml_namespace_node(crs_index);
        if crs_node == (null as *const AmlNamespaceNode) {
            return aml_discovery_fail(AML_DISCOVERY_ERROR_CRS, namespace_index, 0);
        }
        unsafe {
            if (*crs_node).kind == AML_NAMESPACE_KIND_METHOD {
                AML_DISCOVERY_DEVICES[device_slot].crs_requires_evaluator = true;
            } else if (*crs_node).kind == AML_NAMESPACE_KIND_NAME &&
                      (*crs_node).value_kind == AML_NAMESPACE_VALUE_BUFFER &&
                      (*crs_node).aml_body != (null as *const u8) &&
                      (*crs_node).aml_body_length != 0 {
                AML_DISCOVERY_DEVICES[device_slot].crs_data = (*crs_node).aml_body;
                AML_DISCOVERY_DEVICES[device_slot].crs_length = (*crs_node).aml_body_length;
                if !aml_discovery_parse_resource_template(
                    (*crs_node).aml_body, (*crs_node).aml_body_length, device_slot
                ) {
                    return aml_discovery_fail(
                        AML_DISCOVERY_ERROR_RESOURCE, namespace_index,
                        AML_DISCOVERY_RESOURCE_COUNT
                    );
                }
                AML_DISCOVERY_DEVICES[device_slot].crs_static = true;
            } else {
                return aml_discovery_fail(AML_DISCOVERY_ERROR_CRS, namespace_index, 0);
            }
        }
    }

    unsafe { AML_DISCOVERY_DEVICES[device_slot].valid = true; }
    return true;
}

@system
pub fn aml_discovery_init() -> bool {
    aml_discovery_reset();
    if !aml_namespace_is_ready() || !aml_loader_is_ready() ||
       aml_namespace_count() <= 1 {
        return aml_discovery_fail(AML_DISCOVERY_ERROR_NAMESPACE, 0, 0);
    }

    let namespace_count = aml_namespace_count();
    let mut index: usize = 1;
    while index < namespace_count {
        let node = aml_namespace_node(index);
        if node == (null as *const AmlNamespaceNode) {
            return aml_discovery_fail(AML_DISCOVERY_ERROR_NAMESPACE, index, 0);
        }
        unsafe {
            if (*node).kind == AML_NAMESPACE_KIND_DEVICE {
                if AML_DISCOVERY_DEVICE_COUNT >= AML_DISCOVERY_MAX_DEVICES {
                    return aml_discovery_fail(AML_DISCOVERY_ERROR_CAPACITY, index, 0);
                }
                let slot = AML_DISCOVERY_DEVICE_COUNT;
                if !aml_discovery_read_device(index, slot) { return false; }
                AML_DISCOVERY_DEVICE_COUNT += 1;
            }
        }
        index += 1;
    }

    unsafe {
        if AML_DISCOVERY_DEVICE_COUNT == 0 {
            return aml_discovery_fail(AML_DISCOVERY_ERROR_NAMESPACE, 0, 0);
        }
        __dma_fence();
        AML_DISCOVERY_READY = true;
    }
    return true;
}

@system
pub fn aml_discovery_is_ready() -> bool { unsafe { return AML_DISCOVERY_READY; } }

@system
pub fn aml_discovery_device_count() -> usize {
    unsafe { if !AML_DISCOVERY_READY { return 0; } return AML_DISCOVERY_DEVICE_COUNT; }
}

@system
pub fn aml_discovery_device(index: usize) -> *const AmlDiscoveredDevice {
    unsafe {
        if !AML_DISCOVERY_READY || index >= AML_DISCOVERY_DEVICE_COUNT ||
           !AML_DISCOVERY_DEVICES[index].valid {
            return null as *const AmlDiscoveredDevice;
        }
        return &AML_DISCOVERY_DEVICES[index];
    }
}

@system
pub fn aml_discovery_compat_id_count() -> usize {
    unsafe { if !AML_DISCOVERY_READY { return 0; } return AML_DISCOVERY_COMPAT_ID_COUNT; }
}

@system
pub fn aml_discovery_compat_id(index: usize) -> *const AmlDiscoveryId {
    unsafe {
        if !AML_DISCOVERY_READY || index >= AML_DISCOVERY_COMPAT_ID_COUNT ||
           !AML_DISCOVERY_COMPAT_IDS[index].valid {
            return null as *const AmlDiscoveryId;
        }
        return &AML_DISCOVERY_COMPAT_IDS[index];
    }
}

@system
pub fn aml_discovery_resource_count() -> usize {
    unsafe { if !AML_DISCOVERY_READY { return 0; } return AML_DISCOVERY_RESOURCE_COUNT; }
}

@system
pub fn aml_discovery_resource(index: usize) -> *const AmlResourceDescriptor {
    unsafe {
        if !AML_DISCOVERY_READY || index >= AML_DISCOVERY_RESOURCE_COUNT ||
           !AML_DISCOVERY_RESOURCES[index].valid {
            return null as *const AmlResourceDescriptor;
        }
        return &AML_DISCOVERY_RESOURCES[index];
    }
}

@system
pub fn aml_discovery_emit_failure_markers() -> bool {
    unsafe {
        if AML_DISCOVERY_LAST_ERROR == 0 { return false; }
        let first = x86_serial_write_hex32_marker('R' as u8, AML_DISCOVERY_LAST_ERROR);
        let second = x86_serial_write_hex32_marker('S' as u8,
            (AML_DISCOVERY_LAST_OFFSET & 0xFFFFFFFF) as u32);
        return first && second;
    }
}

@system
pub fn aml_discovery_emit_ready_marker() -> bool {
    if !aml_discovery_is_ready() || aml_discovery_device_count() == 0 { return false; }
    let marker: [u8; 29] = [
        66,65,75,69,78,58,65,67,80,73,95,65,77,76,95,68,69,86,73,67,69,83,95,
        82,69,65,68,89,10
    ];
    let mut index: usize = 0;
    while index < 29 {
        if !x86_serial_write_byte(marker[index]) { return false; }
        index += 1;
    }
    return true;
}