// Compositor canonico e gerenciador de sessoes do Baken OS em Sotlas (@system).
// Gerencia a transicao fluida entre o Assistente de Instalacao/OOBE e o Desktop Shell.

module kernel::desktop_compositor;

import kernel::graphics_engine::*;
import kernel::baken_installer::*;
import kernel::install_engine::*;
import kernel::baken_oobe_screen::*;
import kernel::desktop_shell::*;
import kernel::bakenfx::*;
import kernel::sotlas_graphics::*;
import kernel::sotlas_ui::*;

pub const SESSION_INSTALLER: u32 = 0;
pub const SESSION_OOBE: u32 = 1;
pub const SESSION_DESKTOP: u32 = 2;

static mut COMPOSITOR_READY: bool = false;
static mut CURRENT_SESSION: u32 = 0; // Inicia no Assistente de Instalacao / OOBE
static mut COMPOSITOR_W: u32 = 1920;
static mut COMPOSITOR_H: u32 = 1080;

static mut ROOT_SURFACE: Surface = Surface {
    buffer: null as *mut u32,
    width: 0,
    height: 0,
    pitch: 0,
};

static mut ROOT_CANVAS: Canvas = Canvas {
    surface: null as *mut Surface,
    clip: ClipState { rect: Rect { x: 0, y: 0, width: 0, height: 0 }, has_clip: false },
    save_stack: [
        CanvasState { clip: ClipState { rect: Rect { x: 0, y: 0, width: 0, height: 0 }, has_clip: false }, offset_x: 0, offset_y: 0, scale_milli: 1000 },
        CanvasState { clip: ClipState { rect: Rect { x: 0, y: 0, width: 0, height: 0 }, has_clip: false }, offset_x: 0, offset_y: 0, scale_milli: 1000 },
        CanvasState { clip: ClipState { rect: Rect { x: 0, y: 0, width: 0, height: 0 }, has_clip: false }, offset_x: 0, offset_y: 0, scale_milli: 1000 },
        CanvasState { clip: ClipState { rect: Rect { x: 0, y: 0, width: 0, height: 0 }, has_clip: false }, offset_x: 0, offset_y: 0, scale_milli: 1000 },
        CanvasState { clip: ClipState { rect: Rect { x: 0, y: 0, width: 0, height: 0 }, has_clip: false }, offset_x: 0, offset_y: 0, scale_milli: 1000 },
        CanvasState { clip: ClipState { rect: Rect { x: 0, y: 0, width: 0, height: 0 }, has_clip: false }, offset_x: 0, offset_y: 0, scale_milli: 1000 },
        CanvasState { clip: ClipState { rect: Rect { x: 0, y: 0, width: 0, height: 0 }, has_clip: false }, offset_x: 0, offset_y: 0, scale_milli: 1000 },
        CanvasState { clip: ClipState { rect: Rect { x: 0, y: 0, width: 0, height: 0 }, has_clip: false }, offset_x: 0, offset_y: 0, scale_milli: 1000 }
    ],
    save_count: 0,
    offset_x: 0,
    offset_y: 0,
    scale_milli: 1000,
};

static mut ROOT_RENDER_TREE: RenderTree = RenderTree {
    nodes: [RenderNode {
        node_type: 0,
        bounds: Rect { x: 0, y: 0, width: 0, height: 0 },
        material: Material {
            kind: 0,
            tint_color: Color { r: 0, g: 0, b: 0, a: 0 },
            blur_radius: 0,
            border_color: Color { r: 0, g: 0, b: 0, a: 0 },
            border_width: 0,
            shadow_color: Color { r: 0, g: 0, b: 0, a: 0 },
            shadow_blur: 0,
            shadow_offset_y: 0,
            corner_radius: 0,
            is_squircle: false,
        },
        layout: LayoutParams {
            direction: 0,
            spacing: 0,
            padding_left: 0,
            padding_right: 0,
            padding_top: 0,
            padding_bottom: 0,
            cross_align: 0,
            main_align: 0,
        },
        measured_w: 0,
        measured_h: 0,
        text_content: null as *const u8,
        text_scale: 1,
        icon_id: 0,
        parent_idx: -1,
        first_child: -1,
        next_sibling: -1,
        visible: false,
    }; MAX_RENDER_NODES],
    node_count: 0,
    root_idx: -1,
};

@system
pub fn compositor_get_canvas() -> *mut Canvas {
    unsafe { return &mut ROOT_CANVAS; }
}

@system
pub fn compositor_get_render_tree() -> *mut RenderTree {
    unsafe { return &mut ROOT_RENDER_TREE; }
}

@system
pub fn desktop_compositor_set_session(session: u32) -> void {
    unsafe { CURRENT_SESSION = session; }
}

@system
pub fn desktop_compositor_get_session() -> u32 {
    unsafe { return CURRENT_SESSION; }
}

// Propaga o tempo de quadro medido pelo runtime para todas as sessões. Cada
// sessão conserva sua própria fração, evitando animações em câmera lenta.
@system
pub fn desktop_compositor_set_frame_delta(dt: f32) -> void {
    bakenfx_set_frame_delta(dt);
    baken_installer_set_frame_delta(dt);
    baken_oobe_set_frame_delta(dt);
    desktop_shell_set_frame_delta(dt);
}

@system
pub fn desktop_compositor_init(screen_w: u32, screen_h: u32) -> void {
    unsafe {
        if COMPOSITOR_READY { return; }
        COMPOSITOR_W = screen_w;
        COMPOSITOR_H = screen_h;
        ROOT_SURFACE = surface_from_backbuffer();
        Canvas_init(&mut ROOT_CANVAS, &mut ROOT_SURFACE);
        RenderTree_init(&mut ROOT_RENDER_TREE);
        desktop_shell_init(screen_w, screen_h);
        install_engine_reset();
        baken_installer_init();
        baken_oobe_init();
        CURRENT_SESSION = SESSION_INSTALLER;
        COMPOSITOR_READY = true;
    }
}

@system
pub fn desktop_compositor_render_frame() -> void {
    unsafe {
        if !COMPOSITOR_READY { return; }
        bakenfx_invalidate_backdrop();

        if (desktop_shell_wants_installer() == 1) {
            desktop_shell_clear_installer_request();
            baken_installer_set_exit_to_desktop(0);
            install_engine_reset();
            CURRENT_SESSION = SESSION_INSTALLER;
        }

        if (CURRENT_SESSION == SESSION_INSTALLER) {
            if (baken_installer_wants_desktop() == 1) {
                CURRENT_SESSION = SESSION_DESKTOP;
                desktop_shell_render_frame();
            } else {
                // A rota canônica não chama mais baken_installer_tick(), que
                // avançava a instalação por contagem de frames. O motor real
                // só poderá avançar quando storage nativo confirmar trabalho.
                install_engine_tick();
                baken_installer_render(0, 0, COMPOSITOR_W, COMPOSITOR_H);
                render_cursor();
                display_swap_buffers();
            }
        } else if (CURRENT_SESSION == SESSION_OOBE) {
            if (baken_oobe_is_complete() == 1) {
                CURRENT_SESSION = SESSION_DESKTOP;
                desktop_shell_render_frame();
            } else {
                baken_oobe_render(0, 0, COMPOSITOR_W, COMPOSITOR_H);
                render_cursor();
                display_swap_buffers();
            }
        } else {
            desktop_shell_render_frame();
        }
    }
}
