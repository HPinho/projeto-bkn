// Baken OS — provas reais de dispatch, timer periodico e TLB shootdown em AP.
//
// As tres provas historicas permanecem inalteradas. A quarta prova preenche o
// TLB do AP com um frame, remapeia a mesma VA no BSP e exige que o IPI 0x45
// invalide a entrada remota antes de liberar a segunda leitura.

module kernel::scheduler::smp_probe;

import kernel::arch::x86_64::cpu::*;
import kernel::arch::x86_64::serial::*;
import kernel::arch::x86_64::smp::*;
import kernel::interrupts::irq::*;
import kernel::interrupts::lapic::*;
import kernel::interrupts::lapic_timer::*;
import kernel::memory::active_page_tables::*;
import kernel::memory::direct_map::*;
import kernel::memory::pmm_allocator::*;
import kernel::memory::tlb_shootdown::*;
import kernel::scheduler::core::*;

pub const SCHEDULER_SMP_PROBE_CPU_SLOT: usize = 1;
pub const SCHEDULER_SMP_PROBE_SPIN_LIMIT: u64 = 10000000;
pub const SCHEDULER_SMP_PROBE_MODE_THREAD: u32 = 1;
pub const SCHEDULER_SMP_PROBE_MODE_TIMER: u32 = 2;
pub const SCHEDULER_SMP_PROBE_MODE_TLB: u32 = 3;
pub const SCHEDULER_SMP_TLB_ADDRESS: u64 = VMM_RUNTIME_BASE + 4096;
pub const SCHEDULER_SMP_TLB_OLD_VALUE: u32 = 0x13572468;
pub const SCHEDULER_SMP_TLB_NEW_VALUE: u32 = 0x24681357;

static mut SCHEDULER_SMP_PROBE_EXECUTED: u32 = 0;
static mut SCHEDULER_SMP_PROBE_CPU: u32 = 0xFFFFFFFF;
static mut SCHEDULER_SMP_PROBE_MODE: u32 = 0;
static mut SCHEDULER_SMP_TIMER_ENABLED: u32 = 0;
static mut SCHEDULER_SMP_TLB_PRIMED: u32 = 0;
static mut SCHEDULER_SMP_TLB_RELEASE: u32 = 0;
static mut SCHEDULER_SMP_TLB_OBSERVED: u32 = 0;

@system
fn scheduler_smp_probe_executed_address() -> u64 {
    unsafe { let value: *mut u32 = &mut SCHEDULER_SMP_PROBE_EXECUTED; return value as u64; }
}
@system
fn scheduler_smp_probe_cpu_address() -> u64 {
    unsafe { let value: *mut u32 = &mut SCHEDULER_SMP_PROBE_CPU; return value as u64; }
}
@system
fn scheduler_smp_probe_mode_address() -> u64 {
    unsafe { let value: *mut u32 = &mut SCHEDULER_SMP_PROBE_MODE; return value as u64; }
}
@system
fn scheduler_smp_timer_enabled_address() -> u64 {
    unsafe { let value: *mut u32 = &mut SCHEDULER_SMP_TIMER_ENABLED; return value as u64; }
}
@system
fn scheduler_smp_tlb_primed_address() -> u64 {
    unsafe { let value: *mut u32 = &mut SCHEDULER_SMP_TLB_PRIMED; return value as u64; }
}
@system
fn scheduler_smp_tlb_release_address() -> u64 {
    unsafe { let value: *mut u32 = &mut SCHEDULER_SMP_TLB_RELEASE; return value as u64; }
}
@system
fn scheduler_smp_tlb_observed_address() -> u64 {
    unsafe { let value: *mut u32 = &mut SCHEDULER_SMP_TLB_OBSERVED; return value as u64; }
}

@system
@export
pub fn sotlas_x86_scheduler_smp_probe_entry() -> void {
    let cpu_slot = scheduler_current_cpu_slot();
    let thread_id = scheduler_current_thread_id();
    if cpu_slot == 0 || cpu_slot == SCHEDULER_INVALID_CPU_SLOT || thread_id == 0 { return; }
    if scheduler_thread_owner_cpu(thread_id) != cpu_slot as u32 { return; }

    let mode_address = scheduler_smp_probe_mode_address();
    if mode_address == 0 { return; }
    let mode = x86_mmio_read32(mode_address);

    if mode == SCHEDULER_SMP_PROBE_MODE_TIMER {
        let enabled_address = scheduler_smp_timer_enabled_address();
        if enabled_address == 0 || !lapic_timer_unmask_periodic() { return; }
        __dma_fence();
        x86_mmio_write32(enabled_address, 1);
        __dma_fence();
        return;
    }

    if mode == SCHEDULER_SMP_PROBE_MODE_TLB {
        let primed_address = scheduler_smp_tlb_primed_address();
        let release_address = scheduler_smp_tlb_release_address();
        let observed_address = scheduler_smp_tlb_observed_address();
        if primed_address == 0 || release_address == 0 || observed_address == 0 { return; }
        if x86_mmio_read32(SCHEDULER_SMP_TLB_ADDRESS) != SCHEDULER_SMP_TLB_OLD_VALUE { return; }
        __dma_fence();
        x86_mmio_write32(primed_address, 1);
        __dma_fence();
        while x86_mmio_read32(release_address) != 1 { x86_cpu_pause(); }
        if x86_mmio_read32(SCHEDULER_SMP_TLB_ADDRESS) == SCHEDULER_SMP_TLB_NEW_VALUE {
            __dma_fence();
            x86_mmio_write32(observed_address, 1);
            __dma_fence();
        }
        return;
    }

    if mode != SCHEDULER_SMP_PROBE_MODE_THREAD { return; }
    let cpu_address = scheduler_smp_probe_cpu_address();
    let executed_address = scheduler_smp_probe_executed_address();
    if cpu_address == 0 || executed_address == 0 { return; }
    x86_mmio_write32(cpu_address, cpu_slot as u32);
    __dma_fence();
    x86_mmio_write32(executed_address, 1);
    __dma_fence();
    return;
}

@system
fn scheduler_smp_probe_wait_executed(cpu_slot: usize) -> bool {
    let executed_address = scheduler_smp_probe_executed_address();
    let cpu_address = scheduler_smp_probe_cpu_address();
    if executed_address == 0 || cpu_address == 0 { return false; }
    let mut spins: u64 = 0;
    while spins < SCHEDULER_SMP_PROBE_SPIN_LIMIT {
        if x86_mmio_read32(executed_address) == 1 &&
           x86_mmio_read32(cpu_address) == cpu_slot as u32 { return true; }
        x86_cpu_pause();
        spins += 1;
    }
    return false;
}

@system
fn scheduler_smp_probe_wait_terminated(thread_id: u64, cpu_slot: usize) -> bool {
    let mut spins: u64 = 0;
    while spins < SCHEDULER_SMP_PROBE_SPIN_LIMIT {
        __dma_fence();
        if scheduler_thread_is_terminated(thread_id) &&
           scheduler_thread_owner_cpu(thread_id) == cpu_slot as u32 { return true; }
        x86_cpu_pause();
        spins += 1;
    }
    return false;
}

@system
fn scheduler_smp_probe_wait_idle(thread_id: u64, cpu_slot: usize, idle_epoch_before: u64) -> bool {
    let mut spins: u64 = 0;
    while spins < SCHEDULER_SMP_PROBE_SPIN_LIMIT {
        __dma_fence();
        if scheduler_secondary_idle_epoch(cpu_slot) > idle_epoch_before &&
           scheduler_thread_owner_cpu(thread_id) == SCHEDULER_CPU_NONE { return true; }
        x86_cpu_pause();
        spins += 1;
    }
    return false;
}

@system
fn scheduler_smp_probe_wait_timer_enabled() -> bool {
    let enabled_address = scheduler_smp_timer_enabled_address();
    if enabled_address == 0 { return false; }
    let mut spins: u64 = 0;
    while spins < SCHEDULER_SMP_PROBE_SPIN_LIMIT {
        __dma_fence();
        if x86_mmio_read32(enabled_address) == 1 { return true; }
        x86_cpu_pause();
        spins += 1;
    }
    return false;
}

@system
fn scheduler_smp_probe_wait_timer_tick(cpu_slot: usize, before: u64) -> bool {
    let mut spins: u64 = 0;
    while spins < SCHEDULER_SMP_PROBE_SPIN_LIMIT {
        __dma_fence();
        if irq_timer_count_for_cpu(cpu_slot) > before { return true; }
        x86_cpu_pause();
        spins += 1;
    }
    return false;
}

@system
fn scheduler_smp_probe_wait_flag(address: u64) -> bool {
    if address == 0 { return false; }
    let mut spins: u64 = 0;
    while spins < SCHEDULER_SMP_PROBE_SPIN_LIMIT {
        __dma_fence();
        if x86_mmio_read32(address) == 1 { return true; }
        x86_cpu_pause();
        spins += 1;
    }
    return false;
}

@system
fn scheduler_smp_probe_emit_thread_marker() -> bool {
    if !x86_serial_is_ready() { return false; }
    let marker: [u8; 23] = [66,65,75,69,78,58,83,77,80,95,84,72,82,69,65,68,95,79,78,95,65,80,10];
    let mut index: usize = 0;
    while index < 23 { if !x86_serial_write_byte(marker[index]) { return false; } index += 1; }
    return true;
}
@system
fn scheduler_smp_probe_emit_timer_marker() -> bool {
    if !x86_serial_is_ready() { return false; }
    let marker: [u8; 22] = [66,65,75,69,78,58,83,77,80,95,84,73,77,69,82,95,79,78,95,65,80,10];
    let mut index: usize = 0;
    while index < 22 { if !x86_serial_write_byte(marker[index]) { return false; } index += 1; }
    return true;
}
@system
fn scheduler_smp_probe_emit_any_thread_marker() -> bool {
    if !x86_serial_is_ready() { return false; }
    let marker: [u8; 27] = [66,65,75,69,78,58,83,77,80,95,65,78,89,95,84,72,82,69,65,68,95,79,78,95,65,80,10];
    let mut index: usize = 0;
    while index < 27 { if !x86_serial_write_byte(marker[index]) { return false; } index += 1; }
    return true;
}
@system
fn scheduler_smp_probe_emit_tlb_marker() -> bool {
    if !x86_serial_is_ready() { return false; }
    let marker: [u8; 30] = [66,65,75,69,78,58,83,77,80,95,84,76,66,95,83,72,79,79,84,68,79,87,78,95,82,69,65,68,89,10];
    let mut index: usize = 0;
    while index < 30 { if !x86_serial_write_byte(marker[index]) { return false; } index += 1; }
    return true;
}

@system
fn scheduler_smp_probe_run_tlb(apic_id: u8) -> bool {
    if tlb_shootdown_active_ap_count() == 0 { return false; }
    let first = pmm_alloc_page();
    if first == 0 { return false; }
    let second = pmm_alloc_page();
    if second == 0 { pmm_free_pages(first, 1); return false; }
    let first_virtual = direct_map_virtual_address(first);
    let second_virtual = direct_map_virtual_address(second);
    if first_virtual == 0 || second_virtual == 0 {
        pmm_free_pages(second, 1); pmm_free_pages(first, 1); return false;
    }
    x86_mmio_write32(first_virtual, SCHEDULER_SMP_TLB_OLD_VALUE);
    x86_mmio_write32(second_virtual, SCHEDULER_SMP_TLB_NEW_VALUE);
    __dma_fence();
    if !active_runtime_map(SCHEDULER_SMP_TLB_ADDRESS, first, true, false) {
        pmm_free_pages(second, 1); pmm_free_pages(first, 1); return false;
    }
    let primed_address = scheduler_smp_tlb_primed_address();
    let release_address = scheduler_smp_tlb_release_address();
    let observed_address = scheduler_smp_tlb_observed_address();
    x86_mmio_write32(primed_address, 0);
    x86_mmio_write32(release_address, 0);
    x86_mmio_write32(observed_address, 0);
    x86_mmio_write32(scheduler_smp_probe_mode_address(), SCHEDULER_SMP_PROBE_MODE_TLB);
    __dma_fence();
    let idle_epoch_before = scheduler_secondary_idle_epoch(SCHEDULER_SMP_PROBE_CPU_SLOT);
    let entry = x86_scheduler_smp_probe_entry_address();
    let thread_id = scheduler_create_kernel_thread_on_cpu(
        entry,
        SCHEDULER_DEFAULT_THREAD_STACK_PAGES,
        SCHEDULER_SMP_PROBE_CPU_SLOT
    );
    if thread_id == 0 { return false; }
    if !lapic_send_fixed(apic_id, IRQ_VECTOR_RESCHEDULE_IPI as u8) { return false; }
    if !scheduler_smp_probe_wait_flag(primed_address) { return false; }
    if !active_runtime_remap(SCHEDULER_SMP_TLB_ADDRESS, second, true, false) { return false; }
    x86_mmio_write32(release_address, 1);
    __dma_fence();
    if !scheduler_smp_probe_wait_flag(observed_address) { return false; }
    if !scheduler_smp_probe_wait_terminated(thread_id, SCHEDULER_SMP_PROBE_CPU_SLOT) { return false; }
    if !scheduler_smp_probe_wait_idle(thread_id, SCHEDULER_SMP_PROBE_CPU_SLOT, idle_epoch_before) { return false; }
    if !active_runtime_unmap(SCHEDULER_SMP_TLB_ADDRESS) { return false; }
    if !pmm_free_pages(second, 1) || !pmm_free_pages(first, 1) { return false; }
    return scheduler_smp_probe_emit_tlb_marker();
}

@system
pub fn scheduler_smp_probe_run() -> bool {
    if !scheduler_is_active() || !smp_is_ready() { return false; }
    if smp_runtime_ap_count() == 0 { return true; }
    if SCHEDULER_SMP_PROBE_CPU_SLOT >= SCHEDULER_CPU_SLOT_COUNT { return false; }

    let entry = x86_scheduler_smp_probe_entry_address();
    if entry == 0 { return false; }
    let executed_address = scheduler_smp_probe_executed_address();
    let cpu_address = scheduler_smp_probe_cpu_address();
    let mode_address = scheduler_smp_probe_mode_address();
    let timer_enabled_address = scheduler_smp_timer_enabled_address();
    if executed_address == 0 || cpu_address == 0 || mode_address == 0 || timer_enabled_address == 0 { return false; }
    x86_mmio_write32(executed_address, 0);
    x86_mmio_write32(cpu_address, 0xFFFFFFFF);
    x86_mmio_write32(mode_address, SCHEDULER_SMP_PROBE_MODE_THREAD);
    x86_mmio_write32(timer_enabled_address, 0);
    __dma_fence();

    let idle_epoch_before = scheduler_secondary_idle_epoch(SCHEDULER_SMP_PROBE_CPU_SLOT);
    let thread_id = scheduler_create_kernel_thread_on_cpu(
        entry,
        SCHEDULER_DEFAULT_THREAD_STACK_PAGES,
        SCHEDULER_SMP_PROBE_CPU_SLOT
    );
    if thread_id == 0 { return false; }

    if !smp_release_aps_for_scheduler() { return false; }
    if smp_scheduler_active_ap_count() != smp_runtime_ap_count() { return false; }

    let apic_id = smp_cpu_apic_id(SCHEDULER_SMP_PROBE_CPU_SLOT);
    if !lapic_send_fixed(apic_id, IRQ_VECTOR_RESCHEDULE_IPI as u8) { return false; }
    if !scheduler_smp_probe_wait_executed(SCHEDULER_SMP_PROBE_CPU_SLOT) { return false; }
    if !scheduler_smp_probe_wait_terminated(thread_id, SCHEDULER_SMP_PROBE_CPU_SLOT) { return false; }
    if !lapic_send_fixed(apic_id, IRQ_VECTOR_RESCHEDULE_IPI as u8) { return false; }
    if !scheduler_smp_probe_wait_idle(thread_id, SCHEDULER_SMP_PROBE_CPU_SLOT, idle_epoch_before) { return false; }
    if !scheduler_smp_probe_emit_thread_marker() { return false; }

    x86_mmio_write32(mode_address, SCHEDULER_SMP_PROBE_MODE_TIMER);
    x86_mmio_write32(timer_enabled_address, 0);
    __dma_fence();
    let timer_count_before = irq_timer_count_for_cpu(SCHEDULER_SMP_PROBE_CPU_SLOT);
    let timer_idle_epoch_before = scheduler_secondary_idle_epoch(SCHEDULER_SMP_PROBE_CPU_SLOT);
    let timer_thread_id = scheduler_create_kernel_thread_on_cpu(
        entry,
        SCHEDULER_DEFAULT_THREAD_STACK_PAGES,
        SCHEDULER_SMP_PROBE_CPU_SLOT
    );
    if timer_thread_id == 0 { return false; }
    if !lapic_send_fixed(apic_id, IRQ_VECTOR_RESCHEDULE_IPI as u8) { return false; }
    if !scheduler_smp_probe_wait_timer_enabled() { return false; }
    if !scheduler_smp_probe_wait_timer_tick(SCHEDULER_SMP_PROBE_CPU_SLOT, timer_count_before) { return false; }
    if !scheduler_smp_probe_wait_idle(timer_thread_id, SCHEDULER_SMP_PROBE_CPU_SLOT, timer_idle_epoch_before) { return false; }
    if !scheduler_smp_probe_emit_timer_marker() { return false; }

    x86_mmio_write32(executed_address, 0);
    x86_mmio_write32(cpu_address, 0xFFFFFFFF);
    x86_mmio_write32(mode_address, SCHEDULER_SMP_PROBE_MODE_THREAD);
    __dma_fence();
    let any_idle_epoch_before = scheduler_secondary_idle_epoch(SCHEDULER_SMP_PROBE_CPU_SLOT);
    let bsp_irq_flags = x86_irq_save_disable();
    let any_thread_id = scheduler_create_kernel_thread(
        entry,
        SCHEDULER_DEFAULT_THREAD_STACK_PAGES
    );
    if any_thread_id == 0 { x86_irq_restore(bsp_irq_flags); return false; }
    let any_executed = scheduler_smp_probe_wait_executed(SCHEDULER_SMP_PROBE_CPU_SLOT);
    let mut any_terminated = false;
    let mut any_idle = false;
    if any_executed { any_terminated = scheduler_smp_probe_wait_terminated(any_thread_id, SCHEDULER_SMP_PROBE_CPU_SLOT); }
    if any_terminated {
        any_idle = scheduler_smp_probe_wait_idle(any_thread_id, SCHEDULER_SMP_PROBE_CPU_SLOT, any_idle_epoch_before);
    }
    x86_irq_restore(bsp_irq_flags);
    if !any_executed || !any_terminated || !any_idle { return false; }
    if !scheduler_smp_probe_emit_any_thread_marker() { return false; }

    return scheduler_smp_probe_run_tlb(apic_id);
}
