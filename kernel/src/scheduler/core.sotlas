// Baken OS — scheduler preemptivo CPL0.
//
// O frame real salvo pelo IRQ de timer é a unidade de contexto. A run queue
// mantém bootstrap, idle e threads de kernel criadas dinamicamente; o common
// stub restaura diretamente o frame escolhido e retorna por IRETQ.

module kernel::scheduler::core;

import kernel::scheduler::thread::*;
import kernel::scheduler::stack_cache::*;
import kernel::arch::x86_64::thread_context::*;
import kernel::arch::x86_64::cpu::*;
import kernel::arch::x86_64::serial::*;
import kernel::memory::pmm_allocator::*;
import kernel::memory::direct_map::*;
import kernel::process::registry::*;
import kernel::arch::x86_64::paging::*;

pub const SCHEDULER_BOOT_THREAD_ID: u64 = 0;
pub const SCHEDULER_IDLE_THREAD_ID: u64 = 1;
pub const SCHEDULER_FIRST_DYNAMIC_THREAD_ID: u64 = 2;
pub const SCHEDULER_THREAD_SLOT_COUNT: usize = 8;
pub const SCHEDULER_BOOT_SLOT: usize = 0;
pub const SCHEDULER_IDLE_SLOT: usize = 1;
pub const SCHEDULER_FIRST_DYNAMIC_SLOT: usize = 2;
pub const SCHEDULER_INVALID_SLOT: usize = SCHEDULER_THREAD_SLOT_COUNT;
pub const SCHEDULER_IDLE_STACK_PAGES: u64 = 4;
pub const SCHEDULER_DEFAULT_THREAD_STACK_PAGES: u64 = 4;
pub const SCHEDULER_ROUND_TRIP_SPIN_LIMIT: u64 = 10000000;

static mut SCHEDULER_ACTIVE: bool = false;
static mut SCHEDULER_KERNEL_ROOT: u64 = 0;
static mut SCHEDULER_PROCESS_PROBE_PID: u64 = 0;
static mut SCHEDULER_PROCESS_PROBE_EXECUTED: bool = false;
static mut SCHEDULER_CURRENT_SLOT: usize = SCHEDULER_BOOT_SLOT;
static mut SCHEDULER_NEXT_THREAD_ID: u64 = SCHEDULER_FIRST_DYNAMIC_THREAD_ID;
static mut SCHEDULER_SWITCH_COUNT: u64 = 0;
static mut SCHEDULER_REAP_COUNT: u64 = 0;
static mut SCHEDULER_FIRST_SWITCH_MARKED: bool = false;
static mut SCHEDULER_RUN_QUEUE_SWITCH_MARKED: bool = false;
static mut SCHEDULER_THREAD_EXIT_MARKED: bool = false;
static mut SCHEDULER_THREAD_REAP_MARKED: bool = false;
static mut SCHEDULER_STACK_RELEASE_MARKED: bool = false;
static mut SCHEDULER_BOOTSTRAP_PROBE_COMPLETE: bool = false;
static mut SCHEDULER_RUN_QUEUE_PROBE_COMPLETE: bool = false;
static mut SCHEDULER_RUN_QUEUE_PROBE_SELECTED: bool = false;
static mut SCHEDULER_RUN_QUEUE_PROBE_REAPED: bool = false;
static mut SCHEDULER_RUN_QUEUE_PROBE_THREAD_ID: u64 = 0;

static mut SCHEDULER_THREADS: [KernelThread; SCHEDULER_THREAD_SLOT_COUNT] = [
    KernelThread {
        id: 0,
        process_id: 0,
        address_space_root: 0,
        state: KERNEL_THREAD_UNUSED,
        reserved: 0,
        saved_frame: 0,
        stack_physical_base: 0,
        stack_virtual_top: 0,
        stack_pages: 0,
        switch_count: 0
    };
    SCHEDULER_THREAD_SLOT_COUNT
];

@system
fn scheduler_write_switch_marker_once() -> void {
    unsafe {
        if SCHEDULER_FIRST_SWITCH_MARKED { return; }
        SCHEDULER_FIRST_SWITCH_MARKED = true;
    }
    if !x86_serial_is_ready() { return; }
    let marker: [u8; 23] = [
        66, 65, 75, 69, 78, 58, 83, 67, 72, 69, 68, 85,
        76, 69, 82, 95, 83, 87, 73, 84, 67, 72, 10
    ];
    let mut index: usize = 0;
    while index < 23 {
        if !x86_serial_write_byte(marker[index]) { return; }
        index += 1;
    }
}

@system
fn scheduler_write_run_queue_marker_once() -> void {
    unsafe {
        if SCHEDULER_RUN_QUEUE_SWITCH_MARKED { return; }
        SCHEDULER_RUN_QUEUE_SWITCH_MARKED = true;
    }
    if !x86_serial_is_ready() { return; }
    let marker: [u8; 23] = [
        66, 65, 75, 69, 78, 58, 82, 85, 78, 95, 81, 85,
        69, 85, 69, 95, 83, 87, 73, 84, 67, 72, 10
    ];
    let mut index: usize = 0;
    while index < 23 {
        if !x86_serial_write_byte(marker[index]) { return; }
        index += 1;
    }
}

@system
fn scheduler_write_thread_exit_marker_once() -> void {
    unsafe {
        if SCHEDULER_THREAD_EXIT_MARKED { return; }
        SCHEDULER_THREAD_EXIT_MARKED = true;
    }
    if !x86_serial_is_ready() { return; }
    let marker: [u8; 18] = [
        66, 65, 75, 69, 78, 58, 84, 72, 82,
        69, 65, 68, 95, 69, 88, 73, 84, 10
    ];
    let mut index: usize = 0;
    while index < 18 {
        if !x86_serial_write_byte(marker[index]) { return; }
        index += 1;
    }
}

@system
fn scheduler_write_thread_reap_marker_once() -> void {
    unsafe {
        if SCHEDULER_THREAD_REAP_MARKED { return; }
        SCHEDULER_THREAD_REAP_MARKED = true;
    }
    if !x86_serial_is_ready() { return; }
    let marker: [u8; 18] = [
        66, 65, 75, 69, 78, 58, 84, 72, 82,
        69, 65, 68, 95, 82, 69, 65, 80, 10
    ];
    let mut index: usize = 0;
    while index < 18 {
        if !x86_serial_write_byte(marker[index]) { return; }
        index += 1;
    }
}

@system
fn scheduler_write_stack_release_marker_once() -> void {
    unsafe {
        if SCHEDULER_STACK_RELEASE_MARKED { return; }
        SCHEDULER_STACK_RELEASE_MARKED = true;
    }
    if !x86_serial_is_ready() { return; }
    let marker: [u8; 20] = [
        66, 65, 75, 69, 78, 58, 83, 84, 65, 67,
        75, 95, 82, 69, 76, 69, 65, 83, 69, 10
    ];
    let mut index: usize = 0;
    while index < 20 {
        if !x86_serial_write_byte(marker[index]) { return; }
        index += 1;
    }
}

@system
@export
pub fn sotlas_x86_scheduler_idle_entry() -> ! {
    loop {
        x86_cpu_pause();
    }
}

// Entry mínima usada pela certificação da run queue. O retorno é intencional:
// o trampoline deve convertê-lo em sotlas_x86_scheduler_thread_exit().
@system
@export
pub fn sotlas_x86_scheduler_exit_probe_entry() -> void {
    let flags = x86_irq_save_disable();
    unsafe {
        let slot = SCHEDULER_CURRENT_SLOT;
        if slot < SCHEDULER_THREAD_SLOT_COUNT {
            let pid = SCHEDULER_THREADS[slot].process_id;
            let root = SCHEDULER_THREADS[slot].address_space_root;
            SCHEDULER_PROCESS_PROBE_EXECUTED = pid != 0 &&
                pid == SCHEDULER_PROCESS_PROBE_PID && root != SCHEDULER_KERNEL_ROOT &&
                root == (x86_read_cr3_raw() & X86_PAGE_ADDRESS_MASK);
        }
    }
    x86_irq_restore(flags);
    return;
}

@system
fn scheduler_reset_thread_slots() -> void {
    unsafe {
        let mut slot: usize = 0;
        while slot < SCHEDULER_THREAD_SLOT_COUNT {
            SCHEDULER_THREADS[slot] = kernel_thread_empty(0);
            slot += 1;
        }
        SCHEDULER_THREADS[SCHEDULER_BOOT_SLOT] = kernel_thread_bootstrap(SCHEDULER_BOOT_THREAD_ID);
        SCHEDULER_THREADS[SCHEDULER_IDLE_SLOT] = kernel_thread_empty(SCHEDULER_IDLE_THREAD_ID);
    }
}

@system
fn scheduler_find_free_dynamic_slot() -> usize {
    unsafe {
        let mut slot: usize = SCHEDULER_FIRST_DYNAMIC_SLOT;
        while slot < SCHEDULER_THREAD_SLOT_COUNT {
            // TERMINATED ainda possui stack física e metadados de ownership.
            // O slot só volta a UNUSED depois de um reaper seguro.
            if SCHEDULER_THREADS[slot].state == KERNEL_THREAD_UNUSED {
                return slot;
            }
            slot += 1;
        }
    }
    return SCHEDULER_INVALID_SLOT;
}

@system
fn scheduler_find_thread_slot(thread_id: u64) -> usize {
    unsafe {
        let mut slot: usize = 0;
        while slot < SCHEDULER_THREAD_SLOT_COUNT {
            if SCHEDULER_THREADS[slot].state != KERNEL_THREAD_UNUSED &&
               SCHEDULER_THREADS[slot].id == thread_id {
                return slot;
            }
            slot += 1;
        }
    }
    return SCHEDULER_INVALID_SLOT;
}

@system
fn scheduler_find_next_ready_normal(start_slot: usize) -> usize {
    let mut slot = start_slot;
    if slot >= SCHEDULER_THREAD_SLOT_COUNT { slot = 0; }
    let mut checked: usize = 0;
    unsafe {
        while checked < SCHEDULER_THREAD_SLOT_COUNT {
            if slot != SCHEDULER_IDLE_SLOT &&
               SCHEDULER_THREADS[slot].state == KERNEL_THREAD_READY &&
               SCHEDULER_THREADS[slot].saved_frame != 0 {
                return slot;
            }
            slot += 1;
            if slot >= SCHEDULER_THREAD_SLOT_COUNT { slot = 0; }
            checked += 1;
        }
    }
    return SCHEDULER_INVALID_SLOT;
}

@system
fn scheduler_select_slot(slot: usize, fallback_frame: u64) -> u64 {
    if slot >= SCHEDULER_THREAD_SLOT_COUNT { return fallback_frame; }
    unsafe {
        let resume = SCHEDULER_THREADS[slot].saved_frame;
        if resume == 0 { return fallback_frame; }
        let previous = SCHEDULER_CURRENT_SLOT;
        let mut root = SCHEDULER_THREADS[slot].address_space_root;
        if SCHEDULER_THREADS[slot].process_id == 0 { root = SCHEDULER_KERNEL_ROOT; }
        // Nunca retomar um frame sob uma raiz ausente ou não alinhada.
        if root == 0 || !x86_page_aligned(root) { loop {} }
        if (x86_read_cr3_raw() & X86_PAGE_ADDRESS_MASK) != root {
            x86_write_cr3_raw(root);
        }
        SCHEDULER_THREADS[slot].state = KERNEL_THREAD_RUNNING;
        SCHEDULER_CURRENT_SLOT = slot;
        if slot != previous {
            SCHEDULER_THREADS[slot].switch_count += 1;
            SCHEDULER_SWITCH_COUNT += 1;
            scheduler_write_switch_marker_once();
            if slot >= SCHEDULER_FIRST_DYNAMIC_SLOT {
                scheduler_write_run_queue_marker_once();
                if SCHEDULER_THREADS[slot].id == SCHEDULER_RUN_QUEUE_PROBE_THREAD_ID {
                    SCHEDULER_RUN_QUEUE_PROBE_SELECTED = true;
                }
            }
        }
        return resume;
    }
}

@system
fn scheduler_return_unpublished_stack(base: u64, pages: u64, from_cache: bool) -> void {
    if base == 0 || pages == 0 { return; }
    if from_cache {
        scheduler_stack_cache_put(base, pages);
        return;
    }
    if !pmm_free_pages_lifo(base, pages) {
        scheduler_stack_cache_put(base, pages);
    }
}

// Executado somente dentro do IRQ de timer, com interrupções já mascaradas.
// Nunca toca a stack da thread corrente. Primeiro tenta devolução física LIFO;
// se não for possível, transfere ownership para o cache do scheduler.
@system
fn scheduler_reap_terminated_noncurrent() -> u64 {
    let mut reaped: u64 = 0;
    unsafe {
        let current = SCHEDULER_CURRENT_SLOT;
        let mut slot: usize = SCHEDULER_FIRST_DYNAMIC_SLOT;
        while slot < SCHEDULER_THREAD_SLOT_COUNT {
            if slot != current && SCHEDULER_THREADS[slot].state == KERNEL_THREAD_TERMINATED {
                let thread_id = SCHEDULER_THREADS[slot].id;
                let stack_base = SCHEDULER_THREADS[slot].stack_physical_base;
                let stack_pages = SCHEDULER_THREADS[slot].stack_pages;
                if stack_base != 0 && stack_pages != 0 {
                    let released_to_pmm = pmm_free_pages_lifo(stack_base, stack_pages);
                    if released_to_pmm {
                        scheduler_write_stack_release_marker_once();
                    } else if !scheduler_stack_cache_put(stack_base, stack_pages) {
                        slot += 1;
                        continue;
                    }
                    if thread_id == SCHEDULER_RUN_QUEUE_PROBE_THREAD_ID {
                        SCHEDULER_RUN_QUEUE_PROBE_REAPED = true;
                    }
                    let pid = SCHEDULER_THREADS[slot].process_id;
                    if pid != 0 && !process_release(pid) { loop {} }
                    SCHEDULER_THREADS[slot] = kernel_thread_empty(0);
                    SCHEDULER_REAP_COUNT += 1;
                    reaped += 1;
                }
            }
            slot += 1;
        }
    }
    if reaped != 0 { scheduler_write_thread_reap_marker_once(); }
    return reaped;
}

@system
pub fn scheduler_initialize() -> bool {
    unsafe {
        if SCHEDULER_ACTIVE { return true; }
        SCHEDULER_KERNEL_ROOT = x86_read_cr3_raw() & X86_PAGE_ADDRESS_MASK;
        if SCHEDULER_KERNEL_ROOT == 0 { return false; }
        SCHEDULER_CURRENT_SLOT = SCHEDULER_BOOT_SLOT;
        SCHEDULER_NEXT_THREAD_ID = SCHEDULER_FIRST_DYNAMIC_THREAD_ID;
        SCHEDULER_SWITCH_COUNT = 0;
        SCHEDULER_REAP_COUNT = 0;
        SCHEDULER_FIRST_SWITCH_MARKED = false;
        SCHEDULER_RUN_QUEUE_SWITCH_MARKED = false;
        SCHEDULER_THREAD_EXIT_MARKED = false;
        SCHEDULER_THREAD_REAP_MARKED = false;
        SCHEDULER_STACK_RELEASE_MARKED = false;
        SCHEDULER_BOOTSTRAP_PROBE_COMPLETE = false;
        SCHEDULER_RUN_QUEUE_PROBE_COMPLETE = false;
        SCHEDULER_RUN_QUEUE_PROBE_SELECTED = false;
        SCHEDULER_RUN_QUEUE_PROBE_REAPED = false;
        SCHEDULER_RUN_QUEUE_PROBE_THREAD_ID = 0;
    }
    scheduler_reset_thread_slots();
    scheduler_stack_cache_reset();

    if !pmm_allocator_is_active() { return false; }
    let stack_physical = pmm_alloc_pages(SCHEDULER_IDLE_STACK_PAGES);
    if stack_physical == 0 { return false; }
    let stack_virtual = direct_map_virtual_address(stack_physical);
    if stack_virtual == 0 {
        pmm_free_pages_lifo(stack_physical, SCHEDULER_IDLE_STACK_PAGES);
        return false;
    }
    let stack_bytes = SCHEDULER_IDLE_STACK_PAGES * 4096;
    if stack_bytes / 4096 != SCHEDULER_IDLE_STACK_PAGES {
        pmm_free_pages_lifo(stack_physical, SCHEDULER_IDLE_STACK_PAGES);
        return false;
    }
    let stack_top = stack_virtual + stack_bytes;
    if stack_top <= stack_virtual {
        pmm_free_pages_lifo(stack_physical, SCHEDULER_IDLE_STACK_PAGES);
        return false;
    }

    let idle_entry = x86_scheduler_idle_entry_address();
    if idle_entry == 0 {
        pmm_free_pages_lifo(stack_physical, SCHEDULER_IDLE_STACK_PAGES);
        return false;
    }
    let idle_frame = x86_kernel_thread_prepare_frame(stack_top, idle_entry);
    if idle_frame == 0 {
        pmm_free_pages_lifo(stack_physical, SCHEDULER_IDLE_STACK_PAGES);
        return false;
    }

    unsafe {
        SCHEDULER_THREADS[SCHEDULER_IDLE_SLOT].state = KERNEL_THREAD_READY;
        SCHEDULER_THREADS[SCHEDULER_IDLE_SLOT].saved_frame = idle_frame;
        SCHEDULER_THREADS[SCHEDULER_IDLE_SLOT].stack_physical_base = stack_physical;
        SCHEDULER_THREADS[SCHEDULER_IDLE_SLOT].stack_virtual_top = stack_top;
        SCHEDULER_THREADS[SCHEDULER_IDLE_SLOT].stack_pages = SCHEDULER_IDLE_STACK_PAGES;
        SCHEDULER_ACTIVE = true;
    }
    return true;
}

@system
pub fn scheduler_create_kernel_thread(entry_rip: u64, stack_pages: u64) -> u64 {
    if !scheduler_is_active() || entry_rip == 0 || stack_pages == 0 { return 0; }
    unsafe {
        if SCHEDULER_NEXT_THREAD_ID == 0 || SCHEDULER_NEXT_THREAD_ID == 0xFFFFFFFFFFFFFFFF {
            return 0;
        }
    }
    let slot = scheduler_find_free_dynamic_slot();
    if slot == SCHEDULER_INVALID_SLOT { return 0; }

    let mut stack_physical = scheduler_stack_cache_take(stack_pages);
    let stack_from_cache = stack_physical != 0;
    if stack_physical == 0 {
        stack_physical = pmm_alloc_pages(stack_pages);
    }
    if stack_physical == 0 { return 0; }
    let stack_virtual = direct_map_virtual_address(stack_physical);
    if stack_virtual == 0 {
        scheduler_return_unpublished_stack(stack_physical, stack_pages, stack_from_cache);
        return 0;
    }
    let stack_bytes = stack_pages * 4096;
    if stack_bytes / 4096 != stack_pages {
        scheduler_return_unpublished_stack(stack_physical, stack_pages, stack_from_cache);
        return 0;
    }
    let stack_top = stack_virtual + stack_bytes;
    if stack_top <= stack_virtual {
        scheduler_return_unpublished_stack(stack_physical, stack_pages, stack_from_cache);
        return 0;
    }
    let initial_frame = x86_kernel_thread_prepare_frame(stack_top, entry_rip);
    if initial_frame == 0 {
        scheduler_return_unpublished_stack(stack_physical, stack_pages, stack_from_cache);
        return 0;
    }

    unsafe {
        let thread_id = SCHEDULER_NEXT_THREAD_ID;
        SCHEDULER_NEXT_THREAD_ID += 1;
        SCHEDULER_THREADS[slot] = kernel_thread_empty(thread_id);
        SCHEDULER_THREADS[slot].state = KERNEL_THREAD_READY;
        SCHEDULER_THREADS[slot].saved_frame = initial_frame;
        SCHEDULER_THREADS[slot].stack_physical_base = stack_physical;
        SCHEDULER_THREADS[slot].stack_virtual_top = stack_top;
        SCHEDULER_THREADS[slot].stack_pages = stack_pages;
        return thread_id;
    }
}

@system
pub fn scheduler_create_process_thread(pid: u64, entry_rip: u64, stack_pages: u64) -> u64 {
    // Ainda entrada CPL0: ownership/CR3 não equivalem a uma thread userspace.
    // IRQ-off cobre retenção, publicação READY e vínculo PID/root atomicamente.
    let flags = x86_irq_save_disable();
    if !process_retain(pid) { x86_irq_restore(flags); return 0; }
    let root = process_borrow_root(pid);
    if root == 0 {
        process_release(pid);
        x86_irq_restore(flags);
        return 0;
    }
    let tid = scheduler_create_kernel_thread(entry_rip, stack_pages);
    if tid == 0 {
        process_release(pid);
        x86_irq_restore(flags);
        return 0;
    }
    let slot = scheduler_find_thread_slot(tid);
    if slot == SCHEDULER_INVALID_SLOT { loop {} }
    unsafe {
        SCHEDULER_THREADS[slot].process_id = pid;
        SCHEDULER_THREADS[slot].address_space_root = root;
    }
    x86_irq_restore(flags);
    return tid;
}

@system
pub fn scheduler_block_current() -> bool {
    unsafe {
        if !SCHEDULER_ACTIVE || SCHEDULER_CURRENT_SLOT == SCHEDULER_IDLE_SLOT { return false; }
        SCHEDULER_THREADS[SCHEDULER_CURRENT_SLOT].state = KERNEL_THREAD_BLOCKED;
        return true;
    }
}

@system
pub fn scheduler_wake_thread(thread_id: u64) -> bool {
    let slot = scheduler_find_thread_slot(thread_id);
    if slot == SCHEDULER_INVALID_SLOT || slot == SCHEDULER_IDLE_SLOT { return false; }
    unsafe {
        if SCHEDULER_THREADS[slot].state != KERNEL_THREAD_BLOCKED { return false; }
        SCHEDULER_THREADS[slot].state = KERNEL_THREAD_READY;
    }
    return true;
}

@system
pub fn scheduler_terminate_current() -> bool {
    unsafe {
        if !SCHEDULER_ACTIVE ||
           SCHEDULER_CURRENT_SLOT < SCHEDULER_FIRST_DYNAMIC_SLOT ||
           SCHEDULER_CURRENT_SLOT >= SCHEDULER_THREAD_SLOT_COUNT {
            return false;
        }
        if SCHEDULER_THREADS[SCHEDULER_CURRENT_SLOT].state != KERNEL_THREAD_RUNNING {
            return false;
        }
        SCHEDULER_THREADS[SCHEDULER_CURRENT_SLOT].state = KERNEL_THREAD_TERMINATED;
    }
    scheduler_write_thread_exit_marker_once();
    return true;
}

@system
@export
pub fn sotlas_x86_scheduler_thread_exit() -> ! {
    // Nunca liberamos a stack corrente aqui: ela ainda está ativa até o próximo
    // IRQ escolher outro frame. O reaper posterior será responsável pelo reclaim.
    x86_cli_raw();
    if !scheduler_terminate_current() {
        loop { x86_cpu_pause(); }
    }
    x86_sti_raw();
    loop { x86_cpu_pause(); }
}

@system
pub fn scheduler_is_active() -> bool {
    unsafe { return SCHEDULER_ACTIVE; }
}

@system
pub fn scheduler_current_thread_id() -> u64 {
    unsafe {
        if SCHEDULER_CURRENT_SLOT >= SCHEDULER_THREAD_SLOT_COUNT { return 0; }
        return SCHEDULER_THREADS[SCHEDULER_CURRENT_SLOT].id;
    }
}

@system
pub fn scheduler_switch_count() -> u64 {
    unsafe { return SCHEDULER_SWITCH_COUNT; }
}

@system
pub fn scheduler_reap_count() -> u64 {
    unsafe { return SCHEDULER_REAP_COUNT; }
}

@system
pub fn scheduler_thread_count() -> u64 {
    let mut count: u64 = 0;
    unsafe {
        let mut slot: usize = 0;
        while slot < SCHEDULER_THREAD_SLOT_COUNT {
            if SCHEDULER_THREADS[slot].state != KERNEL_THREAD_UNUSED &&
               SCHEDULER_THREADS[slot].state != KERNEL_THREAD_TERMINATED {
                count += 1;
            }
            slot += 1;
        }
    }
    return count;
}

@system
pub fn scheduler_thread_is_terminated(thread_id: u64) -> bool {
    let slot = scheduler_find_thread_slot(thread_id);
    if slot == SCHEDULER_INVALID_SLOT { return false; }
    unsafe { return SCHEDULER_THREADS[slot].state == KERNEL_THREAD_TERMINATED; }
}

@system
pub fn scheduler_first_switch_observed() -> bool {
    unsafe { return SCHEDULER_FIRST_SWITCH_MARKED; }
}

@system
pub fn scheduler_bootstrap_probe_complete() -> bool {
    unsafe { return SCHEDULER_BOOTSTRAP_PROBE_COMPLETE; }
}

@system
pub fn scheduler_run_queue_probe_complete() -> bool {
    unsafe { return SCHEDULER_RUN_QUEUE_PROBE_COMPLETE; }
}

@system
pub fn scheduler_run_queue_probe_reaped() -> bool {
    unsafe { return SCHEDULER_RUN_QUEUE_PROBE_REAPED; }
}

@system
pub fn scheduler_start_run_queue_probe() -> bool {
    if !scheduler_is_active() || !scheduler_bootstrap_probe_complete() { return false; }
    unsafe {
        if SCHEDULER_RUN_QUEUE_PROBE_THREAD_ID != 0 {
            return SCHEDULER_RUN_QUEUE_PROBE_COMPLETE;
        }
    }
    let entry = x86_scheduler_exit_probe_entry_address();
    if entry == 0 { return false; }
    let pid = process_create();
    if pid == 0 { return false; }
    let thread_id = scheduler_create_process_thread(pid, entry, SCHEDULER_DEFAULT_THREAD_STACK_PAGES);
    if thread_id == 0 { process_destroy(pid); return false; }
    if process_destroy(pid) { return false; }
    unsafe {
        SCHEDULER_PROCESS_PROBE_PID = pid;
        SCHEDULER_RUN_QUEUE_PROBE_THREAD_ID = thread_id;
        SCHEDULER_RUN_QUEUE_PROBE_SELECTED = false;
        SCHEDULER_RUN_QUEUE_PROBE_COMPLETE = false;
        SCHEDULER_RUN_QUEUE_PROBE_REAPED = false;
    }
    return true;
}

// Chamado somente do IRQ de timer com interrupções mascaradas pelo interrupt
// gate. O retorno é o endereço do frame que __sotlas_x86_irq_common restaurará.
@system
pub fn scheduler_on_timer_interrupt(frame_address: u64) -> u64 {
    if frame_address == 0 || !scheduler_is_active() { return frame_address; }

    unsafe {
        let current = SCHEDULER_CURRENT_SLOT;
        if current >= SCHEDULER_THREAD_SLOT_COUNT { return frame_address; }
        SCHEDULER_THREADS[current].saved_frame = frame_address;

        // Uma stack TERMINATED só é reapada quando outra thread já está usando
        // a CPU. Assim nunca liberamos a stack que ainda sustenta este IRQ.
        scheduler_reap_terminated_noncurrent();

        // Bootstrap proof: força exatamente um round-trip bootstrap -> idle ->
        // bootstrap antes de liberar a política normal da run queue.
        if !SCHEDULER_BOOTSTRAP_PROBE_COMPLETE {
            if current == SCHEDULER_BOOT_SLOT {
                SCHEDULER_THREADS[SCHEDULER_BOOT_SLOT].state = KERNEL_THREAD_READY;
                return scheduler_select_slot(SCHEDULER_IDLE_SLOT, frame_address);
            }
            if current == SCHEDULER_IDLE_SLOT {
                SCHEDULER_THREADS[SCHEDULER_IDLE_SLOT].state = KERNEL_THREAD_READY;
                SCHEDULER_BOOTSTRAP_PROBE_COMPLETE = true;
                return scheduler_select_slot(SCHEDULER_BOOT_SLOT, frame_address);
            }
            return frame_address;
        }

        // Threads RUNNING voltam a READY em preempção normal. TERMINATED é
        // preservado até um IRQ posterior em outra thread executar o reaper.
        let current_id = SCHEDULER_THREADS[current].id;
        let current_terminated = SCHEDULER_THREADS[current].state == KERNEL_THREAD_TERMINATED;
        if SCHEDULER_THREADS[current].state == KERNEL_THREAD_RUNNING {
            SCHEDULER_THREADS[current].state = KERNEL_THREAD_READY;
        }

        let mut start = current + 1;
        if start >= SCHEDULER_THREAD_SLOT_COUNT { start = 0; }
        let next = scheduler_find_next_ready_normal(start);
        if next != SCHEDULER_INVALID_SLOT {
            let resume = scheduler_select_slot(next, frame_address);
            if current_id == SCHEDULER_RUN_QUEUE_PROBE_THREAD_ID &&
               SCHEDULER_RUN_QUEUE_PROBE_SELECTED &&
               current_terminated &&
               next == SCHEDULER_BOOT_SLOT {
                SCHEDULER_RUN_QUEUE_PROBE_COMPLETE = true;
            }
            return resume;
        }

        // Idle só entra quando nenhuma thread normal está READY.
        if SCHEDULER_THREADS[SCHEDULER_IDLE_SLOT].saved_frame != 0 {
            if SCHEDULER_THREADS[SCHEDULER_IDLE_SLOT].state != KERNEL_THREAD_RUNNING {
                SCHEDULER_THREADS[SCHEDULER_IDLE_SLOT].state = KERNEL_THREAD_READY;
            }
            return scheduler_select_slot(SCHEDULER_IDLE_SLOT, frame_address);
        }
    }

    return frame_address;
}

@system
pub fn scheduler_wait_first_round_trip() -> bool {
    if !scheduler_is_active() { return false; }
    let mut spins: u64 = 0;
    while spins < SCHEDULER_ROUND_TRIP_SPIN_LIMIT {
        if scheduler_switch_count() >= 2 &&
           scheduler_current_thread_id() == SCHEDULER_BOOT_THREAD_ID &&
           scheduler_bootstrap_probe_complete() {
            return true;
        }
        x86_cpu_pause();
        spins += 1;
    }
    return false;
}

@system
pub fn scheduler_wait_run_queue_probe() -> bool {
    if !scheduler_is_active() { return false; }
    let mut spins: u64 = 0;
    while spins < SCHEDULER_ROUND_TRIP_SPIN_LIMIT {
        unsafe {
            let exited_or_reaped = scheduler_thread_is_terminated(SCHEDULER_RUN_QUEUE_PROBE_THREAD_ID) ||
                SCHEDULER_RUN_QUEUE_PROBE_REAPED;
            if SCHEDULER_RUN_QUEUE_PROBE_COMPLETE &&
               SCHEDULER_RUN_QUEUE_PROBE_THREAD_ID != 0 &&
               exited_or_reaped &&
               scheduler_current_thread_id() == SCHEDULER_BOOT_THREAD_ID {
                return true;
            }
        }
        x86_cpu_pause();
        spins += 1;
    }
    return false;
}

@system
pub fn scheduler_finish_process_probe() -> bool {
    let flags = x86_irq_save_disable();
    let mut passed: bool = false;
    unsafe {
        if SCHEDULER_PROCESS_PROBE_EXECUTED && SCHEDULER_RUN_QUEUE_PROBE_REAPED &&
           SCHEDULER_PROCESS_PROBE_PID != 0 &&
           (x86_read_cr3_raw() & X86_PAGE_ADDRESS_MASK) == SCHEDULER_KERNEL_ROOT {
            passed = process_destroy(SCHEDULER_PROCESS_PROBE_PID);
            if passed { SCHEDULER_PROCESS_PROBE_PID = 0; }
        }
    }
    x86_irq_restore(flags);
    if !passed { return false; }
    let marker: [u8; 30] = [66, 65, 75, 69, 78, 58, 80, 82, 79, 67, 69, 83, 83, 95, 83, 67, 72, 69, 68, 85, 76, 69, 82, 95, 82, 69, 65, 68, 89, 10];
    let mut index: usize = 0;
    while index < 30 {
        if !x86_serial_write_byte(marker[index]) { return false; }
        index += 1;
    }
    return true;
}

@system
pub fn scheduler_wait_reaper_probe() -> bool {
    if !scheduler_is_active() { return false; }
    let mut spins: u64 = 0;
    while spins < SCHEDULER_ROUND_TRIP_SPIN_LIMIT {
        unsafe {
            if SCHEDULER_RUN_QUEUE_PROBE_COMPLETE &&
               SCHEDULER_RUN_QUEUE_PROBE_REAPED &&
               SCHEDULER_REAP_COUNT != 0 &&
               scheduler_current_thread_id() == SCHEDULER_BOOT_THREAD_ID {
                return true;
            }
        }
        x86_cpu_pause();
        spins += 1;
    }
    return false;
}
