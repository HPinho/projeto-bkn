// Baken OS — motor de instalação real, separado da UI.
//
// Regra: progresso só pode refletir trabalho efetivamente concluído por uma
// camada de storage nativa. Enquanto AHCI/NVMe + GPT/FAT32/BakenFS reais não
// existirem, iniciar instalação retorna false e o estado fica UNAVAILABLE.

module kernel::install_engine;

import kernel::storage::block_device::*;
import kernel::storage::gpt::*;
import kernel::storage::fat32::*;

pub const INSTALL_STATE_IDLE: u32 = 0;
pub const INSTALL_STATE_UNAVAILABLE: u32 = 1;
pub const INSTALL_STATE_PREPARING: u32 = 2;
pub const INSTALL_STATE_PARTITIONING: u32 = 3;
pub const INSTALL_STATE_FORMATTING: u32 = 4;
pub const INSTALL_STATE_COPYING: u32 = 5;
pub const INSTALL_STATE_FINALIZING: u32 = 6;
pub const INSTALL_STATE_COMPLETE: u32 = 7;
pub const INSTALL_STATE_FAILED: u32 = 8;

pub const INSTALL_ESP_BYTES: u64 = 536870912;

static mut INSTALL_STATE: u32 = INSTALL_STATE_IDLE;
static mut INSTALL_PROGRESS: u32 = 0;
static mut INSTALL_ERROR: u32 = 0;

@system
pub fn install_engine_reset() -> void {
    unsafe {
        INSTALL_STATE = INSTALL_STATE_IDLE;
        INSTALL_PROGRESS = 0;
        INSTALL_ERROR = 0;
    }
}

@system
pub fn install_engine_available() -> bool {
    if !block_device_has_writable_native_target() { return false; }

    let block_size = block_device_block_size();
    let last_lba = block_device_last_lba();
    let gpt = gpt_plan_default(block_size, last_lba);
    if !gpt.valid { return false; }

    if block_size == 0 { return false; }
    let esp_sectors = INSTALL_ESP_BYTES / (block_size as u64);
    if esp_sectors == 0 { return false; }

    let fat = fat32_plan_layout(block_size, esp_sectors);
    if !fat.valid { return false; }

    // A ESP deve caber dentro da área utilizável planejada, preservando a GPT
    // de backup no fim do dispositivo.
    if gpt.first_usable_lba > gpt.last_usable_lba { return false; }
    let usable_sectors = gpt.last_usable_lba - gpt.first_usable_lba + 1;
    if esp_sectors >= usable_sectors { return false; }

    return true;
}

@system
pub fn install_engine_start() -> bool {
    unsafe {
        INSTALL_PROGRESS = 0;
        INSTALL_ERROR = 0;
        if !install_engine_available() {
            INSTALL_STATE = INSTALL_STATE_UNAVAILABLE;
            return false;
        }

        // O alvo, GPT e ESP FAT32 podem ser válidos, mas isso ainda não
        // equivale a possuir um write path de particionamento/filesystem
        // completo. Até GPT/FAT32/BakenFS efetuarem I/O e verificarem o que foi
        // gravado, não declaramos instalação em andamento nem sucesso.
        INSTALL_STATE = INSTALL_STATE_UNAVAILABLE;
        return false;
    }
}

@system
pub fn install_engine_tick() -> void {
    // Intencionalmente sem incremento temporal/fictício. Drivers e camadas de
    // filesystem reais atualizarão estado/progresso somente após I/O concluído.
    return;
}

@system
pub fn install_engine_state() -> u32 { unsafe { return INSTALL_STATE; } }

@system
pub fn install_engine_progress() -> u32 { unsafe { return INSTALL_PROGRESS; } }

@system
pub fn install_engine_error() -> u32 { unsafe { return INSTALL_ERROR; } }
