// Baken OS - Desktop Shell em Sotlas (@system) — Tema Claro (Light Theme).
// Interface nativa fluida com Glassmorphism Claro, Top Bar com Widgets e Dock Reativo.

module kernel::desktop_shell;

import kernel::graphics_engine::*;
import kernel::baken_animation::*;
import kernel::baken_ui_oop::*;
import kernel::window_manager::*;
import kernel::baken_i18n::*;
import kernel::baken_cursor::*;
import kernel::bakenfx::*;
import kernel::sotlas_graphics::*;

pub struct DesktopShellState {
    pub screen_w: u32;
    pub screen_h: u32;
    pub time_tick: u32;
    pub frame_delta: f32;
    pub cursor_x: i32;
    pub cursor_y: i32;
}

static mut SHELL: DesktopShellState = DesktopShellState {
    screen_w: 1920,
    screen_h: 1080,
    time_tick: 0,
    frame_delta: 0.0166667,
    cursor_x: 960,
    cursor_y: 540
};

static mut REQUEST_INSTALLER: u8 = 0;

@system
pub fn desktop_shell_wants_installer() -> u8 {
    unsafe {
        return REQUEST_INSTALLER;
    }
}

@system
pub fn desktop_shell_clear_installer_request() -> void {
    unsafe {
        REQUEST_INSTALLER = 0;
    }
}

static mut MAIN_DOCK: DesktopDock = DesktopDock {
    y_offset: 20,
    icon_size: 48,
    item_count: 0,
    item_labels: [null as *const u8; 10],
    item_springs: [SpringState {
        current_val: 1.0, target_val: 1.0, velocity: 0.0, stiffness: 150.0, damping: 10.0
    }; 10],
    bounce_springs: [SpringState {
        current_val: 0.0, target_val: 0.0, velocity: 0.0, stiffness: 180.0, damping: 12.0
    }; 10]
};

@system
pub fn desktop_shell_init(w: u32, h: u32) -> void {
    unsafe {
        SHELL.screen_w = w;
        SHELL.screen_h = h;
        SHELL.time_tick = 0;
        SHELL.frame_delta = 0.0166667;
        SHELL.cursor_x = (w / 2) as i32;
        SHELL.cursor_y = (h / 2) as i32;
        REQUEST_INSTALLER = 0;
        MAIN_DOCK.item_count = 0;

        dock_add_item(&mut MAIN_DOCK, "Arquivos");
        dock_add_item(&mut MAIN_DOCK, "Notas");
        dock_add_item(&mut MAIN_DOCK, "Ajustes");
        dock_add_item(&mut MAIN_DOCK, "Terminal");
        dock_add_item(&mut MAIN_DOCK, "Sobre");

        wm_init();
    }
}

@system
pub fn render_top_bar() -> void {
    unsafe {
        let sw = SHELL.screen_w;
        // Top Bar em Vidro Claro Translúcido estilo macOS Liquid Glass
        bakenfx_draw_panel(0, 0, sw, 36, 0x00FFFFFF, 215, 0x00CBD5E1, 0);
        bakenfx_draw_hline(0, 35, sw, 0x00E2E8F0, 200);

        // Logo Swirl Baken OS com Contraste Perfeito
        bakenfx_draw_circle(22, 18, 12, 0x00FFFFFF, 255);
        bakenfx_draw_circle(22, 18, 9, 0x000284C7, 255);
        bakenfx_draw_circle(22, 18, 6, 0x00FFFFFF, 255);
        bakenfx_draw_circle(22, 18, 3, 0x000284C7, 255);

        // Menus da Barra Superior em Tipografia Escura de Alto Contraste
        bakenfx_draw_text(42, 8, "Baken OS", 0x000F172A, 255);
        
        let t_file = i18n_top_file();
        let t_file_w = bakenfx_measure_text(t_file);
        bakenfx_draw_text(130, 8, t_file, 0x00334155, 235);

        let t_edit = i18n_top_edit();
        let t_edit_x = 130 + t_file_w + 24;
        let t_edit_w = bakenfx_measure_text(t_edit);
        bakenfx_draw_text(t_edit_x, 8, t_edit, 0x00334155, 235);

        let t_view = i18n_top_view();
        let t_view_x = t_edit_x + t_edit_w + 24;
        bakenfx_draw_text(t_view_x, 8, t_view, 0x00334155, 235);

        // Widgets à Direita:
        // 1. Botão de Instalação do Baken OS em Azul Vibrante Apple
        let t_inst = i18n_top_install();
        let t_inst_tw = bakenfx_measure_text(t_inst);
        let inst_w: u32 = t_inst_tw + 34;
        let inst_x = sw - inst_w - 220;
        bakenfx_draw_panel(inst_x, 5, inst_w, 26, 0x000284C7, 255, 0x000284C7, 7);
        bakenfx_draw_text(inst_x + 16, 8, t_inst, 0x00FFFFFF, 255);

        // 2. Chip de Status da Sessão em Vidro Claro
        let t_live = i18n_top_live();
        let t_live_tw = bakenfx_measure_text(t_live);
        let chip_w: u32 = t_live_tw + 34;
        let chip_x = sw - chip_w - 90;
        bakenfx_draw_panel(chip_x, 5, chip_w, 26, 0x00FFFFFF, 220, 0x00CBD5E1, 7);
        bakenfx_draw_circle(chip_x + 14, 18, 4, 0x0010B981, 255);
        bakenfx_draw_circle(chip_x + 14, 18, 7, 0x0010B981, 65);
        bakenfx_draw_text(chip_x + 24, 8, t_live, 0x000F172A, 240);

        // 3. Relógio Digital do Sistema em Vidro Claro
        let clock_w: u32 = 72;
        let clock_x = sw - 80;
        bakenfx_draw_panel(clock_x, 5, clock_w, 26, 0x00FFFFFF, 220, 0x00CBD5E1, 7);
        bakenfx_draw_text(clock_x + 14, 8, "10:42", 0x000F172A, 255);
    }
}

// Cursor Moderno em Alta Definição com Sombra e Núcleo de Luz Animado
@system
pub fn render_cursor() -> void {
    unsafe {
        baken_cursor_render(SHELL.cursor_x, SHELL.cursor_y, SHELL.time_tick);
    }
}

@system
pub fn desktop_shell_set_cursor(x: i32, y: i32) -> void {
    unsafe {
        SHELL.cursor_x = x;
        SHELL.cursor_y = y;
        baken_cursor_set_pos(x, y);
        wm_handle_mouse_move(x, y);
    }
}

@system
pub fn desktop_shell_get_cursor_x() -> i32 {
    unsafe { return SHELL.cursor_x; }
}

@system
pub fn desktop_shell_get_cursor_y() -> i32 {
    unsafe { return SHELL.cursor_y; }
}

@system
pub fn desktop_shell_open_app(idx: u32) -> void {
    unsafe {
        let sw = SHELL.screen_w;
        let sh = SHELL.screen_h;
        let win_id = idx + 1;
        if idx < MAIN_DOCK.item_count {
            dock_trigger_bounce(&mut MAIN_DOCK, idx);
        }
        if win_id == 1 {
            wm_create_window(1, i18n_win_title(0), (sw / 2 - 320) as i32, (sh / 2 - 210) as i32, 640, 420, 0x00FFFFFF, 245, 0x00CBD5E1);
        } else if win_id == 2 {
            wm_create_window(2, i18n_win_title(1), (sw / 2 - 300) as i32, (sh / 2 - 200) as i32, 600, 400, 0x00FFFFFF, 245, 0x00CBD5E1);
        } else if win_id == 3 {
            wm_create_window(3, i18n_win_title(2), (sw / 2 - 310) as i32, (sh / 2 - 200) as i32, 620, 400, 0x00FFFFFF, 245, 0x00CBD5E1);
        } else if win_id == 4 {
            wm_create_window(4, i18n_win_title(3), (sw / 2 - 300) as i32, (sh / 2 - 190) as i32, 600, 380, 0x000F172A, 245, 0x00334155);
        } else if win_id == 5 {
            wm_create_window(5, i18n_win_title(4), (sw / 2 - 260) as i32, (sh / 2 - 180) as i32, 520, 360, 0x00FFFFFF, 245, 0x00CBD5E1);
        }
        wm_bring_to_front(win_id);
    }
}

@system
pub fn desktop_shell_handle_click(mx: i32, my: i32) -> void {
    unsafe {
        let sw = SHELL.screen_w;
        let sh = SHELL.screen_h;

        // Clique no botão "Instalar OS" na top bar: aciona abertura do assistente
        if my <= 36 && mx >= (sw - 340) as i32 && mx <= (sw - 180) as i32 {
            REQUEST_INSTALLER = 1;
            return;
        }

        let dock_w = MAIN_DOCK.item_count * 64 + 28;
        let dock_x = if sw > dock_w { (sw - dock_w) / 2 } else { 0 };
        let dock_y = if sh > 86 { sh - 86 } else { 0 };

        if mx >= dock_x as i32 && mx <= (dock_x + dock_w) as i32 &&
           my >= dock_y as i32 && my <= (dock_y + 72) as i32 {
            let item_idx = ((mx - dock_x as i32 - 14) / 64) as u32;
            if item_idx < MAIN_DOCK.item_count {
                desktop_shell_open_app(item_idx);
                return;
            }
        }

        // Se o clique não foi na doca nem na top bar, despacha para o Window Manager
        wm_handle_mouse_down(mx, my);
    }
}

@system
pub fn desktop_shell_set_frame_delta(dt: f32) -> void {
    unsafe {
        SHELL.frame_delta = if dt < 0.001 { 0.001 } else if dt > 0.05 { 0.05 } else { dt };
    }
}

@system
pub fn desktop_shell_update(dt: f32) -> void {
    unsafe {
        dock_update(&mut MAIN_DOCK, dt, SHELL.cursor_x, SHELL.cursor_y);
    }
}

@system
pub fn desktop_shell_render_frame() -> void {
    unsafe {
        SHELL.time_tick = (SHELL.time_tick + 1) % 3600;
        desktop_shell_update(SHELL.frame_delta);

        // 1. Fundo BakenFX Luminoso Tema Claro
        bakenfx_draw_desktop_background(sotlas_get_default_canvas(), SHELL.screen_w, SHELL.screen_h);
        bakenfx_capture_backdrop();

        // 2. Barra Superior com Widgets
        render_top_bar();

        // 3. Janelas do sistema pelo Window Manager
        wm_render_windows();

        // 4. Doca flutuante reativa
        dock_draw(&MAIN_DOCK);

        // 5. Cursor
        render_cursor();

        // 6. Swap Buffers
        display_swap_buffers();
    }
}
