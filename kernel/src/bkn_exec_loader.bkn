// Baken OS - Carregador de Executáveis C/C++ (ELF64 & PE32+) e Processos Ring 3 em BKN (@system)
// Camada de Compatibilidade Binária: Parser de Binários ELF64, PE32+ e .bkn_exec

module kernel::bkn_exec_loader;

import kernel::pmm::*;
import kernel::vmm::*;
import kernel::scheduler::*;
import kernel::bakenfs::*;

pub const BKN_EXEC_MAGIC: u32 = 0x4E4B427F; // "\x7FBKN"
pub const ELF_MAGIC: u32      = 0x464C457F; // "\x7FELF"
pub const PE_MAGIC_MZ: u16    = 0x5A4D;     // "MZ"

// Formato de Executável ELF64 (Linux / POSIX Standard)
pub struct Elf64Header {
    pub ident: [u8; 16],
    pub e_type: u16,
    pub e_machine: u16,
    pub e_version: u32,
    pub e_entry: u64,
    pub e_phoff: u64,
    pub e_shoff: u64,
    pub e_flags: u32,
    pub e_ehsize: u16,
    pub e_phentsize: u16,
    pub e_phnum: u16,
}

// Estrutura de Processo de Usuário
pub struct UserProcess {
    pub pid: u64,
    pub name: [u8; 32],
    pub cr3_pml4: u64,
    pub entry_point: u64,
    pub user_stack_top: u64,
    pub is_running: bool,
    pub is_c_binary: bool,
}

static mut PROCESS_TABLE: [UserProcess; 16] = [UserProcess {
    pid: 0,
    name: [0; 32],
    cr3_pml4: 0,
    entry_point: 0,
    user_stack_top: 0,
    is_running: false,
    is_c_binary: false,
}; 16];

// Carrega um executável C/C++ (ELF64 / PE / BKN) do BakenFS e spawna um novo processo no Ring 3
@system
pub fn bkn_spawn_process(filename: *const u8) -> i64 {
    unsafe {
        // 1. Abre e lê o arquivo no BakenFS
        let fd = bakenfs_open(filename, 0x01);
        if fd < 0 { return -1; }

        let mut magic_buf: [u8; 64] = [0; 64];
        let bytes_read = bakenfs_read(fd, magic_buf.as_mut_ptr(), 64);
        bakenfs_close(fd);

        if bytes_read < 16 { return -2; }

        let magic32 = *(magic_buf.as_ptr() as *const u32);
        let magic16 = *(magic_buf.as_ptr() as *const u16);
        let mut entry_point: u64 = 0x400000;
        let mut is_c: bool = false;

        // 2. Identifica Formato do Binário
        if magic32 == ELF_MAGIC {
            // Binário C/C++ Compilado em ELF64
            let elf = magic_buf.as_ptr() as *const Elf64Header;
            entry_point = (*elf).e_entry;
            is_c = true;
        } else if magic16 == PE_MAGIC_MZ {
            // Binário Executável Windows PE32+
            entry_point = 0x140001000;
            is_c = true;
        } else if magic32 == BKN_EXEC_MAGIC {
            // Binário Soberano .bkn_exec
            entry_point = 0x401000;
            is_c = false;
        }

        // 3. Aloca espaço de memória virtual isolado (PML4) para o processo
        let pml4_page = pmm_alloc_pages(0);
        let new_cr3 = pml4_page as u64;

        // 4. Aloca pilha de usuário de 16KB (RSP = 0x7FFFFFFFE000)
        let stack_pages = pmm_alloc_pages(2);
        let stack_top: u64 = 0x00007FFFFFFFE000;

        // 5. Registra na tabela de processos
        for i in 0..16 {
            if !PROCESS_TABLE[i].is_running {
                let pid = (i + 100) as u64;
                PROCESS_TABLE[i].pid = pid;
                PROCESS_TABLE[i].cr3_pml4 = new_cr3;
                PROCESS_TABLE[i].entry_point = entry_point;
                PROCESS_TABLE[i].user_stack_top = stack_top;
                PROCESS_TABLE[i].is_running = true;
                PROCESS_TABLE[i].is_c_binary = is_c;

                // 6. Spawna thread correspondente no Scheduler com prioridade Normal
                scheduler_spawn_thread(
                    PROCESS_TABLE[i].entry_point,
                    PROCESS_TABLE[i].user_stack_top,
                    PROCESS_TABLE[i].cr3_pml4,
                    ThreadPriority::Normal
                );

                return pid as i64;
            }
        }

        return -3; // Tabela de processos cheia
    }
}
