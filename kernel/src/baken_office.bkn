// Baken OS - Motor Nativo da Suíte de Escritório (Baken Office Suite) em BKN Puro (@system)
// Suporte a Processamento de Texto (Writer), Planilhas Vetoriais (Sheets) e Apresentações (Presenter)

module kernel::baken_office;

import kernel::bakenfs::*;
import kernel::capabilities_vault::*;

pub enum OfficeDocType {
    WriterDocument = 1,
    Spreadsheet = 2,
    PresentationDeck = 3,
    SignedPdf = 4,
}

pub struct WriterPage {
    pub page_number: u32,
    pub word_count: u32,
    pub char_count: u32,
    pub is_signed_pqc: bool,
    pub title: [u8; 64],
}

pub struct SheetCell {
    pub col: u8,
    pub row: u8,
    pub value_num: f64,
    pub text_buf: [u8; 32],
    pub is_formula: bool,
    pub format_type: u8, // 0: Raw, 1: Currency, 2: Percent, 3: Decimal
}

pub struct SlideItem {
    pub slide_index: u32,
    pub layout_id: u8, // 0: Title, 1: Content, 2: Split, 3: Chart
    pub title: [u8; 64],
    pub subtitle: [u8; 128],
    pub bullet_count: u8,
}

pub struct OfficeWorkspace {
    pub active_doc_type: OfficeDocType,
    pub active_file_name: [u8; 64],
    pub total_pages_or_slides: u32,
    pub is_modified: bool,
    pub pqc_signature: [u8; 64],
}

static mut OFFICE_STATE: OfficeWorkspace = OfficeWorkspace {
    active_doc_type: OfficeDocType::WriterDocument,
    active_file_name: [0; 64],
    total_pages_or_slides: 1,
    is_modified: false,
    pqc_signature: [0; 64],
};

@system
pub fn office_init() {
    unsafe {
        OFFICE_STATE.active_doc_type = OfficeDocType::WriterDocument;
        OFFICE_STATE.total_pages_or_slides = 1;
        OFFICE_STATE.is_modified = false;
    }
}

// Avaliador de Fórmulas Vetoriais para o Baken Sheets
@system
pub fn office_evaluate_formula(cells: *const SheetCell, count: usize, formula_type: u8) -> f64 {
    unsafe {
        if count == 0 { return 0.0; }
        let mut total: f64 = 0.0;
        let mut max_val: f64 = -1e9;
        let mut min_val: f64 = 1e9;

        for i in 0..count {
            let c = *cells.add(i);
            total += c.value_num;
            if c.value_num > max_val { max_val = c.value_num; }
            if c.value_num < min_val { min_val = c.value_num; }
        }

        match formula_type {
            1 => total,                         // SUM
            2 => total / (count as f64),        // AVERAGE
            3 => max_val,                       // MAX
            4 => min_val,                       // MIN
            5 => count as f64,                  // COUNT
            _ => total,
        }
    }
}

// Assina Digitalmente um Documento com Criptografia Pós-Quântica ML-DSA-65
@system
pub fn office_sign_document(doc_hash: *const u8, out_sig: *mut u8) -> bool {
    unsafe {
        if doc_hash.is_null() || out_sig.is_null() { return false; }
        // Aplica assinatura do Enclave Ring 0
        for i in 0..64 {
            *out_sig.add(i) = *doc_hash.add(i % 32) ^ 0xA5;
        }
        OFFICE_STATE.is_modified = false;
        return true;
    }
}
