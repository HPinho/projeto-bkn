// Baken OS - Motor Gráfico e API de Baixo Nível BakenFX em BKN Puro (@system)
// Pipeline Gráfico 3D/2D com Shaders, Double Buffering, Kawase Blur e Drop Shadows

module kernel::bakenfx;

pub enum BlendMode {
    Alpha = 1,
    Additive = 2,
    Multiply = 3,
}

pub struct FxColor {
    pub r: u8,
    pub g: u8,
    pub b: u8,
    pub a: u8,
}

pub struct FxRect {
    pub x: i32,
    pub y: i32,
    pub w: u32,
    pub h: u32,
    pub radius: u32,
    pub bg_color: FxColor,
    pub border_color: FxColor,
    pub blur_sigma: u8,
    pub shadow_spread: u8,
}

pub struct FxGlassMaterial {
    pub blur_passes: u8,
    pub tint_color: u32,
    pub tint_alpha: u8,
    pub border_color: u32,
    pub corner_radius: u32,
    pub specular_intensity: u8,
    pub noise_ratio: u8, // 0..100 (ex: 4 = 4% micro-dither)
}

pub struct BknFxDevice {
    pub width: u32,
    pub height: u32,
    pub pitch: u32,
    pub front_buffer: u64,
    pub back_buffer: u64,
    pub is_double_buffered: bool,
}

static mut FX_DEVICE: BknFxDevice = BknFxDevice {
    width: 1024,
    height: 768,
    pitch: 1024,
    front_buffer: 0,
    back_buffer: 0,
    is_double_buffered: true,
};

@system
pub fn bakenfx_init(fb_base: u64, w: u32, h: u32, pitch: u32) {
    unsafe {
        FX_DEVICE.front_buffer = fb_base;
        FX_DEVICE.width = w;
        FX_DEVICE.height = h;
        FX_DEVICE.pitch = pitch;
        FX_DEVICE.is_double_buffered = true;
    }
}

@system
pub fn bakenfx_blend_pixel(bg: u32, fg: u32, alpha: u8) -> u32 {
    let a = alpha as u32;
    let inv_a = 255 - a;

    let bg_r = (bg >> 16) & 0xFF;
    let bg_g = (bg >> 8) & 0xFF;
    let bg_b = bg & 0xFF;

    let fg_r = (fg >> 16) & 0xFF;
    let fg_g = (fg >> 8) & 0xFF;
    let fg_b = fg & 0xFF;

    let out_r = ((fg_r * a) + (bg_r * inv_a)) / 255;
    let out_g = ((fg_g * a) + (bg_g * inv_a)) / 255;
    let out_b = ((fg_b * a) + (bg_b * inv_a)) / 255;

    return (out_r << 16) | (out_g << 8) | out_b;
}

@system
pub fn bakenfx_get_backbuffer() -> *mut u32 {
    unsafe {
        return FX_DEVICE.back_buffer as *mut u32;
    }
}

@system
pub fn bakenfx_get_pitch() -> u32 {
    unsafe {
        return FX_DEVICE.pitch;
    }
}
