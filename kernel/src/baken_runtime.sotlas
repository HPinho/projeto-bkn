// Baken OS - Runtime do Kernel e Despacho de Eventos 100% em Sotlas (@system)
// Implementacao completa e exclusiva em linguagem Sotlas de baixo nivel com vtables EFI.
// Orquestra a integracao de hardware, o controle de quadros a 60 FPS,
// a propagacao do mouse Logitech MX Anywhere 3, as janelas e o chaveamento de sessao.

module kernel::baken_runtime;

import kernel::graphics_engine::*;
import kernel::baken_rasterizer::*;
import kernel::desktop_compositor::*;
import kernel::desktop_shell::*;
import kernel::baken_installer::*;
import kernel::baken_oobe_screen::*;
import kernel::window_manager::*;

// =============================================================================
// ESTRUTURAS UEFI COM VTABLES NATIVAS EM SOTLAS
// =============================================================================

pub struct EfiGuid {
    pub Data1: u32;
    pub Data2: u16;
    pub Data3: u16;
    pub Data4: [u8; 8];
}

pub struct EfiInputKey {
    pub ScanCode: u16;
    pub UnicodeChar: u16;
}

pub struct EfiSimpleTextInput {
    pub Reset: fn(*mut EfiSimpleTextInput, u8) -> u64;
    pub ReadKeyStroke: fn(*mut EfiSimpleTextInput, *mut EfiInputKey) -> u64;
    pub WaitForKey: *mut void;
}

pub struct EfiSimplePointerState {
    pub RelativeMovementX: i32;
    pub RelativeMovementY: i32;
    pub RelativeMovementZ: i32;
    pub LeftButton: u8;
    pub RightButton: u8;
}

pub struct EfiSimplePointerMode {
    pub ResolutionX: u64;
    pub ResolutionY: u64;
    pub ResolutionZ: u64;
    pub LeftButton: u8;
    pub RightButton: u8;
}

pub struct EfiSimplePointer {
    pub Reset: fn(*mut EfiSimplePointer, u8) -> u64;
    pub GetState: fn(*mut EfiSimplePointer, *mut EfiSimplePointerState) -> u64;
    pub WaitForInput: *mut void;
    pub Mode: *mut EfiSimplePointerMode;
}

pub struct EfiAbsolutePointerState {
    pub CurrentX: u64;
    pub CurrentY: u64;
    pub CurrentZ: u64;
    pub ActiveButtons: u32;
}

pub struct EfiAbsolutePointerMode {
    pub AbsoluteMinX: u64;
    pub AbsoluteMinY: u64;
    pub AbsoluteMinZ: u64;
    pub AbsoluteMaxX: u64;
    pub AbsoluteMaxY: u64;
    pub AbsoluteMaxZ: u64;
    pub Attributes: u32;
}

pub struct EfiAbsolutePointer {
    pub Reset: fn(*mut EfiAbsolutePointer, u8) -> u64;
    pub GetState: fn(*mut EfiAbsolutePointer, *mut EfiAbsolutePointerState) -> u64;
    pub WaitForInput: *mut void;
    pub Mode: *mut EfiAbsolutePointerMode;
}

pub struct EfiTableHeader {
    pub Signature: u64;
    pub Revision: u32;
    pub HeaderSize: u32;
    pub CRC32: u32;
    pub Reserved: u32;
}

pub struct EfiBootServicesPrefix {
    pub Hdr: EfiTableHeader;
    pub RaiseTPL: *mut void;
    pub RestoreTPL: *mut void;
    pub AllocatePages: *mut void;
    pub FreePages: *mut void;
    pub GetMemoryMap: *mut void;
    pub AllocatePool: *mut void;
    pub FreePool: fn(*mut void) -> u64;
    pub CreateEvent: *mut void;
    pub SetTimer: *mut void;
    pub WaitForEvent: *mut void;
    pub SignalEvent: *mut void;
    pub CloseEvent: *mut void;
    pub CheckEvent: *mut void;
    pub InstallProtocolInterface: *mut void;
    pub ReinstallProtocolInterface: *mut void;
    pub UninstallProtocolInterface: *mut void;
    pub HandleProtocol: fn(*mut void, *const EfiGuid, *mut *mut void) -> u64;
    pub Reserved: *mut void;
    pub RegisterProtocolNotify: *mut void;
    pub LocateHandle: *mut void;
    pub LocateDevicePath: *mut void;
    pub InstallConfigurationTable: *mut void;
    pub LoadImage: *mut void;
    pub StartImage: *mut void;
    pub Exit: *mut void;
    pub UnloadImage: *mut void;
    pub ExitBootServices: *mut void;
    pub GetNextMonotonicCount: *mut void;
    pub Stall: fn(u64) -> u64;
    pub SetWatchdogTimer: *mut void;
    pub ConnectController: fn(*mut void, *mut void, *mut void, u8) -> u64;
    pub DisconnectController: *mut void;
    pub OpenProtocol: *mut void;
    pub CloseProtocol: *mut void;
    pub OpenProtocolInformation: *mut void;
    pub ProtocolsPerHandle: *mut void;
    pub LocateHandleBuffer: fn(u32, *const EfiGuid, *mut void, *mut u64, *mut *mut *mut void) -> u64;
    pub LocateProtocol: fn(*const EfiGuid, *mut void, *mut *mut void) -> u64;
}

pub struct EfiSystemTable {
    pub Hdr: EfiTableHeader;
    pub FirmwareVendor: *mut u16;
    pub FirmwareRevision: u32;
    pub ConsoleInHandle: *mut void;
    pub ConIn: *mut EfiSimpleTextInput;
    pub ConsoleOutHandle: *mut void;
    pub ConOut: *mut void;
    pub StandardErrorHandle: *mut void;
    pub StdErr: *mut void;
    pub RuntimeServices: *mut void;
    pub BootServices: *mut EfiBootServicesPrefix;
}

pub struct BakenBootContext {
    pub framebuffer_base: *mut u32;
    pub framebuffer_size: usize;
    pub screen_width: u32;
    pub screen_height: u32;
    pub pixels_per_scanline: u32;
    pub memory_map_base: *const u8;
    pub memory_map_size: usize;
    pub system_table: *mut u8;
    pub pointer_protocol: *mut u8;
    pub block_io_protocol: *mut u8;
    pub install_target_block_io_protocol: *mut u8;
}

// =============================================================================
// ESTADO GLOBAL DO RUNTIME
// =============================================================================

static mut G_SYSTEM_TABLE: *mut EfiSystemTable = null as *mut EfiSystemTable;
static mut G_BOOT_SERVICES: *mut EfiBootServicesPrefix = null as *mut EfiBootServicesPrefix;
static mut G_KEYBOARD: *mut EfiSimpleTextInput = null as *mut EfiSimpleTextInput;
static mut G_SIMPLE_POINTERS: [*mut EfiSimplePointer; 8] = [null as *mut EfiSimplePointer; 8];
static mut G_SIMPLE_COUNT: u32 = 0;
static mut G_ABS_POINTERS: [*mut EfiAbsolutePointer; 8] = [null as *mut EfiAbsolutePointer; 8];
static mut G_ABS_COUNT: u32 = 0;
static mut G_CYCLES_PER_US: u64 = 3000;
static mut G_LAST_ABS_X: i32 = -1;
static mut G_LAST_ABS_Y: i32 = -1;

// Telemetria de Hardware, Pacing Adaptativo e Monitoramento de 60/120 Hz
static mut G_LAST_FRAME_TSC: u64 = 0;
static mut G_TARGET_FRAME_US: u64 = 16667;
static mut G_TELEMETRY_FRAME_COUNT: u64 = 0;
static mut G_TELEMETRY_DROPPED_FRAMES: u64 = 0;
static mut G_TELEMETRY_ACCUM_US: u64 = 0;
static mut G_TELEMETRY_FPS: f32 = 60.0;
static mut G_TELEMETRY_FRAMETIME_MS: f32 = 16.66;
static mut G_TELEMETRY_P95_MS: f32 = 16.66;

static mut G_SIMPLE_GUID: EfiGuid = EfiGuid {
    Data1: 0x31878c87,
    Data2: 0x0b75,
    Data3: 0x11d5,
    Data4: [0x9a, 0x4f, 0x00, 0x90, 0x27, 0x3f, 0xc1, 0x4d]
};

static mut G_ABSOLUTE_GUID: EfiGuid = EfiGuid {
    Data1: 0x8D59D32B,
    Data2: 0xC655,
    Data3: 0x4AE9,
    Data4: [0x9B, 0x15, 0xF2, 0x59, 0x04, 0x99, 0x2A, 0x43]
};

// =============================================================================
// LIGAÇÃO DE ATIVOS (FONTES, CJK E LOGO) 100% EM SOTLAS
// =============================================================================

@system
pub fn baken_runtime_init_assets() -> void {
    let font_adv = baken_get_font_advances(2);
    let font_alpha = baken_get_font_alpha(2);
    let font_w = baken_get_font_width(2);
    let font_h = baken_get_font_height(2);
    let font_px = baken_get_font_px(2);
    if (font_alpha != (null as *const u8)) {
        raster_bind_font_atlas(font_adv, font_alpha, font_w, font_h, font_px);
    }

    let title_adv = baken_get_font_advances(5);
    let title_alpha = baken_get_font_alpha(5);
    let title_w = baken_get_font_width(5);
    let title_h = baken_get_font_height(5);
    let title_px = baken_get_font_px(5);
    if (title_alpha != (null as *const u8)) {
        raster_bind_title_font_atlas(title_adv, title_alpha, title_w, title_h, title_px);
    }

    for mut i in 0..3 {
        let cw = baken_get_cjk_width(i as u32);
        let ch = baken_get_cjk_height(i as u32);
        let calpha = baken_get_cjk_alpha(i as u32);
        if (calpha != (null as *const u8)) {
            raster_bind_cjk_item(i as u32, cw, ch, calpha);
        }
    }

    let logo_px = baken_get_logo_pixels();
    let logo_sz = baken_get_logo_size();
    if (logo_px != (null as *const u32)) {
        raster_bind_logo_atlas(logo_px, logo_sz);
    }
}

// =============================================================================
// INICIALIZAÇÃO DE HARDWARE UEFI 100% EM SOTLAS
// =============================================================================

@system
pub fn baken_efi_init(boot_info: *const void) -> void {
    if (boot_info == (null as *const void)) { return; }
    let info = boot_info as *const BakenBootContext;
    let st = info.system_table as *mut EfiSystemTable;
    if (st == (null as *mut EfiSystemTable)) { return; }
    G_SYSTEM_TABLE = st;
    let bs = st.BootServices;
    G_BOOT_SERVICES = bs;
    G_KEYBOARD = st.ConIn;

    // Conecta o protocolo repassado pelo bootloader se existir
    if (info.pointer_protocol != (null as *mut u8)) {
        G_SIMPLE_POINTERS[0] = info.pointer_protocol as *mut EfiSimplePointer;
        G_SIMPLE_COUNT = 1;
        G_ABS_POINTERS[0] = info.pointer_protocol as *mut EfiAbsolutePointer;
        G_ABS_COUNT = 1;
    }

    // Busca via LocateProtocol se ainda nao estiver preenchido
    if (bs != (null as *mut EfiBootServicesPrefix)) {
        if (G_SIMPLE_COUNT == 0) {
            let mut ptr: *mut void = null as *mut void;
            if (bs.LocateProtocol(&G_SIMPLE_GUID, null as *mut void, &mut ptr) == 0) {
                if (ptr != (null as *mut void)) {
                    let sp = ptr as *mut EfiSimplePointer;
                    sp.Reset(sp, 0);
                    G_SIMPLE_POINTERS[0] = sp;
                    G_SIMPLE_COUNT = 1;
                }
            }
        }
        if (G_ABS_COUNT == 0) {
            let mut ptr: *mut void = null as *mut void;
            if (bs.LocateProtocol(&G_ABSOLUTE_GUID, null as *mut void, &mut ptr) == 0) {
                if (ptr != (null as *mut void)) {
                    let ap = ptr as *mut EfiAbsolutePointer;
                    ap.Reset(ap, 0);
                    G_ABS_POINTERS[0] = ap;
                    G_ABS_COUNT = 1;
                }
            }
        }

        // Calibracao de ciclos por microsegundo via TSC e Stall
        let start = baken_efi_read_tsc();
        bs.Stall(10000);
        let end = baken_efi_read_tsc();
        if (end > start) {
            G_CYCLES_PER_US = (end - start) / 10000;
        }
        if (G_CYCLES_PER_US == 0) {
            G_CYCLES_PER_US = 3000;
        }
    }
}

// =============================================================================
// POLLING DE ENTRADA (TECLADO, MOUSE RELATIVO E TABLET ABSOLUTO)
// =============================================================================

@system
pub fn baken_efi_poll_key(out_scan: *mut u16, out_uni: *mut u16) -> u8 {
    let kbd = G_KEYBOARD;
    if (kbd == (null as *mut EfiSimpleTextInput)) { return 0; }
    let mut key = EfiInputKey { ScanCode: 0, UnicodeChar: 0 };
    if (kbd.ReadKeyStroke(kbd, &mut key) == 0) {
        *out_scan = key.ScanCode;
        *out_uni = key.UnicodeChar;
        return 1;
    }
    return 0;
}

@system
pub fn baken_efi_poll_mouse_rel(out_dx: *mut i32, out_dy: *mut i32, out_btn: *mut u8) -> u8 {
    let mut total_dx: i32 = 0;
    let mut total_dy: i32 = 0;
    let mut any_event: u8 = 0;
    let mut btn_state: u8 = 0;

    for mut i in 0..G_SIMPLE_COUNT {
        let ptr = G_SIMPLE_POINTERS[i as usize];
        if (ptr == (null as *mut EfiSimplePointer)) { continue; }
        let mut state = EfiSimplePointerState {
            RelativeMovementX: 0,
            RelativeMovementY: 0,
            RelativeMovementZ: 0,
            LeftButton: 0,
            RightButton: 0
        };
        if (ptr.GetState(ptr, &mut state) == 0) {
            let rx = state.RelativeMovementX;
            let ry = state.RelativeMovementY;
            if (rx != 0 || ry != 0 || state.LeftButton != 0) {
                let mag2 = rx * rx + ry * ry;
                let scale: i32 = if (mag2 > 100) { 2 } else { 1 };
                let mut dx = (rx * scale) / 6;
                let mut dy = (ry * scale) / 6;
                if (dx == 0 && rx != 0) { dx = if (rx > 0) { 1 } else { -1 }; }
                if (dy == 0 && ry != 0) { dy = if (ry > 0) { 1 } else { -1 }; }

                total_dx += dx;
                total_dy += dy;
                if (state.LeftButton != 0) { btn_state = 1; }
                any_event = 1;
            }
        }
    }

    if (any_event == 1) {
        *out_dx = total_dx;
        *out_dy = total_dy;
        *out_btn = btn_state;
        return 1;
    }
    return 0;
}

@system
pub fn baken_efi_poll_mouse_abs(screen_w: u32, screen_h: u32, out_x: *mut i32, out_y: *mut i32, out_btn: *mut u8) -> u8 {
    for mut i in 0..G_ABS_COUNT {
        let abs = G_ABS_POINTERS[i as usize];
        if (abs == (null as *mut EfiAbsolutePointer)) { continue; }
        let mode = abs.Mode;
        if (mode == (null as *mut EfiAbsolutePointerMode)) { continue; }
        let mut state = EfiAbsolutePointerState {
            CurrentX: 0,
            CurrentY: 0,
            CurrentZ: 0,
            ActiveButtons: 0
        };
        if (abs.GetState(abs, &mut state) == 0) {
            let range_x = mode.AbsoluteMaxX - mode.AbsoluteMinX;
            let range_y = mode.AbsoluteMaxY - mode.AbsoluteMinY;
            if (range_x > 0 && range_y > 0) {
                let mut raw_x = if (state.CurrentX > mode.AbsoluteMinX) { state.CurrentX - mode.AbsoluteMinX } else { 0 };
                let mut raw_y = if (state.CurrentY > mode.AbsoluteMinY) { state.CurrentY - mode.AbsoluteMinY } else { 0 };
                if (raw_x > range_x) { raw_x = range_x; }
                if (raw_y > range_y) { raw_y = range_y; }
                let mx = ((raw_x * ((screen_w - 1) as u64)) / range_x) as i32;
                let my = ((raw_y * ((screen_h - 1) as u64)) / range_y) as i32;
                let btn: u8 = if ((state.ActiveButtons & 1) != 0) { 1 } else { 0 };
                if (mx != G_LAST_ABS_X || my != G_LAST_ABS_Y || btn != 0) {
                    G_LAST_ABS_X = mx;
                    G_LAST_ABS_Y = my;
                    *out_x = mx;
                    *out_y = my;
                    *out_btn = btn;
                    return 1;
                }
            }
        }
    }
    return 0;
}

// =============================================================================
// TEMPORIZAÇÃO E PACING DE QUADROS A 60 FPS EXATOS
// =============================================================================

@system
pub fn baken_efi_read_tsc() -> u64 {
    return baken_rdtsc();
}

@system
pub fn baken_efi_frame_wait(frame_start: u64) -> void {
    let frame_end = baken_efi_read_tsc();
    let cycles_per_us = G_CYCLES_PER_US;
    let bs = G_BOOT_SERVICES;

    // Alvo adaptativo baseado na taxa de atualização do monitor
    let reported_refresh = display_get_refresh_hz();
    // Cada painel recebe seu orçamento real: 60, 90, 120, 144, 165 e 240 Hz
    // deixam de ser agrupados artificialmente em apenas três velocidades.
    let refresh_hz: u32 = if reported_refresh < 30 { 60 } else if reported_refresh > 240 { 240 } else { reported_refresh };
    let target_us: u64 = 1000000 / refresh_hz as u64;
    unsafe { G_TARGET_FRAME_US = target_us; }

    if (cycles_per_us > 0 && frame_end > frame_start) {
        let work_us = (frame_end - frame_start) / cycles_per_us;
        if (work_us < target_us) {
            let remain = target_us - work_us;
            if (bs != (null as *mut EfiBootServicesPrefix)) {
                bs.Stall(remain);
            }
        } else {
            // Quadro excedeu o orçamento: registra frame atrasado e NÃO penaliza com stall punitivo
            unsafe { G_TELEMETRY_DROPPED_FRAMES += 1; }
            if (bs != (null as *mut EfiBootServicesPrefix)) {
                bs.Stall(15); // cooperação mínima para descritores USB
            }
        }
    } else {
        if (bs != (null as *mut EfiBootServicesPrefix)) {
            bs.Stall(target_us);
        }
    }

    // Medição real do delta de tempo decorrido desde o início do quadro anterior
    let now_tsc = baken_efi_read_tsc();
    let mut dt: f32 = 0.0166667;
    unsafe {
        if (G_LAST_FRAME_TSC > 0 && now_tsc > G_LAST_FRAME_TSC && cycles_per_us > 0) {
            let total_us = (now_tsc - G_LAST_FRAME_TSC) / cycles_per_us;
            dt = (total_us as f32) / 1000000.0;
            if (dt < 0.001) { dt = 0.001; }
            if (dt > 0.066) { dt = 0.066; }

            let ft_ms = (total_us as f32) / 1000.0;
            G_TELEMETRY_FRAMETIME_MS = (G_TELEMETRY_FRAMETIME_MS * 0.9) + (ft_ms * 0.1);
            if (ft_ms > G_TELEMETRY_P95_MS) {
                G_TELEMETRY_P95_MS = (G_TELEMETRY_P95_MS * 0.95) + (ft_ms * 0.05);
            } else {
                G_TELEMETRY_P95_MS = (G_TELEMETRY_P95_MS * 0.99) + (ft_ms * 0.01);
            }

            G_TELEMETRY_ACCUM_US += total_us;
            G_TELEMETRY_FRAME_COUNT += 1;
            if (G_TELEMETRY_ACCUM_US >= 1000000) {
                G_TELEMETRY_FPS = ((G_TELEMETRY_FRAME_COUNT as f32) * 1000000.0) / (G_TELEMETRY_ACCUM_US as f32);
                G_TELEMETRY_ACCUM_US = 0;
                G_TELEMETRY_FRAME_COUNT = 0;
            }
        }
        G_LAST_FRAME_TSC = now_tsc;
    }

    desktop_shell_set_frame_delta(dt);
}

@system
pub fn baken_telemetry_get_fps() -> f32 { unsafe { return G_TELEMETRY_FPS; } }

@system
pub fn baken_telemetry_get_frametime_ms() -> f32 { unsafe { return G_TELEMETRY_FRAMETIME_MS; } }

@system
pub fn baken_telemetry_get_p95_ms() -> f32 { unsafe { return G_TELEMETRY_P95_MS; } }

@system
pub fn baken_telemetry_get_dropped_frames() -> u64 { unsafe { return G_TELEMETRY_DROPPED_FRAMES; } }

@system
pub fn baken_runtime_timing_contract(frame_start: u64) -> void {
    baken_efi_frame_wait(frame_start);
}

// =============================================================================
// DESPACHO DE EVENTOS VISUAIS E DE ENTRADA
// =============================================================================

@system
pub fn baken_runtime_dispatch_click(mx: i32, my: i32, w: u32, h: u32) -> void {
    let session = desktop_compositor_get_session();
    if (session == 0) {
        baken_installer_handle_click(mx, my, w, h);
    } else if (session == 1) {
        baken_oobe_handle_click(mx, my, w, h);
    } else {
        if (!wm_handle_mouse_down(mx, my)) {
            desktop_shell_handle_click(mx, my);
        }
    }
}

@system
pub fn baken_runtime_dispatch_move(mx: i32, my: i32) -> void {
    desktop_shell_set_cursor(mx, my);
    raster_set_cursor_parallax(mx, my);
    let session = desktop_compositor_get_session();
    if (session == 2) {
        wm_handle_mouse_move(mx, my);
    }
}

@system
pub fn baken_runtime_dispatch_up() -> void {
    let session = desktop_compositor_get_session();
    if (session == 2) {
        wm_handle_mouse_up();
    }
}

// =============================================================================
// LOOP PRINCIPAL DO SISTEMA 100% EM SOTLAS
// =============================================================================

@system
@export
pub fn baken_runtime_run(boot_info: *const void, width: u32, height: u32) -> void {
    baken_efi_init(boot_info);

    let mut mouse_x: i32 = (width / 2) as i32;
    let mut mouse_y: i32 = (height / 2) as i32;
    let mut left_down: u8 = 0;

    desktop_shell_set_cursor(mouse_x, mouse_y);
    raster_set_cursor_parallax(mouse_x, mouse_y);

    loop {
        let frame_start: u64 = baken_efi_read_tsc();

        // 1. Polling de Teclado UEFI
        let mut scancode: u16 = 0;
        let mut unicode: u16 = 0;
        while (baken_efi_poll_key(&mut scancode, &mut unicode) == 1) {
            let session = desktop_compositor_get_session();
            if (session == 0) {
                let key = if (unicode != 0) { unicode as u32 } else { scancode as u32 };
                baken_installer_handle_key(key);
            } else if (session == 1) {
                if (unicode == 13 || unicode == 32 || unicode == 110 || unicode == 78) {
                    baken_oobe_handle_click(mouse_x, mouse_y, width, height);
                }
            } else if (session == 2) {
                if (unicode >= 49 && unicode <= 53) {
                    desktop_shell_open_app((unicode - 49) as u32);
                } else if (unicode == 105 || unicode == 73) {
                    desktop_compositor_set_session(0);
                }
            }
        }

        // 2. Polling de Mouse (Tablet Absoluto e Mouse Relativo Logitech MX Anywhere 3)
        let mut mouse_updated: u8 = 0;
        let mut curr_btn: u8 = left_down;

        let mut abs_x: i32 = 0;
        let mut abs_y: i32 = 0;
        let mut abs_btn: u8 = 0;
        if (baken_efi_poll_mouse_abs(width, height, &mut abs_x, &mut abs_y, &mut abs_btn) == 1) {
            mouse_x = abs_x;
            mouse_y = abs_y;
            curr_btn = abs_btn;
            mouse_updated = 1;
        }

        let mut rel_dx: i32 = 0;
        let mut rel_dy: i32 = 0;
        let mut rel_btn: u8 = 0;
        if (baken_efi_poll_mouse_rel(&mut rel_dx, &mut rel_dy, &mut rel_btn) == 1) {
            mouse_x += rel_dx;
            mouse_y += rel_dy;
            if (mouse_x < 0) { mouse_x = 0; }
            if (mouse_y < 0) { mouse_y = 0; }
            if (mouse_x >= (width as i32)) { mouse_x = (width as i32) - 1; }
            if (mouse_y >= (height as i32)) { mouse_y = (height as i32) - 1; }
            curr_btn = rel_btn;
            mouse_updated = 1;
        }

        if (mouse_updated == 1) {
            desktop_shell_set_cursor(mouse_x, mouse_y);
            raster_set_cursor_parallax(mouse_x, mouse_y);
        }

        // 3. Despacho de Eventos de Clique e Arraste
        if (curr_btn == 1 && left_down == 0) {
            baken_runtime_dispatch_click(mouse_x, mouse_y, width, height);
        } else if (curr_btn == 1) {
            if (desktop_compositor_get_session() == 2) {
                wm_handle_mouse_move(mouse_x, mouse_y);
            }
        } else if (left_down == 1) {
            if (desktop_compositor_get_session() == 2) {
                wm_handle_mouse_up();
            }
        }
        left_down = curr_btn;

        // 4. Renderizacao de Quadro a 60 FPS Fluidos
        desktop_compositor_render_frame();
        baken_efi_frame_wait(frame_start);
    }
}
