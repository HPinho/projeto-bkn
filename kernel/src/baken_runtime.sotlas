// Baken OS — fachada de compatibilidade para o runtime nativo.
//
// A antiga implementação UEFI foi aposentada. Este módulo preserva somente os
// símbolos públicos ainda usados pela rota histórica do kernel e delega input,
// temporização e loop de UI ao runtime nativo. Nenhum SystemTable, BootServices,
// protocolo de input ou ponteiro de firmware é mantido aqui.

module kernel::baken_runtime;

import kernel::graphics_engine::*;
import kernel::baken_rasterizer::*;
import kernel::baken_native_runtime::*;
import kernel::arch::x86_64::timer::*;

@system
pub fn baken_runtime_init_assets() -> void {
    let font_adv = baken_get_font_advances(2);
    let font_alpha = baken_get_font_alpha(2);
    let font_w = baken_get_font_width(2);
    let font_h = baken_get_font_height(2);
    let font_px = baken_get_font_px(2);
    if (font_alpha != (null as *const u8)) {
        raster_bind_font_atlas(font_adv, font_alpha, font_w, font_h, font_px);
    }

    let title_adv = baken_get_font_advances(5);
    let title_alpha = baken_get_font_alpha(5);
    let title_w = baken_get_font_width(5);
    let title_h = baken_get_font_height(5);
    let title_px = baken_get_font_px(5);
    if (title_alpha != (null as *const u8)) {
        raster_bind_title_font_atlas(title_adv, title_alpha, title_w, title_h, title_px);
    }

    for mut i in 0..3 {
        let cw = baken_get_cjk_width(i as u32);
        let ch = baken_get_cjk_height(i as u32);
        let calpha = baken_get_cjk_alpha(i as u32);
        if (calpha != (null as *const u8)) {
            raster_bind_cjk_item(i as u32, cw, ch, calpha);
        }
    }

    let logo_px = baken_get_logo_pixels();
    let logo_sz = baken_get_logo_size();
    if (logo_px != (null as *const u32)) {
        raster_bind_logo_atlas(logo_px, logo_sz);
    }
}

// Aliases temporários de ABI: os nomes antigos permanecem somente porque o
// backend de display ainda os referencia. A implementação é exclusivamente
// x86 nativa e será renomeada na auditoria final.
@system
pub fn baken_efi_read_tsc() -> u64 {
    return x86_timer_read_tsc();
}

@system
pub fn baken_efi_frame_wait(frame_start: u64) -> void {
    if !x86_timer_is_calibrated() { return; }
    let frame_end = x86_timer_read_tsc();
    if frame_end <= frame_start { return; }
    let work_us = x86_timer_elapsed_us(frame_start, frame_end);
    let target_us: u64 = 16667;
    if work_us < target_us {
        x86_timer_spin_wait_us(target_us - work_us);
    }
}

@system
pub fn baken_runtime_timing_contract(frame_start: u64) -> void {
    baken_efi_frame_wait(frame_start);
}

@system
@export
pub fn baken_runtime_run(boot_info: *const void, width: u32, height: u32) -> void {
    if boot_info == (null as *const void) || width == 0 || height == 0 {
        loop {}
    }
    baken_native_runtime_run(width, height);
}
