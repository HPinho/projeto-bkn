// Baken OS — HID-4c.4e: late attach + prova de interleaving de dois HIDs xHCI.
//
// O primeiro teclado continua pertencendo ao proof legado de post_cutover.
// Esta etapa conecta o segundo HID sem tornar sua presença obrigatória em
// hardware normal. Quando existem keyboard+mouse, arma um TD em cada slot antes
// de coletar completions e prova o demux do Event Ring global por slot+epoch.

module kernel::platform::hid_late_attach;

import kernel::arch::x86_64::serial::*;
import kernel::drivers::xhci_address::*;
import kernel::drivers::xhci_slot::*;
import kernel::drivers::xhci_configuration::*;
import kernel::drivers::xhci_hid_enumeration::*;
import kernel::drivers::xhci_hid_report::*;
import kernel::drivers::xhci_transfer::*;

pub const PLATFORM_HID_LATE_ATTACH_ATTEMPTS: u32 = 8;

static mut PLATFORM_HID_LATE_ATTACH_ATTEMPTED: bool = false;
static mut PLATFORM_HID_LATE_ATTACH_READY: bool = false;
static mut PLATFORM_HID_LATE_ATTACH_SLOT_ID: u8 = 0;
static mut PLATFORM_HID_INTERLEAVE_READY: bool = false;

@system
fn platform_hid_late_attach_emit_ready_marker() -> bool {
    // BAKEN:USB_HID_DUAL_READY\n
    let marker: [u8; 25] = [
        66,65,75,69,78,58,85,83,66,95,72,73,68,95,68,85,
        65,76,95,82,69,65,68,89,10
    ];
    let mut index: usize = 0;
    while index < 25 {
        if !x86_serial_write_byte(marker[index]) { return false; }
        index += 1;
    }
    return true;
}

@system
fn platform_hid_late_attach_emit_interleave_ready_marker() -> bool {
    // BAKEN:USB_HID_INTERLEAVE_READY\n
    let marker: [u8; 31] = [
        66,65,75,69,78,58,85,83,66,95,72,73,68,95,73,78,
        84,69,82,76,69,65,86,69,95,82,69,65,68,89,10
    ];
    let mut index: usize = 0;
    while index < 31 {
        if !x86_serial_write_byte(marker[index]) { return false; }
        index += 1;
    }
    return true;
}

// Ambos os TDs precisam estar publicados antes de qualquer wait. Os dois
// route_next_event() consomem exatamente duas completions reais do Event Ring e
// as depositam na mailbox indicada pelo Slot ID de cada Event TRB, independente
// da ordem em que QEMU/xHC as produzir.
@system
fn platform_hid_late_attach_prove_interleaving(first_slot: u8,
                                                second_slot: u8) -> bool {
    if first_slot == 0 || second_slot == 0 || first_slot == second_slot ||
       !xhci_hid_report_is_ready_for(first_slot) ||
       !xhci_hid_report_is_ready_for(second_slot) ||
       xhci_hid_protocol_for(first_slot) != USB_HID_PROTOCOL_KEYBOARD ||
       xhci_hid_protocol_for(second_slot) != USB_HID_PROTOCOL_MOUSE {
        return false;
    }

    let routed_before = xhci_transfer_routed_event_count();

    // Mouse primeiro, teclado depois: nenhuma suposição é feita sobre a ordem
    // de completion. O dispatcher usa o Slot ID que veio do próprio Event TRB.
    if !xhci_hid_report_submit_for_slot(second_slot) { return false; }
    if !xhci_hid_report_submit_for_slot(first_slot) { return false; }
    if !xhci_hid_report_transfer_pending_for(first_slot) ||
       !xhci_hid_report_transfer_pending_for(second_slot) {
        return false;
    }

    if !xhci_transfer_route_next_event() { return false; }
    if !xhci_transfer_route_next_event() { return false; }
    if xhci_transfer_routed_event_count() < routed_before + 2 { return false; }
    if !xhci_transfer_pending_is_ready_for(first_slot) ||
       !xhci_transfer_pending_is_ready_for(second_slot) {
        return false;
    }

    // A ordem de coleta é deliberadamente diferente da ordem de submit. Cada
    // completion só pode ser retirada pela combinação slot+endpoint+TRB física.
    if !xhci_hid_report_complete_for_slot(first_slot) { return false; }
    if !xhci_hid_report_complete_for_slot(second_slot) { return false; }
    if xhci_hid_report_transfer_pending_for(first_slot) ||
       xhci_hid_report_transfer_pending_for(second_slot) ||
       xhci_transfer_pending_is_ready_for(first_slot) ||
       xhci_transfer_pending_is_ready_for(second_slot) {
        return false;
    }
    if xhci_hid_report_last_length_for(first_slot) < XHCI_HID_BOOT_KEYBOARD_LENGTH ||
       xhci_hid_report_last_length_for(second_slot) < XHCI_HID_BOOT_MOUSE_MIN_LENGTH {
        return false;
    }

    if !platform_hid_late_attach_emit_interleave_ready_marker() { return false; }
    unsafe { PLATFORM_HID_INTERLEAVE_READY = true; }
    return true;
}

@system
pub fn platform_hid_late_attach_second_mouse() -> bool {
    unsafe {
        if PLATFORM_HID_LATE_ATTACH_READY { return true; }
        if PLATFORM_HID_LATE_ATTACH_ATTEMPTED { return false; }
        PLATFORM_HID_LATE_ATTACH_ATTEMPTED = true;
    }

    let first_slot = xhci_address_slot_id();
    if first_slot == 0 || xhci_hid_protocol_for(first_slot) != USB_HID_PROTOCOL_KEYBOARD {
        return false;
    }

    // Começa do início do inventário e pula portas que já possuem Slot ID.
    // No QEMU certificado isso preserva usb-kbd como primeiro device e seleciona
    // usb-mouse como o próximo dispositivo conectado.
    let second_slot = xhci_hid_enumerate_next_connected(0);
    if second_slot == 0 || second_slot == first_slot || xhci_slot_active_count() < 2 {
        return false;
    }
    if !xhci_hid_enumeration_is_ready_for(second_slot) ||
       xhci_hid_protocol_for(second_slot) != USB_HID_PROTOCOL_MOUSE {
        return false;
    }

    let mut attempts: u32 = 0;
    while attempts < PLATFORM_HID_LATE_ATTACH_ATTEMPTS {
        if !xhci_hid_report_poll_slot_once(second_slot) { return false; }
        if xhci_hid_report_last_length_for(second_slot) >= XHCI_HID_BOOT_MOUSE_MIN_LENGTH {
            if !platform_hid_late_attach_emit_ready_marker() { return false; }
            unsafe {
                PLATFORM_HID_LATE_ATTACH_SLOT_ID = second_slot;
                PLATFORM_HID_LATE_ATTACH_READY = true;
            }
            // O dual-device 4c.4d já está provado neste ponto. O 4c.4e é uma
            // prova adicional: sua falha não transforma dois HIDs em requisito
            // universal de boot, mas o workflow dedicado exige seu marker.
            platform_hid_late_attach_prove_interleaving(first_slot, second_slot);
            return true;
        }
        attempts += 1;
    }
    return false;
}

@system
pub fn platform_hid_late_attach_is_ready() -> bool {
    unsafe { return PLATFORM_HID_LATE_ATTACH_READY; }
}

@system
pub fn platform_hid_late_attach_slot_id() -> u8 {
    unsafe {
        if !PLATFORM_HID_LATE_ATTACH_READY { return 0; }
        return PLATFORM_HID_LATE_ATTACH_SLOT_ID;
    }
}

@system
pub fn platform_hid_interleave_is_ready() -> bool {
    unsafe { return PLATFORM_HID_INTERLEAVE_READY; }
}
