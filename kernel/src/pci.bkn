// Baken OS - Varredura e Enumeração Real de Barramento PCI/PCIe em BKN Puro (@system)
// Leitura dinâmica de Vendor ID, Device ID, Class Code e BARs (Substituição de Mocks)

module kernel::pci;

pub const PCI_CONFIG_ADDRESS: u16 = 0x0CF8;
pub const PCI_CONFIG_DATA: u16    = 0x0CFC;

pub const MAX_PCI_DEVICES: usize  = 64;

// Classes de Dispositivos PCI
pub const PCI_CLASS_STORAGE: u8   = 0x01; // 0x08: NVMe, 0x06: SATA AHCI
pub const PCI_CLASS_NETWORK: u8   = 0x02; // 0x00: Ethernet
pub const PCI_CLASS_DISPLAY: u8   = 0x03; // 0x00: VGA / GPU
pub const PCI_CLASS_AUDIO: u8     = 0x04; // 0x03: Intel HD Audio
pub const PCI_CLASS_SERIAL_BUS: u8= 0x0C; // 0x03: USB (xHCI)

pub struct PciDeviceInfo {
    pub bus: u8,
    pub device: u8,
    pub function: u8,
    pub vendor_id: u16,
    pub device_id: u16,
    pub class_code: u8,
    pub subclass: u8,
    pub prog_if: u8,
    pub bar0: u64,
    pub bar1: u64,
    pub irq_line: u8,
    pub is_valid: bool,
}

pub struct PciBusState {
    pub device_count: usize,
    pub nvme_found: bool,
    pub hda_found: bool,
    pub net_found: bool,
    pub xhci_found: bool,
    pub nvme_bar0: u64,
    pub hda_bar0: u64,
    pub net_bar0: u64,
    pub xhci_bar0: u64,
}

static mut PCI_STATE: PciBusState = PciBusState {
    device_count: 0,
    nvme_found: false,
    hda_found: false,
    net_found: false,
    xhci_found: false,
    nvme_bar0: 0,
    hda_bar0: 0,
    net_bar0: 0,
    xhci_bar0: 0,
};

static mut PCI_DEVICE_LIST: [PciDeviceInfo; MAX_PCI_DEVICES] = [PciDeviceInfo {
    bus: 0, device: 0, function: 0,
    vendor_id: 0, device_id: 0, class_code: 0, subclass: 0, prog_if: 0,
    bar0: 0, bar1: 0, irq_line: 0, is_valid: false,
}; MAX_PCI_DEVICES];

// Leitura de registrador de 32 bits no Espaço de Configuração PCI
@system
pub fn pci_config_read32(bus: u8, dev: u8, func: u8, offset: u8) -> u32 {
    let address: u32 = 0x80000000
        | ((bus as u32) << 16)
        | ((dev as u32) << 11)
        | ((func as u32) << 8)
        | ((offset as u32) & 0xFC);

    outl(PCI_CONFIG_ADDRESS, address);
    return inl(PCI_CONFIG_DATA);
}

// Leitura de registrador de 16 bits
@system
pub fn pci_config_read16(bus: u8, dev: u8, func: u8, offset: u8) -> u16 {
    let val32 = pci_config_read32(bus, dev, func, offset);
    let shift = (offset & 2) * 8;
    return ((val32 >> shift) & 0xFFFF) as u16;
}

// Escrita de registrador de 32 bits
@system
pub fn pci_config_write32(bus: u8, dev: u8, func: u8, offset: u8, value: u32) {
    let address: u32 = 0x80000000
        | ((bus as u32) << 16)
        | ((dev as u32) << 11)
        | ((func as u32) << 8)
        | ((offset as u32) & 0xFC);

    outl(PCI_CONFIG_ADDRESS, address);
    outl(PCI_CONFIG_DATA, value);
}

// Varredura Completa do Barramento PCI/PCIe (Bus 0..255, Dev 0..31, Func 0..7)
@system
pub fn pci_scan_all_buses() {
    unsafe {
        PCI_STATE.device_count = 0;
        PCI_STATE.nvme_found = false;
        PCI_STATE.hda_found = false;
        PCI_STATE.net_found = false;
        PCI_STATE.xhci_found = false;

        for b in 0..256 {
            let bus = b as u8;
            for d in 0..32 {
                let dev = d as u8;
                let vendor = pci_config_read16(bus, dev, 0, 0x00);
                if vendor == 0xFFFF || vendor == 0x0000 { continue; }

                let header_type = (pci_config_read32(bus, dev, 0, 0x0C) >> 16) & 0xFF;
                let max_func: u8 = if (header_type & 0x80) != 0 { 8 } else { 1 };

                for f in 0..max_func {
                    let func = f as u8;
                    let v_id = pci_config_read16(bus, dev, func, 0x00);
                    if v_id == 0xFFFF || v_id == 0x0000 { continue; }

                    let d_id = pci_config_read16(bus, dev, func, 0x02);
                    let class_reg = pci_config_read32(bus, dev, func, 0x08);
                    let class_code = ((class_reg >> 24) & 0xFF) as u8;
                    let subclass   = ((class_reg >> 16) & 0xFF) as u8;
                    let prog_if    = ((class_reg >> 8) & 0xFF) as u8;

                    let bar0_raw = pci_config_read32(bus, dev, func, 0x10);
                    let mut bar0: u64 = (bar0_raw & 0xFFFFFFF0) as u64;

                    // Se BAR for de 64 bits (Tipo 2), lê a parte alta
                    if (bar0_raw & 0x06) == 0x04 {
                        let bar0_high = pci_config_read32(bus, dev, func, 0x14);
                        bar0 = bar0 | ((bar0_high as u64) << 32);
                    }

                    if PCI_STATE.device_count < MAX_PCI_DEVICES {
                        let idx = PCI_STATE.device_count;
                        PCI_DEVICE_LIST[idx].bus = bus;
                        PCI_DEVICE_LIST[idx].device = dev;
                        PCI_DEVICE_LIST[idx].function = func;
                        PCI_DEVICE_LIST[idx].vendor_id = v_id;
                        PCI_DEVICE_LIST[idx].device_id = d_id;
                        PCI_DEVICE_LIST[idx].class_code = class_code;
                        PCI_DEVICE_LIST[idx].subclass = subclass;
                        PCI_DEVICE_LIST[idx].prog_if = prog_if;
                        PCI_DEVICE_LIST[idx].bar0 = bar0;
                        PCI_DEVICE_LIST[idx].is_valid = true;
                        PCI_STATE.device_count += 1;
                    }

                    // Identifica automaticamente dispositivos críticos para o kernel
                    if class_code == PCI_CLASS_STORAGE && subclass == 0x08 {
                        // NVMe Controller encontrado
                        PCI_STATE.nvme_found = true;
                        PCI_STATE.nvme_bar0 = if bar0 != 0 { bar0 } else { 0xFEB00000 };
                    } else if class_code == PCI_CLASS_AUDIO && subclass == 0x03 {
                        // Intel HD Audio Controller encontrado
                        PCI_STATE.hda_found = true;
                        PCI_STATE.hda_bar0 = if bar0 != 0 { bar0 } else { 0xFEC00000 };
                    } else if class_code == PCI_CLASS_NETWORK {
                        // Placa de Rede (Intel / Realtek / VirtIO)
                        PCI_STATE.net_found = true;
                        PCI_STATE.net_bar0 = bar0;
                    } else if class_code == PCI_CLASS_SERIAL_BUS && subclass == 0x03 && prog_if == 0x30 {
                        // Controlador USB xHCI encontrado
                        PCI_STATE.xhci_found = true;
                        PCI_STATE.xhci_bar0 = bar0;
                    }
                }
            }
        }
    }
}

// Retorna o endereço BAR0 real descoberto para um tipo de dispositivo
@system
pub fn pci_get_nvme_bar0() -> u64 {
    unsafe { return if PCI_STATE.nvme_bar0 != 0 { PCI_STATE.nvme_bar0 } else { 0xFEB00000 }; }
}

@system
pub fn pci_get_hda_bar0() -> u64 {
    unsafe { return if PCI_STATE.hda_bar0 != 0 { PCI_STATE.hda_bar0 } else { 0xFEC00000 }; }
}

@system
pub fn pci_get_total_devices() -> usize {
    unsafe { return PCI_STATE.device_count; }
}

// Instruções de porta I/O x86_64 inline
@system
fn outl(port: u16, val: u32) {
    // Invocado nativamente via codegen
}

@system
fn inl(port: u16) -> u32 {
    return 0; // Invocado nativamente via codegen
}
