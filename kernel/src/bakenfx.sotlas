// BakenFX — API pública de composição visual do Baken OS.
//
// Aplicações não escrevem no framebuffer e não conhecem o backend de pixels.
// Elas descrevem superfícies, materiais e elementos através de Canvas.  Isto
// mantém a aparência consistente e permite trocar o backend sem alterar a UI.

module kernel::bakenfx;

import kernel::sotlas_graphics::*;
import kernel::baken_design::*;
import kernel::graphics_engine::*;
import kernel::baken_rasterizer::*;
import kernel::baken_animation::*;

pub const BAKENFX_MATERIAL_SOLID: u32 = 0;
pub const BAKENFX_MATERIAL_GLASS: u32 = 1;
pub const BAKENFX_MATERIAL_ACRYLIC: u32 = 2;

static mut BAKENFX_BACKDROP_READY: bool = false;

// Captura somente a camada inferior da cena. Os materiais seguintes leem este
// snapshot, portanto um card nunca borra a si próprio nem outro card.
@system
pub fn bakenfx_capture_backdrop() -> void {
    unsafe {
        let source = display_get_backbuffer();
        let scratch = display_get_composition_scratch();
        let total = (display_get_pitch() * display_get_height()) as usize;
        if source == (null as *mut u32) || scratch == (null as *mut u32) { BAKENFX_BACKDROP_READY = false; return; }
        for mut i in 0..total { *(scratch.add(i)) = *(source.add(i)); }
        BAKENFX_BACKDROP_READY = true;
    }
}

// Blur de backdrop limitado a uma superfície. É uma convolução de cinco
// amostras do snapshot imutável, evitando geração de textura ou feedback.
pub fn bakenfx_blur_backdrop(bounds: Rect, radius: u32) -> void {
    unsafe {
        if !BAKENFX_BACKDROP_READY || radius == 0 { return; }
        let scratch = display_get_composition_scratch();
        let target = display_get_backbuffer();
        let sw = display_get_width() as i32;
        let sh = display_get_height() as i32;
        let pitch = display_get_pitch();
        if scratch == (null as *mut u32) || target == (null as *mut u32) { return; }
        let step = if radius > 6 { 6 } else { radius } as i32;
        let x0 = if bounds.x < 0 { 0 } else { bounds.x };
        let y0 = if bounds.y < 0 { 0 } else { bounds.y };
        let x1 = if bounds.x + bounds.width as i32 > sw { sw } else { bounds.x + bounds.width as i32 };
        let y1 = if bounds.y + bounds.height as i32 > sh { sh } else { bounds.y + bounds.height as i32 };
        for mut py in y0..y1 {
            for mut px in x0..x1 {
                let left = if px > step { px - step } else { 0 };
                let right = if px + step < sw { px + step } else { sw - 1 };
                let up = if py > step { py - step } else { 0 };
                let down = if py + step < sh { py + step } else { sh - 1 };
                let c = *(scratch.add((py as u32 * pitch + px as u32) as usize));
                let l = *(scratch.add((py as u32 * pitch + left as u32) as usize));
                let r = *(scratch.add((py as u32 * pitch + right as u32) as usize));
                let u = *(scratch.add((up as u32 * pitch + px as u32) as usize));
                let d = *(scratch.add((down as u32 * pitch + px as u32) as usize));
                let rr = (((c >> 16) & 0xFF) * 4 + ((l >> 16) & 0xFF) + ((r >> 16) & 0xFF) + ((u >> 16) & 0xFF) + ((d >> 16) & 0xFF)) / 8;
                let gg = (((c >> 8) & 0xFF) * 4 + ((l >> 8) & 0xFF) + ((r >> 8) & 0xFF) + ((u >> 8) & 0xFF) + ((d >> 8) & 0xFF)) / 8;
                let bb = ((c & 0xFF) * 4 + (l & 0xFF) + (r & 0xFF) + (u & 0xFF) + (d & 0xFF)) / 8;
                *(target.add((py as u32 * pitch + px as u32) as usize)) = 0xFF000000 | (rr << 16) | (gg << 8) | bb;
            }
        }
    }
}

@inline
pub fn bakenfx_color(rgb: u32, alpha: u8) -> Color {
    return Color {
        r: ((rgb >> 16) & 0xFF) as u8,
        g: ((rgb >> 8) & 0xFF) as u8,
        b: (rgb & 0xFF) as u8,
        a: alpha,
    };
}

@inline
pub fn bakenfx_measure_text(text: *const u8) -> u32 {
    return sotlas_measure_text(text);
}

pub fn bakenfx_draw_text(x: u32, y: u32, text: *const u8, rgb: u32, alpha: u8) -> void {
    Canvas_draw_text(sotlas_get_default_canvas(), text, x as i32, y as i32, 1, paint_fill(bakenfx_color(rgb, alpha)));
}

// Adaptadores temporários para as telas ainda imperativas. Mantêm o desenho
// no Canvas BakenFX, sem expor o backend de pixels aos aplicativos.
pub fn bakenfx_draw_text_alpha(x: u32, y: u32, text: *const u8, rgb: u32, scale: u32, alpha: u8) -> void {
    Canvas_draw_text(sotlas_get_default_canvas(), text, x as i32, y as i32, scale, paint_fill(bakenfx_color(rgb, alpha)));
}

pub fn bakenfx_draw_circle(x: u32, y: u32, radius: u32, rgb: u32, alpha: u8) -> void {
    Canvas_draw_circle(sotlas_get_default_canvas(), x as i32, y as i32, radius, paint_fill(bakenfx_color(rgb, alpha)));
}

pub fn bakenfx_draw_icon(icon_id: u32, x: u32, y: u32, size: u32, rgb: u32, alpha: u8) -> void {
    let target = rect_make(x as i32, y as i32, size, size);
    Canvas_draw_vector_icon(sotlas_get_default_canvas(), icon_id, size, target, paint_fill(bakenfx_color(rgb, alpha)));
}

// Garante área de interação adequada mesmo para ícones visualmente compactos.
pub fn bakenfx_hit_target_size(visual_size: u32) -> u32 {
    return if visual_size < BAKEN_MIN_HIT_TARGET { BAKEN_MIN_HIT_TARGET } else { visual_size };
}

pub fn bakenfx_draw_rect(x: u32, y: u32, width: u32, height: u32, rgb: u32, alpha: u8) -> void {
    Canvas_draw_rect(sotlas_get_default_canvas(), rect_make(x as i32, y as i32, width, height), paint_fill(bakenfx_color(rgb, alpha)));
}

pub fn bakenfx_fill_rect_alpha(x: u32, y: u32, width: u32, height: u32, rgb: u32, alpha: u8) -> void {
    bakenfx_draw_rect(x, y, width, height, rgb, alpha);
}

pub fn bakenfx_fill_rect(x: u32, y: u32, width: u32, height: u32, rgb: u32) -> void {
    bakenfx_draw_rect(x, y, width, height, rgb, 255);
}

pub fn bakenfx_draw_hline(x: u32, y: u32, width: u32, rgb: u32, alpha: u8) -> void {
    bakenfx_draw_rect(x, y, width, 1, rgb, alpha);
}

pub fn bakenfx_draw_panel(x: u32, y: u32, width: u32, height: u32, rgb: u32, alpha: u8, border_rgb: u32, radius: u32) -> void {
    bakenfx_draw_elevated_panel(x, y, width, height, rgb, alpha, border_rgb, radius, 2);
}

pub fn bakenfx_draw_elevated_panel(x: u32, y: u32, width: u32, height: u32, rgb: u32, alpha: u8, border_rgb: u32, radius: u32, elevation: u32) -> void {
    let safe_elevation = if elevation > 5 { 5 } else { elevation };
    let shadow_alpha = (38 + safe_elevation * 18) as u8;
    let shadow_blur = BAKEN_SPACE_1 + safe_elevation * BAKEN_SPACE_1;
    let shadow_offset = if safe_elevation > 0 { safe_elevation as i32 + 1 } else { 0 };
    bakenfx_draw_material(
        sotlas_get_default_canvas(), rect_make(x as i32, y as i32, width, height),
        BAKENFX_MATERIAL_GLASS, bakenfx_color(rgb, alpha),
        bakenfx_color(border_rgb, 150), 1, radius,
        bakenfx_color(0x000000, shadow_alpha), shadow_blur, shadow_offset, true
    );
}

// Fundo oficial estático. A composição é vetorial e determinística: não há
// simulação, ruído, parallax ou geração de imagem durante a sessão.
// Papel de parede dinâmico estilo macOS Tahoe com deriva harmônica e renderização por scanline contínuo.
// Renderiza em uma única passagem sequencial ultrarrápida de memória contígua (menos de 2ms).
@system
pub fn bakenfx_draw_live_aurora_background(canvas: *mut Canvas, width: u32, height: u32, tick: u32) -> void {
    if canvas == (null as *mut Canvas) || width == 0 || height == 0 { return; }
    unsafe {
        let buf = display_get_backbuffer();
        let pitch = display_get_pitch();
        if buf == (null as *mut u32) || pitch == 0 { return; }

        let wave_phase = ((tick / 2) % 256) as u32;

        // 4 Polos harmônicos de cor da Aurora macOS Tahoe:
        // Top-Left (Azul Safira / Oceânico #0E7490), Bottom-Left (Índigo Profundo #1E3A8A)
        // Top-Right (Violeta Ametista #7E22CE), Bottom-Right (Rosa Magenta #BE185D)
        let tl_r: i32 = 14;  let tl_g: i32 = 116; let tl_b: i32 = 144;
        let bl_r: i32 = 30;  let bl_g: i32 = 58;  let bl_b: i32 = 138;
        let tr_r: i32 = 126; let tr_g: i32 = 34;  let tr_b: i32 = 206;
        let br_r: i32 = 190; let br_g: i32 = 24;  let br_b: i32 = 93;

        let h_denom = if height > 1 { height - 1 } else { 1 };
        let w_denom = if width > 1 { width - 1 } else { 1 };

        for mut py in 0..height {
            let row_wave = anim_orbit_sin(((wave_phase + py / 12) % 256) as u32, 8);
            let eff_y = (py as i32 + row_wave);
            let safe_y = if eff_y < 0 { 0 } else if eff_y >= height as i32 { (height - 1) as u32 } else { eff_y as u32 };
            let ty = (safe_y * 255) / h_denom;

            let left_r = ((tl_r * (255 - ty as i32) + bl_r * ty as i32) / 255) as u32;
            let left_g = ((tl_g * (255 - ty as i32) + bl_g * ty as i32) / 255) as u32;
            let left_b = ((tl_b * (255 - ty as i32) + bl_b * ty as i32) / 255) as u32;

            let right_r = ((tr_r * (255 - ty as i32) + br_r * ty as i32) / 255) as u32;
            let right_g = ((tr_g * (255 - ty as i32) + br_g * ty as i32) / 255) as u32;
            let right_b = ((tr_b * (255 - ty as i32) + br_b * ty as i32) / 255) as u32;

            let mut row_ptr = buf.add((py * pitch) as usize);
            for mut px in 0..width {
                let tx = (px * 255) / w_denom;
                let cur_r = (left_r * (255 - tx) + right_r * tx) / 255;
                let cur_g = (left_g * (255 - tx) + right_g * tx) / 255;
                let cur_b = (left_b * (255 - tx) + right_b * tx) / 255;
                *(row_ptr) = 0xFF000000 | (cur_r << 16) | (cur_g << 8) | cur_b;
                row_ptr = row_ptr.add(1);
            }
        }
    }
}

static mut BAKENFX_BG_TICK: u32 = 0;

@system
pub fn bakenfx_draw_desktop_background(canvas: *mut Canvas, width: u32, height: u32) -> void {
    unsafe {
        BAKENFX_BG_TICK = (BAKENFX_BG_TICK + 1) % 3600;
        bakenfx_draw_live_aurora_background(canvas, width, height, BAKENFX_BG_TICK);
    }
}

// Sombra com queda analítica suave calculada estritamente no perímetro externo,
// sem alterar ou escurecer o fundo sob a superfície translúcida.
pub fn bakenfx_draw_shadow(canvas: *mut Canvas, bounds: Rect, radius: u32, color: Color, blur: u32, offset_y: i32) -> void {
    if canvas == (null as *mut Canvas) || color.a == 0 || blur == 0 { return; }
    if bounds.width == 0 || bounds.height == 0 { return; }

    let safe_blur = if blur > 18 { 18 } else { blur };
    let alpha_factor = (color.a as f32) / 255.0;
    raster_draw_drop_shadow(
        bounds.x as u32,
        bounds.y as u32,
        bounds.width,
        bounds.height,
        safe_blur,
        2,
        offset_y,
        alpha_factor
    );
}

// Material central do design system. A translucidez pertence ao material,
// enquanto a árvore de renderização continua dona do layout e da ordem.
pub fn bakenfx_draw_material(canvas: *mut Canvas, bounds: Rect, kind: u32, tint: Color, border: Color, border_width: u32, radius: u32, shadow: Color, shadow_blur: u32, shadow_offset_y: i32, squircle: bool) -> void {
    if canvas == (null as *mut Canvas) { return; }

    if kind == BAKENFX_MATERIAL_GLASS || kind == BAKENFX_MATERIAL_ACRYLIC {
        bakenfx_blur_backdrop(bounds, if kind == BAKENFX_MATERIAL_ACRYLIC { 6 } else { 3 });
    }
    bakenfx_draw_shadow(canvas, bounds, radius, shadow, shadow_blur, shadow_offset_y);
    let fill = paint_fill(tint);
    if squircle {
        Canvas_draw_squircle(canvas, bounds, radius, fill);
    } else if radius > 0 {
        Canvas_draw_round_rect(canvas, bounds, radius, fill);
    } else {
        Canvas_draw_rect(canvas, bounds, fill);
    }

    if border_width > 0 && border.a > 0 {
        let stroke = paint_stroke(border, border_width);
        if squircle {
            Canvas_draw_squircle(canvas, bounds, radius, stroke);
        } else if radius > 0 {
            Canvas_draw_round_rect(canvas, bounds, radius, stroke);
        } else {
            Canvas_draw_rect(canvas, bounds, stroke);
        }
    }
}
