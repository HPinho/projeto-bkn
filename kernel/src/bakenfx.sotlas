// BakenFX — API pública de composição visual do Baken OS.
//
// Aplicações não escrevem no framebuffer e não conhecem o backend de pixels.
// Elas descrevem superfícies, materiais e elementos através de Canvas.  Isto
// mantém a aparência consistente e permite trocar o backend sem alterar a UI.

module kernel::bakenfx;

import kernel::sotlas_graphics::*;
import kernel::baken_design::*;
import kernel::graphics_engine::*;
import kernel::baken_rasterizer::*;
import kernel::baken_animation::*;
import kernel::baken_cursor::*;

pub const BAKENFX_MATERIAL_SOLID: u32 = 0;
pub const BAKENFX_MATERIAL_GLASS: u32 = 1;
pub const BAKENFX_MATERIAL_ACRYLIC: u32 = 2;

pub const BAKENFX_CORNER_CURVE_LINEAR: u32 = 0;
pub const BAKENFX_CORNER_CURVE_CONTINUOUS: u32 = 1; // G2 Squircle

// =============================================================================
// 1. MOTOR DE PROPRIEDADES FÍSICAS E INTERRUPÇÃO CONTÍNUA (AnimState)
// =============================================================================

pub struct AnimState {
    pub current_val: f32;
    pub target_val: f32;
    pub velocity: f32;
    pub is_animating: bool;
    pub mass: f32;
    pub stiffness: f32;
    pub damping: f32;
}

@system
pub fn bakenfx_anim_init(state: *mut AnimState) -> void {
    if state == (null as *mut AnimState) { return; }
    unsafe {
        (*state).current_val = 0.0;
        (*state).target_val = 0.0;
        (*state).velocity = 0.0;
        (*state).is_animating = false;
        (*state).mass = 1.0;
        (*state).stiffness = 300.0;
        (*state).damping = 30.0;
    }
}

@system
pub fn bakenfx_anim_configure_material(state: *mut AnimState, profile: u32) -> void {
    if state == (null as *mut AnimState) { return; }
    unsafe {
        if profile == 0 {
            // Perfil 0: Heavy (Painéis, Menus e Notification Center)
            (*state).mass = 1.2;
            (*state).stiffness = 220.0;
            (*state).damping = 28.0;
        } else if profile == 1 {
            // Perfil 1: Light (Toasts, alertas e seleções rápidas)
            (*state).mass = 0.8;
            (*state).stiffness = 380.0;
            (*state).damping = 22.0;
        } else if profile == 2 {
            // Perfil 2: Viscous/Liquid (Barras de progresso dinâmicas)
            (*state).mass = 0.9;
            (*state).stiffness = 190.0;
            (*state).damping = 18.0;
        } else {
            // Perfil 3: Magnetic (Rastreamento elástico de cursor)
            (*state).mass = 0.6;
            (*state).stiffness = 450.0;
            (*state).damping = 26.0;
        }
    }
}

@system
pub fn bakenfx_interrupt_and_redirect(state: *mut AnimState, new_target: f32) -> void {
    if state == (null as *mut AnimState) { return; }
    unsafe {
        if (*state).is_animating {
            // Interrupção contínua: o alvo muda instantaneamente preservando a velocidade residual na mola
            (*state).target_val = new_target;
        } else {
            (*state).target_val = new_target;
            (*state).velocity = 0.0;
            (*state).is_animating = true;
        }
    }
}

@system
pub fn bakenfx_tick_spring_physics(state: *mut AnimState, delta_time: f32) -> void {
    if state == (null as *mut AnimState) { return; }
    unsafe {
        if !(*state).is_animating { return; }

        let dt = if delta_time > 0.05 { 0.05 } else if delta_time < 0.001 { 0.001 } else { delta_time };
        let displacement = (*state).current_val - (*state).target_val;
        let spring_force = -(*state).stiffness * displacement;
        let damping_force = -(*state).damping * (*state).velocity;
        let mass = if (*state).mass > 0.01 { (*state).mass } else { 1.0 };
        let acceleration = (spring_force + damping_force) / mass;

        (*state).velocity += acceleration * dt;
        (*state).current_val += (*state).velocity * dt;

        // Estabilização mecânica e repouso de energia
        let delta = (*state).current_val - (*state).target_val;
        let abs_delta = if delta < 0.0 { -delta } else { delta };
        let abs_vel = if (*state).velocity < 0.0 { -(*state).velocity } else { (*state).velocity };

        if abs_delta < 0.005 && abs_vel < 0.005 {
            (*state).current_val = (*state).target_val;
            (*state).velocity = 0.0;
            (*state).is_animating = false;
        }
    }
}

static mut BAKENFX_BACKDROP_READY: bool = false;
static mut BAKENFX_BACKGROUND_TICK: u32 = 0;
static mut BAKENFX_BACKGROUND_REMAINDER: f32 = 0.0;
static mut BAKENFX_FRAME_DELTA: f32 = 0.0166667;
// Cache do wallpaper: evita re-renderizar o gradiente animado a cada frame.
// O wallpaper só é redesenhado quando BAKENFX_WALLPAPER_DIRTY é true.
static mut BAKENFX_WALLPAPER_DIRTY: bool = true;
static mut BAKENFX_WALLPAPER_LAST_PHASE: u32 = 0xFFFFFFFF;

// O compositor fornece segundos reais; o wallpaper conserva a mesma cadência
// de movimento tanto em uma VM lenta quanto em um painel de alta atualização.
@system
pub fn bakenfx_set_frame_delta(dt: f32) -> void {
    unsafe {
        BAKENFX_FRAME_DELTA = if dt < 0.001 { 0.001 } else if dt > 0.066 { 0.066 } else { dt };
    }
}

// Captura somente a camada inferior da cena. Os materiais seguintes leem este
// snapshot, portanto um card nunca borra a si próprio nem outro card.
@system
pub fn bakenfx_capture_backdrop() -> void {
    unsafe {
        // O wallpaper ativo é uma composição estática. Reutilizar o snapshot
        // elimina uma cópia de tela inteira em cada frame (crítica em QEMU).
        if BAKENFX_BACKDROP_READY { return; }
        let source = display_get_backbuffer();
        let scratch = display_get_composition_scratch();
        let total = (display_get_pitch() * display_get_height()) as usize;
        if source == (null as *mut u32) || scratch == (null as *mut u32) { BAKENFX_BACKDROP_READY = false; return; }
        for mut i in 0..total { *(scratch.add(i)) = *(source.add(i)); }
        BAKENFX_BACKDROP_READY = true;
    }
}

// Deve ser chamado apenas quando o wallpaper ou o tema de fundo realmente
// mudar. A próxima captura reconstruirá o snapshot antes dos materiais.
@system
pub fn bakenfx_invalidate_backdrop() -> void {
    unsafe { BAKENFX_BACKDROP_READY = false; }
}

// Backend temporário de blur unrolled. Não é SIMD nem uma fila de GPU: o
// nome deixa isso explícito até a troca pelo box blur separável.
@system
pub fn bakenfx_blur_backdrop_unrolled(bounds: Rect, radius: u32) -> void {
    unsafe {
        if !BAKENFX_BACKDROP_READY || radius == 0 { return; }
        let scratch = display_get_composition_scratch();
        let target = display_get_backbuffer();
        let sw = display_get_width() as i32;
        let sh = display_get_height() as i32;
        let pitch = display_get_pitch();
        if scratch == (null as *mut u32) || target == (null as *mut u32) { return; }

        let step = if radius > 6 { 6 } else { radius } as i32;
        let x0 = if bounds.x < 0 { 0 } else { bounds.x };
        let y0 = if bounds.y < 0 { 0 } else { bounds.y };
        let x1 = if bounds.x + bounds.width as i32 > sw { sw } else { bounds.x + bounds.width as i32 };
        let y1 = if bounds.y + bounds.height as i32 > sh { sh } else { bounds.y + bounds.height as i32 };

        for mut py in y0..y1 {
            let row_off = (py as u32) * pitch;
            let up_y = if py > step { py - step } else { 0 };
            let down_y = if py + step < sh { py + step } else { sh - 1 };
            let up_off = (up_y as u32) * pitch;
            let down_off = (down_y as u32) * pitch;

            let mut px = x0;
            // Desenrolamento paralelo de 4 pixels por ciclo com Dynamic Vibrancy Apple
            while px + 4 <= x1 {
                for mut k in 0..4 {
                    let cur_x = px + k;
                    let left = if cur_x > step { cur_x - step } else { 0 };
                    let right = if cur_x + step < sw { cur_x + step } else { sw - 1 };

                    let c = *(scratch.add((row_off + cur_x as u32) as usize));
                    let l = *(scratch.add((row_off + left as u32) as usize));
                    let r = *(scratch.add((row_off + right as u32) as usize));
                    let u = *(scratch.add((up_off + cur_x as u32) as usize));
                    let d = *(scratch.add((down_off + cur_x as u32) as usize));

                    let rr = (((c >> 16) & 0xFF) * 4 + ((l >> 16) & 0xFF) + ((r >> 16) & 0xFF) + ((u >> 16) & 0xFF) + ((d >> 16) & 0xFF)) / 8;
                    let gg = (((c >> 8) & 0xFF) * 4 + ((l >> 8) & 0xFF) + ((r >> 8) & 0xFF) + ((u >> 8) & 0xFF) + ((d >> 8) & 0xFF)) / 8;
                    let bb = ((c & 0xFF) * 4 + (l & 0xFF) + (r & 0xFF) + (u & 0xFF) + (d & 0xFF)) / 8;

                    // Apple Dynamic Vibrancy Boost: +30% de saturação cromática ponderada pela luminância
                    let lum = ((rr * 77 + gg * 150 + bb * 29) / 256) as i32;
                    let vib_r = lum + ((((rr as i32) - lum) * 130) / 100);
                    let vib_g = lum + ((((gg as i32) - lum) * 130) / 100);
                    let vib_b = lum + ((((bb as i32) - lum) * 130) / 100);

                    let fin_r = (if vib_r < 0 { 0 } else if vib_r > 255 { 255 } else { vib_r }) as u32;
                    let fin_g = (if vib_g < 0 { 0 } else if vib_g > 255 { 255 } else { vib_g }) as u32;
                    let fin_b = (if vib_b < 0 { 0 } else if vib_b > 255 { 255 } else { vib_b }) as u32;

                    *(target.add((row_off + cur_x as u32) as usize)) = 0xFF000000 | (fin_r << 16) | (fin_g << 8) | fin_b;
                }
                px += 4;
            }

            // Borda residual com Dynamic Vibrancy
            while px < x1 {
                let left = if px > step { px - step } else { 0 };
                let right = if px + step < sw { px + step } else { sw - 1 };

                let c = *(scratch.add((row_off + px as u32) as usize));
                let l = *(scratch.add((row_off + left as u32) as usize));
                let r = *(scratch.add((row_off + right as u32) as usize));
                let u = *(scratch.add((up_off + px as u32) as usize));
                let d = *(scratch.add((down_off + px as u32) as usize));

                let rr = (((c >> 16) & 0xFF) * 4 + ((l >> 16) & 0xFF) + ((r >> 16) & 0xFF) + ((u >> 16) & 0xFF) + ((d >> 16) & 0xFF)) / 8;
                let gg = (((c >> 8) & 0xFF) * 4 + ((l >> 8) & 0xFF) + ((r >> 8) & 0xFF) + ((u >> 8) & 0xFF) + ((d >> 8) & 0xFF)) / 8;
                let bb = ((c & 0xFF) * 4 + (l & 0xFF) + (r & 0xFF) + (u & 0xFF) + (d & 0xFF)) / 8;

                let lum = ((rr * 77 + gg * 150 + bb * 29) / 256) as i32;
                let vib_r = lum + ((((rr as i32) - lum) * 130) / 100);
                let vib_g = lum + ((((gg as i32) - lum) * 130) / 100);
                let vib_b = lum + ((((bb as i32) - lum) * 130) / 100);

                let fin_r = (if vib_r < 0 { 0 } else if vib_r > 255 { 255 } else { vib_r }) as u32;
                let fin_g = (if vib_g < 0 { 0 } else if vib_g > 255 { 255 } else { vib_g }) as u32;
                let fin_b = (if vib_b < 0 { 0 } else if vib_b > 255 { 255 } else { vib_b }) as u32;

                *(target.add((row_off + px as u32) as usize)) = 0xFF000000 | (fin_r << 16) | (fin_g << 8) | fin_b;
                px += 1;
            }
        }
    }
}

// Box blur separável: snapshot -> intermediário (horizontal) -> framebuffer
// (vertical). O custo cresce linearmente com a área da superfície e não cria
// o padrão em cruz do backend legado.
pub fn bakenfx_blur_backdrop_separable(bounds: Rect, radius: u32) -> void {
    unsafe {
        if !BAKENFX_BACKDROP_READY || radius == 0 { return; }
        let source = display_get_composition_scratch();
        let temp = display_get_composition_intermediate();
        let target = display_get_backbuffer();
        let pitch = display_get_pitch();
        let sw = display_get_width() as i32;
        let sh = display_get_height() as i32;
        if source == (null as *mut u32) || temp == (null as *mut u32) || target == (null as *mut u32) { return; }
        let r = (if radius > 16 { 16 } else { radius }) as i32;
        let x0 = if bounds.x < 0 { 0 } else { bounds.x };
        let y0 = if bounds.y < 0 { 0 } else { bounds.y };
        let x1 = if bounds.x + bounds.width as i32 > sw { sw } else { bounds.x + bounds.width as i32 };
        let y1 = if bounds.y + bounds.height as i32 > sh { sh } else { bounds.y + bounds.height as i32 };
        if x1 <= x0 || y1 <= y0 { return; }

        // A superfície temporária recebe somente a margem vertical necessária
        // para a segunda passagem. As somas deslizantes mantêm custo constante
        // por pixel, inclusive para materiais grandes.
        let sample_y0 = if y0 > r { y0 - r } else { 0 };
        let sample_y1 = if y1 + r < sh { y1 + r } else { sh };
        let n = (r * 2 + 1) as u32;

        let mut y = sample_y0;
        while y < sample_y1 {
            let mut rr: u32 = 0; let mut gg: u32 = 0; let mut bb: u32 = 0;
            let mut sx = x0 - r;
            while sx <= x0 + r {
                let cx = if sx < 0 { 0 } else if sx >= sw { sw - 1 } else { sx };
                let p = *(source.add((y as u32 * pitch + cx as u32) as usize));
                rr += (p >> 16) & 0xFF; gg += (p >> 8) & 0xFF; bb += p & 0xFF;
                sx += 1;
            }
            let mut x = x0;
            while x < x1 {
                *(temp.add((y as u32 * pitch + x as u32) as usize)) = 0xFF000000 | ((rr / n) << 16) | ((gg / n) << 8) | (bb / n);
                let left_x = if x - r < 0 { 0 } else { x - r };
                let right_x = if x + r + 1 >= sw { sw - 1 } else { x + r + 1 };
                let left = *(source.add((y as u32 * pitch + left_x as u32) as usize));
                let right = *(source.add((y as u32 * pitch + right_x as u32) as usize));
                rr = rr - ((left >> 16) & 0xFF) + ((right >> 16) & 0xFF);
                gg = gg - ((left >> 8) & 0xFF) + ((right >> 8) & 0xFF);
                bb = bb - (left & 0xFF) + (right & 0xFF);
                x += 1;
            }
            y += 1;
        }
        let mut x = x0;
        while x < x1 {
            let mut rr: u32 = 0; let mut gg: u32 = 0; let mut bb: u32 = 0;
            let mut sy = y0 - r;
            while sy <= y0 + r {
                let cy = if sy < 0 { 0 } else if sy >= sh { sh - 1 } else { sy };
                let p = *(temp.add((cy as u32 * pitch + x as u32) as usize));
                rr += (p >> 16) & 0xFF; gg += (p >> 8) & 0xFF; bb += p & 0xFF;
                sy += 1;
            }
            let mut y2 = y0;
            while y2 < y1 {
                *(target.add((y2 as u32 * pitch + x as u32) as usize)) = 0xFF000000 | ((rr / n) << 16) | ((gg / n) << 8) | (bb / n);
                let top_y = if y2 - r < 0 { 0 } else { y2 - r };
                let bottom_y = if y2 + r + 1 >= sh { sh - 1 } else { y2 + r + 1 };
                let top = *(temp.add((top_y as u32 * pitch + x as u32) as usize));
                let bottom = *(temp.add((bottom_y as u32 * pitch + x as u32) as usize));
                rr = rr - ((top >> 16) & 0xFF) + ((bottom >> 16) & 0xFF);
                gg = gg - ((top >> 8) & 0xFF) + ((bottom >> 8) & 0xFF);
                bb = bb - (top & 0xFF) + (bottom & 0xFF);
                y2 += 1;
            }
            x += 1;
        }
    }
}

// Blur de backdrop limitado a uma superfície.
@system
pub fn bakenfx_blur_backdrop(bounds: Rect, radius: u32) -> void {
    bakenfx_blur_backdrop_separable(bounds, radius);
}

@inline
pub fn bakenfx_color(rgb: u32, alpha: u8) -> Color {
    return Color {
        r: ((rgb >> 16) & 0xFF) as u8,
        g: ((rgb >> 8) & 0xFF) as u8,
        b: (rgb & 0xFF) as u8,
        a: alpha,
    };
}

@inline
pub fn bakenfx_measure_text(text: *const u8) -> u32 {
    return sotlas_measure_text(text);
}

pub fn bakenfx_draw_text(x: u32, y: u32, text: *const u8, rgb: u32, alpha: u8) -> void {
    Canvas_draw_text(sotlas_get_default_canvas(), text, x as i32, y as i32, 1, paint_fill(bakenfx_color(rgb, alpha)));
}

// Adaptadores temporários para as telas ainda imperativas. Mantêm o desenho
// no Canvas BakenFX, sem expor o backend de pixels aos aplicativos.
pub fn bakenfx_draw_text_alpha(x: u32, y: u32, text: *const u8, rgb: u32, scale: u32, alpha: u8) -> void {
    Canvas_draw_text(sotlas_get_default_canvas(), text, x as i32, y as i32, scale, paint_fill(bakenfx_color(rgb, alpha)));
}

pub fn bakenfx_draw_circle(x: u32, y: u32, radius: u32, rgb: u32, alpha: u8) -> void {
    Canvas_draw_circle(sotlas_get_default_canvas(), x as i32, y as i32, radius, paint_fill(bakenfx_color(rgb, alpha)));
}

pub fn bakenfx_draw_icon(icon_id: u32, x: u32, y: u32, size: u32, rgb: u32, alpha: u8) -> void {
    let target = rect_make(x as i32, y as i32, size, size);
    Canvas_draw_vector_icon(sotlas_get_default_canvas(), icon_id, size, target, paint_fill(bakenfx_color(rgb, alpha)));
}

// Garante área de interação adequada mesmo para ícones visualmente compactos.
pub fn bakenfx_hit_target_size(visual_size: u32) -> u32 {
    return if visual_size < BAKEN_MIN_HIT_TARGET { BAKEN_MIN_HIT_TARGET } else { visual_size };
}

pub fn bakenfx_draw_rect(x: u32, y: u32, width: u32, height: u32, rgb: u32, alpha: u8) -> void {
    Canvas_draw_rect(sotlas_get_default_canvas(), rect_make(x as i32, y as i32, width, height), paint_fill(bakenfx_color(rgb, alpha)));
}

pub fn bakenfx_fill_rect_alpha(x: u32, y: u32, width: u32, height: u32, rgb: u32, alpha: u8) -> void {
    bakenfx_draw_rect(x, y, width, height, rgb, alpha);
}

pub fn bakenfx_fill_rect(x: u32, y: u32, width: u32, height: u32, rgb: u32) -> void {
    bakenfx_draw_rect(x, y, width, height, rgb, 255);
}

pub fn bakenfx_draw_hline(x: u32, y: u32, width: u32, rgb: u32, alpha: u8) -> void {
    bakenfx_draw_rect(x, y, width, 1, rgb, alpha);
}

pub fn bakenfx_draw_panel(x: u32, y: u32, width: u32, height: u32, rgb: u32, alpha: u8, border_rgb: u32, radius: u32) -> void {
    bakenfx_draw_elevated_panel(x, y, width, height, rgb, alpha, border_rgb, radius, 2);
}

pub fn bakenfx_draw_elevated_panel(x: u32, y: u32, width: u32, height: u32, rgb: u32, alpha: u8, border_rgb: u32, radius: u32, elevation: u32) -> void {
    let safe_elevation = if elevation > 5 { 5 } else { elevation };
    let shadow_alpha = (38 + safe_elevation * 18) as u8;
    let shadow_blur = BAKEN_SPACE_1 + safe_elevation * BAKEN_SPACE_1;
    let shadow_offset = if safe_elevation > 0 { safe_elevation as i32 + 1 } else { 0 };
    bakenfx_draw_material(
        sotlas_get_default_canvas(), rect_make(x as i32, y as i32, width, height),
        BAKENFX_MATERIAL_GLASS, bakenfx_color(rgb, alpha),
        bakenfx_color(border_rgb, 150), 1, radius,
        bakenfx_color(0x000000, shadow_alpha), shadow_blur, shadow_offset, true
    );
}

// Fundo oficial estático. A composição é vetorial e determinística: não há
// simulação, ruído, parallax ou geração de imagem durante a sessão.
// Papel de parede dinâmico estilo macOS Tahoe com deriva harmônica e renderização por scanline contínuo.
// Renderiza em uma única passagem sequencial ultrarrápida de memória contígua (menos de 2ms).
@system
pub fn bakenfx_draw_live_aurora_background(canvas: *mut Canvas, width: u32, height: u32, tick: u32) -> void {
    if canvas == (null as *mut Canvas) || width == 0 || height == 0 { return; }
    unsafe {
        let buf = display_get_backbuffer();
        let pitch = display_get_pitch();
        if buf == (null as *mut u32) || pitch == 0 { return; }

        let wave_phase = ((tick / 2) % 256) as u32;

        // 4 Polos harmônicos de cor da Aurora macOS Tahoe Light Edition:
        // Top-Left (Azul Céu Límpido #38BDF8), Bottom-Left (Ciano Suave #7DD3FC)
        // Top-Right (Lilás Pastel #C084FC), Bottom-Right (Rosa Pêssego Pastel #FDA4AF)
        let tl_r: i32 = 56;  let tl_g: i32 = 189; let tl_b: i32 = 248;
        let bl_r: i32 = 125; let bl_g: i32 = 211; let bl_b: i32 = 252;
        let tr_r: i32 = 192; let tr_g: i32 = 132; let tr_b: i32 = 252;
        let br_r: i32 = 253; let br_g: i32 = 164; let br_b: i32 = 175;

        let h_denom = if height > 1 { height - 1 } else { 1 };
        let w_denom = if width > 1 { width - 1 } else { 1 };

        for mut py in 0..height {
            let row_wave = anim_orbit_sin(((wave_phase + py / 12) % 256) as u32, 8);
            let eff_y = (py as i32 + row_wave);
            let safe_y = if eff_y < 0 { 0 } else if eff_y >= height as i32 { (height - 1) as u32 } else { eff_y as u32 };
            let ty = (safe_y * 255) / h_denom;

            let left_r = ((tl_r * (255 - ty as i32) + bl_r * ty as i32) / 255) as u32;
            let left_g = ((tl_g * (255 - ty as i32) + bl_g * ty as i32) / 255) as u32;
            let left_b = ((tl_b * (255 - ty as i32) + bl_b * ty as i32) / 255) as u32;

            let right_r = ((tr_r * (255 - ty as i32) + br_r * ty as i32) / 255) as u32;
            let right_g = ((tr_g * (255 - ty as i32) + br_g * ty as i32) / 255) as u32;
            let right_b = ((tr_b * (255 - ty as i32) + br_b * ty as i32) / 255) as u32;

            let mut row_ptr = buf.add((py * pitch) as usize);
            for mut px in 0..width {
                let tx = (px * 255) / w_denom;
                let cur_r = (left_r * (255 - tx) + right_r * tx) / 255;
                let cur_g = (left_g * (255 - tx) + right_g * tx) / 255;
                let cur_b = (left_b * (255 - tx) + right_b * tx) / 255;
                *(row_ptr) = 0xFF000000 | (cur_r << 16) | (cur_g << 8) | cur_b;
                row_ptr = row_ptr.add(1);
            }
        }
    }
}

@system
pub fn bakenfx_draw_desktop_background(canvas: *mut Canvas, width: u32, height: u32) -> void {
    if canvas == (null as *mut Canvas) || width == 0 || height == 0 { return; }
    let mut phase: u32 = 0;
    unsafe {
        BAKENFX_BACKGROUND_REMAINDER += BAKENFX_FRAME_DELTA * 60.0;
        let advance = BAKENFX_BACKGROUND_REMAINDER as u32;
        BAKENFX_BACKGROUND_REMAINDER -= advance as f32;
        BAKENFX_BACKGROUND_TICK = (BAKENFX_BACKGROUND_TICK + advance) % 1440;
        phase = BAKENFX_BACKGROUND_TICK;

        // Cache de wallpaper: as ondas harmônicas mudam lentamente, então
        // dividimos a fase por 8 para re-renderizar apenas ~7 vezes/s.
        // Isso elimina ~87% das composições de gradiente sem perda visual.
        let quantized_phase = phase / 8;
        if quantized_phase == BAKENFX_WALLPAPER_LAST_PHASE && !BAKENFX_WALLPAPER_DIRTY {
            // Wallpaper inalterado: copia o cache (backbuffer anterior) sem recompor.
            // A captura de backdrop (bakenfx_capture_backdrop) já conserva o snapshot.
            let cached = display_get_composition_scratch();
            let target = display_get_backbuffer();
            let total = (display_get_pitch() * display_get_height()) as usize;
            if cached != (null as *mut u32) && target != (null as *mut u32) && BAKENFX_BACKDROP_READY {
                for mut i in 0..total { *(target.add(i)) = *(cached.add(i)); }
                return;
            }
        }
        BAKENFX_WALLPAPER_LAST_PHASE = quantized_phase;
        BAKENFX_WALLPAPER_DIRTY = false;
    }
    // Camadas de cores luminosas e vibrantes para o Tema Claro
    let cyan_a = (88 + anim_wave_i32(phase, 480, 22)) as u8;
    let violet_a = (82 + anim_wave_i32(phase + 160, 600, 20)) as u8;
    let amber_a = (54 + anim_wave_i32(phase + 320, 720, 16)) as u8;
    Canvas_clear(canvas, color_rgb(241, 245, 249));
    Canvas_draw_linear_gradient(canvas, rect_make(0, 0, width, height),
        linear_gradient_make(color_rgb(219, 234, 254), color_rgb(243, 232, 255), true));
    Canvas_draw_linear_gradient(canvas, rect_make(0, 0, width, height),
        linear_gradient_make(color_rgba(56, 189, 248, cyan_a), color_rgba(192, 132, 252, violet_a), false));
    Canvas_draw_linear_gradient(canvas, rect_make(0, 0, width, height),
        linear_gradient_make(color_rgba(125, 211, 252, 60), color_rgba(254, 205, 211, amber_a), true));
    // Marca backdrop como stale para forçar recaptura após novo wallpaper.
    unsafe { BAKENFX_BACKDROP_READY = false; }
}

// Dupla camada de sombras físicas estilo Apple:
// 1. Camada de Contato / Oclusão Ambiental (AO): sombra curta que ancora o elemento
// 2. Camada de Luz Chave Zenital (Key Light): sombra difusa ampla e suave
@system
pub fn bakenfx_draw_shadow(canvas: *mut Canvas, bounds: Rect, radius: u32, color: Color, blur: u32, offset_y: i32) -> void {
    if canvas == (null as *mut Canvas) || color.a == 0 || blur == 0 { return; }
    if bounds.width == 0 || bounds.height == 0 { return; }

    let safe_blur = if blur > 24 { 24 } else { blur };
    let base_alpha = (color.a as f32) / 255.0;
    let area = bounds.width * bounds.height;

    // Otimização: painéis pequenos (<15000 px²) usam apenas a camada Key Light.
    // A camada AO é imperceptível em botões e chips, mas custa ~50% do tempo.
    if area >= 15000 {
        // 1. Camada AO de contato (apenas para painéis maiores)
        let ao_blur: u32 = 4;
        let ao_offset: i32 = if offset_y > 0 { 2 } else { 0 };
        let ao_alpha: f32 = base_alpha * 0.45;
        raster_draw_drop_shadow_rounded(
            bounds.x as u32,
            bounds.y as u32,
            bounds.width,
            bounds.height,
            radius,
            ao_blur,
            2,
            ao_offset,
            ao_alpha
        );
    }

    // 2. Camada de Luz Chave Zenital
    let key_alpha: f32 = base_alpha * 0.70;
    raster_draw_drop_shadow_rounded(
        bounds.x as u32,
        bounds.y as u32,
        bounds.width,
        bounds.height,
        radius,
        safe_blur,
        2,
        offset_y,
        key_alpha
    );
}

// Borda Especular Chanfrada de 1px (Zenithal Specular Rim Light) estilo macOS
@system
pub fn bakenfx_draw_specular_rim(canvas: *mut Canvas, bounds: Rect, radius: u32, squircle: bool, top_alpha: u8, bottom_alpha: u8) -> void {
    if canvas == (null as *mut Canvas) || bounds.width < 4 || bounds.height < 4 { return; }
    unsafe {
        let buf = display_get_backbuffer();
        let pitch = display_get_pitch();
        let sw = display_get_width();
        let sh = display_get_height();
        if buf == (null as *mut u32) || pitch == 0 { return; }

        let x0 = if bounds.x < 0 { 0 } else { bounds.x as u32 };
        let y0 = if bounds.y < 0 { 0 } else { bounds.y as u32 };
        let x1 = if (bounds.x + bounds.width as i32) > (sw as i32) { sw } else { (bounds.x + bounds.width as i32) as u32 };
        let y1 = if (bounds.y + bounds.height as i32) > (sh as i32) { sh } else { (bounds.y + bounds.height as i32) as u32 };
        if x0 >= x1 || y0 >= y1 { return; }

        let rim_rad = if radius > 4 { radius } else { 2 };
        let w_eff = if (x1 - x0) > rim_rad * 2 { (x1 - x0) - rim_rad * 2 } else { (x1 - x0) };
        let start_x = x0 + rim_rad;

        // Borda superior: reflexo zenital mais intenso de 1px
        if y0 < sh {
            raster_fill_rect_alpha(start_x, y0, w_eff, 1, 0x00FFFFFF, top_alpha);
        }
        // Borda inferior: contato sutil de 1px
        if y1 > 0 && (y1 - 1) < sh {
            raster_fill_rect_alpha(start_x, y1 - 1, w_eff, 1, 0x00FFFFFF, bottom_alpha);
        }
    }
}

// Material central do design system. A translucidez pertence ao material,
// enquanto a árvore de renderização continua dona do layout e da ordem.
pub fn bakenfx_draw_material(canvas: *mut Canvas, bounds: Rect, kind: u32, tint: Color, border: Color, border_width: u32, radius: u32, shadow: Color, shadow_blur: u32, shadow_offset_y: i32, squircle: bool) -> void {
    if canvas == (null as *mut Canvas) { return; }

    if kind == BAKENFX_MATERIAL_GLASS || kind == BAKENFX_MATERIAL_ACRYLIC {
        // Otimização: painéis com área < 20000 px² (botões, chips, toggles)
        // não se beneficiam visualmente do blur backdrop. O skip economiza
        // ~2ms por painel em QEMU.
        let panel_area = bounds.width * bounds.height;
        if panel_area >= 20000 {
            bakenfx_blur_backdrop(bounds, if kind == BAKENFX_MATERIAL_ACRYLIC { 6 } else { 3 });
        }
    }
    bakenfx_draw_shadow(canvas, bounds, radius, shadow, shadow_blur, shadow_offset_y);
    let fill = paint_fill(tint);
    if squircle {
        Canvas_draw_squircle(canvas, bounds, radius, fill);
    } else if radius > 0 {
        Canvas_draw_round_rect(canvas, bounds, radius, fill);
    } else {
        Canvas_draw_rect(canvas, bounds, fill);
    }

    if border_width > 0 && border.a > 0 {
        let stroke = paint_stroke(border, border_width);
        if squircle {
            Canvas_draw_squircle(canvas, bounds, radius, stroke);
        } else if radius > 0 {
            Canvas_draw_round_rect(canvas, bounds, radius, stroke);
        } else {
            Canvas_draw_rect(canvas, bounds, stroke);
        }
    }

    // Aplicação do chanfro especular zenital de 1px em materiais de vidro
    if kind == BAKENFX_MATERIAL_GLASS || kind == BAKENFX_MATERIAL_ACRYLIC {
        bakenfx_draw_specular_rim(canvas, bounds, radius, squircle, 90, 20);
    }
}

// =============================================================================
// 2. RENDERIZADOR PREMIUM DE PAINÉIS FLUIDOS COM DESLOCAMENTO FÍSICO
// =============================================================================

@system
pub fn bakenfx_draw_premium_panel(
    state: *const AnimState,
    base_x: u32,
    base_y: u32,
    width: u32,
    height: u32,
    rgb: u32,
    alpha: u8,
    border_rgb: u32,
    radius: u32,
    elevation: u32,
    curve_type: u32
) -> void {
    let y_offset = if state != (null as *const AnimState) {
        unsafe { (*state).current_val as i32 }
    } else {
        0
    };

    let animated_y = base_y as i32 + y_offset;
    let bounding_rect = rect_make(base_x as i32, animated_y, width, height);

    bakenfx_blur_backdrop_separable(bounding_rect, radius);

    let safe_elevation = if elevation > 5 { 5 } else { elevation };
    let shadow_alpha = (16 + safe_elevation * 10) as u8;
    let shadow_blur = (radius * 2) + safe_elevation * BAKEN_SPACE_2;
    let shadow_offset = (safe_elevation * 2) as i32;
    let is_squircle = (curve_type == BAKENFX_CORNER_CURVE_CONTINUOUS);

    bakenfx_draw_material(
        sotlas_get_default_canvas(),
        bounding_rect,
        BAKENFX_MATERIAL_GLASS,
        bakenfx_color(rgb, alpha),
        bakenfx_color(border_rgb, 120),
        1,
        radius,
        bakenfx_color(0x00000000, shadow_alpha),
        shadow_blur,
        shadow_offset,
        is_squircle
    );
}

// =============================================================================
// 3. INFRAESTRUTURA DO CURSOR MAGNÉTICO (MAGNETIC ATTRACTION & MORPHING)
// =============================================================================

pub struct MagneticCursorState {
    pub anim_x: AnimState;
    pub anim_y: AnimState;
    pub anim_scale: AnimState;
    pub is_locked: bool;
    pub target_id: u32;
}

@system
pub fn bakenfx_magnetic_cursor_init(state: *mut MagneticCursorState) -> void {
    if state == (null as *mut MagneticCursorState) { return; }
    unsafe {
        bakenfx_anim_init(&mut (*state).anim_x);
        bakenfx_anim_init(&mut (*state).anim_y);
        bakenfx_anim_init(&mut (*state).anim_scale);

        bakenfx_anim_configure_material(&mut (*state).anim_x, 3);
        bakenfx_anim_configure_material(&mut (*state).anim_y, 3);
        bakenfx_anim_configure_material(&mut (*state).anim_scale, 1);

        (*state).anim_scale.current_val = 1.0;
        (*state).anim_scale.target_val = 1.0;
        (*state).is_locked = false;
        (*state).target_id = 0;
    }
}

@system
pub fn bakenfx_magnetic_cursor_tick(state: *mut MagneticCursorState, delta_time: f32) -> void {
    if state == (null as *mut MagneticCursorState) { return; }
    unsafe {
        bakenfx_tick_spring_physics(&mut (*state).anim_x, delta_time);
        bakenfx_tick_spring_physics(&mut (*state).anim_y, delta_time);
        bakenfx_tick_spring_physics(&mut (*state).anim_scale, delta_time);
    }
}

@system
pub fn bakenfx_cursor_update_pointer(state: *mut MagneticCursorState, mouse_x: f32, mouse_y: f32, hit_bounds: Rect, is_interactive: bool, element_id: u32) -> void {
    if state == (null as *mut MagneticCursorState) { return; }
    unsafe {
        if is_interactive {
            let center_x = (hit_bounds.x as f32) + ((hit_bounds.width as f32) * 0.5);
            let center_y = (hit_bounds.y as f32) + ((hit_bounds.height as f32) * 0.5);
            // Atração magnética: 35% de atração em direção ao centro do botão
            let magnetic_target_x = center_x + (mouse_x - center_x) * 0.35;
            let magnetic_target_y = center_y + (mouse_y - center_y) * 0.35;
            bakenfx_interrupt_and_redirect(&mut (*state).anim_x, magnetic_target_x);
            bakenfx_interrupt_and_redirect(&mut (*state).anim_y, magnetic_target_y);
            bakenfx_interrupt_and_redirect(&mut (*state).anim_scale, 1.15);
            (*state).is_locked = true;
            (*state).target_id = element_id;
        } else {
            bakenfx_interrupt_and_redirect(&mut (*state).anim_x, mouse_x);
            bakenfx_interrupt_and_redirect(&mut (*state).anim_y, mouse_y);
            bakenfx_interrupt_and_redirect(&mut (*state).anim_scale, 1.0);
            (*state).is_locked = false;
            (*state).target_id = 0;
        }
    }
}

@system
pub fn bakenfx_draw_magnetic_cursor(state: *const MagneticCursorState) -> void {
    if state == (null as *const MagneticCursorState) { return; }
    unsafe {
        let px = (*state).anim_x.current_val as i32;
        let py = (*state).anim_y.current_val as i32;
        let scale = (*state).anim_scale.current_val;
        let base_radius: f32 = if (*state).is_locked { 22.0 } else { 10.0 };
        let dynamic_radius = (base_radius * scale) as u32;

        if (*state).is_locked {
            // Efeito de fusão com a UI: anel translúcido de acento
            let cursor_bounds = rect_make(px - dynamic_radius as i32, py - dynamic_radius as i32, dynamic_radius * 2, dynamic_radius * 2);
            bakenfx_blur_backdrop_separable(cursor_bounds, 3);
            bakenfx_draw_material(
                sotlas_get_default_canvas(),
                cursor_bounds,
                BAKENFX_MATERIAL_ACRYLIC,
                bakenfx_color(0x00FFFFFF, 45),
                bakenfx_color(0x00FFFFFF, 120),
                1,
                dynamic_radius,
                bakenfx_color(0x00000000, 30),
                12,
                0,
                true
            );
        } else {
            baken_cursor_render(px, py, 0);
        }
    }
}

@system
pub fn bakenfx_hittest_rect(cursor: *mut MagneticCursorState, mouse_x: f32, mouse_y: f32, bounds: Rect, is_interactive: bool, element_id: u32) -> bool {
    bakenfx_cursor_update_pointer(cursor, mouse_x, mouse_y, bounds, is_interactive, element_id);
    return if cursor != (null as *mut MagneticCursorState) { unsafe { (*cursor).is_locked } } else { false };
}

// =============================================================================
// 4. BARRA DE PROGRESSO LÍQUIDA (DYNAMIC LIQUID PROGRESS)
// =============================================================================

pub struct LiquidProgressBarState {
    pub progress_spring: AnimState;
    pub wave_phase: u32;
}

@system
pub fn bakenfx_liquid_progress_init(state: *mut LiquidProgressBarState) -> void {
    if state == (null as *mut LiquidProgressBarState) { return; }
    unsafe {
        bakenfx_anim_init(&mut (*state).progress_spring);
        bakenfx_anim_configure_material(&mut (*state).progress_spring, 2);
        (*state).wave_phase = 0;
    }
}

@system
pub fn bakenfx_liquid_progress_set(state: *mut LiquidProgressBarState, ratio: f32) -> void {
    if state == (null as *mut LiquidProgressBarState) { return; }
    let clamped_ratio = if ratio < 0.0 { 0.0 } else if ratio > 1.0 { 1.0 } else { ratio };
    unsafe {
        bakenfx_interrupt_and_redirect(&mut (*state).progress_spring, clamped_ratio);
    }
}

@system
pub fn bakenfx_liquid_progress_tick(state: *mut LiquidProgressBarState, delta_time: f32) -> void {
    if state == (null as *mut LiquidProgressBarState) { return; }
    unsafe {
        bakenfx_tick_spring_physics(&mut (*state).progress_spring, delta_time);
        (*state).wave_phase = ((*state).wave_phase + 4) % 256;
    }
}

@system
pub fn bakenfx_draw_liquid_progress_bar(state: *mut LiquidProgressBarState, x: u32, y: u32, total_width: u32, height: u32, fill_rgb: u32, track_rgb: u32, alpha: u8) -> void {
    if state == (null as *mut LiquidProgressBarState) || total_width == 0 || height == 0 { return; }
    unsafe {
        let track_rect = rect_make(x as i32, y as i32, total_width, height);
        let corner_radius = height / 2;

        // 1. Trilho de Fundo da Barra (Track) com curvatura contínua G2
        bakenfx_draw_material(
            sotlas_get_default_canvas(),
            track_rect,
            BAKENFX_MATERIAL_GLASS,
            bakenfx_color(track_rgb, ((alpha as f32) * 0.35) as u8),
            bakenfx_color(0x00FFFFFF, 40),
            1,
            corner_radius,
            bakenfx_color(0x00000000, 0),
            0,
            0,
            true
        );

        // 2. Preenchimento Dinâmico Alimentado pela Mola Viscosa e Onda Harmônica
        let current_fill_ratio = (*state).progress_spring.current_val;
        let computed_fill_width = ((total_width as f32) * current_fill_ratio) as u32;

        if computed_fill_width > 0 {
            let wave_offset = if (*state).progress_spring.is_animating {
                anim_orbit_sin((*state).wave_phase, 3)
            } else {
                0
            };
            let eff_w = (computed_fill_width as i32 + wave_offset);
            let safe_fill_width = if eff_w < (corner_radius as i32) {
                corner_radius
            } else if eff_w > (total_width as i32) {
                total_width
            } else {
                eff_w as u32
            };

            let fill_rect = rect_make(x as i32, y as i32, safe_fill_width, height);
            bakenfx_blur_backdrop_separable(fill_rect, 2);
            bakenfx_draw_material(
                sotlas_get_default_canvas(),
                fill_rect,
                BAKENFX_MATERIAL_SOLID,
                bakenfx_color(fill_rgb, alpha),
                bakenfx_color(0x00FFFFFF, 180),
                1,
                corner_radius,
                bakenfx_color(fill_rgb, 70),
                BAKEN_SPACE_1,
                1,
                true
            );
        }
    }
}

// =============================================================================
// 5. CURVATURA CONTÍNUA ANALÍTICA G2 (LAMÉ SUPERELIPSE / SQUIRCLE VERDADEIRO)
// =============================================================================

@system
pub fn bakenfx_is_inside_squircle_g2(px: i32, py: i32, bounds: Rect, radius: u32) -> bool {
    let bx = bounds.x;
    let by = bounds.y;
    let bw = bounds.width as i32;
    let bh = bounds.height as i32;
    if px < bx || px >= bx + bw || py < by || py >= by + bh { return false; }
    let r = if radius > 0 { radius as i32 } else { 1 };
    let dx = if px < bx + r { (bx + r) - px } else if px > bx + bw - r { px - (bx + bw - r) } else { 0 };
    let dy = if py < by + r { (by + r) - py } else if py > by + bh - r { py - (by + bh - r) } else { 0 };
    if dx == 0 || dy == 0 { return true; }

    // Formulação da superelipse analítica de Lamé (dx/r)^4 + (dy/r)^4 <= 1 com aceleração contínua (kappa' = 0)
    let nx = (dx * 100) / r;
    let ny = (dy * 100) / r;
    let nx2 = (nx * nx) / 100;
    let ny2 = (ny * ny) / 100;
    let sum = (nx2 * nx2 + ny2 * ny2) / 100;
    return sum <= 10000;
}

// =============================================================================
// 6. ÁRVORE DE COMPOSIÇÃO RETIDA EM CAMADAS (BAKEN LAYER / ESTILO CALAYER)
// =============================================================================

pub struct BakenLayer {
    pub bounds: Rect;
    pub opacity: u8;
    pub is_visible: bool;
    pub is_dirty: bool;
    pub surface: Surface;
}

@system
pub fn bakenfx_layer_init(layer: *mut BakenLayer, bounds: Rect, buffer: *mut u32) -> void {
    if layer == (null as *mut BakenLayer) { return; }
    unsafe {
        (*layer).bounds = bounds;
        (*layer).opacity = 255;
        (*layer).is_visible = true;
        (*layer).is_dirty = true;
        (*layer).surface = Surface {
            buffer: buffer,
            width: bounds.width,
            height: bounds.height,
            pitch: bounds.width,
        };
    }
}

@system
pub fn bakenfx_layer_composite(layer: *const BakenLayer, dst_canvas: *mut Canvas) -> void {
    if layer == (null as *const BakenLayer) || dst_canvas == (null as *mut Canvas) { return; }
    unsafe {
        if !(*layer).is_visible || (*layer).opacity == 0 { return; }
        let src_buf = (*layer).surface.buffer;
        let dst_buf = display_get_backbuffer();
        let pitch = display_get_pitch();
        let sw = display_get_width();
        let sh = display_get_height();
        if src_buf == (null as *mut u32) || dst_buf == (null as *mut u32) { return; }

        let bounds = (*layer).bounds;
        let x0 = if bounds.x < 0 { 0 } else { bounds.x as u32 };
        let y0 = if bounds.y < 0 { 0 } else { bounds.y as u32 };
        let x1 = if (bounds.x + bounds.width as i32) > (sw as i32) { sw } else { (bounds.x + bounds.width as i32) as u32 };
        let y1 = if (bounds.y + bounds.height as i32) > (sh as i32) { sh } else { (bounds.y + bounds.height as i32) as u32 };
        if x0 >= x1 || y0 >= y1 { return; }

        let alpha = (*layer).opacity as u32;
        let layer_w = bounds.width;

        for mut py in y0..y1 {
            let src_y = py - y0;
            let dst_row = dst_buf.add((py * pitch) as usize);
            let src_row = src_buf.add((src_y * layer_w) as usize);

            for mut px in x0..x1 {
                let src_x = px - x0;
                let src_pixel = *(src_row.add(src_x as usize));
                let src_a = (((src_pixel >> 24) & 0xFF) * alpha) / 255;
                if src_a == 255 {
                    *(dst_row.add(px as usize)) = src_pixel;
                } else if src_a > 0 {
                    let dst_pixel = *(dst_row.add(px as usize));
                    let inv_a = 255 - src_a;
                    let r = (((src_pixel >> 16) & 0xFF) * src_a + ((dst_pixel >> 16) & 0xFF) * inv_a) / 255;
                    let g = (((src_pixel >> 8) & 0xFF) * src_a + ((dst_pixel >> 8) & 0xFF) * inv_a) / 255;
                    let b = ((src_pixel & 0xFF) * src_a + (dst_pixel & 0xFF) * inv_a) / 255;
                    *(dst_row.add(px as usize)) = 0xFF000000 | (r << 16) | (g << 8) | b;
                }
            }
        }
    }
}

// =============================================================================
// 7. EFEITO GENIE / DEFORMAÇÃO TRAPEZOIDAL PARABÓLICA DE JANELAS
// =============================================================================

@system
pub fn bakenfx_draw_genie_transform(
    src_surface: *const Surface,
    window_rect: Rect,
    dock_rect: Rect,
    progress: f32
) -> void {
    if src_surface == (null as *const Surface) { return; }
    let t = if progress < 0.0 { 0.0 } else if progress > 1.0 { 1.0 } else { progress };
    if t == 0.0 { return; }

    unsafe {
        let src_buf = (*src_surface).buffer;
        let dst_buf = display_get_backbuffer();
        let pitch = display_get_pitch();
        let sw = display_get_width() as i32;
        let sh = display_get_height() as i32;
        if src_buf == (null as *mut u32) || dst_buf == (null as *mut u32) { return; }

        let orig_w = window_rect.width as f32;
        let orig_h = window_rect.height as f32;
        let orig_x = window_rect.x as f32;
        let orig_y = window_rect.y as f32;

        let target_x = (dock_rect.x as f32) + ((dock_rect.width as f32) * 0.5);
        let target_y = dock_rect.y as f32;

        let num_rows = (orig_h * (1.0 - t * 0.85)) as u32;
        if num_rows == 0 { return; }

        for mut r in 0..num_rows {
            let row_norm = (r as f32) / (num_rows as f32);
            let src_y = ((row_norm * orig_h) as u32);
            if src_y >= (*src_surface).height { continue; }

            // Curvatura parabólica suave que afunila em direção ao Dock
            let curve = row_norm * row_norm;
            let current_w = orig_w * (1.0 - t) + (dock_rect.width as f32) * t * (1.0 - curve * 0.6);
            let current_cx = (orig_x + orig_w * 0.5) * (1.0 - t) + target_x * t;
            let current_x0 = (current_cx - current_w * 0.5) as i32;
            let current_y = (orig_y * (1.0 - t) + (target_y - (num_rows as f32 - r as f32)) * t) as i32;

            if current_y < 0 || current_y >= sh { continue; }

            let row_w = current_w as u32;
            if row_w == 0 { continue; }

            let dst_row = dst_buf.add((current_y as u32 * pitch) as usize);
            let src_row = src_buf.add((src_y * (*src_surface).pitch) as usize);

            for mut col in 0..row_w {
                let px = current_x0 + col as i32;
                if px >= 0 && px < sw {
                    let sample_x = ((col as f32 / current_w) * orig_w) as u32;
                    if sample_x < (*src_surface).width {
                        let pix = *(src_row.add(sample_x as usize));
                        *(dst_row.add(px as usize)) = pix;
                    }
                }
            }
        }
    }
}
