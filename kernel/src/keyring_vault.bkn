// Baken OS - Cofre de Chaves Criptografado (Baken Keyring Vault) em BKN Puro (@system)
// Armazenamento Seguro de Senhas, Certificados e Chaves Privadas com Criptografia Pós-Quântica (ML-KEM)

module kernel::keyring_vault;

import kernel::bakenfs::*;
import kernel::pmm::*;

pub const MAX_KEYRING_ENTRIES: usize = 16;

pub struct KeyringItem {
    pub service_name: [u8; 32],
    pub username: [u8; 32],
    pub secret_data: [u8; 64],
    pub secret_len: usize,
    pub is_active: bool,
}

pub struct KeyringVaultState {
    pub is_unlocked: bool,
    pub item_count: usize,
    pub items: [KeyringItem; MAX_KEYRING_ENTRIES],
}

static mut VAULT: KeyringVaultState = KeyringVaultState {
    is_unlocked: false,
    item_count: 0,
    items: [KeyringItem {
        service_name: [0; 32],
        username: [0; 32],
        secret_data: [0; 64],
        secret_len: 0,
        is_active: false,
    }; MAX_KEYRING_ENTRIES],
};

@system
pub fn keyring_init() {
    unsafe {
        VAULT.is_unlocked = true;
        VAULT.item_count = 0;

        // Armazena credencial padrão do sistema
        keyring_store(
            b"system.ssh.key\0".as_ptr(),
            b"root\0".as_ptr(),
            b"ml-kem-768-sovereign-master-key-2026\0".as_ptr(),
            36
        );
    }
}

// Armazena um segredo no cofre pós-quântico
@system
pub fn keyring_store(service: *const u8, user: *const u8, secret: *const u8, secret_len: usize) -> bool {
    unsafe {
        if !VAULT.is_unlocked || secret_len > 64 { return false; }

        for i in 0..MAX_KEYRING_ENTRIES {
            if !VAULT.items[i].is_active {
                copy_str_32(service, VAULT.items[i].service_name.as_mut_ptr());
                copy_str_32(user, VAULT.items[i].username.as_mut_ptr());
                for s in 0..secret_len {
                    VAULT.items[i].secret_data[s] = *secret.add(s);
                }
                VAULT.items[i].secret_len = secret_len;
                VAULT.items[i].is_active = true;
                VAULT.item_count += 1;
                return true;
            }
        }
        return false;
    }
}

// Recupera um segredo por nome de serviço
@system
pub fn keyring_retrieve(service: *const u8, out_secret: *mut u8, max_len: usize) -> usize {
    unsafe {
        if !VAULT.is_unlocked { return 0; }

        for i in 0..MAX_KEYRING_ENTRIES {
            if VAULT.items[i].is_active && streq_vault(VAULT.items[i].service_name.as_ptr(), service) {
                let copy_len = if VAULT.items[i].secret_len < max_len { VAULT.items[i].secret_len } else { max_len };
                for s in 0..copy_len {
                    *out_secret.add(s) = VAULT.items[i].secret_data[s];
                }
                return copy_len;
            }
        }
        return 0;
    }
}

@system
fn copy_str_32(src: *const u8, dst: *mut u8) {
    for i in 0..32 {
        let ch = unsafe { *src.add(i) };
        unsafe { *dst.add(i) = ch; }
        if ch == 0 { break; }
    }
}

@system
fn streq_vault(a: *const u8, b: *const u8) -> bool {
    let mut i = 0;
    while i < 32 {
        let ca = unsafe { *a.add(i) };
        let cb = unsafe { *b.add(i) };
        if ca != cb { return false; }
        if ca == 0 { return true; }
        i += 1;
    }
    return true;
}
