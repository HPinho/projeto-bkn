// Baken OS - Rasterizador Vetorial SDF (Signed Distance Fields) em BKN Puro (@system)
// Subpixel Anti-Aliasing, Cantos Arredondados Perfeitos (Squircles), Sombras Suaves e Glassmorphism

module kernel::baken_rasterizer;

import kernel::graphics_engine::*;

// Funcao de distancia assinada para retangulo com cantos arredondados contínuos
@system
pub fn sdf_box_distance(px: f32, py: f32, rx: f32, ry: f32, rw: f32, rh: f32, radius: f32) -> f32 {
    let half_w = rw * 0.5;
    let half_h = rh * 0.5;
    let cx = rx + half_w;
    let cy = ry + half_h;

    let dx = (px - cx).abs() - (half_w - radius);
    let dy = (py - cy).abs() - (half_h - radius);

    let ax = if dx > 0.0 { dx } else { 0.0 };
    let ay = if dy > 0.0 { dy } else { 0.0 };
    let outside_dist = (ax * ax + ay * ay).sqrt();

    let inside_dist = if dx > dy {
        if dx < 0.0 { dx } else { 0.0 }
    } else {
        if dy < 0.0 { dy } else { 0.0 }
    };

    return outside_dist + inside_dist - radius;
}

// Funcao de cobertura subpixel antialiased atraves de Smoothstep no SDF
@system
pub fn sdf_coverage(dist: f32, edge_softness: f32) -> f32 {
    if dist < -edge_softness {
        return 1.0;
    }
    if dist > edge_softness {
        return 0.0;
    }
    let t = (dist + edge_softness) / (2.0 * edge_softness);
    return 1.0 - (t * t * (3.0 - 2.0 * t)); // Hermite Interpolation (Smoothstep)
}

// Renderiza cartao de vidro fosco com cantos perfeitos e borda antialiasada
@system
pub fn sdf_render_smooth_card(
    x: u32, y: u32, w: u32, h: u32,
    radius: u32,
    bg_color: u32,
    bg_alpha: u8,
    border_color: u32,
    border_width: f32
) {
    let rx = x as f32;
    let ry = y as f32;
    let rw = w as f32;
    let rh = h as f32;
    let rad = radius as f32;

    for py in y..(y + h) {
        for px in x..(x + w) {
            let dist = sdf_box_distance(px as f32 + 0.5, py as f32 + 0.5, rx, ry, rw, rh, rad);

            // Antialiasing da borda externa
            let alpha_factor = sdf_coverage(dist, 0.8);
            if alpha_factor > 0.01 {
                // Checa se esta na regiao da borda interna
                if dist > -border_width {
                    let border_factor = (dist + border_width) / border_width;
                    let blend_alpha = ((bg_alpha as f32) * (1.0 - border_factor) + 220.0 * border_factor) * alpha_factor;
                    gfx_put_pixel_alpha(px, py, border_color, blend_alpha as u8);
                } else {
                    let final_alpha = (bg_alpha as f32 * alpha_factor) as u8;
                    gfx_put_pixel_alpha(px, py, bg_color, final_alpha);
                }
            }
        }
    }
}

// Renderiza circulo com gradiente radial e borda SDF suave
@system
pub fn sdf_render_circle(cx: u32, cy: u32, radius: u32, color: u32, alpha: u8) {
    let r_f = radius as f32;
    let r_sq = radius * radius;
    let min_x = if cx > radius + 1 { cx - radius - 1 } else { 0 };
    let min_y = if cy > radius + 1 { cy - radius - 1 } else { 0 };
    let max_x = cx + radius + 1;
    let max_y = cy + radius + 1;

    for py in min_y..=max_y {
        for px in min_x..=max_x {
            let dx = (px as f32) - (cx as f32);
            let dy = (py as f32) - (cy as f32);
            let dist = (dx * dx + dy * dy).sqrt() - r_f;

            let coverage = sdf_coverage(dist, 0.75);
            if coverage > 0.01 {
                let final_alpha = ((alpha as f32) * coverage) as u8;
                gfx_put_pixel_alpha(px, py, color, final_alpha);
            }
        }
    }
}

// Fast Kawase Blur de 2 passes para efeito real de Acrylic/Frosted Glass
@system
pub fn sdf_kawase_blur(fb: *mut u32, pitch: u32, x: u32, y: u32, w: u32, h: u32, iteration: u32) {
    unsafe {
        let offset = iteration + 1;
        for py in (y + offset)..(y + h - offset) {
            for px in (x + offset)..(x + w - offset) {
                // Amostra 4 cantos diagonais
                let p1 = *fb.add(((py - offset) * pitch + (px - offset)) as usize);
                let p2 = *fb.add(((py - offset) * pitch + (px + offset)) as usize);
                let p3 = *fb.add(((py + offset) * pitch + (px - offset)) as usize);
                let p4 = *fb.add(((py + offset) * pitch + (px + offset)) as usize);

                let r = (((p1 >> 16) & 0xFF) + ((p2 >> 16) & 0xFF) + ((p3 >> 16) & 0xFF) + ((p4 >> 16) & 0xFF)) / 4;
                let g = (((p1 >> 8) & 0xFF)  + ((p2 >> 8) & 0xFF)  + ((p3 >> 8) & 0xFF)  + ((p4 >> 8) & 0xFF)) / 4;
                let b = ((p1 & 0xFF)         + (p2 & 0xFF)         + (p3 & 0xFF)         + (p4 & 0xFF)) / 4;

                let blurred = (r << 16) | (g << 8) | b;
                *fb.add((py * pitch + px) as usize) = blurred;
            }
        }
    }
}
