// Baken OS - Driver NVMe PCIe em BKN Puro (@system)
// Filas de Submissao (SQ) e Conclusao (CQ) com DMA de Copia Zero para BakenFS

module kernel::nvme;

import kernel::pmm::*;

pub const NVME_ADMIN_QUEUE_SIZE: usize = 64;
pub const NVME_IO_QUEUE_SIZE: usize = 256;
pub const NVME_BLOCK_SIZE: usize = 4096;

pub const NVME_OP_ADMIN_CREATE_IO_CQ: u8 = 0x05;
pub const NVME_OP_ADMIN_CREATE_IO_SQ: u8 = 0x01;
pub const NVME_OP_ADMIN_IDENTIFY: u8 = 0x06;

pub const NVME_OP_IO_WRITE: u8 = 0x01;
pub const NVME_OP_IO_READ: u8 = 0x02;

pub struct NvmeSqEntry {
    pub opcode: u8,
    pub flags: u8,
    pub command_id: u16,
    pub nsid: u32,
    pub reserved: u64,
    pub mptr: u64,
    pub prp1: u64, // Endereco fisico do buffer DMA (alocado no PMM)
    pub prp2: u64,
    pub cdw10: u32, // LBA Inicial (Low 32 bits)
    pub cdw11: u32, // LBA Inicial (High 32 bits)
    pub cdw12: u32, // Quantidade de Blocos - 1
    pub cdw13: u32,
    pub cdw14: u32,
    pub cdw15: u32,
}

pub struct NvmeCqEntry {
    pub command_specific: u32,
    pub reserved: u32,
    pub sq_head: u16,
    pub sq_id: u16,
    pub command_id: u16,
    pub status: u16, // Bit 0: Phase Tag, Bits 1..15: Status Code
}

pub struct NvmeController {
    pub bar0_base: *mut u32,
    pub admin_sq_phys: u64,
    pub admin_cq_phys: u64,
    pub io_sq_phys: u64,
    pub io_cq_phys: u64,
    pub admin_sq: *mut NvmeSqEntry,
    pub admin_cq: *mut NvmeCqEntry,
    pub io_sq: *mut NvmeSqEntry,
    pub io_cq: *mut NvmeCqEntry,
    pub admin_sq_tail: u16,
    pub io_sq_tail: u16,
    pub io_cq_head: u16,
    pub phase_tag: u8,
    pub is_initialized: bool,
    pub total_sectors: u64,
}

static mut NVME: NvmeController = NvmeController {
    bar0_base: 0 as *mut u32,
    admin_sq_phys: 0,
    admin_cq_phys: 0,
    io_sq_phys: 0,
    io_cq_phys: 0,
    admin_sq: 0 as *mut NvmeSqEntry,
    admin_cq: 0 as *mut NvmeCqEntry,
    io_sq: 0 as *mut NvmeSqEntry,
    io_cq: 0 as *mut NvmeCqEntry,
    admin_sq_tail: 0,
    io_sq_tail: 0,
    io_cq_head: 0,
    phase_tag: 1,
    is_initialized: false,
    total_sectors: 2097152, // 1GB em blocos de 512B / 4KB
};

@system
pub fn nvme_init(pci_bar0_phys: u64) {
    unsafe {
        NVME.bar0_base = pci_bar0_phys as *mut u32;

        // 1. Aloca memoria fisica contigua para as filas Admin (PMM Order 0 = 4KB)
        let asq_page = pmm_alloc_pages(0);
        let acq_page = pmm_alloc_pages(0);
        NVME.admin_sq_phys = asq_page as u64;
        NVME.admin_cq_phys = acq_page as u64;
        NVME.admin_sq = asq_page as *mut NvmeSqEntry;
        NVME.admin_cq = acq_page as *mut NvmeCqEntry;

        // 2. Aloca memoria fisica para as filas de I/O de alta velocidade
        let iosq_page = pmm_alloc_pages(0);
        let iocq_page = pmm_alloc_pages(0);
        NVME.io_sq_phys = iosq_page as u64;
        NVME.io_cq_phys = iocq_page as u64;
        NVME.io_sq = iosq_page as *mut NvmeSqEntry;
        NVME.io_cq = iocq_page as *mut NvmeCqEntry;

        NVME.admin_sq_tail = 0;
        NVME.io_sq_tail = 0;
        NVME.io_cq_head = 0;
        NVME.phase_tag = 1;
        NVME.is_initialized = true;
    }
}

// Submissao de Leitura de Blocos DMA para o BakenFS
@system
pub fn nvme_read_blocks(lba: u64, num_blocks: u32, phys_dest_buf: u64) -> bool {
    unsafe {
        if !NVME.is_initialized || num_blocks == 0 { return false; }

        let sqe = NVME.io_sq.add(NVME.io_sq_tail as usize);
        (*sqe).opcode = NVME_OP_IO_READ;
        (*sqe).flags = 0;
        (*sqe).command_id = NVME.io_sq_tail;
        (*sqe).nsid = 1; // Namespace 1 primario
        (*sqe).reserved = 0;
        (*sqe).mptr = 0;
        (*sqe).prp1 = phys_dest_buf;
        (*sqe).prp2 = 0;
        (*sqe).cdw10 = (lba & 0xFFFFFFFF) as u32;
        (*sqe).cdw11 = ((lba >> 32) & 0xFFFFFFFF) as u32;
        (*sqe).cdw12 = num_blocks - 1; // 0-based
        (*sqe).cdw13 = 0;
        (*sqe).cdw14 = 0;
        (*sqe).cdw15 = 0;

        // Atualiza Tail do Doorbell
        NVME.io_sq_tail = (NVME.io_sq_tail + 1) % (NVME_IO_QUEUE_SIZE as u16);
        return true;
    }
}

// Submissao de Escrita de Blocos DMA para o BakenFS
@system
pub fn nvme_write_blocks(lba: u64, num_blocks: u32, phys_src_buf: u64) -> bool {
    unsafe {
        if !NVME.is_initialized || num_blocks == 0 { return false; }

        let sqe = NVME.io_sq.add(NVME.io_sq_tail as usize);
        (*sqe).opcode = NVME_OP_IO_WRITE;
        (*sqe).flags = 0;
        (*sqe).command_id = NVME.io_sq_tail;
        (*sqe).nsid = 1;
        (*sqe).reserved = 0;
        (*sqe).mptr = 0;
        (*sqe).prp1 = phys_src_buf;
        (*sqe).prp2 = 0;
        (*sqe).cdw10 = (lba & 0xFFFFFFFF) as u32;
        (*sqe).cdw11 = ((lba >> 32) & 0xFFFFFFFF) as u32;
        (*sqe).cdw12 = num_blocks - 1;
        (*sqe).cdw13 = 0;
        (*sqe).cdw14 = 0;
        (*sqe).cdw15 = 0;

        NVME.io_sq_tail = (NVME.io_sq_tail + 1) % (NVME_IO_QUEUE_SIZE as u16);
        return true;
    }
}

@system
pub fn nvme_is_ready() -> bool {
    unsafe {
        return NVME.is_initialized;
    }
}
