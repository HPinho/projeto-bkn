// Baken OS - componentes de interface usados pela rota executavel.
// A implementacao permanece em Sotlas; o compilador apenas reduz a AST.

module kernel::baken_ui_oop;

import kernel::graphics_engine::*;
import kernel::baken_rasterizer::*;
import kernel::baken_animation::*;

pub const DOCK_MAX_ITEMS: usize = 10;

pub struct DesktopDock {
    pub y_offset: u32;
    pub icon_size: u32;
    pub item_count: u32;
    pub item_labels: [*const u8; DOCK_MAX_ITEMS];
    pub item_springs: [SpringState; DOCK_MAX_ITEMS];
    pub bounce_springs: [SpringState; DOCK_MAX_ITEMS];
}

pub struct BakenDockLayout {
    pub x: u32;
    pub y: u32;
    pub width: u32;
    pub height: u32;
    pub pitch: u32;
    pub icon: u32;
    pub pad: u32;
}

@system
pub fn baken_dock_layout(item_count: u32, out: *mut BakenDockLayout) -> void {
    if out == (null as *mut BakenDockLayout) { return; }
    unsafe {
        let sw = gfx_get_width();
        let sh = gfx_get_height();
        (*out).pitch = 50;
        (*out).height = 58;
        (*out).icon = 40;
        (*out).pad = 10;
        (*out).width = item_count * (*out).pitch + (*out).pad * 2;
        if (*out).width > sw { (*out).width = sw; }
        (*out).x = if sw > (*out).width { (sw - (*out).width) / 2 } else { 0 };
        (*out).y = if sh > (*out).height + 14 { sh - (*out).height - 14 } else { 0 };
    }
}

@system
pub fn dock_init(dock: *mut DesktopDock) -> void {
    if dock == (null as *mut DesktopDock) { return; }
    unsafe {
        (*dock).y_offset = 14;
        (*dock).icon_size = 40;
        (*dock).item_count = 0;
        for mut i in 0..DOCK_MAX_ITEMS {
            (*dock).item_labels[i] = null as *const u8;
            (*dock).item_springs[i] = SpringState {
                current_val: 1.0, target_val: 1.0, velocity: 0.0,
                stiffness: 150.0, damping: 10.0
            };
            (*dock).bounce_springs[i] = SpringState {
                current_val: 0.0, target_val: 0.0, velocity: 0.0,
                stiffness: 180.0, damping: 12.0
            };
        }
    }
}

@system
pub fn dock_add_item(dock: *mut DesktopDock, label: *const u8) -> void {
    if dock == (null as *mut DesktopDock) || label == (null as *const u8) { return; }
    unsafe {
        if (*dock).item_count >= DOCK_MAX_ITEMS as u32 { return; }
        let i = (*dock).item_count as usize;
        (*dock).item_labels[i] = label;
        (*dock).item_springs[i] = SpringState {
            current_val: 1.0, target_val: 1.0, velocity: 0.0,
            stiffness: 150.0, damping: 10.0
        };
        (*dock).bounce_springs[i] = SpringState {
            current_val: 0.0, target_val: 0.0, velocity: 0.0,
            stiffness: 180.0, damping: 12.0
        };
        (*dock).item_count += 1;
    }
}

@system
pub fn dock_trigger_bounce(dock: *mut DesktopDock, index: u32) -> void {
    if dock == (null as *mut DesktopDock) { return; }
    unsafe {
        if index >= (*dock).item_count { return; }
        (*dock).bounce_springs[index as usize].current_val = -6.0;
        (*dock).bounce_springs[index as usize].velocity = -50.0;
    }
}

@system
pub fn dock_update(dock: *mut DesktopDock, dt: f32, cursor_x: i32, cursor_y: i32) -> void {
    if dock == (null as *mut DesktopDock) { return; }
    unsafe {
        if (*dock).item_count == 0 { return; }
        let mut geo = BakenDockLayout { x: 0, y: 0, width: 0, height: 0, pitch: 0, icon: 0, pad: 0 };
        baken_dock_layout((*dock).item_count, &mut geo);
        let inside = cursor_x >= geo.x as i32 && cursor_x <= (geo.x + geo.width) as i32 &&
                     cursor_y >= geo.y as i32 && cursor_y <= (geo.y + geo.height) as i32;
        for mut i in 0..(*dock).item_count {
            let center = (geo.x + geo.pad + i * geo.pitch + geo.pitch / 2) as i32;
            (*dock).item_springs[i as usize].target_val = if inside {
                calculate_dock_magnify(cursor_x, center, 68)
            } else { 1.0 };
            spring_update(&mut (*dock).item_springs[i as usize], dt);
            spring_update(&mut (*dock).bounce_springs[i as usize], dt);
        }
    }
}

@system
pub fn dock_draw(dock: *const DesktopDock) -> void {
    if dock == (null as *const DesktopDock) { return; }
    unsafe {
        if (*dock).item_count == 0 { return; }
        let mut geo = BakenDockLayout { x: 0, y: 0, width: 0, height: 0, pitch: 0, icon: 0, pad: 0 };
        baken_dock_layout((*dock).item_count, &mut geo);
        gfx_draw_glass_rect(geo.x, geo.y, geo.width, geo.height, 0x00111A2E, 220, 0x44FFFFFF, geo.height / 2);
        for mut i in 0..(*dock).item_count {
            let scale = (*dock).item_springs[i as usize].current_val;
            let bounce = (*dock).bounce_springs[i as usize].current_val;
            let icon = ((geo.icon as f32) * scale) as u32;
            let base_x = geo.x + geo.pad + i * geo.pitch + (geo.pitch - geo.icon) / 2;
            let ix = base_x - (icon - geo.icon) / 2;
            let iy = ((geo.y + (geo.height - geo.icon) / 2 - (icon - geo.icon) / 2) as f32 + bounce) as u32;
            if scale > 1.02 {
                gfx_draw_circle_alpha(ix + icon / 2, iy + icon / 2, icon / 2 + 4, 0x00FFFFFF, 45);
            }
            gfx_draw_app_icon_hd(ix, iy, icon, i);
        }
    }
}
