// Baken OS - Gerenciador de Boot Gráfico e Menu de Recuperação em BKN Puro (@system)
// Seleção de Modos de Inicialização, Modo Seguro e Diagnóstico de Memória

module kernel::boot_manager;

import kernel::graphics_engine::*;
import kernel::baken_rasterizer::*;
import kernel::pmm::*;

pub enum BootMode {
    NormalDesktop = 0,
    RecoveryConsole = 1,
    SafeGraphicsMode = 2,
    MemoryDiagnostic = 3,
    RebootSystem = 4,
}

pub struct BootMenuState {
    pub selected_index: u8,
    pub timeout_seconds: u8,
    pub is_menu_active: bool,
    pub screen_w: u32,
    pub screen_h: u32,
}

static mut BOOT_MENU: BootMenuState = BootMenuState {
    selected_index: 0,
    timeout_seconds: 3,
    is_menu_active: false,
    screen_w: 1280,
    screen_h: 720,
};

static MENU_OPTIONS: [*const u8; 5] = [
    b"1. Iniciar Baken OS (Modo Normal Aero-Quantum 64-bit)\0".as_ptr(),
    b"2. Modo de Recuperacao (Console Puro Ring 0 / BakenFS)\0".as_ptr(),
    b"3. Modo Seguro Grafico (Fallback 1024x768)\0".as_ptr(),
    b"4. Diagnostico de Hardware & Teste de Memoria RAM\0".as_ptr(),
    b"5. Reiniciar o Computador (Reset ACPI)\0".as_ptr(),
];

@system
pub fn boot_manager_init(w: u32, h: u32) {
    unsafe {
        BOOT_MENU.screen_w = w;
        BOOT_MENU.screen_h = h;
        BOOT_MENU.selected_index = 0;
        BOOT_MENU.is_menu_active = false;
    }
}

// Renderiza o menu gráfico de opções de boot
@system
pub fn boot_manager_render() {
    unsafe {
        let sw = BOOT_MENU.screen_w;
        let sh = BOOT_MENU.screen_h;

        // Fundo com blur e acrílico
        gfx_draw_glass_rect(0, 0, sw, sh, 0x00060913, 255, 0x00000000, 0);

        let menu_w: u32 = 640;
        let menu_h: u32 = 380;
        let mx = (sw - menu_w) / 2;
        let my = (sh - menu_h) / 2;

        // Card do Menu de Boot com Sombras e Borda Ciano
        gfx_draw_drop_shadow(mx, my, menu_w, menu_h, 20, 3);
        sdf_render_smooth_card(mx, my, menu_w, menu_h, 14, 0x000B1021, 240, 0x0000E5FF, 1.2);

        // Cabeçalho do Menu
        gfx_draw_glass_rect(mx, my, menu_w, 48, 0x000F172A, 255, 0x0038BDF8, 14);
        gfx_draw_circle_button(mx + 24, my + 24, 7, 0x0000E5FF);
        gfx_draw_text(mx + 42, my + 16, b"BAKEN BOOT MANAGER - OPCOES DE INICIALIZACAO\0".as_ptr(), 0x00FFFFFF, 1);

        // Lista de Opções Selecionáveis
        let mut opt_y = my + 68;
        for i in 0..5 {
            let is_sel = (BOOT_MENU.selected_index == (i as u8));
            let bg_col = if is_sel { 0x001E293B } else { 0x00070B14 };
            let border_col = if is_sel { 0x0000E5FF } else { 0x001E293B };
            let text_col = if is_sel { 0x0038BDF8 } else { 0x00E2E8F0 };

            sdf_render_smooth_card(mx + 20, opt_y, menu_w - 40, 44, 8, bg_col, 220, border_col, 1.0);
            
            // Indicador de seta [>]
            if is_sel {
                gfx_draw_char(mx + 36, opt_y + 14, b'>', 0x0000E5FF, 1);
            }
            
            gfx_draw_text(mx + 54, opt_y + 14, MENU_OPTIONS[i], text_col, 1);
            opt_y += 52;
        }

        // Rodapé com instruções
        let footer_y = my + menu_h - 32;
        gfx_draw_text_alpha(mx + 24, footer_y, b"Use as setas [UP/DOWN] para navegar e [ENTER] para confirmar.\0".as_ptr(), 0x0094A3B8, 1, 200);

        gfx_swap_buffers();
    }
}

// Navegação do Menu de Boot pelo Teclado
@system
pub fn boot_manager_handle_key(key_scancode: u8) -> Option<BootMode> {
    unsafe {
        if key_scancode == 0x48 { // Up Arrow
            if BOOT_MENU.selected_index > 0 { BOOT_MENU.selected_index -= 1; }
        } else if key_scancode == 0x50 { // Down Arrow
            if BOOT_MENU.selected_index < 4 { BOOT_MENU.selected_index += 1; }
        } else if key_scancode == 0x1C { // Enter
            let mode = match BOOT_MENU.selected_index {
                1 => BootMode::RecoveryConsole,
                2 => BootMode::SafeGraphicsMode,
                3 => BootMode::MemoryDiagnostic,
                4 => BootMode::RebootSystem,
                _ => BootMode::NormalDesktop,
            };
            return Some(mode);
        }
        return None;
    }
}
