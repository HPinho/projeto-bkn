// Baken OS — Next-Gen Aurora Graphical Setup Wizard & OOBE
// 100% Implementado na linguagem Sotlas (@system) com Glassmorphism Real, i18n Multilingue e Zero Telemetria

module kernel::baken_installer;

import kernel::graphics_engine::*;
import kernel::baken_rasterizer::*;
import kernel::baken_oobe_screen::*;

pub const TOTAL_LANGUAGES: usize = 11;

pub struct InstallerState {
    pub step: u32;              // 0: Welcome, 1: Language/Keyboard, 2: Mode, 3: Disk, 4: Review, 5: Installing, 6: Complete, 7: Repair, 8: OOBE
    pub selected_lang: u32;     // 0..10 (PT, EN, FR, IT, ES, DE, EL, ZH, JA, HI, SW)
    pub selected_kb: u32;       // 0..10
    pub selected_mode: u32;     // 0: Instalar Definitivamente, 1: Live Demo
    pub selected_disk: u32;     // 0: NVMe SSD (Gravavel), 1: USB Live (Protegida)
    pub install_progress: u32;  // 0 a 100%
    pub install_substep: u32;   // 0 a 3
    pub anim_tick: u32;
    pub error: u32;
    pub oobe_step: u32;         // 0 a 6
    pub oobe_usage: u32;        // 0: Dev, 1: Gamer, 2: Produtividade
    pub oobe_diagnostics: u8;   // 0: Desativado (Privacidade Total)
    pub oobe_location: u8;      // 0: Desativado
}

static mut INSTALLER: InstallerState = InstallerState {
    step: 0,
    selected_lang: 0,
    selected_kb: 0,
    selected_mode: 0,
    selected_disk: 0,
    install_progress: 0,
    install_substep: 0,
    anim_tick: 0,
    error: 0,
    oobe_step: 0,
    oobe_usage: 0,
    oobe_diagnostics: 0,
    oobe_location: 0,
};

@system
pub fn baken_installer_init() -> void {
    unsafe {
        INSTALLER.step = 0;
        INSTALLER.selected_lang = 0;
        INSTALLER.selected_kb = 0;
        INSTALLER.selected_mode = 0;
        INSTALLER.selected_disk = 0;
        INSTALLER.install_progress = 0;
        INSTALLER.install_substep = 0;
        INSTALLER.anim_tick = 0;
        INSTALLER.error = 0;
        INSTALLER.oobe_step = 0;
        INSTALLER.oobe_usage = 0;
        INSTALLER.oobe_diagnostics = 0;
        INSTALLER.oobe_location = 0;
    }
    baken_oobe_init();
}

@inline
fn min_u32(a: u32, b: u32) -> u32 {
    if (a < b) { return a; }
    return b;
}

@inline
fn get_lang() -> usize {
    unsafe {
        let l = INSTALLER.selected_lang as usize;
        if (l >= TOTAL_LANGUAGES) { return 0; }
        return l;
    }
}

