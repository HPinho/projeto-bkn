        raster_draw_text_alpha(cx + 200, y + 112, STR_NATIVE_LANGS[lang_idx], 0x00FFFFFF, 1, 255);

        raster_draw_text_alpha(cx + 20, y + 142, "• Modo Selecionado:".as_ptr(), 0x0000E5FF, 1, 240);
        raster_draw_text_alpha(cx + 200, y + 142, "Instalacao Nativa GPT + BakenFS".as_ptr(), 0x00FFFFFF, 1, 255);

        raster_draw_text_alpha(cx + 20, y + 172, "• Unidade Destino:".as_ptr(), 0x0000E5FF, 1, 240);
        raster_draw_text_alpha(cx + 200, y + 172, "NVMe SSD Principal (512 GB)".as_ptr(), 0x0010B981, 1, 255);

        raster_draw_text_alpha(cx + 20, y + 202, "• Privacidade & Telemetria:".as_ptr(), 0x0000E5FF, 1, 240);
        raster_draw_text_alpha(cx + 200, y + 202, "Zero Telemetria (100% Offline e Privado)".as_ptr(), 0x0010B981, 1, 255);

        raster_draw_text_alpha(cx + 20, y + 232, "• Seguranca de Snapshots:".as_ptr(), 0x0000E5FF, 1, 240);
        raster_draw_text_alpha(cx + 200, y + 232, "Ativo (Ponto de restauracao inicial sera criado)".as_ptr(), 0x00F8FAFC, 1, 240);

        let bot_y = y + h - 68;
        draw_interactive_btn(cx, bot_y, 110, 38, STR_BTN_BACK[lang_idx], false, false);
        draw_interactive_btn(cx + cw - 180, bot_y, 180, 38, STR_BTN_INSTALL[lang_idx], true, true);
    }
}

// Tela 5: Progresso de Instalacao com Barra Neon, Bloom e Telemetria
@system
fn render_installing_progress(x: u32, y: u32, w: u32, h: u32) -> void {
    unsafe {
        let cx = if (w >= 760) { x + 258 } else { x + 24 };
        let cw = if (w >= 760) { w - 288 } else { w - 48 };

        // Emblema Central Pulsante
        let logo_cx = cx + (cw / 2);
        let logo_cy = y + 74;
        let pulse = 24 + ((raster_smoothstep_u8(INSTALLER.anim_tick % 60, 60) as u32 * 6) / 255);
        raster_draw_circle_alpha(logo_cx, logo_cy, pulse + 14, 0x000284C7, 35);
        raster_draw_circle_alpha(logo_cx, logo_cy, pulse + 4, 0x0000E5FF, 70);
        raster_draw_baken_logo(logo_cx - 30, logo_cy - 30, 60, 255);

        raster_draw_text_alpha(cx + (cw - 320) / 2, y + 128, "Gravando Baken OS no Armazenamento...".as_ptr(), 0x00FFFFFF, 1, 255);

        // Barra de Progresso com Bloom e Gradiente
        let pb_w = cw - 40;
        let pbx = cx + 20;
        let pby = y + 160;
        draw_specular_card(pbx, pby, pb_w, 14, 0x001E293B, 220, 0x00334155, 7);

        let prog_w = (pb_w * INSTALLER.install_progress) / 100;
        if (prog_w > 4) {
            raster_fill_rect_alpha(pbx + 2, pby + 2, prog_w - 4, 10, 0x0000E5FF, 255);
            // Ponta Neon Iluminada (Bloom Glow)
            raster_draw_circle_alpha(pbx + prog_w - 2, pby + 7, 7, 0x0038BDF8, 120);
            raster_draw_circle_alpha(pbx + prog_w - 2, pby + 7, 12, 0x0000E5FF, 45);
        }

        // Etapas de Telemetria Detalhada
        let substeps = [
            "1. Criando tabela de particoes GPT e volume ESP FAT32...".as_ptr(),
            "2. Formatando volume de dados BakenFS com suporte a snapshots...".as_ptr(),
            "3. Instalando microkernel Sotlas e drivers nativos UEFI...".as_ptr(),
            "4. Configurando ponto de restauracao inicial e finalizando...".as_ptr()
        ];

        for mut s in 0..4 {
            let sy = y + 200 + (s * 30);
            let is_s_done = ((s as u32) < INSTALLER.install_substep);
            let is_s_cur = ((s as u32) == INSTALLER.install_substep);
            let s_col = if (is_s_done) { 0x0010B981 } else if (is_s_cur) { 0x0000E5FF } else { 0x00475569 };

            raster_draw_circle_alpha(cx + 20, sy + 7, 4, s_col, 255);
            raster_draw_text_alpha(cx + 34, sy, substeps[s], if (is_s_cur) { 0x00FFFFFF } else { 0x0094A3B8 }, 1, 240);
        }
    }
}

// Tela 6: Conclusao e Boas-Vindas ao Desktop Baken OS
@system
fn render_complete_summary(x: u32, y: u32, w: u32, h: u32) -> void {
    unsafe {
        let lang_idx = get_lang();
        let cx = if (w >= 760) { x + 258 } else { x + 24 };
        let cw = if (w >= 760) { w - 288 } else { w - 48 };

        // Emblema com Anel Esmeralda de Sucesso
        let logo_cx = cx + (cw / 2);
        let logo_cy = y + 78;
        raster_draw_circle_alpha(logo_cx, logo_cy, 38, 0x0010B981, 240);
        raster_draw_circle_alpha(logo_cx, logo_cy, 48, 0x0010B981, 60);
        raster_draw_baken_logo(logo_cx - 24, logo_cy - 24, 48, 255);

        let t = "Tudo Pronto! Baken OS Instalado com Sucesso";
        let tw = raster_measure_text(t.as_ptr());
        raster_draw_text_alpha(cx + (if (cw > tw) { (cw - tw) / 2 } else { 10 }), y + 140, t.as_ptr(), 0x0010B981, 1, 255);

        let sub = "Seu ambiente nativo com BakenFS esta pronto para ser explorado.";
        let sw = raster_measure_text(sub.as_ptr());
        raster_draw_text_alpha(cx + (if (cw > sw) { (cw - sw) / 2 } else { 10 }), y + 168, sub.as_ptr(), 0x00E0F2FE, 1, 240);

        // Cartao Informativo de Status
        draw_specular_card(cx + 20, y + 204, cw - 40, 48, 0x001E293B, 220, 0x0010B981, 8);
        raster_draw_text_alpha(cx + 36, y + 218, "Privacidade: 100% Nativo Local  •  BakenFS: Protegido  •  Drivers: Carregados".as_ptr(), 0x0000E5FF, 1, 255);

        // Botao Principal Largo
        let bot_y = y + h - 68;
        let btn_w: u32 = 320;
        let btn_x = cx + (if (cw > btn_w) { (cw - btn_w) / 2 } else { 10 });
        draw_interactive_btn(btn_x, bot_y, btn_w, 44, STR_BTN_ENTER_DESKTOP[lang_idx], true, true);
    }
}

// Tela 7: Ferramentas de Reparo e Diagnostico
@system
fn render_repair_tools(x: u32, y: u32, w: u32, h: u32) -> void {
    unsafe {
        let lang_idx = get_lang();
        let cx = if (w >= 760) { x + 258 } else { x + 24 };
        let cw = if (w >= 760) { w - 288 } else { w - 48 };

        raster_draw_text_alpha(cx, y + 36, "Ambiente de Recuperacao e Diagnostico".as_ptr(), 0x00FFFFFF, 1, 255);
        raster_draw_text_alpha(cx, y + 60, "Ferramentas para restauracao do bootloader UEFI e integridade BakenFS.".as_ptr(), 0x0094A3B8, 1, 235);

        // Opcao 1: Reparar Bootloader
        draw_specular_card(cx, y + 96, cw, 60, 0x001E293B, 220, 0x0038BDF8, 8);
        raster_draw_circle_alpha(cx + 20, y + 126, 6, 0x0000E5FF, 255);
        raster_draw_text_alpha(cx + 36, y + 108, "[1] Reparar Bootloader UEFI (ESP / NVRAM)".as_ptr(), 0x00FFFFFF, 1, 255);
        raster_draw_text_alpha(cx + 36, y + 130, "Reescreve o arquivo BOOTX64.EFI na particao FAT32 do sistema.".as_ptr(), 0x0038BDF8, 1, 220);

        // Opcao 2: Restaurar Snapshot
        draw_specular_card(cx, y + 168, cw, 60, 0x001E293B, 220, 0x0038BDF8, 8);
        raster_draw_circle_alpha(cx + 20, y + 198, 6, 0x0010B981, 255);
        raster_draw_text_alpha(cx + 36, y + 180, "[2] Restaurar Snapshot Estavel do BakenFS".as_ptr(), 0x00FFFFFF, 1, 255);
        raster_draw_text_alpha(cx + 36, y + 202, "Reverte o estado do sistema operacional para o snapshot mais recente.".as_ptr(), 0x0010B981, 1, 220);

        let bot_y = y + h - 68;
        draw_interactive_btn(cx, bot_y, 110, 38, STR_BTN_BACK[lang_idx], false, false);
    }
}

// Tela 8: OOBE Personalizacao Integrada
@system
fn render_oobe_experience(x: u32, y: u32, w: u32, h: u32) -> void {
    unsafe {
        let lang_idx = get_lang();
        let cx = if (w >= 760) { x + 258 } else { x + 24 };
        let cw = if (w >= 760) { w - 288 } else { w - 48 };

        raster_draw_text_alpha(cx, y + 36, "Configuracao Inicial do Perfil de Uso (OOBE)".as_ptr(), 0x00FFFFFF, 1, 255);
        raster_draw_text_alpha(cx, y + 60, "Personalize seu ambiente de trabalho de acordo com suas necessidades.".as_ptr(), 0x0094A3B8, 1, 235);

        // 3 Perfis de Uso em Cartoes
        let p_names = [
            "• Desenvolvimento de Software & Sotlas SDK".as_ptr(),
            "• Jogos, Multimidia & Producao 3D".as_ptr(),
            "• Uso Pessoal, Navegacao & Escritorio".as_ptr()
        ];
        for mut i in 0..3 {
            let py = y + 96 + (i * 48);
            let is_sel = (INSTALLER.oobe_usage == (i as u32));
            draw_specular_card(cx, py, cw, 42, if (is_sel) { 0x000284C7 } else { 0x001E293B }, 220, if (is_sel) { 0x0000E5FF } else { 0x00334155 }, 8);
            raster_draw_circle_alpha(cx + 20, py + 21, 5, if (is_sel) { 0x0000E5FF } else { 0x0064748B }, 255);
            raster_draw_text_alpha(cx + 36, py + 12, p_names[i], if (is_sel) { 0x00FFFFFF } else { 0x00F8FAFC }, 1, 255);
        }

        let bot_y = y + h - 68;
        draw_interactive_btn(cx, bot_y, 110, 38, STR_BTN_BACK[lang_idx], false, false);
        draw_interactive_btn(cx + cw - 200, bot_y, 200, 38, STR_BTN_ENTER_DESKTOP[lang_idx], true, true);
    }
}

// Tick para avanco suave da instalacao
@system
pub fn baken_installer_tick() -> void {
    unsafe {
        if (INSTALLER.step != 5 || INSTALLER.error != 0) { return; }
        if (INSTALLER.install_progress < 100) {
            INSTALLER.install_progress += 1;
            INSTALLER.install_substep = min_u32(INSTALLER.install_progress / 26, 3);
        } else {
            installer_go_to(6, 1);
        }
    }
}

// =============================================================================
// TRATAMENTO REATIVO DE INTERACAO (MOUSE E TECLADO)
// =============================================================================

@system
pub fn baken_installer_handle_click(rx: i32, ry: i32, w: u32, h: u32) -> void {
    unsafe {
        // Tela 0: Welcome
        if (INSTALLER.step == 0) {
            let cw: i32 = if (w > 760) { 680 } else { (w - 32) as i32 };
            let ch: i32 = if (h > 540) { 400 } else { (h - 40) as i32 };
            let cx: i32 = (w as i32 - cw) / 2;
            let cy: i32 = if (h as i32 > ch) { (h as i32 - ch) / 2 - 12 } else { 10 };

            // Clique no Card Hero Central ou no Botao Iniciar
            if (rx >= cx && rx <= cx + cw && ry >= cy && ry <= cy + ch) {
                installer_go_to(1, 1);
            } else if (ry > (h as i32) - 52 && rx < 180) {
                installer_go_to(1, 1); // Configuracoes
            } else if (ry > (h as i32) - 52 && rx >= 180 && rx < 520) {
                installer_go_to(7, 1); // Reparo
            }
            return;
        }

        let cx: i32 = if (w >= 760) { 258 } else { 24 };
        let cw: i32 = if (w >= 760) { (w - 288) as i32 } else { (w - 48) as i32 };

        // Tela 1: Selecao de Idioma e Teclado (11 Idiomas)
        if (INSTALLER.step == 1) {
            let col_w = (cw - 20) / 2;
            
            // Coluna 1 (Idiomas 0 a 5)
            for mut i in 0..6 {
                let ly = 96 + (i * 48);
                if (ry >= ly && ry < ly + 42 && rx >= cx && rx < cx + col_w) {
                    INSTALLER.selected_lang = i as u32;
                    INSTALLER.selected_kb = i as u32;
                    baken_i18n_set_lang(i as u32);
                    show_toast("Idioma selecionado com sucesso".as_ptr());
                    return;
                }
            }
            
            // Coluna 2 (Idiomas 6 a 10)
            let col2_x = cx + col_w + 20;
            for mut j in 6..11 {
                let ly = 96 + ((j - 6) * 48);
                if (ry >= ly && ry < ly + 42 && rx >= col2_x && rx < col2_x + col_w) {
                    INSTALLER.selected_lang = j as u32;
                    INSTALLER.selected_kb = j as u32;
                    baken_i18n_set_lang(j as u32);
                    show_toast("Idioma selecionado com sucesso".as_ptr());
                    return;
                }
            }
        }

        // Tela 2: Selecao de Modo
        if (INSTALLER.step == 2) {
            if (ry >= 96 && ry < 96 + 72 && rx >= cx && rx < cx + cw) {
                INSTALLER.selected_mode = 0;
                return;
            }
            if (ry >= 180 && ry < 180 + 72 && rx >= cx && rx < cx + cw) {
                INSTALLER.selected_mode = 1;
                return;
            }
            if (ry >= 264 && ry < 264 + 68 && rx >= cx && rx < cx + cw) {
                INSTALLER.selected_mode = 2;
                return;
            }
        }

        // Tela 3: Selecao de Disco
        if (INSTALLER.step == 3) {
            if (ry >= 96 && ry < 96 + 78 && rx >= cx && rx < cx + cw) {
                INSTALLER.selected_disk = 0;
                return;
            }
        }

        // Tela 7: Reparo
        if (INSTALLER.step == 7) {
            if (ry > (h as i32) - 76 && rx < cx + 140) {
                installer_go_to(0, -1);
                return;
            }
        }

        // Tela 8: OOBE
        if (INSTALLER.step == 8) {
            for mut k in 0..3 {
                let py = 96 + (k * 48);
                if (ry >= py && ry < py + 42 && rx >= cx && rx < cx + cw) {
                    INSTALLER.oobe_usage = k as u32;
                    return;
                }
            }
        }

        // Botoes Inferiores de Navegacao (Voltar e Continuar)
        if (ry > (h as i32) - 76) {
            if (rx < cx + 140 && INSTALLER.step > 0) {
                installer_go_to(INSTALLER.step - 1, -1);
                return;
            }
            if (rx > (cx + cw - 210)) {
                if (INSTALLER.step == 2 && INSTALLER.selected_mode == 1) {
                    INSTALLER.exit_to_desktop = 1;
                    return;
                }
                if (INSTALLER.step < 6) {
                    if (INSTALLER.step == 4) {
                        installer_go_to(5, 1);
                        INSTALLER.install_progress = 0;
                    } else {
                        installer_go_to(INSTALLER.step + 1, 1);
                    }
                } else if (INSTALLER.step == 6) {
                    installer_go_to(8, 1); // OOBE
                } else if (INSTALLER.step == 8) {
                    INSTALLER.exit_to_desktop = 1; // Entrar no Desktop
                }
            }
        }
    }
}

@system
pub fn baken_installer_handle_key(key: u32) -> void {
    unsafe {
        if (key == 'd' as u32 || key == 'D' as u32 || key == 'l' as u32 || key == 'L' as u32) {
            INSTALLER.exit_to_desktop = 1;
            return;
        }
        if ((key == 27 || key == 0x17 || key == 'p' as u32 || key == 'P' as u32) && INSTALLER.step > 0) {
            installer_go_to(INSTALLER.step - 1, -1);
        } else if (key == 13 || key == 10 || key == 32 || key == ' ' as u32 || key == 'n' as u32 || key == 'N' as u32 || key == 'i' as u32 || key == 'I' as u32) {
            if (INSTALLER.step == 2 && INSTALLER.selected_mode == 1) {
                INSTALLER.exit_to_desktop = 1;
                return;
            }
            if (INSTALLER.step < 6) {
                if (INSTALLER.step == 4) {
                    installer_go_to(5, 1);
                    INSTALLER.install_progress = 0;
                } else {
                    installer_go_to(INSTALLER.step + 1, 1);
                }
            } else if (INSTALLER.step == 6) {
                installer_go_to(8, 1);
            } else if (INSTALLER.step == 8) {
                INSTALLER.exit_to_desktop = 1;
            }
        } else if (key >= 49 && key <= 57 && INSTALLER.step == 1) {
            // Teclas '1'..'9'
            INSTALLER.selected_lang = key - 49;
            INSTALLER.selected_kb = key - 49;
            baken_i18n_set_lang(key - 49);
            show_toast("Idioma selecionado via teclado".as_ptr());
        }
    }
}
