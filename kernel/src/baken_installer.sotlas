// =============================================================================
// RENDERIZADOR PRINCIPAL DO ASSISTENTE AURORA
// =============================================================================

@system
pub fn baken_installer_render(x: u32, y: u32, w: u32, h: u32) -> void {
    unsafe {
        INSTALLER.anim_tick = (INSTALLER.anim_tick + 1) % 3600;
        let step = INSTALLER.step;

        if (step == 0) {
            render_welcome(x, y, w, h);
            return;
        }

        render_aurora_shell(x, y, w, h, min_u32(step, 5));

        if (step == 1) {
            render_language_keyboard(x, y, w, h);
        } else if (step == 2) {
            render_mode_choice(x, y, w, h);
        } else if (step == 3) {
            render_disk_selection(x, y, w, h);
        } else if (step == 4) {
            render_review_confirmation(x, y, w, h);
        } else if (step == 5) {
            render_installing_progress(x, y, w, h);
        } else if (step == 6) {
            render_complete_summary(x, y, w, h);
        } else if (step == 7) {
            render_repair_tools(x, y, w, h);
        } else {
            render_oobe_experience(x, y, w, h);
        }
    }
}

@system
fn render_aurora_shell(x: u32, y: u32, w: u32, h: u32, active_step: u32) -> void {
    let lang_idx = get_lang();
    if (w >= 760) {
        // Painel Lateral Esquerdo (Timeline Stepper) em Vidro Acrilico Translucido
        gfx_draw_glass_rect(x + 16, y + 16, 210, h - 32, 0x000F172A, 195, 0x0038BDF8, 16);
        gfx_draw_baken_logo(x + 32, y + 36, 32, 255);
        gfx_draw_text_alpha(x + 72, y + 38, "BAKEN OS".as_ptr(), 0x00FFFFFF, 1, 255);
        gfx_draw_text_alpha(x + 72, y + 58, "Instalacao Aurora".as_ptr(), 0x0038BDF8, 1, 230);

        for mut i in 0..6 {
            let py = y + 104 + ((i as u32) * 44);
            let is_past_or_current = (i as u32) <= active_step;
            let dot_color = if (is_past_or_current) { 0x0000E5FF } else { 0x00475569 };

            if (i < 5) {
                let line_c = if ((i as u32) < active_step) { 0x0000E5FF } else { 0x00334155 };
                gfx_fill_rect_alpha(x + 47, py + 14, 2, 30, line_c, 200);
            }

            gfx_draw_circle_alpha(x + 48, py + 8, 6, dot_color, 255);
            if (i as u32 == active_step) {
                gfx_draw_circle_alpha(x + 48, py + 8, 10, 0x0000E5FF, 60);
            }

            let txt_c = if (is_past_or_current) { 0x00F8FAFC } else { 0x0064748B };
            let step_label = STR_SIDEBAR_STEPS[lang_idx][i];
            gfx_draw_text_alpha(x + 66, py, step_label, txt_c, 1, 255);
        }

        // Rodape da Barra Lateral
        gfx_draw_circle_alpha(x + 36, y + h - 42, 4, 0x0010B981, 255);
        gfx_draw_text_alpha(x + 48, y + h - 48, STR_PRIVACY_TAG[lang_idx], 0x0010B981, 1, 240);

        // Painel Principal Direito em Vidro Fosco Translucido
        let main_x = x + 242;
        let main_w = w - 258;
        gfx_draw_glass_rect(main_x, y + 16, main_w, h - 32, 0x000F172A, 185, 0x0038BDF8, 16);
    } else {
        // Modo Compacto para Resolucoes Menores
        gfx_draw_glass_rect(x + 10, y + 10, w - 20, h - 20, 0x000F172A, 210, 0x0038BDF8, 14);
        gfx_draw_text_alpha(x + 24, y + 24, "BAKEN OS / SETUP".as_ptr(), 0x0000E5FF, 1, 240);
        let progress_w = ((w - 48) * (active_step + 1)) / 6;
        gfx_fill_rect_alpha(x + 24, y + 46, progress_w, 3, 0x0000E5FF, 255);
    }
}

@system
fn render_welcome(x: u32, y: u32, w: u32, h: u32) -> void {
    unsafe {
        let cw: u32 = if (w > 720) { 660 } else { w - 32 };
        let ch: u32 = if (h > 520) { 380 } else { h - 40 };
        let cx = x + (w - cw) / 2;
        let cy = y + (if (h > ch) { (h - ch) / 2 - 12 } else { 10 });

        // Card Hero Central Flutuante em Vidro Fosco
        gfx_draw_glass_rect(cx, cy, cw, ch, 0x000F172A, 175, 0x0038BDF8, 20);

        let logo_x = cx + (cw / 2);
        let logo_y = cy + 68;
        let pulse = 24 + ((INSTALLER.anim_tick % 30) / 6);
        gfx_draw_circle_alpha(logo_x, logo_y, pulse + 14, 0x000284C7, 30);
        gfx_draw_circle_alpha(logo_x, logo_y, pulse + 4, 0x0000E5FF, 60);

        gfx_draw_baken_logo(logo_x - 36, logo_y - 36, 72, 255);

        let t1 = "BAKEN OS";
        let t1_w = gfx_measure_text(t1.as_ptr());
        gfx_draw_text_alpha(logo_x - (t1_w / 2), logo_y + 44, t1.as_ptr(), 0x00FFFFFF, 1, 255);

        // Ciclo de Boas-Vindas nos 11 Idiomas Suportados
        let g_welcome = [
            "Bem-vindo, obrigado por escolher o Baken OS",
            "Welcome, thank you for choosing Baken OS",
            "Bienvenue, merci d'avoir choisi Baken OS",
            "Benvenuto, grazie per aver scelto Baken OS",
            "Bienvenido, gracias por elegir Baken OS",
            "Willkommen, danke dass Sie Baken OS gewaehlt haben",
            "Kalosorisate, efcharistoume pou epilexate to Baken OS",
            "Huan ying, gan xie nin xuan ze Baken OS",
            "Yokoso, Baken OS wo erande itadaki arigatou gozaimasu",
            "Swagat hai, Baken OS chunne ke liye dhanyavad",
            "Karibu, asante kwa kuchagua Baken OS"
        ];

        let g_buttons = [
            "Comecar agora >",
            "Get Started >",
            "Commencer maintenant >",
            "Inizia ora >",
            "Comenzar ahora >",
            "Jetzt starten >",
            "Xekiniste tora >",
            "Li ji kai shi >",
            "Ima sugu hajimeru >",
            "Abhi shuru karein >",
            "Anza sasa >"
        ];

        let g_settings = [
            "Configuracoes",
            "Settings",
            "Parametres",
            "Impostazioni",
            "Configuracion",
            "Einstellungen",
            "Rythmiseis",
            "She zhi",
            "Settei",
            "Settings",
            "Mipangilio"
        ];

        let g_repair = [
            "Restaurar ou Reparar Computador",
            "Restore or Repair Computer",
            "Restaurer ou Reparer l'ordinateur",
            "Ripristina o Ripara Computer",
            "Restaurar o Reparar Computadora",
            "Computer Wiederherstellen oder Reparieren",
            "Epanafora i Episkevi Ypologisti",
            "Hui fu huo Xiu fu Dian nao",
            "Konpyuta no Fukugen matawa Shuri",
            "Computer Restore ya Repair karein",
            "Rejesha au Rekebisha Kompyuta"
        ];

        let msg_idx = ((INSTALLER.anim_tick / 75) % 11) as usize;
        
        // 1. Subtitulo Traduzido em Tempo Real
        let t2 = g_welcome[msg_idx];
        let t2_w = gfx_measure_text(t2.as_ptr());
        gfx_draw_text_alpha(logo_x - (t2_w / 2), logo_y + 72, t2.as_ptr(), 0x00E0F2FE, 1, 255);

        // 2. Botao Central Traduzido em Sincronia
        let start_w: u32 = 300;
        let start_h: u32 = 50;
        let start_x = logo_x - (start_w / 2);
        let start_y = logo_y + 116;
        gfx_draw_glass_rect(start_x, start_y, start_w, start_h, 0x000284C7, 240, 0x0000E5FF, 14);
        let btn_txt = g_buttons[msg_idx];
        let btn_w = gfx_measure_text(btn_txt.as_ptr());
        gfx_draw_text_alpha(start_x + (start_w - btn_w) / 2, start_y + 15, btn_txt.as_ptr(), 0x00FFFFFF, 1, 255);

        // 3. Links Traduzidos no Canto Inferior Esquerdo
        let link_y = if (h > 50) { h - 40 } else { 10 };
        let set_txt = g_settings[msg_idx];
        let set_w = gfx_measure_text(set_txt.as_ptr());
        gfx_draw_text_alpha(28, link_y + 8, set_txt.as_ptr(), 0x00E0F2FE, 1, 240);
        
        let sep_x = 28 + set_w + 14;
        gfx_draw_text_alpha(sep_x, link_y + 8, "|".as_ptr(), 0x00475569, 1, 200);
        
        let rep_txt = g_repair[msg_idx];
        gfx_draw_text_alpha(sep_x + 16, link_y + 8, rep_txt.as_ptr(), 0x00E0F2FE, 1, 240);

        // 4. Rodape Canto Inferior Direito
        let brand = "Baken OS - TasteTrack Systems LTDA";
        let brand_w = gfx_measure_text(brand.as_ptr());
        let brand_x = if (w > brand_w + 34) { w - brand_w - 28 } else { 10 };
        gfx_draw_text_alpha(brand_x, link_y + 8, brand.as_ptr(), 0x0094A3B8, 1, 200);
    }
}

@system
fn render_language_keyboard(x: u32, y: u32, w: u32, h: u32) -> void {
    unsafe {
        let lang_idx = get_lang();
        let cx = if (w >= 760) { x + 258 } else { x + 24 };
        let cw = if (w >= 760) { w - 288 } else { w - 48 };

        gfx_draw_text_alpha(cx, y + 36, STR_LANG_TITLE[lang_idx], 0x00FFFFFF, 1, 255);
        gfx_draw_text_alpha(cx, y + 60, STR_LANG_SUB[lang_idx], 0x0094A3B8, 1, 235);

        let col_w = (cw - 20) / 2;

        // Lista de 11 Idiomas e Teclados Nativos
        let langs = [
            "[1] Portugues (Brasil) • ABNT2",
            "[2] English (US) • US-Intl",
            "[3] Francais (France) • AZERTY",
            "[4] Italiano (Italia) • QWERTY",
            "[5] Espanol (LatAm) • ISO Latin",
            "[6] Deutsch (DE/CH) • QWERTZ",
            "[7] Ellenika (Grego) • Greek",
            "[8] Zhongwen (Chines) • Pinyin",
            "[9] Nihongo (Japones) • JIS/Romaji",
            "[10] Hindi (Indiano) • Inscript",
            "[11] Kiswahili (Africano) • Std"
        ];

        // Coluna 1 (Idiomas 0 a 5)
        gfx_draw_text_alpha(cx, y + 90, STR_LANG_COL1[lang_idx], 0x0038BDF8, 1, 240);
        for mut i in 0..6 {
            let ly = y + 112 + (i * 38) as u32;
            let sel = (INSTALLER.selected_lang == i);
            gfx_draw_glass_rect(cx, ly, col_w, 32, if (sel) { 0x00132338 } else { 0x001E293B }, if (sel) { 240 } else { 160 }, if (sel) { 0x0010B981 } else { 0x00334155 }, 8);
            gfx_draw_circle_alpha(cx + 14, ly + 16, 5, if (sel) { 0x0010B981 } else { 0x0064748B }, 255);
            gfx_draw_text_alpha(cx + 26, ly + 8, langs[i as usize].as_ptr(), if (sel) { 0x00FFFFFF } else { 0x00CBD5E1 }, 1, 255);
        }

        // Coluna 2 (Idiomas 6 a 10)
        let col2_x = cx + col_w + 20;
        gfx_draw_text_alpha(col2_x, y + 90, STR_LANG_COL2[lang_idx], 0x0038BDF8, 1, 240);
        for mut j in 6..11 {
            let idx_offset = (j - 6) as u32;
            let ly = y + 112 + (idx_offset * 38) as u32;
            let sel = (INSTALLER.selected_lang == j);
            gfx_draw_glass_rect(col2_x, ly, col_w, 32, if (sel) { 0x00132338 } else { 0x001E293B }, if (sel) { 240 } else { 160 }, if (sel) { 0x0000E5FF } else { 0x00334155 }, 8);
            gfx_draw_circle_alpha(col2_x + 14, ly + 16, 5, if (sel) { 0x0000E5FF } else { 0x0064748B }, 255);
            gfx_draw_text_alpha(col2_x + 26, ly + 8, langs[j as usize].as_ptr(), if (sel) { 0x00FFFFFF } else { 0x00CBD5E1 }, 1, 255);
        }

        // Botoes Inferiores
        let bot_y = y + h - 68;
        gfx_draw_glass_rect(cx, bot_y, 110, 38, 0x001E293B, 200, 0x00475569, 8);
        gfx_draw_text_alpha(cx + 26, bot_y + 11, STR_BTN_BACK[lang_idx], 0x0094A3B8, 1, 240);

        gfx_draw_glass_rect(cx + cw - 150, bot_y, 150, 38, 0x000284C7, 240, 0x0000E5FF, 8);
        gfx_draw_text_alpha(cx + cw - 126, bot_y + 11, STR_BTN_CONTINUE[lang_idx], 0x00FFFFFF, 1, 255);
    }
}

@system
