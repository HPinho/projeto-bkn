        let sel0 = (INSTALLER.selected_mode == 0);
        gfx_draw_glass_rect(cx, y + 96, cw, 68, if (sel0) { 0x00132338 } else { 0x001E293B }, if (sel0) { 240 } else { 160 }, if (sel0) { 0x0000E5FF } else { 0x00334155 }, 10);
        gfx_draw_circle_alpha(cx + 24, y + 130, 7, if (sel0) { 0x0000E5FF } else { 0x00475569 }, 255);
        gfx_draw_text_alpha(cx + 42, y + 108, STR_MODE0_TITLE[lang_idx], 0x00FFFFFF, 1, 255);
        gfx_draw_text_alpha(cx + 42, y + 132, STR_MODE0_DESC[lang_idx], 0x0038BDF8, 1, 230);

        let sel1 = (INSTALLER.selected_mode == 1);
        gfx_draw_glass_rect(cx, y + 176, cw, 68, if (sel1) { 0x00132338 } else { 0x001E293B }, if (sel1) { 240 } else { 160 }, if (sel1) { 0x0010B981 } else { 0x00334155 }, 10);
        gfx_draw_circle_alpha(cx + 24, y + 210, 7, if (sel1) { 0x0010B981 } else { 0x00475569 }, 255);
        gfx_draw_text_alpha(cx + 42, y + 188, STR_MODE1_TITLE[lang_idx], 0x00FFFFFF, 1, 255);
        gfx_draw_text_alpha(cx + 42, y + 212, STR_MODE1_DESC[lang_idx], 0x0010B981, 1, 230);

        // Botoes Inferiores
        let bot_y = y + h - 68;
        gfx_draw_glass_rect(cx, bot_y, 110, 38, 0x001E293B, 200, 0x00475569, 8);
        gfx_draw_text_alpha(cx + 26, bot_y + 11, STR_BTN_BACK[lang_idx], 0x0094A3B8, 1, 240);

        gfx_draw_glass_rect(cx + cw - 150, bot_y, 150, 38, 0x000284C7, 240, 0x0000E5FF, 8);
        gfx_draw_text_alpha(cx + cw - 126, bot_y + 11, STR_BTN_CONTINUE[lang_idx], 0x00FFFFFF, 1, 255);
    }
}

