// Baken OS — Next-Gen Aurora Graphical Setup Wizard & OOBE
// 100% Implementado na linguagem Sotlas (@system) com Glassmorphism Especular Claro, i18n Multilingue e Zero Telemetria
// Strings padrao e i18n: "TasteTrack Systems LTDA", "Comecar agora", "Restaurar ou Corrigir Computador"

module kernel::baken_installer;

import kernel::graphics_engine::*;
import kernel::baken_rasterizer::*;
import kernel::bakenfx::*;
import kernel::sotlas_graphics::*;
import kernel::baken_oobe_screen::*;
import kernel::baken_i18n::*;
import kernel::baken_cursor::*;
import kernel::baken_animation::*;
import kernel::baken_materials::*;

pub const TOTAL_LANGUAGES: usize = 11;

pub struct InstallerState {
    pub step: u32;              // 0: Welcome, 1: Language/Keyboard, 2: Mode, 3: Disk, 4: Review, 5: Installing, 6: Complete, 7: Repair, 8: OOBE
    pub selected_lang: u32;     // 0..10 (PT, EN, FR, IT, ES, DE, EL, ZH, JA, HI, SW)
    pub selected_kb: u32;       // 0..10
    pub selected_mode: u32;     // 0: Instalar Definitivamente, 1: Live Demo, 2: Benchmark
    pub selected_disk: u32;     // 0: NVMe SSD (Gravavel), 1: USB Live (Protegida)
    pub install_progress: u32;  // 0 a 100%
    pub install_substep: u32;   // 0 a 3
    pub anim_tick: u32;
    pub error: u32;
    pub oobe_step: u32;         // 0 a 6
    pub oobe_usage: u32;        // 0: Dev, 1: Gamer, 2: Produtividade
    pub oobe_diagnostics: u8;   // 0: Desativado (Privacidade Total)
    pub oobe_location: u8;      // 0: Desativado
    pub previous_step: u32;
    pub transition_tick: u32;   // 0..36, aproximadamente 600 ms a 60 Hz
    pub transition_direction: i32;
    pub toast_tick: u32;
    pub toast_text: *const u8;
    pub exit_to_desktop: u8;
    pub frame_delta: f32;
    pub anim_frame_remainder: f32;
    pub stagger_base: u32;
}

static mut INSTALLER: InstallerState = InstallerState {
    step: 0,
    selected_lang: 0,
    selected_kb: 0,
    selected_mode: 0,
    selected_disk: 0,
    install_progress: 0,
    install_substep: 0,
    anim_tick: 0,
    error: 0,
    oobe_step: 0,
    oobe_usage: 0,
    oobe_diagnostics: 0,
    oobe_location: 0,
    previous_step: 0,
    transition_tick: 36,
    transition_direction: 1,
    toast_tick: 0,
    toast_text: null as *const u8,
    exit_to_desktop: 0,
    frame_delta: 0.0166667,
    anim_frame_remainder: 0.0,
    stagger_base: 0,
};

@system
pub fn baken_installer_wants_desktop() -> u8 {
    unsafe {
        return INSTALLER.exit_to_desktop;
    }
}

@system
pub fn baken_installer_set_exit_to_desktop(val: u8) -> void {
    unsafe {
        INSTALLER.exit_to_desktop = val;
    }
}

@system
pub fn baken_installer_set_frame_delta(dt: f32) -> void {
    unsafe {
        INSTALLER.frame_delta = if dt < 0.001 { 0.001 } else if dt > 0.066 { 0.066 } else { dt };
    }
}

@system
fn installer_go_to(next: u32, direction: i32) -> void {
    unsafe {
        if (next == INSTALLER.step) { return; }
        INSTALLER.previous_step = INSTALLER.step;
        INSTALLER.step = next;
        INSTALLER.transition_tick = 0;
        INSTALLER.transition_direction = direction;
        INSTALLER.stagger_base = INSTALLER.anim_tick;
    }
}

@system
fn show_toast(msg: *const u8) -> void {
    unsafe {
        INSTALLER.toast_text = msg;
        INSTALLER.toast_tick = 90;
    }
}

@system
pub fn baken_installer_init() -> void {
    unsafe {
        INSTALLER.step = 0;
        INSTALLER.selected_lang = 0;
        INSTALLER.selected_kb = 0;
        INSTALLER.selected_mode = 0;
        INSTALLER.selected_disk = 0;
        INSTALLER.install_progress = 0;
        INSTALLER.install_substep = 0;
        INSTALLER.anim_tick = 0;
        INSTALLER.error = 0;
        INSTALLER.oobe_step = 0;
        INSTALLER.oobe_usage = 0;
        INSTALLER.oobe_diagnostics = 0;
        INSTALLER.oobe_location = 0;
        INSTALLER.previous_step = 0;
        INSTALLER.transition_tick = 36;
        INSTALLER.transition_direction = 1;
        INSTALLER.toast_tick = 0;
        INSTALLER.toast_text = null as *const u8;
        INSTALLER.frame_delta = 0.0166667;
        INSTALLER.anim_frame_remainder = 0.0;
        INSTALLER.stagger_base = 0;
    }
    baken_oobe_init();
}

@inline
fn min_u32(a: u32, b: u32) -> u32 {
    if (a < b) { return a; }
    return b;
}

@inline
fn get_lang() -> usize {
    unsafe {
        let l = INSTALLER.selected_lang as usize;
        if (l >= TOTAL_LANGUAGES) { return 0; }
        return l;
    }
}

// Primitiva de Vidro Especular com Borda Iluminada Perfeita
@inline
fn draw_specular_card(x: u32, y: u32, w: u32, h: u32, bg: u32, alpha: u8, border: u32, radius: u32) -> void {
    material_draw_glass_panel(x, y, w, h, bg, alpha, border, radius);
}

// Botao Interativo Moderno com Efeito de Luz e Seta Animada (Tema Claro)
@inline
fn draw_interactive_btn(x: u32, y: u32, w: u32, h: u32, text: *const u8, is_primary: bool, is_hover: bool) -> void {
    let text_col = if (is_primary) { 0x00FFFFFF } else { if (is_hover) { 0x000F172A } else { 0x00334155 } };
    material_draw_macos_button(x, y, w, h, null as *const u8, is_primary, is_hover);
    let tw = raster_measure_text(text);

    if (is_primary) {
        let content_w = tw + 20;
        let tx = x + (if (w > content_w) { (w - content_w) / 2 } else { 12 });
        let ty = y + (if (h > 20) { (h - 20) / 2 } else { 2 });
        raster_draw_text_alpha(tx, ty, text, text_col, 1, 255);
        unsafe {
            baken_draw_animated_action_arrow(tx + tw + 6, ty + 5, INSTALLER.anim_tick, 0x00FFFFFF, is_hover);
        }
    } else {
        let tx = x + (if (w > tw) { (w - tw) / 2 } else { 14 });
        let ty = y + (if (h > 20) { (h - 20) / 2 } else { 2 });
        raster_draw_text_alpha(tx, ty, text, text_col, 1, 255);
    }
}

