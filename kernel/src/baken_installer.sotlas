// =============================================================================
// RENDERIZADOR PRINCIPAL DO ASSISTENTE GRAFICO
// =============================================================================

@system
pub fn baken_installer_render(x: u32, y: u32, w: u32, h: u32) -> void {
    unsafe {
        INSTALLER.anim_tick = (INSTALLER.anim_tick + 1) % 3600;
        if (INSTALLER.transition_tick < 24) { INSTALLER.transition_tick += 1; }
        if (INSTALLER.toast_tick > 0) { INSTALLER.toast_tick -= 1; }
        let step = INSTALLER.step;

        // 1. Fundo fixo da sessão. Não há geração procedural de imagem nem
        // variação dependente de frame no assistente.
        bakenfx_draw_desktop_background(sotlas_get_default_canvas(), w, h);
        bakenfx_capture_backdrop();

        if (step == 0) {
            render_welcome(x, y, w, h);
            render_toast(w);
            return;
        }

        // 2. Timeline Stepper Lateral Flutuante (para telas >= 760px)
        render_aurora_shell(x, y, w, h, min_u32(step, 5));

        // 3. Calculo de Slide Parallax com Fisica de Mola Amortecida
        let prog = raster_smoothstep_u8(INSTALLER.transition_tick, 24) as u32;
        let slide_ox = if (INSTALLER.transition_tick < 24) {
            INSTALLER.transition_direction * (((255 - prog as i32) * 28) / 255)
        } else {
            0
        };
        let target_x = (x as i32 + slide_ox) as u32;

        // 4. Renderizacao da Etapa Atual
        if (step == 1) {
            render_language_keyboard(target_x, y, w, h);
        } else if (step == 2) {
            render_mode_choice(target_x, y, w, h);
        } else if (step == 3) {
            render_disk_selection(target_x, y, w, h);
        } else if (step == 4) {
            render_review_confirmation(target_x, y, w, h);
        } else if (step == 5) {
            render_installing_progress(target_x, y, w, h);
        } else if (step == 6) {
            render_complete_summary(target_x, y, w, h);
        } else if (step == 7) {
            render_repair_tools(target_x, y, w, h);
        } else {
            render_oobe_experience(target_x, y, w, h);
        }

        // 5. Chips de Atalhos de Teclado no Rodape
        render_keyboard_chips(x, y, w, h);

        // 6. Toasts Flutuantes de Notificacao
        render_toast(w);
    }
}

// Renderiza barra de atalhos flutuante no rodape (centralizada e sem sobreposicao)
@system
fn render_keyboard_chips(x: u32, y: u32, w: u32, h: u32) -> void {
    let chip_y = y + h - 30;
    let chip_w: u32 = 390;
    let chip_x = x + (if (w > chip_w) { (w - chip_w) / 2 } else { 10 });
    if (w >= 640 && h >= 400) {
        material_draw_glass_panel(chip_x, chip_y, chip_w, 24, 0x000F172A, 190, 0x00334155, 7);
        raster_draw_text_alpha(chip_x + 16, chip_y + 5, "[ Enter ] Avancar".as_ptr(), 0x0000E5FF, 1, 230);
        raster_draw_text_alpha(chip_x + 150, chip_y + 5, "[ Esc ] Voltar".as_ptr(), 0x0094A3B8, 1, 200);
        raster_draw_text_alpha(chip_x + 268, chip_y + 5, "[ 1..9 ] Opcoes".as_ptr(), 0x0038BDF8, 1, 200);
    }
}

// Renderiza Notificacao Toast Flutuante no Topo
@system
fn render_toast(w: u32) -> void {
    unsafe {
        if (INSTALLER.toast_tick == 0 || INSTALLER.toast_text == (null as *const u8)) { return; }
        let tw = raster_measure_text(INSTALLER.toast_text);
        let toast_w = tw + 40;
        let toast_x = (w - toast_w) / 2;
        let alpha: u8 = if (INSTALLER.toast_tick > 15) { 240 } else { ((INSTALLER.toast_tick * 240) / 15) as u8 };

        draw_specular_card(toast_x, 16, toast_w, 32, 0x000F172A, alpha, 0x0000E5FF, 16);
        raster_draw_circle_alpha(toast_x + 16, 32, 5, 0x0010B981, alpha);
        raster_draw_text_alpha(toast_x + 28, 23, INSTALLER.toast_text, 0x00FFFFFF, 1, alpha);
    }
}

// Timeline Stepper Lateral Flutuante
@system
fn render_aurora_shell(x: u32, y: u32, w: u32, h: u32, active_step: u32) -> void {
    let lang_idx = get_lang();
    if (w >= 760) {
        // Painel Esquerdo em Vidro Acrilico Translúcido com Specular Highlight
        draw_specular_card(x + 16, y + 16, 216, h - 32, 0x000F172A, 195, 0x0038BDF8, 16);
        
        // Emblema Oficial Swirl Baken OS
        raster_draw_baken_logo(x + 32, y + 36, 36, 255);
        raster_draw_text_alpha(x + 76, y + 38, "BAKEN OS".as_ptr(), 0x00FFFFFF, 1, 255);
        raster_draw_text_alpha(x + 76, y + 58, "Setup & OOBE".as_ptr(), 0x0000E5FF, 1, 230);

        // Itens da Timeline Conectada
        for mut i in 0..6 {
            let py = y + 106 + ((i as u32) * 44);
            let is_past_or_current = (i as u32) <= active_step;
            let dot_color = if (is_past_or_current) { 0x0000E5FF } else { 0x00475569 };

            // Linha conectora vertical
            if (i < 5) {
                let line_c = if ((i as u32) < active_step) { 0x0000E5FF } else { 0x00334155 };
                raster_fill_rect_alpha(x + 47, py + 14, 2, 30, line_c, 210);
            }

            // Anel do Ponto da Timeline
            raster_draw_circle_alpha(x + 48, py + 8, 6, dot_color, 255);
            if (i as u32 == active_step) {
                raster_draw_circle_alpha(x + 48, py + 8, 11, 0x0000E5FF, 75);
                raster_draw_circle_alpha(x + 48, py + 8, 16, 0x000284C7, 30);
            }

            let txt = STR_SIDEBAR_STEPS[lang_idx][i];
            let txt_color = if (i as u32 == active_step) { 0x00FFFFFF } else if (is_past_or_current) { 0x0038BDF8 } else { 0x0064748B };
            raster_draw_text_alpha(x + 66, py, txt, txt_color, 1, 250);
        }

        // Badge de Privacidade no Rodape Lateral
        let priv_y = y + h - 68;
        material_draw_glass_panel(x + 24, priv_y, 200, 32, 0x001E293B, 200, 0x0010B981, 8);
        raster_draw_circle_alpha(x + 38, priv_y + 16, 4, 0x0010B981, 255);
        raster_draw_text_alpha(x + 50, priv_y + 9, "Zero Telemetria Nativa".as_ptr(), 0x0010B981, 1, 240);
    }
}

// Tela 0: Boas-Vindas com Card Central Flutuante em Alta Resolução e Ray Tracing
@system
fn render_welcome(x: u32, y: u32, w: u32, h: u32) -> void {
    unsafe {
        let cw: u32 = if (w > 800) { 740 } else { w - 32 };
        let ch: u32 = if (h > 560) { 440 } else { h - 40 };
        let cx = x + (w - cw) / 2;

        // Geometria estável: a posição da superfície não oscila com o número
        // de frames. Movimento de interface deve vir de transições de estado.
        let float_dy: i32 = 0;
        let base_cy = if (h > ch) { (h - ch) / 2 - 12 } else { 10 };
        let cy = (y as i32 + base_cy as i32 + float_dy) as u32;

        // Card Hero central com material definido pelo design system.
        material_draw_glass_panel(cx, cy, cw, ch, 0x000B132B, 210, 0x0038BDF8, 24);

        let logo_x = cx + (cw / 2);
        let logo_y = cy + 80;
        
        // Moldura estática de marca e logotipo de asset. Nenhum ícone ou
        // efeito visual é sintetizado durante a renderização.
        raster_draw_circle_alpha(logo_x, logo_y, 50, 0x000284C7, 28);
        raster_draw_circle_alpha(logo_x, logo_y, 44, 0x0000E5FF, 48);
        raster_draw_baken_logo(logo_x - 42, logo_y - 42, 84, 255);

        // Título "BAKEN OS" em Alta Resolução Nativa (32px puro com curvas ultra-suaves)
        let t1 = "BAKEN OS";
        let t1_w = raster_measure_title_text(t1.as_ptr());
        raster_draw_title_text_alpha(logo_x - (t1_w / 2), logo_y + 54, t1.as_ptr(), 0x00FFFFFF, 255);

        // Ticker Multilingue com Micro-Slide Vertical e Cross-Fade
        let lang_period: u32 = 100;
        let cur_idx = ((INSTALLER.anim_tick / lang_period) % 11) as usize;
        let next_idx = ((cur_idx + 1) % 11) as usize;
        let phase = INSTALLER.anim_tick % lang_period;

        let mut show_idx = cur_idx;
        let mut alpha: u8 = 255;
        let mut y_off: i32 = 0;

        if (phase < 75) {
            show_idx = cur_idx; alpha = 255; y_off = 0;
        } else if (phase < 88) {
            let p = raster_smoothstep_u8(phase - 75, 13) as u32;
            show_idx = cur_idx; alpha = (255 - p) as u8; y_off = -((p as i32 * 8) / 255);
        } else {
            let p = raster_smoothstep_u8(phase - 88, 12) as u32;
            show_idx = next_idx; alpha = p as u8; y_off = 8 - ((p as i32 * 8) / 255);
        }
        
        let t2_y = (logo_y as i32 + 96 + y_off) as u32;
        if (show_idx == 6) {
            // Grego: Ελληνικά (ID 2, largura 75)
            raster_draw_cjk_item(logo_x - 37, t2_y, 2, 0x0093C5FD, alpha);
        } else if (show_idx == 7) {
            // Chinês: 中文 (ID 0, largura 36)
            raster_draw_cjk_item(logo_x - 18, t2_y, 0, 0x0093C5FD, alpha);
        } else if (show_idx == 8) {
            // Japonês: 日本語 (ID 1, largura 52)
            raster_draw_cjk_item(logo_x - 26, t2_y, 1, 0x0093C5FD, alpha);
        } else {
            let t2 = i18n_welcome_text_for_lang(show_idx);
            let t2_w = raster_measure_text(t2);
            raster_draw_text_alpha(logo_x - (t2_w / 2), t2_y, t2, 0x0093C5FD, 1, alpha);
        }

        // Botao Central com Seta Animada e Traducao Dinamica Sincronizada ao Carrossel
        let start_w: u32 = 320;
        let start_h: u32 = 52;
        let start_x = logo_x - (start_w / 2);
        let start_y = logo_y + 138;
        draw_interactive_btn(start_x, start_y, start_w, start_h, i18n_btn_start_for_lang(show_idx), true, true);

        // Rodape de Links Multilingue Sincronizado com Acentuação Autêntica e Fade Suave
        let link_y = if (h > 50) { h - 40 } else { 10 };
        let footer_text = i18n_footer_help_for_lang(show_idx);
        let footer_alpha = if (phase < 75) { 230 } else { 160 + ((alpha as u32 * 70) / 255) as u8 };
        raster_draw_text_alpha(x + 32, link_y, footer_text, 0x0094A3B8, 1, footer_alpha);
        let cr = "Baken OS - TasteTrack Systems LTDA";
        let cr_w = raster_measure_text(cr.as_ptr());
        raster_draw_text_alpha(x + w - cr_w - 32, link_y, cr.as_ptr(), 0x0064748B, 1, 210);
    }
}

// Tela 1: Selecao de 11 Idiomas e Layout de Teclado
@system
fn render_language_keyboard(x: u32, y: u32, w: u32, h: u32) -> void {
    unsafe {
        let lang_idx = get_lang();
        let cx = if (w >= 760) { x + 258 } else { x + 24 };
        let cw = if (w >= 760) { w - 288 } else { w - 48 };

        // Titulo e Subtitulo com Hierarquia Tipografica
        raster_draw_text_alpha(cx, y + 36, STR_LANG_TITLE[lang_idx], 0x00FFFFFF, 1, 255);
        raster_draw_text_alpha(cx, y + 60, STR_LANG_SUB[lang_idx], 0x0094A3B8, 1, 235);

        let col_w = (cw - 20) / 2;

        // Coluna 1 (Idiomas 0 a 5)
        for mut i in 0..6 {
            let ly = y + 96 + (i * 48);
            let is_sel = (INSTALLER.selected_lang == (i as u32));
            let bg_c = if (is_sel) { 0x000284C7 } else { 0x000F172A };
            let border_c = if (is_sel) { 0x0000E5FF } else { 0x00334155 };
            let alpha: u8 = if (is_sel) { 245 } else { 190 };

            draw_specular_card(cx, ly, col_w, 42, bg_c, alpha, border_c, 10);
            raster_draw_circle_alpha(cx + 20, ly + 21, 6, if (is_sel) { 0x0000E5FF } else { 0x0064748B }, 255);
            raster_draw_text_alpha(cx + 38, ly + 11, STR_NATIVE_LANGS[i], if (is_sel) { 0x00FFFFFF } else { 0x00F8FAFC }, 1, 255);
        }

        // Coluna 2 (Idiomas 6 a 10)
        let col2_x = cx + col_w + 20;
        for mut j in 6..11 {
            let ly = y + 96 + ((j - 6) * 48);
            let is_sel = (INSTALLER.selected_lang == (j as u32));
            let bg_c = if (is_sel) { 0x000284C7 } else { 0x000F172A };
            let border_c = if (is_sel) { 0x0000E5FF } else { 0x00334155 };
            let alpha: u8 = if (is_sel) { 245 } else { 190 };
            let text_color = if (is_sel) { 0x00FFFFFF } else { 0x00F8FAFC };

            material_draw_glass_panel(col2_x, ly, col_w, 42, bg_c, alpha, border_c, 10);
            raster_draw_circle_alpha(col2_x + 20, ly + 21, 6, if (is_sel) { 0x0000E5FF } else { 0x0064748B }, 255);

            if (j == 6) {
                // 7. Ελληνικά
                raster_draw_text_alpha(col2_x + 38, ly + 11, "7. ".as_ptr(), text_color, 1, 255);
                raster_draw_cjk_item(col2_x + 58, ly + 11, 2, text_color, 255);
                raster_draw_text_alpha(col2_x + 140, ly + 11, "(Grego / EL)".as_ptr(), 0x0094A3B8, 1, 210);
            } else if (j == 7) {
                // 8. 中文
                raster_draw_text_alpha(col2_x + 38, ly + 11, "8. ".as_ptr(), text_color, 1, 255);
                raster_draw_cjk_item(col2_x + 58, ly + 11, 0, text_color, 255);
                raster_draw_text_alpha(col2_x + 102, ly + 11, "(Chines / ZH)".as_ptr(), 0x0094A3B8, 1, 210);
            } else if (j == 8) {
                // 9. 日本語
                raster_draw_text_alpha(col2_x + 38, ly + 11, "9. ".as_ptr(), text_color, 1, 255);
                raster_draw_cjk_item(col2_x + 58, ly + 11, 1, text_color, 255);
                raster_draw_text_alpha(col2_x + 118, ly + 11, "(Japones / JA)".as_ptr(), 0x0094A3B8, 1, 210);
            } else {
                raster_draw_text_alpha(col2_x + 38, ly + 11, STR_NATIVE_LANGS[j], text_color, 1, 255);
            }
        }

        // Botoes de Navegacao Inferiores Multilingue
        let bot_y = y + h - 70;
        draw_interactive_btn(cx, bot_y, 120, 42, i18n_btn_back(), false, false);
        draw_interactive_btn(cx + cw - 160, bot_y, 160, 42, i18n_btn_next(), true, true);
    }
}

// Tela 2: Selecao de Modo de Uso (Nativo SSD vs Live RAM vs Benchmark)
@system
fn render_mode_choice(x: u32, y: u32, w: u32, h: u32) -> void {
    unsafe {
        let lang_idx = get_lang();
        let cx = if (w >= 760) { x + 258 } else { x + 24 };
        let cw = if (w >= 760) { w - 288 } else { w - 48 };

        raster_draw_text_alpha(cx, y + 36, STR_MODE_TITLE[lang_idx], 0x00FFFFFF, 1, 255);
        raster_draw_text_alpha(cx, y + 60, STR_MODE_SUB[lang_idx], 0x0094A3B8, 1, 235);

        // Opcao 1: Instalacao Definitiva
        let is_m0 = (INSTALLER.selected_mode == 0);
        let bg0 = if (is_m0) { 0x000284C7 } else { 0x001E293B };
        let brd0 = if (is_m0) { 0x0000E5FF } else { 0x00334155 };
        draw_specular_card(cx, y + 96, cw, 72, bg0, if (is_m0) { 240 } else { 190 }, brd0, 10);
        raster_draw_circle_alpha(cx + 24, y + 132, 7, if (is_m0) { 0x0010B981 } else { 0x0064748B }, 255);
        raster_draw_text_alpha(cx + 44, y + 108, STR_M1_TITLE[lang_idx], if (is_m0) { 0x0000E5FF } else { 0x00FFFFFF }, 1, 255);
        raster_draw_text_alpha(cx + 44, y + 132, STR_M1_DESC[lang_idx], 0x0094A3B8, 1, 240);

        // Opcao 2: Modo Live RAM
        let is_m1 = (INSTALLER.selected_mode == 1);
        let bg1 = if (is_m1) { 0x000284C7 } else { 0x001E293B };
        let brd1 = if (is_m1) { 0x0000E5FF } else { 0x00334155 };
        draw_specular_card(cx, y + 180, cw, 72, bg1, if (is_m1) { 240 } else { 190 }, brd1, 10);
        raster_draw_circle_alpha(cx + 24, y + 216, 7, if (is_m1) { 0x0010B981 } else { 0x0064748B }, 255);
        raster_draw_text_alpha(cx + 44, y + 192, STR_M2_TITLE[lang_idx], if (is_m1) { 0x0000E5FF } else { 0x00FFFFFF }, 1, 255);
        raster_draw_text_alpha(cx + 44, y + 216, STR_M2_DESC[lang_idx], 0x0094A3B8, 1, 240);

        // Opcao 3: Benchmark de Desempenho do Sistema
        let is_m2 = (INSTALLER.selected_mode == 2);
        let bg2 = if (is_m2) { 0x000284C7 } else { 0x001E293B };
        let brd2 = if (is_m2) { 0x0000E5FF } else { 0x00334155 };
        draw_specular_card(cx, y + 264, cw, 68, bg2, if (is_m2) { 240 } else { 190 }, brd2, 10);
        raster_draw_circle_alpha(cx + 24, y + 298, 7, if (is_m2) { 0x00F59E0B } else { 0x0064748B }, 255);
        raster_draw_text_alpha(cx + 44, y + 276, "Teste de Desempenho e Telemetria de Hardware".as_ptr(), if (is_m2) { 0x00F59E0B } else { 0x00FFFFFF }, 1, 255);
        raster_draw_text_alpha(cx + 44, y + 300, "Executa benchmark completo de CPU, RAM, SSD e Framebuffer.".as_ptr(), 0x0094A3B8, 1, 240);

        let bot_y = y + h - 68;
        draw_interactive_btn(cx, bot_y, 110, 38, STR_BTN_BACK[lang_idx], false, false);
        draw_interactive_btn(cx + cw - 150, bot_y, 150, 38, STR_BTN_NEXT[lang_idx], true, true);
    }
}

// Tela 3: Selecao de Disco com Grafico de Particionamento Visual
@system
fn render_disk_selection(x: u32, y: u32, w: u32, h: u32) -> void {
    unsafe {
        let lang_idx = get_lang();
        let cx = if (w >= 760) { x + 258 } else { x + 24 };
        let cw = if (w >= 760) { w - 288 } else { w - 48 };

        raster_draw_text_alpha(cx, y + 36, STR_DISK_TITLE[lang_idx], 0x00FFFFFF, 1, 255);
        raster_draw_text_alpha(cx, y + 60, STR_DISK_SUB[lang_idx], 0x0094A3B8, 1, 235);

        // Cartao do Disco NVMe SSD
        draw_specular_card(cx, y + 96, cw, 78, 0x000284C7, 240, 0x0000E5FF, 10);
        raster_draw_circle_alpha(cx + 24, y + 135, 7, 0x0010B981, 255);
        raster_draw_text_alpha(cx + 44, y + 108, "NVMe SSD Principal — 512.0 GB [ALVO GRAVAVEL]".as_ptr(), 0x0000E5FF, 1, 255);
        raster_draw_text_alpha(cx + 44, y + 130, "Unidade de armazenamento veloz para instalacao nativa com BakenFS.".as_ptr(), 0x00F8FAFC, 1, 240);

        // Diagrama Visual de Particionamento em Barra Segmentada
        let bar_y = y + 190;
        draw_specular_card(cx, bar_y, cw, 64, 0x001E293B, 220, 0x00334155, 8);
        raster_draw_text_alpha(cx + 16, bar_y + 8, "Esquema de Particoes Planejado (Tabela GPT):".as_ptr(), 0x0000E5FF, 1, 240);

        let p_bar_w = cw - 32;
        let esp_w = min_u32(p_bar_w * 15 / 100, 80);
        let root_w = p_bar_w - esp_w - 30;
        let p_x = cx + 16;
        let p_y = bar_y + 30;

        // Bloco 1: ESP FAT32 (Verde Esmeralda)
        raster_fill_rect_alpha(p_x, p_y, esp_w, 20, 0x0010B981, 240);
        raster_draw_text_alpha(p_x + 6, p_y + 4, "ESP (512MB)".as_ptr(), 0x00FFFFFF, 1, 230);

        // Bloco 2: BakenFS Sistema (Azul Eletrico)
        raster_fill_rect_alpha(p_x + esp_w + 4, p_y, root_w, 20, 0x000284C7, 240);
        raster_draw_text_alpha(p_x + esp_w + 14, p_y + 4, "BakenFS Raiz com Snapshots (476.5 GB)".as_ptr(), 0x00FFFFFF, 1, 255);

        // Bloco 3: Espaco Livre de Seguranca
        raster_fill_rect_alpha(p_x + esp_w + root_w + 8, p_y, 22, 20, 0x00475569, 200);

        // Aviso de Seguranca
        draw_specular_card(cx, y + 268, cw, 44, 0x001E293B, 190, 0x00F59E0B, 8);
        raster_draw_circle_alpha(cx + 20, y + 290, 5, 0x00F59E0B, 255);
        raster_draw_text_alpha(cx + 34, y + 280, "Aviso: Todos os dados na particao selecionada serao formatados com integridade.".as_ptr(), 0x00F8FAFC, 1, 240);

        let bot_y = y + h - 68;
        draw_interactive_btn(cx, bot_y, 110, 38, STR_BTN_BACK[lang_idx], false, false);
        draw_interactive_btn(cx + cw - 150, bot_y, 150, 38, STR_BTN_NEXT[lang_idx], true, true);
    }
}

// Tela 4: Revisao Final de Parametros
@system
fn render_review_confirmation(x: u32, y: u32, w: u32, h: u32) -> void {
    unsafe {
        let lang_idx = get_lang();
