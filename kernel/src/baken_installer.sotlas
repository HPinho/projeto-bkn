    }
}

// Tick para avanco suave da instalacao
@system
pub fn baken_installer_tick() -> void {
    unsafe {
        if (INSTALLER.step != 5 || INSTALLER.error != 0) { return; }
        if (INSTALLER.install_progress < 100) {
            INSTALLER.install_progress += 1;
            INSTALLER.install_substep = min_u32(INSTALLER.install_progress / 26, 3);
        } else {
            INSTALLER.step = 6;
        }
    }
}

// =============================================================================
// TRATAMENTO REATIVO DE INTERACAO (MOUSE E TECLADO)
// =============================================================================

@system
pub fn baken_installer_handle_click(rx: i32, ry: i32, w: u32, h: u32) -> void {
    unsafe {
        // Tela 0: Welcome
        if (INSTALLER.step == 0) {
            let ch: i32 = if (h > 520) { 380 } else { (h - 40) as i32 };
            let cy: i32 = if (h as i32 > ch) { (h as i32 - ch) / 2 - 12 } else { 10 };
            let start_y = cy + 68 + 116;

            // Botao Central Iniciar
            if (ry >= start_y && ry <= start_y + 50) {
                INSTALLER.step = 1;
            } else if (ry > (h as i32) - 52 && rx < 180) {
                INSTALLER.step = 1; // Configuracoes
            } else if (ry > (h as i32) - 52 && rx >= 180 && rx < 520) {
                INSTALLER.step = 7; // Reparo
            }
            return;
        }

        let cx: i32 = if (w >= 760) { 258 } else { 24 };
        let cw: i32 = if (w >= 760) { (w - 288) as i32 } else { (w - 48) as i32 };

        // Tela 1: Selecao de Idioma e Teclado (11 Idiomas)
        if (INSTALLER.step == 1) {
            let col_w = (cw - 20) / 2;
            
            // Coluna 1 (Idiomas 0 a 5)
            for mut i in 0..6 {
                let ly = 112 + (i * 38);
                if (ry >= ly && ry < ly + 32 && rx >= cx && rx < cx + col_w) {
                    INSTALLER.selected_lang = i as u32;
                    INSTALLER.selected_kb = i as u32;
                    return;
                }
            }
            
            // Coluna 2 (Idiomas 6 a 10)
            let col2_x = cx + col_w + 20;
            for mut j in 6..11 {
                let ly = 112 + ((j - 6) * 38);
                if (ry >= ly && ry < ly + 32 && rx >= col2_x && rx < col2_x + col_w) {
                    INSTALLER.selected_lang = j as u32;
                    INSTALLER.selected_kb = j as u32;
                    return;
                }
            }
        }

        // Tela 2: Selecao de Modo
        if (INSTALLER.step == 2) {
            if (ry >= 96 && ry < 96 + 68 && rx >= cx && rx < cx + cw) {
                INSTALLER.selected_mode = 0;
                return;
            }
            if (ry >= 176 && ry < 176 + 68 && rx >= cx && rx < cx + cw) {
                INSTALLER.selected_mode = 1;
                return;
            }
        }

        // Tela 3: Selecao de Disco
        if (INSTALLER.step == 3) {
            if (ry >= 92 && ry < 92 + 58 && rx >= cx && rx < cx + cw) {
                INSTALLER.selected_disk = 0;
                return;
            }
        }

        // Tela 7: Reparo
        if (INSTALLER.step == 7) {
            if (ry > (h as i32) - 76 && rx < cx + 140) {
                INSTALLER.step = 0;
                return;
            }
        }

        // Botoes Inferiores de Navegacao (Voltar e Continuar)
        if (ry > (h as i32) - 76) {
            if (rx < cx + 140 && INSTALLER.step > 0) {
                INSTALLER.step -= 1;
                return;
            }
            if (rx > (cx + cw - 210)) {
                if (INSTALLER.step < 6) {
                    if (INSTALLER.step == 4) {
                        INSTALLER.step = 5;
                        INSTALLER.install_progress = 0;
                    } else {
                        INSTALLER.step += 1;
                    }
                } else if (INSTALLER.step == 6) {
                    INSTALLER.step = 8; // OOBE
                } else if (INSTALLER.step == 8) {
                    INSTALLER.step = 0; // Concluido
                }
            }
        }
    }
}

@system
pub fn baken_installer_handle_key(key: u32) -> void {
    unsafe {
        if (key == 27 && INSTALLER.step > 0) {
            INSTALLER.step -= 1;
        } else if (key == 13 && INSTALLER.step < 6) {
            if (INSTALLER.step == 4) {
                INSTALLER.step = 5;
                INSTALLER.install_progress = 0;
            } else {
                INSTALLER.step += 1;
            }
        } else if (key >= 49 && key <= 57 && INSTALLER.step == 1) {
            // Teclas '1'..'9'
            INSTALLER.selected_lang = key - 49;
            INSTALLER.selected_kb = key - 49;
        }
    }
}
