// =============================================================================
// RENDERIZADOR PRINCIPAL DO ASSISTENTE GRAFICO (TEMA CLARO)
// =============================================================================

@system
pub fn baken_installer_render(x: u32, y: u32, w: u32, h: u32) -> void {
    unsafe {
        INSTALLER.anim_frame_remainder += INSTALLER.frame_delta * 60.0;
        let advance = INSTALLER.anim_frame_remainder as u32;
        INSTALLER.anim_frame_remainder -= advance as f32;
        INSTALLER.anim_tick = (INSTALLER.anim_tick + advance) % 3600;
        if (INSTALLER.transition_tick < 36) {
            INSTALLER.transition_tick += advance;
            if (INSTALLER.transition_tick > 36) { INSTALLER.transition_tick = 36; }
        }
        if (INSTALLER.toast_tick > advance) { INSTALLER.toast_tick -= advance; }
        else { INSTALLER.toast_tick = 0; }
        let step = INSTALLER.step;

        // 1. Papel de parede dinâmico estilo macOS Tahoe Light Edition
        bakenfx_draw_desktop_background(sotlas_get_default_canvas(), w, h);
        bakenfx_capture_backdrop();

        if (step == 0) {
            render_welcome(x, y, w, h);
            render_toast(w);
            return;
        }

        // 2. Timeline Stepper Lateral Flutuante
        render_aurora_shell(x, y, w, h, min_u32(step, 5));

        // 3. Slide Parallax com Mola Elástica CASpring
        let spring_t = if (INSTALLER.transition_tick >= 36) { 1.0 } else { (INSTALLER.transition_tick as f32) / 36.0 };
        let spring_val = anim_caspring_f32(spring_t);
        let slide_ox = if (INSTALLER.transition_tick < 36) {
            (INSTALLER.transition_direction as f32 * (1.0 - spring_val) * 40.0) as i32
        } else {
            0
        };
        let target_x = (x as i32 + slide_ox) as u32;

        // 4. Renderizacao da Etapa Atual
        if (step == 1) {
            render_language_keyboard(target_x, y, w, h);
        } else if (step == 2) {
            render_mode_choice(target_x, y, w, h);
        } else if (step == 3) {
            render_disk_selection(target_x, y, w, h);
        } else if (step == 4) {
            render_review_confirmation(target_x, y, w, h);
        } else if (step == 5) {
            render_installing_progress(target_x, y, w, h);
        } else if (step == 6) {
            render_complete_summary(target_x, y, w, h);
        } else if (step == 7) {
            render_repair_tools(target_x, y, w, h);
        } else {
            render_oobe_experience(target_x, y, w, h);
        }

        // 5. Chips de Atalhos de Teclado no Rodape
        render_keyboard_chips(x, y, w, h);

        // 6. Toasts Flutuantes de Notificacao
        render_toast(w);
    }
}

// Renderiza barra de atalhos flutuante no rodape
@system
fn render_keyboard_chips(x: u32, y: u32, w: u32, h: u32) -> void {
    let chip_y = y + h - 30;
    let chip_w: u32 = 390;
    let chip_x = x + (if (w > chip_w) { (w - chip_w) / 2 } else { 10 });
    if (w >= 640 && h >= 400) {
        material_draw_glass_panel(chip_x, chip_y, chip_w, 24, 0x00FFFFFF, 220, 0x00CBD5E1, 7);
        raster_draw_text_alpha(chip_x + 16, chip_y + 5, "[ Enter ] Avancar".as_ptr(), 0x000284C7, 1, 255);
        raster_draw_text_alpha(chip_x + 150, chip_y + 5, "[ Esc ] Voltar".as_ptr(), 0x0064748B, 1, 220);
        raster_draw_text_alpha(chip_x + 268, chip_y + 5, "[ 1..9 ] Opcoes".as_ptr(), 0x000284C7, 1, 240);
    }
}

// Renderiza Notificacao Toast Flutuante no Topo
@system
fn render_toast(w: u32) -> void {
    unsafe {
        if (INSTALLER.toast_tick == 0 || INSTALLER.toast_text == (null as *const u8)) { return; }
        let tw = raster_measure_text(INSTALLER.toast_text);
        let toast_w = tw + 40;
        let toast_x = (w - toast_w) / 2;
        let alpha: u8 = if (INSTALLER.toast_tick > 15) { 240 } else { ((INSTALLER.toast_tick * 240) / 15) as u8 };

        draw_specular_card(toast_x, 16, toast_w, 32, 0x00FFFFFF, alpha, 0x00CBD5E1, 16);
        raster_draw_circle_alpha(toast_x + 16, 32, 5, 0x0010B981, alpha);
        raster_draw_text_alpha(toast_x + 28, 23, INSTALLER.toast_text, 0x000F172A, 1, alpha);
    }
}

// Timeline Stepper Lateral Flutuante
@system
fn render_aurora_shell(x: u32, y: u32, w: u32, h: u32, active_step: u32) -> void {
    let lang_idx = get_lang();
    if (w >= 760) {
        // Painel Esquerdo em Vidro Claro Translúcido
        draw_specular_card(x + 16, y + 16, 216, h - 32, 0x00FFFFFF, 215, 0x00CBD5E1, 16);
        
        // Emblema Oficial Swirl Baken OS
        raster_draw_baken_logo(x + 32, y + 36, 36, 255);
        raster_draw_text_alpha(x + 76, y + 38, "BAKEN OS".as_ptr(), 0x000F172A, 1, 255);
        raster_draw_text_alpha(x + 76, y + 58, "Setup & OOBE".as_ptr(), 0x000284C7, 1, 240);

        // Itens da Timeline Conectada
        for mut i in 0..6 {
            let py = y + 106 + ((i as u32) * 44);
            let is_past_or_current = (i as u32) <= active_step;
            let dot_color = if (is_past_or_current) { 0x000284C7 } else { 0x00CBD5E1 };

            // Linha conectora vertical
            if (i < 5) {
                let line_c = if ((i as u32) < active_step) { 0x000284C7 } else { 0x00E2E8F0 };
                raster_fill_rect_alpha(x + 47, py + 14, 2, 30, line_c, 210);
            }

            // Anel do Ponto da Timeline
            raster_draw_circle_alpha(x + 48, py + 8, 6, dot_color, 255);
            if (i as u32 == active_step) {
                raster_draw_circle_alpha(x + 48, py + 8, 11, 0x000284C7, 65);
                raster_draw_circle_alpha(x + 48, py + 8, 16, 0x0038BDF8, 25);
            }

            let txt = STR_SIDEBAR_STEPS[lang_idx][i];
            let txt_color = if (i as u32 == active_step) { 0x000F172A } else if (is_past_or_current) { 0x000284C7 } else { 0x0064748B };
            raster_draw_text_alpha(x + 66, py, txt, txt_color, 1, 250);
        }

        // Badge de Privacidade no Rodape Lateral
        let priv_y = y + h - 68;
        material_draw_glass_panel(x + 24, priv_y, 200, 32, 0x00ECFDF5, 220, 0x0010B981, 8);
        raster_draw_circle_alpha(x + 38, priv_y + 16, 4, 0x0010B981, 255);
        raster_draw_text_alpha(x + 50, priv_y + 9, "Zero Telemetria Nativa".as_ptr(), 0x00059669, 1, 250);
    }
}

// Tela 0: Boas-Vindas com Card Central Flutuante em Alta Resolução
@system
fn render_welcome(x: u32, y: u32, w: u32, h: u32) -> void {
    unsafe {
        let cw: u32 = if (w > 800) { 740 } else { w - 32 };
        let ch: u32 = if (h > 560) { 440 } else { h - 40 };
        let cx = x + (w - cw) / 2;

        let float_dy: i32 = 0;
        let base_cy = if (h > ch) { (h - ch) / 2 - 12 } else { 10 };
        let cy = (y as i32 + base_cy as i32 + float_dy) as u32;

        // Card Hero central com material translúcido Liquid Glass estilo macOS Light.
        material_draw_macos_card(cx, cy, cw, ch, 24, false);
        // Controle de energia Baken
        material_draw_close_button(cx + cw - 30, cy + 24);

        let logo_x = cx + (cw / 2);
        let logo_y = cy + 80;
        
        // Anel externo pulsante
        let outer_glow_a = anim_pulse_glow(INSTALLER.anim_tick, 180, 12, 40);
        raster_draw_circle_alpha(logo_x, logo_y, 64, 0x0038BDF8, outer_glow_a);
        raster_draw_circle_alpha(logo_x, logo_y, 56, 0x000284C7, 20);
        raster_draw_circle_alpha(logo_x, logo_y, 48, 0x0038BDF8, 36);
        raster_draw_circle_alpha(logo_x, logo_y, 44, 0x00FFFFFF, 45);
        raster_draw_baken_logo(logo_x - 42, logo_y - 42, 84, 255);

        // Título "BAKEN OS" em tom escuro de alto contraste
        let t1 = "BAKEN OS";
        let t1_w = raster_measure_title_text(t1.as_ptr());
        raster_draw_title_text_alpha(logo_x - (t1_w / 2), logo_y + 54, t1.as_ptr(), 0x000F172A, 255);

        // Ticker Multilíngue com Física de Mola Apple
        let lang_period: u32 = 156;
        let cur_idx = ((INSTALLER.anim_tick / lang_period) % 11) as usize;
        let next_idx = ((cur_idx + 1) % 11) as usize;
        let phase = INSTALLER.anim_tick % lang_period;

        let mut show_idx = cur_idx;
        let mut alpha: u8 = 255;
        let mut y_off: i32 = 0;

        if (phase < 44) {
            show_idx = cur_idx;
            alpha = 255;
            y_off = 0;
        } else if (phase < 52) {
            let out_prog = (phase - 44) as f32 / 8.0;
            let spring_out = anim_caspring_f32(out_prog);
            show_idx = cur_idx;
            alpha = (255.0 * (1.0 - out_prog)) as u8;
            y_off = -((spring_out * 8.0) as i32);
        } else {
            let in_prog = (phase - 52) as f32 / 12.0;
            let spring_in = anim_caspring_f32(in_prog);
            show_idx = next_idx;
            alpha = (255.0 * (if in_prog < 1.0 { in_prog } else { 1.0 })) as u8;
            y_off = ((1.0 - spring_in) * 10.0) as i32;
        }
        
        let t2_y = (logo_y as i32 + 96 + y_off) as u32;
        let sub_color: u32 = 0x000369A1;
        if (show_idx == 6) {
            raster_draw_cjk_item(logo_x - 37, t2_y, 2, sub_color, alpha);
        } else if (show_idx == 7) {
            raster_draw_cjk_item(logo_x - 18, t2_y, 0, sub_color, alpha);
        } else if (show_idx == 8) {
            raster_draw_cjk_item(logo_x - 26, t2_y, 1, sub_color, alpha);
        } else {
            let t2 = i18n_welcome_text_for_lang(show_idx);
            let t2_w = raster_measure_text(t2);
            raster_draw_text_alpha(logo_x - (t2_w / 2), t2_y, t2, sub_color, 1, alpha);
        }

        // Botão Central com Atração Magnética
        let start_w: u32 = 320;
        let start_h: u32 = 52;
        let base_x = logo_x - (start_w / 2);
        let base_y = logo_y + 138;

        let mx = baken_cursor_get_x();
        let my = baken_cursor_get_y();
        let is_hover = mx >= base_x as i32 && mx <= (base_x + start_w) as i32 &&
                       my >= base_y as i32 && my <= (base_y + start_h) as i32;

        let mag_dx = if is_hover { (mx - (base_x as i32 + (start_w as i32 / 2))) / 10 } else { 0 };
        let mag_dy = if is_hover { (my - (base_y as i32 + (start_h as i32 / 2))) / 10 } else { 0 };
        let start_x = (base_x as i32 + mag_dx) as u32;
        let start_y = (base_y as i32 + mag_dy) as u32;

        draw_interactive_btn(start_x, start_y, start_w, start_h, i18n_btn_start_for_lang(show_idx), true, is_hover);

        if is_hover {
            let shimmer_pos = anim_shimmer_offset(INSTALLER.anim_tick, 120, start_w);
            let shimmer_w: u32 = 40;
            if shimmer_pos > 0 && shimmer_pos < start_w {
                let sx = start_x + shimmer_pos;
                let sw = if sx + shimmer_w > start_x + start_w { start_x + start_w - sx } else { shimmer_w };
                raster_fill_rect_alpha(sx, start_y + 2, sw, start_h - 4, 0x00FFFFFF, 45);
            }
        }

        // Rodapé de Links Multilíngue
        let footer_fade = if (INSTALLER.anim_tick < 60) {
            anim_fade_slide_alpha(INSTALLER.anim_tick, 60, 0)
        } else { 255 as u8 };
        let link_y = if (h > 50) { h - 40 } else { 10 };
        let footer_text = i18n_footer_help_for_lang(show_idx);
        let base_fa = if (phase < 44) { 245 } else { (alpha as u32 * 245 / 255) as u8 };
        let footer_alpha = ((base_fa as u32 * footer_fade as u32) / 255) as u8;
        raster_draw_text_alpha(x + 36, link_y, footer_text, 0x00334155, 1, footer_alpha);
        let cr = "Baken OS - TasteTrack Systems LTDA";
        let cr_w = raster_measure_text(cr.as_ptr());
        let cr_a = ((210 as u32 * footer_fade as u32) / 255) as u8;
        raster_draw_text_alpha(x + w - cr_w - 36, link_y, cr.as_ptr(), 0x00475569, 1, cr_a);
    }
}

// Tela 1: Selecao de 11 Idiomas e Layout de Teclado
@system
fn render_language_keyboard(x: u32, y: u32, w: u32, h: u32) -> void {
    unsafe {
        let lang_idx = get_lang();
        let cx = if (w >= 760) { x + 258 } else { x + 24 };
        let cw = if (w >= 760) { w - 288 } else { w - 48 };

        // Titulo e Subtitulo em Tema Claro
        raster_draw_text_alpha(cx, y + 36, STR_LANG_TITLE[lang_idx], 0x000F172A, 1, 255);
        raster_draw_text_alpha(cx, y + 60, STR_LANG_SUB[lang_idx], 0x0064748B, 1, 240);

        let col_w = (cw - 20) / 2;
        let stagger_elapsed = if (INSTALLER.anim_tick >= INSTALLER.stagger_base) { INSTALLER.anim_tick - INSTALLER.stagger_base } else { 60 };

        // Coluna 1 (Idiomas 0 a 5)
        for mut i in 0..6 {
            let item_fade = anim_fade_slide_alpha(stagger_elapsed, 16, (i as u32) * 2);
            let slide_y = (((255 - item_fade as i32) * 8) / 255) as u32;
            let ly = y + 96 + (i * 48) + slide_y;
            let is_sel = (INSTALLER.selected_lang == (i as u32));
            let bg_c = if (is_sel) { 0x00E0F2FE } else { 0x00FFFFFF };
            let border_c = if (is_sel) { 0x000284C7 } else { 0x00CBD5E1 };
            let base_a: u8 = if (is_sel) { 245 } else { 210 };
            let alpha = ((base_a as u32 * item_fade as u32) / 255) as u8;

            draw_specular_card(cx, ly, col_w, 42, bg_c, alpha, border_c, 10);
            raster_draw_circle_alpha(cx + 20, ly + 21, 6, if (is_sel) { 0x000284C7 } else { 0x00CBD5E1 }, alpha);
            raster_draw_text_alpha(cx + 38, ly + 11, STR_NATIVE_LANGS[i], if (is_sel) { 0x000369A1 } else { 0x000F172A }, 1, alpha);
        }

        // Coluna 2 (Idiomas 6 a 10)
        let col2_x = cx + col_w + 20;
        for mut j in 6..11 {
            let item_fade = anim_fade_slide_alpha(stagger_elapsed, 16, ((j as u32) - 6) * 2 + 1);
            let slide_y = (((255 - item_fade as i32) * 8) / 255) as u32;
            let ly = y + 96 + ((j - 6) * 48) + slide_y;
            let is_sel = (INSTALLER.selected_lang == (j as u32));
            let bg_c = if (is_sel) { 0x00E0F2FE } else { 0x00FFFFFF };
            let border_c = if (is_sel) { 0x000284C7 } else { 0x00CBD5E1 };
            let base_a: u8 = if (is_sel) { 245 } else { 210 };
            let alpha = ((base_a as u32 * item_fade as u32) / 255) as u8;
            let text_color = if (is_sel) { 0x000369A1 } else { 0x000F172A };

            material_draw_glass_panel(col2_x, ly, col_w, 42, bg_c, alpha, border_c, 10);
            raster_draw_circle_alpha(col2_x + 20, ly + 21, 6, if (is_sel) { 0x000284C7 } else { 0x00CBD5E1 }, alpha);

            if (j == 6) {
                raster_draw_text_alpha(col2_x + 38, ly + 11, "7. ".as_ptr(), text_color, 1, alpha);
                raster_draw_cjk_item(col2_x + 58, ly + 11, 2, text_color, alpha);
                raster_draw_text_alpha(col2_x + 140, ly + 11, "(Grego / EL)".as_ptr(), 0x0064748B, 1, ((210 as u32 * item_fade as u32) / 255) as u8);
            } else if (j == 7) {
                raster_draw_text_alpha(col2_x + 38, ly + 11, "8. ".as_ptr(), text_color, 1, alpha);
                raster_draw_cjk_item(col2_x + 58, ly + 11, 0, text_color, alpha);
                raster_draw_text_alpha(col2_x + 102, ly + 11, "(Chines / ZH)".as_ptr(), 0x0064748B, 1, ((210 as u32 * item_fade as u32) / 255) as u8);
            } else if (j == 8) {
                raster_draw_text_alpha(col2_x + 38, ly + 11, "9. ".as_ptr(), text_color, 1, alpha);
                raster_draw_cjk_item(col2_x + 58, ly + 11, 1, text_color, alpha);
                raster_draw_text_alpha(col2_x + 118, ly + 11, "(Japones / JA)".as_ptr(), 0x0064748B, 1, ((210 as u32 * item_fade as u32) / 255) as u8);
            } else {
                raster_draw_text_alpha(col2_x + 38, ly + 11, STR_NATIVE_LANGS[j], text_color, 1, alpha);
            }
        }

        // Botoes de Navegacao Inferiores
        let bot_y = y + h - 70;
        draw_interactive_btn(cx, bot_y, 120, 42, i18n_btn_back(), false, false);
        draw_interactive_btn(cx + cw - 160, bot_y, 160, 42, i18n_btn_next(), true, true);
    }
}

// Tela 2: Selecao de Modo de Uso
@system
fn render_mode_choice(x: u32, y: u32, w: u32, h: u32) -> void {
    unsafe {
        let lang_idx = get_lang();
        let cx = if (w >= 760) { x + 258 } else { x + 24 };
        let cw = if (w >= 760) { w - 288 } else { w - 48 };

        raster_draw_text_alpha(cx, y + 36, STR_MODE_TITLE[lang_idx], 0x000F172A, 1, 255);
        raster_draw_text_alpha(cx, y + 60, STR_MODE_SUB[lang_idx], 0x0064748B, 1, 240);

        let stagger_elapsed = if (INSTALLER.anim_tick >= INSTALLER.stagger_base) { INSTALLER.anim_tick - INSTALLER.stagger_base } else { 60 };

        // Opcao 1: Instalacao Definitiva
        let f0 = anim_fade_slide_alpha(stagger_elapsed, 16, 0);
        let s0 = (((255 - f0 as i32) * 8) / 255) as u32;
        let is_m0 = (INSTALLER.selected_mode == 0);
        let bg0 = if (is_m0) { 0x00E0F2FE } else { 0x00FFFFFF };
        let brd0 = if (is_m0) { 0x000284C7 } else { 0x00CBD5E1 };
        let a0 = (((if (is_m0) { 245 } else { 210 }) as u32 * f0 as u32) / 255) as u8;
        draw_specular_card(cx, y + 96 + s0, cw, 72, bg0, a0, brd0, 10);
        raster_draw_circle_alpha(cx + 24, y + 132 + s0, 7, if (is_m0) { 0x0010B981 } else { 0x00CBD5E1 }, f0);
        raster_draw_text_alpha(cx + 44, y + 108 + s0, STR_M1_TITLE[lang_idx], if (is_m0) { 0x000369A1 } else { 0x000F172A }, 1, f0);
        raster_draw_text_alpha(cx + 44, y + 132 + s0, STR_M1_DESC[lang_idx], 0x0064748B, 1, ((240 as u32 * f0 as u32) / 255) as u8);

        // Opcao 2: Modo Live RAM
        let f1 = anim_fade_slide_alpha(stagger_elapsed, 16, 4);
        let s1 = (((255 - f1 as i32) * 8) / 255) as u32;
        let is_m1 = (INSTALLER.selected_mode == 1);
        let bg1 = if (is_m1) { 0x00E0F2FE } else { 0x00FFFFFF };
        let brd1 = if (is_m1) { 0x000284C7 } else { 0x00CBD5E1 };
        let a1 = (((if (is_m1) { 245 } else { 210 }) as u32 * f1 as u32) / 255) as u8;
        draw_specular_card(cx, y + 180 + s1, cw, 72, bg1, a1, brd1, 10);
        raster_draw_circle_alpha(cx + 24, y + 216 + s1, 7, if (is_m1) { 0x0010B981 } else { 0x00CBD5E1 }, f1);
        raster_draw_text_alpha(cx + 44, y + 192 + s1, STR_M2_TITLE[lang_idx], if (is_m1) { 0x000369A1 } else { 0x000F172A }, 1, f1);
        raster_draw_text_alpha(cx + 44, y + 216 + s1, STR_M2_DESC[lang_idx], 0x0064748B, 1, ((240 as u32 * f1 as u32) / 255) as u8);

        // Opcao 3: Benchmark
        let f2 = anim_fade_slide_alpha(stagger_elapsed, 16, 8);
        let s2 = (((255 - f2 as i32) * 8) / 255) as u32;
        let is_m2 = (INSTALLER.selected_mode == 2);
        let bg2 = if (is_m2) { 0x00FEF3C7 } else { 0x00FFFFFF };
        let brd2 = if (is_m2) { 0x00F59E0B } else { 0x00CBD5E1 };
        let a2 = (((if (is_m2) { 245 } else { 210 }) as u32 * f2 as u32) / 255) as u8;
        draw_specular_card(cx, y + 264 + s2, cw, 68, bg2, a2, brd2, 10);
        raster_draw_circle_alpha(cx + 24, y + 298 + s2, 7, if (is_m2) { 0x00F59E0B } else { 0x00CBD5E1 }, f2);
        raster_draw_text_alpha(cx + 44, y + 276 + s2, "Teste de Desempenho e Telemetria de Hardware".as_ptr(), if (is_m2) { 0x00B45309 } else { 0x000F172A }, 1, f2);
        raster_draw_text_alpha(cx + 44, y + 300 + s2, "Executa benchmark completo de CPU, RAM, SSD e Framebuffer.".as_ptr(), 0x0064748B, 1, ((240 as u32 * f2 as u32) / 255) as u8);

        let bot_y = y + h - 68;
        draw_interactive_btn(cx, bot_y, 110, 38, STR_BTN_BACK[lang_idx], false, false);
        draw_interactive_btn(cx + cw - 150, bot_y, 150, 38, STR_BTN_NEXT[lang_idx], true, true);
    }
}

// Tela 3: Selecao de Disco com Grafico Visual
@system
fn render_disk_selection(x: u32, y: u32, w: u32, h: u32) -> void {
    unsafe {
        let lang_idx = get_lang();
        let cx = if (w >= 760) { x + 258 } else { x + 24 };
        let cw = if (w >= 760) { w - 288 } else { w - 48 };

        raster_draw_text_alpha(cx, y + 36, STR_DISK_TITLE[lang_idx], 0x000F172A, 1, 255);
        raster_draw_text_alpha(cx, y + 60, STR_DISK_SUB[lang_idx], 0x0064748B, 1, 240);

        // Cartao do Disco NVMe SSD
        draw_specular_card(cx, y + 96, cw, 78, 0x00E0F2FE, 240, 0x000284C7, 10);
        raster_draw_circle_alpha(cx + 24, y + 135, 7, 0x0010B981, 255);
        raster_draw_text_alpha(cx + 44, y + 108, "NVMe SSD Principal — 512.0 GB [ALVO GRAVAVEL]".as_ptr(), 0x000369A1, 1, 255);
        raster_draw_text_alpha(cx + 44, y + 130, "Unidade de armazenamento veloz para instalacao nativa com BakenFS.".as_ptr(), 0x00334155, 1, 240);

        // Diagrama Visual de Particionamento
        let bar_y = y + 190;
        draw_specular_card(cx, bar_y, cw, 64, 0x00FFFFFF, 220, 0x00CBD5E1, 8);
        raster_draw_text_alpha(cx + 16, bar_y + 8, "Esquema de Particoes Planejado (Tabela GPT):".as_ptr(), 0x000284C7, 1, 240);

        let p_bar_w = cw - 32;
        let esp_w = min_u32(p_bar_w * 15 / 100, 80);
        let root_w = p_bar_w - esp_w - 30;
        let p_x = cx + 16;
        let p_y = bar_y + 30;

        // Bloco 1: ESP FAT32 (Verde Esmeralda)
        raster_fill_rect_alpha(p_x, p_y, esp_w, 20, 0x0010B981, 240);
        raster_draw_text_alpha(p_x + 6, p_y + 4, "ESP (512MB)".as_ptr(), 0x00FFFFFF, 1, 255);

        // Bloco 2: BakenFS Sistema (Azul Eletrico)
        raster_fill_rect_alpha(p_x + esp_w + 4, p_y, root_w, 20, 0x000284C7, 240);
        raster_draw_text_alpha(p_x + esp_w + 14, p_y + 4, "BakenFS Raiz com Snapshots (476.5 GB)".as_ptr(), 0x00FFFFFF, 1, 255);

        // Bloco 3: Espaco Livre
        raster_fill_rect_alpha(p_x + esp_w + root_w + 8, p_y, 22, 20, 0x0094A3B8, 200);

        // Aviso de Seguranca
        draw_specular_card(cx, y + 268, cw, 44, 0x00FEF3C7, 220, 0x00F59E0B, 8);
        raster_draw_circle_alpha(cx + 20, y + 290, 5, 0x00F59E0B, 255);
        raster_draw_text_alpha(cx + 34, y + 280, "Aviso: Todos os dados na particao selecionada serao formatados com integridade.".as_ptr(), 0x0092400E, 1, 240);

        let bot_y = y + h - 68;
        draw_interactive_btn(cx, bot_y, 110, 38, STR_BTN_BACK[lang_idx], false, false);
        draw_interactive_btn(cx + cw - 150, bot_y, 150, 38, STR_BTN_NEXT[lang_idx], true, true);
    }
}

// Tela 4: Revisao Final de Parametros
@system
fn render_review_confirmation(x: u32, y: u32, w: u32, h: u32) -> void {
    unsafe {
        let lang_idx = get_lang();
        let cx = if (w >= 760) { x + 258 } else { x + 24 };
        let cw = if (w >= 760) { w - 288 } else { w - 48 };

        raster_draw_text_alpha(cx, y + 36, "Revise suas Preferencias antes de Gravar".as_ptr(), 0x000F172A, 1, 255);
        raster_draw_text_alpha(cx, y + 60, "Tudo pronto para iniciar a instalacao automatizada do microkernel Baken OS.".as_ptr(), 0x0064748B, 1, 240);

        // Quadro Resumo em Vidro Claro
        draw_specular_card(cx, y + 96, cw, 170, 0x00FFFFFF, 220, 0x00CBD5E1, 10);
        raster_draw_text_alpha(cx + 20, y + 112, "• Idioma e Teclado:".as_ptr(), 0x000284C7, 1, 255);
        raster_draw_text_alpha(cx + 200, y + 112, STR_NATIVE_LANGS[lang_idx], 0x000F172A, 1, 255);

        raster_draw_text_alpha(cx + 20, y + 142, "• Modo Selecionado:".as_ptr(), 0x000284C7, 1, 255);
        raster_draw_text_alpha(cx + 200, y + 142, "Instalacao Nativa GPT + BakenFS".as_ptr(), 0x000F172A, 1, 255);

        raster_draw_text_alpha(cx + 20, y + 172, "• Unidade Destino:".as_ptr(), 0x000284C7, 1, 255);
        raster_draw_text_alpha(cx + 200, y + 172, "NVMe SSD Principal (512 GB)".as_ptr(), 0x00059669, 1, 255);

        raster_draw_text_alpha(cx + 20, y + 202, "• Privacidade & Telemetria:".as_ptr(), 0x000284C7, 1, 255);
        raster_draw_text_alpha(cx + 200, y + 202, "Zero Telemetria (100% Offline e Privado)".as_ptr(), 0x00059669, 1, 255);

        raster_draw_text_alpha(cx + 20, y + 232, "• Seguranca de Snapshots:".as_ptr(), 0x000284C7, 1, 255);
        raster_draw_text_alpha(cx + 200, y + 232, "Ativo (Ponto de restauracao inicial sera criado)".as_ptr(), 0x00334155, 1, 240);

        let bot_y = y + h - 68;
        draw_interactive_btn(cx, bot_y, 110, 38, STR_BTN_BACK[lang_idx], false, false);
        draw_interactive_btn(cx + cw - 180, bot_y, 180, 38, STR_BTN_INSTALL[lang_idx], true, true);
    }
}

// Tela 5: Progresso de Instalacao
@system
fn render_installing_progress(x: u32, y: u32, w: u32, h: u32) -> void {
    unsafe {
        let cx = if (w >= 760) { x + 258 } else { x + 24 };
        let cw = if (w >= 760) { w - 288 } else { w - 48 };

        let logo_cx = cx + (cw / 2);
        let logo_cy = y + 74;
        let pulse = 24 + ((raster_smoothstep_u8(INSTALLER.anim_tick % 60, 60) as u32 * 6) / 255);
        raster_draw_circle_alpha(logo_cx, logo_cy, pulse + 14, 0x0038BDF8, 35);
        raster_draw_circle_alpha(logo_cx, logo_cy, pulse + 4, 0x000284C7, 70);
        raster_draw_baken_logo(logo_cx - 30, logo_cy - 30, 60, 255);

        raster_draw_text_alpha(cx + (cw - 320) / 2, y + 128, "Gravando Baken OS no Armazenamento...".as_ptr(), 0x000F172A, 1, 255);

        // Barra de Progresso com Bloom e Gradiente
        let pb_w = cw - 40;
        let pbx = cx + 20;
        let pby = y + 160;
        draw_specular_card(pbx, pby, pb_w, 14, 0x00FFFFFF, 220, 0x00CBD5E1, 7);

        let prog_w = (pb_w * INSTALLER.install_progress) / 100;
        if (prog_w > 4) {
            raster_fill_rect_alpha(pbx + 2, pby + 2, prog_w - 4, 10, 0x000284C7, 255);
            let shim_off = anim_shimmer_offset(INSTALLER.anim_tick, 80, prog_w);
            if (shim_off > 0 && shim_off < prog_w) {
                let shim_w = if (shim_off + 24 > prog_w) { prog_w - shim_off } else { 24 };
                raster_fill_rect_alpha(pbx + 2 + shim_off, pby + 2, shim_w, 10, 0x00FFFFFF, 80);
            }
            let tip_glow = anim_pulse_glow(INSTALLER.anim_tick, 45, 80, 160);
            raster_draw_circle_alpha(pbx + prog_w - 2, pby + 7, 7, 0x0038BDF8, tip_glow);
            raster_draw_circle_alpha(pbx + prog_w - 2, pby + 7, 12, 0x000284C7, tip_glow / 3);
        }

        // Etapas de Telemetria Detalhada
        let substeps = [
            "1. Criando tabela de particoes GPT e volume ESP FAT32...".as_ptr(),
            "2. Formatando volume de dados BakenFS com suporte a snapshots...".as_ptr(),
            "3. Instalando microkernel Sotlas e drivers nativos UEFI...".as_ptr(),
            "4. Configurando ponto de restauracao inicial e finalizando...".as_ptr()
        ];

        for mut s in 0..4 {
            let sy = y + 200 + (s * 30);
            let is_s_done = ((s as u32) < INSTALLER.install_substep);
            let is_s_cur = ((s as u32) == INSTALLER.install_substep);
            let s_col = if (is_s_done) { 0x0010B981 } else if (is_s_cur) { 0x000284C7 } else { 0x0094A3B8 };

            raster_draw_circle_alpha(cx + 20, sy + 7, 4, s_col, 255);
            raster_draw_text_alpha(cx + 34, sy, substeps[s], if (is_s_cur) { 0x000F172A } else { 0x0064748B }, 1, 240);
        }
    }
}

// Tela 6: Conclusao
@system
fn render_complete_summary(x: u32, y: u32, w: u32, h: u32) -> void {
    unsafe {
        let lang_idx = get_lang();
        let cx = if (w >= 760) { x + 258 } else { x + 24 };
        let cw = if (w >= 760) { w - 288 } else { w - 48 };

        let logo_cx = cx + (cw / 2);
        let logo_cy = y + 78;

        let bounce_t = if (INSTALLER.transition_tick >= 36) { 1.0 } else { (INSTALLER.transition_tick as f32) / 36.0 };
        let bounce_factor = anim_spring_bounce(bounce_t);
        let ring_r = ((38.0 * bounce_factor) as i32);
        let eff_r: u32 = if ring_r < 10 { 10 } else { ring_r as u32 };

        let glow_pulse = anim_pulse_glow(INSTALLER.anim_tick, 120, 40, 90);
        raster_draw_circle_alpha(logo_cx, logo_cy, eff_r + 12, 0x0010B981, glow_pulse);
        raster_draw_circle_alpha(logo_cx, logo_cy, eff_r, 0x0010B981, 240);
        raster_draw_circle_alpha(logo_cx, logo_cy, (eff_r * 4) / 5, 0x000284C7, 180);
        raster_draw_baken_logo(logo_cx - 24, logo_cy - 24, 48, 255);

        let orb_phase = (INSTALLER.anim_tick * 2) % 256;
        let orb1_x = logo_cx as i32 + anim_orbit_cos(orb_phase, (eff_r + 18) as i32);
        let orb1_y = logo_cy as i32 + anim_orbit_sin(orb_phase, (eff_r + 18) as i32);
        raster_draw_circle_alpha(orb1_x as u32, orb1_y as u32, 3, 0x000284C7, 200);

        let orb2_x = logo_cx as i32 + anim_orbit_cos((orb_phase + 128) % 256, (eff_r + 15) as i32);
        let orb2_y = logo_cy as i32 + anim_orbit_sin((orb_phase + 128) % 256, (eff_r + 15) as i32);
        raster_draw_circle_alpha(orb2_x as u32, orb2_y as u32, 2, 0x0010B981, 180);

        let t = "Tudo Pronto! Baken OS Instalado com Sucesso";
        let tw = raster_measure_text(t.as_ptr());
        raster_draw_text_alpha(cx + (if (cw > tw) { (cw - tw) / 2 } else { 10 }), y + 140, t.as_ptr(), 0x00059669, 1, 255);

        let sub = "Seu ambiente nativo com BakenFS esta pronto para ser explorado.";
        let sw = raster_measure_text(sub.as_ptr());
        raster_draw_text_alpha(cx + (if (cw > sw) { (cw - sw) / 2 } else { 10 }), y + 168, sub.as_ptr(), 0x00334155, 1, 240);

        // Cartao Informativo de Status
        draw_specular_card(cx + 20, y + 204, cw - 40, 48, 0x00ECFDF5, 220, 0x0010B981, 8);
        raster_draw_text_alpha(cx + 36, y + 218, "Privacidade: 100% Nativo Local  •  BakenFS: Protegido  •  Drivers: Carregados".as_ptr(), 0x00065F46, 1, 255);

        let bot_y = y + h - 68;
        let btn_w: u32 = 320;
        let btn_x = cx + (if (cw > btn_w) { (cw - btn_w) / 2 } else { 10 });
        draw_interactive_btn(btn_x, bot_y, btn_w, 44, STR_BTN_ENTER_DESKTOP[lang_idx], true, true);
    }
}

