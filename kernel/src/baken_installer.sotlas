    "• BakenFS Vault: Yu-za-暗号ka ga yuukou".as_ptr(),
    "• BakenFS Vault: User encryption sakriya".as_ptr(),
    "• BakenFS Vault: Usimbaji fiche wa mtumiaji umewashwa".as_ptr()
];
static STR_OOBE_BTN: [*const u8; 11] = [
    "Iniciar Desktop Baken >".as_ptr(),
    "Launch Baken Desktop >".as_ptr(),
    "Lancer le Bureau Baken >".as_ptr(),
    "Avvia Desktop Baken >".as_ptr(),
    "Iniciar Escritorio Baken >".as_ptr(),
