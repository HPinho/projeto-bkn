@system
fn render_installing_progress(x: u32, y: u32, w: u32, h: u32) -> void {
    unsafe {
        let lang_idx = get_lang();
        let cx = if (w >= 760) { x + 258 } else { x + 24 };
        let cw = if (w >= 760) { w - 288 } else { w - 48 };

        gfx_draw_text_alpha(cx, y + 36, STR_PROG_TITLE[lang_idx], 0x00FFFFFF, 1, 255);
        gfx_draw_text_alpha(cx, y + 60, STR_PROG_SUB[lang_idx], 0x0094A3B8, 1, 235);

        // Barra de Progresso com Pulso Ciano
        gfx_draw_glass_rect(cx, y + 104, cw, 16, 0x001E293B, 255, 0x00334155, 8);
        let cur_prog = INSTALLER.install_progress;
        if (cur_prog > 0) {
            let fill_w = ((cw - 4) * cur_prog) / 100;
            gfx_fill_rect_alpha(cx + 2, y + 106, fill_w, 12, 0x0000E5FF, 255);
        }

        let substeps = [
            STR_PROG_S1[lang_idx],
            STR_PROG_S2[lang_idx],
            STR_PROG_S3[lang_idx],
            STR_PROG_S4[lang_idx]
        ];

        for mut s in 0..4 {
            let sy = y + 144 + (s * 30) as u32;
            let is_s_cur = (s == INSTALLER.install_substep);
            let c_dot = if (is_s_cur) { 0x0000E5FF } else { 0x0010B981 };
            gfx_draw_circle_alpha(cx + 12, sy + 7, 5, c_dot, 255);
            gfx_draw_text_alpha(cx + 28, sy, substeps[s], if (is_s_cur) { 0x00FFFFFF } else { 0x0094A3B8 }, 1, 240);
        }
    }
}

@system
fn render_complete_summary(x: u32, y: u32, w: u32, h: u32) -> void {
    unsafe {
        let lang_idx = get_lang();
        let cx = if (w >= 760) { x + 258 } else { x + 24 };
        let cw = if (w >= 760) { w - 288 } else { w - 48 };

        gfx_draw_circle_alpha(cx + (cw / 2), y + 68, 32, 0x0010B981, 240);
        gfx_draw_baken_logo(cx + (cw / 2) - 18, y + 50, 36, 255);

        let t = STR_DONE_TITLE[lang_idx];
        let tw = gfx_measure_text(t);
        gfx_draw_text_alpha(cx + (cw - tw) / 2, y + 116, t, 0x00FFFFFF, 1, 255);

        let sub = STR_DONE_SUB[lang_idx];
        let sw = gfx_measure_text(sub);
        gfx_draw_text_alpha(cx + (cw - sw) / 2, y + 142, sub, 0x0038BDF8, 1, 230);

        let bot_y = y + h - 68;
        let btn_w: u32 = 260;
        let btn_x = cx + (cw - btn_w) / 2;
        gfx_draw_glass_rect(btn_x, bot_y, btn_w, 42, 0x000284C7, 240, 0x0000E5FF, 10);
        let r_txt = STR_DONE_BTN[lang_idx];
        let rw = gfx_measure_text(r_txt);
        gfx_draw_text_alpha(btn_x + (btn_w - rw) / 2, bot_y + 12, r_txt, 0x00FFFFFF, 1, 255);
    }
}

