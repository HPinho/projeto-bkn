// Baken OS - Sandbox de Capabilities e Isolamento Criptográfico Zero-Trust (Fase 16)
// Tokens de Capacidade Criptografados Assinados com Chaves ML-DSA-65 (FIPS 204)

module kernel::capabilities_vault;

pub enum SystemCapability {
    ReadFilesystem = 0x01,
    WriteFilesystem = 0x02,
    AccessGpuDirect = 0x04,
    AccessQuantumQpu = 0x08,
    NetworkRawSockets = 0x10,
    AudioRecording = 0x20,
    Ring0EnclaveCall = 0x40,
}

pub struct CapabilityToken {
    pub process_id: u32,
    pub allowed_caps_mask: u64,
    pub ml_dsa_signature: [u8; 64],
    pub valid_until_timestamp: u64,
    pub is_revoked: bool,
}

pub struct ZeroTrustEnclaveState {
    pub active_enclaves: u32,
    pub unauthorized_attempts_blocked: u32,
    pub security_score: f32, // 100.0%
}

static mut G_ENCLAVE_STATE: ZeroTrustEnclaveState = ZeroTrustEnclaveState {
    active_enclaves: 18,
    unauthorized_attempts_blocked: 0,
    security_score: 100.0,
};

// Valida token de capacidade assinado antes de conceder acesso ao hardware
@system
pub fn capabilities_verify_access(token: &CapabilityToken, required_cap: SystemCapability) -> bool {
    if token.is_revoked { return false; }
    let has_permission = (token.allowed_caps_mask & (required_cap as u64)) != 0;
    return has_permission;
}
