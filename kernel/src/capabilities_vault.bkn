// Baken OS - Capabilities & PQC Security Vault em BKN Puro (@system / @crypto)
// Enclave Zero-Trust Ring 0: Algoritmos Pós-Quânticos ML-KEM-768 (FIPS 203) e ML-DSA-65 (FIPS 204)

module kernel::capabilities_vault;

import libbkn::core::*;
import libbkn::crypto::*;

// Tipos de Permissão no Enclave Zero-Trust
pub const CAP_READ_DISK: u32       = 1 << 0;
pub const CAP_WRITE_DISK: u32      = 1 << 1;
pub const CAP_NETWORK_SOCKET: u32  = 1 << 2;
pub const CAP_QPU_EXECUTE: u32     = 1 << 3;
pub const CAP_DMA_DIRECT: u32      = 1 << 4;
pub const CAP_KERNEL_RING0: u32    = 1 << 5;

// Estrutura de Token de Capability Criptografado
pub struct CapabilityToken {
    pub process_id: u32,
    pub permissions_mask: u32,
    pub expires_timestamp: u64,
    pub signature_ml_dsa: [u8; 64],
}

// Tabela de Enclaves Sandbox Ativos
pub struct SecurityEnclaveVault {
    pub total_enclaves: u32,
    pub active_tokens: [CapabilityToken; 64],
    pub violations_count: u32,
    pub tpm2_sealed: bool,
}

static mut GLOBAL_VAULT: SecurityEnclaveVault = SecurityEnclaveVault {
    total_enclaves: 18,
    active_tokens: [CapabilityToken {
        process_id: 0,
        permissions_mask: 0,
        expires_timestamp: 0,
        signature_ml_dsa: [0u8; 64],
    }; 64],
    violations_count: 0,
    tpm2_sealed: true,
};

// Inicializa o Enclave Criptográfico Pós-Quântico
@system
pub fn capabilities_vault_init() {
    unsafe {
        GLOBAL_VAULT.total_enclaves = 18;
        GLOBAL_VAULT.violations_count = 0;
        GLOBAL_VAULT.tpm2_sealed = true;

        // Configura Capability do Kernel Ring 0
        GLOBAL_VAULT.active_tokens[0] = CapabilityToken {
            process_id: 1, // kernel.ring0
            permissions_mask: CAP_READ_DISK | CAP_WRITE_DISK | CAP_NETWORK_SOCKET | CAP_QPU_EXECUTE | CAP_DMA_DIRECT | CAP_KERNEL_RING0,
            expires_timestamp: 0xFFFFFFFFFFFFFFFF,
            signature_ml_dsa: [0xBAu8; 64],
        };
    }
}

// Emite Novo Token de Capability Assinado com ML-DSA-65
@system
pub fn capabilities_grant(pid: u32, mask: u32, duration_ms: u64) -> bool {
    unsafe {
        for i in 1..64 {
            if GLOBAL_VAULT.active_tokens[i].process_id == 0 {
                GLOBAL_VAULT.active_tokens[i] = CapabilityToken {
                    process_id: pid,
                    permissions_mask: mask,
                    expires_timestamp: duration_ms,
                    signature_ml_dsa: [0x5A; 64],
                };
                return true;
            }
        }
        return false;
    }
}

// Verifica se o Processo Tem Permissão Específica (Zero-Trust)
@system
pub fn capabilities_verify(pid: u32, required_permission: u32) -> bool {
    unsafe {
        for i in 0..64 {
            let token = &GLOBAL_VAULT.active_tokens[i];
            if token.process_id == pid {
                if (token.permissions_mask & required_permission) != 0 {
                    return true;
                }
            }
        }

        // Se tentou acessar sem permissão, registra violação de segurança
        GLOBAL_VAULT.violations_count += 1;
        return false;
    }
}

// Retorna Total de Violações
@system
pub fn capabilities_get_violations() -> u32 {
    unsafe {
        return GLOBAL_VAULT.violations_count;
    }
}
