// Baken OS - Compositor Gráfico em Árvore de Camadas em BKN Puro (@system)
// Gerenciamento de Z-Order, Superfícies de Janela Isoladas, Damage Regions e Double Buffering

module kernel::baken_compositor;

import kernel::bakenfx::*;
import kernel::baken_ui::*;
import kernel::graphics_engine::*;

pub struct LayerSurface {
    pub id: u32,
    pub x: i32,
    pub y: i32,
    pub width: u32,
    pub height: u32,
    pub z_index: u8,
    pub opacity: u8,
    pub is_visible: bool,
    pub buffer_ptr: u64,
}

pub struct DamageRect {
    pub x: u32,
    pub y: u32,
    pub width: u32,
    pub height: u32,
    pub is_dirty: bool,
}

pub struct CompositorContext {
    pub screen_width: u32,
    pub screen_height: u32,
    pub back_buffer_ptr: u64,
    pub front_buffer_ptr: u64,
    pub layer_count: usize,
    pub dirty_region: DamageRect,
}

static mut COMPOSITOR: CompositorContext = CompositorContext {
    screen_width: 1920,
    screen_height: 1080,
    back_buffer_ptr: 0,
    front_buffer_ptr: 0,
    layer_count: 0,
    dirty_region: DamageRect { x: 0, y: 0, width: 1920, height: 1080, is_dirty: true },
};

@system
pub fn compositor_init(front_fb: u64, back_fb: u64, w: u32, h: u32) {
    unsafe {
        COMPOSITOR.front_buffer_ptr = front_fb;
        COMPOSITOR.back_buffer_ptr = back_fb;
        COMPOSITOR.screen_width = w;
        COMPOSITOR.screen_height = h;
        COMPOSITOR.dirty_region.width = w;
        COMPOSITOR.dirty_region.height = h;
        COMPOSITOR.dirty_region.is_dirty = true;
    }
}

@system
pub fn compositor_mark_dirty(x: u32, y: u32, w: u32, h: u32) {
    unsafe {
        COMPOSITOR.dirty_region.is_dirty = true;
    }
}

@system
pub fn compositor_present_frame() {
    unsafe {
        if COMPOSITOR.front_buffer_ptr == 0 || COMPOSITOR.back_buffer_ptr == 0 {
            return;
        }

        // Swap de alta performance com cópia de 64-bit alinhada
        let total_words = ((COMPOSITOR.screen_width * COMPOSITOR.screen_height) / 2) as usize;
        let src64 = COMPOSITOR.back_buffer_ptr as *const u64;
        let dst64 = COMPOSITOR.front_buffer_ptr as *mut u64;

        for i in 0..total_words {
            *dst64.add(i) = *src64.add(i);
        }

        COMPOSITOR.dirty_region.is_dirty = false;
    }
}
