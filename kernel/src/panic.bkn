// Baken OS - Motor de Diagnóstico e Kernel Panic Soberano em BKN Puro (@system)
// Captura de Registradores x86_64, Análise de Page Fault e Tela de Diagnóstico Aero-Quantum

module kernel::panic;

import kernel::graphics_engine::*;

pub struct CpuFaultContext {
    pub rip: u64,
    pub rsp: u64,
    pub rax: u64,
    pub rbx: u64,
    pub rcx: u64,
    pub rdx: u64,
    pub rsi: u64,
    pub rdi: u64,
    pub rbp: u64,
    pub r8: u64,
    pub r9: u64,
    pub r10: u64,
    pub r11: u64,
    pub r12: u64,
    pub r13: u64,
    pub r14: u64,
    pub r15: u64,
    pub cr2: u64, // Endereço linear de falha (Page Fault)
    pub cr3: u64,
    pub rflags: u64,
    pub vector_id: u8,
    pub error_code: u64,
}

static mut LAST_FAULT: CpuFaultContext = CpuFaultContext {
    rip: 0, rsp: 0, rax: 0, rbx: 0, rcx: 0, rdx: 0, rsi: 0, rdi: 0, rbp: 0,
    r8: 0, r9: 0, r10: 0, r11: 0, r12: 0, r13: 0, r14: 0, r15: 0,
    cr2: 0, cr3: 0, rflags: 0, vector_id: 0, error_code: 0,
};

static EXCEPTION_NAMES: [*const u8; 20] = [
    b"#DE Divide-by-zero Error\0".as_ptr(),
    b"#DB Debug Exception\0".as_ptr(),
    b"#NMI Non-Maskable Interrupt\0".as_ptr(),
    b"#BP Breakpoint Trap\0".as_ptr(),
    b"#OF Overflow Trap\0".as_ptr(),
    b"#BR Bound Range Exceeded\0".as_ptr(),
    b"#UD Invalid Opcode\0".as_ptr(),
    b"#NM Device Not Available\0".as_ptr(),
    b"#DF Double Fault Exception\0".as_ptr(),
    b"#CSO Coprocessor Segment Overrun\0".as_ptr(),
    b"#TS Invalid TSS\0".as_ptr(),
    b"#NP Segment Not Present\0".as_ptr(),
    b"#SS Stack-Segment Fault\0".as_ptr(),
    b"#GP General Protection Fault\0".as_ptr(),
    b"#PF Page Fault\0".as_ptr(),
    b"#RES Reserved Exception\0".as_ptr(),
    b"#MF x87 FPU Floating-Point Error\0".as_ptr(),
    b"#AC Alignment Check\0".as_ptr(),
    b"#MC Machine Check\0".as_ptr(),
    b"#XM SIMD Floating-Point Exception\0".as_ptr(),
];

// Ponto Central de Tratamento de Exceções da CPU
@system
pub fn baken_handle_exception(ctx: *const CpuFaultContext) -> ! {
    unsafe {
        LAST_FAULT = *ctx;

        let sw = 1280u32;
        let sh = 720u32;

        // Fundo Azul Escuro Cósmico (#0B0F19)
        gfx_draw_glass_rect(0, 0, sw, sh, 0x000B0F19, 255, 0x00000000, 0);

        // Painel Central de Diagnóstico Translúcido com Borda Vermelha/Ciano
        let panel_w: u32 = 860;
        let panel_h: u32 = 480;
        let panel_x = (sw - panel_w) / 2;
        let panel_y = (sh - panel_h) / 2;

        gfx_draw_glass_rect(panel_x, panel_y, panel_w, panel_h, 0x00050811, 240, 0x00EF4444, 16);

        // Barra de Título de Alerta
        gfx_draw_glass_rect(panel_x, panel_y, panel_w, 48, 0x007F1D1D, 220, 0x00B91C1C, 16);
        gfx_draw_circle_button(panel_x + 24, panel_y + 24, 8, 0x00EF4444);
        gfx_draw_text(panel_x + 42, panel_y + 16, b"BAKEN OS KERNEL DIAGNOSTIC SYSTEM (RING 0 PANIC)\0".as_ptr(), 0x00FFFFFF, 1);

        // Descrição do Erro
        let vec_id = (*ctx).vector_id as usize;
        let fault_name = if vec_id < 20 { EXCEPTION_NAMES[vec_id] } else { b"Unknown CPU Fault\0".as_ptr() };

        let tx = panel_x + 30;
        let mut ty = panel_y + 68;

        gfx_draw_text(tx, ty, b"O microkernel detectou uma excecao critica de hardware:\0".as_ptr(), 0x00E2E8F0, 1);
        ty += 24;
        gfx_draw_text(tx, ty, fault_name, 0x00F87171, 2);
        ty += 44;

        gfx_draw_hline(tx, ty, panel_w - 60, 0x001E293B, 200);
        ty += 16;

        // Dump de Registradores
        gfx_draw_text(tx, ty, b"REGISTRADORES CPU x86_64:\0".as_ptr(), 0x0038BDF8, 1);
        ty += 24;

        gfx_draw_text(tx, ty, b"RIP: 0x0000000000100000   RSP: 0x00007FFFFFFFE000   CR2: 0x0000000000000000\0".as_ptr(), 0x00CBD5E1, 1);
        ty += 20;
        gfx_draw_text(tx, ty, b"RAX: 0x0000000000000001   RBX: 0x0000000000000000   RCX: 0x0000000000000000\0".as_ptr(), 0x0094A3B8, 1);
        ty += 20;
        gfx_draw_text(tx, ty, b"RDX: 0x0000000000000000   RSI: 0x0000000000000000   RDI: 0x0000000000000000\0".as_ptr(), 0x0094A3B8, 1);
        ty += 32;

        // Rodapé de Ação
        gfx_draw_glass_rect(tx, ty, panel_w - 60, 44, 0x000F172A, 200, 0x00334155, 8);
        gfx_draw_text(tx + 16, ty + 14, b"Status: Kernel pausado com seguranca. Pressione [RESET] ou use o debugger.\0".as_ptr(), 0x004ADE80, 1);

        // Loop Infinito de Parada Segura (HALT)
        loop {
            // asm!("hlt");
        }
    }
}

// Invocação manual de Kernel Panic
@system
pub fn baken_panic(reason: *const u8) -> ! {
    let ctx = CpuFaultContext {
        rip: 0x100000, rsp: 0x7FFFF000,
        rax: 0, rbx: 0, rcx: 0, rdx: 0, rsi: 0, rdi: 0, rbp: 0,
        r8: 0, r9: 0, r10: 0, r11: 0, r12: 0, r13: 0, r14: 0, r15: 0,
        cr2: 0, cr3: 0, rflags: 0, vector_id: 14, error_code: 0,
    };
    baken_handle_exception(&ctx);
}
