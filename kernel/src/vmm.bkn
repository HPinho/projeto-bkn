// Baken OS - Gerenciador de Memoria Virtual (VMM) em BKN Puro (@system)
// Mapeamento x86_64 Long Mode (PML4 -> PDPT -> PD -> PT) com Isolamento de Ring 0 e Ring 3

module kernel::vmm;

import kernel::pmm::*;

pub const PTE_PRESENT: u64  = 1 << 0;
pub const PTE_WRITABLE: u64 = 1 << 1;
pub const PTE_USER: u64     = 1 << 2;
pub const PTE_WRITE_THRU: u64 = 1 << 3;
pub const PTE_CACHE_DIS: u64  = 1 << 4;
pub const PTE_ACCESSED: u64   = 1 << 5;
pub const PTE_DIRTY: u64      = 1 << 6;
pub const PTE_HUGE_PAGE: u64  = 1 << 7;
pub const PTE_GLOBAL: u64     = 1 << 8;
pub const PTE_NO_EXEC: u64    = 1 << 63; // Bit NX (No-Execute)

pub const PAGE_SIZE_4K: u64 = 4096;
pub const PAGE_SIZE_2M: u64 = 2 * 1024 * 1024;
pub const KERNEL_HIGHER_HALF: u64 = 0xFFFF800000000000;

pub struct PageTable {
    pub entries: [u64; 512],
}

pub struct AddressSpace {
    pub pml4_phys: u64,
    pub pml4_virt: *mut PageTable,
    pub is_user_space: bool,
    pub mapped_pages: u64,
}

static mut KERNEL_PML4: *mut PageTable = 0 as *mut PageTable;
static mut CURRENT_PML4_PHYS: u64 = 0;

@system
pub fn vmm_init() {
    unsafe {
        let pml4_page = pmm_alloc_pages(0);
        KERNEL_PML4 = pml4_page as *mut PageTable;
        CURRENT_PML4_PHYS = pml4_page as u64;

        for i in 0..512 {
            (*KERNEL_PML4).entries[i] = 0;
        }

        // Mapeamento de Identidade dos primeiros 1GB de RAM fisica para o kernel
        vmm_map_range(0x0, 0x0, 1024 * 1024 * 1024, PTE_PRESENT | PTE_WRITABLE);

        // Mapeamento Higher-Half para seguranca de Ring 0
        vmm_map_range(KERNEL_HIGHER_HALF, 0x0, 1024 * 1024 * 1024, PTE_PRESENT | PTE_WRITABLE | PTE_GLOBAL);

        // Ativa o novo PML4 carregando o registrador CR3
        vmm_switch_pml4(CURRENT_PML4_PHYS);
    }
}

@system
pub fn vmm_switch_pml4(pml4_phys: u64) {
    unsafe {
        CURRENT_PML4_PHYS = pml4_phys;
        asm!(
            "mov cr3, {0}",
            in(reg) pml4_phys
        );
    }
}

@system
pub fn vmm_get_current_cr3() -> u64 {
    unsafe {
        return CURRENT_PML4_PHYS;
    }
}

@system
pub fn vmm_map_page(virt_addr: u64, phys_addr: u64, flags: u64) -> bool {
    unsafe {
        if KERNEL_PML4 == (0 as *mut PageTable) {
            return false;
        }

        let pml4_idx = ((virt_addr >> 39) & 0x1FF) as usize;
        let pdpt_idx = ((virt_addr >> 30) & 0x1FF) as usize;
        let pd_idx   = ((virt_addr >> 21) & 0x1FF) as usize;
        let pt_idx   = ((virt_addr >> 12) & 0x1FF) as usize;

        // 1. PML4 -> PDPT
        if ((*KERNEL_PML4).entries[pml4_idx] & PTE_PRESENT) == 0 {
            let new_pdpt = pmm_alloc_pages(0) as u64;
            if new_pdpt == 0 { return false; }
            let pt_ptr = new_pdpt as *mut PageTable;
            for i in 0..512 { (*pt_ptr).entries[i] = 0; }
            (*KERNEL_PML4).entries[pml4_idx] = new_pdpt | PTE_PRESENT | PTE_WRITABLE | (flags & PTE_USER);
        }
        let pdpt = ((*KERNEL_PML4).entries[pml4_idx] & 0x000FFFFFFFFFF000) as *mut PageTable;

        // 2. PDPT -> PD
        if ((*pdpt).entries[pdpt_idx] & PTE_PRESENT) == 0 {
            let new_pd = pmm_alloc_pages(0) as u64;
            if new_pd == 0 { return false; }
            let pt_ptr = new_pd as *mut PageTable;
            for i in 0..512 { (*pt_ptr).entries[i] = 0; }
            (*pdpt).entries[pdpt_idx] = new_pd | PTE_PRESENT | PTE_WRITABLE | (flags & PTE_USER);
        }
        let pd = ((*pdpt).entries[pdpt_idx] & 0x000FFFFFFFFFF000) as *mut PageTable;

        // 3. PD -> PT
        if ((*pd).entries[pd_idx] & PTE_PRESENT) == 0 {
            let new_pt = pmm_alloc_pages(0) as u64;
            if new_pt == 0 { return false; }
            let pt_ptr = new_pt as *mut PageTable;
            for i in 0..512 { (*pt_ptr).entries[i] = 0; }
            (*pd).entries[pd_idx] = new_pt | PTE_PRESENT | PTE_WRITABLE | (flags & PTE_USER);
        }
        let pt = ((*pd).entries[pd_idx] & 0x000FFFFFFFFFF000) as *mut PageTable;

        // 4. Mapeamento da Pagina Folha de 4KB
        (*pt).entries[pt_idx] = (phys_addr & 0x000FFFFFFFFFF000) | flags | PTE_PRESENT;

        // Invalida a linha da TLB
        asm!(
            "invlpg [{0}]",
            in(reg) virt_addr
        );

        return true;
    }
}

@system
pub fn vmm_map_range(virt_start: u64, phys_start: u64, size: u64, flags: u64) -> bool {
    let mut offset: u64 = 0;
    while offset < size {
        if !vmm_map_page(virt_start + offset, phys_start + offset, flags) {
            return false;
        }
        offset += PAGE_SIZE_4K;
    }
    return true;
}

@system
pub fn vmm_unmap_page(virt_addr: u64) -> bool {
    unsafe {
        if KERNEL_PML4 == (0 as *mut PageTable) {
            return false;
        }

        let pml4_idx = ((virt_addr >> 39) & 0x1FF) as usize;
        let pdpt_idx = ((virt_addr >> 30) & 0x1FF) as usize;
        let pd_idx   = ((virt_addr >> 21) & 0x1FF) as usize;
        let pt_idx   = ((virt_addr >> 12) & 0x1FF) as usize;

        if ((*KERNEL_PML4).entries[pml4_idx] & PTE_PRESENT) == 0 { return false; }
        let pdpt = ((*KERNEL_PML4).entries[pml4_idx] & 0x000FFFFFFFFFF000) as *mut PageTable;

        if ((*pdpt).entries[pdpt_idx] & PTE_PRESENT) == 0 { return false; }
        let pd = ((*pdpt).entries[pdpt_idx] & 0x000FFFFFFFFFF000) as *mut PageTable;

        if ((*pd).entries[pd_idx] & PTE_PRESENT) == 0 { return false; }
        let pt = ((*pd).entries[pd_idx] & 0x000FFFFFFFFFF000) as *mut PageTable;

        (*pt).entries[pt_idx] = 0; // Desmapeia

        asm!(
            "invlpg [{0}]",
            in(reg) virt_addr
        );

        return true;
    }
}

@system
pub fn vmm_get_phys_addr(virt_addr: u64) -> u64 {
    unsafe {
        if KERNEL_PML4 == (0 as *mut PageTable) {
            return 0;
        }

        let pml4_idx = ((virt_addr >> 39) & 0x1FF) as usize;
        let pdpt_idx = ((virt_addr >> 30) & 0x1FF) as usize;
        let pd_idx   = ((virt_addr >> 21) & 0x1FF) as usize;
        let pt_idx   = ((virt_addr >> 12) & 0x1FF) as usize;
        let page_offset = virt_addr & 0xFFF;

        if ((*KERNEL_PML4).entries[pml4_idx] & PTE_PRESENT) == 0 { return 0; }
        let pdpt = ((*KERNEL_PML4).entries[pml4_idx] & 0x000FFFFFFFFFF000) as *mut PageTable;

        if ((*pdpt).entries[pdpt_idx] & PTE_PRESENT) == 0 { return 0; }
        let pd = ((*pdpt).entries[pdpt_idx] & 0x000FFFFFFFFFF000) as *mut PageTable;

        if ((*pd).entries[pd_idx] & PTE_PRESENT) == 0 { return 0; }
        let pt = ((*pd).entries[pd_idx] & 0x000FFFFFFFFFF000) as *mut PageTable;

        if ((*pt).entries[pt_idx] & PTE_PRESENT) == 0 { return 0; }
        let phys_base = (*pt).entries[pt_idx] & 0x000FFFFFFFFFF000;

        return phys_base | page_offset;
    }
}
