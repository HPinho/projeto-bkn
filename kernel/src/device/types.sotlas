// Identidade e estados universais do Device Core. Nenhum backend fisico aqui.
module kernel::device::types;

pub const DEVICE_CORE_CAPACITY: usize = 128;
pub const DEVICE_ID_NONE: u32 = 0;
pub const DEVICE_GENERATION_INVALID: u32 = 0;

pub const DEVICE_BUS_NONE: u8 = 0;
pub const DEVICE_BUS_PCI: u8 = 1;
pub const DEVICE_BUS_USB: u8 = 2;
pub const DEVICE_BUS_I2C: u8 = 3;
pub const DEVICE_BUS_ACPI: u8 = 4;
pub const DEVICE_BUS_VIRTUAL: u8 = 5;

pub const DEVICE_CLASS_NONE: u8 = 0;
pub const DEVICE_CLASS_BUS: u8 = 1;
pub const DEVICE_CLASS_BLOCK: u8 = 2;
pub const DEVICE_CLASS_INPUT: u8 = 3;
pub const DEVICE_CLASS_DISPLAY: u8 = 4;
pub const DEVICE_CLASS_AUDIO: u8 = 5;
pub const DEVICE_CLASS_NETWORK: u8 = 6;
pub const DEVICE_CLASS_CONTROLLER: u8 = 7;

pub const DEVICE_STATE_EMPTY: u8 = 0;
pub const DEVICE_STATE_ATTACHED: u8 = 1;
pub const DEVICE_STATE_ACTIVE: u8 = 2;
pub const DEVICE_STATE_FAILED: u8 = 3;
pub const DEVICE_STATE_DETACHED: u8 = 4;
pub const DEVICE_STATE_UNBINDING: u8 = 5;

pub const DRIVER_ID_NONE: u32 = 0;
pub const DRIVER_GENERATION_INVALID: u32 = 0;
pub const DRIVER_MATCH_ANY: u32 = 0xFFFFFFFF;
pub const DRIVER_STATE_EMPTY: u8 = 0;
pub const DRIVER_STATE_REGISTERED: u8 = 1;
pub const DRIVER_STATE_REMOVING: u8 = 2;

pub const RESOURCE_ID_NONE: u32 = 0;
pub const RESOURCE_GENERATION_INVALID: u32 = 0;
pub const RESOURCE_KIND_NONE: u8 = 0;
pub const RESOURCE_KIND_MMIO: u8 = 1;
pub const RESOURCE_KIND_IO_PORT: u8 = 2;
pub const RESOURCE_KIND_PCI_BAR: u8 = 3;
pub const RESOURCE_KIND_IRQ: u8 = 4;
pub const RESOURCE_KIND_DMA: u8 = 5;

@repr(C)
pub struct ResourceHandle {
    pub resource_id: u32;
    pub generation: u32;
    pub valid: bool;
}

@repr(C)
pub struct ResourceRequest {
    pub kind: u8;
    pub start: u64;
    pub length: u64;
    // PCI BAR: indice 0..5. Demais classes devem usar zero.
    pub auxiliary: u32;
}

@repr(C)
pub struct DriverHandle {
    pub driver_id: u32;
    pub generation: u32;
    pub valid: bool;
}

@repr(C)
pub struct DriverMatch {
    pub bus: u8;
    pub class_code: u8;
    pub vendor_id: u32;
    pub hardware_id: u32;
}

@repr(C)
pub struct DeviceHandle {
    pub device_id: u32;
    pub generation: u32;
    pub valid: bool;
}

@repr(C)
pub struct DeviceRecord {
    pub handle: DeviceHandle;
    pub parent: DeviceHandle;
    pub bus: u8;
    pub class_code: u8;
    pub state: u8;
    pub driver_id: u32;
    pub vendor_id: u32;
    pub hardware_id: u32;
    pub bus_instance: u32;
    pub child_count: u32;
    pub resource_count: u32;
    pub valid: bool;
}

@repr(C)
pub struct ResourceClaim {
    pub handle: ResourceHandle;
    pub owner_device: DeviceHandle;
    pub owner_driver: DriverHandle;
    pub request: ResourceRequest;
    pub valid: bool;
}

@system
pub fn device_invalid_handle() -> DeviceHandle {
    return DeviceHandle { device_id: DEVICE_ID_NONE,
                          generation: DEVICE_GENERATION_INVALID, valid: false };
}

@system
pub fn device_invalid_record() -> DeviceRecord {
    return DeviceRecord {
        handle: device_invalid_handle(), parent: device_invalid_handle(),
        bus: DEVICE_BUS_NONE, class_code: DEVICE_CLASS_NONE,
        state: DEVICE_STATE_EMPTY, driver_id: 0, vendor_id: 0,
        hardware_id: 0, bus_instance: 0, child_count: 0, resource_count: 0,
        valid: false
    };
}

@system
pub fn device_handle_equal(left: DeviceHandle, right: DeviceHandle) -> bool {
    return left.valid && right.valid && left.device_id == right.device_id &&
           left.generation == right.generation;
}

@system
pub fn driver_invalid_handle() -> DriverHandle {
    return DriverHandle { driver_id: DRIVER_ID_NONE,
                          generation: DRIVER_GENERATION_INVALID, valid: false };
}

@system
pub fn driver_handle_equal(left: DriverHandle, right: DriverHandle) -> bool {
    return left.valid && right.valid && left.driver_id == right.driver_id &&
           left.generation == right.generation;
}

@system
pub fn resource_invalid_handle() -> ResourceHandle {
    return ResourceHandle { resource_id: RESOURCE_ID_NONE,
                            generation: RESOURCE_GENERATION_INVALID, valid: false };
}

@system
pub fn resource_invalid_claim() -> ResourceClaim {
    return ResourceClaim {
        handle: resource_invalid_handle(), owner_device: device_invalid_handle(),
        owner_driver: driver_invalid_handle(),
        request: ResourceRequest { kind: RESOURCE_KIND_NONE, start: 0,
                                   length: 0, auxiliary: 0 },
        valid: false
    };
}

@system
pub fn resource_handle_equal(left: ResourceHandle, right: ResourceHandle) -> bool {
    return left.valid && right.valid && left.resource_id == right.resource_id &&
           left.generation == right.generation;
}
