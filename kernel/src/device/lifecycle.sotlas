// DF-3.1a: fachada conservadora do lifecycle universal.
// ACTIVE pertence exclusivamente ao binding transacional do Driver Registry:
// ATTACHED -> BINDING -> probe -> commit -> ACTIVE.
// Esta fachada nao oferece atalho ATTACHED -> ACTIVE.
module kernel::device::lifecycle;

import kernel::device::types::*;
import kernel::device::registry::*;

@system
pub fn device_fail(handle: DeviceHandle) -> bool {
    return device_core_mark_failed(handle);
}

@system
pub fn device_detach(handle: DeviceHandle) -> bool {
    return device_core_detach(handle);
}
