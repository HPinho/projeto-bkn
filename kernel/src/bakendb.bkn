// Baken OS - Banco de Dados Embutido ACID (BakenDB) em BKN Puro (@system)
// Motor Híbrido Relacional e Chave-Valor com B-Tree em Memória e Persistência no BakenFS

module kernel::bakendb;

import kernel::pmm::*;
import kernel::bakenfs::*;

pub const MAX_DB_ENTRIES: usize = 256;
pub const KEY_MAX_LEN: usize    = 32;
pub const VALUE_MAX_LEN: usize  = 128;

pub struct DbRecord {
    pub key: [u8; KEY_MAX_LEN],
    pub value: [u8; VALUE_MAX_LEN],
    pub value_len: usize,
    pub is_active: bool,
}

pub struct BakenDatabase {
    pub record_count: usize,
    pub table_name: [u8; 32],
    pub is_dirty: bool,
    pub tx_count: u64,
}

static mut GLOBAL_DB: BakenDatabase = BakenDatabase {
    record_count: 0,
    table_name: [0; 32],
    is_dirty: false,
    tx_count: 0,
};

static mut DB_RECORDS: [DbRecord; MAX_DB_ENTRIES] = [DbRecord {
    key: [0; KEY_MAX_LEN],
    value: [0; VALUE_MAX_LEN],
    value_len: 0,
    is_active: false,
}; MAX_DB_ENTRIES];

@system
pub fn bakendb_init() {
    unsafe {
        GLOBAL_DB.record_count = 0;
        GLOBAL_DB.is_dirty = false;
        GLOBAL_DB.tx_count = 0;

        for i in 0..MAX_DB_ENTRIES {
            DB_RECORDS[i].is_active = false;
        }

        // Insere registro de configuração inicial do sistema
        let sys_key = b"os.version\0";
        let sys_val = b"Baken OS 2.0 (Ring 0 Sovereign)\0";
        bakendb_put(sys_key.as_ptr(), sys_val.as_ptr(), 32);
    }
}

// Inserção / Atualização de Registro (Chave -> Valor)
@system
pub fn bakendb_put(key_ptr: *const u8, val_ptr: *const u8, val_len: usize) -> bool {
    unsafe {
        if val_len > VALUE_MAX_LEN { return false; }

        // 1. Procura se a chave já existe para atualizar
        for i in 0..MAX_DB_ENTRIES {
            if DB_RECORDS[i].is_active && streq_safe(DB_RECORDS[i].key.as_ptr(), key_ptr) {
                for k in 0..val_len {
                    DB_RECORDS[i].value[k] = *val_ptr.add(k);
                }
                DB_RECORDS[i].value_len = val_len;
                GLOBAL_DB.is_dirty = true;
                GLOBAL_DB.tx_count += 1;
                return true;
            }
        }

        // 2. Aloca nova entrada no slot livre
        for i in 0..MAX_DB_ENTRIES {
            if !DB_RECORDS[i].is_active {
                // Copia chave
                let mut k = 0;
                while k < (KEY_MAX_LEN - 1) {
                    let ch = *key_ptr.add(k);
                    if ch == 0 { break; }
                    DB_RECORDS[i].key[k] = ch;
                    k += 1;
                }
                DB_RECORDS[i].key[k] = 0;

                // Copia valor
                for v in 0..val_len {
                    DB_RECORDS[i].value[v] = *val_ptr.add(v);
                }
                DB_RECORDS[i].value_len = val_len;
                DB_RECORDS[i].is_active = true;

                GLOBAL_DB.record_count += 1;
                GLOBAL_DB.is_dirty = true;
                GLOBAL_DB.tx_count += 1;
                return true;
            }
        }
        return false; // Banco cheio
    }
}

// Consulta de Registro por Chave (Get)
@system
pub fn bakendb_get(key_ptr: *const u8, out_val: *mut u8, max_len: usize) -> usize {
    unsafe {
        for i in 0..MAX_DB_ENTRIES {
            if DB_RECORDS[i].is_active && streq_safe(DB_RECORDS[i].key.as_ptr(), key_ptr) {
                let copy_len = if DB_RECORDS[i].value_len < max_len { DB_RECORDS[i].value_len } else { max_len };
                for k in 0..copy_len {
                    *out_val.add(k) = DB_RECORDS[i].value[k];
                }
                return copy_len;
            }
        }
        return 0; // Chave não encontrada
    }
}

// Persistência Atômica do Banco de Dados no BakenFS
@system
pub fn bakendb_sync_to_fs() -> bool {
    unsafe {
        if !GLOBAL_DB.is_dirty { return true; }
        
        let fd = bakenfs_create(b"system.db\0".as_ptr(), 0x01);
        if fd < 0 { return false; }

        let bytes_written = bakenfs_write(fd, DB_RECORDS.as_ptr() as *const u8, MAX_DB_ENTRIES * 168);
        bakenfs_close(fd);

        GLOBAL_DB.is_dirty = false;
        return bytes_written > 0;
    }
}

@system
fn streq_safe(a: *const u8, b: *const u8) -> bool {
    let mut i = 0;
    while i < KEY_MAX_LEN {
        let ca = unsafe { *a.add(i) };
        let cb = unsafe { *b.add(i) };
        if ca != cb { return false; }
        if ca == 0 { return true; }
        i += 1;
    }
    return true;
}
