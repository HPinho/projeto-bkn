// Gerenciador canônico de janelas do Baken OS.
// Aplicações pedem molduras aqui; não escrevem no framebuffer nem trazem
// serviços de terminal, rede ou disco para o caminho gráfico inicial.

module kernel::window_manager;

import kernel::graphics_engine::*;
import kernel::bakenfx::*;
import kernel::app_files::*;
import kernel::app_notes::*;
import kernel::app_settings::*;
import kernel::app_terminal::*;
import kernel::app_about::*;
import kernel::baken_installer::*;
import kernel::baken_materials::*;

pub const MAX_WINDOWS: usize = 16;
pub const TITLE_BAR_HEIGHT: u32 = 36;

pub struct Window {
    pub id: u32; pub x: i32; pub y: i32; pub width: u32; pub height: u32;
    pub min_width: u32; pub min_height: u32; pub z_index: u8;
    pub is_open: bool; pub is_focused: bool; pub is_minimized: bool; pub is_maximized: bool;
    pub saved_x: i32; pub saved_y: i32; pub saved_w: u32; pub saved_h: u32;
    pub title: [u8; 48]; pub bg_color: u32; pub bg_alpha: u8; pub border_color: u32;
}

pub struct DragState {
    pub is_dragging: bool; pub active_win_id: u32;
    pub drag_start_x: i32; pub drag_start_y: i32; pub win_start_x: i32; pub win_start_y: i32;
}

pub struct ResizeState {
    pub is_resizing: bool;
    pub active_win_id: u32;
    pub grip_edge: u8;
    pub drag_start_x: i32;
    pub drag_start_y: i32;
    pub win_start_x: i32;
    pub win_start_y: i32;
    pub win_start_w: u32;
    pub win_start_h: u32;
}

static mut WINDOW_COUNT: usize = 0;
static mut FOCUSED_WINDOW: u32 = 0;
static mut DRAG: DragState = DragState {
    is_dragging: false, active_win_id: 0,
    drag_start_x: 0, drag_start_y: 0, win_start_x: 0, win_start_y: 0,
};
static mut RESIZE: ResizeState = ResizeState {
    is_resizing: false, active_win_id: 0, grip_edge: 0,
    drag_start_x: 0, drag_start_y: 0,
    win_start_x: 0, win_start_y: 0,
    win_start_w: 0, win_start_h: 0,
};
static mut WINDOWS: [Window; MAX_WINDOWS] = [Window {
    id: 0, x: 0, y: 0, width: 0, height: 0, min_width: 240, min_height: 160, z_index: 0,
    is_open: false, is_focused: false, is_minimized: false, is_maximized: false,
    saved_x: 0, saved_y: 0, saved_w: 0, saved_h: 0,
    title: [0; 48], bg_color: 0x00FFFFFF, bg_alpha: 245, border_color: 0x00CBD5E1,
}; MAX_WINDOWS];

@system
pub fn wm_init() -> void {
    unsafe {
        WINDOW_COUNT = 0; FOCUSED_WINDOW = 0; DRAG.is_dragging = false; DRAG.active_win_id = 0;
        RESIZE.is_resizing = false; RESIZE.active_win_id = 0;
        for mut i in 0..MAX_WINDOWS {
            WINDOWS[i].id = 0; WINDOWS[i].is_open = false; WINDOWS[i].is_focused = false;
            WINDOWS[i].is_minimized = false; WINDOWS[i].is_maximized = false; WINDOWS[i].title = [0; 48];
        }
        baken_installer_init();
    }
}

@system
pub fn wm_create_window(id: u32, title: *const u8, x: i32, y: i32, w: u32, h: u32,
                        bg: u32, alpha: u8, border: u32) -> *mut Window {
    unsafe {
        if id == 0 || title == (null as *const u8) || WINDOW_COUNT >= MAX_WINDOWS { return null as *mut Window; }
        for mut i in 0..WINDOW_COUNT { if WINDOWS[i].id == id { return null as *mut Window; } }
        let win = &mut WINDOWS[WINDOW_COUNT];
        win.id = id; win.x = x; win.y = y;
        win.width = if w < win.min_width { win.min_width } else { w };
        win.height = if h < win.min_height { win.min_height } else { h };
        win.saved_x = x; win.saved_y = y; win.saved_w = win.width; win.saved_h = win.height;
        win.z_index = WINDOW_COUNT as u8; win.is_open = true; win.is_focused = false;
        win.is_minimized = false; win.is_maximized = false; win.bg_color = bg; win.bg_alpha = alpha; win.border_color = border;
        win.title = [0; 48];
        for mut i in 0..47 { let ch = *title.add(i); win.title[i] = ch; if ch == 0 { break; } }
        WINDOW_COUNT += 1; wm_bring_to_front(id); return win as *mut Window;
    }
}

@system
pub fn wm_bring_to_front(id: u32) -> void {
    unsafe {
        let mut target = MAX_WINDOWS;
        for mut i in 0..WINDOW_COUNT { if WINDOWS[i].id == id { target = i; break; } }
        if target == MAX_WINDOWS { return; }
        let old_z = WINDOWS[target].z_index;
        for mut i in 0..WINDOW_COUNT {
            if WINDOWS[i].z_index > old_z { WINDOWS[i].z_index -= 1; }
            WINDOWS[i].is_focused = false;
        }
        WINDOWS[target].z_index = (WINDOW_COUNT - 1) as u8;
        WINDOWS[target].is_focused = true; WINDOWS[target].is_minimized = false; FOCUSED_WINDOW = id;
    }
}

@system
pub fn wm_get_cursor_type(mx: i32, my: i32) -> u8 {
    unsafe {
        for mut idx in 0..WINDOW_COUNT {
            let z = (WINDOW_COUNT - 1 - idx) as u8;
            for mut i in 0..WINDOW_COUNT {
                let win = &WINDOWS[i];
                if win.z_index == z && win.is_open && !win.is_minimized && !win.is_maximized &&
                   mx >= win.x - 4 && mx <= win.x + win.width as i32 + 4 &&
                   my >= win.y - 4 && my <= win.y + win.height as i32 + 4 {
                    let left = mx >= win.x - 4 && mx <= win.x + 8;
                    let right = mx >= win.x + win.width as i32 - 8 && mx <= win.x + win.width as i32 + 4;
                    let top = my >= win.y - 4 && my <= win.y + 8;
                    let bottom = my >= win.y + win.height as i32 - 8 && my <= win.y + win.height as i32 + 4;
                    if (left && top) || (right && bottom) { return 1; }
                    if (right && top) || (left && bottom) { return 2; }
                    if left || right { return 3; }
                    if top || bottom { return 4; }
                    return 0;
                }
            }
        }
        return 0;
    }
}

@system
pub fn wm_handle_mouse_down(mx: i32, my: i32) -> bool {
    unsafe {
        let mut target = MAX_WINDOWS; let mut top_z: i32 = -1;
        for mut i in 0..WINDOW_COUNT {
            let win = &WINDOWS[i];
            if win.is_open && !win.is_minimized && mx >= win.x - 4 && mx < win.x + win.width as i32 + 4 &&
               my >= win.y - 4 && my < win.y + win.height as i32 + 4 && win.z_index as i32 > top_z {
                target = i; top_z = win.z_index as i32;
            }
        }
        if target == MAX_WINDOWS { return false; }
        let id = WINDOWS[target].id; wm_bring_to_front(id);
        let win = &mut WINDOWS[target]; let button_y = win.y + 18;
        // A área tocável é maior que o desenho visual, respeitando o token
        // de acessibilidade sem alterar a composição óptica dos botões.
        let hit_radius = (bakenfx_hit_target_size(12) / 2) as i32;
        if (mx - (win.x + 18)).abs() + (my - button_y).abs() < hit_radius { win.is_open = false; return true; }
        if (mx - (win.x + 36)).abs() + (my - button_y).abs() < hit_radius { win.is_minimized = true; return true; }
        if (mx - (win.x + 54)).abs() + (my - button_y).abs() < hit_radius {
            if win.is_maximized {
                win.x = win.saved_x; win.y = win.saved_y; win.width = win.saved_w; win.height = win.saved_h; win.is_maximized = false;
            } else {
                win.saved_x = win.x; win.saved_y = win.y; win.saved_w = win.width; win.saved_h = win.height;
                win.x = 0; win.y = TITLE_BAR_HEIGHT as i32 + 8; win.width = display_get_width();
                win.height = display_get_height() - TITLE_BAR_HEIGHT - 80; win.is_maximized = true;
            }
            return true;
        }

        // Zonas de Grip de Redimensionamento (8px)
        if !win.is_maximized {
            let mut grip: u8 = 0;
            if mx >= win.x - 4 && mx <= win.x + 8 { grip |= 1; }
            if mx >= win.x + win.width as i32 - 8 && mx <= win.x + win.width as i32 + 4 { grip |= 2; }
            if my >= win.y - 4 && my <= win.y + 8 { grip |= 4; }
            if my >= win.y + win.height as i32 - 8 && my <= win.y + win.height as i32 + 4 { grip |= 8; }
            if grip != 0 {
                RESIZE.is_resizing = true; RESIZE.active_win_id = id; RESIZE.grip_edge = grip;
                RESIZE.drag_start_x = mx; RESIZE.drag_start_y = my;
                RESIZE.win_start_x = win.x; RESIZE.win_start_y = win.y;
                RESIZE.win_start_w = win.width; RESIZE.win_start_h = win.height;
                return true;
            }
        }

        if my >= win.y && my <= win.y + TITLE_BAR_HEIGHT as i32 {
            DRAG.is_dragging = true; DRAG.active_win_id = id; DRAG.drag_start_x = mx; DRAG.drag_start_y = my;
            DRAG.win_start_x = win.x; DRAG.win_start_y = win.y;
        } else {
            let rel_x = mx - win.x;
            let rel_y = my - win.y - TITLE_BAR_HEIGHT as i32;
            if win.id == 1 { app_files_handle_click(rel_x, rel_y); }
            else if win.id == 2 { app_notes_handle_click(rel_x, rel_y); }
            else if win.id == 3 { app_settings_handle_click(rel_x, rel_y); }
            else if win.id == 4 { app_terminal_handle_click(rel_x, rel_y); }
            else if win.id == 5 { app_about_handle_click(rel_x, rel_y); }
            else if win.id == 6 { baken_installer_handle_click(rel_x, rel_y, win.width, win.height); }
        }
        return true;
    }
}

@system
pub fn wm_handle_mouse_move(mx: i32, my: i32) -> void {
    unsafe {
        if RESIZE.is_resizing {
            for mut i in 0..WINDOW_COUNT {
                if WINDOWS[i].id == RESIZE.active_win_id {
                    let win = &mut WINDOWS[i];
                    if (RESIZE.grip_edge & 2) != 0 {
                        let nw = RESIZE.win_start_w as i32 + (mx - RESIZE.drag_start_x);
                        win.width = if nw < win.min_width as i32 { win.min_width } else { nw as u32 };
                    }
                    if (RESIZE.grip_edge & 1) != 0 {
                        let dx = mx - RESIZE.drag_start_x;
                        let nw = RESIZE.win_start_w as i32 - dx;
                        if nw >= win.min_width as i32 {
                            win.x = RESIZE.win_start_x + dx;
                            win.width = nw as u32;
                        }
                    }
                    if (RESIZE.grip_edge & 8) != 0 {
                        let nh = RESIZE.win_start_h as i32 + (my - RESIZE.drag_start_y);
                        win.height = if nh < win.min_height as i32 { win.min_height } else { nh as u32 };
                    }
                    if (RESIZE.grip_edge & 4) != 0 {
                        let dy = my - RESIZE.drag_start_y;
                        let nh = RESIZE.win_start_h as i32 - dy;
                        if nh >= win.min_height as i32 {
                            win.y = RESIZE.win_start_y + dy;
                            win.height = nh as u32;
                        }
                    }
                    return;
                }
            }
        }
        if !DRAG.is_dragging { return; }
        for mut i in 0..WINDOW_COUNT {
            if WINDOWS[i].id == DRAG.active_win_id {
                WINDOWS[i].x = DRAG.win_start_x + mx - DRAG.drag_start_x;
                WINDOWS[i].y = DRAG.win_start_y + my - DRAG.drag_start_y; return;
            }
        }
    }
}

@system
pub fn wm_handle_mouse_up() -> void {
    unsafe {
        DRAG.is_dragging = false;
        RESIZE.is_resizing = false;
    }
}

@system
pub fn wm_render_windows() -> void {
    unsafe {
        for mut z in 0..(WINDOW_COUNT as u8) {
            for mut i in 0..WINDOW_COUNT {
                let win = &WINDOWS[i];
                if win.z_index == z && win.is_open && !win.is_minimized { wm_render_single_window(win); }
            }
        }
    }
}

@system
fn wm_render_single_window(win: &Window) -> void {
    if win.x + win.width as i32 < 0 || win.y + win.height as i32 < 0 { return; }
    let x = if win.x < 0 { 0 } else { win.x as u32 }; let y = if win.y < 0 { 0 } else { win.y as u32 };
    let border = if win.is_focused { win.border_color } else { 0x00E2E8F0 };
    
    let panel_alpha: u8 = if win.is_focused { 248 } else { 235 };
    bakenfx_draw_elevated_panel(x, y, win.width, win.height, win.bg_color, panel_alpha, border, 14, if win.is_focused { 4 } else { 2 });
    bakenfx_draw_rect(x + 1, y + TITLE_BAR_HEIGHT, win.width - 2, 1, 0x00E2E8F0, 180);
    material_draw_traffic_lights(x + 18, y + 18);
    let title_col = if win.id == 4 { 0x00FFFFFF } else { 0x000F172A };
    bakenfx_draw_text(x + 72, y + 11, win.title.as_ptr(), title_col, 245);

    // Renderiza o corpo do aplicativo
    let content_x = x + 1;
    let content_y = y + TITLE_BAR_HEIGHT + 1;
    let content_w = win.width - 2;
    let content_h = win.height - TITLE_BAR_HEIGHT - 2;

    if win.id == 1 {
        app_files_render(content_x, content_y, content_w, content_h);
    } else if win.id == 2 {
        app_notes_render(content_x, content_y, content_w, content_h);
    } else if win.id == 3 {
        app_settings_render(content_x, content_y, content_w, content_h);
    } else if win.id == 4 {
        app_terminal_render(content_x, content_y, content_w, content_h);
    } else if win.id == 5 {
        app_about_render(content_x, content_y, content_w, content_h);
    } else if win.id == 6 {
        baken_installer_render(content_x, content_y, content_w, content_h);
    }
}
