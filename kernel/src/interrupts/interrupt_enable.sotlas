// Baken OS — porta fail-closed para habilitação progressiva de interrupções.
//
// Ordem de bring-up: primeiro LAPIC timer; depois IRQ1 do teclado. IRQ12/mouse e
// todas as demais fontes externas permanecem mascaradas até etapas próprias.

module kernel::interrupts::interrupt_enable;

import kernel::arch::x86_64::cpu::*;
import kernel::interrupts::irq::*;
import kernel::interrupts::lapic::*;
import kernel::interrupts::ioapic::*;
import kernel::interrupts::lapic_timer::*;
import kernel::interrupts::route::*;
import kernel::drivers::i8042::*;

static mut EXTERNAL_INTERRUPTS_ENABLED: bool = false;
static mut KEYBOARD_IRQ_ENABLED: bool = false;

@system
pub fn interrupt_enable_timer_only() -> bool {
    unsafe {
        if EXTERNAL_INTERRUPTS_ENABLED { return false; }
    }
    if !lapic_is_ready() || !ioapic_is_ready() { return false; }
    if !irq_idt_ready() || !irq_routes_ready() { return false; }
    if !lapic_timer_is_ready() { return false; }

    x86_cli_raw();
    if !lapic_timer_unmask_periodic() {
        lapic_timer_mask();
        return false;
    }
    unsafe {
        EXTERNAL_INTERRUPTS_ENABLED = true;
        KEYBOARD_IRQ_ENABLED = false;
    }
    x86_sti_raw();
    return true;
}

// Habilita somente a entrega IOAPIC de IRQ1. O i8042 pode anunciar também a
// porta auxiliar em seu config byte, porém IRQ12 continua mascarada no IOAPIC,
// portanto nenhuma interrupção de mouse pode chegar ao CPU nesta etapa.
@system
pub fn interrupt_enable_keyboard_after_timer() -> bool {
    unsafe {
        if !EXTERNAL_INTERRUPTS_ENABLED || KEYBOARD_IRQ_ENABLED { return false; }
    }
    if !lapic_timer_is_ready() || !irq_idt_ready() || !irq_routes_ready() { return false; }
    if !i8042_initialize_polling() || !i8042_first_port_present() { return false; }

    let keyboard = interrupt_route_keyboard(IRQ_VECTOR_KEYBOARD);
    if !keyboard.valid { return false; }
    let destination = lapic_id();

    x86_cli_raw();
    if !i8042_enable_native_irqs() {
        x86_sti_raw();
        return false;
    }
    if !ioapic_program_route_unmasked(&keyboard, destination) {
        i8042_disable_native_irqs();
        ioapic_program_route_masked(&keyboard, destination);
        x86_sti_raw();
        return false;
    }

    unsafe { KEYBOARD_IRQ_ENABLED = true; }
    x86_sti_raw();
    return true;
}

@system
pub fn keyboard_interrupt_enabled() -> bool {
    unsafe { return KEYBOARD_IRQ_ENABLED; }
}

@system
pub fn interrupt_disable_all() -> void {
    x86_cli_raw();
    if irq_routes_ready() && ioapic_is_ready() && lapic_is_ready() {
        let keyboard = interrupt_route_keyboard(IRQ_VECTOR_KEYBOARD);
        if keyboard.valid {
            ioapic_program_route_masked(&keyboard, lapic_id());
        }
    }
    if i8042_native_irqs_enabled() { i8042_disable_native_irqs(); }
    lapic_timer_mask();
    unsafe {
        KEYBOARD_IRQ_ENABLED = false;
        EXTERNAL_INTERRUPTS_ENABLED = false;
    }
}

@system
pub fn external_interrupts_enabled() -> bool {
    unsafe { return EXTERNAL_INTERRUPTS_ENABLED; }
}
