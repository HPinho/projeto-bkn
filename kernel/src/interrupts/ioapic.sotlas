// Baken OS — IOAPIC pós-cutover.
//
// Descobre a capacidade de cada IOAPIC via register-select/window e mascara
// todas as redirection entries antes de qualquer STI. Rotas podem ser preparadas
// ainda mascaradas e só serão abertas numa fase posterior.

module kernel::interrupts::ioapic;

import kernel::arch::x86_64::cpu::*;
import kernel::memory::active_page_tables::*;
import kernel::acpi::madt::*;
import kernel::interrupts::route::*;

pub const IOAPIC_REGSEL_OFFSET: u64 = 0x00;
pub const IOAPIC_WINDOW_OFFSET: u64 = 0x10;
pub const IOAPIC_REG_ID: u32 = 0x00;
pub const IOAPIC_REG_VERSION: u32 = 0x01;
pub const IOAPIC_REDIR_BASE: u32 = 0x10;
pub const IOAPIC_REDIR_MASKED: u32 = 1 << 16;
pub const IOAPIC_REDIR_ACTIVE_LOW: u32 = 1 << 13;
pub const IOAPIC_REDIR_LEVEL: u32 = 1 << 15;

static mut IOAPIC_READY: bool = false;
static mut IOAPIC_COUNT: u32 = 0;

@system
fn ioapic_read(base: u64, register_index: u32) -> u32 {
    x86_mmio_write32(base + IOAPIC_REGSEL_OFFSET, register_index);
    return x86_mmio_read32(base + IOAPIC_WINDOW_OFFSET);
}

@system
fn ioapic_write(base: u64, register_index: u32, value: u32) -> void {
    x86_mmio_write32(base + IOAPIC_REGSEL_OFFSET, register_index);
    x86_mmio_write32(base + IOAPIC_WINDOW_OFFSET, value);
}

@system
fn ioapic_max_redirection(base: u64) -> u32 {
    return (ioapic_read(base, IOAPIC_REG_VERSION) >> 16) & 0xFF;
}

@system
fn ioapic_mask_all_at(base: u64) -> bool {
    let max_redirection = ioapic_max_redirection(base);
    if max_redirection > 239 { return false; }

    let mut index: u32 = 0;
    while index <= max_redirection {
        let low_reg = IOAPIC_REDIR_BASE + (index * 2);
        let current_low = ioapic_read(base, low_reg);
        ioapic_write(base, low_reg, current_low | IOAPIC_REDIR_MASKED);
        index += 1;
    }
    return true;
}

@system
pub fn ioapic_init_all_masked() -> bool {
    unsafe {
        IOAPIC_READY = false;
        IOAPIC_COUNT = 0;
    }
    if !madt_is_ready() { return false; }

    let count = madt_ioapic_count();
    if count == 0 || count > MADT_MAX_IOAPICS as u32 { return false; }

    let mut index: u32 = 0;
    while index < count {
        let descriptor = madt_ioapic(index);
        if descriptor == (null as *const MadtIoApic) { return false; }
        unsafe {
            let base = descriptor.mmio_address as u64;
            if base == 0 || (base & 0xFFF) != 0 { return false; }
            if !active_page_tables_map_mmio_identity_4k(base) { return false; }
            if !ioapic_mask_all_at(base) { return false; }
        }
        index += 1;
    }

    unsafe {
        IOAPIC_COUNT = count;
        IOAPIC_READY = true;
    }
    return true;
}

@system
pub fn ioapic_program_route_masked(route: *const InterruptRoute,
                                    destination_apic_id: u8) -> bool {
    if route == (null as *const InterruptRoute) { return false; }
    unsafe {
        if !IOAPIC_READY || !(*route).valid { return false; }
        if (*route).vector < IRQ_ROUTE_MIN_VECTOR || (*route).vector >= 255 { return false; }

        let mut controller_index: u32 = 0;
        while controller_index < madt_ioapic_count() {
            let descriptor = madt_ioapic(controller_index);
            if descriptor == (null as *const MadtIoApic) { return false; }
            let base = (*descriptor).mmio_address as u64;
            let max_redirection = ioapic_max_redirection(base);
            let first_gsi = (*descriptor).gsi_base;
            let last_gsi = first_gsi + max_redirection;
            if last_gsi < first_gsi { return false; }

            if (*route).gsi >= first_gsi && (*route).gsi <= last_gsi {
                let redir_index = (*route).gsi - first_gsi;
                let low_reg = IOAPIC_REDIR_BASE + (redir_index * 2);
                let high_reg = low_reg + 1;

                let mut low = ((*route).vector as u32) | IOAPIC_REDIR_MASKED;
                if (*route).active_low { low |= IOAPIC_REDIR_ACTIVE_LOW; }
                if (*route).level_triggered { low |= IOAPIC_REDIR_LEVEL; }
                let high = (destination_apic_id as u32) << 24;

                // High primeiro, low ainda mascarado: nunca existe janela de IRQ ativa.
                ioapic_write(base, high_reg, high);
                ioapic_write(base, low_reg, low);
                return true;
            }
            controller_index += 1;
        }
    }
    return false;
}

@system
pub fn ioapic_is_ready() -> bool { unsafe { return IOAPIC_READY; } }

@system
pub fn ioapic_count() -> u32 { unsafe { return IOAPIC_COUNT; } }
