// Baken OS — fundacao de IRQs externos x86-64 + syscall CPL3 + IPIs SMP.
module kernel::interrupts::irq;

import kernel::arch::x86_64::cpu::*;
import kernel::arch::x86_64::fpu::*;
import kernel::arch::x86_64::idt::*;
import kernel::arch::x86_64::serial::*;
import kernel::arch::x86_64::thread_context::*;
import kernel::arch::x86_64::tss::*;
import kernel::interrupts::lapic::*;
import kernel::interrupts::ioapic::*;
import kernel::interrupts::route::*;
import kernel::drivers::i8042::*;
import kernel::memory::tlb_shootdown::*;
import kernel::scheduler::core::*;
import kernel::scheduler::sleep::*;
import kernel::syscall::dispatch::*;

pub const IRQ_VECTOR_TIMER: u16 = 0x40;
pub const IRQ_VECTOR_KEYBOARD: u16 = 0x41;
pub const IRQ_VECTOR_MOUSE: u16 = 0x42;
pub const IRQ_VECTOR_RESCHEDULE: u16 = 0x43;
pub const IRQ_VECTOR_RESCHEDULE_IPI: u16 = 0x44;
pub const IRQ_VECTOR_TLB_SHOOTDOWN_IPI: u16 = 0x45;
pub const IRQ_VECTOR_SPURIOUS: u16 = 0xFF;

static mut IRQ_IDT_READY: bool = false;
static mut IRQ_ROUTES_READY: bool = false;
static mut IRQ_TIMER_COUNT: u64 = 0;
static mut IRQ_CPU_TIMER_COUNT: [u64; SCHEDULER_CPU_SLOT_COUNT] = [0; SCHEDULER_CPU_SLOT_COUNT];
static mut IRQ_KEYBOARD_COUNT: u64 = 0;
static mut IRQ_MOUSE_COUNT: u64 = 0;
static mut IRQ_SPURIOUS_COUNT: u64 = 0;
static mut IRQ_RESCHEDULE_IPI_COUNT: u64 = 0;
static mut IRQ_TLB_SHOOTDOWN_IPI_COUNT: u64 = 0;

@system
fn irq_install_gate(vector: u16) -> bool {
    let handler = x86_irq_stub_address(vector);
    if handler == 0 { return false; }
    return idt_set_irq_gate(vector, handler);
}

@system
fn irq_install_user_gate(vector: u16) -> bool {
    let handler = x86_irq_stub_address(vector);
    if handler == 0 { return false; }
    return idt_set_user_irq_gate(vector, handler);
}

@system
pub fn irq_prepare_idt() -> bool {
    unsafe { IRQ_IDT_READY = false; }
    if !idt_exceptions_ready() || !tlb_shootdown_is_ready() { return false; }
    if !irq_install_gate(IRQ_VECTOR_TIMER) { return false; }
    if !irq_install_gate(IRQ_VECTOR_KEYBOARD) { return false; }
    if !irq_install_gate(IRQ_VECTOR_MOUSE) { return false; }
    if !irq_install_user_gate(IRQ_VECTOR_RESCHEDULE) { return false; }
    if !irq_install_gate(IRQ_VECTOR_RESCHEDULE_IPI) { return false; }
    if !irq_install_gate(IRQ_VECTOR_TLB_SHOOTDOWN_IPI) { return false; }
    if !irq_install_gate(IRQ_VECTOR_SPURIOUS) { return false; }
    unsafe { IRQ_IDT_READY = true; }
    return true;
}

@system
pub fn irq_prepare_masked_ioapic_routes() -> bool {
    unsafe { IRQ_ROUTES_READY = false; }
    if !IRQ_IDT_READY || !lapic_is_ready() || !ioapic_is_ready() { return false; }
    let keyboard = interrupt_route_keyboard(IRQ_VECTOR_KEYBOARD);
    if !keyboard.valid { return false; }
    let mouse = interrupt_route_ps2_mouse(IRQ_VECTOR_MOUSE);
    if !mouse.valid { return false; }
    let destination = lapic_id();
    if !ioapic_program_route_masked(&keyboard, destination) { return false; }
    if !ioapic_program_route_masked(&mouse, destination) { return false; }
    unsafe { IRQ_ROUTES_READY = true; }
    return true;
}

@system pub fn irq_idt_ready() -> bool { unsafe { return IRQ_IDT_READY; } }
@system pub fn irq_routes_ready() -> bool { unsafe { return IRQ_ROUTES_READY; } }
@system pub fn irq_timer_count() -> u64 { unsafe { return IRQ_TIMER_COUNT; } }
@system
pub fn irq_timer_count_for_cpu(cpu_slot: usize) -> u64 {
    if cpu_slot >= SCHEDULER_CPU_SLOT_COUNT { return 0; }
    if cpu_slot == 0 { return irq_timer_count(); }
    unsafe { return IRQ_CPU_TIMER_COUNT[cpu_slot]; }
}
@system pub fn irq_keyboard_count() -> u64 { unsafe { return IRQ_KEYBOARD_COUNT; } }
@system pub fn irq_mouse_count() -> u64 { unsafe { return IRQ_MOUSE_COUNT; } }
@system pub fn irq_spurious_count() -> u64 { unsafe { return IRQ_SPURIOUS_COUNT; } }
@system pub fn irq_reschedule_ipi_count() -> u64 { unsafe { return IRQ_RESCHEDULE_IPI_COUNT; } }
@system pub fn irq_tlb_shootdown_ipi_count() -> u64 { unsafe { return IRQ_TLB_SHOOTDOWN_IPI_COUNT; } }

// Caminho sem FPU: publica o CR3 somente depois que o scheduler terminou de
// selecionar o frame/root. O scheduler continua sem importar memory.
@system
fn irq_schedule_publish_root(frame_address: u64) -> u64 {
    let selected = scheduler_on_timer_interrupt(frame_address);
    // IRQs de timer podem chegar antes de smp_initialize_base() registrar o
    // BSP e antes de scheduler_initialize() ativar qualquer contexto. Nessa
    // janela nao existe decisao de scheduling para publicar.
    if scheduler_is_active() && !tlb_shootdown_publish_current_root() { loop {} }
    return selected;
}

@system
fn irq_schedule_with_fpu(frame_address: u64) -> u64 {
    if !scheduler_switch_lock() { loop {} }
    let cpu_slot = scheduler_current_cpu_slot();
    if cpu_slot == SCHEDULER_INVALID_CPU_SLOT { loop {} }
    let old_tid = scheduler_current_thread_id();
    let old_terminated = scheduler_thread_is_terminated(old_tid);
    if old_tid != 0 && fpu_is_ready() && !fpu_save_thread(old_tid) { loop {} }
    let selected = scheduler_on_timer_interrupt(frame_address);
    if scheduler_is_active() && !tlb_shootdown_publish_current_root() { loop {} }
    let new_tid = scheduler_current_thread_id();
    if x86_saved_frame_is_user(selected) {
        let kernel_rsp0 = selected + X86_KERNEL_THREAD_FRAME_BYTES;
        if kernel_rsp0 <= selected || (kernel_rsp0 & 15) != 0 ||
           !tss_set_rsp0_for_cpu(cpu_slot, kernel_rsp0) { loop {} }
    }
    if fpu_is_ready() && (cpu_slot == 0 || new_tid != 0) && !fpu_restore_thread(new_tid) { loop {} }
    if fpu_is_ready() && old_terminated && old_tid != 0 && old_tid != new_tid {
        if !fpu_release_thread(old_tid) { loop {} }
    }
    if !scheduler_switch_unlock() { loop {} }
    return selected;
}

@system
@export
pub fn sotlas_x86_irq_dispatch(vector: u64, frame_address: u64) -> u64 {
    if vector == IRQ_VECTOR_SPURIOUS as u64 {
        unsafe { IRQ_SPURIOUS_COUNT += 1; }
        return frame_address;
    }

    if vector == IRQ_VECTOR_RESCHEDULE as u64 {
        if x86_saved_frame_is_user(frame_address) {
            let action = syscall_dispatch_frame(frame_address);
            if action == SYSCALL_ACTION_EXIT {
                if !scheduler_terminate_current() { loop {} }
                return irq_schedule_with_fpu(frame_address);
            }
            return frame_address;
        }
        if !fpu_is_ready() { return irq_schedule_publish_root(frame_address); }
        return irq_schedule_with_fpu(frame_address);
    }

    if vector == IRQ_VECTOR_RESCHEDULE_IPI as u64 {
        unsafe { IRQ_RESCHEDULE_IPI_COUNT += 1; }
        lapic_eoi();
        if !fpu_is_ready() { loop {} }
        return irq_schedule_with_fpu(frame_address);
    }

    // IPI 0x45 não entra no scheduler: apenas invalida a página publicada e
    // confirma a geração. EOI vem depois do INVLPG/ACK para manter a ordem.
    if vector == IRQ_VECTOR_TLB_SHOOTDOWN_IPI as u64 {
        unsafe { IRQ_TLB_SHOOTDOWN_IPI_COUNT += 1; }
        let handled = tlb_shootdown_handle_ipi();
        lapic_eoi();
        if !handled { loop {} }
        return frame_address;
    }

    if vector == IRQ_VECTOR_TIMER as u64 {
        let cpu_slot = scheduler_current_cpu_slot();
        let mut timer_count: u64 = 0;
        let bsp_clock = cpu_slot == 0 || cpu_slot == SCHEDULER_INVALID_CPU_SLOT;
        unsafe {
            if bsp_clock {
                IRQ_TIMER_COUNT += 1;
                timer_count = IRQ_TIMER_COUNT;
            } else if cpu_slot < SCHEDULER_CPU_SLOT_COUNT {
                IRQ_CPU_TIMER_COUNT[cpu_slot] += 1;
                timer_count = IRQ_CPU_TIMER_COUNT[cpu_slot];
            }
        }
        lapic_eoi();
        if bsp_clock {
            if timer_count <= 3 { x86_serial_write_hex32_marker('T' as u8, timer_count as u32); }
            scheduler_sleep_on_timer_tick(timer_count);
        }
        if !fpu_is_ready() { return irq_schedule_publish_root(frame_address); }
        return irq_schedule_with_fpu(frame_address);
    }
    if vector == IRQ_VECTOR_KEYBOARD as u64 {
        i8042_drain_irq_output();
        unsafe { IRQ_KEYBOARD_COUNT += 1; }
        lapic_eoi();
        return frame_address;
    }
    if vector == IRQ_VECTOR_MOUSE as u64 {
        i8042_drain_irq_output();
        unsafe { IRQ_MOUSE_COUNT += 1; }
        lapic_eoi();
        return frame_address;
    }
    return frame_address;
}
