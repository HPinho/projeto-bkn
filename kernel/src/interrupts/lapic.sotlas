// Baken OS — Local APIC xAPIC pos-cutover.
//
// So opera depois que a pagina MMIO indicada pela MADT foi mapeada UC. O modo
// x2APIC e recusado nesta fase. Alem de EOI/LVT e ICR INIT/SIPI, APs podem
// preparar o proprio Local APIC e receber IPIs de reschedule dedicados.

module kernel::interrupts::lapic;

import kernel::arch::x86_64::cpu::*;
import kernel::memory::active_page_tables::*;

pub const IA32_APIC_BASE_MSR: u32 = 0x1B;
pub const IA32_APIC_BASE_ENABLE: u64 = 1 << 11;
pub const IA32_APIC_BASE_X2APIC: u64 = 1 << 10;
pub const IA32_APIC_BASE_ADDRESS_MASK: u64 = 0x000FFFFFFFFFF000;

pub const LAPIC_REG_ID: u64 = 0x020;
pub const LAPIC_REG_VERSION: u64 = 0x030;
pub const LAPIC_REG_EOI: u64 = 0x0B0;
pub const LAPIC_REG_SVR: u64 = 0x0F0;
pub const LAPIC_REG_ICR_LOW: u64 = 0x300;
pub const LAPIC_REG_ICR_HIGH: u64 = 0x310;
pub const LAPIC_REG_LVT_TIMER: u64 = 0x320;
pub const LAPIC_REG_LVT_THERMAL: u64 = 0x330;
pub const LAPIC_REG_LVT_PERF: u64 = 0x340;
pub const LAPIC_REG_LVT_LINT0: u64 = 0x350;
pub const LAPIC_REG_LVT_LINT1: u64 = 0x360;
pub const LAPIC_REG_LVT_ERROR: u64 = 0x370;

pub const LAPIC_LVT_MASKED: u32 = 1 << 16;
pub const LAPIC_SVR_ENABLE: u32 = 1 << 8;
pub const LAPIC_SPURIOUS_VECTOR: u32 = 0xFF;
pub const LAPIC_ICR_DELIVERY_STATUS: u32 = 1 << 12;
pub const LAPIC_ICR_INIT_ASSERT: u32 = 0x0000C500;
pub const LAPIC_ICR_INIT_DEASSERT: u32 = 0x00008500;
pub const LAPIC_ICR_STARTUP: u32 = 0x00000600;
pub const LAPIC_ICR_SPIN_LIMIT: u64 = 1000000;
pub const LAPIC_FIXED_VECTOR_MIN: u8 = 0x20;
pub const LAPIC_FIXED_VECTOR_MAX: u8 = 0xFE;

static mut LAPIC_READY: bool = false;
static mut LAPIC_BASE: u64 = 0;
static mut LAPIC_VERSION: u32 = 0;
static mut LAPIC_ID: u8 = 0;

@system
fn lapic_read(offset: u64) -> u32 {
    unsafe {
        if !LAPIC_READY && offset != LAPIC_REG_VERSION && offset != LAPIC_REG_ID { return 0; }
        if LAPIC_BASE == 0 { return 0; }
        return x86_mmio_read32(LAPIC_BASE + offset);
    }
}

@system
fn lapic_write(offset: u64, value: u32) -> void {
    unsafe {
        if LAPIC_BASE == 0 { return; }
        x86_mmio_write32(LAPIC_BASE + offset, value);
    }
}

@system
fn lapic_mask_local_vectors_at(base: u64) -> void {
    x86_mmio_write32(base + LAPIC_REG_LVT_TIMER, LAPIC_LVT_MASKED);
    x86_mmio_write32(base + LAPIC_REG_LVT_THERMAL, LAPIC_LVT_MASKED);
    x86_mmio_write32(base + LAPIC_REG_LVT_PERF, LAPIC_LVT_MASKED);
    x86_mmio_write32(base + LAPIC_REG_LVT_LINT0, LAPIC_LVT_MASKED);
    x86_mmio_write32(base + LAPIC_REG_LVT_LINT1, LAPIC_LVT_MASKED);
    x86_mmio_write32(base + LAPIC_REG_LVT_ERROR, LAPIC_LVT_MASKED);
    x86_mmio_write32(base + LAPIC_REG_SVR, LAPIC_SVR_ENABLE | LAPIC_SPURIOUS_VECTOR);
}

@system
pub fn lapic_init_masked(madt_base: u64) -> bool {
    unsafe {
        LAPIC_READY = false;
        LAPIC_BASE = 0;
        LAPIC_VERSION = 0;
        LAPIC_ID = 0;
    }
    if madt_base == 0 || (madt_base & 0xFFF) != 0 { return false; }

    let mut apic_base = x86_read_msr(IA32_APIC_BASE_MSR);
    if (apic_base & IA32_APIC_BASE_X2APIC) != 0 { return false; }

    let msr_base = apic_base & IA32_APIC_BASE_ADDRESS_MASK;
    if msr_base != 0 && msr_base != madt_base { return false; }
    if (apic_base & IA32_APIC_BASE_ENABLE) == 0 {
        apic_base = (apic_base & ~IA32_APIC_BASE_ADDRESS_MASK) |
            madt_base | IA32_APIC_BASE_ENABLE;
        x86_write_msr(IA32_APIC_BASE_MSR, apic_base);
    }

    if !active_page_tables_map_mmio_identity_4k(madt_base) { return false; }
    unsafe { LAPIC_BASE = madt_base; }

    let version = x86_mmio_read32(madt_base + LAPIC_REG_VERSION);
    if (version & 0xFF) == 0 { return false; }
    let apic_id = ((x86_mmio_read32(madt_base + LAPIC_REG_ID) >> 24) & 0xFF) as u8;

    // Preserve o caminho BSP historico e seus guardrails de mascaramento.
    lapic_write(LAPIC_REG_LVT_TIMER, LAPIC_LVT_MASKED);
    lapic_write(LAPIC_REG_LVT_THERMAL, LAPIC_LVT_MASKED);
    lapic_write(LAPIC_REG_LVT_PERF, LAPIC_LVT_MASKED);
    lapic_write(LAPIC_REG_LVT_LINT0, LAPIC_LVT_MASKED);
    lapic_write(LAPIC_REG_LVT_LINT1, LAPIC_LVT_MASKED);
    lapic_write(LAPIC_REG_LVT_ERROR, LAPIC_LVT_MASKED);
    lapic_write(LAPIC_REG_SVR, LAPIC_SVR_ENABLE | LAPIC_SPURIOUS_VECTOR);

    unsafe {
        LAPIC_VERSION = version;
        LAPIC_ID = apic_id;
        LAPIC_READY = true;
    }
    return true;
}

@system
pub fn lapic_prepare_current_cpu_masked() -> bool {
    let base = lapic_base();
    if !lapic_is_ready() || base == 0 { return false; }

    let mut apic_base = x86_read_msr(IA32_APIC_BASE_MSR);
    if (apic_base & IA32_APIC_BASE_X2APIC) != 0 { return false; }
    let msr_base = apic_base & IA32_APIC_BASE_ADDRESS_MASK;
    if msr_base != 0 && msr_base != base { return false; }
    if (apic_base & IA32_APIC_BASE_ENABLE) == 0 {
        apic_base = (apic_base & ~IA32_APIC_BASE_ADDRESS_MASK) |
            base | IA32_APIC_BASE_ENABLE;
        x86_write_msr(IA32_APIC_BASE_MSR, apic_base);
    }

    let version = x86_mmio_read32(base + LAPIC_REG_VERSION);
    if (version & 0xFF) == 0 { return false; }
    lapic_mask_local_vectors_at(base);
    return true;
}

@system
pub fn lapic_is_ready() -> bool { unsafe { return LAPIC_READY; } }

@system
pub fn lapic_base() -> u64 { unsafe { return LAPIC_BASE; } }

@system
pub fn lapic_version() -> u32 { unsafe { return LAPIC_VERSION; } }

@system
pub fn lapic_id() -> u8 { unsafe { return LAPIC_ID; } }

@system
pub fn lapic_current_id() -> u8 {
    let base = lapic_base();
    if base == 0 { return 0; }
    return ((x86_mmio_read32(base + LAPIC_REG_ID) >> 24) & 0xFF) as u8;
}

@system
pub fn lapic_wait_icr_idle(spin_limit: u64) -> bool {
    if !lapic_is_ready() || spin_limit == 0 { return false; }
    let mut spins: u64 = 0;
    while spins < spin_limit {
        if (lapic_read(LAPIC_REG_ICR_LOW) & LAPIC_ICR_DELIVERY_STATUS) == 0 {
            return true;
        }
        x86_cpu_pause();
        spins += 1;
    }
    return false;
}

@system
fn lapic_send_icr(destination_apic_id: u8, command: u32) -> bool {
    if !lapic_wait_icr_idle(LAPIC_ICR_SPIN_LIMIT) { return false; }
    lapic_write(LAPIC_REG_ICR_HIGH, (destination_apic_id as u32) << 24);
    lapic_write(LAPIC_REG_ICR_LOW, command);
    return lapic_wait_icr_idle(LAPIC_ICR_SPIN_LIMIT);
}

@system
pub fn lapic_send_init_assert(destination_apic_id: u8) -> bool {
    return lapic_send_icr(destination_apic_id, LAPIC_ICR_INIT_ASSERT);
}

@system
pub fn lapic_send_init_deassert(destination_apic_id: u8) -> bool {
    return lapic_send_icr(destination_apic_id, LAPIC_ICR_INIT_DEASSERT);
}

@system
pub fn lapic_send_startup(destination_apic_id: u8, vector: u8) -> bool {
    if vector == 0 { return false; }
    return lapic_send_icr(destination_apic_id, LAPIC_ICR_STARTUP | (vector as u32));
}

// Fixed-delivery IPI. Um vetor separado do INT 0x43 e obrigatorio porque IPIs
// exigem EOI, enquanto o yield/syscall por software nao deve emitir EOI.
@system
pub fn lapic_send_fixed(destination_apic_id: u8, vector: u8) -> bool {
    if vector < LAPIC_FIXED_VECTOR_MIN || vector > LAPIC_FIXED_VECTOR_MAX { return false; }
    return lapic_send_icr(destination_apic_id, vector as u32);
}

@system
pub fn lapic_eoi() -> void {
    unsafe {
        if !LAPIC_READY { return; }
    }
    lapic_write(LAPIC_REG_EOI, 0);
}
