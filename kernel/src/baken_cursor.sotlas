// Baken OS - Cursor Moderno em Alta Definicao & Setas Animadas em Sotlas (@system)
// Substitui o cursor bitmap arcaico por seta estilizada Fluent com sombra de vidro
// e nucleo de luz cosmica animada.

module kernel::baken_cursor;

import kernel::baken_rasterizer::*;

static mut G_CURSOR_X: i32 = 960;
static mut G_CURSOR_Y: i32 = 540;

@system
pub fn baken_cursor_set_pos(x: i32, y: i32) -> void {
    unsafe {
        G_CURSOR_X = x;
        G_CURSOR_Y = y;
    }
}

@system
pub fn baken_cursor_get_x() -> i32 {
    unsafe { return G_CURSOR_X; }
}

@system
pub fn baken_cursor_get_y() -> i32 {
    unsafe { return G_CURSOR_Y; }
}

// Seta do Cursor de Alta Precisão estilo macOS (12x19) com Contorno Nítido e Sombra Suave
@system
pub fn baken_cursor_render(cx: i32, cy: i32, tick: u32) -> void {
    baken_cursor_set_pos(cx, cy);
    if (cx < 0 || cy < 0) { return; }
    let x = cx as u32;
    let y = cy as u32;

    // Máscaras de bits por linha (19 linhas, até 12 colunas)
    // 0: transparente, b_mask: borda escura (#0F172A), f_mask: interior branco (#FFFFFF)
    let border_masks: [u16; 19] = [
        0x0001, 0x0003, 0x0005, 0x0009, 0x0011, 0x0021, 0x0041, 0x0081,
        0x0101, 0x0201, 0x0401, 0x0fc1, 0x0049, 0x0125, 0x0123, 0x0241,
        0x0240, 0x0480, 0x0300
    ];
    let fill_masks: [u16; 19] = [
        0x0000, 0x0000, 0x0002, 0x0006, 0x000e, 0x001e, 0x003e, 0x007e,
        0x00fe, 0x01fe, 0x03fe, 0x003e, 0x0036, 0x00c2, 0x00c0, 0x0180,
        0x0180, 0x0300, 0x0000
    ];

    // 1. Sombra Suave com Offset de 1px x 2px
    for mut row in 0..19 {
        let bm = border_masks[row as usize];
        let fm = fill_masks[row as usize];
        let shape = bm | fm;
        for mut col in 0..12 {
            if ((shape & (1 << col)) != 0) {
                raster_put_pixel_alpha(x + col + 1, y + row + 2, 0x00000000, 48);
            }
        }
    }

    // 2. Preenchimento e Borda Nítida
    for mut row in 0..19 {
        let bm = border_masks[row as usize];
        let fm = fill_masks[row as usize];
        for mut col in 0..12 {
            let bit = (1 << col);
            if ((bm & bit) != 0) {
                // Contorno escuro sólido de alta definição
                raster_put_pixel_alpha(x + col, y + row, 0x000F172A, 245);
            } else if ((fm & bit) != 0) {
                // Corpo da seta em branco acetinado puro
                raster_put_pixel_alpha(x + col, y + row, 0x00FFFFFF, 255);
            }
        }
    }
}

// Renderiza uma Seta de Acao Animada Estilizada para Botoes (Micro-Interacao de Hover/Fluidez)
@system
pub fn baken_draw_animated_action_arrow(x: u32, y: u32, tick: u32, color: u32, is_hover: bool) -> void {
    // Deslocamento suave de ida e volta (respiração contínua sem saltos bruscos)
    let cycle = if is_hover { 48 } else { 72 };
    let phase = tick % cycle;
    let half = cycle / 2;
    let wave = if phase < half { phase } else { cycle - phase };
    let dx = if is_hover { (wave * 4) / half } else { (wave * 2) / half };

    let ox = x + dx;
    let oy = y;

    // Desenha uma seta chanfrada vetorial '->' moderna e nitida
    // 1. Linha horizontal da haste da seta (7px)
    for mut i in 0..7 {
        raster_put_pixel_alpha(ox + i, oy + 4, color, 255);
        raster_put_pixel_alpha(ox + i, oy + 5, color, 255);
    }
    // 2. Ponta em chevron angular de 45 graus
    raster_put_pixel_alpha(ox + 5, oy + 2, color, 255);
    raster_put_pixel_alpha(ox + 6, oy + 3, color, 255);
    raster_put_pixel_alpha(ox + 7, oy + 4, color, 255);
    raster_put_pixel_alpha(ox + 7, oy + 5, color, 255);
    raster_put_pixel_alpha(ox + 6, oy + 6, color, 255);
    raster_put_pixel_alpha(ox + 5, oy + 7, color, 255);

    // Destaque brilhante na ponta
    raster_put_pixel_alpha(ox + 8, oy + 4, 0x00FFFFFF, 220);
    raster_put_pixel_alpha(ox + 8, oy + 5, 0x00FFFFFF, 220);
}
