// -----------------------------------------------------------------------------
// FUNCOES GETTER CONVENIENTES
// -----------------------------------------------------------------------------

@system pub fn i18n_top_file() -> *const u8 { unsafe { return I18N_TOP_FILE[CURRENT_SYSTEM_LANG as usize]; } }
@system pub fn i18n_top_edit() -> *const u8 { unsafe { return I18N_TOP_EDIT[CURRENT_SYSTEM_LANG as usize]; } }
@system pub fn i18n_top_view() -> *const u8 { unsafe { return I18N_TOP_VIEW[CURRENT_SYSTEM_LANG as usize]; } }
@system pub fn i18n_top_install() -> *const u8 { unsafe { return I18N_TOP_INSTALL[CURRENT_SYSTEM_LANG as usize]; } }
@system pub fn i18n_top_live() -> *const u8 { unsafe { return I18N_TOP_LIVE[CURRENT_SYSTEM_LANG as usize]; } }

@system pub fn i18n_app_name(id: u32) -> *const u8 {
    unsafe {
        let l = CURRENT_SYSTEM_LANG as usize;
        let mid = id % 6;
        if (mid == 0) { return I18N_APP_FILES[l]; }
        if (mid == 1) { return I18N_APP_NOTES[l]; }
        if (mid == 2) { return I18N_APP_SETTINGS[l]; }
        if (mid == 3) { return I18N_APP_TERMINAL[l]; }
        if (mid == 4) { return I18N_APP_ABOUT[l]; }
        return I18N_TOP_INSTALL[l];
    }
}

@system pub fn i18n_win_title(id: u32) -> *const u8 {
    unsafe {
        let l = CURRENT_SYSTEM_LANG as usize;
        let mid = id % 6;
        if (mid == 0) { return I18N_WIN_FILES[l]; }
        if (mid == 1) { return I18N_WIN_NOTES[l]; }
        if (mid == 2) { return I18N_WIN_SETTINGS[l]; }
        if (mid == 3) { return "BakenTerminal - /home/root".as_ptr(); }
        if (mid == 4) { return I18N_WIN_ABOUT[l]; }
        return I18N_TOP_INSTALL[l];
    }
}

@system pub fn i18n_btn_start() -> *const u8 { unsafe { return I18N_BTN_START[CURRENT_SYSTEM_LANG as usize]; } }
@system pub fn i18n_btn_start_for_lang(idx: usize) -> *const u8 {
    let l = if (idx < 11) { idx } else { 0 };
    return I18N_BTN_START[l];
}

@system pub fn i18n_btn_next() -> *const u8 { unsafe { return I18N_BTN_NEXT[CURRENT_SYSTEM_LANG as usize]; } }
@system pub fn i18n_btn_back() -> *const u8 { unsafe { return I18N_BTN_BACK[CURRENT_SYSTEM_LANG as usize]; } }
@system pub fn i18n_footer_help() -> *const u8 { unsafe { return I18N_FOOTER_HELP[CURRENT_SYSTEM_LANG as usize]; } }
@system pub fn i18n_footer_help_for_lang(idx: usize) -> *const u8 {
    let l = if (idx < 11) { idx } else { 0 };
    return I18N_FOOTER_HELP[l];
}

@system pub fn i18n_welcome_text_for_lang(idx: usize) -> *const u8 {
    let l = if (idx < 11) { idx } else { 0 };
    return I18N_WELCOME_TEXTS[l];
}
