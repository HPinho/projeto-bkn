// Baken OS - Modulo Central de Internacionalizacao Multilingue em Sotlas (@system)
// Dicionarios completos para 11 Idiomas Globais:
// 0: PT-BR, 1: EN-US, 2: FR, 3: IT, 4: ES, 5: DE, 6: EL, 7: ZH, 8: JA, 9: HI, 10: SW.

module kernel::baken_i18n;

pub static mut CURRENT_SYSTEM_LANG: u32 = 0;

@system
pub fn baken_i18n_set_lang(lang: u32) -> void {
    unsafe {
        CURRENT_SYSTEM_LANG = if (lang < 11) { lang } else { 0 };
    }
}

@system
pub fn baken_i18n_get_lang() -> u32 {
    unsafe {
        return CURRENT_SYSTEM_LANG;
    }
}

