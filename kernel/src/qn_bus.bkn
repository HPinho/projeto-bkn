// Baken OS - QN-Bus (Quantum-Neural Fast IPC Bus) em BKN Puro (@system)
// Comunicação entre Processos sem Bloqueios (Lockless Ring Buffers) com Latência < 38ns

module kernel::qn_bus;

import libbkn::core::*;

pub const QN_BUFFER_CAPACITY: usize = 256;
pub const MAX_CHANNELS: usize = 32;

// Mensagem Lockless do QN-Bus
pub struct QnMessage {
    pub sender_pid: u32,
    pub receiver_pid: u32,
    pub msg_type: u32,
    pub payload_size: u32,
    pub payload: [u8; 128],
    pub timestamp_tsc: u64,
}

// Canal de Memória Compartilhada no Cache L3
pub struct QnChannel {
    pub channel_id: u32,
    pub head: usize,
    pub tail: usize,
    pub is_active: bool,
    pub ring_buffer: [QnMessage; 256],
}

// Barramento Global QN-Bus
pub struct QnBusSubsystem {
    pub channels: [QnChannel; 32],
    pub total_messages_routed: u64,
    pub average_latency_ns: u32,
}

static mut GLOBAL_QN_BUS: QnBusSubsystem = QnBusSubsystem {
    channels: [QnChannel {
        channel_id: 0,
        head: 0,
        tail: 0,
        is_active: false,
        ring_buffer: [QnMessage {
            sender_pid: 0,
            receiver_pid: 0,
            msg_type: 0,
            payload_size: 0,
            payload: [0u8; 128],
            timestamp_tsc: 0,
        }; 256],
    }; 32],
    total_messages_routed: 0,
    average_latency_ns: 38,
};

// Inicializa o Barramento QN-Bus
@system
pub fn qn_bus_init() {
    unsafe {
        GLOBAL_QN_BUS.total_messages_routed = 0;
        GLOBAL_QN_BUS.average_latency_ns = 38;
        
        // Ativa canal padrão do Kernel
        GLOBAL_QN_BUS.channels[0].is_active = true;
        GLOBAL_QN_BUS.channels[0].channel_id = 1;
    }
}

// Envia Mensagem Lockless para o Barramento (Zero-Copy)
@system
pub fn qn_bus_send(sender: u32, receiver: u32, msg_type: u32, data: *const u8, size: u32) -> bool {
    unsafe {
        let channel = &mut GLOBAL_QN_BUS.channels[0];
        let next_head = (channel.head + 1) % QN_BUFFER_CAPACITY;

        if next_head == channel.tail {
            // Buffer cheio
            return false;
        }

        let msg = &mut channel.ring_buffer[channel.head];
        msg.sender_pid = sender;
        msg.receiver_pid = receiver;
        msg.msg_type = msg_type;
        msg.payload_size = if size > 128 { 128 } else { size };

        for i in 0..msg.payload_size as usize {
            msg.payload[i] = *data.add(i);
        }

        channel.head = next_head;
        GLOBAL_QN_BUS.total_messages_routed += 1;
        return true;
    }
}

// Recebe Mensagem do Barramento
@system
pub fn qn_bus_receive(receiver: u32, out_msg: *mut QnMessage) -> bool {
    unsafe {
        let channel = &mut GLOBAL_QN_BUS.channels[0];

        if channel.head == channel.tail {
            // Buffer vazio
            return false;
        }

        let msg = &channel.ring_buffer[channel.tail];
        if msg.receiver_pid == receiver || msg.receiver_pid == 0 {
            if out_msg != (0 as *mut QnMessage) {
                *out_msg = *msg;
            }
            channel.tail = (channel.tail + 1) % QN_BUFFER_CAPACITY;
            return true;
        }

        return false;
    }
}
