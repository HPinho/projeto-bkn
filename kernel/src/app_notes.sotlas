// Baken OS - BakenNotes Text & Code Editor (Tema Claro)
// 100% Implementado na linguagem Sotlas (@system)

module kernel::app_notes;

import kernel::graphics_engine::*;
import kernel::bakenfx::*;

pub struct NotesState {
    pub cursor_line: u32;
    pub cursor_col: u32;
    pub total_lines: u32;
    pub is_modified: bool;
}

static mut NOTES_STATE: NotesState = NotesState {
    cursor_line: 4,
    cursor_col: 18,
    total_lines: 9,
    is_modified: false,
};

@system
pub fn app_notes_render(x: u32, y: u32, w: u32, h: u32) -> void {
    unsafe {
        // Fundo principal do editor (Branco Papel Suave)
        bakenfx_fill_rect_alpha(x, y, w, h, 0x00FFFFFF, 250);

        // 1. Menu Ribbon Superior
        let bar_h: u32 = 32;
        bakenfx_fill_rect_alpha(x, y, w, bar_h, 0x00F1F5F9, 230);
        bakenfx_draw_hline(x, y + bar_h, w, 0x00CBD5E1, 180);

        // Itens do Menu
        bakenfx_draw_text_alpha(x + 14, y + 8, "Arquivo", 0x000284C7, 1, 255);
        bakenfx_draw_text_alpha(x + 76, y + 8, "Editar", 0x00334155, 1, 230);
        bakenfx_draw_text_alpha(x + 130, y + 8, "Visualizar", 0x00334155, 1, 230);
        bakenfx_draw_text_alpha(x + 205, y + 8, "Compilar (F5)", 0x00059669, 1, 255);

        // Indicador de Arquivo Ativo
        let tab_w: u32 = 180;
        let tab_x = x + w - tab_w - 12;
        bakenfx_draw_panel(tab_x, y + 4, tab_w, 24, 0x00FFFFFF, 220, 0x00CBD5E1, 6);
        bakenfx_draw_text_alpha(tab_x + 8, y + 8, "kernel_main.sotlas *", 0x000F172A, 1, 240);

        // 2. Gutter Lateral com Numeração de Linhas
        let gutter_w: u32 = 38;
        let body_y = y + bar_h + 1;
        let body_h = h - bar_h - 26;
        bakenfx_fill_rect_alpha(x, body_y, gutter_w, body_h, 0x00F8FAFC, 230);
        bakenfx_draw_hline(x + gutter_w, body_y, 1, 0x00E2E8F0, 150);

        // 3. Linhas de Código Sintetizadas com Cores Claras
        static const LINE_NUMS: [&str; 9] = ["01", "02", "03", "04", "05", "06", "07", "08", "09"];

        let line_h: u32 = 20;
        let text_x = x + gutter_w + 14;

        for mut i in 0..9 {
            let ly = body_y + 10 + (i * line_h);
            
            if i == NOTES_STATE.cursor_line {
                bakenfx_fill_rect_alpha(x + gutter_w + 1, ly - 2, w - gutter_w - 1, line_h, 0x00F1F5F9, 200);
                bakenfx_draw_text_alpha(x + 10, ly + 2, LINE_NUMS[i], 0x000284C7, 1, 255);
            } else {
                bakenfx_draw_text_alpha(x + 10, ly + 2, LINE_NUMS[i], 0x0094A3B8, 1, 200);
            }

            if i == 0 {
                bakenfx_draw_text_alpha(text_x, ly + 2, "// Baken OS - Kernel Native Core", 0x0064748B, 1, 220);
            } else if i == 1 {
                bakenfx_draw_text_alpha(text_x, ly + 2, "module kernel::app_notes;", 0x007C3AED, 1, 255);
            } else if i == 2 {
                bakenfx_draw_text_alpha(text_x, ly + 2, "import kernel::graphics_engine::*;", 0x000284C7, 1, 240);
            } else if i == 3 {
                bakenfx_draw_text_alpha(text_x, ly + 2, "", 0x000F172A, 1, 255);
            } else if i == 4 {
                bakenfx_draw_text_alpha(text_x, ly + 2, "@system pub fn app_notes_render() -> void {", 0x000284C7, 1, 255);
                bakenfx_fill_rect(text_x + 360, ly, 2, line_h - 4, 0x000284C7);
            } else if i == 5 {
                bakenfx_draw_text_alpha(text_x + 16, ly + 2, "bakenfx_draw_panel(10, 10, 100, 40, 0, 0, 0, 0);", 0x000F172A, 1, 245);
            } else if i == 6 {
                bakenfx_draw_text_alpha(text_x + 16, ly + 2, "bakenfx_draw_text(20, 20, \"BakenNotes\", 0);", 0x00059669, 1, 245);
            } else if i == 7 {
                bakenfx_draw_text_alpha(text_x + 16, ly + 2, "display_swap_buffers();", 0x00D97706, 1, 245);
            } else if i == 8 {
                bakenfx_draw_text_alpha(text_x, ly + 2, "}", 0x000284C7, 1, 255);
            }
        }

        // 4. Barra de Status Inferior
        let foot_y = y + h - 24;
        bakenfx_fill_rect_alpha(x, foot_y, w, 24, 0x00F1F5F9, 240);
        bakenfx_draw_hline(x, foot_y, w, 0x00CBD5E1, 180);

        bakenfx_draw_text_alpha(x + 12, foot_y + 5, "Sotlas 0.2.0 | UTF-8 | Linha 5, Coluna 18", 0x0064748B, 1, 230);
        bakenfx_draw_text_alpha(x + w - 140, foot_y + 5, "1.4 KB | LF | Ready", 0x00059669, 1, 240);
    }
}

@system
pub fn app_notes_handle_click(rel_x: i32, rel_y: i32) -> void {
    unsafe {
        if rel_y > 36 && rel_y < 250 {
            let clicked_line = ((rel_y - 42) / 20) as u32;
            if clicked_line < 9 {
                NOTES_STATE.cursor_line = clicked_line;
            }
        }
    }
}
