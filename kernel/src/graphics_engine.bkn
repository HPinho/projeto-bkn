// Baken OS - Motor Gráfico de Pixels de Alta Definição em BKN Puro (@system)
// Renderização Linear 32-bit ARGB8888, SDF Anti-Aliasing, Glassmorphism, Sombras e Gradientes Mesh
// v2.0 — Texto Bitmap 8x16, linha Bresenham, fill sólido, círculo com alpha

module kernel::graphics_engine;

// --- Fonte Bitmap 8x16 via C (bkn_font.c) ---
extern "C" {
    pub fn bkn_font_get_row(char_code: u8, row: u8) -> u8;
}

pub struct FramebufferConfig {
    pub base: *mut u32,
    pub width: u32,
    pub height: u32,
    pub pitch: u32,
}

static mut FB: FramebufferConfig = FramebufferConfig {
    base: 0 as *mut u32,
    width: 1920,
    height: 1080,
    pitch: 1920,
};

@system
pub fn gfx_init(base: *mut u32, width: u32, height: u32, pitch: u32) {
    unsafe {
        FB.base = base;
        FB.width = width;
        FB.height = height;
        FB.pitch = pitch;
    }
}

// --- Alpha Blending preciso (0..255) ---
@system
pub fn gfx_blend_color(bg: u32, fg: u32, alpha: u8) -> u32 {
    let a: u32 = alpha as u32;
    let inv_a: u32 = 255 - a;

    let bg_r: u32 = (bg >> 16) & 0xFF;
    let bg_g: u32 = (bg >> 8) & 0xFF;
    let bg_b: u32 = bg & 0xFF;

    let fg_r: u32 = (fg >> 16) & 0xFF;
    let fg_g: u32 = (fg >> 8) & 0xFF;
    let fg_b: u32 = fg & 0xFF;

    let out_r: u32 = ((fg_r * a) + (bg_r * inv_a)) / 255;
    let out_g: u32 = ((fg_g * a) + (bg_g * inv_a)) / 255;
    let out_b: u32 = ((fg_b * a) + (bg_b * inv_a)) / 255;

    return (out_r << 16) | (out_g << 8) | out_b;
}

@system
pub fn gfx_put_pixel(x: u32, y: u32, color: u32) {
    unsafe {
        if x < FB.width && y < FB.height {
            let offset = (y * FB.pitch + x) as usize;
            *FB.base.add(offset) = color;
        }
    }
}

@system
pub fn gfx_put_pixel_alpha(x: u32, y: u32, color: u32, alpha: u8) {
    unsafe {
        if x < FB.width && y < FB.height && alpha > 0 {
            let offset = (y * FB.pitch + x) as usize;
            if alpha == 255 {
                *FB.base.add(offset) = color;
            } else {
                let current = *FB.base.add(offset);
                *FB.base.add(offset) = gfx_blend_color(current, color, alpha);
            }
        }
    }
}

// --- Gradiente de fundo cósmico roxo-azul (igual à screenshot do Baken OS) ---
// Tons: roxo médio #7B6FA0 transitando para azul #5B7AB5 com onda suave
@system
pub fn gfx_draw_background_gradient(time_step: u32) {
    unsafe {
        let t = (time_step % 360) as f32 * 0.01745;
        for y in 0..FB.height {
            let fy = y as f32 / FB.height as f32;
            for x in 0..FB.width {
                let fx = x as f32 / FB.width as f32;

                // Ondas suaves para animar o wallpaper
                let wave  = ((fx * 3.14159 + t).sin()        * 0.5 + 0.5) * 18.0;
                let wave2 = ((fy * 2.71828 + t * 0.7).cos()  * 0.5 + 0.5) * 12.0;

                // Paleta roxo-azul como na screenshot (fundo do Baken OS)
                let r = (80.0  + fy * 40.0 + wave  * 0.5) as u32;
                let g = (65.0  + fx * 25.0 + wave2 * 0.4) as u32;
                let b = (140.0 + fy * 50.0 + wave  * 0.7 + wave2 * 0.5) as u32;

                let color = (r.min(180) << 16) | (g.min(150) << 8) | b.min(210);
                let offset = (y * FB.pitch + x) as usize;
                *FB.base.add(offset) = color;
            }
        }
    }
}

// --- Retângulo sólido rápido (sem alpha) ---
@system
pub fn gfx_fill_rect(x: u32, y: u32, w: u32, h: u32, color: u32) {
    for py in y..(y + h) {
        for px in x..(x + w) {
            gfx_put_pixel(px, py, color);
        }
    }
}

// --- Linha horizontal com alpha ---
@system
pub fn gfx_draw_hline(x: u32, y: u32, length: u32, color: u32, alpha: u8) {
    for px in x..(x + length) {
        gfx_put_pixel_alpha(px, y, color, alpha);
    }
}

// --- Linha de Bresenham com alpha ---
@system
pub fn gfx_draw_line(x0: i32, y0: i32, x1: i32, y1: i32, color: u32, alpha: u8) {
    let dx = (x1 - x0).abs();
    let dy = -(y1 - y0).abs();
    let sx: i32 = if x0 < x1 { 1 } else { -1 };
    let sy: i32 = if y0 < y1 { 1 } else { -1 };
    let mut err = dx + dy;
    let mut cx = x0;
    let mut cy = y0;

    loop {
        if cx >= 0 && cy >= 0 {
            gfx_put_pixel_alpha(cx as u32, cy as u32, color, alpha);
        }
        if cx == x1 && cy == y1 { break; }
        let e2 = 2 * err;
        if e2 >= dy { err += dy; cx += sx; }
        if e2 <= dx { err += dx; cy += sy; }
    }
}

// --- Retângulo com vidro fosco acrílico e borda arredondada ---
@system
pub fn gfx_draw_glass_rect(x: u32, y: u32, w: u32, h: u32, bg_color: u32, alpha: u8, border_color: u32, radius: u32) {
    let r2 = (radius * radius) as i32;

    for py in y..(y + h) {
        for px in x..(x + w) {
            let mut is_corner = false;
            let mut inside = true;

            let cx = if px < x + radius { x + radius } else if px > x + w - radius { x + w - radius } else { px };
            let cy = if py < y + radius { y + radius } else if py > y + h - radius { y + h - radius } else { py };

            if cx != px || cy != py {
                is_corner = true;
                let dx = px as i32 - cx as i32;
                let dy = py as i32 - cy as i32;
                if (dx * dx + dy * dy) > r2 {
                    inside = false;
                }
            }

            if inside {
                let is_border = px == x || px == x + w - 1 || py == y || py == y + h - 1 ||
                               (is_corner && {
                                   let dx = px as i32 - cx as i32;
                                   let dy = py as i32 - cy as i32;
                                   (dx * dx + dy * dy) >= ((radius - 1) * (radius - 1)) as i32
                               });

                if is_border {
                    gfx_put_pixel_alpha(px, py, border_color, 200);
                } else {
                    gfx_put_pixel_alpha(px, py, bg_color, alpha);
                }
            }
        }
    }
}

// --- Sombra Suave (Drop Shadow Volumétrico) ---
@system
pub fn gfx_draw_drop_shadow(x: u32, y: u32, w: u32, h: u32, blur: u32, spread: u32) {
    let sx = if x > blur + spread { x - blur - spread } else { 0 };
    let sy = if y > blur + spread { y - blur - spread } else { 0 };
    let ex = x + w + blur + spread;
    let ey = y + h + blur + spread;

    for py in sy..ey {
        for px in sx..ex {
            let qx = if px < x { (x - px) as f32 } else if px > x + w { (px - (x + w)) as f32 } else { 0.0 };
            let qy = if py < y { (y - py) as f32 } else if py > y + h { (py - (y + h)) as f32 } else { 0.0 };
            let dist = (qx * qx + qy * qy).sqrt();

            let max_dist = (blur + spread) as f32;
            if dist < max_dist && dist > 0.0 {
                let falloff = 1.0 - (dist / max_dist);
                let alpha = (120.0 * falloff * falloff) as u8;
                if alpha > 2 {
                    gfx_put_pixel_alpha(px, py, 0x00000000, alpha);
                }
            }
        }
    }
}

// --- Círculo Preenchido (ícones, botões de janela) ---
@system
pub fn gfx_draw_circle_button(cx: u32, cy: u32, radius: u32, color: u32) {
    let r2 = (radius * radius) as i32;
    for dy in 0..(radius * 2 + 1) {
        for dx in 0..(radius * 2 + 1) {
            let px = cx + dx - radius;
            let py = cy + dy - radius;
            let dist = (dx as i32 - radius as i32) * (dx as i32 - radius as i32) +
                       (dy as i32 - radius as i32) * (dy as i32 - radius as i32);
            if dist <= r2 {
                gfx_put_pixel(px, py, color);
            }
        }
    }
}

// --- Círculo com Alpha (halos de glow ao redor de ícones) ---
@system
pub fn gfx_draw_circle_alpha(cx: u32, cy: u32, radius: u32, color: u32, alpha: u8) {
    let r2 = (radius * radius) as i32;
    for dy in 0..(radius * 2 + 1) {
        for dx in 0..(radius * 2 + 1) {
            if cx + dx < radius || cy + dy < radius { continue; }
            let px = cx + dx - radius;
            let py = cy + dy - radius;
            let dist = (dx as i32 - radius as i32) * (dx as i32 - radius as i32) +
                       (dy as i32 - radius as i32) * (dy as i32 - radius as i32);
            if dist <= r2 {
                gfx_put_pixel_alpha(px, py, color, alpha);
            }
        }
    }
}

// ===================================================================
// RENDERIZAÇÃO DE TEXTO — Fonte Bitmap 8x16 (bkn_font.c)
// ===================================================================

// Renderiza um único caractere ASCII na posição (x, y)
// scale=1 → 8×16 px | scale=2 → 16×32 px | scale=3 → 24×48 px
@system
pub fn gfx_draw_char(x: u32, y: u32, ch: u8, color: u32, scale: u32) {
    if ch >= 128 { return; }
    for row in 0..16u32 {
        let bits = unsafe { bkn_font_get_row(ch, row as u8) };
        for col in 0..8u32 {
            if (bits >> (7 - col)) & 1 == 1 {
                for sy in 0..scale {
                    for sx in 0..scale {
                        gfx_put_pixel(x + col * scale + sx, y + row * scale + sy, color);
                    }
                }
            }
        }
    }
}

// Renderiza string terminada em nulo — máximo 256 caracteres por chamada
// Cada caractere ocupa (8 * scale + scale) pixels de largura (+ kerning de 1 scale)
@system
pub fn gfx_draw_text(x: u32, y: u32, text_ptr: *const u8, color: u32, scale: u32) {
    let char_step = 8 * scale + scale; // advance por caractere
    let mut cx = x;
    let mut i: usize = 0;
    loop {
        let ch = unsafe { *text_ptr.add(i) };
        if ch == 0 || i > 255 { break; }
        gfx_draw_char(cx, y, ch, color, scale);
        cx += char_step;
        i += 1;
    }
}

// Variante com alpha blend — para texto sobre painéis translúcidos
@system
pub fn gfx_draw_char_alpha(x: u32, y: u32, ch: u8, color: u32, scale: u32, alpha: u8) {
    if ch >= 128 { return; }
    for row in 0..16u32 {
        let bits = unsafe { bkn_font_get_row(ch, row as u8) };
        for col in 0..8u32 {
            if (bits >> (7 - col)) & 1 == 1 {
                for sy in 0..scale {
                    for sx in 0..scale {
                        gfx_put_pixel_alpha(x + col * scale + sx, y + row * scale + sy, color, alpha);
                    }
                }
            }
        }
    }
}

@system
pub fn gfx_draw_text_alpha(x: u32, y: u32, text_ptr: *const u8, color: u32, scale: u32, alpha: u8) {
    let char_step = 8 * scale + scale;
    let mut cx = x;
    let mut i: usize = 0;
    loop {
        let ch = unsafe { *text_ptr.add(i) };
        if ch == 0 || i > 255 { break; }
        gfx_draw_char_alpha(cx, y, ch, color, scale, alpha);
        cx += char_step;
        i += 1;
    }
}
