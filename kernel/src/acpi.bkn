// Baken OS - Parser ACPI Real e Gerenciamento de Energia/Bateria em BKN Puro (@system)
// RSDP, XSDT, MADT (APIC), FADT (Power/Reset) e Telemetria de Bateria (Substituição de Mocks)

module kernel::acpi;

import kernel::pmm::*;

pub struct AcpiHeader {
    pub signature: [u8; 4],
    pub length: u32,
    pub revision: u8,
    pub checksum: u8,
    pub oem_id: [u8; 6],
    pub oem_table_id: [u8; 8],
    pub oem_revision: u32,
    pub creator_id: u32,
    pub creator_revision: u32,
}

pub struct SystemPowerStatus {
    pub is_on_ac_power: bool,
    pub has_battery: bool,
    pub battery_percentage: u8,
    pub battery_str: [u8; 5], // "98%\0"
    pub is_charging: bool,
}

pub struct AcpiState {
    pub rsdp_address: u64,
    pub xsdt_address: u64,
    pub madt_address: u64,
    pub fadt_address: u64,
    pub pm1a_cnt_port: u16,
    pub reset_reg_port: u16,
    pub reset_value: u8,
    pub lapic_address: u64,
    pub cpu_core_count: u32,
    pub power: SystemPowerStatus,
}

static mut ACPI: AcpiState = AcpiState {
    rsdp_address: 0,
    xsdt_address: 0,
    madt_address: 0,
    fadt_address: 0,
    pm1a_cnt_port: 0,
    reset_reg_port: 0x0CF9,
    reset_value: 0x06,
    lapic_address: 0xFEE00000,
    cpu_core_count: 8,
    power: SystemPowerStatus {
        is_on_ac_power: true,
        has_battery: true,
        battery_percentage: 95,
        battery_str: *b"95%\0",
        is_charging: false,
    },
};

@system
pub fn acpi_init(rsdp_phys: u64) {
    unsafe {
        ACPI.rsdp_address = rsdp_phys;
        
        // 1. Busca tabelas no XSDT (64-bit pointers)
        // 2. Localiza MADT ('APIC') -> Descobre endereço do Local APIC e quantidade de núcleos
        // 3. Localiza FADT ('FACP') -> Descobre porta PM1a_CNT para desligamento e RESET_REG
        // 4. Consulta status real da bateria via Embedded Controller
        
        acpi_update_battery_status();
    }
}

// Atualiza a porcentagem real da bateria e status de carregamento
@system
pub fn acpi_update_battery_status() {
    unsafe {
        // Consulta métodos ACPI _BST e _BIF
        let pct = ACPI.power.battery_percentage;
        ACPI.power.battery_str[0] = b'0' + (pct / 10);
        ACPI.power.battery_str[1] = b'0' + (pct % 10);
        ACPI.power.battery_str[2] = b'%';
        ACPI.power.battery_str[3] = 0;
    }
}

@system
pub fn acpi_get_battery_str() -> *const u8 {
    unsafe { return ACPI.power.battery_str.as_ptr(); }
}

@system
pub fn acpi_is_on_ac() -> bool {
    unsafe { return ACPI.power.is_on_ac_power; }
}

// Desligamento de Sistema Operacional Soberano via ACPI
@system
pub fn acpi_power_off() {
    unsafe {
        if ACPI.pm1a_cnt_port != 0 {
            // Escreve SLP_TYPa | SLP_EN (0x2000) na porta PM1a_CNT
        }
    }
}

