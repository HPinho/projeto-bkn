// Baken OS - Sistema de Notificações Flutuantes (Aero Toast Notifications) em BKN Puro (@system)
// Notificações Translúcidas com Sombras Volumétricas e Animação de Entrada/Saída

module kernel::toast_notification;

import kernel::graphics_engine::*;
import kernel::baken_rasterizer::*;

pub const MAX_TOASTS: usize = 4;

pub enum ToastType {
    Info = 1,
    Success = 2,
    Warning = 3,
    Hardware = 4,
}

pub struct ToastNotification {
    pub id: u32,
    pub toast_type: ToastType,
    pub title: [u8; 32],
    pub message: [u8; 64],
    pub duration_ticks: u32,
    pub remaining_ticks: u32,
    pub is_active: bool,
}

pub struct ToastManager {
    pub active_count: usize,
    pub toasts: [ToastNotification; MAX_TOASTS],
}

static mut TOASTS: ToastManager = ToastManager {
    active_count: 0,
    toasts: [ToastNotification {
        id: 0,
        toast_type: ToastType::Info,
        title: [0; 32],
        message: [0; 64],
        duration_ticks: 0,
        remaining_ticks: 0,
        is_active: false,
    }; MAX_TOASTS],
};

@system
pub fn toast_init() {
    unsafe {
        TOASTS.active_count = 0;
        for i in 0..MAX_TOASTS {
            TOASTS.toasts[i].is_active = false;
        }

        // Notificação de boas-vindas do sistema
        toast_push(
            ToastType::Success,
            b"Baken OS Iniciado\0".as_ptr(),
            b"Hardware real e BakenFS online no Ring 0.\0".as_ptr(),
            300 // 5 segundos a 60 FPS
        );
    }
}

// Cria uma nova notificação flutuante
@system
pub fn toast_push(t_type: ToastType, title_ptr: *const u8, msg_ptr: *const u8, duration: u32) {
    unsafe {
        for i in 0..MAX_TOASTS {
            if !TOASTS.toasts[i].is_active {
                TOASTS.toasts[i].id = (i + 1) as u32;
                TOASTS.toasts[i].toast_type = t_type;
                TOASTS.toasts[i].duration_ticks = duration;
                TOASTS.toasts[i].remaining_ticks = duration;
                TOASTS.toasts[i].is_active = true;

                copy_str_safe(title_ptr, TOASTS.toasts[i].title.as_mut_ptr(), 31);
                copy_str_safe(msg_ptr, TOASTS.toasts[i].message.as_mut_ptr(), 63);

                TOASTS.active_count += 1;
                return;
            }
        }
    }
}

// Renderiza todas as notificações ativas no canto superior direito
@system
pub fn toast_render_all(screen_w: u32) {
    unsafe {
        let toast_w: u32 = 320;
        let toast_h: u32 = 64;
        let start_x = screen_w - toast_w - 20;
        let mut curr_y: u32 = 56; // Abaixo da Top Bar

        for i in 0..MAX_TOASTS {
            if TOASTS.toasts[i].is_active {
                let border_col = match TOASTS.toasts[i].toast_type {
                    ToastType::Success => 0x0010B981, // Esmeralda
                    ToastType::Warning => 0x00F59E0B, // Âmbar
                    ToastType::Hardware => 0x0038BDF8, // Ciano
                    _ => 0x006366F1, // Índigo
                };

                // Sombra e Corpo Translúcido
                gfx_draw_drop_shadow(start_x, curr_y, toast_w, toast_h, 14, 2);
                sdf_render_smooth_card(start_x, curr_y, toast_w, toast_h, 10, 0x000B1021, 235, border_col, 1.2);

                // Ponto indicador do tipo
                gfx_draw_circle_button(start_x + 18, curr_y + 20, 4, border_col);

                // Título e Mensagem
                gfx_draw_text(start_x + 30, curr_y + 12, TOASTS.toasts[i].title.as_ptr(), 0x00FFFFFF, 1);
                gfx_draw_text_alpha(start_x + 30, curr_y + 34, TOASTS.toasts[i].message.as_ptr(), 0x00CBD5E1, 1, 200);

                // Decai tempo restante
                if TOASTS.toasts[i].remaining_ticks > 0 {
                    TOASTS.toasts[i].remaining_ticks -= 1;
                } else {
                    TOASTS.toasts[i].is_active = false;
                }

                curr_y += toast_h + 12;
            }
        }
    }
}

@system
fn copy_str_safe(src: *const u8, dst: *mut u8, max: usize) {
    let mut i = 0;
    while i < max {
        let ch = unsafe { *src.add(i) };
        unsafe { *dst.add(i) = ch; }
        if ch == 0 { break; }
        i += 1;
    }
    unsafe { *dst.add(i) = 0; }
}
