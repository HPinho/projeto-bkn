// Baken OS — HID-4a: fila genérica de input com identidade e serialização SMP.
//
// O módulo permanece independente de HID/xHCI/DMA/ACPI. Eventos carregam
// device_id+generation e só entram na fila enquanto essa identidade está ACTIVE.
// Mutação/consumo usam IRQ-save + spinlock; detach pode purgar uma geração antiga.

module kernel::drivers::input_event;

import kernel::arch::x86_64::cpu::*;
import kernel::sync::spinlock::*;
import kernel::drivers::input_device::*;

pub const INPUT_EVENT_QUEUE_CAPACITY: usize = 512;

pub const INPUT_DEVICE_CLASS_GENERIC: u8 = 0;
pub const INPUT_DEVICE_CLASS_KEYBOARD: u8 = 1;
pub const INPUT_DEVICE_CLASS_POINTER: u8 = 2;
pub const INPUT_DEVICE_CLASS_TOUCH: u8 = 3;

pub const INPUT_EVENT_KIND_KEY_DOWN: u8 = 1;
pub const INPUT_EVENT_KIND_KEY_UP: u8 = 2;
pub const INPUT_EVENT_KIND_BUTTON_DOWN: u8 = 3;
pub const INPUT_EVENT_KIND_BUTTON_UP: u8 = 4;
pub const INPUT_EVENT_KIND_RELATIVE: u8 = 5;
pub const INPUT_EVENT_KIND_ABSOLUTE: u8 = 6;

pub const INPUT_EVENT_FLAG_NONE: u32 = 0;
pub const INPUT_EVENT_FLAG_RELATIVE: u32 = 1;

pub struct InputEvent {
    pub valid: bool;
    pub sequence: u64;
    pub device_id: u32;
    pub device_generation: u32;
    pub device_class: u8;
    pub kind: u8;
    pub report_id: u8;
    pub usage_page: u32;
    pub usage: u32;
    pub value: i64;
    pub flags: u32;
}

static mut INPUT_EVENT_QUEUE: [InputEvent; INPUT_EVENT_QUEUE_CAPACITY] = [
    InputEvent {
        valid: false, sequence: 0, device_id: INPUT_DEVICE_ID_NONE,
        device_generation: INPUT_DEVICE_GENERATION_INVALID,
        device_class: INPUT_DEVICE_CLASS_GENERIC, kind: 0, report_id: 0,
        usage_page: 0, usage: 0, value: 0, flags: INPUT_EVENT_FLAG_NONE
    };
    INPUT_EVENT_QUEUE_CAPACITY
];
static mut INPUT_EVENT_HEAD: usize = 0;
static mut INPUT_EVENT_TAIL: usize = 0;
static mut INPUT_EVENT_COUNT: usize = 0;
static mut INPUT_EVENT_NEXT_SEQUENCE: u64 = 1;
static mut INPUT_EVENT_DROPPED: u64 = 0;
static mut INPUT_EVENT_READY: bool = false;
static mut INPUT_EVENT_LOCK: SpinLock = SpinLock { state: SPINLOCK_UNLOCKED };
static mut INPUT_EVENT_LOCK_READY: bool = false;

@system
pub fn input_event_invalid() -> InputEvent {
    return InputEvent {
        valid: false, sequence: 0, device_id: INPUT_DEVICE_ID_NONE,
        device_generation: INPUT_DEVICE_GENERATION_INVALID,
        device_class: INPUT_DEVICE_CLASS_GENERIC, kind: 0, report_id: 0,
        usage_page: 0, usage: 0, value: 0, flags: INPUT_EVENT_FLAG_NONE
    };
}

@system
fn input_event_kind_valid(kind: u8) -> bool {
    return kind >= INPUT_EVENT_KIND_KEY_DOWN && kind <= INPUT_EVENT_KIND_ABSOLUTE;
}

@system
fn input_event_device_class_valid(device_class: u8) -> bool {
    return device_class <= INPUT_DEVICE_CLASS_TOUCH;
}

@system
fn input_event_lock_irq() -> u64 {
    let flags = x86_irq_save_disable();
    unsafe {
        if !INPUT_EVENT_LOCK_READY || !spinlock_lock(&mut INPUT_EVENT_LOCK) {
            x86_irq_restore(flags);
            return 0;
        }
    }
    return flags;
}

@system
fn input_event_unlock_irq(flags: u64) -> void {
    let mut released = false;
    unsafe { released = spinlock_unlock(&mut INPUT_EVENT_LOCK); }
    if !released { loop { x86_cpu_pause(); } }
    x86_irq_restore(flags);
}

@system
fn input_event_append_locked(device_id: u32,
                             device_generation: u32,
                             device_class: u8,
                             kind: u8,
                             report_id: u8,
                             usage_page: u32,
                             usage: u32,
                             value: i64,
                             flags: u32) -> bool {
    unsafe {
        if !INPUT_EVENT_READY || INPUT_EVENT_COUNT >= INPUT_EVENT_QUEUE_CAPACITY {
            if INPUT_EVENT_READY { INPUT_EVENT_DROPPED += 1; }
            return false;
        }
        let mut event = input_event_invalid();
        event.valid = true;
        event.sequence = INPUT_EVENT_NEXT_SEQUENCE;
        event.device_id = device_id;
        event.device_generation = device_generation;
        event.device_class = device_class;
        event.kind = kind;
        event.report_id = report_id;
        event.usage_page = usage_page;
        event.usage = usage;
        event.value = value;
        event.flags = flags;
        INPUT_EVENT_QUEUE[INPUT_EVENT_TAIL] = event;
        INPUT_EVENT_TAIL += 1;
        if INPUT_EVENT_TAIL >= INPUT_EVENT_QUEUE_CAPACITY { INPUT_EVENT_TAIL = 0; }
        INPUT_EVENT_COUNT += 1;
        INPUT_EVENT_NEXT_SEQUENCE += 1;
        if INPUT_EVENT_NEXT_SEQUENCE == 0 { INPUT_EVENT_NEXT_SEQUENCE = 1; }
    }
    return true;
}

@system
pub fn input_event_initialize() -> bool {
    let flags = x86_irq_save_disable();
    unsafe {
        if !INPUT_EVENT_LOCK_READY {
            if !spinlock_init(&mut INPUT_EVENT_LOCK) {
                x86_irq_restore(flags);
                return false;
            }
            INPUT_EVENT_LOCK_READY = true;
        }
        if !spinlock_lock(&mut INPUT_EVENT_LOCK) {
            x86_irq_restore(flags);
            return false;
        }
        INPUT_EVENT_HEAD = 0;
        INPUT_EVENT_TAIL = 0;
        INPUT_EVENT_COUNT = 0;
        INPUT_EVENT_NEXT_SEQUENCE = 1;
        INPUT_EVENT_DROPPED = 0;
        INPUT_EVENT_READY = false;
        let mut index: usize = 0;
        while index < INPUT_EVENT_QUEUE_CAPACITY {
            INPUT_EVENT_QUEUE[index] = input_event_invalid();
            index += 1;
        }
        INPUT_EVENT_READY = true;
        spinlock_unlock(&mut INPUT_EVENT_LOCK);
    }
    x86_irq_restore(flags);
    return true;
}

@system
pub fn input_event_queue_is_ready() -> bool { unsafe { return INPUT_EVENT_READY; } }

@system
pub fn input_event_queue_count() -> usize {
    let flags = input_event_lock_irq();
    if flags == 0 { return 0; }
    let mut count: usize = 0;
    unsafe { if INPUT_EVENT_READY { count = INPUT_EVENT_COUNT; } }
    input_event_unlock_irq(flags);
    return count;
}

@system
pub fn input_event_queue_dropped() -> u64 {
    let flags = input_event_lock_irq();
    if flags == 0 { return 0; }
    let mut dropped: u64 = 0;
    unsafe { if INPUT_EVENT_READY { dropped = INPUT_EVENT_DROPPED; } }
    input_event_unlock_irq(flags);
    return dropped;
}

@system
pub fn input_event_publish_for_device(device_id: u32,
                                      device_generation: u32,
                                      device_class: u8,
                                      kind: u8,
                                      report_id: u8,
                                      usage_page: u32,
                                      usage: u32,
                                      value: i64,
                                      flags: u32) -> bool {
    if !input_event_queue_is_ready() ||
       !input_event_device_class_valid(device_class) ||
       !input_event_kind_valid(kind) ||
       !input_device_is_active(device_id, device_generation) {
        return false;
    }
    let queue_flags = input_event_lock_irq();
    if queue_flags == 0 { return false; }

    // Revalida dentro da seção da fila. Se detach venceu a corrida depois da
    // primeira checagem, a geração antiga não pode entrar na fila.
    if !input_device_is_active(device_id, device_generation) {
        input_event_unlock_irq(queue_flags);
        return false;
    }
    let appended = input_event_append_locked(
        device_id, device_generation, device_class, kind, report_id,
        usage_page, usage, value, flags);
    input_event_unlock_irq(queue_flags);
    return appended;
}

@system
pub fn input_event_peek() -> InputEvent {
    let flags = input_event_lock_irq();
    if flags == 0 { return input_event_invalid(); }
    let mut event = input_event_invalid();
    unsafe {
        if INPUT_EVENT_READY && INPUT_EVENT_COUNT != 0 {
            event = INPUT_EVENT_QUEUE[INPUT_EVENT_HEAD];
        }
    }
    input_event_unlock_irq(flags);
    return event;
}

@system
pub fn input_event_pop() -> InputEvent {
    let flags = input_event_lock_irq();
    if flags == 0 { return input_event_invalid(); }
    let mut event = input_event_invalid();
    unsafe {
        if INPUT_EVENT_READY && INPUT_EVENT_COUNT != 0 {
            event = INPUT_EVENT_QUEUE[INPUT_EVENT_HEAD];
            INPUT_EVENT_QUEUE[INPUT_EVENT_HEAD] = input_event_invalid();
            INPUT_EVENT_HEAD += 1;
            if INPUT_EVENT_HEAD >= INPUT_EVENT_QUEUE_CAPACITY { INPUT_EVENT_HEAD = 0; }
            INPUT_EVENT_COUNT -= 1;
        }
    }
    input_event_unlock_irq(flags);
    return event;
}

@system
pub fn input_event_purge_device(device_id: u32, device_generation: u32) -> bool {
    if device_id == INPUT_DEVICE_ID_NONE ||
       device_generation == INPUT_DEVICE_GENERATION_INVALID {
        return false;
    }
    let flags = input_event_lock_irq();
    if flags == 0 { return false; }
    unsafe {
        if !INPUT_EVENT_READY {
            input_event_unlock_irq(flags);
            return false;
        }
        let original = INPUT_EVENT_COUNT;
        let mut processed: usize = 0;
        while processed < original {
            let event = INPUT_EVENT_QUEUE[INPUT_EVENT_HEAD];
            INPUT_EVENT_QUEUE[INPUT_EVENT_HEAD] = input_event_invalid();
            INPUT_EVENT_HEAD += 1;
            if INPUT_EVENT_HEAD >= INPUT_EVENT_QUEUE_CAPACITY { INPUT_EVENT_HEAD = 0; }
            INPUT_EVENT_COUNT -= 1;

            if !(event.valid && event.device_id == device_id &&
                 event.device_generation == device_generation) {
                INPUT_EVENT_QUEUE[INPUT_EVENT_TAIL] = event;
                INPUT_EVENT_TAIL += 1;
                if INPUT_EVENT_TAIL >= INPUT_EVENT_QUEUE_CAPACITY { INPUT_EVENT_TAIL = 0; }
                INPUT_EVENT_COUNT += 1;
            }
            processed += 1;
        }
    }
    input_event_unlock_irq(flags);
    return true;
}

@system
pub fn input_event_queue_self_test() -> bool {
    if !input_event_initialize() { return false; }
    let flags = input_event_lock_irq();
    if flags == 0 { return false; }
    let first_ok = input_event_append_locked(
        1, 1, INPUT_DEVICE_CLASS_KEYBOARD, INPUT_EVENT_KIND_KEY_DOWN,
        0, 0x07, 0x04, 1, INPUT_EVENT_FLAG_NONE);
    let second_ok = input_event_append_locked(
        2, 7, INPUT_DEVICE_CLASS_POINTER, INPUT_EVENT_KIND_RELATIVE,
        5, 0x01, 0x30, -2, INPUT_EVENT_FLAG_RELATIVE);
    input_event_unlock_irq(flags);
    if !first_ok || !second_ok || input_event_queue_count() != 2 ||
       input_event_queue_dropped() != 0 {
        return false;
    }

    let first = input_event_pop();
    let second = input_event_pop();
    if !first.valid || first.sequence != 1 || first.device_id != 1 ||
       first.device_generation != 1 ||
       first.device_class != INPUT_DEVICE_CLASS_KEYBOARD ||
       first.kind != INPUT_EVENT_KIND_KEY_DOWN || first.usage_page != 0x07 ||
       first.usage != 0x04 || first.value != 1 {
        return false;
    }
    if !second.valid || second.sequence != 2 || second.device_id != 2 ||
       second.device_generation != 7 ||
       second.device_class != INPUT_DEVICE_CLASS_POINTER ||
       second.kind != INPUT_EVENT_KIND_RELATIVE || second.report_id != 5 ||
       second.usage != 0x30 || second.value != -2 ||
       (second.flags & INPUT_EVENT_FLAG_RELATIVE) == 0 {
        return false;
    }
    if input_event_queue_count() != 0 || input_event_pop().valid { return false; }
    return input_event_initialize();
}
