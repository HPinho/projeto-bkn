// Baken OS — discovery PCI, probe MMIO, reset, DMA, IDENTIFY e I/O AHCI real.
//
// A enumeração começa read-only. Pós-cutover, AHCI/NVMe habilitam Memory Space
// para o probe estrutural. Para AHCI, o HBA é resetado com IE=0, a arena DMA é
// programada, IDENTIFY é executado, LBA 0 é lido e LBA 1 é escrito/lido de volta
// somente no disco descartável usado pelo gate de runtime.

module kernel::drivers::storage_discovery;

import kernel::arch::x86_64::cpu::*;
import kernel::arch::x86_64::serial::*;
import kernel::memory::active_page_tables::*;
import kernel::drivers::pci_bus::*;
import kernel::drivers::ahci_runtime::*;
import kernel::drivers::ahci_block_read::*;

pub const PCI_CLASS_MASS_STORAGE: u8 = 0x01;
pub const PCI_SUBCLASS_SATA: u8 = 0x06;
pub const PCI_PROGIF_AHCI: u8 = 0x01;
pub const PCI_SUBCLASS_NVM: u8 = 0x08;
pub const PCI_PROGIF_NVME: u8 = 0x02;

pub const STORAGE_CONTROLLER_NONE: u32 = 0;
pub const STORAGE_CONTROLLER_AHCI: u32 = 1;
pub const STORAGE_CONTROLLER_NVME: u32 = 2;

pub const AHCI_REG_CAP: u64 = 0x00;
pub const AHCI_REG_GHC: u64 = 0x04;
pub const AHCI_REG_PI: u64 = 0x0C;
pub const AHCI_REG_VS: u64 = 0x10;
pub const AHCI_GHC_HR: u32 = 1;
pub const AHCI_GHC_IE: u32 = 1 << 1;
pub const AHCI_GHC_AE: u32 = 1 << 31;
pub const AHCI_RESET_SPIN_LIMIT: u64 = 10000000;
pub const NVME_REG_CAP_LO: u64 = 0x00;
pub const NVME_REG_CAP_HI: u64 = 0x04;
pub const NVME_REG_VS: u64 = 0x08;
pub const NVME_REG_CSTS: u64 = 0x1C;

pub struct StorageControllerCandidate {
    pub kind: u32;
    pub pci_index: u32;
    pub bus: u8;
    pub slot: u8;
    pub func: u8;
    pub vendor_id: u16;
    pub device_id: u16;
    pub abar_or_mmio_base: u64;
    pub command_before_driver: u16;
}

static mut STORAGE_CANDIDATE: StorageControllerCandidate = StorageControllerCandidate {
    kind: STORAGE_CONTROLLER_NONE,
    pci_index: 0,
    bus: 0,
    slot: 0,
    func: 0,
    vendor_id: 0,
    device_id: 0,
    abar_or_mmio_base: 0,
    command_before_driver: 0,
};

static mut STORAGE_MMIO_READY: bool = false;
static mut STORAGE_AHCI_RESET_READY: bool = false;
static mut STORAGE_AHCI_DMA_READY: bool = false;
static mut STORAGE_AHCI_IDENTIFY_READY: bool = false;
static mut STORAGE_AHCI_READ_READY: bool = false;
static mut STORAGE_MMIO_REG0: u32 = 0;
static mut STORAGE_MMIO_REG1: u32 = 0;
static mut STORAGE_MMIO_REG2: u32 = 0;
static mut STORAGE_MMIO_REG3: u32 = 0;

@system
fn storage_candidate_kind(dev: *const PciDevice) -> u32 {
    unsafe {
        if dev == (null as *const PciDevice) { return STORAGE_CONTROLLER_NONE; }
        if (*dev).class_code != PCI_CLASS_MASS_STORAGE { return STORAGE_CONTROLLER_NONE; }
        if (*dev).subclass == PCI_SUBCLASS_NVM && (*dev).prog_if == PCI_PROGIF_NVME {
            return STORAGE_CONTROLLER_NVME;
        }
        if (*dev).subclass == PCI_SUBCLASS_SATA && (*dev).prog_if == PCI_PROGIF_AHCI {
            return STORAGE_CONTROLLER_AHCI;
        }
        return STORAGE_CONTROLLER_NONE;
    }
}

@system
fn storage_mmio_page_base(address: u64) -> u64 {
    return address & 0xFFFFFFFFFFFFF000;
}

@system
fn storage_probe_mmio_after_cutover() -> bool {
    unsafe {
        STORAGE_MMIO_READY = false;
        STORAGE_AHCI_RESET_READY = false;
        STORAGE_AHCI_DMA_READY = false;
        STORAGE_AHCI_IDENTIFY_READY = false;
        STORAGE_AHCI_READ_READY = false;
        STORAGE_MMIO_REG0 = 0;
        STORAGE_MMIO_REG1 = 0;
        STORAGE_MMIO_REG2 = 0;
        STORAGE_MMIO_REG3 = 0;

        if !active_page_tables_is_ready() { return true; }
        if STORAGE_CANDIDATE.kind == STORAGE_CONTROLLER_NONE ||
           STORAGE_CANDIDATE.abar_or_mmio_base == 0 { return false; }

        let command_before = pci_read_config16(STORAGE_CANDIDATE.bus,
            STORAGE_CANDIDATE.slot, STORAGE_CANDIDATE.func, 0x04);
        pci_enable_command_bits(STORAGE_CANDIDATE.bus, STORAGE_CANDIDATE.slot,
            STORAGE_CANDIDATE.func, PCI_COMMAND_MEMORY_SPACE);
        let command_after = pci_read_config16(STORAGE_CANDIDATE.bus,
            STORAGE_CANDIDATE.slot, STORAGE_CANDIDATE.func, 0x04);
        if (command_after & PCI_COMMAND_MEMORY_SPACE) == 0 { return false; }
        if (command_after & PCI_COMMAND_BUS_MASTER) != (command_before & PCI_COMMAND_BUS_MASTER) {
            return false;
        }

        let base = STORAGE_CANDIDATE.abar_or_mmio_base;
        if !active_page_tables_map_mmio_identity_4k(storage_mmio_page_base(base)) { return false; }

        if STORAGE_CANDIDATE.kind == STORAGE_CONTROLLER_AHCI {
            let cap = x86_mmio_read32(base + AHCI_REG_CAP);
            let ghc = x86_mmio_read32(base + AHCI_REG_GHC);
            let pi = x86_mmio_read32(base + AHCI_REG_PI);
            let version = x86_mmio_read32(base + AHCI_REG_VS);
            if cap == 0xFFFFFFFF || version == 0 || version == 0xFFFFFFFF { return false; }
            if pi == 0 || pi == 0xFFFFFFFF { return false; }
            STORAGE_MMIO_REG0 = cap;
            STORAGE_MMIO_REG1 = ghc;
            STORAGE_MMIO_REG2 = pi;
            STORAGE_MMIO_REG3 = version;
        } else if STORAGE_CANDIDATE.kind == STORAGE_CONTROLLER_NVME {
            let cap_lo = x86_mmio_read32(base + NVME_REG_CAP_LO);
            let cap_hi = x86_mmio_read32(base + NVME_REG_CAP_HI);
            let version = x86_mmio_read32(base + NVME_REG_VS);
            let csts = x86_mmio_read32(base + NVME_REG_CSTS);
            if (cap_lo == 0 && cap_hi == 0) ||
               (cap_lo == 0xFFFFFFFF && cap_hi == 0xFFFFFFFF) { return false; }
            if version == 0 || version == 0xFFFFFFFF { return false; }
            STORAGE_MMIO_REG0 = cap_lo;
            STORAGE_MMIO_REG1 = cap_hi;
            STORAGE_MMIO_REG2 = version;
            STORAGE_MMIO_REG3 = csts;
        } else {
            return false;
        }

        STORAGE_MMIO_READY = true;
        x86_serial_write_stage_marker('a' as u8);
        return true;
    }
}

@system
fn storage_reset_ahci_after_probe() -> bool {
    unsafe {
        STORAGE_AHCI_RESET_READY = false;
        STORAGE_AHCI_DMA_READY = false;
        STORAGE_AHCI_IDENTIFY_READY = false;
        STORAGE_AHCI_READ_READY = false;
        if !STORAGE_MMIO_READY || STORAGE_CANDIDATE.kind != STORAGE_CONTROLLER_AHCI { return false; }
        let base = STORAGE_CANDIDATE.abar_or_mmio_base;
        if base == 0 { return false; }

        let ghc_before = x86_mmio_read32(base + AHCI_REG_GHC);
        if ghc_before == 0xFFFFFFFF { return false; }
        x86_mmio_write32(base + AHCI_REG_GHC, (ghc_before & !AHCI_GHC_IE) | AHCI_GHC_HR);

        let mut spins: u64 = 0;
        while spins < AHCI_RESET_SPIN_LIMIT {
            let ghc = x86_mmio_read32(base + AHCI_REG_GHC);
            if ghc == 0xFFFFFFFF { return false; }
            if (ghc & AHCI_GHC_HR) == 0 {
                let enabled = (ghc & !AHCI_GHC_IE) | AHCI_GHC_AE;
                x86_mmio_write32(base + AHCI_REG_GHC, enabled);
                let verify = x86_mmio_read32(base + AHCI_REG_GHC);
                if (verify & AHCI_GHC_HR) != 0 || (verify & AHCI_GHC_AE) == 0 ||
                   (verify & AHCI_GHC_IE) != 0 { return false; }
                STORAGE_AHCI_RESET_READY = true;
                x86_serial_write_stage_marker('b' as u8);
                return true;
            }
            spins += 1;
        }
        return false;
    }
}

@system
fn storage_prepare_ahci_dma_after_reset() -> bool {
    unsafe {
        STORAGE_AHCI_DMA_READY = false;
        STORAGE_AHCI_IDENTIFY_READY = false;
        STORAGE_AHCI_READ_READY = false;
        if !STORAGE_AHCI_RESET_READY || STORAGE_CANDIDATE.kind != STORAGE_CONTROLLER_AHCI {
            return false;
        }
        if !ahci_runtime_prepare_dma(STORAGE_CANDIDATE.abar_or_mmio_base,
            STORAGE_CANDIDATE.bus, STORAGE_CANDIDATE.slot, STORAGE_CANDIDATE.func,
            STORAGE_MMIO_REG2) { return false; }
        if !ahci_runtime_is_ready() { return false; }
        STORAGE_AHCI_DMA_READY = true;
        return true;
    }
}

@system
fn storage_identify_ahci_after_dma() -> bool {
    unsafe {
        STORAGE_AHCI_IDENTIFY_READY = false;
        STORAGE_AHCI_READ_READY = false;
        if !STORAGE_AHCI_DMA_READY || STORAGE_CANDIDATE.kind != STORAGE_CONTROLLER_AHCI {
            return false;
        }
        if !ahci_runtime_identify_device() || !ahci_identify_is_ready() { return false; }
        STORAGE_AHCI_IDENTIFY_READY = true;
        return true;
    }
}

@system
fn storage_read_ahci_after_identify() -> bool {
    unsafe {
        STORAGE_AHCI_READ_READY = false;
        if !STORAGE_AHCI_IDENTIFY_READY || STORAGE_CANDIDATE.kind != STORAGE_CONTROLLER_AHCI {
            return false;
        }
        if !ahci_parse_identify_capacity() || !ahci_capacity_is_ready() { return false; }
        if !ahci_read_probe_sector0(STORAGE_CANDIDATE.abar_or_mmio_base) ||
           !ahci_read_is_ready() { return false; }
        STORAGE_AHCI_READ_READY = true;
        return true;
    }
}

@system
pub fn storage_discovery_scan() -> u32 {
    unsafe {
        STORAGE_CANDIDATE.kind = STORAGE_CONTROLLER_NONE;
        STORAGE_CANDIDATE.abar_or_mmio_base = 0;
        STORAGE_MMIO_READY = false;
        STORAGE_AHCI_RESET_READY = false;
        STORAGE_AHCI_DMA_READY = false;
        STORAGE_AHCI_IDENTIFY_READY = false;
        STORAGE_AHCI_READ_READY = false;

        let count = pci_get_device_count();
        for mut index in 0..count {
            let dev = pci_get_device(index);
            let kind = storage_candidate_kind(dev);
            if kind == STORAGE_CONTROLLER_NONE { continue; }

            STORAGE_CANDIDATE.kind = kind;
            STORAGE_CANDIDATE.pci_index = index;
            STORAGE_CANDIDATE.bus = (*dev).bus;
            STORAGE_CANDIDATE.slot = (*dev).slot;
            STORAGE_CANDIDATE.func = (*dev).func;
            STORAGE_CANDIDATE.vendor_id = (*dev).vendor_id;
            STORAGE_CANDIDATE.device_id = (*dev).device_id;
            STORAGE_CANDIDATE.command_before_driver = (*dev).command;

            if kind == STORAGE_CONTROLLER_AHCI {
                STORAGE_CANDIDATE.abar_or_mmio_base = (*dev).bars[5].base_address;
            } else {
                STORAGE_CANDIDATE.abar_or_mmio_base = (*dev).bars[0].base_address;
            }
            if !storage_probe_mmio_after_cutover() { return STORAGE_CONTROLLER_NONE; }
            // Pre-cutover discovery remains strictly read-only. The real MMIO/reset/DMA
            // driver path is entered only after the active page tables are installed.
            if !active_page_tables_is_ready() { return kind; }
            if kind == STORAGE_CONTROLLER_AHCI {
                if !storage_reset_ahci_after_probe() { return STORAGE_CONTROLLER_NONE; }
                if !storage_prepare_ahci_dma_after_reset() { return STORAGE_CONTROLLER_NONE; }
                if !storage_identify_ahci_after_dma() { return STORAGE_CONTROLLER_NONE; }
                if !storage_read_ahci_after_identify() { return STORAGE_CONTROLLER_NONE; }
                if !ahci_write_probe_sector1(STORAGE_CANDIDATE.abar_or_mmio_base) ||
                   !ahci_write_is_ready() { return STORAGE_CONTROLLER_NONE; }
            }
            return kind;
        }
        return STORAGE_CONTROLLER_NONE;
    }
}

@system
pub fn storage_discovery_kind() -> u32 { unsafe { return STORAGE_CANDIDATE.kind; } }

@system
pub fn storage_discovery_candidate() -> *const StorageControllerCandidate {
    unsafe {
        if STORAGE_CANDIDATE.kind == STORAGE_CONTROLLER_NONE {
            return null as *const StorageControllerCandidate;
        }
        return &STORAGE_CANDIDATE;
    }
}

@system
pub fn storage_mmio_is_ready() -> bool { unsafe { return STORAGE_MMIO_READY; } }
@system
pub fn storage_ahci_reset_is_ready() -> bool { unsafe { return STORAGE_AHCI_RESET_READY; } }
@system
pub fn storage_ahci_dma_is_ready() -> bool { unsafe { return STORAGE_AHCI_DMA_READY; } }
@system
pub fn storage_ahci_identify_is_ready() -> bool { unsafe { return STORAGE_AHCI_IDENTIFY_READY; } }
@system
pub fn storage_ahci_read_is_ready() -> bool { unsafe { return STORAGE_AHCI_READ_READY; } }
@system
pub fn storage_ahci_total_sectors() -> u64 { return ahci_total_sectors(); }
@system
pub fn storage_mmio_reg0() -> u32 { unsafe { return STORAGE_MMIO_REG0; } }
@system
pub fn storage_mmio_reg1() -> u32 { unsafe { return STORAGE_MMIO_REG1; } }
@system
pub fn storage_mmio_reg2() -> u32 { unsafe { return STORAGE_MMIO_REG2; } }
@system
pub fn storage_mmio_reg3() -> u32 { unsafe { return STORAGE_MMIO_REG3; } }
