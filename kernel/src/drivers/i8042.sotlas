// Baken OS - controlador i8042 compartilhado para teclado e porta auxiliar.
//
// Somente este módulo é dono das portas 0x60/0x64. Polling e IRQ compartilham
// as mesmas filas, mas a ISR nunca inicializa/reconfigura o controlador.

module kernel::drivers::i8042;

pub const I8042_DATA_PORT: u16 = 0x60;
pub const I8042_STATUS_PORT: u16 = 0x64;
pub const I8042_COMMAND_PORT: u16 = 0x64;

pub const I8042_STATUS_OUTPUT_FULL: u8 = 0x01;
pub const I8042_STATUS_INPUT_FULL: u8 = 0x02;
pub const I8042_STATUS_AUX_DATA: u8 = 0x20;

pub const I8042_QUEUE_CAPACITY: u32 = 64;

static mut I8042_INITIALIZED: bool = false;
static mut I8042_FIRST_PORT_OK: bool = false;
static mut I8042_SECOND_PORT_OK: bool = false;
static mut I8042_NATIVE_IRQS_ENABLED: bool = false;
static mut I8042_KEYBOARD_IRQ_ENABLED: bool = false;
static mut I8042_AUX_IRQ_ENABLED: bool = false;

static mut KBD_QUEUE: [u8; 64] = [0; 64];
static mut KBD_HEAD: u32 = 0;
static mut KBD_TAIL: u32 = 0;
static mut AUX_QUEUE: [u8; 64] = [0; 64];
static mut AUX_HEAD: u32 = 0;
static mut AUX_TAIL: u32 = 0;

@system
fn i8042_wait_write() -> bool {
    for mut i in 0..100000 {
        if (__inb(I8042_STATUS_PORT) & I8042_STATUS_INPUT_FULL) == 0 { return true; }
        baken_io_wait();
    }
    return false;
}

@system
fn i8042_wait_output() -> bool {
    for mut i in 0..100000 {
        if (__inb(I8042_STATUS_PORT) & I8042_STATUS_OUTPUT_FULL) != 0 { return true; }
        baken_io_wait();
    }
    return false;
}

@system
fn i8042_command(command: u8) -> bool {
    if !i8042_wait_write() { return false; }
    __outb(I8042_COMMAND_PORT, command);
    baken_io_wait();
    return true;
}

@system
fn i8042_write_data(data: u8) -> bool {
    if !i8042_wait_write() { return false; }
    __outb(I8042_DATA_PORT, data);
    baken_io_wait();
    return true;
}

@system
fn i8042_queue_kbd(data: u8) -> void {
    unsafe {
        let next = (KBD_HEAD + 1) % I8042_QUEUE_CAPACITY;
        if next == KBD_TAIL {
            KBD_TAIL = (KBD_TAIL + 1) % I8042_QUEUE_CAPACITY;
        }
        KBD_QUEUE[KBD_HEAD as usize] = data;
        KBD_HEAD = next;
    }
}

@system
fn i8042_queue_aux(data: u8) -> void {
    unsafe {
        let next = (AUX_HEAD + 1) % I8042_QUEUE_CAPACITY;
        if next == AUX_TAIL {
            AUX_TAIL = (AUX_TAIL + 1) % I8042_QUEUE_CAPACITY;
        }
        AUX_QUEUE[AUX_HEAD as usize] = data;
        AUX_HEAD = next;
    }
}

@system
fn i8042_flush_hardware_output() -> void {
    for mut i in 0..256 {
        let status = __inb(I8042_STATUS_PORT);
        if (status & I8042_STATUS_OUTPUT_FULL) == 0 { return; }
        __inb(I8042_DATA_PORT);
        baken_io_wait();
    }
}

@system
fn i8042_drain_ready_output() -> void {
    for mut i in 0..64 {
        let status = __inb(I8042_STATUS_PORT);
        if (status & I8042_STATUS_OUTPUT_FULL) == 0 { return; }
        let data = __inb(I8042_DATA_PORT);
        if (status & I8042_STATUS_AUX_DATA) != 0 {
            i8042_queue_aux(data);
        } else {
            i8042_queue_kbd(data);
        }
    }
}

@system
pub fn i8042_initialize_polling() -> bool {
    unsafe {
        if I8042_INITIALIZED { return true; }
        KBD_HEAD = 0;
        KBD_TAIL = 0;
        AUX_HEAD = 0;
        AUX_TAIL = 0;
        I8042_NATIVE_IRQS_ENABLED = false;
        I8042_KEYBOARD_IRQ_ENABLED = false;
        I8042_AUX_IRQ_ENABLED = false;

        if !i8042_command(0xAD) { return false; }
        if !i8042_command(0xA7) { return false; }
        i8042_flush_hardware_output();

        if !i8042_command(0x20) { return false; }
        if !i8042_wait_output() { return false; }
        let mut config = __inb(I8042_DATA_PORT);

        config = config & 0xCC;
        if !i8042_command(0x60) { return false; }
        if !i8042_write_data(config) { return false; }

        I8042_FIRST_PORT_OK = false;
        if i8042_command(0xAB) && i8042_wait_output() {
            I8042_FIRST_PORT_OK = __inb(I8042_DATA_PORT) == 0;
        }
        I8042_SECOND_PORT_OK = false;
        if i8042_command(0xA9) && i8042_wait_output() {
            I8042_SECOND_PORT_OK = __inb(I8042_DATA_PORT) == 0;
        }

        if I8042_FIRST_PORT_OK { i8042_command(0xAE); }
        if I8042_SECOND_PORT_OK { i8042_command(0xA8); }
        i8042_flush_hardware_output();

        I8042_INITIALIZED = true;
        return true;
    }
}

@system
pub fn i8042_drain_output() -> void {
    if !i8042_initialize_polling() { return; }
    if i8042_native_irqs_enabled() { return; }
    i8042_drain_ready_output();
}

@system
pub fn i8042_drain_irq_output() -> void {
    unsafe {
        if !I8042_INITIALIZED || !I8042_NATIVE_IRQS_ENABLED { return; }
    }
    i8042_drain_ready_output();
}

@system
pub fn i8042_pop_keyboard(out_byte: *mut u8) -> bool {
    if out_byte == (null as *mut u8) { return false; }
    if !i8042_native_irqs_enabled() { i8042_drain_output(); }
    unsafe {
        if KBD_HEAD == KBD_TAIL { return false; }
        *out_byte = KBD_QUEUE[KBD_TAIL as usize];
        KBD_TAIL = (KBD_TAIL + 1) % I8042_QUEUE_CAPACITY;
        return true;
    }
}

@system
pub fn i8042_pop_aux(out_byte: *mut u8) -> bool {
    if out_byte == (null as *mut u8) { return false; }
    if !i8042_native_irqs_enabled() { i8042_drain_output(); }
    unsafe {
        if AUX_HEAD == AUX_TAIL { return false; }
        *out_byte = AUX_QUEUE[AUX_TAIL as usize];
        AUX_TAIL = (AUX_TAIL + 1) % I8042_QUEUE_CAPACITY;
        return true;
    }
}

@system
pub fn i8042_aux_command(data: u8) -> bool {
    if i8042_native_irqs_enabled() { return false; }
    if !i8042_initialize_polling() { return false; }
    if !i8042_command(0xD4) { return false; }
    if !i8042_write_data(data) { return false; }

    for mut i in 0..100000 {
        let status = __inb(I8042_STATUS_PORT);
        if (status & I8042_STATUS_OUTPUT_FULL) == 0 {
            baken_io_wait();
            continue;
        }
        let value = __inb(I8042_DATA_PORT);
        if (status & I8042_STATUS_AUX_DATA) != 0 {
            if value == 0xFA { return true; }
            if value == 0xFE { return false; }
            i8042_queue_aux(value);
        } else {
            i8042_queue_kbd(value);
        }
    }
    return false;
}

@system
pub fn i8042_first_port_present() -> bool {
    unsafe { return I8042_INITIALIZED && I8042_FIRST_PORT_OK; }
}

@system
pub fn i8042_second_port_present() -> bool {
    unsafe { return I8042_INITIALIZED && I8042_SECOND_PORT_OK; }
}

@system
pub fn i8042_native_irqs_enabled() -> bool {
    unsafe { return I8042_INITIALIZED && I8042_NATIVE_IRQS_ENABLED; }
}

@system
pub fn i8042_keyboard_irq_enabled() -> bool {
    unsafe { return I8042_INITIALIZED && I8042_KEYBOARD_IRQ_ENABLED; }
}

@system
pub fn i8042_aux_irq_enabled() -> bool {
    unsafe { return I8042_INITIALIZED && I8042_AUX_IRQ_ENABLED; }
}

@system
fn i8042_set_native_irq_mask(keyboard: bool, aux: bool) -> bool {
    if !i8042_initialize_polling() { return false; }
    if keyboard && !i8042_first_port_present() { return false; }
    if aux && !i8042_second_port_present() { return false; }

    if !i8042_command(0x20) { return false; }
    if !i8042_wait_output() { return false; }
    let mut config = __inb(I8042_DATA_PORT);
    config = config & 0xFC;
    if keyboard { config = config | 0x01; }
    if aux { config = config | 0x02; }

    if !i8042_command(0x60) { return false; }
    if !i8042_write_data(config) { return false; }
    unsafe {
        I8042_KEYBOARD_IRQ_ENABLED = keyboard;
        I8042_AUX_IRQ_ENABLED = aux;
        I8042_NATIVE_IRQS_ENABLED = keyboard || aux;
    }
    return true;
}

// Bring-up seguro: apenas IRQ1 no config byte do i8042.
@system
pub fn i8042_enable_keyboard_irq_only() -> bool {
    return i8042_set_native_irq_mask(true, false);
}

// Controller diagnostic stimulus, not a synthetic call into the ISR. D2
// places a byte in the controller output buffer and asserts its IRQ line.
// The integration test must observe IDT delivery and EOI before succeeding.
@system
pub fn i8042_trigger_irq_probe() -> bool {
    if !i8042_keyboard_irq_enabled() { return false; }
    if !i8042_command(0xD2) { return false; }
    return i8042_write_data(0x00);
}

// Compatibilidade para a etapa futura que abrirá ambas as rotas no IOAPIC.
@system
pub fn i8042_enable_native_irqs() -> bool {
    let keyboard = i8042_first_port_present();
    let aux = i8042_second_port_present();
    if !keyboard && !aux { return false; }
    return i8042_set_native_irq_mask(keyboard, aux);
}

@system
pub fn i8042_disable_native_irqs() -> bool {
    return i8042_set_native_irq_mask(false, false);
}
