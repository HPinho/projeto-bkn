// Baken OS — decodificação pura de Event TRBs xHCI.
//
// Interpreta Transfer Event e Command Completion Event já presentes em memória.
// Não configura Event Ring/ERST, não avança dequeue pointer, não acessa MMIO,
// não habilita interrupções e não escreve doorbells.

module kernel::drivers::xhci_event;

import kernel::drivers::xhci_ring::*;

pub const XHCI_TRB_TYPE_TRANSFER_EVENT: u32 = 32;
pub const XHCI_TRB_TYPE_COMMAND_COMPLETION_EVENT: u32 = 33;
pub const XHCI_COMPLETION_CODE_SUCCESS: u8 = 1;

pub const XHCI_EVENT_TYPE_SHIFT: u32 = 10;
pub const XHCI_EVENT_ENDPOINT_ID_SHIFT: u32 = 16;
pub const XHCI_EVENT_SLOT_ID_SHIFT: u32 = 24;
pub const XHCI_EVENT_COMPLETION_CODE_SHIFT: u32 = 24;
pub const XHCI_EVENT_CYCLE_BIT: u32 = 1;
pub const XHCI_EVENT_ED_BIT: u32 = 1 << 2;
pub const XHCI_EVENT_TRANSFER_LENGTH_MASK: u32 = 0x00FFFFFF;
pub const XHCI_EVENT_COMMAND_PARAMETER_MASK: u32 = 0x00FFFFFF;

@system
pub fn xhci_event_type(trb: *const XhciTrb) -> u32 {
    if trb == (null as *const XhciTrb) { return 0; }
    unsafe { return ((*trb).control >> XHCI_EVENT_TYPE_SHIFT) & 0x3F; }
}

@system
pub fn xhci_event_cycle(trb: *const XhciTrb) -> bool {
    if trb == (null as *const XhciTrb) { return false; }
    unsafe { return ((*trb).control & XHCI_EVENT_CYCLE_BIT) != 0; }
}

@system
pub fn xhci_event_completion_code(trb: *const XhciTrb) -> u8 {
    if trb == (null as *const XhciTrb) { return 0; }
    unsafe { return (((*trb).status >> XHCI_EVENT_COMPLETION_CODE_SHIFT) & 0xFF) as u8; }
}

@system
pub fn xhci_event_success(trb: *const XhciTrb) -> bool {
    return xhci_event_completion_code(trb) == XHCI_COMPLETION_CODE_SUCCESS;
}

@system
pub fn xhci_event_slot_id(trb: *const XhciTrb) -> u8 {
    if trb == (null as *const XhciTrb) { return 0; }
    unsafe { return (((*trb).control >> XHCI_EVENT_SLOT_ID_SHIFT) & 0xFF) as u8; }
}

@system
pub fn xhci_transfer_event_endpoint_id(trb: *const XhciTrb) -> u8 {
    if xhci_event_type(trb) != XHCI_TRB_TYPE_TRANSFER_EVENT { return 0; }
    unsafe { return (((*trb).control >> XHCI_EVENT_ENDPOINT_ID_SHIFT) & 0x1F) as u8; }
}

@system
pub fn xhci_transfer_event_has_event_data(trb: *const XhciTrb) -> bool {
    if xhci_event_type(trb) != XHCI_TRB_TYPE_TRANSFER_EVENT { return false; }
    unsafe { return ((*trb).control & XHCI_EVENT_ED_BIT) != 0; }
}

@system
pub fn xhci_transfer_event_residual_length(trb: *const XhciTrb) -> u32 {
    if xhci_event_type(trb) != XHCI_TRB_TYPE_TRANSFER_EVENT { return 0; }
    unsafe { return (*trb).status & XHCI_EVENT_TRANSFER_LENGTH_MASK; }
}

@system
pub fn xhci_transfer_event_trb_pointer(trb: *const XhciTrb) -> u64 {
    if xhci_event_type(trb) != XHCI_TRB_TYPE_TRANSFER_EVENT { return 0; }
    if xhci_transfer_event_has_event_data(trb) { return 0; }
    unsafe { return (*trb).parameter & 0xFFFFFFFFFFFFFFF0; }
}

@system
pub fn xhci_transfer_event_data(trb: *const XhciTrb) -> u64 {
    if xhci_event_type(trb) != XHCI_TRB_TYPE_TRANSFER_EVENT { return 0; }
    if !xhci_transfer_event_has_event_data(trb) { return 0; }
    unsafe { return (*trb).parameter; }
}

@system
pub fn xhci_command_completion_trb_pointer(trb: *const XhciTrb) -> u64 {
    if xhci_event_type(trb) != XHCI_TRB_TYPE_COMMAND_COMPLETION_EVENT { return 0; }
    unsafe { return (*trb).parameter & 0xFFFFFFFFFFFFFFF0; }
}

@system
pub fn xhci_command_completion_parameter(trb: *const XhciTrb) -> u32 {
    if xhci_event_type(trb) != XHCI_TRB_TYPE_COMMAND_COMPLETION_EVENT { return 0; }
    unsafe { return (*trb).status & XHCI_EVENT_COMMAND_PARAMETER_MASK; }
}
