// Baken OS — HID-4c.4e/HID-4d.2b: polling HID Interrupt IN por Slot ID.
//
// Ring producer, cycle state, DMA report buffer, identidade lógica, mapa HID,
// SET_CONFIGURATION e fallback Boot ficam coerentes por slot+epoch. Cada slot
// admite um TD HID outstanding; submit e complete separados permitem armar dois
// devices antes de consumir o Event Ring sem alterar os wrappers legados.
// HID-4d bloqueia novos prepare/submit após DETACH_PENDING; o drain de cancel
// limpa apenas o TD parado e nunca publica um report de input cancelado.

module kernel::drivers::xhci_hid_report;

import kernel::arch::x86_64::cpu::*;
import kernel::arch::x86_64::serial::*;
import kernel::memory::dma::*;
import kernel::memory::direct_map::*;
import kernel::memory::active_page_tables::*;
import kernel::drivers::input_device::*;
import kernel::drivers::hid_input_device_map::*;
import kernel::drivers::hid_input_events::*;
import kernel::drivers::input_event::*;
import kernel::drivers::xhci_controller::*;
import kernel::drivers::xhci_device_table::*;
import kernel::drivers::xhci_configuration::*;
import kernel::drivers::xhci_hid_context::*;
import kernel::drivers::xhci_hid_descriptor::*;
import kernel::drivers::xhci_configure_endpoint::*;
import kernel::drivers::xhci_set_configuration::*;
import kernel::drivers::xhci_ring::*;
import kernel::drivers::xhci_trb::*;
import kernel::drivers::xhci_transfer::*;

pub const XHCI_HID_REPORT_DMA_SIZE: u64 = 4096;
pub const XHCI_HID_REPORT_FIRST_INDEX: u32 = 0;
pub const XHCI_HID_BOOT_KEYBOARD_LENGTH: u32 = 8;
pub const XHCI_HID_BOOT_MOUSE_MIN_LENGTH: u32 = 3;
pub const XHCI_HID_REPORT_SLOT_CAPACITY: usize = XHCI_DEVICE_SLOT_CAPACITY;

pub struct XhciHidReportState {
    pub ready: bool;
    pub epoch: u32;
    pub enqueue_index: u32;
    pub producer_cycle: bool;
    pub transfer_pending: bool;
    pub pending_trb_physical: u64;
    pub pending_transfer_length: u32;
    pub event_marker_emitted: bool;
    pub buffer: DmaBuffer;
    pub last_length: u32;
    pub keyboard_modifiers: u8;
    pub keyboard_key0: u8;
    pub keyboard_key1: u8;
    pub keyboard_key2: u8;
    pub keyboard_key3: u8;
    pub keyboard_key4: u8;
    pub keyboard_key5: u8;
    pub mouse_buttons: u8;
    pub mouse_x_raw: u8;
    pub mouse_y_raw: u8;
}

static mut XHCI_HID_REPORT_STATES: [XhciHidReportState; XHCI_HID_REPORT_SLOT_CAPACITY] = [
    XhciHidReportState {
        ready: false,
        epoch: 0,
        enqueue_index: XHCI_HID_REPORT_FIRST_INDEX,
        producer_cycle: true,
        transfer_pending: false,
        pending_trb_physical: 0,
        pending_transfer_length: 0,
        event_marker_emitted: false,
        buffer: DmaBuffer {
            virtual_address: null as *mut u8,
            physical_address: 0,
            size: 0,
            alignment: 0,
            owner: DMA_OWNER_CPU,
            fence: 0,
            valid: false
        },
        last_length: 0,
        keyboard_modifiers: 0,
        keyboard_key0: 0,
        keyboard_key1: 0,
        keyboard_key2: 0,
        keyboard_key3: 0,
        keyboard_key4: 0,
        keyboard_key5: 0,
        mouse_buttons: 0,
        mouse_x_raw: 0,
        mouse_y_raw: 0
    };
    XHCI_HID_REPORT_SLOT_CAPACITY
];
static mut XHCI_HID_REPORT_ACTIVE_SLOT_ID: u8 = 0;

@system
fn xhci_hid_report_index(slot_id: u8) -> usize {
    if slot_id == 0 { return XHCI_HID_REPORT_SLOT_CAPACITY; }
    return slot_id as usize;
}

@system
fn xhci_hid_report_page_base(address: u64) -> u64 {
    return address & 0xFFFFFFFFFFFFF000;
}

@system
fn xhci_hid_report_map_mmio(address: u64) -> bool {
    if address == 0 { return false; }
    return active_page_tables_map_mmio_identity_4k(xhci_hid_report_page_base(address));
}

@system
fn xhci_hid_report_zero(base: *mut u8, size: u64) -> bool {
    if base == (null as *mut u8) || size == 0 { return false; }
    unsafe {
        let mut i: u64 = 0;
        while i < size {
            *(((base as usize) + (i as usize)) as *mut u8) = 0;
            i += 1;
        }
    }
    return true;
}

@system
fn xhci_hid_report_identity_matches_slot(slot_id: u8) -> bool {
    let device_id = xhci_hid_descriptor_input_device_id_for(slot_id);
    let generation = xhci_hid_descriptor_input_device_generation_for(slot_id);
    if device_id == INPUT_DEVICE_ID_NONE || generation == INPUT_DEVICE_GENERATION_INVALID ||
       !xhci_hid_descriptor_input_device_is_active_for(slot_id) {
        return false;
    }
    let record = input_device_snapshot(device_id, generation);
    return record.valid && record.transport_kind == INPUT_TRANSPORT_USB &&
           record.transport_address == slot_id as u32;
}

@system
fn xhci_hid_report_ring_slot(slot_id: u8, index: u32) -> *mut XhciTrb {
    let usable = XHCI_HID_RING_TRBS - XHCI_RING_RESERVED_LINK_TRBS;
    if index >= usable { return null as *mut XhciTrb; }
    let base = direct_map_virtual_address(xhci_hid_context_ring_physical_for(slot_id));
    if base == 0 { return null as *mut XhciTrb; }
    return unsafe { (base + ((index as u64) * XHCI_TRB_SIZE)) as *mut XhciTrb };
}

@system
fn xhci_hid_report_ring_physical(slot_id: u8, index: u32) -> u64 {
    let usable = XHCI_HID_RING_TRBS - XHCI_RING_RESERVED_LINK_TRBS;
    if index >= usable { return 0; }
    let base = xhci_hid_context_ring_physical_for(slot_id);
    if base == 0 { return 0; }
    return base + ((index as u64) * XHCI_TRB_SIZE);
}

@system
fn xhci_hid_report_publish_link(slot_id: u8, cycle: bool) -> bool {
    let base = direct_map_virtual_address(xhci_hid_context_ring_physical_for(slot_id));
    if base == 0 { return false; }
    let link_index = XHCI_HID_RING_TRBS - 1;
    unsafe {
        let slot = (base + ((link_index as u64) * XHCI_TRB_SIZE)) as *mut XhciTrb;
        *slot = xhci_trb_link(xhci_hid_context_ring_physical_for(slot_id), true, cycle);
    }
    return x86_read_cr3_raw() != 0;
}

@system
fn xhci_hid_report_advance(slot_id: u8) -> bool {
    let state_index = xhci_hid_report_index(slot_id);
    if state_index >= XHCI_HID_REPORT_SLOT_CAPACITY { return false; }
    unsafe {
        let usable = XHCI_HID_RING_TRBS - XHCI_RING_RESERVED_LINK_TRBS;
        if usable == 0 || XHCI_HID_REPORT_STATES[state_index].enqueue_index >= usable {
            return false;
        }
        XHCI_HID_REPORT_STATES[state_index].enqueue_index += 1;
        if XHCI_HID_REPORT_STATES[state_index].enqueue_index >= usable {
            XHCI_HID_REPORT_STATES[state_index].enqueue_index = 0;
            XHCI_HID_REPORT_STATES[state_index].producer_cycle =
                !XHCI_HID_REPORT_STATES[state_index].producer_cycle;
        }
    }
    return true;
}

@system
fn xhci_hid_report_ring_doorbell(slot_id: u8, dci: u8) -> bool {
    if slot_id == 0 || dci <= 1 { return false; }
    let mmio = xhci_controller_mmio_base();
    if mmio == 0 { return false; }
    let dboff = (x86_mmio_read32(mmio + XHCI_DBOFF) as u64) & 0xFFFFFFFC;
    let doorbell = mmio + dboff + ((slot_id as u64) * 4);
    if doorbell < mmio || !xhci_hid_report_map_mmio(doorbell) { return false; }
    x86_mmio_write32(doorbell, dci as u32);
    return true;
}

@system
fn xhci_hid_report_emit_event_ready_marker() -> bool {
    let marker: [u8; 26] = [
        66,65,75,69,78,58,85,83,66,95,72,73,68,95,69,86,
        69,78,84,95,82,69,65,68,89,10
    ];
    let mut index: usize = 0;
    while index < 26 {
        if !x86_serial_write_byte(marker[index]) { return false; }
        index += 1;
    }
    return true;
}

@system
fn xhci_hid_report_emit_event_failure_marker() -> bool {
    let marker: [u8; 27] = [
        66,65,75,69,78,58,85,83,66,95,72,73,68,95,69,86,
        69,78,84,95,70,65,73,76,69,68,10
    ];
    let mut index: usize = 0;
    while index < 27 {
        if !x86_serial_write_byte(marker[index]) { return false; }
        index += 1;
    }
    return true;
}

@system
fn xhci_hid_report_parse_for_slot(slot_id: u8, length: u32) -> bool {
    let state_index = xhci_hid_report_index(slot_id);
    if state_index >= XHCI_HID_REPORT_SLOT_CAPACITY ||
       !xhci_hid_report_identity_matches_slot(slot_id) {
        return false;
    }
    let base = unsafe { XHCI_HID_REPORT_STATES[state_index].buffer.virtual_address };
    let device_id = xhci_hid_descriptor_input_device_id_for(slot_id);
    let device_generation = xhci_hid_descriptor_input_device_generation_for(slot_id);
    if base == (null as *mut u8) || length == 0 ||
       !hid_input_device_map_is_ready(device_id, device_generation) ||
       !hid_input_events_is_ready() || !input_event_queue_is_ready() {
        return false;
    }

    if !hid_input_device_map_validate(
        device_id, device_generation, base as *const u8, length as usize) {
        return false;
    }
    let before_events = hid_input_events_events_published();
    if !hid_input_events_process_report_for_device(
        device_id, device_generation, base as *const u8, length as usize) {
        xhci_hid_report_emit_event_failure_marker();
        return false;
    }
    let after_events = hid_input_events_events_published();
    unsafe {
        if !XHCI_HID_REPORT_STATES[state_index].event_marker_emitted &&
           after_events > before_events {
            if !xhci_hid_report_emit_event_ready_marker() { return false; }
            XHCI_HID_REPORT_STATES[state_index].event_marker_emitted = true;
        }
    }

    if hid_input_device_map_has_report_ids(device_id, device_generation) { return true; }
    let protocol = xhci_hid_protocol_for(slot_id);
    unsafe {
        if protocol == USB_HID_PROTOCOL_KEYBOARD {
            if length < XHCI_HID_BOOT_KEYBOARD_LENGTH { return false; }
            XHCI_HID_REPORT_STATES[state_index].keyboard_modifiers = *base;
            XHCI_HID_REPORT_STATES[state_index].keyboard_key0 = *(((base as usize) + 2) as *const u8);
            XHCI_HID_REPORT_STATES[state_index].keyboard_key1 = *(((base as usize) + 3) as *const u8);
            XHCI_HID_REPORT_STATES[state_index].keyboard_key2 = *(((base as usize) + 4) as *const u8);
            XHCI_HID_REPORT_STATES[state_index].keyboard_key3 = *(((base as usize) + 5) as *const u8);
            XHCI_HID_REPORT_STATES[state_index].keyboard_key4 = *(((base as usize) + 6) as *const u8);
            XHCI_HID_REPORT_STATES[state_index].keyboard_key5 = *(((base as usize) + 7) as *const u8);
            return true;
        }
        if protocol == USB_HID_PROTOCOL_MOUSE {
            if length < XHCI_HID_BOOT_MOUSE_MIN_LENGTH { return false; }
            XHCI_HID_REPORT_STATES[state_index].mouse_buttons = *base;
            XHCI_HID_REPORT_STATES[state_index].mouse_x_raw =
                *(((base as usize) + 1) as *const u8);
            XHCI_HID_REPORT_STATES[state_index].mouse_y_raw =
                *(((base as usize) + 2) as *const u8);
            return true;
        }
    }
    return false;
}

@system
pub fn xhci_hid_report_is_ready_for(slot_id: u8) -> bool {
    let state_index = xhci_hid_report_index(slot_id);
    if state_index >= XHCI_HID_REPORT_SLOT_CAPACITY ||
       !xhci_device_table_slot_is_valid(slot_id) {
        return false;
    }
    let epoch = xhci_device_table_slot_epoch(slot_id);
    if epoch == 0 { return false; }
    unsafe {
        return XHCI_HID_REPORT_STATES[state_index].ready &&
               XHCI_HID_REPORT_STATES[state_index].epoch == epoch;
    }
}

@system
pub fn xhci_hid_report_prepare_for_slot(slot_id: u8) -> bool {
    if xhci_device_table_state(slot_id) != XHCI_DEVICE_STATE_HID_READY ||
       !xhci_hid_context_is_ready_for(slot_id) ||
       !xhci_configure_endpoint_is_ready_for(slot_id) ||
       !xhci_set_configuration_is_ready_for(slot_id) ||
       xhci_set_configuration_value_for(slot_id) != xhci_configuration_value_for(slot_id) ||
       !xhci_hid_descriptor_input_map_is_ready_for(slot_id) || !hid_input_events_is_ready() ||
       !input_event_queue_is_ready() || !xhci_hid_report_identity_matches_slot(slot_id) {
        return false;
    }
    let state_index = xhci_hid_report_index(slot_id);
    if state_index >= XHCI_HID_REPORT_SLOT_CAPACITY { return false; }
    let epoch = xhci_device_table_slot_epoch(slot_id);
    let dci = xhci_hid_context_dci_for(slot_id);
    let max_packet = xhci_hid_context_max_packet_for(slot_id) as u64;
    if epoch == 0 || dci <= 1 || max_packet == 0 || max_packet > XHCI_HID_REPORT_DMA_SIZE {
        return false;
    }

    unsafe {
        if XHCI_HID_REPORT_STATES[state_index].ready &&
           XHCI_HID_REPORT_STATES[state_index].epoch == epoch {
            XHCI_HID_REPORT_ACTIVE_SLOT_ID = slot_id;
            return true;
        }
    }

    let mut buffer = dma_alloc(XHCI_HID_REPORT_DMA_SIZE, XHCI_HID_REPORT_DMA_SIZE);
    if !dma_buffer_cpu_owned(&buffer) || !xhci_hid_report_zero(buffer.virtual_address, buffer.size) {
        return false;
    }
    if !dma_share_with_device(&mut buffer) { return false; }
    unsafe {
        XHCI_HID_REPORT_STATES[state_index].ready = true;
        XHCI_HID_REPORT_STATES[state_index].epoch = epoch;
        XHCI_HID_REPORT_STATES[state_index].enqueue_index = XHCI_HID_REPORT_FIRST_INDEX;
        XHCI_HID_REPORT_STATES[state_index].producer_cycle = true;
        XHCI_HID_REPORT_STATES[state_index].transfer_pending = false;
        XHCI_HID_REPORT_STATES[state_index].pending_trb_physical = 0;
        XHCI_HID_REPORT_STATES[state_index].pending_transfer_length = 0;
        XHCI_HID_REPORT_STATES[state_index].event_marker_emitted = false;
        XHCI_HID_REPORT_STATES[state_index].buffer = buffer;
        XHCI_HID_REPORT_STATES[state_index].last_length = 0;
        XHCI_HID_REPORT_STATES[state_index].keyboard_modifiers = 0;
        XHCI_HID_REPORT_STATES[state_index].keyboard_key0 = 0;
        XHCI_HID_REPORT_STATES[state_index].keyboard_key1 = 0;
        XHCI_HID_REPORT_STATES[state_index].keyboard_key2 = 0;
        XHCI_HID_REPORT_STATES[state_index].keyboard_key3 = 0;
        XHCI_HID_REPORT_STATES[state_index].keyboard_key4 = 0;
        XHCI_HID_REPORT_STATES[state_index].keyboard_key5 = 0;
        XHCI_HID_REPORT_STATES[state_index].mouse_buttons = 0;
        XHCI_HID_REPORT_STATES[state_index].mouse_x_raw = 0;
        XHCI_HID_REPORT_STATES[state_index].mouse_y_raw = 0;
        XHCI_HID_REPORT_ACTIVE_SLOT_ID = slot_id;
    }
    return true;
}

@system
pub fn xhci_hid_report_prepare() -> bool {
    let slot_id = xhci_configure_endpoint_slot_id();
    if slot_id == 0 { return false; }
    return xhci_hid_report_prepare_for_slot(slot_id);
}

@system
pub fn xhci_hid_report_transfer_pending_for(slot_id: u8) -> bool {
    if !xhci_hid_report_is_ready_for(slot_id) { return false; }
    let state_index = xhci_hid_report_index(slot_id);
    unsafe {
        return XHCI_HID_REPORT_STATES[state_index].transfer_pending &&
               XHCI_HID_REPORT_STATES[state_index].pending_trb_physical != 0 &&
               XHCI_HID_REPORT_STATES[state_index].pending_transfer_length != 0;
    }
}

@system
pub fn xhci_hid_report_submit_for_slot(slot_id: u8) -> bool {
    if xhci_device_table_state(slot_id) != XHCI_DEVICE_STATE_HID_READY ||
       !xhci_hid_report_is_ready_for(slot_id) ||
       !xhci_hid_report_identity_matches_slot(slot_id) ||
       !xhci_hid_descriptor_input_map_is_ready_for(slot_id) ||
       xhci_hid_report_transfer_pending_for(slot_id) {
        return false;
    }
    let state_index = xhci_hid_report_index(slot_id);
    if state_index >= XHCI_HID_REPORT_SLOT_CAPACITY { return false; }
    let dci = xhci_hid_context_dci_for(slot_id);
    let transfer_length = xhci_hid_context_max_packet_for(slot_id) as u32;
    if dci <= 1 || transfer_length == 0 { return false; }

    unsafe {
        let index = XHCI_HID_REPORT_STATES[state_index].enqueue_index;
        let cycle = XHCI_HID_REPORT_STATES[state_index].producer_cycle;
        let usable = XHCI_HID_RING_TRBS - XHCI_RING_RESERVED_LINK_TRBS;
        if index >= usable { return false; }
        if index == (usable - 1) && !xhci_hid_report_publish_link(slot_id, cycle) {
            return false;
        }
        let slot = xhci_hid_report_ring_slot(slot_id, index);
        let physical = xhci_hid_report_ring_physical(slot_id, index);
        if slot == (null as *mut XhciTrb) || physical == 0 { return false; }
        let buffer = XHCI_HID_REPORT_STATES[state_index].buffer;
        if !buffer.valid || buffer.virtual_address == (null as *mut u8) ||
           !xhci_hid_report_zero(buffer.virtual_address, transfer_length as u64) {
            return false;
        }
        *slot = xhci_trb_normal(
            buffer.physical_address,
            transfer_length,
            0,
            true,
            cycle
        );
        if x86_read_cr3_raw() == 0 { return false; }
        if !xhci_hid_report_ring_doorbell(slot_id, dci) { return false; }
        if !xhci_hid_report_advance(slot_id) { return false; }
        XHCI_HID_REPORT_STATES[state_index].transfer_pending = true;
        XHCI_HID_REPORT_STATES[state_index].pending_trb_physical = physical;
        XHCI_HID_REPORT_STATES[state_index].pending_transfer_length = transfer_length;
        XHCI_HID_REPORT_ACTIVE_SLOT_ID = slot_id;
    }
    return true;
}

@system
pub fn xhci_hid_report_complete_for_slot(slot_id: u8) -> bool {
    if !xhci_hid_report_is_ready_for(slot_id) ||
       !xhci_hid_report_identity_matches_slot(slot_id) ||
       !xhci_hid_descriptor_input_map_is_ready_for(slot_id) ||
       !xhci_hid_report_transfer_pending_for(slot_id) {
        return false;
    }
    let state_index = xhci_hid_report_index(slot_id);
    if state_index >= XHCI_HID_REPORT_SLOT_CAPACITY { return false; }
    let dci = xhci_hid_context_dci_for(slot_id);
    if dci <= 1 { return false; }

    unsafe {
        let physical = XHCI_HID_REPORT_STATES[state_index].pending_trb_physical;
        let transfer_length = XHCI_HID_REPORT_STATES[state_index].pending_transfer_length;
        if physical == 0 || transfer_length == 0 { return false; }
        if !xhci_transfer_wait_completion(slot_id, dci, physical) { return false; }
        let residual = xhci_transfer_last_residual_length_for(slot_id);
        XHCI_HID_REPORT_STATES[state_index].transfer_pending = false;
        XHCI_HID_REPORT_STATES[state_index].pending_trb_physical = 0;
        XHCI_HID_REPORT_STATES[state_index].pending_transfer_length = 0;
        if residual > transfer_length {
            XHCI_HID_REPORT_STATES[state_index].last_length = 0;
            return false;
        }
        let actual = transfer_length - residual;
        XHCI_HID_REPORT_STATES[state_index].last_length = actual;
        XHCI_HID_REPORT_ACTIVE_SLOT_ID = slot_id;
        return xhci_hid_report_parse_for_slot(slot_id, actual);
    }
}

// HID-4d.2b: coleta o Transfer Event terminal do TD que estava outstanding
// quando o slot entrou em DETACH_PENDING. Não valida/parsa o buffer como input:
// o evento representa cancel/drain de lifecycle, não um novo report do usuário.
@system
pub fn xhci_hid_report_drain_cancelled_for_slot(slot_id: u8) -> bool {
    if xhci_device_table_state(slot_id) != XHCI_DEVICE_STATE_DETACH_PENDING ||
       !xhci_hid_report_is_ready_for(slot_id) ||
       !xhci_hid_report_transfer_pending_for(slot_id) {
        return false;
    }
    let state_index = xhci_hid_report_index(slot_id);
    if state_index >= XHCI_HID_REPORT_SLOT_CAPACITY { return false; }
    let dci = xhci_hid_context_dci_for(slot_id);
    if dci <= 1 { return false; }

    unsafe {
        let physical = XHCI_HID_REPORT_STATES[state_index].pending_trb_physical;
        if physical == 0 { return false; }
        if !xhci_transfer_wait_stopped_or_completed(slot_id, dci, physical) {
            return false;
        }
        XHCI_HID_REPORT_STATES[state_index].transfer_pending = false;
        XHCI_HID_REPORT_STATES[state_index].pending_trb_physical = 0;
        XHCI_HID_REPORT_STATES[state_index].pending_transfer_length = 0;
        XHCI_HID_REPORT_STATES[state_index].last_length = 0;
        XHCI_HID_REPORT_ACTIVE_SLOT_ID = slot_id;
    }
    return true;
}

@system
pub fn xhci_hid_report_poll_slot_once(slot_id: u8) -> bool {
    if !xhci_hid_report_submit_for_slot(slot_id) { return false; }
    return xhci_hid_report_complete_for_slot(slot_id);
}

@system
pub fn xhci_hid_report_poll_once() -> bool {
    return xhci_hid_report_poll_slot_once(xhci_hid_report_active_slot_id());
}

