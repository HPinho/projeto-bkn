// Baken OS - Driver Nativo Realtek RTL8168/8111/8125 2.5GbE PCIe (@system)
// Controle de Registradores MMIO, Anéis de Descritores RX/TX e Interrupções MSI-X

module kernel::drivers::rtl8168;

import kernel::pci::*;
import kernel::pmm::*;

pub const RTL8168_VENDOR_ID: u16 = 0x10EC;
pub const RTL8168_DEVICE_ID: u16 = 0x8168;
pub const RTL8125_DEVICE_ID: u16 = 0x8125;

// Registradores MMIO do Realtek NIC
pub const REG_IDR0: u32        = 0x00; // MAC Address bytes 0-3
pub const REG_IDR4: u32        = 0x04; // MAC Address bytes 4-5
pub const REG_COMMAND: u32     = 0x37; // Command Register (RST, RE, TE)
pub const REG_TX_POLL: u32     = 0x38; // Transmit Priority Polling
pub const REG_INTR_MASK: u32   = 0x3C; // Interrupt Mask Register (IMR)
pub const REG_INTR_STATUS: u32 = 0x3E; // Interrupt Status Register (ISR)
pub const REG_TX_ADDR_LO: u32  = 0x20; // TX Descriptor Base Low 32
pub const REG_TX_ADDR_HI: u32  = 0x24; // TX Descriptor Base High 32
pub const REG_RX_ADDR_LO: u32  = 0xE4; // RX Descriptor Base Low 32
pub const REG_RX_ADDR_HI: u32  = 0xE8; // RX Descriptor Base High 32
pub const REG_MAX_RX_SIZE: u32 = 0xDA; // Max RX Packet Size (MTU)

pub const CMD_RESET: u8 = 0x10;
pub const CMD_RX_EN: u8 = 0x08;
pub const CMD_TX_EN: u8 = 0x04;

pub struct RtlDescriptor {
    pub flags: u32,
    pub vlan: u32,
    pub buf_addr_lo: u32,
    pub buf_addr_hi: u32,
}

pub struct Rtl8168Device {
    pub mmio_base: u64,
    pub pci_bus: u8,
    pub pci_slot: u8,
    pub pci_func: u8,
    pub irq_line: u8,
    pub mac_address: [u8; 6],
    pub is_link_up: bool,
    pub rx_desc_phys: u64,
    pub tx_desc_phys: u64,
    pub cur_rx_idx: usize,
    pub cur_tx_idx: usize,
}

static mut RTL_DEVICE: Rtl8168Device = Rtl8168Device {
    mmio_base: 0,
    pci_bus: 0,
    pci_slot: 0,
    pci_func: 0,
    irq_line: 0,
    mac_address: [0; 6],
    is_link_up: false,
    rx_desc_phys: 0,
    tx_desc_phys: 0,
    cur_rx_idx: 0,
    cur_tx_idx: 0,
};

@system
pub fn rtl8168_init(pci_bus: u8, pci_slot: u8, pci_func: u8, bar0_phys: u64) -> bool {
    unsafe {
        RTL_DEVICE.pci_bus = pci_bus;
        RTL_DEVICE.pci_slot = pci_slot;
        RTL_DEVICE.pci_func = pci_func;
        RTL_DEVICE.mmio_base = bar0_phys;

        // 1. Soft Reset do Chipset
        let cmd_ptr = (bar0_phys + REG_COMMAND as u64) as *mut u8;
        *cmd_ptr = CMD_RESET;

        // 2. Lê MAC Address Real dos Registradores IDR0 e IDR4
        let idr0 = *((bar0_phys + REG_IDR0 as u64) as *const u32);
        let idr4 = *((bar0_phys + REG_IDR4 as u64) as *const u16);

        RTL_DEVICE.mac_address[0] = (idr0 & 0xFF) as u8;
        RTL_DEVICE.mac_address[1] = ((idr0 >> 8) & 0xFF) as u8;
        RTL_DEVICE.mac_address[2] = ((idr0 >> 16) & 0xFF) as u8;
        RTL_DEVICE.mac_address[3] = ((idr0 >> 24) & 0xFF) as u8;
        RTL_DEVICE.mac_address[4] = (idr4 & 0xFF) as u8;
        RTL_DEVICE.mac_address[5] = ((idr4 >> 8) & 0xFF) as u8;

        // 3. Aloca Anel de 64 Descritores RX e TX na Memória Física
        let rx_ring = pmm_alloc_pages(1);
        let tx_ring = pmm_alloc_pages(1);

        RTL_DEVICE.rx_desc_phys = rx_ring as u64;
        RTL_DEVICE.tx_desc_phys = tx_ring as u64;

        // Configura Endereço Base dos Descritores
        *((bar0_phys + REG_RX_ADDR_LO as u64) as *mut u32) = (rx_ring as u64 & 0xFFFFFFFF) as u32;
        *((bar0_phys + REG_RX_ADDR_HI as u64) as *mut u32) = ((rx_ring as u64 >> 32) & 0xFFFFFFFF) as u32;
        *((bar0_phys + REG_TX_ADDR_LO as u64) as *mut u32) = (tx_ring as u64 & 0xFFFFFFFF) as u32;
        *((bar0_phys + REG_TX_ADDR_HI as u64) as *mut u32) = ((tx_ring as u64 >> 32) & 0xFFFFFFFF) as u32;

        // 4. Habilita Receptor e Transmissor
        *cmd_ptr = CMD_RX_EN | CMD_TX_EN;
        RTL_DEVICE.is_link_up = true;
        return true;
    }
}

@system
pub fn rtl8168_send_packet(packet_phys: u64, length: u16) -> bool {
    unsafe {
        if !RTL_DEVICE.is_link_up { return false; }
        let desc = (RTL_DEVICE.tx_desc_phys as *mut RtlDescriptor).add(RTL_DEVICE.cur_tx_idx);
        (*desc).buf_addr_lo = (packet_phys & 0xFFFFFFFF) as u32;
        (*desc).buf_addr_hi = ((packet_phys >> 32) & 0xFFFFFFFF) as u32;
        (*desc).flags = (1 << 31) | (1 << 30) | (1 << 29) | (length as u32); // OWN, EOR, FS, LS

        // Dispara Poll de Transmissão
        let poll_ptr = (RTL_DEVICE.mmio_base + REG_TX_POLL as u64) as *mut u8;
        *poll_ptr = 0x40; // Transmit normal priority

        RTL_DEVICE.cur_tx_idx = (RTL_DEVICE.cur_tx_idx + 1) % 64;
        return true;
    }
}
