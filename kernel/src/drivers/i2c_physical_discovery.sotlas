// Baken OS — I2C-5a/5G: descoberta e mapeamento físico de controladores I2C (PCI/ACPI/MMIO).
//
// O discovery é fail-closed: primeiro resolve um controller lógico ACPI único, depois valida
// o ID PCI homologado, mapeia MMIO, inicializa o silício e somente então publica o backend.
// Nenhum dispositivo PCI sem correspondência ACPI exata é tocado pelo driver físico.

module kernel::drivers::i2c_physical_discovery;

import kernel::arch::x86_64::cpu::*;
import kernel::sync::spinlock::*;
import kernel::drivers::pci_bus::*;
import kernel::memory::active_page_tables::*;
import kernel::acpi::aml_discovery::*;
import kernel::acpi::aml_namespace::*;
import kernel::drivers::i2c_core::*;
import kernel::drivers::i2c_controller::*;
import kernel::drivers::i2c_controller_registry::*;
import kernel::drivers::i2c_discovery_bridge::*;
import kernel::drivers::i2c_designware::*;

pub const I2C_HARDWARE_TYPE_UNKNOWN: u8 = 0;
pub const I2C_HARDWARE_TYPE_DESIGNWARE: u8 = 1;
pub const I2C_HARDWARE_TYPE_INTEL_LPSS: u8 = 2;

pub const I2C_MAX_PHYSICAL_CONTROLLERS: usize = 8;
pub const PCI_CLASS_SERIAL_BUS: u8 = 0x0C;
pub const PCI_SUBCLASS_SMBUS: u8 = 0x05;
pub const PCI_SUBCLASS_SERIAL_OTHER: u8 = 0x80;

@repr(C)
pub struct I2cPhysicalController {
    pub bus: u8;
    pub slot: u8;
    pub func: u8;
    pub vendor_id: u16;
    pub device_id: u16;
    pub hardware_type: u8;
    pub physical_base: u64;
    pub virtual_base: u64;
    pub mmio_size: u64;
    pub input_clock_hz: u32;
    pub irq_line: u8;
    pub acpi_namespace_index: usize;
    pub initialized: bool;
    pub valid: bool;
}

static mut I2C_PHYSICAL_CONTROLLERS: [I2cPhysicalController; I2C_MAX_PHYSICAL_CONTROLLERS] = [
    I2cPhysicalController {
        bus: 0,
        slot: 0,
        func: 0,
        vendor_id: 0,
        device_id: 0,
        hardware_type: I2C_HARDWARE_TYPE_UNKNOWN,
        physical_base: 0,
        virtual_base: 0,
        mmio_size: 0,
        input_clock_hz: 0,
        irq_line: 0,
        acpi_namespace_index: AML_NAMESPACE_INVALID_INDEX,
        initialized: false,
        valid: false
    };
    I2C_MAX_PHYSICAL_CONTROLLERS
];

static mut I2C_PHYSICAL_CONTROLLER_LOCKS: [SpinLock; I2C_MAX_PHYSICAL_CONTROLLERS] = [
    SpinLock { state: SPINLOCK_UNLOCKED };
    I2C_MAX_PHYSICAL_CONTROLLERS
];

static mut I2C_PHYSICAL_READY: bool = false;
static mut I2C_PHYSICAL_LOCK: SpinLock = SpinLock { state: SPINLOCK_UNLOCKED };
static mut I2C_PHYSICAL_LOCK_READY: bool = false;
static mut I2C_PHYSICAL_COUNT: usize = 0;

@system
pub fn i2c_physical_invalid_controller() -> I2cPhysicalController {
    return I2cPhysicalController {
        bus: 0,
        slot: 0,
        func: 0,
        vendor_id: 0,
        device_id: 0,
        hardware_type: I2C_HARDWARE_TYPE_UNKNOWN,
        physical_base: 0,
        virtual_base: 0,
        mmio_size: 0,
        input_clock_hz: 0,
        irq_line: 0,
        acpi_namespace_index: AML_NAMESPACE_INVALID_INDEX,
        initialized: false,
        valid: false
    };
}

// Tabela fail-closed de clocks baseada nas famílias Intel LPSS homologadas pelo backend.
// IDs ausentes retornam 0 e portanto NÃO são tratados como I2C físico suportado.
@system
pub fn i2c_physical_clock_for_device(vendor_id: u16, device_id: u16) -> u32 {
    if vendor_id == 0x16C3 { return 100000000; }
    if vendor_id != 0x8086 { return 0; }

    // Sunrise Point / Kaby Lake e Tiger Lake-LP usam a plataforma SPT: 120 MHz.
    if (device_id >= 0x9D60 && device_id <= 0x9D65) ||
       (device_id >= 0xA160 && device_id <= 0xA162) ||
       (device_id >= 0xA0C5 && device_id <= 0xA0C6) ||
       (device_id >= 0xA0D8 && device_id <= 0xA0D9) ||
       (device_id >= 0xA0E8 && device_id <= 0xA0EB) {
        return 120000000;
    }

    // Cannon/Comet Lake usam a plataforma CNL: 216 MHz.
    if (device_id >= 0x02C5 && device_id <= 0x02C6) ||
       (device_id >= 0x02E8 && device_id <= 0x02EB) ||
       (device_id >= 0x06E8 && device_id <= 0x06EB) ||
       (device_id >= 0x9DC5 && device_id <= 0x9DC6) ||
       (device_id >= 0x9DE8 && device_id <= 0x9DEB) {
        return 216000000;
    }

    // Elkhart Lake usa 100 MHz.
    if (device_id >= 0x4B44 && device_id <= 0x4B45) ||
       (device_id >= 0x4B4B && device_id <= 0x4B4C) ||
       (device_id >= 0x4B78 && device_id <= 0x4B7B) {
        return 100000000;
    }

    // Plataformas BXT/APL/GLK/ICL e gerações posteriores com bxt_i2c_info: 133 MHz.
    if device_id == 0x5AAC || device_id == 0x5AAE || device_id == 0x5AB0 || device_id == 0x5AB2 ||
       device_id == 0x5AB4 || device_id == 0x5AB6 || device_id == 0x5AB8 || device_id == 0x5ABA ||
       device_id == 0x31AC || device_id == 0x31AE || device_id == 0x31B0 || device_id == 0x31B2 ||
       device_id == 0x31B4 || device_id == 0x31B6 || device_id == 0x31B8 || device_id == 0x31BA ||
       (device_id >= 0x34C5 && device_id <= 0x34C6) ||
       (device_id >= 0x34E8 && device_id <= 0x34EB) ||
       (device_id >= 0x43AD && device_id <= 0x43AE) || device_id == 0x43D8 ||
       (device_id >= 0x43E8 && device_id <= 0x43EB) ||
       (device_id >= 0x51C5 && device_id <= 0x51C6) ||
       (device_id >= 0x51D8 && device_id <= 0x51D9) ||
       (device_id >= 0x51E8 && device_id <= 0x51EB) ||
       (device_id >= 0x54C5 && device_id <= 0x54C6) ||
       (device_id >= 0x54E8 && device_id <= 0x54EB) ||
       (device_id >= 0x7A4C && device_id <= 0x7A4F) ||
       (device_id >= 0x7A7C && device_id <= 0x7A7D) ||
       (device_id >= 0x7ACC && device_id <= 0x7ACF) ||
       (device_id >= 0x7AFC && device_id <= 0x7AFD) ||
       (device_id >= 0x7E50 && device_id <= 0x7E51) ||
       (device_id >= 0x7E78 && device_id <= 0x7E7B) ||
       (device_id >= 0x98C5 && device_id <= 0x98C6) ||
       (device_id >= 0x98E8 && device_id <= 0x98EB) {
        return 133000000;
    }

    return 0;
}

@system
pub fn i2c_physical_identify_hardware(vendor_id: u16, device_id: u16, class_code: u8, subclass: u8) -> u8 {
    let is_valid_pci_serial_class = class_code == PCI_CLASS_SERIAL_BUS &&
        (subclass == PCI_SUBCLASS_SERIAL_OTHER || subclass == PCI_SUBCLASS_SMBUS);
    if !is_valid_pci_serial_class { return I2C_HARDWARE_TYPE_UNKNOWN; }

    if vendor_id == 0x8086 {
        if i2c_physical_clock_for_device(vendor_id, device_id) != 0 {
            return I2C_HARDWARE_TYPE_INTEL_LPSS;
        }
        return I2C_HARDWARE_TYPE_UNKNOWN;
    }

    if vendor_id == 0x16C3 { return I2C_HARDWARE_TYPE_DESIGNWARE; }
    return I2C_HARDWARE_TYPE_UNKNOWN;
}

@system
pub fn i2c_physical_discovery_init() -> bool {
    let flags = x86_irq_save_disable();
    unsafe {
        if !I2C_PHYSICAL_LOCK_READY {
            if !spinlock_init(&mut I2C_PHYSICAL_LOCK) {
                x86_irq_restore(flags);
                return false;
            }
            let mut l_idx: usize = 0;
            while l_idx < I2C_MAX_PHYSICAL_CONTROLLERS {
                if !spinlock_init(&mut I2C_PHYSICAL_CONTROLLER_LOCKS[l_idx]) {
                    x86_irq_restore(flags);
                    return false;
                }
                l_idx += 1;
            }
            I2C_PHYSICAL_LOCK_READY = true;
        }
        if !spinlock_lock(&mut I2C_PHYSICAL_LOCK) {
            x86_irq_restore(flags);
            return false;
        }
        if I2C_PHYSICAL_READY {
            spinlock_unlock(&mut I2C_PHYSICAL_LOCK);
            x86_irq_restore(flags);
            return true;
        }

        let mut index: usize = 0;
        while index < I2C_MAX_PHYSICAL_CONTROLLERS {
            I2C_PHYSICAL_CONTROLLERS[index] = i2c_physical_invalid_controller();
            index += 1;
        }
        I2C_PHYSICAL_COUNT = 0;
        I2C_PHYSICAL_READY = true;
        spinlock_unlock(&mut I2C_PHYSICAL_LOCK);
    }
    x86_irq_restore(flags);
    return true;
}

// Pareamento estrito para Bus 0. Apenas namespaces já reconhecidos pela bridge lógica
// são elegíveis e qualquer ambiguidade de _ADR é rejeitada.
@system
pub fn i2c_physical_find_acpi_namespace(bus: u8, slot: u8, func: u8) -> usize {
    if !aml_discovery_is_ready() || bus != 0 { return AML_NAMESPACE_INVALID_INDEX; }

    let count = aml_discovery_device_count();
    let target_adr = ((slot as u64) << 16) | (func as u64);
    let mut found = AML_NAMESPACE_INVALID_INDEX;
    let mut i: usize = 0;

    while i < count {
        let dev = aml_discovery_device(i);
        let mut ns_index = AML_NAMESPACE_INVALID_INDEX;
        unsafe {
            if dev != (null as *const AmlDiscoveredDevice) &&
               (*dev).valid && (*dev).has_adr && (*dev).adr == target_adr {
                ns_index = (*dev).namespace_index;
            }
        }

        if ns_index != AML_NAMESPACE_INVALID_INDEX {
            let logical = i2c_discovery_bridge_find_by_namespace(ns_index);
            if i2c_controller_handle_valid(&logical) {
                if found != AML_NAMESPACE_INVALID_INDEX && found != ns_index {
                    return AML_NAMESPACE_INVALID_INDEX;
                }
                found = ns_index;
            }
        }
        i += 1;
    }

    return found;
}

@system
pub fn i2c_physical_lock_controller(backend_instance: u32) -> bool {
    if backend_instance == 0 || backend_instance > (I2C_MAX_PHYSICAL_CONTROLLERS as u32) { return false; }
    let idx = (backend_instance - 1) as usize;
    unsafe { return spinlock_lock(&mut I2C_PHYSICAL_CONTROLLER_LOCKS[idx]); }
}

@system
pub fn i2c_physical_unlock_controller(backend_instance: u32) -> void {
    if backend_instance == 0 || backend_instance > (I2C_MAX_PHYSICAL_CONTROLLERS as u32) { return; }
    let idx = (backend_instance - 1) as usize;
    unsafe { spinlock_unlock(&mut I2C_PHYSICAL_CONTROLLER_LOCKS[idx]); }
}

@system
fn i2c_physical_rollback_last(slot_idx: usize) -> void {
    if slot_idx >= I2C_MAX_PHYSICAL_CONTROLLERS { return; }
    let flags = x86_irq_save_disable();
    unsafe {
        if I2C_PHYSICAL_LOCK_READY && spinlock_lock(&mut I2C_PHYSICAL_LOCK) {
            if I2C_PHYSICAL_READY && I2C_PHYSICAL_CONTROLLERS[slot_idx].valid {
                I2C_PHYSICAL_CONTROLLERS[slot_idx] = i2c_physical_invalid_controller();
                if I2C_PHYSICAL_COUNT == slot_idx + 1 && I2C_PHYSICAL_COUNT != 0 {
                    I2C_PHYSICAL_COUNT -= 1;
                }
            }
            spinlock_unlock(&mut I2C_PHYSICAL_LOCK);
        }
    }
    x86_irq_restore(flags);
}

@system
pub fn i2c_physical_probe_pci() -> usize {
    if !i2c_physical_discovery_init() { return 0; }

    let count = pci_get_device_count();
    let mut discovered: usize = 0;
    let mut i: u32 = 0;

    while i < count {
        let dev_ptr = pci_get_device(i);
        if dev_ptr != (null as *const PciDevice) {
            let bus = unsafe { (*dev_ptr).bus };
            let slot = unsafe { (*dev_ptr).slot };
            let func = unsafe { (*dev_ptr).func };
            let vendor_id = unsafe { (*dev_ptr).vendor_id };
            let device_id = unsafe { (*dev_ptr).device_id };
            let class_code = unsafe { (*dev_ptr).class_code };
            let subclass = unsafe { (*dev_ptr).subclass };

            let hw_type = i2c_physical_identify_hardware(vendor_id, device_id, class_code, subclass);
            if hw_type != I2C_HARDWARE_TYPE_UNKNOWN {
                // Resolve e valida o controller lógico ANTES de habilitar PCI ou tocar MMIO.
                let acpi_ns = i2c_physical_find_acpi_namespace(bus, slot, func);
                if acpi_ns == AML_NAMESPACE_INVALID_INDEX {
                    i += 1;
                    continue;
                }
                let logical_handle = i2c_discovery_bridge_find_by_namespace(acpi_ns);
                if !i2c_controller_handle_valid(&logical_handle) {
                    i += 1;
                    continue;
                }
                // Probe repetido é idempotente: só ATTACHED e sem backend pode avançar.
                let logical_record = i2c_controller_registry_snapshot(
                    logical_handle.controller_id,
                    logical_handle.generation
                );
                if !logical_record.valid ||
                   logical_record.state != I2C_CONTROLLER_STATE_ATTACHED ||
                   logical_record.backend_ready {
                    i += 1;
                    continue;
                }

                let input_clock = i2c_physical_clock_for_device(vendor_id, device_id);
                if input_clock == 0 {
                    i += 1;
                    continue;
                }

                let mut bar0 = PciBar {
                    base_address: 0,
                    size: 0,
                    is_io: false,
                    is_64bit: false,
                    is_prefetchable: false
                };

                // pci_probe_bar retorna o avanço do BAR (1/2); base_address é o critério de validade.
                let bar_step = pci_probe_bar(bus, slot, func, 0, &mut bar0);
                if bar_step >= 1 && bar0.base_address != 0 && !bar0.is_io {
                    pci_enable_command_bits(bus, slot, func, PCI_COMMAND_MEMORY_SPACE);

                    let phys_base = bar0.base_address;
                    let page_aligned = phys_base & 0xFFFFFFFFFFFFF000;
                    if !active_page_tables_map_mmio_identity_4k(page_aligned) {
                        i += 1;
                        continue;
                    }

                    if hw_type == I2C_HARDWARE_TYPE_INTEL_LPSS {
                        i2c_lpss_reset_release(phys_base, phys_base);
                    }

                    let init_ok = i2c_dw_init_with_clock(phys_base, DW_SUPPORTED_FAST_SPEED_HZ, input_clock);
                    if !init_ok {
                        i += 1;
                        continue;
                    }

                    let flags = x86_irq_save_disable();
                    let mut slot_idx: usize = I2C_MAX_PHYSICAL_CONTROLLERS;
                    unsafe {
                        if I2C_PHYSICAL_LOCK_READY && spinlock_lock(&mut I2C_PHYSICAL_LOCK) {
                            if I2C_PHYSICAL_READY && I2C_PHYSICAL_COUNT < I2C_MAX_PHYSICAL_CONTROLLERS {
                                slot_idx = I2C_PHYSICAL_COUNT;
                                I2C_PHYSICAL_CONTROLLERS[slot_idx] = I2cPhysicalController {
                                    bus: bus,
                                    slot: slot,
                                    func: func,
                                    vendor_id: vendor_id,
                                    device_id: device_id,
                                    hardware_type: hw_type,
                                    physical_base: phys_base,
                                    virtual_base: phys_base,
                                    mmio_size: 4096,
                                    input_clock_hz: input_clock,
                                    irq_line: 0,
                                    acpi_namespace_index: acpi_ns,
                                    initialized: true,
                                    valid: true
                                };
                                I2C_PHYSICAL_COUNT += 1;
                            }
                            spinlock_unlock(&mut I2C_PHYSICAL_LOCK);
                        }
                    }
                    x86_irq_restore(flags);

                    if slot_idx >= I2C_MAX_PHYSICAL_CONTROLLERS {
                        i2c_dw_enable(phys_base, false);
                        i += 1;
                        continue;
                    }

                    let backend_instance = (slot_idx + 1) as u32;
                    let physical_caps = i2c_discovery_default_capabilities(DW_SUPPORTED_FAST_SPEED_HZ, false);

                    if !i2c_controller_registry_update_capabilities(
                        logical_handle.controller_id,
                        logical_handle.generation,
                        &physical_caps
                    ) {
                        i2c_physical_rollback_last(slot_idx);
                        i2c_dw_enable(phys_base, false);
                        i += 1;
                        continue;
                    }

                    if !i2c_controller_registry_publish_backend(
                        logical_handle.controller_id,
                        logical_handle.generation,
                        backend_instance
                    ) {
                        i2c_physical_rollback_last(slot_idx);
                        i2c_dw_enable(phys_base, false);
                        i += 1;
                        continue;
                    }

                    if !i2c_controller_registry_activate(
                        logical_handle.controller_id,
                        logical_handle.generation
                    ) {
                        i2c_controller_registry_mark_failed(
                            logical_handle.controller_id,
                            logical_handle.generation
                        );
                        i2c_physical_rollback_last(slot_idx);
                        i2c_dw_enable(phys_base, false);
                        i += 1;
                        continue;
                    }

                    discovered += 1;
                }
            }
        }
        i += 1;
    }

    return discovered;
}

@system
pub fn i2c_physical_controller_get(index: usize) -> I2cPhysicalController {
    if index >= I2C_MAX_PHYSICAL_CONTROLLERS { return i2c_physical_invalid_controller(); }
    let flags = x86_irq_save_disable();
    let mut result = i2c_physical_invalid_controller();
    unsafe {
        if I2C_PHYSICAL_LOCK_READY && spinlock_lock(&mut I2C_PHYSICAL_LOCK) {
            if I2C_PHYSICAL_READY && I2C_PHYSICAL_CONTROLLERS[index].valid {
                result = I2C_PHYSICAL_CONTROLLERS[index];
            }
            spinlock_unlock(&mut I2C_PHYSICAL_LOCK);
        }
    }
    x86_irq_restore(flags);
    return result;
}

@system
pub fn i2c_physical_get_mmio_base(backend_instance: u32) -> u64 {
    if backend_instance == 0 || backend_instance > (I2C_MAX_PHYSICAL_CONTROLLERS as u32) { return 0; }
    let index = (backend_instance - 1) as usize;
    let controller = i2c_physical_controller_get(index);
    if controller.valid && controller.initialized { return controller.virtual_base; }
    return 0;
}

@system
pub fn i2c_physical_discovered_count() -> usize {
    let flags = x86_irq_save_disable();
    let mut count: usize = 0;
    unsafe {
        if !I2C_PHYSICAL_LOCK_READY || !spinlock_lock(&mut I2C_PHYSICAL_LOCK) {
            x86_irq_restore(flags);
            return 0;
        }
        if I2C_PHYSICAL_READY { count = I2C_PHYSICAL_COUNT; }
        spinlock_unlock(&mut I2C_PHYSICAL_LOCK);
    }
    x86_irq_restore(flags);
    return count;
}
