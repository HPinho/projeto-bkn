@system
fn xhci_hid_attach_input_device_for_slot(slot_id: u8,
                                         protocol: u8,
                                         interface_number: u8) -> bool {
    if !xhci_hid_descriptor_state_is_current(slot_id) { return false; }
    let mut device_class: u8 = INPUT_DEVICE_CLASS_GENERIC;
    if protocol == USB_HID_PROTOCOL_KEYBOARD {
        device_class = INPUT_DEVICE_CLASS_KEYBOARD;
    } else if protocol == USB_HID_PROTOCOL_MOUSE {
        device_class = INPUT_DEVICE_CLASS_POINTER;
    } else {
        return false;
    }

    let handle = input_device_attach(
        device_class, INPUT_TRANSPORT_USB, 0, slot_id as u32,
        interface_number as u16
    );
    if !handle.valid { return false; }
    if !input_device_activate(handle.device_id, handle.generation) {
        input_device_detach(handle.device_id, handle.generation);
        return false;
    }
    unsafe {
        let index = xhci_hid_descriptor_index(slot_id);
        XHCI_HID_DESCRIPTOR_STATES[index].input_device_id = handle.device_id;
        XHCI_HID_DESCRIPTOR_STATES[index].input_device_generation = handle.generation;
    }
    return true;
}

@system
fn xhci_hid_bind_input_events_for_slot(slot_id: u8) -> bool {
    if !xhci_hid_descriptor_state_is_current(slot_id) { return false; }
    let index = xhci_hid_descriptor_index(slot_id);
    let device_id = unsafe { XHCI_HID_DESCRIPTOR_STATES[index].input_device_id };
    let generation = unsafe { XHCI_HID_DESCRIPTOR_STATES[index].input_device_generation };
    if device_id == INPUT_DEVICE_ID_NONE || generation == INPUT_DEVICE_GENERATION_INVALID ||
       !input_device_is_active(device_id, generation) ||
       !hid_input_device_map_is_ready(device_id, generation) {
        return false;
    }
    return hid_input_events_bind_device(device_id, generation);
}

@system
fn xhci_hid_descriptor_probe_internal_for_slot(slot_id: u8) -> bool {
    if !hid_report_descriptor_self_test() || !hid_input_report_self_test() ||
       !hid_input_device_map_self_test() || !xhci_hid_descriptor_prepare_state(slot_id) {
        return false;
    }
    let length = xhci_hid_report_descriptor_length_for(slot_id);
    let interface_number = xhci_hid_interface_number_for(slot_id);
    if length == 0 || (length as u64) > XHCI_HID_DESCRIPTOR_DMA_SIZE { return false; }

    let mut buffer = dma_alloc(XHCI_HID_DESCRIPTOR_DMA_SIZE, XHCI_HID_DESCRIPTOR_DMA_SIZE);
    if !dma_buffer_cpu_owned(&buffer) { return false; }
    if !xhci_hid_descriptor_zero(buffer.virtual_address, length as u64) { return false; }
    if !dma_share_with_device(&mut buffer) { return false; }
    if !xhci_hid_descriptor_fetch_for_slot(slot_id, &mut buffer, interface_number, length) {
        return false;
    }

    let info = hid_report_descriptor_parse(buffer.virtual_address as *const u8, length as usize);
    if !info.valid || info.descriptor_length != length { return false; }

    let protocol = xhci_hid_protocol_for(slot_id);
    if protocol == USB_HID_PROTOCOL_KEYBOARD && !info.has_keyboard_application { return false; }
    if protocol == USB_HID_PROTOCOL_MOUSE && !info.has_mouse_application { return false; }
    if protocol != USB_HID_PROTOCOL_KEYBOARD && protocol != USB_HID_PROTOCOL_MOUSE { return false; }

    if !info.has_report_ids {
        let input_bytes = hid_report_descriptor_input_bytes(info);
        if input_bytes == 0 || input_bytes > xhci_hid_endpoint_max_packet_for(slot_id) {
            return false;
        }
    }

    if !input_device_registry_init() || !input_device_registry_is_ready() ||
       !hid_input_device_map_initialize() || !hid_input_device_map_core_is_ready() {
        xhci_hid_device_emit_failure_marker();
        return false;
    }
    if !xhci_hid_attach_input_device_for_slot(slot_id, protocol, interface_number) {
        xhci_hid_device_emit_failure_marker();
        return false;
    }

    let device_id = xhci_hid_descriptor_input_device_id_for(slot_id);
    let generation = xhci_hid_descriptor_input_device_generation_for(slot_id);
    if !hid_input_device_map_build(
        device_id, generation, buffer.virtual_address as *const u8, length as usize
    ) || !hid_input_device_map_is_ready(device_id, generation) {
        xhci_hid_input_map_emit_failure_marker();
        xhci_hid_device_map_emit_failure_marker();
        xhci_hid_descriptor_release_input_device_for_slot(slot_id);
        return false;
    }
    if !xhci_hid_input_map_emit_ready_marker() || !xhci_hid_device_map_emit_ready_marker() {
        xhci_hid_descriptor_release_input_device_for_slot(slot_id);
        return false;
    }

    if !hid_input_events_initialize() || !hid_input_events_is_ready() {
        xhci_hid_event_model_emit_failure_marker();
        xhci_hid_descriptor_release_input_device_for_slot(slot_id);
        return false;
    }
    if !xhci_hid_bind_input_events_for_slot(slot_id) {
        xhci_hid_device_emit_failure_marker();
        xhci_hid_descriptor_release_input_device_for_slot(slot_id);
        return false;
    }
    if !xhci_hid_event_model_emit_ready_marker() { return false; }

    if !xhci_hid_descriptor_input_device_is_active_for(slot_id) {
        xhci_hid_device_emit_failure_marker();
        xhci_hid_descriptor_release_input_device_for_slot(slot_id);
        return false;
    }
    if !xhci_hid_device_emit_ready_marker() {
        xhci_hid_descriptor_release_input_device_for_slot(slot_id);
        return false;
    }
    if !xhci_hid_descriptor_state_is_current(slot_id) { return false; }

    unsafe {
        let index = xhci_hid_descriptor_index(slot_id);
        XHCI_HID_DESCRIPTOR_STATES[index].buffer = buffer;
        XHCI_HID_DESCRIPTOR_STATES[index].info = info;
    }
    return true;
}

@system
pub fn xhci_hid_descriptor_emit_ready_marker() -> bool {
    let marker: [u8; 31] = [
        66,65,75,69,78,58,85,83,66,95,72,73,68,95,68,69,
        83,67,82,73,80,84,79,82,95,82,69,65,68,89,10
    ];
    let mut index: usize = 0;
    while index < 31 {
        if !x86_serial_write_byte(marker[index]) { return false; }
        index += 1;
    }
    return true;
}

@system
pub fn xhci_hid_descriptor_emit_failure_marker() -> bool {
    let marker: [u8; 32] = [
        66,65,75,69,78,58,85,83,66,95,72,73,68,95,68,69,
        83,67,82,73,80,84,79,82,95,70,65,73,76,69,68,10
    ];
    let mut index: usize = 0;
    while index < 32 {
        if !x86_serial_write_byte(marker[index]) { return false; }
        index += 1;
    }
    return true;
}

@system
pub fn xhci_hid_descriptor_initialize_for_slot(slot_id: u8) -> bool {
    if !xhci_hid_descriptor_prepare_state(slot_id) {
        xhci_hid_descriptor_emit_failure_marker();
        return false;
    }
    let epoch = xhci_device_table_slot_epoch(slot_id);
    if !xhci_hid_descriptor_reset_for_slot(slot_id, epoch) {
        xhci_hid_descriptor_emit_failure_marker();
        return false;
    }
    if !xhci_hid_descriptor_probe_internal_for_slot(slot_id) {
        xhci_hid_descriptor_emit_failure_marker();
        return false;
    }
    if !xhci_hid_descriptor_state_is_current(slot_id) { return false; }
    unsafe {
        XHCI_HID_DESCRIPTOR_STATES[xhci_hid_descriptor_index(slot_id)].ready = true;
    }
    if !xhci_hid_descriptor_emit_ready_marker() {
        unsafe {
            XHCI_HID_DESCRIPTOR_STATES[xhci_hid_descriptor_index(slot_id)].ready = false;
        }
        return false;
    }
    return true;
}

@system
pub fn xhci_hid_descriptor_initialize() -> bool {
    let slot_id = xhci_address_slot_id();
    if slot_id == 0 { return false; }
    return xhci_hid_descriptor_initialize_for_slot(slot_id);
}

@system
pub fn xhci_hid_descriptor_is_ready_for(slot_id: u8) -> bool {
    if !xhci_hid_descriptor_state_is_current(slot_id) { return false; }
    unsafe { return XHCI_HID_DESCRIPTOR_STATES[xhci_hid_descriptor_index(slot_id)].ready; }
}

@system
pub fn xhci_hid_descriptor_is_ready() -> bool {
    return xhci_hid_descriptor_is_ready_for(xhci_address_slot_id());
}

@system
pub fn xhci_hid_descriptor_input_device_id_for(slot_id: u8) -> u32 {
    if !xhci_hid_descriptor_state_is_current(slot_id) { return INPUT_DEVICE_ID_NONE; }
    unsafe { return XHCI_HID_DESCRIPTOR_STATES[xhci_hid_descriptor_index(slot_id)].input_device_id; }
}

@system
pub fn xhci_hid_descriptor_input_device_id() -> u32 {
    return xhci_hid_descriptor_input_device_id_for(xhci_address_slot_id());
}

@system
pub fn xhci_hid_descriptor_input_device_generation_for(slot_id: u8) -> u32 {
    if !xhci_hid_descriptor_state_is_current(slot_id) {
        return INPUT_DEVICE_GENERATION_INVALID;
    }
    unsafe {
        return XHCI_HID_DESCRIPTOR_STATES[xhci_hid_descriptor_index(slot_id)].input_device_generation;
    }
}

@system
pub fn xhci_hid_descriptor_input_device_generation() -> u32 {
    return xhci_hid_descriptor_input_device_generation_for(xhci_address_slot_id());
}

@system
pub fn xhci_hid_descriptor_input_map_is_ready_for(slot_id: u8) -> bool {
    let device_id = xhci_hid_descriptor_input_device_id_for(slot_id);
    let generation = xhci_hid_descriptor_input_device_generation_for(slot_id);
    return device_id != INPUT_DEVICE_ID_NONE &&
           generation != INPUT_DEVICE_GENERATION_INVALID &&
           hid_input_device_map_is_ready(device_id, generation);
}

@system
pub fn xhci_hid_descriptor_input_map_is_ready() -> bool {
    return xhci_hid_descriptor_input_map_is_ready_for(xhci_address_slot_id());
}

@system
pub fn xhci_hid_descriptor_input_device_is_active_for(slot_id: u8) -> bool {
    let device_id = xhci_hid_descriptor_input_device_id_for(slot_id);
    let generation = xhci_hid_descriptor_input_device_generation_for(slot_id);
    return device_id != INPUT_DEVICE_ID_NONE &&
           generation != INPUT_DEVICE_GENERATION_INVALID &&
           input_device_is_active(device_id, generation) &&
           hid_input_device_map_is_ready(device_id, generation) &&
           hid_input_events_device_is_bound(device_id, generation);
}

@system
pub fn xhci_hid_descriptor_input_device_is_active() -> bool {
    return xhci_hid_descriptor_input_device_is_active_for(xhci_address_slot_id());
}

@system
pub fn xhci_hid_descriptor_length_for(slot_id: u8) -> u16 {
    if !xhci_hid_descriptor_is_ready_for(slot_id) { return 0; }
    unsafe {
        return XHCI_HID_DESCRIPTOR_STATES[xhci_hid_descriptor_index(slot_id)].info.descriptor_length;
    }
}

@system
pub fn xhci_hid_descriptor_length() -> u16 {
    return xhci_hid_descriptor_length_for(xhci_address_slot_id());
}

@system
pub fn xhci_hid_descriptor_input_bytes_for(slot_id: u8) -> u16 {
    if !xhci_hid_descriptor_is_ready_for(slot_id) { return 0; }
    unsafe {
        return hid_report_descriptor_input_bytes(
            XHCI_HID_DESCRIPTOR_STATES[xhci_hid_descriptor_index(slot_id)].info
        );
    }
}

@system
pub fn xhci_hid_descriptor_input_bytes() -> u16 {
    return xhci_hid_descriptor_input_bytes_for(xhci_address_slot_id());
}

@system
pub fn xhci_hid_descriptor_has_report_ids_for(slot_id: u8) -> bool {
    if !xhci_hid_descriptor_is_ready_for(slot_id) { return false; }
    unsafe {
        return XHCI_HID_DESCRIPTOR_STATES[xhci_hid_descriptor_index(slot_id)].info.has_report_ids;
    }
}

@system
pub fn xhci_hid_descriptor_has_report_ids() -> bool {
    return xhci_hid_descriptor_has_report_ids_for(xhci_address_slot_id());
}

@system
pub fn xhci_hid_descriptor_keyboard_application_for(slot_id: u8) -> bool {
    if !xhci_hid_descriptor_is_ready_for(slot_id) { return false; }
    unsafe {
        return XHCI_HID_DESCRIPTOR_STATES[xhci_hid_descriptor_index(slot_id)].info.has_keyboard_application;
    }
}

@system
pub fn xhci_hid_descriptor_keyboard_application() -> bool {
    return xhci_hid_descriptor_keyboard_application_for(xhci_address_slot_id());
}

@system
pub fn xhci_hid_descriptor_mouse_application_for(slot_id: u8) -> bool {
    if !xhci_hid_descriptor_is_ready_for(slot_id) { return false; }
    unsafe {
        return XHCI_HID_DESCRIPTOR_STATES[xhci_hid_descriptor_index(slot_id)].info.has_mouse_application;
    }
}

@system
