// Baken OS — transporte xHCI para HID Report Descriptor real via EP0.
//
// SET_CONFIGURATION continua sendo feito pelo estágio anterior. Depois que o
// dispositivo aceitou a configuração, este módulo envia GET_DESCRIPTOR(Report)
// ao recipient Interface, lê exatamente o wDescriptorLength descoberto no HID
// descriptor e entrega os bytes ao parser genérico hid_report_descriptor.
// Nenhum layout keyboard/mouse é inventado a partir do boot protocol.

module kernel::drivers::xhci_hid_descriptor;

import kernel::arch::x86_64::serial::*;
import kernel::memory::dma::*;
import kernel::drivers::hid_report_descriptor::*;
import kernel::drivers::xhci_context::*;
import kernel::drivers::xhci_address::*;
import kernel::drivers::xhci_ep0::*;
import kernel::drivers::xhci_descriptor::*;
import kernel::drivers::xhci_configuration::*;
import kernel::drivers::xhci_trb::*;
import kernel::drivers::xhci_transfer::*;

pub const USB_REQUEST_TYPE_DEVICE_TO_HOST_STANDARD_INTERFACE: u8 = 0x81;
pub const USB_HID_REPORT_DESCRIPTOR_VALUE: u16 = 0x2200;
pub const XHCI_HID_DESCRIPTOR_DMA_SIZE: u64 = 4096;

static mut XHCI_HID_DESCRIPTOR_READY: bool = false;
static mut XHCI_HID_DESCRIPTOR_BUFFER: DmaBuffer = DmaBuffer {
    virtual_address: null as *mut u8,
    physical_address: 0,
    size: 0,
    alignment: 0,
    owner: DMA_OWNER_CPU,
    fence: 0,
    valid: false
};
static mut XHCI_HID_DESCRIPTOR_INFO: HidReportDescriptorInfo = HidReportDescriptorInfo {
    valid: false,
    descriptor_length: 0,
    item_count: 0,
    collection_count: 0,
    input_bits: 0,
    output_bits: 0,
    feature_bits: 0,
    has_report_ids: false,
    has_keyboard_application: false,
    has_mouse_application: false
};

@system
fn xhci_hid_descriptor_reset() -> void {
    unsafe {
        XHCI_HID_DESCRIPTOR_READY = false;
        XHCI_HID_DESCRIPTOR_BUFFER = dma_invalid_buffer();
        XHCI_HID_DESCRIPTOR_INFO = hid_report_descriptor_invalid();
    }
}

@system
fn xhci_hid_descriptor_zero(base: *mut u8, size: u64) -> bool {
    if base == (null as *mut u8) || size == 0 || size > XHCI_HID_DESCRIPTOR_DMA_SIZE {
        return false;
    }
    unsafe {
        let mut index: u64 = 0;
        while index < size {
            *(((base as usize) + (index as usize)) as *mut u8) = 0;
            index += 1;
        }
    }
    return true;
}

@system
fn xhci_hid_descriptor_fetch(buffer: *mut DmaBuffer,
                             interface_number: u8,
                             length: u16) -> bool {
    if buffer == (null as *mut DmaBuffer) || length == 0 ||
       (length as u64) > XHCI_HID_DESCRIPTOR_DMA_SIZE {
        return false;
    }
    unsafe {
        if !(*buffer).valid || (*buffer).physical_address == 0 ||
           (*buffer).virtual_address == (null as *mut u8) ||
           (length as u64) > (*buffer).size {
            return false;
        }
    }

    let slot_id = xhci_address_slot_id();
    if slot_id == 0 || slot_id != xhci_context_slot_id() { return false; }
    let setup = xhci_trb_setup_stage(
        USB_REQUEST_TYPE_DEVICE_TO_HOST_STANDARD_INTERFACE,
        USB_REQUEST_GET_DESCRIPTOR,
        USB_HID_REPORT_DESCRIPTOR_VALUE,
        interface_number as u16,
        length,
        XHCI_SETUP_TRT_IN_DATA,
        xhci_ep0_producer_cycle()
    );
    unsafe {
        let data = xhci_trb_data_stage(
            (*buffer).physical_address,
            length as u32,
            0,
            true,
            false,
            xhci_ep0_producer_cycle()
        );
        let status = xhci_trb_status_stage(false, true, xhci_ep0_producer_cycle());
        let status_physical = xhci_ep0_submit_control_td(setup, data, status, true);
        if status_physical == 0 { return false; }
        if !xhci_transfer_wait_ep0_completion(slot_id, status_physical) { return false; }
        return xhci_transfer_last_residual_length() == 0;
    }
}

@system
fn xhci_hid_descriptor_probe_internal() -> bool {
    if !hid_report_descriptor_self_test() || !xhci_configuration_is_ready() ||
       !xhci_ep0_is_ready() || !xhci_address_is_ready() {
        return false;
    }
    let length = xhci_hid_report_descriptor_length();
    let interface_number = xhci_hid_interface_number();
    if length == 0 || (length as u64) > XHCI_HID_DESCRIPTOR_DMA_SIZE { return false; }

    let mut buffer = dma_alloc(XHCI_HID_DESCRIPTOR_DMA_SIZE, XHCI_HID_DESCRIPTOR_DMA_SIZE);
    if !dma_buffer_cpu_owned(&buffer) { return false; }
    if !xhci_hid_descriptor_zero(buffer.virtual_address, length as u64) { return false; }
    if !dma_share_with_device(&mut buffer) { return false; }
    if !xhci_hid_descriptor_fetch(&mut buffer, interface_number, length) { return false; }

    let info = hid_report_descriptor_parse(buffer.virtual_address as *const u8, length as usize);
    if !info.valid || info.descriptor_length != length { return false; }

    let protocol = xhci_hid_protocol();
    if protocol == USB_HID_PROTOCOL_KEYBOARD && !info.has_keyboard_application { return false; }
    if protocol == USB_HID_PROTOCOL_MOUSE && !info.has_mouse_application { return false; }
    if protocol != USB_HID_PROTOCOL_KEYBOARD && protocol != USB_HID_PROTOCOL_MOUSE { return false; }

    // Sem Report ID, o tamanho agregado calculado é o tamanho exato do input
    // report e deve caber no Interrupt IN endpoint já configurado.
    if !info.has_report_ids {
        let input_bytes = hid_report_descriptor_input_bytes(info);
        if input_bytes == 0 || input_bytes > xhci_hid_endpoint_max_packet() { return false; }
    }

    unsafe {
        XHCI_HID_DESCRIPTOR_BUFFER = buffer;
        XHCI_HID_DESCRIPTOR_INFO = info;
    }
    return true;
}

@system
pub fn xhci_hid_descriptor_emit_ready_marker() -> bool {
    let marker: [u8; 31] = [
        66,65,75,69,78,58,85,83,66,95,72,73,68,95,68,69,
        83,67,82,73,80,84,79,82,95,82,69,65,68,89,10
    ];
    let mut index: usize = 0;
    while index < 31 {
        if !x86_serial_write_byte(marker[index]) { return false; }
        index += 1;
    }
    return true;
}

@system
pub fn xhci_hid_descriptor_emit_failure_marker() -> bool {
    let marker: [u8; 32] = [
        66,65,75,69,78,58,85,83,66,95,72,73,68,95,68,69,
        83,67,82,73,80,84,79,82,95,70,65,73,76,69,68,10
    ];
    let mut index: usize = 0;
    while index < 32 {
        if !x86_serial_write_byte(marker[index]) { return false; }
        index += 1;
    }
    return true;
}

@system
pub fn xhci_hid_descriptor_initialize() -> bool {
    xhci_hid_descriptor_reset();
    if !xhci_hid_descriptor_probe_internal() {
        xhci_hid_descriptor_emit_failure_marker();
        return false;
    }
    unsafe { XHCI_HID_DESCRIPTOR_READY = true; }
    if !xhci_hid_descriptor_emit_ready_marker() {
        unsafe { XHCI_HID_DESCRIPTOR_READY = false; }
        return false;
    }
    return true;
}

@system
pub fn xhci_hid_descriptor_is_ready() -> bool {
    unsafe { return XHCI_HID_DESCRIPTOR_READY; }
}

@system
pub fn xhci_hid_descriptor_length() -> u16 {
    unsafe {
        if !XHCI_HID_DESCRIPTOR_READY { return 0; }
        return XHCI_HID_DESCRIPTOR_INFO.descriptor_length;
    }
}

@system
pub fn xhci_hid_descriptor_input_bytes() -> u16 {
    unsafe {
        if !XHCI_HID_DESCRIPTOR_READY { return 0; }
        return hid_report_descriptor_input_bytes(XHCI_HID_DESCRIPTOR_INFO);
    }
}

@system
pub fn xhci_hid_descriptor_has_report_ids() -> bool {
    unsafe { return XHCI_HID_DESCRIPTOR_READY && XHCI_HID_DESCRIPTOR_INFO.has_report_ids; }
}

@system
pub fn xhci_hid_descriptor_keyboard_application() -> bool {
    unsafe { return XHCI_HID_DESCRIPTOR_READY && XHCI_HID_DESCRIPTOR_INFO.has_keyboard_application; }
}

@system
pub fn xhci_hid_descriptor_mouse_application() -> bool {
    unsafe { return XHCI_HID_DESCRIPTOR_READY && XHCI_HID_DESCRIPTOR_INFO.has_mouse_application; }
}
