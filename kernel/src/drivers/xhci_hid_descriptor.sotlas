// Baken OS — HID-4c.3: HID Report Descriptor + InputDevice por Slot ID + epoch.
//
// Cada slot xHCI mantém o Report Descriptor, identidade lógica HID-4a e snapshot
// HID-2 próprios. O Event Ring continua compartilhado, mas nenhum binding desta
// camada depende mais de singletons de transporte. Wrappers sem argumento
// preservam o bring-up legado do primeiro dispositivo.

module kernel::drivers::xhci_hid_descriptor;

import kernel::arch::x86_64::serial::*;
import kernel::memory::dma::*;
import kernel::drivers::input_device::*;
import kernel::drivers::input_event::*;
import kernel::drivers::hid_report_descriptor::*;
import kernel::drivers::hid_input_report::*;
import kernel::drivers::hid_input_device_map::*;
import kernel::drivers::hid_input_events::*;
import kernel::drivers::xhci_context::*;
import kernel::drivers::xhci_address::*;
import kernel::drivers::xhci_ep0::*;
import kernel::drivers::xhci_descriptor::*;
import kernel::drivers::xhci_configuration::*;
import kernel::drivers::xhci_device_table::*;
import kernel::drivers::xhci_trb::*;
import kernel::drivers::xhci_transfer::*;

pub const USB_REQUEST_TYPE_DEVICE_TO_HOST_STANDARD_INTERFACE: u8 = 0x81;
pub const USB_HID_REPORT_DESCRIPTOR_VALUE: u16 = 0x2200;
pub const XHCI_HID_DESCRIPTOR_DMA_SIZE: u64 = 4096;
pub const XHCI_HID_DESCRIPTOR_SLOT_CAPACITY: usize = XHCI_DEVICE_SLOT_CAPACITY;

pub struct XhciHidDescriptorState {
    pub ready: bool;
    pub epoch: u32;
    pub input_device_id: u32;
    pub input_device_generation: u32;
    pub buffer: DmaBuffer;
    pub info: HidReportDescriptorInfo;
}

static mut XHCI_HID_DESCRIPTOR_STATES: [XhciHidDescriptorState; XHCI_HID_DESCRIPTOR_SLOT_CAPACITY] = [
    XhciHidDescriptorState {
        ready: false,
        epoch: 0,
        input_device_id: INPUT_DEVICE_ID_NONE,
        input_device_generation: INPUT_DEVICE_GENERATION_INVALID,
        buffer: DmaBuffer {
            virtual_address: null as *mut u8,
            physical_address: 0,
            size: 0,
            alignment: 0,
            owner: DMA_OWNER_CPU,
            fence: 0,
            valid: false
        },
        info: HidReportDescriptorInfo {
            valid: false,
            descriptor_length: 0,
            item_count: 0,
            collection_count: 0,
            input_bits: 0,
            output_bits: 0,
            feature_bits: 0,
            has_report_ids: false,
            has_keyboard_application: false,
            has_mouse_application: false
        }
    };
    XHCI_HID_DESCRIPTOR_SLOT_CAPACITY
];

@system
fn xhci_hid_descriptor_index(slot_id: u8) -> usize {
    if slot_id == 0 { return XHCI_HID_DESCRIPTOR_SLOT_CAPACITY; }
    return slot_id as usize;
}

@system
fn xhci_hid_descriptor_state_is_current(slot_id: u8) -> bool {
    let index = xhci_hid_descriptor_index(slot_id);
    if index >= XHCI_HID_DESCRIPTOR_SLOT_CAPACITY ||
       !xhci_device_table_slot_is_valid(slot_id) {
        return false;
    }
    let epoch = xhci_device_table_slot_epoch(slot_id);
    unsafe {
        return epoch != 0 && XHCI_HID_DESCRIPTOR_STATES[index].epoch == epoch;
    }
}

@system
pub fn xhci_hid_descriptor_release_input_device_for_slot(slot_id: u8) -> bool {
    let index = xhci_hid_descriptor_index(slot_id);
    if index >= XHCI_HID_DESCRIPTOR_SLOT_CAPACITY { return false; }
    let device_id = unsafe { XHCI_HID_DESCRIPTOR_STATES[index].input_device_id };
    let generation = unsafe { XHCI_HID_DESCRIPTOR_STATES[index].input_device_generation };
    if device_id == INPUT_DEVICE_ID_NONE || generation == INPUT_DEVICE_GENERATION_INVALID {
        return true;
    }

    let queue_ready = input_event_queue_is_ready();
    let event_ready = hid_input_events_is_ready();
    let event_bound = event_ready && hid_input_events_device_is_bound(device_id, generation);
    let map_bound = hid_input_device_map_is_ready(device_id, generation);

    // Ordem: invalida identidade -> purga fila -> limpa estado HID -> remove mapa.
    if !input_device_detach(device_id, generation) { return false; }
    let mut released = true;
    if queue_ready && !input_event_purge_device(device_id, generation) { released = false; }
    if event_bound && !hid_input_events_unbind_device(device_id, generation) { released = false; }
    if map_bound && !hid_input_device_map_unbind(device_id, generation) { released = false; }

    unsafe {
        XHCI_HID_DESCRIPTOR_STATES[index].input_device_id = INPUT_DEVICE_ID_NONE;
        XHCI_HID_DESCRIPTOR_STATES[index].input_device_generation = INPUT_DEVICE_GENERATION_INVALID;
    }
    return released;
}

@system
pub fn xhci_hid_descriptor_release_input_device() -> bool {
    let slot_id = xhci_address_slot_id();
    if slot_id == 0 { return false; }
    return xhci_hid_descriptor_release_input_device_for_slot(slot_id);
}

@system
fn xhci_hid_descriptor_reset_for_slot(slot_id: u8, epoch: u32) -> bool {
    let index = xhci_hid_descriptor_index(slot_id);
    if index >= XHCI_HID_DESCRIPTOR_SLOT_CAPACITY || epoch == 0 { return false; }
    if !xhci_hid_descriptor_release_input_device_for_slot(slot_id) { return false; }
    unsafe {
        XHCI_HID_DESCRIPTOR_STATES[index].ready = false;
        XHCI_HID_DESCRIPTOR_STATES[index].epoch = epoch;
        XHCI_HID_DESCRIPTOR_STATES[index].input_device_id = INPUT_DEVICE_ID_NONE;
        XHCI_HID_DESCRIPTOR_STATES[index].input_device_generation = INPUT_DEVICE_GENERATION_INVALID;
        XHCI_HID_DESCRIPTOR_STATES[index].buffer = dma_invalid_buffer();
        XHCI_HID_DESCRIPTOR_STATES[index].info = hid_report_descriptor_invalid();
    }
    return true;
}

@system
fn xhci_hid_descriptor_prepare_state(slot_id: u8) -> bool {
    let index = xhci_hid_descriptor_index(slot_id);
    if index >= XHCI_HID_DESCRIPTOR_SLOT_CAPACITY ||
       !xhci_device_table_slot_is_valid(slot_id) ||
       !xhci_address_is_ready_for(slot_id) ||
       !xhci_context_is_ready_for(slot_id) ||
       !xhci_ep0_is_ready_for(slot_id) ||
       !xhci_configuration_is_ready_for(slot_id) {
        return false;
    }
    let epoch = xhci_device_table_slot_epoch(slot_id);
    if epoch == 0 { return false; }
    unsafe {
        if XHCI_HID_DESCRIPTOR_STATES[index].epoch != epoch {
            return xhci_hid_descriptor_reset_for_slot(slot_id, epoch);
        }
    }
    return true;
}

@system
fn xhci_hid_descriptor_zero(base: *mut u8, size: u64) -> bool {
    if base == (null as *mut u8) || size == 0 || size > XHCI_HID_DESCRIPTOR_DMA_SIZE {
        return false;
    }
    unsafe {
        let mut index: u64 = 0;
        while index < size {
            *(((base as usize) + (index as usize)) as *mut u8) = 0;
            index += 1;
        }
    }
    return true;
}

@system
fn xhci_hid_descriptor_fetch_for_slot(slot_id: u8,
                                      buffer: *mut DmaBuffer,
                                      interface_number: u8,
                                      length: u16) -> bool {
    if buffer == (null as *mut DmaBuffer) || length == 0 ||
       (length as u64) > XHCI_HID_DESCRIPTOR_DMA_SIZE ||
       !xhci_hid_descriptor_prepare_state(slot_id) {
        return false;
    }
    unsafe {
        if !(*buffer).valid || (*buffer).physical_address == 0 ||
           (*buffer).virtual_address == (null as *mut u8) ||
           (length as u64) > (*buffer).size {
            return false;
        }
    }

    let setup = xhci_trb_setup_stage(
        USB_REQUEST_TYPE_DEVICE_TO_HOST_STANDARD_INTERFACE,
        USB_REQUEST_GET_DESCRIPTOR,
        USB_HID_REPORT_DESCRIPTOR_VALUE,
        interface_number as u16,
        length,
        XHCI_SETUP_TRT_IN_DATA,
        xhci_ep0_producer_cycle_for(slot_id)
    );
    unsafe {
        let data = xhci_trb_data_stage(
            (*buffer).physical_address,
            length as u32,
            0,
            true,
            false,
            xhci_ep0_producer_cycle_for(slot_id)
        );
        let status = xhci_trb_status_stage(
            false,
            true,
            xhci_ep0_producer_cycle_for(slot_id)
        );
        let status_physical = xhci_ep0_submit_control_td_for_slot(
            slot_id, setup, data, status, true
        );
        if status_physical == 0 { return false; }
        if !xhci_transfer_wait_ep0_completion(slot_id, status_physical) { return false; }
        return xhci_transfer_last_residual_length_for(slot_id) == 0;
    }
}

@system
fn xhci_hid_input_map_emit_ready_marker() -> bool {
    let marker: [u8; 30] = [
        66,65,75,69,78,58,85,83,66,95,72,73,68,95,73,78,
        80,85,84,95,77,65,80,95,82,69,65,68,89,10
    ];
    let mut index: usize = 0;
    while index < 30 {
        if !x86_serial_write_byte(marker[index]) { return false; }
        index += 1;
    }
    return true;
}

@system
fn xhci_hid_input_map_emit_failure_marker() -> bool {
    let marker: [u8; 31] = [
        66,65,75,69,78,58,85,83,66,95,72,73,68,95,73,78,
        80,85,84,95,77,65,80,95,70,65,73,76,69,68,10
    ];
    let mut index: usize = 0;
    while index < 31 {
        if !x86_serial_write_byte(marker[index]) { return false; }
        index += 1;
    }
    return true;
}

