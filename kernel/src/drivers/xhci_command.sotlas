// Baken OS — produtor único do Command Ring e polling de completions xHCI.
//
// Esta camada só é ativada após o No-op inicial ter sido realmente completado.
// O primeiro Command TRB livre é o índice 1. O Event Ring não possui mais cursor
// privado aqui: Command Completion e futuros Transfer Events compartilham o
// consumidor único kernel::drivers::xhci_event_consumer.

module kernel::drivers::xhci_command;

import kernel::arch::x86_64::cpu::*;
import kernel::memory::direct_map::*;
import kernel::memory::active_page_tables::*;
import kernel::drivers::xhci_controller::*;
import kernel::drivers::xhci_runtime::*;
import kernel::drivers::xhci_program::*;
import kernel::drivers::xhci_start::*;
import kernel::drivers::xhci_ring::*;
import kernel::drivers::xhci_trb::*;
import kernel::drivers::xhci_event::*;
import kernel::drivers::xhci_event_consumer::*;

pub const XHCI_COMMAND_POLL_LIMIT: u64 = 10000000;
pub const XHCI_COMMAND_FIRST_FREE_INDEX: u32 = 1;

static mut XHCI_COMMAND_READY: bool = false;
static mut XHCI_COMMAND_ENQUEUE_INDEX: u32 = XHCI_COMMAND_FIRST_FREE_INDEX;
static mut XHCI_COMMAND_PRODUCER_CYCLE: bool = true;
static mut XHCI_COMMAND_LAST_SLOT_ID: u8 = 0;

@system
fn xhci_command_page_base(address: u64) -> u64 {
    return address & 0xFFFFFFFFFFFFF000;
}

@system
fn xhci_command_map_address(address: u64) -> bool {
    if address == 0 { return false; }
    return active_page_tables_map_mmio_identity_4k(xhci_command_page_base(address));
}

@system
fn xhci_command_slot_virtual(index: u32) -> *mut XhciTrb {
    if index >= XHCI_RUNTIME_COMMAND_TRBS { return null as *mut XhciTrb; }
    let base = direct_map_virtual_address(xhci_runtime_command_ring_physical());
    if base == 0 { return null as *mut XhciTrb; }
    let offset = (index as u64) * XHCI_TRB_SIZE;
    if offset / XHCI_TRB_SIZE != (index as u64) { return null as *mut XhciTrb; }
    return (base + offset) as *mut XhciTrb;
}

@system
fn xhci_command_slot_physical(index: u32) -> u64 {
    if index >= XHCI_RUNTIME_COMMAND_TRBS { return 0; }
    let base = xhci_runtime_command_ring_physical();
    if base == 0 { return 0; }
    let offset = (index as u64) * XHCI_TRB_SIZE;
    let address = base + offset;
    if address < base { return 0; }
    return address;
}

@system
fn xhci_command_publish_link(cycle: bool) -> bool {
    let link_index = XHCI_RUNTIME_COMMAND_TRBS - 1;
    let slot = xhci_command_slot_virtual(link_index);
    if slot == (null as *mut XhciTrb) { return false; }
    let link = xhci_trb_link(xhci_runtime_command_ring_physical(), true, cycle);
    unsafe { *slot = link; }
    let root = x86_read_cr3_raw();
    return root != 0;
}

@system
fn xhci_command_ring_doorbell0() -> bool {
    let mmio = xhci_controller_mmio_base();
    if mmio == 0 { return false; }
    let dboff = (x86_mmio_read32(mmio + XHCI_DBOFF) as u64) & 0xFFFFFFFC;
    let doorbell = mmio + dboff;
    if doorbell < mmio || !xhci_command_map_address(doorbell) { return false; }
    x86_mmio_write32(doorbell, 0);
    return true;
}

@system
fn xhci_command_advance_producer() -> bool {
    unsafe {
        let usable = XHCI_RUNTIME_COMMAND_TRBS - XHCI_RING_RESERVED_LINK_TRBS;
        if usable == 0 || XHCI_COMMAND_ENQUEUE_INDEX >= usable { return false; }
        XHCI_COMMAND_ENQUEUE_INDEX += 1;
        if XHCI_COMMAND_ENQUEUE_INDEX >= usable {
            XHCI_COMMAND_ENQUEUE_INDEX = 0;
            XHCI_COMMAND_PRODUCER_CYCLE = !XHCI_COMMAND_PRODUCER_CYCLE;
        }
    }
    return true;
}

@system
pub fn xhci_command_prepare_after_noop() -> bool {
    unsafe {
        XHCI_COMMAND_READY = false;
        XHCI_COMMAND_ENQUEUE_INDEX = XHCI_COMMAND_FIRST_FREE_INDEX;
        XHCI_COMMAND_PRODUCER_CYCLE = true;
        XHCI_COMMAND_LAST_SLOT_ID = 0;
    }
    if !xhci_start_is_ready() || !xhci_start_noop_completed() { return false; }
    if !xhci_runtime_is_ready() || !xhci_program_is_ready() { return false; }
    if xhci_runtime_command_ring_physical() == 0 || xhci_runtime_event_ring_physical() == 0 {
        return false;
    }
    if !xhci_event_consumer_prepare_after_noop() { return false; }
    unsafe { XHCI_COMMAND_READY = true; }
    return true;
}

@system
pub fn xhci_command_submit(command: XhciTrb) -> u64 {
    unsafe { XHCI_COMMAND_LAST_SLOT_ID = 0; }
    if !xhci_command_is_ready() { return 0; }
    unsafe {
        let usable = XHCI_RUNTIME_COMMAND_TRBS - XHCI_RING_RESERVED_LINK_TRBS;
        if XHCI_COMMAND_ENQUEUE_INDEX >= usable { return 0; }
        let index = XHCI_COMMAND_ENQUEUE_INDEX;
        let cycle = XHCI_COMMAND_PRODUCER_CYCLE;

        // Quando o comando ocupa o último TRB utilizável, o xHC seguirá o Link
        // TRB imediatamente; publique-o com o mesmo PCS antes do doorbell.
        if index == (usable - 1) && !xhci_command_publish_link(cycle) { return 0; }

        let slot = xhci_command_slot_virtual(index);
        let physical = xhci_command_slot_physical(index);
        if slot == (null as *mut XhciTrb) || physical == 0 { return 0; }
        let mut published = command;
        published.control = (published.control & ~XHCI_TRB_CYCLE_BIT) |
            xhci_trb_cycle_bits(cycle);
        *slot = published;

        // Compiler barrier + serializing privileged read. Não depende do syntax
        // node `quench`, que o bootstrap legado não reconhece.
        if x86_read_cr3_raw() == 0 { return 0; }
        if !xhci_command_ring_doorbell0() { return 0; }
        if !xhci_command_advance_producer() { return 0; }
        return physical;
    }
}

@system
pub fn xhci_command_wait_completion(command_physical: u64) -> bool {
    if !xhci_command_is_ready() || command_physical == 0 { return false; }
    let operational = xhci_controller_operational_base();
    if operational == 0 || !xhci_event_consumer_is_ready() { return false; }

    let mut spins: u64 = 0;
    while spins < XHCI_COMMAND_POLL_LIMIT {
        let status = x86_mmio_read32(operational + XHCI_OP_USBSTS);
        if (status & XHCI_USBSTS_HOST_CONTROLLER_ERROR) != 0 { return false; }

        let event = xhci_event_consumer_peek();
        if event != (null as *const XhciTrb) {
            if xhci_event_type(event) != XHCI_TRB_TYPE_COMMAND_COMPLETION_EVENT {
                return false;
            }
            if !xhci_event_success(event) { return false; }
            if xhci_command_completion_trb_pointer(event) != command_physical {
                return false;
            }
            unsafe { XHCI_COMMAND_LAST_SLOT_ID = xhci_event_slot_id(event); }
            if !xhci_event_consumer_consume() {
                unsafe { XHCI_COMMAND_LAST_SLOT_ID = 0; }
                return false;
            }
            return true;
        }
        spins += 1;
    }
    return false;
}

@system
pub fn xhci_command_is_ready() -> bool { unsafe { return XHCI_COMMAND_READY; } }

@system
pub fn xhci_command_enqueue_index() -> u32 { unsafe { return XHCI_COMMAND_ENQUEUE_INDEX; } }

@system
pub fn xhci_command_producer_cycle() -> bool { unsafe { return XHCI_COMMAND_PRODUCER_CYCLE; } }

@system
pub fn xhci_command_event_dequeue_index() -> u32 {
    return xhci_event_consumer_index();
}

@system
pub fn xhci_command_event_consumer_cycle() -> bool {
    return xhci_event_consumer_cycle();
}

@system
pub fn xhci_command_last_slot_id() -> u8 { unsafe { return XHCI_COMMAND_LAST_SLOT_ID; } }
