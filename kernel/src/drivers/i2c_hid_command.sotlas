// Baken OS — I2C-HID-5: Protocolo de Comandos e Ciclo de Vida HID-over-I2C.
//
// Implementa os comandos obrigatórios da especificação Microsoft HID-over-I2C:
// RESET (0x01), SET_POWER (0x08), GET_REPORT (0x02) e SET_REPORT (0x03).

module kernel::drivers::i2c_hid_command;

import kernel::arch::x86_64::cpu::*;
import kernel::drivers::i2c_core::*;
import kernel::drivers::i2c_device::*;

pub const I2C_HID_CMD_RESET: u8 = 0x01;
pub const I2C_HID_CMD_GET_REPORT: u8 = 0x02;
pub const I2C_HID_CMD_SET_REPORT: u8 = 0x03;
pub const I2C_HID_CMD_GET_IDLE: u8 = 0x04;
pub const I2C_HID_CMD_SET_IDLE: u8 = 0x05;
pub const I2C_HID_CMD_GET_PROTOCOL: u8 = 0x06;
pub const I2C_HID_CMD_SET_PROTOCOL: u8 = 0x07;
pub const I2C_HID_CMD_SET_POWER: u8 = 0x08;

pub const I2C_HID_POWER_ON: u8 = 0x00;
pub const I2C_HID_POWER_SLEEP: u8 = 0x01;

pub const I2C_HID_REPORT_TYPE_OTHER: u8 = 0x00;
pub const I2C_HID_REPORT_TYPE_INPUT: u8 = 0x01;
pub const I2C_HID_REPORT_TYPE_OUTPUT: u8 = 0x02;
pub const I2C_HID_REPORT_TYPE_FEATURE: u8 = 0x03;

pub const I2C_HID_SET_REPORT_MAX_DATA: usize = 256;
pub const I2C_HID_SET_REPORT_BUFFER: usize = 268;

@system
pub fn i2c_hid_command_reset(device_id: u32,
                             generation: u32,
                             command_register: u16) -> u8 {
    if command_register == 0 { return I2C_STATUS_INVALID; }

    let mut payload: [u8; 4] = [0; 4];
    payload[0] = (command_register & 0xFF) as u8;
    payload[1] = ((command_register >> 8) & 0xFF) as u8;
    payload[2] = 0x00;
    payload[3] = I2C_HID_CMD_RESET;

    return i2c_device_write(device_id, generation, &payload[0], 4);
}

@system
pub fn i2c_hid_command_set_power(device_id: u32,
                                 generation: u32,
                                 command_register: u16,
                                 power_state: u8) -> u8 {
    if command_register == 0 { return I2C_STATUS_INVALID; }
    if power_state != I2C_HID_POWER_ON && power_state != I2C_HID_POWER_SLEEP {
        return I2C_STATUS_INVALID;
    }

    let mut payload: [u8; 4] = [0; 4];
    payload[0] = (command_register & 0xFF) as u8;
    payload[1] = ((command_register >> 8) & 0xFF) as u8;
    payload[2] = power_state & 0x0F;
    payload[3] = I2C_HID_CMD_SET_POWER;

    return i2c_device_write(device_id, generation, &payload[0], 4);
}

@system
fn i2c_hid_command_encode_report(command_register: u16,
                                 report_type: u8,
                                 report_id: u8,
                                 opcode: u8,
                                 out_buf: *mut u8) -> usize {
    if out_buf == (null as *mut u8) { return 0; }
    let r_type = report_type & 0x03;
    unsafe {
        out_buf[0] = (command_register & 0xFF) as u8;
        out_buf[1] = ((command_register >> 8) & 0xFF) as u8;
        if report_id < 15 {
            out_buf[2] = (r_type << 4) | (report_id & 0x0F);
            out_buf[3] = opcode;
            return 4;
        }
        out_buf[2] = (r_type << 4) | 0x0F;
        out_buf[3] = opcode;
        out_buf[4] = report_id;
    }
    return 5;
}

@system
pub fn i2c_hid_command_get_report(device_id: u32,
                                  generation: u32,
                                  command_register: u16,
                                  data_register: u16,
                                  report_type: u8,
                                  report_id: u8,
                                  out_buf: *mut u8,
                                  buf_capacity: usize,
                                  out_len: *mut usize) -> u8 {
    if command_register == 0 || out_buf == (null as *mut u8) ||
       out_len == (null as *mut usize) || buf_capacity < 2 {
        return I2C_STATUS_INVALID;
    }
    unsafe { *out_len = 0; }

    // HID-over-I2C: CommandRegister + command (+ optional extended Report ID)
    // + DataRegister form ONE write phase followed by the repeated-start read.
    let mut cmd: [u8; 7] = [0; 7];
    let mut cmd_len = i2c_hid_command_encode_report(
        command_register, report_type, report_id, I2C_HID_CMD_GET_REPORT, &mut cmd[0]
    );
    if cmd_len == 0 { return I2C_STATUS_INVALID; }
    cmd[cmd_len] = (data_register & 0xFF) as u8;
    cmd[cmd_len + 1] = ((data_register >> 8) & 0xFF) as u8;
    cmd_len += 2;

    let read_status = i2c_device_write_read(
        device_id, generation, &cmd[0], cmd_len, out_buf, buf_capacity
    );
    if read_status != I2C_STATUS_OK { return read_status; }

    let total_len = unsafe {
        (out_buf[0] as usize) | ((out_buf[1] as usize) << 8)
    };
    if total_len < 2 || total_len > buf_capacity {
        return I2C_STATUS_INVALID;
    }
    unsafe { *out_len = total_len - 2; }
    return I2C_STATUS_OK;
}

@system
pub fn i2c_hid_command_set_report(device_id: u32,
                                  generation: u32,
                                  command_register: u16,
                                  data_register: u16,
                                  report_type: u8,
                                  report_id: u8,
                                  report_data: *const u8,
                                  report_length: usize) -> u8 {
    if command_register == 0 ||
       (report_length > 0 && report_data == (null as *const u8)) ||
       report_length > I2C_HID_SET_REPORT_MAX_DATA {
        return I2C_STATUS_INVALID;
    }

    // SET_REPORT is one write transaction:
    // CommandRegister, command, optional extended report id, DataRegister,
    // report-size LE16, optional report-id byte, then report payload.
    let mut send_buf: [u8; I2C_HID_SET_REPORT_BUFFER] = [0; I2C_HID_SET_REPORT_BUFFER];
    let mut offset = i2c_hid_command_encode_report(
        command_register, report_type, report_id, I2C_HID_CMD_SET_REPORT, &mut send_buf[0]
    );
    if offset == 0 { return I2C_STATUS_INVALID; }

    send_buf[offset] = (data_register & 0xFF) as u8;
    send_buf[offset + 1] = ((data_register >> 8) & 0xFF) as u8;
    offset += 2;

    let mut report_id_bytes: usize = 0;
    if report_id != 0 { report_id_bytes = 1; }
    let total_wire_len = 2 + report_id_bytes + report_length;
    send_buf[offset] = (total_wire_len & 0xFF) as u8;
    send_buf[offset + 1] = ((total_wire_len >> 8) & 0xFF) as u8;
    offset += 2;

    if report_id != 0 {
        send_buf[offset] = report_id;
        offset += 1;
    }

    let mut i: usize = 0;
    while i < report_length {
        unsafe { send_buf[offset + i] = report_data[i]; }
        i += 1;
    }
    offset += report_length;

    return i2c_device_write(device_id, generation, &send_buf[0], offset);
}
