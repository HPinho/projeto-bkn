// Baken OS — contrato de rings xHCI sobre buffers DMA reais.
//
// Define a unidade TRB de 16 bytes, valida um buffer já fornecido pelo
// allocator DMA e mantém somente a semântica lógica do Producer Cycle State.
// Não aloca memória, não escreve TRBs/doorbells e não toca MMIO.

module kernel::drivers::xhci_ring;

import kernel::memory::dma::*;

pub const XHCI_TRB_SIZE: u64 = 16;
pub const XHCI_RING_ALIGNMENT: u64 = 64;
pub const XHCI_RING_MIN_TRBS: u32 = 16;
pub const XHCI_RING_MAX_TRBS: u32 = 4096;
pub const XHCI_RING_RESERVED_LINK_TRBS: u32 = 1;

pub struct XhciTrb {
    pub parameter: u64;
    pub status: u32;
    pub control: u32;
}

pub struct XhciRing {
    pub virtual_base: *mut XhciTrb;
    pub physical_base: u64;
    pub trb_count: u32;
    pub enqueue_index: u32;
    pub cycle_state: bool;
    pub valid: bool;
}

@system
pub fn xhci_ring_invalid() -> XhciRing {
    return XhciRing {
        virtual_base: null as *mut XhciTrb,
        physical_base: 0,
        trb_count: 0,
        enqueue_index: 0,
        cycle_state: true,
        valid: false
    };
}

@system
pub fn xhci_ring_bind(buffer: DmaBuffer, trb_count: u32) -> XhciRing {
    if !buffer.valid { return xhci_ring_invalid(); }
    if buffer.virtual_address == (null as *mut u8) { return xhci_ring_invalid(); }
    if buffer.physical_address == 0 { return xhci_ring_invalid(); }
    if trb_count < XHCI_RING_MIN_TRBS || trb_count > XHCI_RING_MAX_TRBS {
        return xhci_ring_invalid();
    }

    let required = (trb_count as u64) * XHCI_TRB_SIZE;
    if buffer.size < required { return xhci_ring_invalid(); }
    if (buffer.physical_address & (XHCI_RING_ALIGNMENT - 1)) != 0 {
        return xhci_ring_invalid();
    }

    return XhciRing {
        virtual_base: buffer.virtual_address as *mut XhciTrb,
        physical_base: buffer.physical_address,
        trb_count: trb_count,
        enqueue_index: 0,
        cycle_state: true,
        valid: true
    };
}

@system
pub fn xhci_ring_is_ready(ring: *const XhciRing) -> bool {
    if ring == (null as *const XhciRing) { return false; }
    unsafe {
        return (*ring).valid &&
            (*ring).virtual_base != (null as *mut XhciTrb) &&
            (*ring).physical_base != 0 &&
            (*ring).trb_count >= XHCI_RING_MIN_TRBS;
    }
}

@system
pub fn xhci_ring_usable_trbs(ring: *const XhciRing) -> u32 {
    if !xhci_ring_is_ready(ring) { return 0; }
    unsafe {
        if (*ring).trb_count <= XHCI_RING_RESERVED_LINK_TRBS { return 0; }
        return (*ring).trb_count - XHCI_RING_RESERVED_LINK_TRBS;
    }
}

// Avança apenas o cursor lógico. O último slot físico é reservado ao Link TRB.
// Ao segui-lo, um ring de um segmento retorna ao início e alterna o Producer
// Cycle State. Esta função não escreve nenhum TRB na memória.
@system
pub fn xhci_ring_advance_cursor(ring: *mut XhciRing) -> bool {
    if ring == (null as *mut XhciRing) { return false; }
    if !xhci_ring_is_ready(ring as *const XhciRing) { return false; }

    unsafe {
        let usable = (*ring).trb_count - XHCI_RING_RESERVED_LINK_TRBS;
        if usable == 0 { return false; }

        (*ring).enqueue_index += 1;
        if (*ring).enqueue_index >= usable {
            (*ring).enqueue_index = 0;
            (*ring).cycle_state = !(*ring).cycle_state;
        }
        return true;
    }
}
