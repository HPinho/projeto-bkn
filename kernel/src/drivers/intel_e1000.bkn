// Baken OS - Driver Nativo Intel PRO/1000 Gigabit & I219/I225 PCIe Ethernet (@system)
// Arquitetura MMIO de Alta Performance com Suporte a Jumbo Frames e Scatter-Gather DMA

module kernel::drivers::intel_e1000;

import kernel::pci::*;
import kernel::pmm::*;

pub const INTEL_VENDOR_ID: u16    = 0x8086;
pub const INTEL_E1000_82540: u16  = 0x100E; // QEMU / VirtualBox Default
pub const INTEL_E1000E_82574L: u16= 0x10D3;
pub const INTEL_I219_V: u16       = 0x15B8;
pub const INTEL_I225_V: u16       = 0x15F3; // 2.5GbE

// Registradores MMIO Intel e1000
pub const REG_CTRL: u32    = 0x0000; // Device Control
pub const REG_STATUS: u32  = 0x0008; // Device Status
pub const REG_EECD: u32    = 0x0010; // EEPROM Control
pub const REG_ICR: u32     = 0x00C0; // Interrupt Cause Read
pub const REG_IMS: u32     = 0x00D0; // Interrupt Mask Set
pub const REG_RCTL: u32    = 0x0100; // Receive Control
pub const REG_RDBAL: u32   = 0x2800; // RX Descriptor Base Low
pub const REG_RDBAH: u32   = 0x2804; // RX Descriptor Base High
pub const REG_RDLEN: u32   = 0x2808; // RX Descriptor Length
pub const REG_RDH: u32     = 0x2810; // RX Descriptor Head
pub const REG_RDT: u32     = 0x2818; // RX Descriptor Tail
pub const REG_TCTL: u32    = 0x0400; // Transmit Control
pub const REG_TDBAL: u32   = 0x3800; // TX Descriptor Base Low
pub const REG_TDBAH: u32   = 0x3804; // TX Descriptor Base High
pub const REG_TDLEN: u32   = 0x3808; // TX Descriptor Length
pub const REG_TDH: u32     = 0x3810; // TX Descriptor Head
pub const REG_TDT: u32     = 0x3818; // TX Descriptor Tail

pub struct E1000RxDesc {
    pub buffer_addr: u64,
    pub length: u16,
    pub checksum: u16,
    pub status: u8,
    pub errors: u8,
    pub special: u16,
}

pub struct E1000TxDesc {
    pub buffer_addr: u64,
    pub length: u16,
    pub cso: u8,
    pub cmd: u8,
    pub status: u8,
    pub css: u8,
    pub special: u16,
}

pub struct IntelE1000Device {
    pub mmio_base: u64,
    pub pci_bus: u8,
    pub pci_slot: u8,
    pub pci_func: u8,
    pub mac_address: [u8; 6],
    pub is_online: bool,
    pub rx_ring_phys: u64,
    pub tx_ring_phys: u64,
    pub rx_cur: usize,
    pub tx_cur: usize,
}

static mut INTEL_NIC: IntelE1000Device = IntelE1000Device {
    mmio_base: 0,
    pci_bus: 0,
    pci_slot: 0,
    pci_func: 0,
    mac_address: [0x52, 0x54, 0x00, 0x12, 0x34, 0x56],
    is_online: false,
    rx_ring_phys: 0,
    tx_ring_phys: 0,
    rx_cur: 0,
    tx_cur: 0,
};

@system
pub fn intel_e1000_init(pci_bus: u8, pci_slot: u8, pci_func: u8, bar0_phys: u64) -> bool {
    unsafe {
        INTEL_NIC.pci_bus = pci_bus;
        INTEL_NIC.pci_slot = pci_slot;
        INTEL_NIC.pci_func = pci_func;
        INTEL_NIC.mmio_base = bar0_phys;

        // 1. Reset Global do Controlador
        let ctrl_ptr = (bar0_phys + REG_CTRL as u64) as *mut u32;
        *ctrl_ptr |= (1 << 26); // Device Reset (RST)

        // 2. Aloca Memória Física para as Filas RX e TX DMA
        let rx_mem = pmm_alloc_pages(1);
        let tx_mem = pmm_alloc_pages(1);
        INTEL_NIC.rx_ring_phys = rx_mem as u64;
        INTEL_NIC.tx_ring_phys = tx_mem as u64;

        // 3. Configura Descritores de Recepção (RX)
        *((bar0_phys + REG_RDBAL as u64) as *mut u32) = (rx_mem as u64 & 0xFFFFFFFF) as u32;
        *((bar0_phys + REG_RDBAH as u64) as *mut u32) = ((rx_mem as u64 >> 32) & 0xFFFFFFFF) as u32;
        *((bar0_phys + REG_RDLEN as u64) as *mut u32) = (32 * 16); // 32 Descritores * 16 bytes
        *((bar0_phys + REG_RDH as u64) as *mut u32) = 0;
        *((bar0_phys + REG_RDT as u64) as *mut u32) = 31;

        // 4. Configura Descritores de Transmissão (TX)
        *((bar0_phys + REG_TDBAL as u64) as *mut u32) = (tx_mem as u64 & 0xFFFFFFFF) as u32;
        *((bar0_phys + REG_TDBAH as u64) as *mut u32) = ((tx_mem as u64 >> 32) & 0xFFFFFFFF) as u32;
        *((bar0_phys + REG_TDLEN as u64) as *mut u32) = (32 * 16);
        *((bar0_phys + REG_TDH as u64) as *mut u32) = 0;
        *((bar0_phys + REG_TDT as u64) as *mut u32) = 0;

        // 5. Habilita RCTL (RX Enable, Broadcast, 2048-byte buffer)
        *((bar0_phys + REG_RCTL as u64) as *mut u32) = (1 << 1) | (1 << 15) | (0 << 16);
        // Habilita TCTL (TX Enable, Pad Short Packets, Collision Threshold 15)
        *((bar0_phys + REG_TCTL as u64) as *mut u32) = (1 << 1) | (1 << 3) | (0x0F << 4);

        INTEL_NIC.is_online = true;
        return true;
    }
}
