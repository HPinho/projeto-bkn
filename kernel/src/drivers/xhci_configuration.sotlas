// Baken OS — HID-4c.3/HID-4d.4a1: Configuration Descriptor por Slot ID.
//
// O header de 9 bytes usa DMA temporário apenas para descobrir wTotalLength e
// bConfigurationValue. HID-4d.3a devolve esse buffer ao PMM após o parse.
// HID-4d.4a1 adiciona teardown exact-epoch do Configuration Descriptor completo,
// mantendo um tombstone que impede recriação do DMA no mesmo epoch.
//
// Hardening pós-HID-4d: qualquer DMA que já possa ter sido submetido ao EP0 é
// publicado primeiro como owner per-slot. Submit/wait ambíguos mantêm o owner
// em quarentena; somente completion terminal ou Disable Slot confirmado podem
// autorizar unshare/release. Epoch novo nunca sobrescreve owner antigo válido.

module kernel::drivers::xhci_configuration;

import kernel::memory::dma::*;
import kernel::drivers::xhci_context::*;
import kernel::drivers::xhci_address::*;
import kernel::drivers::xhci_ep0::*;
import kernel::drivers::xhci_trb::*;
import kernel::drivers::xhci_transfer::*;
import kernel::drivers::xhci_descriptor::*;
import kernel::drivers::xhci_device_table::*;

pub const USB_DESCRIPTOR_TYPE_CONFIGURATION: u8 = 2;
pub const USB_DESCRIPTOR_TYPE_INTERFACE: u8 = 4;
pub const USB_DESCRIPTOR_TYPE_ENDPOINT: u8 = 5;
pub const USB_DESCRIPTOR_TYPE_HID: u8 = 0x21;
pub const USB_DESCRIPTOR_TYPE_REPORT: u8 = 0x22;
pub const USB_CONFIGURATION_HEADER_LENGTH: u16 = 9;
pub const USB_INTERFACE_DESCRIPTOR_LENGTH: u8 = 9;
pub const USB_ENDPOINT_DESCRIPTOR_LENGTH: u8 = 7;
pub const USB_CLASS_HID: u8 = 3;
pub const USB_HID_SUBCLASS_BOOT: u8 = 1;
pub const USB_HID_PROTOCOL_KEYBOARD: u8 = 1;
pub const USB_HID_PROTOCOL_MOUSE: u8 = 2;
pub const USB_ENDPOINT_DIRECTION_IN: u8 = 0x80;
pub const USB_ENDPOINT_TRANSFER_TYPE_MASK: u8 = 0x03;
pub const USB_ENDPOINT_TRANSFER_INTERRUPT: u8 = 0x03;
pub const XHCI_CONFIGURATION_DMA_SIZE: u64 = 4096;
pub const XHCI_CONFIGURATION_SLOT_CAPACITY: usize = XHCI_DEVICE_SLOT_CAPACITY;

pub struct XhciConfigurationState {
    pub epoch: u32;
    pub header_ready: bool;
    pub header_total_length: u16;
    pub header_value: u8;
    pub full_ready: bool;
    pub full_total_length: u16;
    pub full_value: u8;
    pub ready: bool;
    pub value: u8;
    pub total_length: u16;
    pub hid_interface_number: u8;
    pub hid_protocol: u8;
    pub hid_endpoint_address: u8;
    pub hid_endpoint_max_packet: u16;
    pub hid_endpoint_interval: u8;
    pub hid_report_descriptor_length: u16;
    pub buffer: DmaBuffer;
}

static mut XHCI_CONFIGURATION_STATES: [XhciConfigurationState; XHCI_CONFIGURATION_SLOT_CAPACITY] = [
    XhciConfigurationState {
        epoch: 0,
        header_ready: false,
        header_total_length: 0,
        header_value: 0,
        full_ready: false,
        full_total_length: 0,
        full_value: 0,
        ready: false,
        value: 0,
        total_length: 0,
        hid_interface_number: 0,
        hid_protocol: 0,
        hid_endpoint_address: 0,
        hid_endpoint_max_packet: 0,
        hid_endpoint_interval: 0,
        hid_report_descriptor_length: 0,
        buffer: DmaBuffer {
            virtual_address: null as *mut u8,
            physical_address: 0,
            size: 0,
            alignment: 0,
            owner: DMA_OWNER_CPU,
            fence: 0,
            valid: false
        }
    };
    XHCI_CONFIGURATION_SLOT_CAPACITY
];
static mut XHCI_CONFIGURATION_RELEASE_STARTED_EPOCHS:
    [u32; XHCI_CONFIGURATION_SLOT_CAPACITY] = [0; XHCI_CONFIGURATION_SLOT_CAPACITY];
static mut XHCI_CONFIGURATION_RELEASED_EPOCHS:
    [u32; XHCI_CONFIGURATION_SLOT_CAPACITY] = [0; XHCI_CONFIGURATION_SLOT_CAPACITY];

@system
fn xhci_configuration_index(slot_id: u8) -> usize {
    if slot_id == 0 { return XHCI_CONFIGURATION_SLOT_CAPACITY; }
    return slot_id as usize;
}

@system
fn xhci_configuration_reset_state(slot_id: u8, epoch: u32) -> bool {
    let index = xhci_configuration_index(slot_id);
    if index >= XHCI_CONFIGURATION_SLOT_CAPACITY || epoch == 0 { return false; }
    unsafe {
        // Nunca apagar a única referência de software para DMA ainda válido.
        if XHCI_CONFIGURATION_STATES[index].buffer.valid { return false; }
        XHCI_CONFIGURATION_STATES[index].epoch = epoch;
        XHCI_CONFIGURATION_STATES[index].header_ready = false;
        XHCI_CONFIGURATION_STATES[index].header_total_length = 0;
        XHCI_CONFIGURATION_STATES[index].header_value = 0;
        XHCI_CONFIGURATION_STATES[index].full_ready = false;
        XHCI_CONFIGURATION_STATES[index].full_total_length = 0;
        XHCI_CONFIGURATION_STATES[index].full_value = 0;
        XHCI_CONFIGURATION_STATES[index].ready = false;
        XHCI_CONFIGURATION_STATES[index].value = 0;
        XHCI_CONFIGURATION_STATES[index].total_length = 0;
        XHCI_CONFIGURATION_STATES[index].hid_interface_number = 0;
        XHCI_CONFIGURATION_STATES[index].hid_protocol = 0;
        XHCI_CONFIGURATION_STATES[index].hid_endpoint_address = 0;
        XHCI_CONFIGURATION_STATES[index].hid_endpoint_max_packet = 0;
        XHCI_CONFIGURATION_STATES[index].hid_endpoint_interval = 0;
        XHCI_CONFIGURATION_STATES[index].hid_report_descriptor_length = 0;
        XHCI_CONFIGURATION_STATES[index].buffer = dma_invalid_buffer();
        XHCI_CONFIGURATION_RELEASE_STARTED_EPOCHS[index] = 0;
        XHCI_CONFIGURATION_RELEASED_EPOCHS[index] = 0;
    }
    return true;
}

@system
fn xhci_configuration_prepare_state(slot_id: u8) -> bool {
    let index = xhci_configuration_index(slot_id);
    if index >= XHCI_CONFIGURATION_SLOT_CAPACITY ||
       !xhci_device_table_slot_is_valid(slot_id) ||
       !xhci_address_is_ready_for(slot_id) ||
       !xhci_context_is_ready_for(slot_id) ||
       !xhci_ep0_is_ready_for(slot_id) ||
       !xhci_device_descriptor_is_ready_for(slot_id) {
        return false;
    }
    let epoch = xhci_device_table_slot_epoch(slot_id);
    if epoch == 0 { return false; }
    unsafe {
        if XHCI_CONFIGURATION_STATES[index].epoch != epoch {
            // Um Slot ID não pode trocar de epoch abandonando um owner DMA antigo.
            if XHCI_CONFIGURATION_STATES[index].buffer.valid { return false; }
            return xhci_configuration_reset_state(slot_id, epoch);
        }
        if XHCI_CONFIGURATION_RELEASED_EPOCHS[index] == epoch {
            return false;
        }
    }
    return true;
}

@system
fn xhci_configuration_state_is_current(slot_id: u8) -> bool {
    let index = xhci_configuration_index(slot_id);
    if index >= XHCI_CONFIGURATION_SLOT_CAPACITY ||
       !xhci_device_table_slot_is_valid(slot_id) {
        return false;
    }
    let epoch = xhci_device_table_slot_epoch(slot_id);
    unsafe {
        return epoch != 0 && XHCI_CONFIGURATION_STATES[index].epoch == epoch;
    }
}

@system
fn xhci_configuration_epoch_matches(slot_id: u8, epoch: u32) -> bool {
    let index = xhci_configuration_index(slot_id);
    if index >= XHCI_CONFIGURATION_SLOT_CAPACITY || slot_id == 0 || epoch == 0 ||
       !xhci_device_table_slot_is_valid(slot_id) ||
       xhci_device_table_slot_epoch(slot_id) != epoch ||
       xhci_device_table_state(slot_id) != XHCI_DEVICE_STATE_DETACH_PENDING {
        return false;
    }
    unsafe { return XHCI_CONFIGURATION_STATES[index].epoch == epoch; }
}

@system
fn xhci_configuration_current_buffer_epoch_matches(slot_id: u8, epoch: u32) -> bool {
    let index = xhci_configuration_index(slot_id);
    if index >= XHCI_CONFIGURATION_SLOT_CAPACITY || slot_id == 0 || epoch == 0 ||
       !xhci_device_table_slot_is_valid(slot_id) ||
       xhci_device_table_slot_epoch(slot_id) != epoch {
        return false;
    }
    unsafe { return XHCI_CONFIGURATION_STATES[index].epoch == epoch; }
}

@system
fn xhci_configuration_failed_epoch_matches(slot_id: u8, epoch: u32) -> bool {
    let index = xhci_configuration_index(slot_id);
    if index >= XHCI_CONFIGURATION_SLOT_CAPACITY || slot_id == 0 || epoch == 0 ||
       !xhci_device_table_slot_is_valid(slot_id) ||
       xhci_device_table_slot_epoch(slot_id) != epoch ||
       xhci_device_table_state(slot_id) != XHCI_DEVICE_STATE_FAILED {
        return false;
    }
    unsafe { return XHCI_CONFIGURATION_STATES[index].epoch == epoch; }
}

@system
fn xhci_configuration_invalidate_after_header(slot_id: u8) -> bool {
    let index = xhci_configuration_index(slot_id);
    if index >= XHCI_CONFIGURATION_SLOT_CAPACITY { return false; }
    unsafe {
        // Retry não pode apagar owner publicado por um TD ambíguo anterior.
        if XHCI_CONFIGURATION_STATES[index].buffer.valid { return false; }
        XHCI_CONFIGURATION_STATES[index].full_ready = false;
        XHCI_CONFIGURATION_STATES[index].full_total_length = 0;
        XHCI_CONFIGURATION_STATES[index].full_value = 0;
        XHCI_CONFIGURATION_STATES[index].ready = false;
        XHCI_CONFIGURATION_STATES[index].value = 0;
        XHCI_CONFIGURATION_STATES[index].total_length = 0;
        XHCI_CONFIGURATION_STATES[index].hid_interface_number = 0;
        XHCI_CONFIGURATION_STATES[index].hid_protocol = 0;
        XHCI_CONFIGURATION_STATES[index].hid_endpoint_address = 0;
        XHCI_CONFIGURATION_STATES[index].hid_endpoint_max_packet = 0;
        XHCI_CONFIGURATION_STATES[index].hid_endpoint_interval = 0;
        XHCI_CONFIGURATION_STATES[index].hid_report_descriptor_length = 0;
        XHCI_CONFIGURATION_STATES[index].buffer = dma_invalid_buffer();
    }
    return true;
}

@system
fn xhci_configuration_invalidate_after_full(slot_id: u8) -> bool {
    let index = xhci_configuration_index(slot_id);
    if index >= XHCI_CONFIGURATION_SLOT_CAPACITY { return false; }
    unsafe {
        XHCI_CONFIGURATION_STATES[index].ready = false;
        XHCI_CONFIGURATION_STATES[index].value = 0;
        XHCI_CONFIGURATION_STATES[index].total_length = 0;
        XHCI_CONFIGURATION_STATES[index].hid_interface_number = 0;
        XHCI_CONFIGURATION_STATES[index].hid_protocol = 0;
        XHCI_CONFIGURATION_STATES[index].hid_endpoint_address = 0;
        XHCI_CONFIGURATION_STATES[index].hid_endpoint_max_packet = 0;
        XHCI_CONFIGURATION_STATES[index].hid_endpoint_interval = 0;
        XHCI_CONFIGURATION_STATES[index].hid_report_descriptor_length = 0;
    }
    return true;
}

@system
fn xhci_configuration_read8(base: *const u8, offset: u64) -> u8 {
    if base == (null as *const u8) { return 0; }
    unsafe { return *(((base as usize) + (offset as usize)) as *const u8); }
}

@system
fn xhci_configuration_read16(base: *const u8, offset: u64) -> u16 {
    let lo = xhci_configuration_read8(base, offset) as u16;
    let hi = xhci_configuration_read8(base, offset + 1) as u16;
    return lo | (hi << 8);
}

@system
fn xhci_configuration_zero(base: *mut u8, size: u64) -> bool {
    if base == (null as *mut u8) || size == 0 { return false; }
    unsafe {
        let mut i: u64 = 0;
        while i < size {
            *(((base as usize) + (i as usize)) as *mut u8) = 0;
            i += 1;
        }
    }
    return true;
}

// Somente candidatos que ainda não foram publicados como owner per-slot.
@system
fn xhci_configuration_release_temporary(buffer: *mut DmaBuffer) -> bool {
    if buffer == (null as *mut DmaBuffer) { return false; }
    unsafe {
        if !(*buffer).valid { return true; }
    }
    if dma_buffer_shared(buffer as *const DmaBuffer) {
        if !dma_unshare_from_device(buffer) { return false; }
    }
    if !dma_buffer_cpu_owned(buffer as *const DmaBuffer) { return false; }
    return dma_release(buffer);
}

// Owner canônico depois da publicação. O caller só pode invocar este helper
// depois de uma completion terminal já consumida ou de Disable Slot confirmado.
@system
fn xhci_configuration_release_current_buffer_for_epoch(slot_id: u8,
                                                       epoch: u32) -> bool {
    if !xhci_configuration_current_buffer_epoch_matches(slot_id, epoch) { return false; }
    let index = xhci_configuration_index(slot_id);
    if index >= XHCI_CONFIGURATION_SLOT_CAPACITY { return false; }
    unsafe {
        if !XHCI_CONFIGURATION_STATES[index].buffer.valid { return true; }
    }

    let mut shared = false;
    unsafe { shared = dma_buffer_shared(&XHCI_CONFIGURATION_STATES[index].buffer); }
    if shared {
        unsafe {
            if !dma_unshare_from_device(&mut XHCI_CONFIGURATION_STATES[index].buffer) {
                return false;
            }
        }
        if !xhci_configuration_current_buffer_epoch_matches(slot_id, epoch) { return false; }
    }

    unsafe {
        if !dma_buffer_cpu_owned(&XHCI_CONFIGURATION_STATES[index].buffer) {
            return false;
        }
    }
    if !xhci_configuration_current_buffer_epoch_matches(slot_id, epoch) { return false; }
    unsafe {
        if !dma_release(&mut XHCI_CONFIGURATION_STATES[index].buffer) {
            return false;
        }
    }
    if !xhci_configuration_current_buffer_epoch_matches(slot_id, epoch) { return false; }
    unsafe { return !XHCI_CONFIGURATION_STATES[index].buffer.valid; }
}

@system
fn xhci_configuration_publish_candidate_buffer(slot_id: u8,
                                               epoch: u32,
                                               buffer: DmaBuffer) -> bool {
    if !xhci_configuration_current_buffer_epoch_matches(slot_id, epoch) ||
       !buffer.valid || !dma_buffer_shared(&buffer) {
        return false;
    }
    let index = xhci_configuration_index(slot_id);
    if index >= XHCI_CONFIGURATION_SLOT_CAPACITY { return false; }
    unsafe {
        if XHCI_CONFIGURATION_STATES[index].buffer.valid { return false; }
        XHCI_CONFIGURATION_STATES[index].buffer = buffer;
    }
    // Depois da atribuição o owner canônico é o estado per-slot. Não retornar
    // false pós-publicação: isso faria o caller liberar uma cópia do mesmo DMA.
    return true;
}

@system
fn xhci_configuration_fetch_for_slot(slot_id: u8,
                                     buffer: *mut DmaBuffer,
                                     length: u16) -> bool {
    if buffer == (null as *mut DmaBuffer) || length == 0 ||
       !xhci_configuration_prepare_state(slot_id) {
        return false;
    }
    let epoch = xhci_device_table_slot_epoch(slot_id);
    let index = xhci_configuration_index(slot_id);
    if epoch == 0 || index >= XHCI_CONFIGURATION_SLOT_CAPACITY ||
       !xhci_configuration_current_buffer_epoch_matches(slot_id, epoch) {
        return false;
    }
    unsafe {
        if !(*buffer).valid || (*buffer).physical_address == 0 ||
           (*buffer).virtual_address == (null as *mut u8) { return false; }
        if (length as u64) > (*buffer).size { return false; }
        if !XHCI_CONFIGURATION_STATES[index].buffer.valid ||
           XHCI_CONFIGURATION_STATES[index].buffer.physical_address != (*buffer).physical_address ||
           !dma_buffer_shared(&XHCI_CONFIGURATION_STATES[index].buffer) {
            return false;
        }
    }

    let setup = xhci_trb_setup_stage(
        USB_REQUEST_TYPE_DEVICE_TO_HOST_STANDARD_DEVICE,
        USB_REQUEST_GET_DESCRIPTOR,
        0x0200,
        0,
        length,
        XHCI_SETUP_TRT_IN_DATA,
        xhci_ep0_producer_cycle_for(slot_id)
    );
    unsafe {
        let data = xhci_trb_data_stage(
            (*buffer).physical_address,
            length as u32,
            0,
            true,
            false,
            xhci_ep0_producer_cycle_for(slot_id)
        );
        let status = xhci_trb_status_stage(
            false,
            true,
            xhci_ep0_producer_cycle_for(slot_id)
        );
        let status_physical = xhci_ep0_submit_control_td_for_slot(
            slot_id, setup, data, status, true
        );
        // Falhas daqui são deliberadamente ambíguas: o owner continua no estado
        // per-slot até que o recovery confirme Disable Slot.
        if status_physical == 0 { return false; }
        if !xhci_transfer_wait_ep0_completion(slot_id, status_physical) { return false; }
        let transfer_complete = xhci_transfer_last_residual_length_for(slot_id) == 0;
        if !transfer_complete {
            // A completion foi consumida: residual != 0 é uma fronteira terminal.
            xhci_configuration_release_current_buffer_for_epoch(slot_id, epoch);
            return false;
        }
        return true;
    }
}

@system
pub fn xhci_probe_configuration_header_for_slot(slot_id: u8) -> bool {
    if !xhci_configuration_prepare_state(slot_id) { return false; }
    let index = xhci_configuration_index(slot_id);
    let epoch = xhci_device_table_slot_epoch(slot_id);
    if epoch == 0 { return false; }
    unsafe {
        if XHCI_CONFIGURATION_STATES[index].buffer.valid { return false; }
        XHCI_CONFIGURATION_STATES[index].header_ready = false;
        XHCI_CONFIGURATION_STATES[index].header_total_length = 0;
        XHCI_CONFIGURATION_STATES[index].header_value = 0;
    }
    if !xhci_configuration_invalidate_after_header(slot_id) { return false; }

    let mut buffer = dma_alloc(XHCI_CONFIGURATION_DMA_SIZE, XHCI_CONFIGURATION_DMA_SIZE);
    if !dma_buffer_cpu_owned(&buffer) { return false; }
    if !xhci_configuration_zero(buffer.virtual_address, USB_CONFIGURATION_HEADER_LENGTH as u64) {
        xhci_configuration_release_temporary(&mut buffer);
        return false;
    }
    if !dma_share_with_device(&mut buffer) {
        xhci_configuration_release_temporary(&mut buffer);
        return false;
    }
    let buffer_virtual = buffer.virtual_address;
    if !xhci_configuration_publish_candidate_buffer(slot_id, epoch, buffer) {
        xhci_configuration_release_temporary(&mut buffer);
        return false;
    }
    if !xhci_configuration_fetch_for_slot(
        slot_id, &mut buffer, USB_CONFIGURATION_HEADER_LENGTH
    ) { return false; }

    let base = buffer_virtual as *const u8;
    let length = xhci_configuration_read8(base, 0);
    let descriptor_type = xhci_configuration_read8(base, 1);
    let total_length = xhci_configuration_read16(base, 2);
    let configuration_value = xhci_configuration_read8(base, 5);
    if length < (USB_CONFIGURATION_HEADER_LENGTH as u8) ||
       descriptor_type != USB_DESCRIPTOR_TYPE_CONFIGURATION ||
       total_length < USB_CONFIGURATION_HEADER_LENGTH ||
       (total_length as u64) > XHCI_CONFIGURATION_DMA_SIZE ||
       configuration_value == 0 {
        xhci_configuration_release_current_buffer_for_epoch(slot_id, epoch);
        return false;
    }
    if !xhci_configuration_state_is_current(slot_id) {
        xhci_configuration_release_current_buffer_for_epoch(slot_id, epoch);
        return false;
    }
    if !xhci_configuration_release_current_buffer_for_epoch(slot_id, epoch) { return false; }
    if !xhci_configuration_state_is_current(slot_id) { return false; }

    unsafe {
        XHCI_CONFIGURATION_STATES[index].header_total_length = total_length;
        XHCI_CONFIGURATION_STATES[index].header_value = configuration_value;
        XHCI_CONFIGURATION_STATES[index].header_ready = true;
    }
    return true;
}

@system
pub fn xhci_probe_first_configuration_header() -> bool {
    let slot_id = xhci_address_slot_id();
    if slot_id == 0 { return false; }
    return xhci_probe_configuration_header_for_slot(slot_id);
}

@system
pub fn xhci_configuration_header_is_ready_for(slot_id: u8) -> bool {
    if !xhci_configuration_state_is_current(slot_id) { return false; }
    unsafe { return XHCI_CONFIGURATION_STATES[xhci_configuration_index(slot_id)].header_ready; }
}

@system
pub fn xhci_configuration_header_is_ready() -> bool {
    return xhci_configuration_header_is_ready_for(xhci_address_slot_id());
}

@system
pub fn xhci_configuration_header_total_length_for(slot_id: u8) -> u16 {
    if !xhci_configuration_header_is_ready_for(slot_id) { return 0; }
    unsafe { return XHCI_CONFIGURATION_STATES[xhci_configuration_index(slot_id)].header_total_length; }
}

@system
pub fn xhci_configuration_header_total_length() -> u16 {
    return xhci_configuration_header_total_length_for(xhci_address_slot_id());
}

@system
pub fn xhci_configuration_header_value_for(slot_id: u8) -> u8 {
    if !xhci_configuration_header_is_ready_for(slot_id) { return 0; }
    unsafe { return XHCI_CONFIGURATION_STATES[xhci_configuration_index(slot_id)].header_value; }
}

@system
pub fn xhci_configuration_header_value() -> u8 {
    return xhci_configuration_header_value_for(xhci_address_slot_id());
}

@system
pub fn xhci_read_configuration_full_for_slot(slot_id: u8) -> bool {
    if !xhci_configuration_prepare_state(slot_id) ||
       !xhci_configuration_header_is_ready_for(slot_id) {
        return false;
    }
    let index = xhci_configuration_index(slot_id);
    let epoch = xhci_device_table_slot_epoch(slot_id);
    if epoch == 0 { return false; }
    unsafe {
        if XHCI_CONFIGURATION_STATES[index].buffer.valid { return false; }
        XHCI_CONFIGURATION_STATES[index].full_ready = false;
        XHCI_CONFIGURATION_STATES[index].full_total_length = 0;
        XHCI_CONFIGURATION_STATES[index].full_value = 0;
    }
    if !xhci_configuration_invalidate_after_full(slot_id) { return false; }

    let total_length = xhci_configuration_header_total_length_for(slot_id);
    let configuration_value = xhci_configuration_header_value_for(slot_id);
    if total_length < USB_CONFIGURATION_HEADER_LENGTH ||
       (total_length as u64) > XHCI_CONFIGURATION_DMA_SIZE ||
       configuration_value == 0 {
        return false;
    }

    let mut buffer = dma_alloc(XHCI_CONFIGURATION_DMA_SIZE, XHCI_CONFIGURATION_DMA_SIZE);
    if !dma_buffer_cpu_owned(&buffer) { return false; }
    if !xhci_configuration_zero(buffer.virtual_address, total_length as u64) {
        xhci_configuration_release_temporary(&mut buffer);
        return false;
    }
    if !dma_share_with_device(&mut buffer) {
        xhci_configuration_release_temporary(&mut buffer);
        return false;
    }
    let buffer_virtual = buffer.virtual_address;
    if !xhci_configuration_publish_candidate_buffer(slot_id, epoch, buffer) {
        xhci_configuration_release_temporary(&mut buffer);
        return false;
    }
    if !xhci_configuration_fetch_for_slot(slot_id, &mut buffer, total_length) { return false; }

    let base = buffer_virtual as *const u8;
    if xhci_configuration_read8(base, 0) < (USB_CONFIGURATION_HEADER_LENGTH as u8) ||
       xhci_configuration_read8(base, 1) != USB_DESCRIPTOR_TYPE_CONFIGURATION ||
       xhci_configuration_read16(base, 2) != total_length ||
       xhci_configuration_read8(base, 5) != configuration_value {
        xhci_configuration_release_current_buffer_for_epoch(slot_id, epoch);
        return false;
    }
    if !xhci_configuration_state_is_current(slot_id) {
        xhci_configuration_release_current_buffer_for_epoch(slot_id, epoch);
        return false;
    }

    unsafe {
        XHCI_CONFIGURATION_STATES[index].full_total_length = total_length;
        XHCI_CONFIGURATION_STATES[index].full_value = configuration_value;
        XHCI_CONFIGURATION_STATES[index].full_ready = true;
    }
    return true;
}

