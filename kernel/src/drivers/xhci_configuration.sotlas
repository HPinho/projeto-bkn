// Baken OS — leitura e parsing do Configuration Descriptor USB.
//
// Faz uma leitura curta de 9 bytes para descobrir wTotalLength e depois busca
// a configuração completa no EP0. O parser caminha por descritores variáveis
// e seleciona uma interface HID Boot (keyboard/mouse) com endpoint Interrupt IN.
// Não configura endpoint no xHC e não envia SET_CONFIGURATION nesta camada.

module kernel::drivers::xhci_configuration;

import kernel::memory::dma::*;
import kernel::drivers::xhci_context::*;
import kernel::drivers::xhci_address::*;
import kernel::drivers::xhci_ep0::*;
import kernel::drivers::xhci_trb::*;
import kernel::drivers::xhci_transfer::*;
import kernel::drivers::xhci_descriptor::*;

pub const USB_DESCRIPTOR_TYPE_CONFIGURATION: u8 = 2;
pub const USB_DESCRIPTOR_TYPE_INTERFACE: u8 = 4;
pub const USB_DESCRIPTOR_TYPE_ENDPOINT: u8 = 5;
pub const USB_DESCRIPTOR_TYPE_HID: u8 = 0x21;
pub const USB_DESCRIPTOR_TYPE_REPORT: u8 = 0x22;
pub const USB_CONFIGURATION_HEADER_LENGTH: u16 = 9;
pub const USB_INTERFACE_DESCRIPTOR_LENGTH: u8 = 9;
pub const USB_ENDPOINT_DESCRIPTOR_LENGTH: u8 = 7;
pub const USB_CLASS_HID: u8 = 3;
pub const USB_HID_SUBCLASS_BOOT: u8 = 1;
pub const USB_HID_PROTOCOL_KEYBOARD: u8 = 1;
pub const USB_HID_PROTOCOL_MOUSE: u8 = 2;
pub const USB_ENDPOINT_DIRECTION_IN: u8 = 0x80;
pub const USB_ENDPOINT_TRANSFER_TYPE_MASK: u8 = 0x03;
pub const USB_ENDPOINT_TRANSFER_INTERRUPT: u8 = 0x03;
pub const XHCI_CONFIGURATION_DMA_SIZE: u64 = 4096;

static mut XHCI_CONFIGURATION_READY: bool = false;
static mut XHCI_CONFIGURATION_VALUE: u8 = 0;
static mut XHCI_CONFIGURATION_TOTAL_LENGTH: u16 = 0;
static mut XHCI_HID_INTERFACE_NUMBER: u8 = 0;
static mut XHCI_HID_PROTOCOL: u8 = 0;
static mut XHCI_HID_ENDPOINT_ADDRESS: u8 = 0;
static mut XHCI_HID_ENDPOINT_MAX_PACKET: u16 = 0;
static mut XHCI_HID_ENDPOINT_INTERVAL: u8 = 0;
static mut XHCI_HID_REPORT_DESCRIPTOR_LENGTH: u16 = 0;
static mut XHCI_CONFIGURATION_BUFFER: DmaBuffer = DmaBuffer {
    virtual_address: null as *mut u8,
    physical_address: 0,
    size: 0,
    alignment: 0,
    owner: DMA_OWNER_CPU,
    fence: 0,
    valid: false
};

@system
fn xhci_configuration_read8(base: *const u8, offset: u64) -> u8 {
    if base == (null as *const u8) { return 0; }
    unsafe { return *(((base as usize) + (offset as usize)) as *const u8); }
}

@system
fn xhci_configuration_read16(base: *const u8, offset: u64) -> u16 {
    let lo = xhci_configuration_read8(base, offset) as u16;
    let hi = xhci_configuration_read8(base, offset + 1) as u16;
    return lo | (hi << 8);
}

@system
fn xhci_configuration_zero(base: *mut u8, size: u64) -> bool {
    if base == (null as *mut u8) || size == 0 { return false; }
    unsafe {
        let mut i: u64 = 0;
        while i < size {
            *(((base as usize) + (i as usize)) as *mut u8) = 0;
            i += 1;
        }
    }
    return true;
}

@system
fn xhci_configuration_fetch(buffer: *mut DmaBuffer, length: u16) -> bool {
    if buffer == (null as *mut DmaBuffer) || length == 0 { return false; }
    unsafe {
        if !(*buffer).valid || (*buffer).physical_address == 0 ||
           (*buffer).virtual_address == (null as *mut u8) { return false; }
        if (length as u64) > (*buffer).size { return false; }
    }

    let slot_id = xhci_address_slot_id();
    if slot_id == 0 || slot_id != xhci_context_slot_id() { return false; }

    let setup = xhci_trb_setup_stage(
        USB_REQUEST_TYPE_DEVICE_TO_HOST_STANDARD_DEVICE,
        USB_REQUEST_GET_DESCRIPTOR,
        0x0200,
        0,
        length,
        XHCI_SETUP_TRT_IN_DATA,
        xhci_ep0_producer_cycle()
    );
    unsafe {
        let data = xhci_trb_data_stage(
            (*buffer).physical_address,
            length as u32,
            0,
            true,
            false,
            xhci_ep0_producer_cycle()
        );
        let status = xhci_trb_status_stage(false, true, xhci_ep0_producer_cycle());
        let status_physical = xhci_ep0_submit_control_td(setup, data, status, true);
        if status_physical == 0 { return false; }
        if !xhci_transfer_wait_ep0_completion(slot_id, status_physical) { return false; }
        return xhci_transfer_last_residual_length() == 0;
    }
}

@system
fn xhci_configuration_parse(base: *const u8, total_length: u16) -> bool {
    if base == (null as *const u8) || total_length < USB_CONFIGURATION_HEADER_LENGTH {
        return false;
    }
    if xhci_configuration_read8(base, 0) < (USB_CONFIGURATION_HEADER_LENGTH as u8) ||
       xhci_configuration_read8(base, 1) != USB_DESCRIPTOR_TYPE_CONFIGURATION {
        return false;
    }

    let mut offset: u64 = 0;
    let mut hid_active: bool = false;
    let mut hid_interface: u8 = 0;
    let mut hid_protocol: u8 = 0;
    let mut hid_report_length: u16 = 0;
    let mut endpoint_address: u8 = 0;
    let mut endpoint_packet: u16 = 0;
    let mut endpoint_interval: u8 = 0;

    while offset + 2 <= (total_length as u64) {
        let length = xhci_configuration_read8(base, offset) as u64;
        let dtype = xhci_configuration_read8(base, offset + 1);
        if length < 2 || offset + length > (total_length as u64) { return false; }

        if dtype == USB_DESCRIPTOR_TYPE_INTERFACE &&
           length >= (USB_INTERFACE_DESCRIPTOR_LENGTH as u64) {
            let interface_class = xhci_configuration_read8(base, offset + 5);
            let interface_subclass = xhci_configuration_read8(base, offset + 6);
            let interface_protocol = xhci_configuration_read8(base, offset + 7);
            let alternate = xhci_configuration_read8(base, offset + 3);
            hid_active = interface_class == USB_CLASS_HID &&
                interface_subclass == USB_HID_SUBCLASS_BOOT && alternate == 0 &&
                (interface_protocol == USB_HID_PROTOCOL_KEYBOARD ||
                 interface_protocol == USB_HID_PROTOCOL_MOUSE);
            if hid_active {
                hid_interface = xhci_configuration_read8(base, offset + 2);
                hid_protocol = interface_protocol;
                hid_report_length = 0;
                endpoint_address = 0;
                endpoint_packet = 0;
                endpoint_interval = 0;
            }
        } else if dtype == USB_DESCRIPTOR_TYPE_HID && hid_active && length >= 9 {
            if xhci_configuration_read8(base, offset + 6) == USB_DESCRIPTOR_TYPE_REPORT {
                hid_report_length = xhci_configuration_read16(base, offset + 7);
            }
        } else if dtype == USB_DESCRIPTOR_TYPE_ENDPOINT && hid_active &&
                  length >= (USB_ENDPOINT_DESCRIPTOR_LENGTH as u64) {
            let address = xhci_configuration_read8(base, offset + 2);
            let attributes = xhci_configuration_read8(base, offset + 3);
            if (address & USB_ENDPOINT_DIRECTION_IN) != 0 &&
               (attributes & USB_ENDPOINT_TRANSFER_TYPE_MASK) == USB_ENDPOINT_TRANSFER_INTERRUPT {
                endpoint_address = address;
                endpoint_packet = xhci_configuration_read16(base, offset + 4) & 0x07FF;
                endpoint_interval = xhci_configuration_read8(base, offset + 6);
                if endpoint_packet == 0 { return false; }
                unsafe {
                    XHCI_HID_INTERFACE_NUMBER = hid_interface;
                    XHCI_HID_PROTOCOL = hid_protocol;
                    XHCI_HID_REPORT_DESCRIPTOR_LENGTH = hid_report_length;
                    XHCI_HID_ENDPOINT_ADDRESS = endpoint_address;
                    XHCI_HID_ENDPOINT_MAX_PACKET = endpoint_packet;
                    XHCI_HID_ENDPOINT_INTERVAL = endpoint_interval;
                }
                return true;
            }
        }

        offset += length;
    }
    return false;
}

@system
pub fn xhci_get_first_hid_configuration() -> bool {
    unsafe {
        XHCI_CONFIGURATION_READY = false;
        XHCI_CONFIGURATION_VALUE = 0;
        XHCI_CONFIGURATION_TOTAL_LENGTH = 0;
        XHCI_HID_INTERFACE_NUMBER = 0;
        XHCI_HID_PROTOCOL = 0;
        XHCI_HID_ENDPOINT_ADDRESS = 0;
        XHCI_HID_ENDPOINT_MAX_PACKET = 0;
        XHCI_HID_ENDPOINT_INTERVAL = 0;
        XHCI_HID_REPORT_DESCRIPTOR_LENGTH = 0;
        XHCI_CONFIGURATION_BUFFER = dma_invalid_buffer();
    }
    if !xhci_device_descriptor_is_ready() || !xhci_ep0_is_ready() { return false; }

    let mut buffer = dma_alloc(XHCI_CONFIGURATION_DMA_SIZE, XHCI_CONFIGURATION_DMA_SIZE);
    if !dma_buffer_cpu_owned(&buffer) { return false; }
    if !xhci_configuration_zero(buffer.virtual_address, XHCI_CONFIGURATION_DMA_SIZE) { return false; }
    if !dma_share_with_device(&mut buffer) { return false; }

    if !xhci_configuration_fetch(&mut buffer, USB_CONFIGURATION_HEADER_LENGTH) { return false; }
    let base = buffer.virtual_address as *const u8;
    if xhci_configuration_read8(base, 1) != USB_DESCRIPTOR_TYPE_CONFIGURATION { return false; }
    let total_length = xhci_configuration_read16(base, 2);
    if total_length < USB_CONFIGURATION_HEADER_LENGTH ||
       (total_length as u64) > XHCI_CONFIGURATION_DMA_SIZE { return false; }
    let configuration_value = xhci_configuration_read8(base, 5);
    if configuration_value == 0 { return false; }

    if !xhci_configuration_zero(buffer.virtual_address, total_length as u64) { return false; }
    if !xhci_configuration_fetch(&mut buffer, total_length) { return false; }
    if !xhci_configuration_parse(base, total_length) { return false; }

    unsafe {
        XHCI_CONFIGURATION_VALUE = configuration_value;
        XHCI_CONFIGURATION_TOTAL_LENGTH = total_length;
        XHCI_CONFIGURATION_BUFFER = buffer;
        XHCI_CONFIGURATION_READY = true;
    }
    return true;
}

@system
pub fn xhci_configuration_is_ready() -> bool { unsafe { return XHCI_CONFIGURATION_READY; } }
@system
pub fn xhci_configuration_value() -> u8 { unsafe { return XHCI_CONFIGURATION_VALUE; } }
@system
pub fn xhci_configuration_total_length() -> u16 { unsafe { return XHCI_CONFIGURATION_TOTAL_LENGTH; } }
@system
pub fn xhci_hid_interface_number() -> u8 { unsafe { return XHCI_HID_INTERFACE_NUMBER; } }
@system
pub fn xhci_hid_protocol() -> u8 { unsafe { return XHCI_HID_PROTOCOL; } }
@system
pub fn xhci_hid_endpoint_address() -> u8 { unsafe { return XHCI_HID_ENDPOINT_ADDRESS; } }
@system
pub fn xhci_hid_endpoint_max_packet() -> u16 { unsafe { return XHCI_HID_ENDPOINT_MAX_PACKET; } }
@system
pub fn xhci_hid_endpoint_interval() -> u8 { unsafe { return XHCI_HID_ENDPOINT_INTERVAL; } }
@system
pub fn xhci_hid_report_descriptor_length() -> u16 {
    unsafe { return XHCI_HID_REPORT_DESCRIPTOR_LENGTH; }
}
