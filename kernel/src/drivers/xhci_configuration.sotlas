@system
fn xhci_configuration_parse_for_slot(slot_id: u8,
                                     base: *const u8,
                                     total_length: u16) -> bool {
    if base == (null as *const u8) ||
       total_length < USB_CONFIGURATION_HEADER_LENGTH ||
       !xhci_configuration_state_is_current(slot_id) {
        return false;
    }
    if xhci_configuration_read8(base, 0) < (USB_CONFIGURATION_HEADER_LENGTH as u8) ||
       xhci_configuration_read8(base, 1) != USB_DESCRIPTOR_TYPE_CONFIGURATION {
        return false;
    }

    let mut offset: u64 = 0;
    let mut hid_active: bool = false;
    let mut hid_interface: u8 = 0;
    let mut hid_protocol: u8 = 0;
    let mut hid_report_length: u16 = 0;
    let mut endpoint_address: u8 = 0;
    let mut endpoint_packet: u16 = 0;
    let mut endpoint_interval: u8 = 0;

    while offset + 2 <= (total_length as u64) {
        let length = xhci_configuration_read8(base, offset) as u64;
        let dtype = xhci_configuration_read8(base, offset + 1);
        if length < 2 || offset + length > (total_length as u64) { return false; }

        if dtype == USB_DESCRIPTOR_TYPE_INTERFACE &&
           length >= (USB_INTERFACE_DESCRIPTOR_LENGTH as u64) {
            let interface_class = xhci_configuration_read8(base, offset + 5);
            let interface_subclass = xhci_configuration_read8(base, offset + 6);
            let interface_protocol = xhci_configuration_read8(base, offset + 7);
            let alternate = xhci_configuration_read8(base, offset + 3);
            hid_active = interface_class == USB_CLASS_HID &&
                interface_subclass == USB_HID_SUBCLASS_BOOT && alternate == 0 &&
                (interface_protocol == USB_HID_PROTOCOL_KEYBOARD ||
                 interface_protocol == USB_HID_PROTOCOL_MOUSE);
            if hid_active {
                hid_interface = xhci_configuration_read8(base, offset + 2);
                hid_protocol = interface_protocol;
                hid_report_length = 0;
                endpoint_address = 0;
                endpoint_packet = 0;
                endpoint_interval = 0;
            }
        } else if dtype == USB_DESCRIPTOR_TYPE_HID && hid_active && length >= 9 {
            if xhci_configuration_read8(base, offset + 6) == USB_DESCRIPTOR_TYPE_REPORT {
                hid_report_length = xhci_configuration_read16(base, offset + 7);
            }
        } else if dtype == USB_DESCRIPTOR_TYPE_ENDPOINT && hid_active &&
                  length >= (USB_ENDPOINT_DESCRIPTOR_LENGTH as u64) {
            let address = xhci_configuration_read8(base, offset + 2);
            let attributes = xhci_configuration_read8(base, offset + 3);
            if (address & USB_ENDPOINT_DIRECTION_IN) != 0 &&
               (attributes & USB_ENDPOINT_TRANSFER_TYPE_MASK) == USB_ENDPOINT_TRANSFER_INTERRUPT {
                endpoint_address = address;
                endpoint_packet = xhci_configuration_read16(base, offset + 4) & 0x07FF;
                endpoint_interval = xhci_configuration_read8(base, offset + 6);
                if endpoint_packet == 0 || hid_report_length == 0 { return false; }
                let index = xhci_configuration_index(slot_id);
                unsafe {
                    XHCI_CONFIGURATION_STATES[index].hid_interface_number = hid_interface;
                    XHCI_CONFIGURATION_STATES[index].hid_protocol = hid_protocol;
                    XHCI_CONFIGURATION_STATES[index].hid_report_descriptor_length = hid_report_length;
                    XHCI_CONFIGURATION_STATES[index].hid_endpoint_address = endpoint_address;
                    XHCI_CONFIGURATION_STATES[index].hid_endpoint_max_packet = endpoint_packet;
                    XHCI_CONFIGURATION_STATES[index].hid_endpoint_interval = endpoint_interval;
                }
                return true;
            }
        }

        offset += length;
    }
    return false;
}

@system
pub fn xhci_get_hid_configuration_for_slot(slot_id: u8) -> bool {
    if !xhci_configuration_prepare_state(slot_id) ||
       !xhci_configuration_full_is_ready_for(slot_id) {
        return false;
    }
    let index = xhci_configuration_index(slot_id);
    if !xhci_configuration_invalidate_after_full(slot_id) { return false; }

    let total_length = xhci_configuration_full_total_length_for(slot_id);
    let configuration_value = xhci_configuration_full_value_for(slot_id);
    unsafe {
        if !XHCI_CONFIGURATION_STATES[index].buffer.valid ||
           XHCI_CONFIGURATION_STATES[index].buffer.virtual_address == (null as *mut u8) {
            return false;
        }
        let base = XHCI_CONFIGURATION_STATES[index].buffer.virtual_address as *const u8;
        if !xhci_configuration_parse_for_slot(slot_id, base, total_length) { return false; }
    }
    if !xhci_configuration_state_is_current(slot_id) { return false; }
    unsafe {
        XHCI_CONFIGURATION_STATES[index].value = configuration_value;
        XHCI_CONFIGURATION_STATES[index].total_length = total_length;
        XHCI_CONFIGURATION_STATES[index].ready = true;
    }
    return true;
}

@system
pub fn xhci_get_first_hid_configuration() -> bool {
    let slot_id = xhci_address_slot_id();
    if slot_id == 0 { return false; }
    return xhci_get_hid_configuration_for_slot(slot_id);
}

