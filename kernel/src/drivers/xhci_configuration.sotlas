// HID-4d.4a1: o Configuration Descriptor completo é o owner mais alto dos dois
// buffers persistentes de enumeração e deve ser liberado antes do Device
// Descriptor. O helper permanece exact-epoch, retry-safe e não atravessa 4d.4b.
@system
pub fn xhci_configuration_release_persistent_for_epoch(slot_id: u8,
                                                        epoch: u32) -> bool {
    if !xhci_configuration_epoch_matches(slot_id, epoch) { return false; }
    let index = xhci_configuration_index(slot_id);
    if index >= XHCI_CONFIGURATION_SLOT_CAPACITY { return false; }
    if xhci_configuration_persistent_release_complete_for(slot_id, epoch) {
        return true;
    }

    unsafe {
        if XHCI_CONFIGURATION_STATES[index].buffer.valid {
            XHCI_CONFIGURATION_RELEASE_STARTED_EPOCHS[index] = epoch;
        } else if XHCI_CONFIGURATION_RELEASE_STARTED_EPOCHS[index] != epoch {
            return false;
        }
    }

    let mut shared = false;
    let mut cpu_owned = false;
    unsafe {
        if XHCI_CONFIGURATION_STATES[index].buffer.valid {
            shared = dma_buffer_shared(&XHCI_CONFIGURATION_STATES[index].buffer);
            cpu_owned = dma_buffer_cpu_owned(&XHCI_CONFIGURATION_STATES[index].buffer);
        }
    }
    if shared {
        unsafe {
            if !dma_unshare_from_device(&mut XHCI_CONFIGURATION_STATES[index].buffer) {
                return false;
            }
        }
        if !xhci_configuration_epoch_matches(slot_id, epoch) { return false; }
        unsafe {
            cpu_owned = dma_buffer_cpu_owned(&XHCI_CONFIGURATION_STATES[index].buffer);
        }
    }

    unsafe {
        if XHCI_CONFIGURATION_STATES[index].buffer.valid {
            if !cpu_owned ||
               !dma_buffer_cpu_owned(&XHCI_CONFIGURATION_STATES[index].buffer) {
                return false;
            }
        }
    }
    if !xhci_configuration_epoch_matches(slot_id, epoch) { return false; }

    unsafe {
        if XHCI_CONFIGURATION_STATES[index].buffer.valid &&
           !dma_release(&mut XHCI_CONFIGURATION_STATES[index].buffer) {
            return false;
        }
    }
    if !xhci_configuration_epoch_matches(slot_id, epoch) { return false; }

    unsafe {
        if XHCI_CONFIGURATION_RELEASE_STARTED_EPOCHS[index] != epoch ||
           XHCI_CONFIGURATION_STATES[index].buffer.valid {
            return false;
        }
        XHCI_CONFIGURATION_STATES[index].header_ready = false;
        XHCI_CONFIGURATION_STATES[index].header_total_length = 0;
        XHCI_CONFIGURATION_STATES[index].header_value = 0;
        XHCI_CONFIGURATION_STATES[index].full_ready = false;
        XHCI_CONFIGURATION_STATES[index].full_total_length = 0;
        XHCI_CONFIGURATION_STATES[index].full_value = 0;
        XHCI_CONFIGURATION_STATES[index].ready = false;
        XHCI_CONFIGURATION_STATES[index].value = 0;
        XHCI_CONFIGURATION_STATES[index].total_length = 0;
        XHCI_CONFIGURATION_STATES[index].hid_interface_number = 0;
        XHCI_CONFIGURATION_STATES[index].hid_protocol = 0;
        XHCI_CONFIGURATION_STATES[index].hid_endpoint_address = 0;
        XHCI_CONFIGURATION_STATES[index].hid_endpoint_max_packet = 0;
        XHCI_CONFIGURATION_STATES[index].hid_endpoint_interval = 0;
        XHCI_CONFIGURATION_STATES[index].hid_report_descriptor_length = 0;
        XHCI_CONFIGURATION_STATES[index].buffer = dma_invalid_buffer();
        XHCI_CONFIGURATION_RELEASED_EPOCHS[index] = epoch;
    }
    return xhci_configuration_persistent_release_complete_for(slot_id, epoch);
}

@system
pub fn xhci_configuration_persistent_release_complete_for(slot_id: u8,
                                                           epoch: u32) -> bool {
    if !xhci_configuration_epoch_matches(slot_id, epoch) { return false; }
    let index = xhci_configuration_index(slot_id);
    if index >= XHCI_CONFIGURATION_SLOT_CAPACITY { return false; }
    unsafe {
        return XHCI_CONFIGURATION_RELEASE_STARTED_EPOCHS[index] == epoch &&
               XHCI_CONFIGURATION_RELEASED_EPOCHS[index] == epoch &&
               !XHCI_CONFIGURATION_STATES[index].header_ready &&
               XHCI_CONFIGURATION_STATES[index].header_total_length == 0 &&
               XHCI_CONFIGURATION_STATES[index].header_value == 0 &&
               !XHCI_CONFIGURATION_STATES[index].full_ready &&
               XHCI_CONFIGURATION_STATES[index].full_total_length == 0 &&
               XHCI_CONFIGURATION_STATES[index].full_value == 0 &&
               !XHCI_CONFIGURATION_STATES[index].ready &&
               XHCI_CONFIGURATION_STATES[index].value == 0 &&
               XHCI_CONFIGURATION_STATES[index].total_length == 0 &&
               XHCI_CONFIGURATION_STATES[index].hid_interface_number == 0 &&
               XHCI_CONFIGURATION_STATES[index].hid_protocol == 0 &&
               XHCI_CONFIGURATION_STATES[index].hid_endpoint_address == 0 &&
               XHCI_CONFIGURATION_STATES[index].hid_endpoint_max_packet == 0 &&
               XHCI_CONFIGURATION_STATES[index].hid_endpoint_interval == 0 &&
               XHCI_CONFIGURATION_STATES[index].hid_report_descriptor_length == 0 &&
               !XHCI_CONFIGURATION_STATES[index].buffer.valid;
    }
}

// Recovery de enumeração parcial. Só pode ser chamado depois de Disable Slot
// confirmado pelo orquestrador; por isso FAILED é a barreira lógica exigida.
@system
pub fn xhci_configuration_release_failed_for_epoch(slot_id: u8,
                                                    epoch: u32) -> bool {
    if slot_id == 0 || epoch == 0 ||
       !xhci_device_table_slot_is_valid(slot_id) ||
       xhci_device_table_slot_epoch(slot_id) != epoch ||
       xhci_device_table_state(slot_id) != XHCI_DEVICE_STATE_FAILED {
        return false;
    }
    let index = xhci_configuration_index(slot_id);
    if index >= XHCI_CONFIGURATION_SLOT_CAPACITY { return false; }
    if xhci_configuration_failed_release_complete_for(slot_id, epoch) { return true; }

    unsafe {
        if XHCI_CONFIGURATION_STATES[index].epoch != epoch {
            if XHCI_CONFIGURATION_STATES[index].buffer.valid { return false; }
            // Falha pode ocorrer antes de Configuration state ter sido iniciado.
            XHCI_CONFIGURATION_STATES[index].epoch = epoch;
            XHCI_CONFIGURATION_STATES[index].header_ready = false;
            XHCI_CONFIGURATION_STATES[index].header_total_length = 0;
            XHCI_CONFIGURATION_STATES[index].header_value = 0;
            XHCI_CONFIGURATION_STATES[index].full_ready = false;
            XHCI_CONFIGURATION_STATES[index].full_total_length = 0;
            XHCI_CONFIGURATION_STATES[index].full_value = 0;
            XHCI_CONFIGURATION_STATES[index].ready = false;
            XHCI_CONFIGURATION_STATES[index].value = 0;
            XHCI_CONFIGURATION_STATES[index].total_length = 0;
            XHCI_CONFIGURATION_STATES[index].hid_interface_number = 0;
            XHCI_CONFIGURATION_STATES[index].hid_protocol = 0;
            XHCI_CONFIGURATION_STATES[index].hid_endpoint_address = 0;
            XHCI_CONFIGURATION_STATES[index].hid_endpoint_max_packet = 0;
            XHCI_CONFIGURATION_STATES[index].hid_endpoint_interval = 0;
            XHCI_CONFIGURATION_STATES[index].hid_report_descriptor_length = 0;
            XHCI_CONFIGURATION_STATES[index].buffer = dma_invalid_buffer();
        }
        XHCI_CONFIGURATION_RELEASE_STARTED_EPOCHS[index] = epoch;
    }
    if !xhci_configuration_failed_epoch_matches(slot_id, epoch) { return false; }
    if !xhci_configuration_release_current_buffer_for_epoch(slot_id, epoch) { return false; }
    if !xhci_configuration_failed_epoch_matches(slot_id, epoch) { return false; }

    unsafe {
        XHCI_CONFIGURATION_STATES[index].header_ready = false;
        XHCI_CONFIGURATION_STATES[index].header_total_length = 0;
        XHCI_CONFIGURATION_STATES[index].header_value = 0;
        XHCI_CONFIGURATION_STATES[index].full_ready = false;
        XHCI_CONFIGURATION_STATES[index].full_total_length = 0;
        XHCI_CONFIGURATION_STATES[index].full_value = 0;
        XHCI_CONFIGURATION_STATES[index].ready = false;
        XHCI_CONFIGURATION_STATES[index].value = 0;
        XHCI_CONFIGURATION_STATES[index].total_length = 0;
        XHCI_CONFIGURATION_STATES[index].hid_interface_number = 0;
        XHCI_CONFIGURATION_STATES[index].hid_protocol = 0;
        XHCI_CONFIGURATION_STATES[index].hid_endpoint_address = 0;
        XHCI_CONFIGURATION_STATES[index].hid_endpoint_max_packet = 0;
        XHCI_CONFIGURATION_STATES[index].hid_endpoint_interval = 0;
        XHCI_CONFIGURATION_STATES[index].hid_report_descriptor_length = 0;
        XHCI_CONFIGURATION_STATES[index].buffer = dma_invalid_buffer();
        XHCI_CONFIGURATION_RELEASE_STARTED_EPOCHS[index] = epoch;
        XHCI_CONFIGURATION_RELEASED_EPOCHS[index] = epoch;
    }
    return xhci_configuration_failed_release_complete_for(slot_id, epoch);
}

@system
pub fn xhci_configuration_failed_release_complete_for(slot_id: u8,
                                                       epoch: u32) -> bool {
    if !xhci_configuration_failed_epoch_matches(slot_id, epoch) { return false; }
    let index = xhci_configuration_index(slot_id);
    if index >= XHCI_CONFIGURATION_SLOT_CAPACITY { return false; }
    unsafe {
        return XHCI_CONFIGURATION_RELEASE_STARTED_EPOCHS[index] == epoch &&
               XHCI_CONFIGURATION_RELEASED_EPOCHS[index] == epoch &&
               !XHCI_CONFIGURATION_STATES[index].header_ready &&
               XHCI_CONFIGURATION_STATES[index].header_total_length == 0 &&
               XHCI_CONFIGURATION_STATES[index].header_value == 0 &&
               !XHCI_CONFIGURATION_STATES[index].full_ready &&
               XHCI_CONFIGURATION_STATES[index].full_total_length == 0 &&
               XHCI_CONFIGURATION_STATES[index].full_value == 0 &&
               !XHCI_CONFIGURATION_STATES[index].ready &&
               XHCI_CONFIGURATION_STATES[index].value == 0 &&
               XHCI_CONFIGURATION_STATES[index].total_length == 0 &&
               XHCI_CONFIGURATION_STATES[index].hid_interface_number == 0 &&
               XHCI_CONFIGURATION_STATES[index].hid_protocol == 0 &&
               XHCI_CONFIGURATION_STATES[index].hid_endpoint_address == 0 &&
               XHCI_CONFIGURATION_STATES[index].hid_endpoint_max_packet == 0 &&
               XHCI_CONFIGURATION_STATES[index].hid_endpoint_interval == 0 &&
               XHCI_CONFIGURATION_STATES[index].hid_report_descriptor_length == 0 &&
               !XHCI_CONFIGURATION_STATES[index].buffer.valid;
    }
}
