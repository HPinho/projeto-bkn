// Baken OS — construtores puros de Transfer TRBs xHCI para EP0.
//
// Codifica Setup/Data/Status Stage TRBs sem escrever rings, tocar doorbells,
// acessar MMIO ou consumir eventos. Esta camada prepara futuras transferências
// de controle (por exemplo GET_DESCRIPTOR) após Address Device.

module kernel::drivers::xhci_transfer_trb;

import kernel::drivers::xhci_ring::*;
import kernel::drivers::xhci_trb::*;

pub const XHCI_TRB_TYPE_NORMAL: u32 = 1;
pub const XHCI_TRB_TYPE_SETUP_STAGE: u32 = 2;
pub const XHCI_TRB_TYPE_DATA_STAGE: u32 = 3;
pub const XHCI_TRB_TYPE_STATUS_STAGE: u32 = 4;

pub const XHCI_TRANSFER_TRB_IOC_BIT: u32 = 1 << 5;
pub const XHCI_TRANSFER_TRB_IDT_BIT: u32 = 1 << 6;
pub const XHCI_TRANSFER_TRB_DIR_IN_BIT: u32 = 1 << 16;
pub const XHCI_SETUP_TRT_SHIFT: u32 = 16;
pub const XHCI_SETUP_TRT_NO_DATA: u32 = 0;
pub const XHCI_SETUP_TRT_OUT_DATA: u32 = 2;
pub const XHCI_SETUP_TRT_IN_DATA: u32 = 3;
pub const XHCI_TRANSFER_LENGTH_MASK: u32 = 0x1FFFF;
pub const XHCI_TD_SIZE_SHIFT: u32 = 17;
pub const XHCI_TD_SIZE_MASK: u32 = 0x1F;

@system
fn xhci_setup_packet_parameter(request_type: u8,
                               request: u8,
                               value: u16,
                               index: u16,
                               length: u16) -> u64 {
    return (request_type as u64) |
        ((request as u64) << 8) |
        ((value as u64) << 16) |
        ((index as u64) << 32) |
        ((length as u64) << 48);
}

@system
pub fn xhci_trb_setup_stage(request_type: u8,
                            request: u8,
                            value: u16,
                            index: u16,
                            length: u16,
                            transfer_type: u32,
                            cycle: bool) -> XhciTrb {
    let trt = transfer_type & 3;
    let status: u32 = 8;
    let control = xhci_trb_type_bits(XHCI_TRB_TYPE_SETUP_STAGE) |
        XHCI_TRANSFER_TRB_IDT_BIT |
        (trt << XHCI_SETUP_TRT_SHIFT) |
        xhci_trb_cycle_bits(cycle);
    return XhciTrb {
        parameter: xhci_setup_packet_parameter(request_type, request, value, index, length),
        status: status,
        control: control
    };
}

@system
pub fn xhci_trb_data_stage(buffer_physical: u64,
                           transfer_length: u32,
                           td_size: u8,
                           direction_in: bool,
                           interrupt_on_completion: bool,
                           cycle: bool) -> XhciTrb {
    let mut control = xhci_trb_type_bits(XHCI_TRB_TYPE_DATA_STAGE) |
        xhci_trb_cycle_bits(cycle);
    if direction_in { control = control | XHCI_TRANSFER_TRB_DIR_IN_BIT; }
    if interrupt_on_completion { control = control | XHCI_TRANSFER_TRB_IOC_BIT; }
    let status = (transfer_length & XHCI_TRANSFER_LENGTH_MASK) |
        (((td_size as u32) & XHCI_TD_SIZE_MASK) << XHCI_TD_SIZE_SHIFT);
    return XhciTrb {
        parameter: buffer_physical & 0xFFFFFFFFFFFFFFF0,
        status: status,
        control: control
    };
}

@system
pub fn xhci_trb_status_stage(direction_in: bool,
                             interrupt_on_completion: bool,
                             cycle: bool) -> XhciTrb {
    let mut control = xhci_trb_type_bits(XHCI_TRB_TYPE_STATUS_STAGE) |
        xhci_trb_cycle_bits(cycle);
    if direction_in { control = control | XHCI_TRANSFER_TRB_DIR_IN_BIT; }
    if interrupt_on_completion { control = control | XHCI_TRANSFER_TRB_IOC_BIT; }
    return XhciTrb { parameter: 0, status: 0, control: control };
}

@system
pub fn xhci_trb_normal(buffer_physical: u64,
                       transfer_length: u32,
                       td_size: u8,
                       interrupt_on_completion: bool,
                       cycle: bool) -> XhciTrb {
    let mut control = xhci_trb_type_bits(XHCI_TRB_TYPE_NORMAL) |
        xhci_trb_cycle_bits(cycle);
    if interrupt_on_completion { control = control | XHCI_TRANSFER_TRB_IOC_BIT; }
    let status = (transfer_length & XHCI_TRANSFER_LENGTH_MASK) |
        (((td_size as u32) & XHCI_TD_SIZE_MASK) << XHCI_TD_SIZE_SHIFT);
    return XhciTrb {
        parameter: buffer_physical & 0xFFFFFFFFFFFFFFF0,
        status: status,
        control: control
    };
}
