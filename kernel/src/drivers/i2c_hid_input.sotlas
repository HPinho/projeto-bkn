// Baken OS — I2C-HID-3 & I2C-HID-4: Pipeline de Entrada e Interrupção GPIO para HID-over-I2C.
//
// Lê relatórios de entrada a partir do wInputRegister, decodifica o cabeçalho de 2 bytes
// de comprimento e despacha o payload de relatório para o subsistema de entrada genérico.

module kernel::drivers::i2c_hid_input;

import kernel::arch::x86_64::cpu::*;
import kernel::sync::spinlock::*;
import kernel::drivers::i2c_core::*;
import kernel::drivers::i2c_device::*;
import kernel::drivers::hid_report_descriptor::*;
import kernel::drivers::hid_input_events::*;

pub const I2C_HID_MAX_INPUT_DEVICES: usize = 4;
pub const I2C_HID_MAX_INPUT_BUFFER_BYTES: usize = 256;

@repr(C)
pub struct I2cHidInputDevice {
    pub device_slot: usize;
    pub i2c_device_id: u32;
    pub i2c_generation: u32;
    pub input_register: u16;
    pub max_input_length: u16;
    pub gpio_pin: u16;
    pub gpio_connection_id: u32;
    pub gpio_generation: u32;
    pub input_device_id: u32;
    pub input_device_generation: u32;
    pub is_mouse: bool;
    pub is_touchpad: bool;
    pub is_keyboard: bool;
    pub pending_irq: bool;
    pub reports_received: u64;
    pub valid: bool;
}

static mut I2C_HID_INPUT_LOCK: SpinLock = SpinLock { state: SPINLOCK_UNLOCKED };
static mut I2C_HID_INPUT_LOCK_READY: bool = false;
static mut I2C_HID_INPUT_READY: bool = false;
static mut I2C_HID_INPUT_DEVICES: [I2cHidInputDevice; I2C_HID_MAX_INPUT_DEVICES] = [
    I2cHidInputDevice {
        device_slot: 0,
        i2c_device_id: 0,
        i2c_generation: 0,
        input_register: 0,
        max_input_length: 0,
        gpio_pin: 0,
        gpio_connection_id: 0,
        gpio_generation: 0,
        input_device_id: 0,
        input_device_generation: 0,
        is_mouse: false,
        is_touchpad: false,
        is_keyboard: false,
        pending_irq: false,
        reports_received: 0,
        valid: false
    }; I2C_HID_MAX_INPUT_DEVICES
];
static mut I2C_HID_INPUT_COUNT: usize = 0;

@system
pub fn i2c_hid_input_init() -> bool {
    let flags = x86_irq_save_disable();
    unsafe {
        if !I2C_HID_INPUT_LOCK_READY {
            spinlock_init(&mut I2C_HID_INPUT_LOCK);
            I2C_HID_INPUT_LOCK_READY = true;
        }
        if !I2C_HID_INPUT_READY {
            let mut i: usize = 0;
            while i < I2C_HID_MAX_INPUT_DEVICES {
                I2C_HID_INPUT_DEVICES[i] = I2cHidInputDevice {
                    device_slot: 0,
                    i2c_device_id: 0,
                    i2c_generation: 0,
                    input_register: 0,
                    max_input_length: 0,
                    gpio_pin: 0,
                    is_mouse: false,
                    is_touchpad: false,
                    is_keyboard: false,
                    pending_irq: false,
                    reports_received: 0,
                    valid: false
                };
                i += 1;
            }
            I2C_HID_INPUT_COUNT = 0;
            __dma_fence();
            I2C_HID_INPUT_READY = true;
        }
    }
    x86_irq_restore(flags);
    return true;
}

@system
pub fn i2c_hid_input_register_device(device_slot: usize,
                                     i2c_device_id: u32,
                                     i2c_generation: u32,
                                     input_register: u16,
                                     max_input_length: u16,
                                     gpio_pin: u16,
                                     gpio_connection_id: u32,
                                     gpio_generation: u32,
                                     input_device_id: u32,
                                     input_device_generation: u32,
                                     is_mouse: bool,
                                     is_touchpad: bool,
                                     is_keyboard: bool) -> bool {
    if !i2c_hid_input_init() { return false; }
    if input_register == 0 || max_input_length < 2 { return false; }

    let flags = x86_irq_save_disable();
    let mut enrolled = false;
    unsafe {
        if I2C_HID_INPUT_LOCK_READY && spinlock_lock(&mut I2C_HID_INPUT_LOCK) {
            if I2C_HID_INPUT_READY && I2C_HID_INPUT_COUNT < I2C_HID_MAX_INPUT_DEVICES {
                let slot = I2C_HID_INPUT_COUNT;
                I2C_HID_INPUT_DEVICES[slot] = I2cHidInputDevice {
                    device_slot: device_slot,
                    i2c_device_id: i2c_device_id,
                    i2c_generation: i2c_generation,
                    input_register: input_register,
                    max_input_length: max_input_length,
                    gpio_pin: gpio_pin,
                    gpio_connection_id: gpio_connection_id,
                    gpio_generation: gpio_generation,
                    input_device_id: input_device_id,
                    input_device_generation: input_device_generation,
                    is_mouse: is_mouse,
                    is_touchpad: is_touchpad,
                    is_keyboard: is_keyboard,
                    pending_irq: false,
                    reports_received: 0,
                    valid: true
                };
                I2C_HID_INPUT_COUNT += 1;
                enrolled = true;
            }
            spinlock_unlock(&mut I2C_HID_INPUT_LOCK);
        }
    }
    x86_irq_restore(flags);
    return enrolled;
}

@system
pub fn i2c_hid_input_notify_irq(gpio_pin: u16) -> void {
    let flags = x86_irq_save_disable();
    unsafe {
        if I2C_HID_INPUT_LOCK_READY && spinlock_lock(&mut I2C_HID_INPUT_LOCK) {
            if I2C_HID_INPUT_READY {
                let mut i: usize = 0;
                while i < I2C_HID_INPUT_COUNT {
                    if I2C_HID_INPUT_DEVICES[i].valid &&
                       (I2C_HID_INPUT_DEVICES[i].gpio_pin == gpio_pin || gpio_pin == 0) {
                        I2C_HID_INPUT_DEVICES[i].pending_irq = true;
                    }
                    i += 1;
                }
            }
            spinlock_unlock(&mut I2C_HID_INPUT_LOCK);
        }
    }
    x86_irq_restore(flags);
}

@system
pub fn i2c_hid_input_fetch_report(device_index: usize,
                                  out_buf: *mut u8,
                                  buf_capacity: usize,
                                  out_report_len: *mut usize) -> u8 {
    if out_buf == (null as *mut u8) || out_report_len == (null as *mut usize) ||
       buf_capacity < 2 || device_index >= I2C_HID_MAX_INPUT_DEVICES {
        return I2C_STATUS_INVALID;
    }
    unsafe { *out_report_len = 0; }

    let flags = x86_irq_save_disable();
    let mut dev = I2cHidInputDevice {
        device_slot: 0, i2c_device_id: 0, i2c_generation: 0, input_register: 0,
        max_input_length: 0, gpio_pin: 0, gpio_connection_id: 0, gpio_generation: 0,
        input_device_id: 0, input_device_generation: 0, is_mouse: false,
        is_touchpad: false, is_keyboard: false, pending_irq: false,
        reports_received: 0, valid: false
    };
    unsafe {
        if I2C_HID_INPUT_LOCK_READY && spinlock_lock(&mut I2C_HID_INPUT_LOCK) {
            if I2C_HID_INPUT_READY && I2C_HID_INPUT_DEVICES[device_index].valid {
                dev = I2C_HID_INPUT_DEVICES[device_index];
            }
            spinlock_unlock(&mut I2C_HID_INPUT_LOCK);
        }
    }
    x86_irq_restore(flags);

    if !dev.valid { return I2C_STATUS_INVALID; }

    let mut read_len = dev.max_input_length as usize;
    if read_len > buf_capacity { read_len = buf_capacity; }
    if read_len < 2 { read_len = 2; }

    // No protocolo HID-over-I2C de referência (Linux), o serviço de IRQ realiza
    // uma transação READ pura diretamente no endereço do escravo.
    let status = i2c_device_read(
        dev.i2c_device_id,
        dev.i2c_generation,
        out_buf,
        read_len
    );

    if status != I2C_STATUS_OK {
        return status;
    }

    // Decodifica o comprimento do relatório (primeiros 2 bytes LE)
    let wire_length = unsafe {
        (out_buf[0] as usize) | ((out_buf[1] as usize) << 8)
    };

    if wire_length == 0 {
        // Handshake de confirmação de RESET ou frame nulo
        let clear_flags = x86_irq_save_disable();
        unsafe {
            if I2C_HID_INPUT_LOCK_READY && spinlock_lock(&mut I2C_HID_INPUT_LOCK) {
                if I2C_HID_INPUT_READY && I2C_HID_INPUT_DEVICES[device_index].valid {
                    I2C_HID_INPUT_DEVICES[device_index].pending_irq = false;
                }
                spinlock_unlock(&mut I2C_HID_INPUT_LOCK);
            }
        }
        x86_irq_restore(clear_flags);
        return I2C_STATUS_OK;
    }

    if wire_length == 1 || wire_length > read_len {
        return I2C_STATUS_INVALID;
    }

    let payload_len = wire_length - 2;
    unsafe {
        *out_report_len = payload_len;
        let finish_flags = x86_irq_save_disable();
        if I2C_HID_INPUT_LOCK_READY && spinlock_lock(&mut I2C_HID_INPUT_LOCK) {
            if I2C_HID_INPUT_READY && I2C_HID_INPUT_DEVICES[device_index].valid {
                I2C_HID_INPUT_DEVICES[device_index].pending_irq = false;
                I2C_HID_INPUT_DEVICES[device_index].reports_received += 1;
            }
            spinlock_unlock(&mut I2C_HID_INPUT_LOCK);
        }
        x86_irq_restore(finish_flags);
    }

    if payload_len > 0 && dev.input_device_id != 0 && dev.input_device_generation != 0 {
        unsafe {
            let report_ptr = ((out_buf as usize) + 2) as *const u8;
            hid_input_events_process_report_for_device(
                dev.input_device_id,
                dev.input_device_generation,
                report_ptr,
                payload_len
            );
        }
    }

    return I2C_STATUS_OK;
}

@system
pub fn i2c_hid_input_has_pending_irq(device_index: usize) -> bool {
    if device_index >= I2C_HID_MAX_INPUT_DEVICES { return false; }
    let flags = x86_irq_save_disable();
    let mut pending = false;
    unsafe {
        if I2C_HID_INPUT_LOCK_READY && spinlock_lock(&mut I2C_HID_INPUT_LOCK) {
            if I2C_HID_INPUT_READY && I2C_HID_INPUT_DEVICES[device_index].valid {
                pending = I2C_HID_INPUT_DEVICES[device_index].pending_irq;
            }
            spinlock_unlock(&mut I2C_HID_INPUT_LOCK);
        }
    }
    x86_irq_restore(flags);
    return pending;
}

@system
pub fn i2c_hid_input_get_input_device_id(device_index: usize) -> u32 {
    if device_index >= I2C_HID_MAX_INPUT_DEVICES { return 0; }
    let flags = x86_irq_save_disable();
    let mut dev_id: u32 = 0;
    unsafe {
        if I2C_HID_INPUT_LOCK_READY && spinlock_lock(&mut I2C_HID_INPUT_LOCK) {
            if I2C_HID_INPUT_READY && I2C_HID_INPUT_DEVICES[device_index].valid {
                dev_id = I2C_HID_INPUT_DEVICES[device_index].input_device_id;
            }
            spinlock_unlock(&mut I2C_HID_INPUT_LOCK);
        }
    }
    x86_irq_restore(flags);
    return dev_id;
}

@system
pub fn i2c_hid_input_get_input_device_generation(device_index: usize) -> u32 {
    if device_index >= I2C_HID_MAX_INPUT_DEVICES { return 0; }
    let flags = x86_irq_save_disable();
    let mut gen: u32 = 0;
    unsafe {
        if I2C_HID_INPUT_LOCK_READY && spinlock_lock(&mut I2C_HID_INPUT_LOCK) {
            if I2C_HID_INPUT_READY && I2C_HID_INPUT_DEVICES[device_index].valid {
                gen = I2C_HID_INPUT_DEVICES[device_index].input_device_generation;
            }
            spinlock_unlock(&mut I2C_HID_INPUT_LOCK);
        }
    }
    x86_irq_restore(flags);
    return gen;
}

@system
pub fn i2c_hid_input_device_count() -> usize {
    let flags = x86_irq_save_disable();
    let mut count: usize = 0;
    unsafe {
        if !I2C_HID_INPUT_LOCK_READY || !spinlock_lock(&mut I2C_HID_INPUT_LOCK) {
            x86_irq_restore(flags);
            return 0;
        }
        if I2C_HID_INPUT_READY { count = I2C_HID_INPUT_COUNT; }
        spinlock_unlock(&mut I2C_HID_INPUT_LOCK);
    }
    x86_irq_restore(flags);
    return count;
}
