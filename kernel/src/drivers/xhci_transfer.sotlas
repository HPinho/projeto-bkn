// Baken OS — HID-4c.4e/HID-4d.3b2: demultiplexação bounded de Transfer Events.
//
// O Event Ring continua com consumidor global único. Events já consumidos são
// preservados em uma mailbox por slot+epoch até o waiter dono daquele transfer
// recolher o resultado. Matching/take no caminho generation-sensitive usam
// slot+epoch+endpoint+TRB pointer explícitos; wrappers slot-only ficam apenas
// para compatibilidade. HID-4d.2b reconhece somente completions terminais
// válidas produzidas por Stop Endpoint, sem transformar outros erros em sucesso.

module kernel::drivers::xhci_transfer;

import kernel::arch::x86_64::cpu::*;
import kernel::drivers::xhci_controller::*;
import kernel::drivers::xhci_start::*;
import kernel::drivers::xhci_ring::*;
import kernel::drivers::xhci_event::*;
import kernel::drivers::xhci_event_consumer::*;
import kernel::drivers::xhci_device_table::*;

pub const XHCI_TRANSFER_POLL_LIMIT: u64 = 10000000;
pub const XHCI_TRANSFER_EP0_ENDPOINT_ID: u8 = 1;
pub const XHCI_TRANSFER_SLOT_CAPACITY: usize = XHCI_DEVICE_SLOT_CAPACITY;

pub struct XhciTransferResult {
    pub valid: bool;
    pub epoch: u32;
    pub endpoint_id: u8;
    pub residual_length: u32;
    pub completion_code: u8;
}

pub struct XhciTransferPendingEvent {
    pub valid: bool;
    pub epoch: u32;
    pub endpoint_id: u8;
    pub trb_pointer: u64;
    pub residual_length: u32;
    pub completion_code: u8;
}

static mut XHCI_TRANSFER_RESULTS: [XhciTransferResult; XHCI_TRANSFER_SLOT_CAPACITY] = [
    XhciTransferResult {
        valid: false,
        epoch: 0,
        endpoint_id: 0,
        residual_length: 0,
        completion_code: 0
    };
    XHCI_TRANSFER_SLOT_CAPACITY
];

static mut XHCI_TRANSFER_PENDING_EVENTS: [XhciTransferPendingEvent; XHCI_TRANSFER_SLOT_CAPACITY] = [
    XhciTransferPendingEvent {
        valid: false,
        epoch: 0,
        endpoint_id: 0,
        trb_pointer: 0,
        residual_length: 0,
        completion_code: 0
    };
    XHCI_TRANSFER_SLOT_CAPACITY
];

static mut XHCI_TRANSFER_ACTIVE_SLOT_ID: u8 = 0;
static mut XHCI_TRANSFER_ROUTED_EVENT_COUNT: u64 = 0;

@system
fn xhci_transfer_index(slot_id: u8) -> usize {
    if slot_id == 0 { return XHCI_TRANSFER_SLOT_CAPACITY; }
    return slot_id as usize;
}

@system
fn xhci_transfer_clear_result(slot_id: u8, epoch: u32, endpoint_id: u8) -> bool {
    let index = xhci_transfer_index(slot_id);
    if index >= XHCI_TRANSFER_SLOT_CAPACITY || epoch == 0 || endpoint_id == 0 { return false; }
    unsafe {
        XHCI_TRANSFER_RESULTS[index].valid = false;
        XHCI_TRANSFER_RESULTS[index].epoch = epoch;
        XHCI_TRANSFER_RESULTS[index].endpoint_id = endpoint_id;
        XHCI_TRANSFER_RESULTS[index].residual_length = 0;
        XHCI_TRANSFER_RESULTS[index].completion_code = 0;
        XHCI_TRANSFER_ACTIVE_SLOT_ID = slot_id;
    }
    return true;
}

@system
fn xhci_transfer_clear_pending_index(index: usize) -> bool {
    if index >= XHCI_TRANSFER_SLOT_CAPACITY { return false; }
    unsafe {
        XHCI_TRANSFER_PENDING_EVENTS[index].valid = false;
        XHCI_TRANSFER_PENDING_EVENTS[index].epoch = 0;
        XHCI_TRANSFER_PENDING_EVENTS[index].endpoint_id = 0;
        XHCI_TRANSFER_PENDING_EVENTS[index].trb_pointer = 0;
        XHCI_TRANSFER_PENDING_EVENTS[index].residual_length = 0;
        XHCI_TRANSFER_PENDING_EVENTS[index].completion_code = 0;
    }
    return true;
}

// HID-4d.3b: gate exato para limpar somente estado lógico de transfer após
// Stop Endpoint + drain. O caller de lifecycle ainda é responsável por provar
// endpoint_stopped/quiescence; este módulo não importa o lifecycle para manter
// o grafo acíclico. DETACH_PENDING impede novos submits para esta geração.
@system
fn xhci_transfer_teardown_epoch_matches(slot_id: u8, epoch: u32) -> bool {
    let index = xhci_transfer_index(slot_id);
    if index >= XHCI_TRANSFER_SLOT_CAPACITY || epoch == 0 ||
       !xhci_device_table_slot_is_valid(slot_id) ||
       xhci_device_table_slot_epoch(slot_id) != epoch ||
       xhci_device_table_state(slot_id) != XHCI_DEVICE_STATE_DETACH_PENDING {
        return false;
    }
    return true;
}

// Limpa mailbox/result lógico do slot+epoch sem consumir Event Ring e sem tocar
// no Transfer Ring físico. Qualquer mailbox ainda válida bloqueia o teardown:
// same-epoch significa completion ainda não drenada; foreign-epoch é violação de
// invariante enquanto Slot ID físico não pode ser reutilizado antes de HID-4d.5.
// Resultado terminal do mesmo epoch pode ser descartado, mas um resultado válido
// de outro epoch também falha fechado em vez de apagar estado desconhecido.
@system
pub fn xhci_transfer_clear_slot_state_for_epoch(slot_id: u8, epoch: u32) -> bool {
    if !xhci_transfer_teardown_epoch_matches(slot_id, epoch) { return false; }
    let index = xhci_transfer_index(slot_id);
    if index >= XHCI_TRANSFER_SLOT_CAPACITY { return false; }

    unsafe {
        if XHCI_TRANSFER_PENDING_EVENTS[index].valid { return false; }
        if XHCI_TRANSFER_RESULTS[index].valid &&
           XHCI_TRANSFER_RESULTS[index].epoch != epoch {
            return false;
        }
    }
    if !xhci_transfer_teardown_epoch_matches(slot_id, epoch) { return false; }

    // Revalida imediatamente antes da mutação. DETACH_PENDING + proibição de
    // slot reuse antes de 4d.5 tornam qualquer foreign-epoch válido um erro de
    // invariantes, nunca um estado que o cleanup possa silenciosamente apagar.
    unsafe {
        if XHCI_TRANSFER_PENDING_EVENTS[index].valid { return false; }
        if XHCI_TRANSFER_RESULTS[index].valid &&
           XHCI_TRANSFER_RESULTS[index].epoch != epoch {
            return false;
        }
    }
    if !xhci_transfer_clear_pending_index(index) { return false; }
    if !xhci_transfer_teardown_epoch_matches(slot_id, epoch) { return false; }

    unsafe {
        XHCI_TRANSFER_RESULTS[index].valid = false;
        XHCI_TRANSFER_RESULTS[index].epoch = 0;
        XHCI_TRANSFER_RESULTS[index].endpoint_id = 0;
        XHCI_TRANSFER_RESULTS[index].residual_length = 0;
        XHCI_TRANSFER_RESULTS[index].completion_code = 0;
        if XHCI_TRANSFER_ACTIVE_SLOT_ID == slot_id {
            XHCI_TRANSFER_ACTIVE_SLOT_ID = 0;
        }
    }
    return xhci_transfer_teardown_epoch_matches(slot_id, epoch);
}

// HID-4d.3b2 prerequisite: exact-generation mailbox query. Unlike the
// compatibility wrapper, this function never follows the slot's implicit
// current epoch and never mutates a stale mailbox while answering a query.
@system
pub fn xhci_transfer_pending_is_ready_for_epoch(slot_id: u8, epoch: u32) -> bool {
    let index = xhci_transfer_index(slot_id);
    if index >= XHCI_TRANSFER_SLOT_CAPACITY || epoch == 0 ||
       !xhci_device_table_slot_is_valid(slot_id) ||
       xhci_device_table_slot_epoch(slot_id) != epoch {
        return false;
    }

    let mut ready = false;
    unsafe {
        ready = XHCI_TRANSFER_PENDING_EVENTS[index].valid &&
                XHCI_TRANSFER_PENDING_EVENTS[index].epoch == epoch &&
                XHCI_TRANSFER_PENDING_EVENTS[index].endpoint_id != 0 &&
                XHCI_TRANSFER_PENDING_EVENTS[index].trb_pointer != 0;
    }

    if !xhci_device_table_slot_is_valid(slot_id) ||
       xhci_device_table_slot_epoch(slot_id) != epoch {
        return false;
    }
    return ready;
}

@system
pub fn xhci_transfer_pending_is_ready_for(slot_id: u8) -> bool {
    let index = xhci_transfer_index(slot_id);
    if index >= XHCI_TRANSFER_SLOT_CAPACITY || !xhci_device_table_slot_is_valid(slot_id) {
        return false;
    }
    let epoch = xhci_device_table_slot_epoch(slot_id);
    if epoch == 0 { return false; }
    unsafe {
        if XHCI_TRANSFER_PENDING_EVENTS[index].valid &&
           XHCI_TRANSFER_PENDING_EVENTS[index].epoch != epoch {
            xhci_transfer_clear_pending_index(index);
            return false;
        }
    }
    return xhci_transfer_pending_is_ready_for_epoch(slot_id, epoch);
}

// Exact demux identity for a waiter that already captured the slot epoch.
// The mailbox is consulted without side effects and the device-table epoch is
// revalidated by xhci_transfer_pending_is_ready_for_epoch before and after read.
@system
pub fn xhci_transfer_pending_matches_for_epoch(slot_id: u8,
                                               epoch: u32,
                                               endpoint_id: u8,
                                               completion_trb_physical: u64) -> bool {
    if epoch == 0 || endpoint_id == 0 || completion_trb_physical == 0 ||
       !xhci_transfer_pending_is_ready_for_epoch(slot_id, epoch) {
        return false;
    }
    let index = xhci_transfer_index(slot_id);
    if index >= XHCI_TRANSFER_SLOT_CAPACITY { return false; }
    let mut matches = false;
    unsafe {
        matches = XHCI_TRANSFER_PENDING_EVENTS[index].epoch == epoch &&
                  XHCI_TRANSFER_PENDING_EVENTS[index].endpoint_id == endpoint_id &&
                  XHCI_TRANSFER_PENDING_EVENTS[index].trb_pointer == completion_trb_physical;
    }
    if !xhci_transfer_pending_is_ready_for_epoch(slot_id, epoch) { return false; }
    return matches;
}

@system
pub fn xhci_transfer_pending_matches(slot_id: u8,
                                     endpoint_id: u8,
                                     completion_trb_physical: u64) -> bool {
    if endpoint_id == 0 || completion_trb_physical == 0 ||
       !xhci_transfer_pending_is_ready_for(slot_id) {
        return false;
    }
    let epoch = xhci_device_table_slot_epoch(slot_id);
    if epoch == 0 { return false; }
    return xhci_transfer_pending_matches_for_epoch(
        slot_id, epoch, endpoint_id, completion_trb_physical
    );
}

@system
fn xhci_transfer_publish_pending_event(event: *const XhciTrb) -> bool {
    if event == (null as *const XhciTrb) ||
       xhci_event_type(event) != XHCI_TRB_TYPE_TRANSFER_EVENT ||
       xhci_transfer_event_has_event_data(event) {
        return false;
    }

    let slot_id = xhci_event_slot_id(event);
    let endpoint_id = xhci_transfer_event_endpoint_id(event);
    let trb_pointer = xhci_transfer_event_trb_pointer(event);
    if slot_id == 0 || endpoint_id == 0 || trb_pointer == 0 ||
       !xhci_device_table_slot_is_valid(slot_id) {
        return false;
    }

    let epoch = xhci_device_table_slot_epoch(slot_id);
    let index = xhci_transfer_index(slot_id);
    if epoch == 0 || index >= XHCI_TRANSFER_SLOT_CAPACITY { return false; }

    // O xHCI Event TRB não carrega o epoch de software. Até HID-4d.5, Slot ID
    // não pode ser reutilizado antes do drain/barrier que prove ausência de
    // completions antigas. O publisher registra o epoch corrente; waiters
    // antigos nunca podem tomar esta mailbox graças ao matching exact-epoch.
    unsafe {
        if XHCI_TRANSFER_PENDING_EVENTS[index].valid &&
           XHCI_TRANSFER_PENDING_EVENTS[index].epoch == epoch {
            return false;
        }
        if XHCI_TRANSFER_PENDING_EVENTS[index].valid {
            xhci_transfer_clear_pending_index(index);
        }
        XHCI_TRANSFER_PENDING_EVENTS[index].valid = true;
        XHCI_TRANSFER_PENDING_EVENTS[index].epoch = epoch;
        XHCI_TRANSFER_PENDING_EVENTS[index].endpoint_id = endpoint_id;
        XHCI_TRANSFER_PENDING_EVENTS[index].trb_pointer = trb_pointer;
        XHCI_TRANSFER_PENDING_EVENTS[index].residual_length =
            xhci_transfer_event_residual_length(event);
        XHCI_TRANSFER_PENDING_EVENTS[index].completion_code =
            xhci_event_completion_code(event);
    }

    if !xhci_event_consumer_consume() {
        xhci_transfer_clear_pending_index(index);
        return false;
    }
    unsafe { XHCI_TRANSFER_ROUTED_EVENT_COUNT += 1; }
    return true;
}

@system
fn xhci_transfer_take_pending(slot_id: u8,
                              epoch: u32,
                              endpoint_id: u8,
                              completion_trb_physical: u64) -> bool {
    let index = xhci_transfer_index(slot_id);
    if index >= XHCI_TRANSFER_SLOT_CAPACITY || epoch == 0 ||
       !xhci_transfer_pending_matches_for_epoch(
           slot_id, epoch, endpoint_id, completion_trb_physical
       ) {
        return false;
    }

    let mut residual: u32 = 0;
    let mut completion: u8 = 0;
    unsafe {
        residual = XHCI_TRANSFER_PENDING_EVENTS[index].residual_length;
        completion = XHCI_TRANSFER_PENDING_EVENTS[index].completion_code;
    }
    if !xhci_transfer_pending_matches_for_epoch(
        slot_id, epoch, endpoint_id, completion_trb_physical
    ) {
        return false;
    }

    unsafe {
        XHCI_TRANSFER_RESULTS[index].valid = true;
        XHCI_TRANSFER_RESULTS[index].epoch = epoch;
        XHCI_TRANSFER_RESULTS[index].endpoint_id = endpoint_id;
        XHCI_TRANSFER_RESULTS[index].residual_length = residual;
        XHCI_TRANSFER_RESULTS[index].completion_code = completion;
        XHCI_TRANSFER_ACTIVE_SLOT_ID = slot_id;
        xhci_transfer_clear_pending_index(index);
        return completion == XHCI_COMPLETION_CODE_SUCCESS;
    }
}

@system
pub fn xhci_transfer_route_next_event() -> bool {
    if !xhci_start_is_ready() || !xhci_event_consumer_is_ready() { return false; }
    let operational = xhci_controller_operational_base();
    if operational == 0 { return false; }

    let mut spins: u64 = 0;
    while spins < XHCI_TRANSFER_POLL_LIMIT {
        let status = x86_mmio_read32(operational + XHCI_OP_USBSTS);
        if (status & XHCI_USBSTS_HOST_CONTROLLER_ERROR) != 0 { return false; }
        let event = xhci_event_consumer_peek();
        if event != (null as *const XhciTrb) {
            return xhci_transfer_publish_pending_event(event);
        }
        spins += 1;
    }
    return false;
}

@system
pub fn xhci_transfer_wait_completion(slot_id: u8,
                                     endpoint_id: u8,
                                     completion_trb_physical: u64) -> bool {
    if !xhci_start_is_ready() || !xhci_event_consumer_is_ready() ||
       !xhci_device_table_slot_is_valid(slot_id) {
        return false;
    }
    if slot_id == 0 || endpoint_id == 0 || completion_trb_physical == 0 { return false; }
    let epoch = xhci_device_table_slot_epoch(slot_id);
    if epoch == 0 || !xhci_transfer_clear_result(slot_id, epoch, endpoint_id) { return false; }

    let operational = xhci_controller_operational_base();
    if operational == 0 { return false; }

    if xhci_transfer_pending_is_ready_for_epoch(slot_id, epoch) {
        if !xhci_transfer_pending_matches_for_epoch(
            slot_id, epoch, endpoint_id, completion_trb_physical
        ) {
            return false;
        }
        return xhci_transfer_take_pending(
            slot_id, epoch, endpoint_id, completion_trb_physical
        );
    }

    let mut spins: u64 = 0;
    while spins < XHCI_TRANSFER_POLL_LIMIT {
        if !xhci_device_table_slot_is_valid(slot_id) ||
           xhci_device_table_slot_epoch(slot_id) != epoch {
            return false;
        }
        let status = x86_mmio_read32(operational + XHCI_OP_USBSTS);
        if (status & XHCI_USBSTS_HOST_CONTROLLER_ERROR) != 0 { return false; }

        let event = xhci_event_consumer_peek();
        if event != (null as *const XhciTrb) {
            if xhci_event_type(event) != XHCI_TRB_TYPE_TRANSFER_EVENT ||
               xhci_transfer_event_has_event_data(event) {
                return false;
            }
            let event_slot = xhci_event_slot_id(event);
            let event_endpoint = xhci_transfer_event_endpoint_id(event);
            let event_pointer = xhci_transfer_event_trb_pointer(event);
            if event_slot == slot_id &&
               (event_endpoint != endpoint_id || event_pointer != completion_trb_physical) {
                return false;
            }
            if !xhci_transfer_publish_pending_event(event) { return false; }
            if event_slot == slot_id {
                return xhci_transfer_take_pending(
                    slot_id, epoch, endpoint_id, completion_trb_physical
                );
            }
        }
        spins += 1;
    }
    return false;
}

// HID-4d.2b: Stop Endpoint pode terminar o TD com 26/27/28 em vez de SUCCESS.
// O waiter normal continua estrito; somente este caminho de lifecycle aceita os
// três Completion Codes terminais definidos pela xHCI, após endpoint/TRB exatos.
@system
pub fn xhci_transfer_wait_stopped_or_completed(slot_id: u8,
                                                endpoint_id: u8,
                                                completion_trb_physical: u64) -> bool {
    if xhci_transfer_wait_completion(slot_id, endpoint_id, completion_trb_physical) {
        return true;
    }
    if !xhci_transfer_result_is_valid_for(slot_id) ||
       xhci_transfer_last_endpoint_id_for(slot_id) != endpoint_id {
        return false;
    }
    let completion = xhci_transfer_last_completion_code_for(slot_id);
    return completion == XHCI_COMPLETION_CODE_STOPPED ||
           completion == XHCI_COMPLETION_CODE_STOPPED_LENGTH_INVALID ||
           completion == XHCI_COMPLETION_CODE_STOPPED_SHORT_PACKET;
}

@system
pub fn xhci_transfer_wait_ep0_completion(slot_id: u8,
                                         completion_trb_physical: u64) -> bool {
    return xhci_transfer_wait_completion(
        slot_id,
        XHCI_TRANSFER_EP0_ENDPOINT_ID,
        completion_trb_physical
    );
}

@system
pub fn xhci_transfer_result_is_valid_for(slot_id: u8) -> bool {
    let index = xhci_transfer_index(slot_id);
    if index >= XHCI_TRANSFER_SLOT_CAPACITY || !xhci_device_table_slot_is_valid(slot_id) {
        return false;
    }
    let epoch = xhci_device_table_slot_epoch(slot_id);
    unsafe {
        return epoch != 0 && XHCI_TRANSFER_RESULTS[index].valid &&
               XHCI_TRANSFER_RESULTS[index].epoch == epoch &&
               XHCI_TRANSFER_RESULTS[index].endpoint_id != 0;
    }
}

@system
pub fn xhci_transfer_last_residual_length_for(slot_id: u8) -> u32 {
    if !xhci_transfer_result_is_valid_for(slot_id) { return 0; }
    unsafe { return XHCI_TRANSFER_RESULTS[xhci_transfer_index(slot_id)].residual_length; }
}

@system
pub fn xhci_transfer_last_completion_code_for(slot_id: u8) -> u8 {
    if !xhci_transfer_result_is_valid_for(slot_id) { return 0; }
    unsafe { return XHCI_TRANSFER_RESULTS[xhci_transfer_index(slot_id)].completion_code; }
}

@system
pub fn xhci_transfer_last_endpoint_id_for(slot_id: u8) -> u8 {
    if !xhci_transfer_result_is_valid_for(slot_id) { return 0; }
    unsafe { return XHCI_TRANSFER_RESULTS[xhci_transfer_index(slot_id)].endpoint_id; }
}

@system
pub fn xhci_transfer_routed_event_count() -> u64 {
    unsafe { return XHCI_TRANSFER_ROUTED_EVENT_COUNT; }
}

@system
pub fn xhci_transfer_active_slot_id() -> u8 {
    unsafe { return XHCI_TRANSFER_ACTIVE_SLOT_ID; }
}

@system
pub fn xhci_transfer_last_residual_length() -> u32 {
    return xhci_transfer_last_residual_length_for(xhci_transfer_active_slot_id());
}

@system
pub fn xhci_transfer_last_completion_code() -> u8 {
    return xhci_transfer_last_completion_code_for(xhci_transfer_active_slot_id());
}