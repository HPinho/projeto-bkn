// Baken OS - backend de display canônico durante a migração bare-metal.
//
// Esta camada representa somente capacidades que realmente foram inicializadas.
// Encontrar uma GPU no PCI ou ler seus BARs NAO equivale a possuir um driver
// acelerado. Enquanto GPU HAL/VirtIO/Intel command submission nao existirem,
// o backend ativo e o framebuffer linear entregue pelo GOP.

module kernel::drivers::display_driver;

pub const DRIVER_TYPE_GENERIC_GOP: u32    = 1;
pub const DRIVER_TYPE_INTEL_DYNAMIC: u32  = 2;
pub const DRIVER_TYPE_VIRTIO_GPU: u32     = 3;
pub const DRIVER_TYPE_AMD_RADEON: u32     = 4;
pub const DRIVER_TYPE_NVIDIA_NATIVE: u32  = 5;

pub struct DisplayMode {
    pub width: u32;
    pub height: u32;
    pub pitch: u32;
    pub bytes_per_pixel: u32;
    pub refresh_rate_hz: u32;
}

pub struct DisplayDriver {
    pub driver_type: u32;
    pub driver_name: *const u8;
    pub device_desc: *const u8;
    pub vendor_name: *const u8;
    pub pci_bus: u8;
    pub pci_slot: u8;
    pub pci_func: u8;
    pub pci_vendor_id: u16;
    pub pci_device_id: u16;
    pub fb_base: *mut u32;
    pub fb_size_bytes: usize;
    pub width: u32;
    pub height: u32;
    pub pitch: u32;
    pub is_hardware_accelerated: bool;
    pub framebuffer_wc_active: bool;
    pub vsync_counter: u64;
}

static mut ACTIVE_DRIVER: DisplayDriver = DisplayDriver {
    driver_type: DRIVER_TYPE_GENERIC_GOP,
    driver_name: "Baken Software Framebuffer Backend\0".as_ptr(),
    device_desc: "GOP linear framebuffer; CPU rasterization\0".as_ptr(),
    vendor_name: "Firmware-provided framebuffer\0".as_ptr(),
    pci_bus: 0,
    pci_slot: 0,
    pci_func: 0,
    pci_vendor_id: 0,
    pci_device_id: 0,
    fb_base: null as *mut u32,
    fb_size_bytes: 0,
    width: 0,
    height: 0,
    pitch: 0,
    is_hardware_accelerated: false,
    framebuffer_wc_active: false,
    vsync_counter: 0,
};

static mut IS_DRIVER_INITIALIZED: bool = false;

// PAT/WC NAO e programado aqui. A politica correta exige:
//   CPUID -> IA32_PAT -> VMM page mapping -> PAT/PCD/PWT -> TLB coherence.
// Apenas escrever IA32_PAT nao altera sozinho o atributo do framebuffer.
// `framebuffer_wc_active` so podera ser marcado depois que o VMM confirmar o
// mapping WC da faixa fisica correspondente.

@system
pub fn display_driver_init(fb_base: *mut u32, width: u32, height: u32, pitch: u32) -> void {
    unsafe {
        ACTIVE_DRIVER.driver_type = DRIVER_TYPE_GENERIC_GOP;
        ACTIVE_DRIVER.driver_name = "Baken Software Framebuffer Backend\0".as_ptr();
        ACTIVE_DRIVER.device_desc = "GOP linear framebuffer; CPU rasterization\0".as_ptr();
        ACTIVE_DRIVER.vendor_name = "Firmware-provided framebuffer\0".as_ptr();
        ACTIVE_DRIVER.pci_bus = 0;
        ACTIVE_DRIVER.pci_slot = 0;
        ACTIVE_DRIVER.pci_func = 0;
        ACTIVE_DRIVER.pci_vendor_id = 0;
        ACTIVE_DRIVER.pci_device_id = 0;
        ACTIVE_DRIVER.fb_base = fb_base;
        ACTIVE_DRIVER.fb_size_bytes = (pitch as usize) * (height as usize) * 4;
        ACTIVE_DRIVER.width = width;
        ACTIVE_DRIVER.height = height;
        ACTIVE_DRIVER.pitch = pitch;
        ACTIVE_DRIVER.is_hardware_accelerated = false;
        ACTIVE_DRIVER.framebuffer_wc_active = false;
        ACTIVE_DRIVER.vsync_counter = 0;
        IS_DRIVER_INITIALIZED = fb_base != (null as *mut u32) && width > 0 && height > 0 && pitch >= width;
    }
}

// Chamado futuramente pelo VMM/PAT somente depois de o mapping WC estar
// efetivamente instalado nas page tables. Nao programa MSR nem PTE aqui.
@system
pub fn display_driver_set_framebuffer_wc_active(active: bool) -> void {
    unsafe {
        ACTIVE_DRIVER.framebuffer_wc_active = active;
    }
}

// Um backend GPU real deve chamar esta API apenas APOS inicializar command
// queues/rings, memoria, sincronizacao e present. Vendor ID isolado nao basta.
@system
pub fn display_driver_promote_hardware_backend(driver_type: u32,
                                                driver_name: *const u8,
                                                device_desc: *const u8,
                                                vendor_name: *const u8,
                                                bus: u8,
                                                slot: u8,
                                                func: u8,
                                                vendor_id: u16,
                                                device_id: u16) -> bool {
    if (driver_type != DRIVER_TYPE_INTEL_DYNAMIC &&
        driver_type != DRIVER_TYPE_VIRTIO_GPU &&
        driver_type != DRIVER_TYPE_AMD_RADEON &&
        driver_type != DRIVER_TYPE_NVIDIA_NATIVE) {
        return false;
    }
    if (driver_name == (null as *const u8) || device_desc == (null as *const u8)) {
        return false;
    }

    unsafe {
        ACTIVE_DRIVER.driver_type = driver_type;
        ACTIVE_DRIVER.driver_name = driver_name;
        ACTIVE_DRIVER.device_desc = device_desc;
        ACTIVE_DRIVER.vendor_name = vendor_name;
        ACTIVE_DRIVER.pci_bus = bus;
        ACTIVE_DRIVER.pci_slot = slot;
        ACTIVE_DRIVER.pci_func = func;
        ACTIVE_DRIVER.pci_vendor_id = vendor_id;
        ACTIVE_DRIVER.pci_device_id = device_id;
        ACTIVE_DRIVER.is_hardware_accelerated = true;
    }
    return true;
}

@system
pub fn display_driver_present_frame(backbuffer: *const u32,
                                    dirty_x: u32,
                                    dirty_y: u32,
                                    dirty_w: u32,
                                    dirty_h: u32) -> void {
    unsafe {
        if !IS_DRIVER_INITIALIZED ||
           backbuffer == (null as *const u32) ||
           ACTIVE_DRIVER.fb_base == (null as *mut u32) {
            return;
        }

        let target_fb = ACTIVE_DRIVER.fb_base;
        let pitch = ACTIVE_DRIVER.pitch;

        if dirty_w == 0 || dirty_h == 0 ||
           (dirty_w >= ACTIVE_DRIVER.width && dirty_h >= ACTIVE_DRIVER.height) {
            let total_bytes = (pitch * ACTIVE_DRIVER.height * 4) as usize;
            baken_fast_memcpy(target_fb as *mut void, backbuffer as *const void, total_bytes);
            ACTIVE_DRIVER.vsync_counter += 1;
            return;
        }

        let max_x = if (dirty_x + dirty_w) > ACTIVE_DRIVER.width {
            ACTIVE_DRIVER.width
        } else {
            dirty_x + dirty_w
        };
        let max_y = if (dirty_y + dirty_h) > ACTIVE_DRIVER.height {
            ACTIVE_DRIVER.height
        } else {
            dirty_y + dirty_h
        };
        let copy_width_pixels = if max_x > dirty_x { max_x - dirty_x } else { 0 };
        let copy_bytes = (copy_width_pixels * 4) as usize;

        if copy_bytes > 0 {
            for mut y in dirty_y..max_y {
                let offset = (y * pitch + dirty_x) as usize;
                let dst_ptr = target_fb + offset;
                let src_ptr = backbuffer + offset;
                baken_fast_memcpy(dst_ptr as *mut void, src_ptr as *const void, copy_bytes);
            }
        }

        ACTIVE_DRIVER.vsync_counter += 1;
    }
}

@system
pub fn display_driver_wait_vsync() -> void {
    // Ponte temporaria: o time subsystem nativo substituira este pacing UEFI.
    let start = baken_rdtsc();
    baken_efi_frame_wait(start);
}

@system
pub fn display_driver_get_type() -> u32 {
    unsafe { return ACTIVE_DRIVER.driver_type; }
}

@system
pub fn display_driver_get_name() -> *const u8 {
    unsafe { return ACTIVE_DRIVER.driver_name; }
}

@system
pub fn display_driver_get_device_desc() -> *const u8 {
    unsafe { return ACTIVE_DRIVER.device_desc; }
}

@system
pub fn display_driver_get_vendor_name() -> *const u8 {
    unsafe { return ACTIVE_DRIVER.vendor_name; }
}

@system
pub fn display_driver_is_accelerated() -> bool {
    unsafe { return ACTIVE_DRIVER.is_hardware_accelerated; }
}

@system
pub fn display_driver_is_framebuffer_wc() -> bool {
    unsafe { return ACTIVE_DRIVER.framebuffer_wc_active; }
}

@system
pub fn display_driver_get_vram_size_mb() -> u32 {
    // O backend GOP nao conhece VRAM real. Retornar o tamanho do framebuffer
    // como "VRAM" produziria telemetria ficticia.
    return 0;
}

@system
pub fn display_driver_get_mmio_size_kb() -> u32 {
    // Nenhum BAR MMIO e mapeado pelo backend GOP.
    return 0;
}

@system
pub fn display_driver_get_pci_bus() -> u8 {
    unsafe { return ACTIVE_DRIVER.pci_bus; }
}

@system
pub fn display_driver_get_pci_slot() -> u8 {
    unsafe { return ACTIVE_DRIVER.pci_slot; }
}

@system
pub fn display_driver_get_pci_func() -> u8 {
    unsafe { return ACTIVE_DRIVER.pci_func; }
}

@system
pub fn display_driver_get_vendor_id() -> u16 {
    unsafe { return ACTIVE_DRIVER.pci_vendor_id; }
}

@system
pub fn display_driver_get_device_id() -> u16 {
    unsafe { return ACTIVE_DRIVER.pci_device_id; }
}
