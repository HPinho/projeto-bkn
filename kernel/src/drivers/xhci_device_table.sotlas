// Baken OS — HID-4c/HID-4d: registro bounded de devices xHCI por Slot ID.
//
// O xHC pode manter múltiplos slots ativos simultaneamente. Este módulo separa
// identidade de transporte (slot/porta/tipo) do "device atual" usado pelos
// wrappers legados e oferece storage fixed-capacity, sem heap, protegido por
// spinlock. Slot ID 0 permanece inválido; índices 1..255 correspondem ao ID xHCI.
// HID-4d.1 introduz DETACH_PENDING somente por transição dedicada generation-safe.

module kernel::drivers::xhci_device_table;

import kernel::sync::spinlock::*;

pub const XHCI_DEVICE_SLOT_CAPACITY: usize = 256;
pub const XHCI_DEVICE_SLOT_INVALID: u8 = 0;
pub const XHCI_DEVICE_STATE_EMPTY: u8 = 0;
pub const XHCI_DEVICE_STATE_ENABLED: u8 = 1;
pub const XHCI_DEVICE_STATE_CONTEXT_READY: u8 = 2;
pub const XHCI_DEVICE_STATE_ADDRESSED: u8 = 3;
pub const XHCI_DEVICE_STATE_HID_READY: u8 = 4;
pub const XHCI_DEVICE_STATE_FAILED: u8 = 5;
pub const XHCI_DEVICE_STATE_DETACH_PENDING: u8 = 6;

pub struct XhciDeviceSlotRecord {
    pub valid: bool;
    pub slot_id: u8;
    pub port_id: u8;
    pub slot_type: u8;
    pub state: u8;
    pub epoch: u32;
}

static mut XHCI_DEVICE_SLOTS: [XhciDeviceSlotRecord; XHCI_DEVICE_SLOT_CAPACITY] = [
    XhciDeviceSlotRecord {
        valid: false,
        slot_id: 0,
        port_id: 0,
        slot_type: 0,
        state: XHCI_DEVICE_STATE_EMPTY,
        epoch: 0
    };
    XHCI_DEVICE_SLOT_CAPACITY
];
static mut XHCI_DEVICE_SLOT_EPOCHS: [u32; XHCI_DEVICE_SLOT_CAPACITY] = [0; XHCI_DEVICE_SLOT_CAPACITY];
static mut XHCI_DEVICE_TABLE_LOCK: SpinLock = SpinLock { state: SPINLOCK_UNLOCKED };
static mut XHCI_DEVICE_TABLE_READY: bool = false;
static mut XHCI_DEVICE_ACTIVE_SLOT_ID: u8 = XHCI_DEVICE_SLOT_INVALID;
static mut XHCI_DEVICE_ACTIVE_COUNT: u16 = 0;

@system
fn xhci_device_table_index(slot_id: u8) -> usize {
    if slot_id == XHCI_DEVICE_SLOT_INVALID { return XHCI_DEVICE_SLOT_CAPACITY; }
    return slot_id as usize;
}

@system
fn xhci_device_table_clear_index(index: usize) -> bool {
    if index == 0 || index >= XHCI_DEVICE_SLOT_CAPACITY { return false; }
    unsafe {
        XHCI_DEVICE_SLOTS[index] = XhciDeviceSlotRecord {
            valid: false,
            slot_id: 0,
            port_id: 0,
            slot_type: 0,
            state: XHCI_DEVICE_STATE_EMPTY,
            epoch: XHCI_DEVICE_SLOT_EPOCHS[index]
        };
    }
    return true;
}

@system
pub fn xhci_device_table_initialize() -> bool {
    unsafe {
        if XHCI_DEVICE_TABLE_READY { return true; }
        if !spinlock_init(&mut XHCI_DEVICE_TABLE_LOCK) { return false; }
        let mut index: usize = 1;
        while index < XHCI_DEVICE_SLOT_CAPACITY {
            XHCI_DEVICE_SLOT_EPOCHS[index] = 0;
            if !xhci_device_table_clear_index(index) { return false; }
            index += 1;
        }
        XHCI_DEVICE_ACTIVE_SLOT_ID = XHCI_DEVICE_SLOT_INVALID;
        XHCI_DEVICE_ACTIVE_COUNT = 0;
        XHCI_DEVICE_TABLE_READY = true;
    }
    return true;
}

@system
pub fn xhci_device_table_is_ready() -> bool {
    unsafe { return XHCI_DEVICE_TABLE_READY; }
}

@system
pub fn xhci_device_table_reserve(slot_id: u8, port_id: u8, slot_type: u8) -> bool {
    if !xhci_device_table_initialize() || slot_id == 0 || port_id == 0 { return false; }
    let index = xhci_device_table_index(slot_id);
    if index >= XHCI_DEVICE_SLOT_CAPACITY { return false; }

    unsafe {
        if !spinlock_lock(&mut XHCI_DEVICE_TABLE_LOCK) { return false; }
        if XHCI_DEVICE_SLOTS[index].valid {
            spinlock_unlock(&mut XHCI_DEVICE_TABLE_LOCK);
            return false;
        }

        let mut epoch = XHCI_DEVICE_SLOT_EPOCHS[index] + 1;
        if epoch == 0 { epoch = 1; }
        XHCI_DEVICE_SLOT_EPOCHS[index] = epoch;
        XHCI_DEVICE_SLOTS[index] = XhciDeviceSlotRecord {
            valid: true,
            slot_id: slot_id,
            port_id: port_id,
            slot_type: slot_type,
            state: XHCI_DEVICE_STATE_ENABLED,
            epoch: epoch
        };
        XHCI_DEVICE_ACTIVE_SLOT_ID = slot_id;
        XHCI_DEVICE_ACTIVE_COUNT += 1;
        spinlock_unlock(&mut XHCI_DEVICE_TABLE_LOCK);
    }
    return true;
}

@system
pub fn xhci_device_table_release(slot_id: u8, epoch: u32) -> bool {
    if !xhci_device_table_is_ready() || slot_id == 0 || epoch == 0 { return false; }
    let index = xhci_device_table_index(slot_id);
    if index >= XHCI_DEVICE_SLOT_CAPACITY { return false; }

    unsafe {
        if !spinlock_lock(&mut XHCI_DEVICE_TABLE_LOCK) { return false; }
        if !XHCI_DEVICE_SLOTS[index].valid || XHCI_DEVICE_SLOTS[index].epoch != epoch {
            spinlock_unlock(&mut XHCI_DEVICE_TABLE_LOCK);
            return false;
        }
        if !xhci_device_table_clear_index(index) {
            spinlock_unlock(&mut XHCI_DEVICE_TABLE_LOCK);
            return false;
        }
        if XHCI_DEVICE_ACTIVE_COUNT > 0 { XHCI_DEVICE_ACTIVE_COUNT -= 1; }
        if XHCI_DEVICE_ACTIVE_SLOT_ID == slot_id {
            XHCI_DEVICE_ACTIVE_SLOT_ID = XHCI_DEVICE_SLOT_INVALID;
            let mut scan: usize = 1;
            while scan < XHCI_DEVICE_SLOT_CAPACITY {
                let candidate = &XHCI_DEVICE_SLOTS[scan];
                if candidate.valid &&
                   candidate.state != XHCI_DEVICE_STATE_FAILED &&
                   candidate.state != XHCI_DEVICE_STATE_DETACH_PENDING {
                    XHCI_DEVICE_ACTIVE_SLOT_ID = scan as u8;
                    break;
                }
                scan += 1;
            }
        }
        spinlock_unlock(&mut XHCI_DEVICE_TABLE_LOCK);
    }
    return true;
}

@system
pub fn xhci_device_table_set_state(slot_id: u8, epoch: u32, state: u8) -> bool {
    // DETACH_PENDING não entra por esta API genérica. A única transição pública
    // para esse estado é xhci_device_table_mark_detach_pending().
    if !xhci_device_table_is_ready() || slot_id == 0 || epoch == 0 ||
       state < XHCI_DEVICE_STATE_ENABLED || state > XHCI_DEVICE_STATE_FAILED {
        return false;
    }
    let index = xhci_device_table_index(slot_id);
    if index >= XHCI_DEVICE_SLOT_CAPACITY { return false; }
    unsafe {
        if !spinlock_lock(&mut XHCI_DEVICE_TABLE_LOCK) { return false; }
        if !XHCI_DEVICE_SLOTS[index].valid || XHCI_DEVICE_SLOTS[index].epoch != epoch {
            spinlock_unlock(&mut XHCI_DEVICE_TABLE_LOCK);
            return false;
        }
        XHCI_DEVICE_SLOTS[index].state = state;
        spinlock_unlock(&mut XHCI_DEVICE_TABLE_LOCK);
    }
    return true;
}

@system
pub fn xhci_device_table_mark_detach_pending(slot_id: u8, epoch: u32) -> bool {
    if !xhci_device_table_is_ready() || slot_id == 0 || epoch == 0 { return false; }
    let index = xhci_device_table_index(slot_id);
    if index >= XHCI_DEVICE_SLOT_CAPACITY { return false; }
    unsafe {
        if !spinlock_lock(&mut XHCI_DEVICE_TABLE_LOCK) { return false; }
        if !XHCI_DEVICE_SLOTS[index].valid || XHCI_DEVICE_SLOTS[index].epoch != epoch {
            spinlock_unlock(&mut XHCI_DEVICE_TABLE_LOCK);
            return false;
        }
        let state = XHCI_DEVICE_SLOTS[index].state;
        if state != XHCI_DEVICE_STATE_HID_READY && state != XHCI_DEVICE_STATE_DETACH_PENDING {
            spinlock_unlock(&mut XHCI_DEVICE_TABLE_LOCK);
            return false;
        }
        XHCI_DEVICE_SLOTS[index].state = XHCI_DEVICE_STATE_DETACH_PENDING;
        spinlock_unlock(&mut XHCI_DEVICE_TABLE_LOCK);
    }
    return true;
}

@system
pub fn xhci_device_table_set_active(slot_id: u8) -> bool {
    if !xhci_device_table_is_ready() || slot_id == 0 { return false; }
    let index = xhci_device_table_index(slot_id);
    if index >= XHCI_DEVICE_SLOT_CAPACITY { return false; }
    unsafe {
        let record = &XHCI_DEVICE_SLOTS[index];
        if !record.valid ||
           record.state == XHCI_DEVICE_STATE_FAILED ||
           record.state == XHCI_DEVICE_STATE_DETACH_PENDING {
            return false;
        }
        XHCI_DEVICE_ACTIVE_SLOT_ID = slot_id;
    }
    return true;
}

@system
pub fn xhci_device_table_slot_is_valid(slot_id: u8) -> bool {
    if !xhci_device_table_is_ready() || slot_id == 0 { return false; }
    let index = xhci_device_table_index(slot_id);
    if index >= XHCI_DEVICE_SLOT_CAPACITY { return false; }
    unsafe { return XHCI_DEVICE_SLOTS[index].valid; }
}

@system
pub fn xhci_device_table_slot_epoch(slot_id: u8) -> u32 {
    if !xhci_device_table_slot_is_valid(slot_id) { return 0; }
    unsafe { return XHCI_DEVICE_SLOTS[xhci_device_table_index(slot_id)].epoch; }
}

@system
pub fn xhci_device_table_port_id(slot_id: u8) -> u8 {
    if !xhci_device_table_slot_is_valid(slot_id) { return 0; }
    unsafe { return XHCI_DEVICE_SLOTS[xhci_device_table_index(slot_id)].port_id; }
}

@system
pub fn xhci_device_table_slot_type(slot_id: u8) -> u8 {
    if !xhci_device_table_slot_is_valid(slot_id) { return 0; }
    unsafe { return XHCI_DEVICE_SLOTS[xhci_device_table_index(slot_id)].slot_type; }
}

@system
pub fn xhci_device_table_state(slot_id: u8) -> u8 {
    if !xhci_device_table_slot_is_valid(slot_id) { return XHCI_DEVICE_STATE_EMPTY; }
    unsafe { return XHCI_DEVICE_SLOTS[xhci_device_table_index(slot_id)].state; }
}

@system
pub fn xhci_device_table_active_slot_id() -> u8 {
    unsafe { return XHCI_DEVICE_ACTIVE_SLOT_ID; }
}

@system
pub fn xhci_device_table_active_count() -> u16 {
    unsafe { return XHCI_DEVICE_ACTIVE_COUNT; }
}

@system
pub fn xhci_device_table_find_slot_for_port(port_id: u8) -> u8 {
    if !xhci_device_table_is_ready() || port_id == 0 { return 0; }
    unsafe {
        let mut index: usize = 1;
        while index < XHCI_DEVICE_SLOT_CAPACITY {
            if XHCI_DEVICE_SLOTS[index].valid && XHCI_DEVICE_SLOTS[index].port_id == port_id {
                return index as u8;
            }
            index += 1;
        }
    }
    return 0;
}
