// Baken OS — HID-4c.2 / HID-4d.3c2: Endpoint Context HID Interrupt IN por Slot ID.
//
// Cada slot xHCI possui DCI/ring/interval próprios e é validado contra o epoch
// do registro de transporte. O wrapper legado continua preparando o slot ativo
// usando o Configuration Descriptor singleton; HID-4c.3 removeu os acoplamentos
// de runtime multi-device, mas o wrapper permanece para o bring-up inicial.
//
// HID-4d.3c2 adiciona somente a primitiva de lifetime do HID Transfer Ring. A
// autorização física (Drop Endpoint + Output Endpoint Context Disabled) fica na
// camada lifecycle para evitar dependência circular. Aqui o buffer só percorre
// SHARED -> CPU-owned -> dma_release, com retry seguro se uma tentativa anterior
// já tiver concluído o unshare. Device/Input Context, EP0 ring e Slot ID não são
// liberados por este módulo.

module kernel::drivers::xhci_hid_context;

import kernel::arch::x86_64::cpu::*;
import kernel::memory::dma::*;
import kernel::memory::direct_map::*;
import kernel::drivers::xhci_context::*;
import kernel::drivers::xhci_device_table::*;
import kernel::drivers::xhci_configuration::*;
import kernel::drivers::xhci_port::*;
import kernel::drivers::xhci_slot::*;
import kernel::drivers::xhci_ring::*;
import kernel::drivers::xhci_trb::*;

pub const XHCI_HID_RING_SIZE: u64 = 4096;
pub const XHCI_HID_RING_TRBS: u32 = 256;
pub const XHCI_HID_CONTEXT_SLOT_CAPACITY: usize = XHCI_DEVICE_SLOT_CAPACITY;
pub const XHCI_ENDPOINT_CONTEXT_INTERVAL_SHIFT: u32 = 16;
pub const XHCI_ENDPOINT_CONTEXT_CERR_SHIFT: u32 = 1;
pub const XHCI_ENDPOINT_CONTEXT_CERR_3: u32 = 3;
pub const XHCI_ENDPOINT_CONTEXT_TYPE_SHIFT: u32 = 3;
pub const XHCI_ENDPOINT_TYPE_INTERRUPT_IN: u32 = 7;
pub const XHCI_ENDPOINT_CONTEXT_MAX_PACKET_SHIFT: u32 = 16;
pub const XHCI_ENDPOINT_CONTEXT_MAX_ESIT_PAYLOAD_SHIFT: u32 = 16;
pub const XHCI_ENDPOINT_CONTEXT_AVG_TRB_LENGTH: u32 = 8;
pub const XHCI_HID_MAX_CONTEXT_INDEX: u8 = 31;

pub struct XhciHidContextRecord {
    pub ready: bool;
    pub epoch: u32;
    pub dci: u8;
    pub endpoint_address: u8;
    pub max_packet: u16;
    pub interval: u8;
    pub ring: DmaBuffer;
    pub ring_physical: u64;
}

static mut XHCI_HID_CONTEXTS: [XhciHidContextRecord; XHCI_HID_CONTEXT_SLOT_CAPACITY] = [
    XhciHidContextRecord {
        ready: false,
        epoch: 0,
        dci: 0,
        endpoint_address: 0,
        max_packet: 0,
        interval: 0,
        ring: DmaBuffer {
            virtual_address: null as *mut u8,
            physical_address: 0,
            size: 0,
            alignment: 0,
            owner: DMA_OWNER_CPU,
            fence: 0,
            valid: false
        },
        ring_physical: 0
    };
    XHCI_HID_CONTEXT_SLOT_CAPACITY
];
static mut XHCI_HID_CONTEXT_ACTIVE_SLOT_ID: u8 = 0;

@system
fn xhci_hid_context_index(slot_id: u8) -> usize {
    if slot_id == 0 { return XHCI_HID_CONTEXT_SLOT_CAPACITY; }
    return slot_id as usize;
}

@system
fn xhci_hid_context_write32(base: *mut u8, offset: u64, value: u32) -> bool {
    if base == (null as *mut u8) { return false; }
    unsafe { *(((base as usize) + (offset as usize)) as *mut u32) = value; }
    return true;
}

@system
fn xhci_hid_context_write64(base: *mut u8, offset: u64, value: u64) -> bool {
    if base == (null as *mut u8) { return false; }
    unsafe { *(((base as usize) + (offset as usize)) as *mut u64) = value; }
    return true;
}

@system
fn xhci_hid_context_zero(base: *mut u8, size: u64) -> bool {
    if base == (null as *mut u8) || size == 0 { return false; }
    unsafe {
        let mut i: u64 = 0;
        while i < size {
            *(((base as usize) + (i as usize)) as *mut u8) = 0;
            i += 1;
        }
    }
    return true;
}

@system
fn xhci_hid_context_endpoint_number(address: u8) -> u8 {
    return address & 0x0F;
}

@system
fn xhci_hid_context_compute_dci(address: u8) -> u8 {
    let endpoint = xhci_hid_context_endpoint_number(address);
    if endpoint == 0 || (address & USB_ENDPOINT_DIRECTION_IN) == 0 { return 0; }
    let dci = ((endpoint as u16) * 2) + 1;
    if dci > (XHCI_HID_MAX_CONTEXT_INDEX as u16) { return 0; }
    return dci as u8;
}

@system
fn xhci_hid_context_ceil_log2(value: u32) -> u8 {
    if value <= 1 { return 0; }
    let mut power: u32 = 1;
    let mut exponent: u8 = 0;
    while power < value && exponent < 15 {
        power = power << 1;
        exponent += 1;
    }
    return exponent;
}

@system
fn xhci_hid_context_compute_interval(speed_id: u8, usb_interval: u8) -> u8 {
    if usb_interval == 0 { return 0; }
    if speed_id == 1 || speed_id == 2 {
        let microframes = (usb_interval as u32) * 8;
        let exponent = xhci_hid_context_ceil_log2(microframes);
        let encoded = exponent + 1;
        if encoded > 15 { return 15; }
        return encoded;
    }
    if speed_id >= 3 {
        let encoded = usb_interval - 1;
        if encoded > 15 { return 15; }
        return encoded;
    }
    return 0;
}

@system
fn xhci_hid_context_epoch_matches(slot_id: u8, epoch: u32) -> bool {
    let index = xhci_hid_context_index(slot_id);
    if index >= XHCI_HID_CONTEXT_SLOT_CAPACITY || epoch == 0 ||
       !xhci_device_table_slot_is_valid(slot_id) ||
       xhci_device_table_slot_epoch(slot_id) != epoch {
        return false;
    }
    unsafe { return XHCI_HID_CONTEXTS[index].epoch == epoch; }
}

@system
pub fn xhci_hid_context_is_ready_for(slot_id: u8) -> bool {
    let index = xhci_hid_context_index(slot_id);
    if index >= XHCI_HID_CONTEXT_SLOT_CAPACITY || !xhci_device_table_slot_is_valid(slot_id) {
        return false;
    }
    let epoch = xhci_device_table_slot_epoch(slot_id);
    if epoch == 0 { return false; }
    unsafe {
        return XHCI_HID_CONTEXTS[index].ready &&
               XHCI_HID_CONTEXTS[index].epoch == epoch;
    }
}

@system
pub fn xhci_hid_context_prepare_for_slot(slot_id: u8,
                                         endpoint_address: u8,
                                         max_packet: u16,
                                         usb_interval: u8) -> bool {
    if !xhci_context_is_ready_for(slot_id) || !xhci_device_table_slot_is_valid(slot_id) {
        return false;
    }
    let index = xhci_hid_context_index(slot_id);
    if index >= XHCI_HID_CONTEXT_SLOT_CAPACITY { return false; }
    let epoch = xhci_device_table_slot_epoch(slot_id);
    let port_id = xhci_device_table_port_id(slot_id);
    if epoch == 0 || port_id == 0 { return false; }

    unsafe {
        if XHCI_HID_CONTEXTS[index].ready && XHCI_HID_CONTEXTS[index].epoch == epoch {
            return XHCI_HID_CONTEXTS[index].endpoint_address == endpoint_address &&
                   XHCI_HID_CONTEXTS[index].max_packet == max_packet;
        }
        if XHCI_HID_CONTEXTS[index].ready { return false; }
        // Tombstone 3c2: um ring já liberado não pode ser recriado no mesmo
        // epoch antes de Disable Slot/reuse físico. Epoch novo pode sobrescrever
        // o tombstone somente depois da fronteira de reuse 4d.5.
        if XHCI_HID_CONTEXTS[index].epoch == epoch &&
           XHCI_HID_CONTEXTS[index].dci > 1 &&
           XHCI_HID_CONTEXTS[index].ring_physical == 0 &&
           !XHCI_HID_CONTEXTS[index].ring.valid {
            return false;
        }
    }

    let dci = xhci_hid_context_compute_dci(endpoint_address);
    if dci <= 1 || max_packet == 0 || usb_interval == 0 { return false; }
    let snapshot = xhci_port_snapshot(port_id);
    if snapshot == (null as *const XhciPortSnapshot) { return false; }
    let speed_id = unsafe { (*snapshot).speed_id };
    let interval = xhci_hid_context_compute_interval(speed_id, usb_interval);
    if interval == 0 || interval > 15 { return false; }

    let context_size = xhci_context_size_for(slot_id);
    let input_physical = xhci_context_input_physical_for(slot_id);
    let input_virtual = direct_map_virtual_address(input_physical);
    if (context_size != 32 && context_size != 64) || input_physical == 0 || input_virtual == 0 {
        return false;
    }
    let input = unsafe { input_virtual as *mut u8 };

    let mut ring_buffer = dma_alloc(XHCI_HID_RING_SIZE, XHCI_HID_RING_SIZE);
    if !dma_buffer_cpu_owned(&ring_buffer) ||
       !xhci_hid_context_zero(ring_buffer.virtual_address, ring_buffer.size) {
        return false;
    }
    let ring = xhci_ring_bind(ring_buffer, XHCI_HID_RING_TRBS);
    if !xhci_ring_is_ready(&ring) { return false; }
    let link_index = XHCI_HID_RING_TRBS - 1;
    unsafe {
        let link = ((ring.virtual_base as usize) + ((link_index as usize) * 16)) as *mut XhciTrb;
        *link = xhci_trb_link(ring.physical_base, true, true);
    }

    let drop_flags_offset: u64 = 0;
    let add_flags_offset: u64 = 4;
    let add_flag = 1 << (dci as u32);
    if !xhci_hid_context_write32(input, drop_flags_offset, 0) ||
       !xhci_hid_context_write32(input, add_flags_offset,
           XHCI_INPUT_CONTROL_ADD_SLOT | add_flag) { return false; }

    let slot_offset = context_size as u64;
    unsafe {
        let slot_dw0_ptr = ((input as usize) + (slot_offset as usize)) as *const u32;
        let slot_dw0 = *slot_dw0_ptr;
        let cleared = slot_dw0 & ~(0x1F << XHCI_SLOT_CONTEXT_ENTRIES_SHIFT);
        if !xhci_hid_context_write32(input, slot_offset,
            cleared | ((dci as u32) << XHCI_SLOT_CONTEXT_ENTRIES_SHIFT)) {
            return false;
        }
    }

    let endpoint_offset = ((dci as u64) + 1) * (context_size as u64);
    let ep_dw0 = (interval as u32) << XHCI_ENDPOINT_CONTEXT_INTERVAL_SHIFT;
    let ep_dw1 = (XHCI_ENDPOINT_CONTEXT_CERR_3 << XHCI_ENDPOINT_CONTEXT_CERR_SHIFT) |
        (XHCI_ENDPOINT_TYPE_INTERRUPT_IN << XHCI_ENDPOINT_CONTEXT_TYPE_SHIFT) |
        ((max_packet as u32) << XHCI_ENDPOINT_CONTEXT_MAX_PACKET_SHIFT);
    let ep_dw4 = XHCI_ENDPOINT_CONTEXT_AVG_TRB_LENGTH |
        ((max_packet as u32) << XHCI_ENDPOINT_CONTEXT_MAX_ESIT_PAYLOAD_SHIFT);
    if !xhci_hid_context_write32(input, endpoint_offset, ep_dw0) ||
       !xhci_hid_context_write32(input, endpoint_offset + 4, ep_dw1) ||
       !xhci_hid_context_write64(input, endpoint_offset + 8,
           ring.physical_base | XHCI_TR_DEQUEUE_DCS) ||
       !xhci_hid_context_write32(input, endpoint_offset + 16, ep_dw4) {
        return false;
    }

    if x86_read_cr3_raw() == 0 || !dma_share_with_device(&mut ring_buffer) { return false; }
    unsafe {
        XHCI_HID_CONTEXTS[index].ready = true;
        XHCI_HID_CONTEXTS[index].epoch = epoch;
        XHCI_HID_CONTEXTS[index].dci = dci;
        XHCI_HID_CONTEXTS[index].endpoint_address = endpoint_address;
        XHCI_HID_CONTEXTS[index].max_packet = max_packet;
        XHCI_HID_CONTEXTS[index].interval = interval;
        XHCI_HID_CONTEXTS[index].ring = ring_buffer;
        XHCI_HID_CONTEXTS[index].ring_physical = ring.physical_base;
        XHCI_HID_CONTEXT_ACTIVE_SLOT_ID = slot_id;
    }
    return true;
}

@system
pub fn xhci_hid_context_prepare() -> bool {
    let slot_id = xhci_context_slot_id();
    if slot_id == 0 || !xhci_configuration_is_ready() { return false; }
    return xhci_hid_context_prepare_for_slot(
        slot_id,
        xhci_hid_endpoint_address(),
        xhci_hid_endpoint_max_packet(),
        xhci_hid_endpoint_interval()
    );
}

// HID-4d.3c2 low-level lifetime primitive. A camada lifecycle é a única caller
// autorizada e prova previamente Drop Endpoint/Disabled. Este módulo não importa
// xhci_configure_endpoint para manter a direção de dependências acíclica.
//
// Retry-safe: se uma tentativa anterior já fez unshare e falhou no release, o
// buffer CPU-owned é aceito e a próxima tentativa retoma diretamente no free.
@system
pub fn xhci_hid_context_release_ring_for_epoch(slot_id: u8, epoch: u32) -> bool {
    if !xhci_hid_context_epoch_matches(slot_id, epoch) { return false; }
    let index = xhci_hid_context_index(slot_id);
    if index >= XHCI_HID_CONTEXT_SLOT_CAPACITY { return false; }

    if xhci_hid_context_ring_release_complete_for(slot_id, epoch) { return true; }

    unsafe {
        if !XHCI_HID_CONTEXTS[index].ready ||
           XHCI_HID_CONTEXTS[index].dci <= 1 ||
           XHCI_HID_CONTEXTS[index].ring_physical == 0 ||
           !XHCI_HID_CONTEXTS[index].ring.valid {
            return false;
        }
    }

    let mut shared = false;
    let mut cpu_owned = false;
    unsafe {
        shared = dma_buffer_shared(&XHCI_HID_CONTEXTS[index].ring);
        cpu_owned = dma_buffer_cpu_owned(&XHCI_HID_CONTEXTS[index].ring);
    }
    if !shared && !cpu_owned { return false; }

    if shared {
        unsafe {
            if !dma_unshare_from_device(&mut XHCI_HID_CONTEXTS[index].ring) {
                return false;
            }
        }
        if !xhci_hid_context_epoch_matches(slot_id, epoch) { return false; }
    }

    unsafe {
        if !dma_buffer_cpu_owned(&XHCI_HID_CONTEXTS[index].ring) {
            return false;
        }
    }
    if !xhci_hid_context_epoch_matches(slot_id, epoch) { return false; }

    unsafe {
        if !dma_release(&mut XHCI_HID_CONTEXTS[index].ring) {
            return false;
        }
        if XHCI_HID_CONTEXTS[index].epoch != epoch ||
           XHCI_HID_CONTEXTS[index].ring.valid {
            return false;
        }
        XHCI_HID_CONTEXTS[index].ready = false;
        XHCI_HID_CONTEXTS[index].ring = dma_invalid_buffer();
        XHCI_HID_CONTEXTS[index].ring_physical = 0;
    }

    return xhci_hid_context_ring_release_complete_for(slot_id, epoch);
}

@system
pub fn xhci_hid_context_ring_release_complete_for(slot_id: u8, epoch: u32) -> bool {
    if !xhci_hid_context_epoch_matches(slot_id, epoch) { return false; }
    let index = xhci_hid_context_index(slot_id);
    if index >= XHCI_HID_CONTEXT_SLOT_CAPACITY { return false; }
    unsafe {
        return !XHCI_HID_CONTEXTS[index].ready &&
               XHCI_HID_CONTEXTS[index].dci > 1 &&
               XHCI_HID_CONTEXTS[index].ring_physical == 0 &&
               !XHCI_HID_CONTEXTS[index].ring.valid;
    }
}

@system
pub fn xhci_hid_context_dci_for(slot_id: u8) -> u8 {
    if !xhci_hid_context_is_ready_for(slot_id) { return 0; }
    unsafe { return XHCI_HID_CONTEXTS[xhci_hid_context_index(slot_id)].dci; }
}

@system
pub fn xhci_hid_context_ring_physical_for(slot_id: u8) -> u64 {
    if !xhci_hid_context_is_ready_for(slot_id) { return 0; }
    unsafe { return XHCI_HID_CONTEXTS[xhci_hid_context_index(slot_id)].ring_physical; }
}

@system
pub fn xhci_hid_context_interval_for(slot_id: u8) -> u8 {
    if !xhci_hid_context_is_ready_for(slot_id) { return 0; }
    unsafe { return XHCI_HID_CONTEXTS[xhci_hid_context_index(slot_id)].interval; }
}

@system
pub fn xhci_hid_context_max_packet_for(slot_id: u8) -> u16 {
    if !xhci_hid_context_is_ready_for(slot_id) { return 0; }
    unsafe { return XHCI_HID_CONTEXTS[xhci_hid_context_index(slot_id)].max_packet; }
}

@system
pub fn xhci_hid_context_active_slot_id() -> u8 {
    unsafe { return XHCI_HID_CONTEXT_ACTIVE_SLOT_ID; }
}

@system
pub fn xhci_hid_context_is_ready() -> bool {
    return xhci_hid_context_is_ready_for(xhci_hid_context_active_slot_id());
}
@system
pub fn xhci_hid_context_dci() -> u8 {
    return xhci_hid_context_dci_for(xhci_hid_context_active_slot_id());
}
@system
pub fn xhci_hid_context_ring_physical() -> u64 {
    return xhci_hid_context_ring_physical_for(xhci_hid_context_active_slot_id());
}
@system
pub fn xhci_hid_context_interval() -> u8 {
    return xhci_hid_context_interval_for(xhci_hid_context_active_slot_id());
}
