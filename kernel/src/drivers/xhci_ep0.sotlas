// Baken OS — HID-4c.3: produtor stateful do EP0 Transfer Ring por Slot ID.
//
// Cada slot endereçado mantém enqueue index, Producer Cycle State e correlação
// do último Status TRB separados por epoch. O Event Ring continua tendo um único
// consumidor global, mas todo Control TD é atribuído explicitamente ao slot que
// possui o EP0 ring. Wrappers legados preservam o bring-up do primeiro device.

module kernel::drivers::xhci_ep0;

import kernel::arch::x86_64::cpu::*;
import kernel::memory::direct_map::*;
import kernel::memory::active_page_tables::*;
import kernel::drivers::xhci_controller::*;
import kernel::drivers::xhci_context::*;
import kernel::drivers::xhci_address::*;
import kernel::drivers::xhci_device_table::*;
import kernel::drivers::xhci_ring::*;
import kernel::drivers::xhci_trb::*;

pub const XHCI_EP0_ENDPOINT_ID: u32 = 1;
pub const XHCI_EP0_DOORBELL_TARGET_MASK: u32 = 0xFF;
pub const XHCI_EP0_SLOT_CAPACITY: usize = XHCI_DEVICE_SLOT_CAPACITY;

pub struct XhciEp0State {
    pub ready: bool;
    pub epoch: u32;
    pub enqueue_index: u32;
    pub producer_cycle: bool;
    pub last_status_trb_physical: u64;
}

static mut XHCI_EP0_STATES: [XhciEp0State; XHCI_EP0_SLOT_CAPACITY] = [
    XhciEp0State {
        ready: false,
        epoch: 0,
        enqueue_index: 0,
        producer_cycle: true,
        last_status_trb_physical: 0
    };
    XHCI_EP0_SLOT_CAPACITY
];
static mut XHCI_EP0_ACTIVE_SLOT_ID: u8 = 0;

@system
fn xhci_ep0_index(slot_id: u8) -> usize {
    if slot_id == 0 { return XHCI_EP0_SLOT_CAPACITY; }
    return slot_id as usize;
}

@system
fn xhci_ep0_page_base(address: u64) -> u64 {
    return address & 0xFFFFFFFFFFFFF000;
}

@system
fn xhci_ep0_map_address(address: u64) -> bool {
    if address == 0 { return false; }
    return active_page_tables_map_mmio_identity_4k(xhci_ep0_page_base(address));
}

@system
fn xhci_ep0_slot_virtual_for(slot_id: u8, index: u32) -> *mut XhciTrb {
    if index >= XHCI_EP0_RING_TRBS { return null as *mut XhciTrb; }
    let base = direct_map_virtual_address(xhci_context_ep0_ring_physical_for(slot_id));
    if base == 0 { return null as *mut XhciTrb; }
    let offset = (index as u64) * XHCI_TRB_SIZE;
    return unsafe { (base + offset) as *mut XhciTrb };
}

@system
fn xhci_ep0_slot_physical_for(slot_id: u8, index: u32) -> u64 {
    if index >= XHCI_EP0_RING_TRBS { return 0; }
    let base = xhci_context_ep0_ring_physical_for(slot_id);
    if base == 0 { return 0; }
    let offset = (index as u64) * XHCI_TRB_SIZE;
    let address = base + offset;
    if address < base { return 0; }
    return address;
}

@system
fn xhci_ep0_publish_link_for(slot_id: u8, cycle: bool) -> bool {
    let link_index = XHCI_EP0_RING_TRBS - 1;
    let slot = xhci_ep0_slot_virtual_for(slot_id, link_index);
    let ring_physical = xhci_context_ep0_ring_physical_for(slot_id);
    if slot == (null as *mut XhciTrb) || ring_physical == 0 { return false; }
    let link = xhci_trb_link(ring_physical, true, cycle);
    unsafe { *slot = link; }
    return x86_read_cr3_raw() != 0;
}

@system
fn xhci_ep0_write_one_for(slot_id: u8, trb: XhciTrb) -> u64 {
    let state_index = xhci_ep0_index(slot_id);
    if state_index >= XHCI_EP0_SLOT_CAPACITY || !xhci_ep0_is_ready_for(slot_id) { return 0; }
    unsafe {
        let usable = XHCI_EP0_RING_TRBS - XHCI_RING_RESERVED_LINK_TRBS;
        if usable == 0 || XHCI_EP0_STATES[state_index].enqueue_index >= usable { return 0; }
        let index = XHCI_EP0_STATES[state_index].enqueue_index;
        let cycle = XHCI_EP0_STATES[state_index].producer_cycle;

        if index == (usable - 1) && !xhci_ep0_publish_link_for(slot_id, cycle) { return 0; }

        let slot = xhci_ep0_slot_virtual_for(slot_id, index);
        let physical = xhci_ep0_slot_physical_for(slot_id, index);
        if slot == (null as *mut XhciTrb) || physical == 0 { return 0; }

        let mut published = trb;
        published.control = (published.control & ~XHCI_TRB_CYCLE_BIT) |
            xhci_trb_cycle_bits(cycle);
        *slot = published;

        XHCI_EP0_STATES[state_index].enqueue_index += 1;
        if XHCI_EP0_STATES[state_index].enqueue_index >= usable {
            XHCI_EP0_STATES[state_index].enqueue_index = 0;
            XHCI_EP0_STATES[state_index].producer_cycle =
                !XHCI_EP0_STATES[state_index].producer_cycle;
        }
        return physical;
    }
}

@system
fn xhci_ep0_ring_doorbell_for(slot_id: u8) -> bool {
    let mmio = xhci_controller_mmio_base();
    if mmio == 0 || slot_id == 0 || !xhci_ep0_is_ready_for(slot_id) { return false; }

    let dboff = (x86_mmio_read32(mmio + XHCI_DBOFF) as u64) & 0xFFFFFFFC;
    let doorbell_base = mmio + dboff;
    if doorbell_base < mmio { return false; }
    let doorbell = doorbell_base + ((slot_id as u64) * 4);
    if doorbell < doorbell_base || !xhci_ep0_map_address(doorbell) { return false; }

    x86_mmio_write32(doorbell, XHCI_EP0_ENDPOINT_ID & XHCI_EP0_DOORBELL_TARGET_MASK);
    return true;
}

@system
pub fn xhci_ep0_prepare_for_slot(slot_id: u8) -> bool {
    let state_index = xhci_ep0_index(slot_id);
    if state_index >= XHCI_EP0_SLOT_CAPACITY ||
       !xhci_device_table_slot_is_valid(slot_id) ||
       !xhci_address_is_ready_for(slot_id) ||
       !xhci_context_is_ready_for(slot_id) {
        return false;
    }
    let epoch = xhci_device_table_slot_epoch(slot_id);
    if epoch == 0 || xhci_context_ep0_ring_physical_for(slot_id) == 0 { return false; }

    unsafe {
        if XHCI_EP0_STATES[state_index].ready && XHCI_EP0_STATES[state_index].epoch == epoch {
            XHCI_EP0_ACTIVE_SLOT_ID = slot_id;
            return true;
        }
        XHCI_EP0_STATES[state_index].ready = true;
        XHCI_EP0_STATES[state_index].epoch = epoch;
        XHCI_EP0_STATES[state_index].enqueue_index = 0;
        XHCI_EP0_STATES[state_index].producer_cycle = true;
        XHCI_EP0_STATES[state_index].last_status_trb_physical = 0;
        XHCI_EP0_ACTIVE_SLOT_ID = slot_id;
    }
    return true;
}

@system
pub fn xhci_ep0_prepare_after_address() -> bool {
    let slot_id = xhci_address_slot_id();
    if slot_id == 0 { return false; }
    return xhci_ep0_prepare_for_slot(slot_id);
}

@system
pub fn xhci_ep0_submit_control_td_for_slot(slot_id: u8,
                                           setup: XhciTrb,
                                           data: XhciTrb,
                                           status: XhciTrb,
                                           has_data: bool) -> u64 {
    if !xhci_ep0_is_ready_for(slot_id) { return 0; }

    let setup_physical = xhci_ep0_write_one_for(slot_id, setup);
    if setup_physical == 0 { return 0; }

    if has_data {
        let data_physical = xhci_ep0_write_one_for(slot_id, data);
        if data_physical == 0 { return 0; }
    }

    let status_physical = xhci_ep0_write_one_for(slot_id, status);
    if status_physical == 0 { return 0; }

    if x86_read_cr3_raw() == 0 { return 0; }
    if !xhci_ep0_ring_doorbell_for(slot_id) { return 0; }

    unsafe {
        XHCI_EP0_STATES[xhci_ep0_index(slot_id)].last_status_trb_physical = status_physical;
        XHCI_EP0_ACTIVE_SLOT_ID = slot_id;
    }
    return status_physical;
}

@system
pub fn xhci_ep0_submit_control_td(setup: XhciTrb,
                                  data: XhciTrb,
                                  status: XhciTrb,
                                  has_data: bool) -> u64 {
    return xhci_ep0_submit_control_td_for_slot(
        xhci_ep0_active_slot_id(), setup, data, status, has_data);
}

@system
pub fn xhci_ep0_is_ready_for(slot_id: u8) -> bool {
    let state_index = xhci_ep0_index(slot_id);
    if state_index >= XHCI_EP0_SLOT_CAPACITY || !xhci_device_table_slot_is_valid(slot_id) {
        return false;
    }
    let epoch = xhci_device_table_slot_epoch(slot_id);
    unsafe {
        return epoch != 0 && XHCI_EP0_STATES[state_index].ready &&
               XHCI_EP0_STATES[state_index].epoch == epoch;
    }
}

@system
pub fn xhci_ep0_active_slot_id() -> u8 {
    unsafe { return XHCI_EP0_ACTIVE_SLOT_ID; }
}

@system
pub fn xhci_ep0_is_ready() -> bool {
    return xhci_ep0_is_ready_for(xhci_ep0_active_slot_id());
}

@system
pub fn xhci_ep0_enqueue_index_for(slot_id: u8) -> u32 {
    if !xhci_ep0_is_ready_for(slot_id) { return 0; }
    unsafe { return XHCI_EP0_STATES[xhci_ep0_index(slot_id)].enqueue_index; }
}

@system
pub fn xhci_ep0_enqueue_index() -> u32 {
    return xhci_ep0_enqueue_index_for(xhci_ep0_active_slot_id());
}

@system
pub fn xhci_ep0_producer_cycle_for(slot_id: u8) -> bool {
    if !xhci_ep0_is_ready_for(slot_id) { return false; }
    unsafe { return XHCI_EP0_STATES[xhci_ep0_index(slot_id)].producer_cycle; }
}

@system
pub fn xhci_ep0_producer_cycle() -> bool {
    return xhci_ep0_producer_cycle_for(xhci_ep0_active_slot_id());
}

@system
pub fn xhci_ep0_last_status_trb_physical_for(slot_id: u8) -> u64 {
    if !xhci_ep0_is_ready_for(slot_id) { return 0; }
    unsafe { return XHCI_EP0_STATES[xhci_ep0_index(slot_id)].last_status_trb_physical; }
}

@system
pub fn xhci_ep0_last_status_trb_physical() -> u64 {
    return xhci_ep0_last_status_trb_physical_for(xhci_ep0_active_slot_id());
}
