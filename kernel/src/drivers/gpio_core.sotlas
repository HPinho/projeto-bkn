// Baken OS — GPIO & IRQ Foundation.
//
// Logical ACPI GpioInt connections are vendor-neutral. Registration only creates a
// CONFIGURED logical connection. A physical backend that owns the resolved ACPI
// controller must explicitly activate it after the real pad and interrupt route are
// armed. This keeps consumers fail-closed and prevents hardware-specific policy
// from leaking into the GPIO core.

module kernel::drivers::gpio_core;

import kernel::arch::x86_64::cpu::*;
import kernel::sync::spinlock::*;
import kernel::acpi::aml_namespace::*;
import kernel::acpi::aml_discovery::*;
import kernel::acpi::aml_i2c_resources::*;
import kernel::acpi::aml_i2c_binding::*;

pub const GPIO_MAX_CONNECTIONS: usize = 32;
pub const GPIO_MAX_PHYSICAL_BACKENDS: usize = 16;
pub const GPIO_CONNECTION_ID_NONE: u32 = 0;
pub const GPIO_GENERATION_INVALID: u32 = 0;
pub const GPIO_BACKEND_INSTANCE_NONE: u32 = 0;

pub const GPIO_PIN_STATE_FREE: u8 = 0;
pub const GPIO_PIN_STATE_CONFIGURED: u8 = 1;
pub const GPIO_PIN_STATE_ACTIVE: u8 = 2;
pub const GPIO_PIN_STATE_MASKED: u8 = 3;
pub const GPIO_PIN_STATE_DETACHED: u8 = 4;

pub const GPIO_POLARITY_ACTIVE_HIGH: u8 = 0;
pub const GPIO_POLARITY_ACTIVE_LOW: u8 = 1;
pub const GPIO_POLARITY_ACTIVE_BOTH: u8 = 2;

pub const GPIO_TRIGGER_LEVEL: u8 = 0;
pub const GPIO_TRIGGER_EDGE: u8 = 1;

@repr(C)
pub struct GpioPinHandle {
    pub connection_id: u32;
    pub generation: u32;
    pub valid: bool;
}

@repr(C)
pub struct GpioPhysicalBackend {
    pub controller_namespace_index: usize;
    pub backend_instance: u32;
    pub active: bool;
}

@repr(C)
pub struct GpioInterruptConnection {
    pub connection_id: u32;
    pub generation: u32;
    pub pin_number: u16;
    pub controller_namespace_index: usize;
    pub target_device_id: u32;
    pub target_generation: u32;
    pub state: u8;
    pub polarity: u8;
    pub trigger: u8;
    pub interrupt_count: u64;
    pub pending: bool;
    pub valid: bool;
}

static mut GPIO_CONNECTIONS: [GpioInterruptConnection; GPIO_MAX_CONNECTIONS] = [
    GpioInterruptConnection {
        connection_id: GPIO_CONNECTION_ID_NONE, generation: GPIO_GENERATION_INVALID,
        pin_number: 0, controller_namespace_index: AML_NAMESPACE_INVALID_INDEX,
        target_device_id: 0, target_generation: 0, state: GPIO_PIN_STATE_FREE,
        polarity: GPIO_POLARITY_ACTIVE_LOW, trigger: GPIO_TRIGGER_EDGE,
        interrupt_count: 0, pending: false, valid: false
    }; GPIO_MAX_CONNECTIONS
];
static mut GPIO_PHYSICAL_BACKENDS: [GpioPhysicalBackend; GPIO_MAX_PHYSICAL_BACKENDS] = [
    GpioPhysicalBackend {
        controller_namespace_index: AML_NAMESPACE_INVALID_INDEX,
        backend_instance: GPIO_BACKEND_INSTANCE_NONE,
        active: false
    }; GPIO_MAX_PHYSICAL_BACKENDS
];

static mut GPIO_CORE_READY: bool = false;
static mut GPIO_CORE_LOCK: SpinLock = SpinLock { state: SPINLOCK_UNLOCKED };
static mut GPIO_CORE_LOCK_READY: bool = false;
static mut GPIO_CONNECTION_COUNT: usize = 0;

@system
pub fn gpio_pin_invalid_handle() -> GpioPinHandle {
    return GpioPinHandle { connection_id: GPIO_CONNECTION_ID_NONE, generation: GPIO_GENERATION_INVALID, valid: false };
}

@system
pub fn gpio_connection_invalid_record() -> GpioInterruptConnection {
    return GpioInterruptConnection {
        connection_id: GPIO_CONNECTION_ID_NONE, generation: GPIO_GENERATION_INVALID,
        pin_number: 0, controller_namespace_index: AML_NAMESPACE_INVALID_INDEX,
        target_device_id: 0, target_generation: 0, state: GPIO_PIN_STATE_FREE,
        polarity: GPIO_POLARITY_ACTIVE_LOW, trigger: GPIO_TRIGGER_EDGE,
        interrupt_count: 0, pending: false, valid: false
    };
}

@system
fn gpio_connection_slot(connection_id: u32) -> usize {
    if connection_id == GPIO_CONNECTION_ID_NONE || connection_id > GPIO_MAX_CONNECTIONS as u32 { return GPIO_MAX_CONNECTIONS; }
    return (connection_id - 1) as usize;
}

@system
fn gpio_generation_next(current: u32) -> u32 {
    let mut next = current + 1;
    if next == GPIO_GENERATION_INVALID { next = 1; }
    return next;
}

@system
fn gpio_backend_present_locked(controller_namespace_index: usize) -> bool {
    let mut index: usize = 0;
    unsafe {
        while index < GPIO_MAX_PHYSICAL_BACKENDS {
            if GPIO_PHYSICAL_BACKENDS[index].active &&
               GPIO_PHYSICAL_BACKENDS[index].controller_namespace_index == controller_namespace_index {
                return true;
            }
            index += 1;
        }
    }
    return false;
}

@system
pub fn gpio_core_init() -> bool {
    let flags = x86_irq_save_disable();
    unsafe {
        if !GPIO_CORE_LOCK_READY {
            if !spinlock_init(&mut GPIO_CORE_LOCK) { x86_irq_restore(flags); return false; }
            GPIO_CORE_LOCK_READY = true;
        }
        if !spinlock_lock(&mut GPIO_CORE_LOCK) { x86_irq_restore(flags); return false; }
        if GPIO_CORE_READY {
            spinlock_unlock(&mut GPIO_CORE_LOCK);
            x86_irq_restore(flags);
            return true;
        }
        let mut index: usize = 0;
        while index < GPIO_MAX_CONNECTIONS {
            GPIO_CONNECTIONS[index] = gpio_connection_invalid_record();
            GPIO_CONNECTIONS[index].connection_id = (index + 1) as u32;
            GPIO_CONNECTIONS[index].generation = 1;
            index += 1;
        }
        index = 0;
        while index < GPIO_MAX_PHYSICAL_BACKENDS {
            GPIO_PHYSICAL_BACKENDS[index].controller_namespace_index = AML_NAMESPACE_INVALID_INDEX;
            GPIO_PHYSICAL_BACKENDS[index].backend_instance = GPIO_BACKEND_INSTANCE_NONE;
            GPIO_PHYSICAL_BACKENDS[index].active = false;
            index += 1;
        }
        GPIO_CONNECTION_COUNT = 0;
        GPIO_CORE_READY = true;
        spinlock_unlock(&mut GPIO_CORE_LOCK);
    }
    x86_irq_restore(flags);
    return true;
}

@system
pub fn gpio_physical_backend_register(controller_namespace_index: usize, backend_instance: u32) -> bool {
    if controller_namespace_index == AML_NAMESPACE_INVALID_INDEX || backend_instance == GPIO_BACKEND_INSTANCE_NONE || !gpio_core_init() { return false; }
    let flags = x86_irq_save_disable();
    let mut registered = false;
    unsafe {
        if GPIO_CORE_LOCK_READY && spinlock_lock(&mut GPIO_CORE_LOCK) {
            let mut index: usize = 0;
            let mut free_slot = GPIO_MAX_PHYSICAL_BACKENDS;
            while index < GPIO_MAX_PHYSICAL_BACKENDS {
                if GPIO_PHYSICAL_BACKENDS[index].active && GPIO_PHYSICAL_BACKENDS[index].controller_namespace_index == controller_namespace_index {
                    registered = GPIO_PHYSICAL_BACKENDS[index].backend_instance == backend_instance;
                    break;
                }
                if !GPIO_PHYSICAL_BACKENDS[index].active && free_slot == GPIO_MAX_PHYSICAL_BACKENDS { free_slot = index; }
                index += 1;
            }
            if !registered && index == GPIO_MAX_PHYSICAL_BACKENDS && free_slot < GPIO_MAX_PHYSICAL_BACKENDS {
                GPIO_PHYSICAL_BACKENDS[free_slot].controller_namespace_index = controller_namespace_index;
                GPIO_PHYSICAL_BACKENDS[free_slot].backend_instance = backend_instance;
                GPIO_PHYSICAL_BACKENDS[free_slot].active = true;
                registered = true;
            }
            spinlock_unlock(&mut GPIO_CORE_LOCK);
        }
    }
    x86_irq_restore(flags);
    return registered;
}

@system
pub fn gpio_physical_backend_unregister(controller_namespace_index: usize, backend_instance: u32) -> bool {
    if controller_namespace_index == AML_NAMESPACE_INVALID_INDEX || backend_instance == GPIO_BACKEND_INSTANCE_NONE { return false; }
    let flags = x86_irq_save_disable();
    let mut removed = false;
    unsafe {
        if GPIO_CORE_LOCK_READY && spinlock_lock(&mut GPIO_CORE_LOCK) {
            let mut connection: usize = 0;
            let mut busy = false;
            while connection < GPIO_MAX_CONNECTIONS {
                if GPIO_CONNECTIONS[connection].valid && GPIO_CONNECTIONS[connection].controller_namespace_index == controller_namespace_index {
                    busy = true;
                    break;
                }
                connection += 1;
            }
            if !busy {
                let mut index: usize = 0;
                while index < GPIO_MAX_PHYSICAL_BACKENDS {
                    if GPIO_PHYSICAL_BACKENDS[index].active &&
                       GPIO_PHYSICAL_BACKENDS[index].controller_namespace_index == controller_namespace_index &&
                       GPIO_PHYSICAL_BACKENDS[index].backend_instance == backend_instance {
                        GPIO_PHYSICAL_BACKENDS[index].active = false;
                        GPIO_PHYSICAL_BACKENDS[index].controller_namespace_index = AML_NAMESPACE_INVALID_INDEX;
                        GPIO_PHYSICAL_BACKENDS[index].backend_instance = GPIO_BACKEND_INSTANCE_NONE;
                        removed = true;
                        break;
                    }
                    index += 1;
                }
            }
            spinlock_unlock(&mut GPIO_CORE_LOCK);
        }
    }
    x86_irq_restore(flags);
    return removed;
}

@system
pub fn gpio_physical_backend_available(controller_namespace_index: usize) -> bool {
    if controller_namespace_index == AML_NAMESPACE_INVALID_INDEX || !gpio_core_init() { return false; }
    let flags = x86_irq_save_disable();
    let mut available = false;
    unsafe {
        if GPIO_CORE_LOCK_READY && spinlock_lock(&mut GPIO_CORE_LOCK) {
            available = gpio_backend_present_locked(controller_namespace_index);
            spinlock_unlock(&mut GPIO_CORE_LOCK);
        }
    }
    x86_irq_restore(flags);
    return available;
}

@system
pub fn gpio_connection_register_from_acpi(resource_index: usize, target_device_id: u32, target_generation: u32) -> GpioPinHandle {
    let gpio = aml_i2c_decode_gpio_int(resource_index);
    if !gpio.valid || gpio.pin_count != 1 || gpio.pin_table == (null as *const u8) { return gpio_pin_invalid_handle(); }
    let mut pin_number: u16 = 0;
    unsafe { pin_number = (gpio.pin_table[0] as u16) | ((gpio.pin_table[1] as u16) << 8); }
    let controller = aml_i2c_resolve_resource_source(gpio.device_slot, gpio.controller_source, gpio.controller_source_length);
    if controller == AML_NAMESPACE_INVALID_INDEX { return gpio_pin_invalid_handle(); }
    let mut trigger = GPIO_TRIGGER_LEVEL;
    if gpio.edge_triggered { trigger = GPIO_TRIGGER_EDGE; }
    let mut polarity = GPIO_POLARITY_ACTIVE_HIGH;
    if gpio.polarity == 1 { polarity = GPIO_POLARITY_ACTIVE_LOW; }
    else if gpio.polarity == 2 { polarity = GPIO_POLARITY_ACTIVE_BOTH; }
    let flags = x86_irq_save_disable();
    let mut result = gpio_pin_invalid_handle();
    unsafe {
        if !GPIO_CORE_LOCK_READY || !spinlock_lock(&mut GPIO_CORE_LOCK) { x86_irq_restore(flags); return result; }
        if GPIO_CORE_READY && gpio_backend_present_locked(controller) {
            let mut index: usize = 0;
            while index < GPIO_MAX_CONNECTIONS {
                if GPIO_CONNECTIONS[index].state == GPIO_PIN_STATE_FREE {
                    GPIO_CONNECTIONS[index].pin_number = pin_number;
                    GPIO_CONNECTIONS[index].controller_namespace_index = controller;
                    GPIO_CONNECTIONS[index].target_device_id = target_device_id;
                    GPIO_CONNECTIONS[index].target_generation = target_generation;
                    GPIO_CONNECTIONS[index].state = GPIO_PIN_STATE_CONFIGURED;
                    GPIO_CONNECTIONS[index].polarity = polarity;
                    GPIO_CONNECTIONS[index].trigger = trigger;
                    GPIO_CONNECTIONS[index].interrupt_count = 0;
                    GPIO_CONNECTIONS[index].pending = false;
                    GPIO_CONNECTIONS[index].valid = true;
                    GPIO_CONNECTION_COUNT += 1;
                    result.connection_id = GPIO_CONNECTIONS[index].connection_id;
                    result.generation = GPIO_CONNECTIONS[index].generation;
                    result.valid = true;
                    break;
                }
                index += 1;
            }
        }
        spinlock_unlock(&mut GPIO_CORE_LOCK);
    }
    x86_irq_restore(flags);
    return result;
}

@system
pub fn gpio_connection_activate(connection_id: u32, generation: u32) -> bool {
    let slot = gpio_connection_slot(connection_id);
    if slot >= GPIO_MAX_CONNECTIONS || generation == GPIO_GENERATION_INVALID { return false; }
    let flags = x86_irq_save_disable();
    let mut activated = false;
    unsafe {
        if !GPIO_CORE_LOCK_READY || !spinlock_lock(&mut GPIO_CORE_LOCK) { x86_irq_restore(flags); return false; }
        if GPIO_CORE_READY && GPIO_CONNECTIONS[slot].valid &&
           GPIO_CONNECTIONS[slot].connection_id == connection_id &&
           GPIO_CONNECTIONS[slot].generation == generation &&
           GPIO_CONNECTIONS[slot].state == GPIO_PIN_STATE_CONFIGURED &&
           gpio_backend_present_locked(GPIO_CONNECTIONS[slot].controller_namespace_index) {
            GPIO_CONNECTIONS[slot].pending = false;
            GPIO_CONNECTIONS[slot].state = GPIO_PIN_STATE_ACTIVE;
            activated = true;
        }
        spinlock_unlock(&mut GPIO_CORE_LOCK);
    }
    x86_irq_restore(flags);
    return activated;
}

@system
pub fn gpio_connection_deactivate(connection_id: u32, generation: u32) -> bool {
    let slot = gpio_connection_slot(connection_id);
    if slot >= GPIO_MAX_CONNECTIONS || generation == GPIO_GENERATION_INVALID { return false; }
    let flags = x86_irq_save_disable();
    let mut deactivated = false;
    unsafe {
        if !GPIO_CORE_LOCK_READY || !spinlock_lock(&mut GPIO_CORE_LOCK) { x86_irq_restore(flags); return false; }
        if GPIO_CORE_READY && GPIO_CONNECTIONS[slot].valid &&
           GPIO_CONNECTIONS[slot].connection_id == connection_id &&
           GPIO_CONNECTIONS[slot].generation == generation &&
           (GPIO_CONNECTIONS[slot].state == GPIO_PIN_STATE_ACTIVE || GPIO_CONNECTIONS[slot].state == GPIO_PIN_STATE_MASKED) {
            GPIO_CONNECTIONS[slot].pending = false;
            GPIO_CONNECTIONS[slot].state = GPIO_PIN_STATE_CONFIGURED;
            deactivated = true;
        }
        spinlock_unlock(&mut GPIO_CORE_LOCK);
    }
    x86_irq_restore(flags);
    return deactivated;
}

@system
pub fn gpio_connection_unregister(connection_id: u32, generation: u32) -> bool {
    let slot = gpio_connection_slot(connection_id);
    if slot >= GPIO_MAX_CONNECTIONS || generation == GPIO_GENERATION_INVALID { return false; }
    let flags = x86_irq_save_disable();
    let mut unregistered = false;
    unsafe {
        if !GPIO_CORE_LOCK_READY || !spinlock_lock(&mut GPIO_CORE_LOCK) { x86_irq_restore(flags); return false; }
        if GPIO_CORE_READY && GPIO_CONNECTIONS[slot].valid &&
           GPIO_CONNECTIONS[slot].connection_id == connection_id &&
           GPIO_CONNECTIONS[slot].generation == generation &&
           (GPIO_CONNECTIONS[slot].state == GPIO_PIN_STATE_CONFIGURED || GPIO_CONNECTIONS[slot].state == GPIO_PIN_STATE_DETACHED) {
            GPIO_CONNECTIONS[slot].state = GPIO_PIN_STATE_FREE;
            GPIO_CONNECTIONS[slot].pin_number = 0;
            GPIO_CONNECTIONS[slot].controller_namespace_index = AML_NAMESPACE_INVALID_INDEX;
            GPIO_CONNECTIONS[slot].target_device_id = 0;
            GPIO_CONNECTIONS[slot].target_generation = 0;
            GPIO_CONNECTIONS[slot].interrupt_count = 0;
            GPIO_CONNECTIONS[slot].pending = false;
            GPIO_CONNECTIONS[slot].valid = false;
            GPIO_CONNECTIONS[slot].generation = gpio_generation_next(generation);
            if GPIO_CONNECTION_COUNT != 0 { GPIO_CONNECTION_COUNT -= 1; }
            unregistered = true;
        }
        spinlock_unlock(&mut GPIO_CORE_LOCK);
    }
    x86_irq_restore(flags);
    return unregistered;
}

@system
pub fn gpio_connection_mask(connection_id: u32, generation: u32) -> bool {
    let slot = gpio_connection_slot(connection_id);
    if slot >= GPIO_MAX_CONNECTIONS || generation == GPIO_GENERATION_INVALID { return false; }
    let flags = x86_irq_save_disable();
    let mut masked = false;
    unsafe {
        if !GPIO_CORE_LOCK_READY || !spinlock_lock(&mut GPIO_CORE_LOCK) { x86_irq_restore(flags); return false; }
        if GPIO_CORE_READY && GPIO_CONNECTIONS[slot].valid && GPIO_CONNECTIONS[slot].generation == generation && GPIO_CONNECTIONS[slot].state == GPIO_PIN_STATE_ACTIVE {
            GPIO_CONNECTIONS[slot].state = GPIO_PIN_STATE_MASKED;
            masked = true;
        }
        spinlock_unlock(&mut GPIO_CORE_LOCK);
    }
    x86_irq_restore(flags);
    return masked;
}

@system
pub fn gpio_connection_unmask(connection_id: u32, generation: u32) -> bool {
    let slot = gpio_connection_slot(connection_id);
    if slot >= GPIO_MAX_CONNECTIONS || generation == GPIO_GENERATION_INVALID { return false; }
    let flags = x86_irq_save_disable();
    let mut unmasked = false;
    unsafe {
        if !GPIO_CORE_LOCK_READY || !spinlock_lock(&mut GPIO_CORE_LOCK) { x86_irq_restore(flags); return false; }
        if GPIO_CORE_READY && GPIO_CONNECTIONS[slot].valid && GPIO_CONNECTIONS[slot].generation == generation && GPIO_CONNECTIONS[slot].state == GPIO_PIN_STATE_MASKED {
            GPIO_CONNECTIONS[slot].state = GPIO_PIN_STATE_ACTIVE;
            unmasked = true;
        }
        spinlock_unlock(&mut GPIO_CORE_LOCK);
    }
    x86_irq_restore(flags);
    return unmasked;
}

@system
pub fn gpio_connection_signal(connection_id: u32) -> bool {
    let slot = gpio_connection_slot(connection_id);
    if slot >= GPIO_MAX_CONNECTIONS { return false; }
    let flags = x86_irq_save_disable();
    let mut signaled = false;
    unsafe {
        if !GPIO_CORE_LOCK_READY || !spinlock_lock(&mut GPIO_CORE_LOCK) { x86_irq_restore(flags); return false; }
        if GPIO_CORE_READY && GPIO_CONNECTIONS[slot].valid && GPIO_CONNECTIONS[slot].connection_id == connection_id && GPIO_CONNECTIONS[slot].state == GPIO_PIN_STATE_ACTIVE {
            GPIO_CONNECTIONS[slot].pending = true;
            GPIO_CONNECTIONS[slot].interrupt_count += 1;
            signaled = true;
        }
        spinlock_unlock(&mut GPIO_CORE_LOCK);
    }
    x86_irq_restore(flags);
    return signaled;
}

@system
pub fn gpio_connection_consume_pending(connection_id: u32, generation: u32) -> bool {
    let slot = gpio_connection_slot(connection_id);
    if slot >= GPIO_MAX_CONNECTIONS || generation == GPIO_GENERATION_INVALID { return false; }
    let flags = x86_irq_save_disable();
    let mut was_pending = false;
    unsafe {
        if !GPIO_CORE_LOCK_READY || !spinlock_lock(&mut GPIO_CORE_LOCK) { x86_irq_restore(flags); return false; }
        if GPIO_CORE_READY && GPIO_CONNECTIONS[slot].valid && GPIO_CONNECTIONS[slot].connection_id == connection_id && GPIO_CONNECTIONS[slot].generation == generation && GPIO_CONNECTIONS[slot].pending {
            GPIO_CONNECTIONS[slot].pending = false;
            was_pending = true;
        }
        spinlock_unlock(&mut GPIO_CORE_LOCK);
    }
    x86_irq_restore(flags);
    return was_pending;
}

@system
pub fn gpio_connection_is_pending(connection_id: u32, generation: u32) -> bool {
    let slot = gpio_connection_slot(connection_id);
    if slot >= GPIO_MAX_CONNECTIONS || generation == GPIO_GENERATION_INVALID { return false; }
    let flags = x86_irq_save_disable();
    let mut pending = false;
    unsafe {
        if !GPIO_CORE_LOCK_READY || !spinlock_lock(&mut GPIO_CORE_LOCK) { x86_irq_restore(flags); return false; }
        if GPIO_CORE_READY && GPIO_CONNECTIONS[slot].valid && GPIO_CONNECTIONS[slot].generation == generation { pending = GPIO_CONNECTIONS[slot].pending; }
        spinlock_unlock(&mut GPIO_CORE_LOCK);
    }
    x86_irq_restore(flags);
    return pending;
}

@system
pub fn gpio_connection_query(connection_id: u32, generation: u32) -> GpioInterruptConnection {
    let slot = gpio_connection_slot(connection_id);
    if slot >= GPIO_MAX_CONNECTIONS || generation == GPIO_GENERATION_INVALID { return gpio_connection_invalid_record(); }
    let flags = x86_irq_save_disable();
    let mut result = gpio_connection_invalid_record();
    unsafe {
        if !GPIO_CORE_LOCK_READY || !spinlock_lock(&mut GPIO_CORE_LOCK) { x86_irq_restore(flags); return result; }
        if GPIO_CORE_READY && GPIO_CONNECTIONS[slot].valid && GPIO_CONNECTIONS[slot].connection_id == connection_id && GPIO_CONNECTIONS[slot].generation == generation { result = GPIO_CONNECTIONS[slot]; }
        spinlock_unlock(&mut GPIO_CORE_LOCK);
    }
    x86_irq_restore(flags);
    return result;
}

@system
pub fn gpio_connection_count() -> usize {
    let flags = x86_irq_save_disable();
    let mut count: usize = 0;
    unsafe {
        if !GPIO_CORE_LOCK_READY || !spinlock_lock(&mut GPIO_CORE_LOCK) { x86_irq_restore(flags); return 0; }
        if GPIO_CORE_READY { count = GPIO_CONNECTION_COUNT; }
        spinlock_unlock(&mut GPIO_CORE_LOCK);
    }
    x86_irq_restore(flags);
    return count;
}