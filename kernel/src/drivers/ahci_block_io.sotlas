// Baken OS — I/O de bloco AHCI genérico de um setor.
//
// Esta camada reaproveita o HBA/porta/command list/command table já inicializados
// pelo runtime AHCI e usa um buffer DMA próprio para READ/WRITE de qualquer LBA
// válido. Os probes destrutivos específicos do CI permanecem separados.

module kernel::drivers::ahci_block_io;

import kernel::arch::x86_64::cpu::*;
import kernel::memory::direct_map::*;
import kernel::memory::dma::*;
import kernel::drivers::ahci_runtime::*;
import kernel::drivers::ahci_block_read::*;

static mut AHCI_BLOCK_IO_BUFFER: DmaBuffer = DmaBuffer {
    virtual_address: null as *mut u8,
    physical_address: 0,
    size: 0,
    alignment: 0,
    owner: DMA_OWNER_CPU,
    fence: 0,
    valid: false
};

@system
fn ahci_block_io_zero(base: *mut u8, size: u64) -> bool {
    if base == (null as *mut u8) || size == 0 { return false; }
    unsafe {
        let mut offset: u64 = 0;
        while offset < size {
            *(((base as usize) + (offset as usize)) as *mut u8) = 0;
            offset += 1;
        }
    }
    return true;
}

@system
fn ahci_block_io_copy(dst: *mut u8, src: *const u8, size: u64) -> bool {
    if dst == (null as *mut u8) || src == (null as *const u8) || size == 0 { return false; }
    unsafe {
        let mut offset: u64 = 0;
        while offset < size {
            *(((dst as usize) + (offset as usize)) as *mut u8) =
                *(((src as usize) + (offset as usize)) as *const u8);
            offset += 1;
        }
    }
    return true;
}

@system
fn ahci_block_io_virtual(physical: u64) -> *mut u8 {
    if physical == 0 { return null as *mut u8; }
    let virtual_address = direct_map_virtual_address(physical);
    if virtual_address == 0 { return null as *mut u8; }
    return virtual_address as *mut u8;
}

@system
fn ahci_block_io_prepare_buffer() -> bool {
    unsafe {
        if dma_buffer_shared(&AHCI_BLOCK_IO_BUFFER) {
            return ahci_block_io_zero(AHCI_BLOCK_IO_BUFFER.virtual_address, AHCI_READ_SECTOR_SIZE);
        }
    }

    let mut buffer = dma_alloc(AHCI_RUNTIME_PAGE_SIZE, AHCI_RUNTIME_PAGE_SIZE);
    if !dma_buffer_cpu_owned(&buffer) { return false; }
    if !ahci_block_io_zero(buffer.virtual_address, buffer.size) { return false; }
    if !dma_share_with_device(&mut buffer) { return false; }
    unsafe { AHCI_BLOCK_IO_BUFFER = buffer; }
    return true;
}

@system
fn ahci_block_io_issue(hba: u64, lba: u64, command: u8, write_to_disk: bool) -> bool {
    if hba == 0 { return false; }
    let lba48 = command == AHCI_ATA_READ_DMA_EXT || command == AHCI_ATA_WRITE_DMA_EXT;
    if !lba48 && lba > 0x0FFFFFFF { return false; }

    let port = ahci_runtime_port();
    if port >= 32 { return false; }
    let port_base = hba + AHCI_PORT_BASE + ((port as u64) * AHCI_PORT_STRIDE);
    let command_list_physical = ahci_runtime_command_list_physical();
    let command_table_physical = ahci_runtime_command_table_physical();
    let command_list = ahci_block_io_virtual(command_list_physical);
    let table = ahci_block_io_virtual(command_table_physical);
    let data_physical = unsafe { AHCI_BLOCK_IO_BUFFER.physical_address };
    if command_list == (null as *mut u8) || table == (null as *mut u8) || data_physical == 0 {
        return false;
    }
    if !ahci_block_io_zero(table, AHCI_RUNTIME_PAGE_SIZE) { return false; }

    unsafe {
        let mut header_flags: u32 = 5 | (1 << 16);
        if write_to_disk { header_flags |= 1 << 6; }
        *command_list = (header_flags & 0xFF) as u8;
        *(((command_list as usize) + 1) as *mut u8) = ((header_flags >> 8) & 0xFF) as u8;
        *(((command_list as usize) + 2) as *mut u8) = ((header_flags >> 16) & 0xFF) as u8;
        *(((command_list as usize) + 3) as *mut u8) = ((header_flags >> 24) & 0xFF) as u8;
        *(((command_list as usize) + 4) as *mut u32) = 0;
        *(((command_list as usize) + 8) as *mut u32) = (command_table_physical & 0xFFFFFFFF) as u32;
        *(((command_list as usize) + 12) as *mut u32) = ((command_table_physical >> 32) & 0xFFFFFFFF) as u32;

        *table = AHCI_FIS_TYPE_REG_H2D;
        *(((table as usize) + 1) as *mut u8) = 0x80;
        *(((table as usize) + 2) as *mut u8) = command;
        *(((table as usize) + 4) as *mut u8) = (lba & 0xFF) as u8;
        *(((table as usize) + 5) as *mut u8) = ((lba >> 8) & 0xFF) as u8;
        *(((table as usize) + 6) as *mut u8) = ((lba >> 16) & 0xFF) as u8;
        let mut device: u8 = 0x40;
        if !lba48 { device |= ((lba >> 24) & 0x0F) as u8; }
        *(((table as usize) + 7) as *mut u8) = device;
        if lba48 {
            *(((table as usize) + 8) as *mut u8) = ((lba >> 24) & 0xFF) as u8;
            *(((table as usize) + 9) as *mut u8) = ((lba >> 32) & 0xFF) as u8;
            *(((table as usize) + 10) as *mut u8) = ((lba >> 40) & 0xFF) as u8;
        }
        *(((table as usize) + 12) as *mut u8) = 1;
        *(((table as usize) + 13) as *mut u8) = 0;

        let prdt = ((table as usize) + 0x80) as *mut u32;
        *prdt = (data_physical & 0xFFFFFFFF) as u32;
        *(((prdt as usize) + 4) as *mut u32) = ((data_physical >> 32) & 0xFFFFFFFF) as u32;
        *(((prdt as usize) + 8) as *mut u32) = 0;
        *(((prdt as usize) + 12) as *mut u32) = (511 as u32) | (1 << 31);
    }

    x86_mmio_write32(port_base + AHCI_PX_IS, 0xFFFFFFFF);
    let ci_before = x86_mmio_read32(port_base + AHCI_PX_CI);
    if ci_before == 0xFFFFFFFF || (ci_before & 1) != 0 { return false; }

    let mut cmd = x86_mmio_read32(port_base + AHCI_PX_CMD);
    if cmd == 0xFFFFFFFF { return false; }
    if (cmd & AHCI_PXCMD_FRE) == 0 {
        cmd |= AHCI_PXCMD_FRE;
        x86_mmio_write32(port_base + AHCI_PX_CMD, cmd);
    }
    if (cmd & AHCI_PXCMD_ST) == 0 {
        cmd |= AHCI_PXCMD_ST;
        x86_mmio_write32(port_base + AHCI_PX_CMD, cmd);
    }

    let mut spins: u64 = 0;
    while spins < AHCI_IDENTIFY_SPIN_LIMIT {
        let tfd = x86_mmio_read32(port_base + AHCI_PX_TFD);
        if tfd == 0xFFFFFFFF { return false; }
        if (tfd & (AHCI_TFD_BSY | AHCI_TFD_DRQ)) == 0 { break; }
        spins += 1;
    }
    if spins >= AHCI_IDENTIFY_SPIN_LIMIT { return false; }

    x86_mmio_write32(port_base + AHCI_PX_CI, 1);
    spins = 0;
    while spins < AHCI_IDENTIFY_SPIN_LIMIT {
        let isr = x86_mmio_read32(port_base + AHCI_PX_IS);
        let ci = x86_mmio_read32(port_base + AHCI_PX_CI);
        if isr == 0xFFFFFFFF || ci == 0xFFFFFFFF { return false; }
        if (isr & AHCI_PXIS_TFES) != 0 { return false; }
        if (ci & 1) == 0 {
            let tfd = x86_mmio_read32(port_base + AHCI_PX_TFD);
            if tfd == 0xFFFFFFFF || (tfd & AHCI_TFD_ERR) != 0 { return false; }
            unsafe {
                let prdbc = *(((command_list as usize) + 4) as *const u32);
                if prdbc != (AHCI_READ_SECTOR_SIZE as u32) { return false; }
            }
            return true;
        }
        spins += 1;
    }
    return false;
}

@system
pub fn ahci_block_io_read_sector(hba: u64, lba: u64, output: *mut u8) -> bool {
    if output == (null as *mut u8) || hba == 0 { return false; }
    if !ahci_read_is_ready() || !ahci_capacity_is_ready() || lba >= ahci_total_sectors() { return false; }
    if !ahci_block_io_prepare_buffer() { return false; }

    let mut command: u8 = AHCI_ATA_READ_DMA;
    if ahci_lba48_is_ready() { command = AHCI_ATA_READ_DMA_EXT; }
    if !ahci_block_io_issue(hba, lba, command, false) { return false; }

    let data = unsafe { AHCI_BLOCK_IO_BUFFER.virtual_address };
    return ahci_block_io_copy(output, data as *const u8, AHCI_READ_SECTOR_SIZE);
}

@system
pub fn ahci_block_io_write_sector(hba: u64, lba: u64, input: *const u8) -> bool {
    if input == (null as *const u8) || hba == 0 { return false; }
    if !ahci_write_is_ready() || !ahci_capacity_is_ready() || lba >= ahci_total_sectors() { return false; }
    if !ahci_block_io_prepare_buffer() { return false; }

    let data = unsafe { AHCI_BLOCK_IO_BUFFER.virtual_address };
    if !ahci_block_io_copy(data, input, AHCI_READ_SECTOR_SIZE) { return false; }

    let mut command: u8 = AHCI_ATA_WRITE_DMA;
    if ahci_lba48_is_ready() { command = AHCI_ATA_WRITE_DMA_EXT; }
    return ahci_block_io_issue(hba, lba, command, true);
}

@system
pub fn ahci_block_io_buffer_physical() -> u64 {
    unsafe { return AHCI_BLOCK_IO_BUFFER.physical_address; }
}
