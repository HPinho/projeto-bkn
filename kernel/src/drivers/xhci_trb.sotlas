// Baken OS — construtores puros de Command/Link/Transfer TRBs xHCI.
//
// Apenas codifica bitfields definidos pela especificação xHCI. Não escreve
// rings, não toca doorbells, não acessa MMIO e não submete comandos ao xHC.

module kernel::drivers::xhci_trb;

import kernel::drivers::xhci_ring::*;

pub const XHCI_TRB_TYPE_NORMAL: u32 = 1;
pub const XHCI_TRB_TYPE_SETUP_STAGE: u32 = 2;
pub const XHCI_TRB_TYPE_DATA_STAGE: u32 = 3;
pub const XHCI_TRB_TYPE_STATUS_STAGE: u32 = 4;
pub const XHCI_TRB_TYPE_LINK: u32 = 6;
pub const XHCI_TRB_TYPE_ENABLE_SLOT: u32 = 9;
pub const XHCI_TRB_TYPE_DISABLE_SLOT: u32 = 10;
pub const XHCI_TRB_TYPE_ADDRESS_DEVICE: u32 = 11;
pub const XHCI_TRB_TYPE_CONFIGURE_ENDPOINT: u32 = 12;
pub const XHCI_TRB_TYPE_NOOP_COMMAND: u32 = 23;

pub const XHCI_TRB_CYCLE_BIT: u32 = 1;
pub const XHCI_TRB_TOGGLE_CYCLE_BIT: u32 = 1 << 1;
pub const XHCI_TRB_IOC_BIT: u32 = 1 << 5;
pub const XHCI_TRB_IDT_BIT: u32 = 1 << 6;
pub const XHCI_TRB_BSR_OR_DC_BIT: u32 = 1 << 9;
pub const XHCI_TRB_TYPE_SHIFT: u32 = 10;
pub const XHCI_TRB_DIR_IN_BIT: u32 = 1 << 16;
pub const XHCI_TRB_SLOT_TYPE_SHIFT: u32 = 16;
pub const XHCI_TRB_SLOT_ID_SHIFT: u32 = 24;
pub const XHCI_SETUP_TRT_SHIFT: u32 = 16;
pub const XHCI_SETUP_TRT_NO_DATA: u32 = 0;
pub const XHCI_SETUP_TRT_OUT_DATA: u32 = 2;
pub const XHCI_SETUP_TRT_IN_DATA: u32 = 3;
pub const XHCI_TRB_TRANSFER_LENGTH_MASK: u32 = 0x1FFFF;
pub const XHCI_TRB_TD_SIZE_SHIFT: u32 = 17;
pub const XHCI_TRB_TD_SIZE_MASK: u32 = 0x1F;

@system
pub fn xhci_trb_type_bits(type_id: u32) -> u32 {
    return (type_id & 0x3F) << XHCI_TRB_TYPE_SHIFT;
}

@system
pub fn xhci_trb_cycle_bits(cycle: bool) -> u32 {
    if cycle { return XHCI_TRB_CYCLE_BIT; }
    return 0;
}

@system
pub fn xhci_trb_link(next_segment_physical: u64,
                     toggle_cycle: bool,
                     cycle: bool) -> XhciTrb {
    let mut control = xhci_trb_type_bits(XHCI_TRB_TYPE_LINK) |
        xhci_trb_cycle_bits(cycle);
    if toggle_cycle { control = control | XHCI_TRB_TOGGLE_CYCLE_BIT; }

    return XhciTrb {
        parameter: next_segment_physical & 0xFFFFFFFFFFFFFFF0,
        status: 0,
        control: control
    };
}

@system
pub fn xhci_trb_noop_command(cycle: bool) -> XhciTrb {
    return XhciTrb {
        parameter: 0,
        status: 0,
        control: xhci_trb_type_bits(XHCI_TRB_TYPE_NOOP_COMMAND) |
            xhci_trb_cycle_bits(cycle)
    };
}

@system
pub fn xhci_trb_enable_slot(slot_type: u8, cycle: bool) -> XhciTrb {
    let control = xhci_trb_type_bits(XHCI_TRB_TYPE_ENABLE_SLOT) |
        (((slot_type as u32) & 0x1F) << XHCI_TRB_SLOT_TYPE_SHIFT) |
        xhci_trb_cycle_bits(cycle);
    return XhciTrb { parameter: 0, status: 0, control: control };
}

@system
pub fn xhci_trb_disable_slot(slot_id: u8, cycle: bool) -> XhciTrb {
    let control = xhci_trb_type_bits(XHCI_TRB_TYPE_DISABLE_SLOT) |
        ((slot_id as u32) << XHCI_TRB_SLOT_ID_SHIFT) |
        xhci_trb_cycle_bits(cycle);
    return XhciTrb { parameter: 0, status: 0, control: control };
}

@system
pub fn xhci_trb_address_device(input_context_physical: u64,
                               slot_id: u8,
                               block_set_address_request: bool,
                               cycle: bool) -> XhciTrb {
    let mut control = xhci_trb_type_bits(XHCI_TRB_TYPE_ADDRESS_DEVICE) |
        ((slot_id as u32) << XHCI_TRB_SLOT_ID_SHIFT) |
        xhci_trb_cycle_bits(cycle);
    if block_set_address_request { control = control | XHCI_TRB_BSR_OR_DC_BIT; }

    return XhciTrb {
        parameter: input_context_physical & 0xFFFFFFFFFFFFFFF0,
        status: 0,
        control: control
    };
}

@system
pub fn xhci_trb_configure_endpoint(input_context_physical: u64,
                                   slot_id: u8,
                                   deconfigure: bool,
                                   cycle: bool) -> XhciTrb {
    let mut control = xhci_trb_type_bits(XHCI_TRB_TYPE_CONFIGURE_ENDPOINT) |
        ((slot_id as u32) << XHCI_TRB_SLOT_ID_SHIFT) |
        xhci_trb_cycle_bits(cycle);
    if deconfigure { control = control | XHCI_TRB_BSR_OR_DC_BIT; }

    return XhciTrb {
        parameter: input_context_physical & 0xFFFFFFFFFFFFFFF0,
        status: 0,
        control: control
    };
}

@system
fn xhci_setup_packet_parameter(request_type: u8,
                               request: u8,
                               value: u16,
                               index: u16,
                               length: u16) -> u64 {
    return (request_type as u64) |
        ((request as u64) << 8) |
        ((value as u64) << 16) |
        ((index as u64) << 32) |
        ((length as u64) << 48);
}

@system
pub fn xhci_trb_setup_stage(request_type: u8,
                            request: u8,
                            value: u16,
                            index: u16,
                            length: u16,
                            transfer_type: u32,
                            cycle: bool) -> XhciTrb {
    let trt = transfer_type & 3;
    let control = xhci_trb_type_bits(XHCI_TRB_TYPE_SETUP_STAGE) |
        XHCI_TRB_IDT_BIT |
        (trt << XHCI_SETUP_TRT_SHIFT) |
        xhci_trb_cycle_bits(cycle);
    return XhciTrb {
        parameter: xhci_setup_packet_parameter(request_type, request, value, index, length),
        status: 8,
        control: control
    };
}

@system
pub fn xhci_trb_data_stage(buffer_physical: u64,
                           transfer_length: u32,
                           td_size: u8,
                           direction_in: bool,
                           interrupt_on_completion: bool,
                           cycle: bool) -> XhciTrb {
    let mut control = xhci_trb_type_bits(XHCI_TRB_TYPE_DATA_STAGE) |
        xhci_trb_cycle_bits(cycle);
    if direction_in { control = control | XHCI_TRB_DIR_IN_BIT; }
    if interrupt_on_completion { control = control | XHCI_TRB_IOC_BIT; }
    let status = (transfer_length & XHCI_TRB_TRANSFER_LENGTH_MASK) |
        (((td_size as u32) & XHCI_TRB_TD_SIZE_MASK) << XHCI_TRB_TD_SIZE_SHIFT);
    return XhciTrb {
        parameter: buffer_physical & 0xFFFFFFFFFFFFFFF0,
        status: status,
        control: control
    };
}

@system
pub fn xhci_trb_status_stage(direction_in: bool,
                             interrupt_on_completion: bool,
                             cycle: bool) -> XhciTrb {
    let mut control = xhci_trb_type_bits(XHCI_TRB_TYPE_STATUS_STAGE) |
        xhci_trb_cycle_bits(cycle);
    if direction_in { control = control | XHCI_TRB_DIR_IN_BIT; }
    if interrupt_on_completion { control = control | XHCI_TRB_IOC_BIT; }
    return XhciTrb { parameter: 0, status: 0, control: control };
}

@system
pub fn xhci_trb_normal(buffer_physical: u64,
                       transfer_length: u32,
                       td_size: u8,
                       interrupt_on_completion: bool,
                       cycle: bool) -> XhciTrb {
    let mut control = xhci_trb_type_bits(XHCI_TRB_TYPE_NORMAL) |
        xhci_trb_cycle_bits(cycle);
    if interrupt_on_completion { control = control | XHCI_TRB_IOC_BIT; }
    let status = (transfer_length & XHCI_TRB_TRANSFER_LENGTH_MASK) |
        (((td_size as u32) & XHCI_TRB_TD_SIZE_MASK) << XHCI_TRB_TD_SIZE_SHIFT);
    return XhciTrb {
        parameter: buffer_physical & 0xFFFFFFFFFFFFFFF0,
        status: status,
        control: control
    };
}
