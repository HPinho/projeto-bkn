// Baken OS — HID-4c: Enable Slot xHCI com registro bounded por Slot ID.
//
// O Command Ring continua sendo o produtor serializado do controller, mas cada
// completion de Enable Slot e publicada em xhci_device_table. A API legada do
// "primeiro slot" permanece como wrapper para preservar o bring-up certificado.

module kernel::drivers::xhci_slot;

import kernel::drivers::xhci_controller::*;
import kernel::drivers::xhci_command::*;
import kernel::drivers::xhci_port_stage::*;
import kernel::drivers::xhci_device_table::*;
import kernel::drivers::xhci_trb::*;

static mut XHCI_SLOT_READY: bool = false;
static mut XHCI_SLOT_ID: u8 = 0;
static mut XHCI_SLOT_PORT_ID: u8 = 0;
static mut XHCI_SLOT_TYPE: u8 = 0;

@system
pub fn xhci_slot_enable_port(port_id: u8, slot_type: u8) -> u8 {
    if port_id == 0 || !xhci_command_is_ready() || !xhci_device_table_initialize() {
        return 0;
    }
    if xhci_device_table_find_slot_for_port(port_id) != 0 { return 0; }

    let command = xhci_trb_enable_slot(slot_type, xhci_command_producer_cycle());
    let slot_id = xhci_command_execute_capture_slot(command);
    let max_slots = xhci_controller_max_slots();
    if slot_id == 0 || max_slots == 0 || slot_id > max_slots { return 0; }
    if !xhci_device_table_reserve(slot_id, port_id, slot_type) { return 0; }
    if !xhci_device_table_set_active(slot_id) { return 0; }
    return slot_id;
}

@system
pub fn xhci_slot_enable_first_port() -> bool {
    unsafe {
        XHCI_SLOT_READY = false;
        XHCI_SLOT_ID = 0;
        XHCI_SLOT_PORT_ID = 0;
        XHCI_SLOT_TYPE = 0;
    }

    if !xhci_port_stage_is_ready() || !xhci_command_is_ready() { return false; }
    let port_id = xhci_port_stage_port_id();
    let slot_type = xhci_port_stage_slot_type();
    if port_id == 0 { return false; }

    let slot_id = xhci_slot_enable_port(port_id, slot_type);
    if slot_id == 0 { return false; }

    unsafe {
        XHCI_SLOT_ID = slot_id;
        XHCI_SLOT_PORT_ID = port_id;
        XHCI_SLOT_TYPE = slot_type;
        XHCI_SLOT_READY = true;
    }
    return true;
}

@system
pub fn xhci_slot_select(slot_id: u8) -> bool {
    if !xhci_device_table_slot_is_valid(slot_id) || !xhci_device_table_set_active(slot_id) {
        return false;
    }
    unsafe {
        XHCI_SLOT_ID = slot_id;
        XHCI_SLOT_PORT_ID = xhci_device_table_port_id(slot_id);
        XHCI_SLOT_TYPE = xhci_device_table_slot_type(slot_id);
        XHCI_SLOT_READY = XHCI_SLOT_PORT_ID != 0;
        return XHCI_SLOT_READY;
    }
}

@system
pub fn xhci_slot_is_ready() -> bool {
    unsafe {
        return XHCI_SLOT_READY && XHCI_SLOT_ID != 0 &&
               xhci_device_table_slot_is_valid(XHCI_SLOT_ID);
    }
}

@system
pub fn xhci_slot_is_ready_for(slot_id: u8) -> bool {
    return xhci_device_table_slot_is_valid(slot_id);
}

@system
pub fn xhci_slot_id() -> u8 {
    unsafe {
        if XHCI_SLOT_ID != 0 && xhci_device_table_slot_is_valid(XHCI_SLOT_ID) {
            return XHCI_SLOT_ID;
        }
    }
    return xhci_device_table_active_slot_id();
}

@system
pub fn xhci_slot_port_id() -> u8 {
    let slot_id = xhci_slot_id();
    if slot_id == 0 { return 0; }
    return xhci_device_table_port_id(slot_id);
}

@system
pub fn xhci_slot_type() -> u8 {
    let slot_id = xhci_slot_id();
    if slot_id == 0 { return 0; }
    return xhci_device_table_slot_type(slot_id);
}

@system
pub fn xhci_slot_epoch(slot_id: u8) -> u32 {
    return xhci_device_table_slot_epoch(slot_id);
}

@system
pub fn xhci_slot_active_count() -> u16 {
    return xhci_device_table_active_count();
}
