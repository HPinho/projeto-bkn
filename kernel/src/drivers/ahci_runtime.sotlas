// Baken OS — runtime AHCI DMA e primeiro comando ATA real pós-cutover.
//
// O estágio de preparação publica Command List, Received FIS, Command Table e
// habilita Bus Master em uma porta implementada. O estágio seguinte espera o
// link SATA estabilizar, localiza uma porta ATA real e então emite IDENTIFY.
// Nenhuma escrita em mídia é realizada.

module kernel::drivers::ahci_runtime;

import kernel::arch::x86_64::cpu::*;
import kernel::arch::x86_64::serial::*;
import kernel::memory::dma::*;
import kernel::drivers::pci_bus::*;

pub const AHCI_RUNTIME_PAGE_SIZE: u64 = 4096;
pub const AHCI_RUNTIME_ARENA_PAGES: u64 = 4;
pub const AHCI_COMMAND_LIST_PAGE: u64 = 0;
pub const AHCI_RECEIVED_FIS_PAGE: u64 = 1;
pub const AHCI_COMMAND_TABLE_PAGE: u64 = 2;
pub const AHCI_IDENTIFY_DATA_PAGE: u64 = 3;

pub const AHCI_PORT_BASE: u64 = 0x100;
pub const AHCI_PORT_STRIDE: u64 = 0x80;
pub const AHCI_REG_PI: u64 = 0x0C;
pub const AHCI_PX_CLB: u64 = 0x00;
pub const AHCI_PX_CLBU: u64 = 0x04;
pub const AHCI_PX_FB: u64 = 0x08;
pub const AHCI_PX_FBU: u64 = 0x0C;
pub const AHCI_PX_IS: u64 = 0x10;
pub const AHCI_PX_CMD: u64 = 0x18;
pub const AHCI_PX_TFD: u64 = 0x20;
pub const AHCI_PX_SIG: u64 = 0x24;
pub const AHCI_PX_SSTS: u64 = 0x28;
pub const AHCI_PX_CI: u64 = 0x38;

pub const AHCI_PXCMD_ST: u32 = 1;
pub const AHCI_PXCMD_FRE: u32 = 1 << 4;
pub const AHCI_PXCMD_FR: u32 = 1 << 14;
pub const AHCI_PXCMD_CR: u32 = 1 << 15;
pub const AHCI_PXIS_TFES: u32 = 1 << 30;
pub const AHCI_TFD_ERR: u32 = 1;
pub const AHCI_TFD_DRQ: u32 = 1 << 3;
pub const AHCI_TFD_BSY: u32 = 1 << 7;
pub const AHCI_SSTS_DET_MASK: u32 = 0x0F;
pub const AHCI_SSTS_IPM_MASK: u32 = 0x0F00;
pub const AHCI_SSTS_DET_PRESENT: u32 = 3;
pub const AHCI_SSTS_IPM_ACTIVE: u32 = 0x0100;
pub const AHCI_SIG_ATA: u32 = 0x00000101;
pub const AHCI_ATA_IDENTIFY_DEVICE: u8 = 0xEC;
pub const AHCI_FIS_TYPE_REG_H2D: u8 = 0x27;
pub const AHCI_PORT_STOP_SPIN_LIMIT: u64 = 10000000;
pub const AHCI_IDENTIFY_SPIN_LIMIT: u64 = 20000000;

static mut AHCI_RUNTIME_READY: bool = false;
static mut AHCI_IDENTIFY_READY: bool = false;
static mut AHCI_RUNTIME_PORT: u32 = 0;
static mut AHCI_RUNTIME_HBA: u64 = 0;
static mut AHCI_RUNTIME_ARENA: DmaBuffer = DmaBuffer {
    virtual_address: null as *mut u8,
    physical_address: 0,
    size: 0,
    alignment: 0,
    owner: DMA_OWNER_CPU,
    fence: 0,
    valid: false
};
static mut AHCI_COMMAND_LIST_PHYSICAL: u64 = 0;
static mut AHCI_RECEIVED_FIS_PHYSICAL: u64 = 0;
static mut AHCI_COMMAND_TABLE_PHYSICAL: u64 = 0;
static mut AHCI_IDENTIFY_DATA_PHYSICAL: u64 = 0;

@system
fn ahci_runtime_zero(base: *mut u8, size: u64) -> bool {
    if base == (null as *mut u8) || size == 0 { return false; }
    unsafe {
        let mut offset: u64 = 0;
        while offset < size {
            let slot = ((base as usize) + (offset as usize)) as *mut u8;
            *slot = 0;
            offset += 1;
        }
    }
    return true;
}

@system
fn ahci_runtime_port_base(hba: u64, port: u32) -> u64 {
    return hba + AHCI_PORT_BASE + ((port as u64) * AHCI_PORT_STRIDE);
}

@system
fn ahci_runtime_first_implemented_port(pi: u32) -> u32 {
    let mut port: u32 = 0;
    while port < 32 {
        if (pi & (1 << port)) != 0 { return port; }
        port += 1;
    }
    return 32;
}

@system
fn ahci_runtime_first_ata_port(hba: u64, pi: u32) -> u32 {
    let mut port: u32 = 0;
    while port < 32 {
        if (pi & (1 << port)) != 0 {
            let base = ahci_runtime_port_base(hba, port);
            let ssts = x86_mmio_read32(base + AHCI_PX_SSTS);
            if (ssts & AHCI_SSTS_DET_MASK) == AHCI_SSTS_DET_PRESENT &&
               (ssts & AHCI_SSTS_IPM_MASK) == AHCI_SSTS_IPM_ACTIVE {
                // PxSIG is published by the initial D2H FIS after reset.
                // Bind valid DMA memory and enable reception BEFORE reading it.
                if !ahci_runtime_bind_dma_port(port) { return 32; }
                let cmd = x86_mmio_read32(base + AHCI_PX_CMD);
                if cmd == 0xFFFFFFFF { return 32; }
                x86_mmio_write32(base + AHCI_PX_CMD, cmd | AHCI_PXCMD_FRE);
                let mut spins: u64 = 0;
                while spins < AHCI_IDENTIFY_SPIN_LIMIT {
                    let sig = x86_mmio_read32(base + AHCI_PX_SIG);
                    if sig == AHCI_SIG_ATA { return port; }
                    if sig != 0xFFFFFFFF && sig != 0 { break; }
                    spins += 1;
                }
                // ATAPI/unknown ports must release the shared receive arena.
                if !ahci_runtime_stop_port(base) { return 32; }
            }
        }
        port += 1;
    }
    return 32;
}

@system
fn ahci_runtime_wait_ata_port(hba: u64, pi: u32) -> u32 {
    // Signature polling is bounded per connected port; do not nest 20M scans.
    return ahci_runtime_first_ata_port(hba, pi);
}

@system
fn ahci_runtime_stop_port(port_base: u64) -> bool {
    let cmd_before = x86_mmio_read32(port_base + AHCI_PX_CMD);
    if cmd_before == 0xFFFFFFFF { return false; }

    x86_mmio_write32(port_base + AHCI_PX_CMD, cmd_before & !AHCI_PXCMD_ST);
    let mut spins: u64 = 0;
    while spins < AHCI_PORT_STOP_SPIN_LIMIT {
        let cmd = x86_mmio_read32(port_base + AHCI_PX_CMD);
        if cmd == 0xFFFFFFFF { return false; }
        if (cmd & (AHCI_PXCMD_CR | AHCI_PXCMD_ST)) == 0 { break; }
        spins += 1;
    }
    if spins >= AHCI_PORT_STOP_SPIN_LIMIT { return false; }

    let cmd_after_st = x86_mmio_read32(port_base + AHCI_PX_CMD);
    if cmd_after_st == 0xFFFFFFFF { return false; }
    x86_mmio_write32(port_base + AHCI_PX_CMD, cmd_after_st & !AHCI_PXCMD_FRE);
    spins = 0;
    while spins < AHCI_PORT_STOP_SPIN_LIMIT {
        let cmd = x86_mmio_read32(port_base + AHCI_PX_CMD);
        if cmd == 0xFFFFFFFF { return false; }
        if (cmd & (AHCI_PXCMD_FR | AHCI_PXCMD_FRE)) == 0 { return true; }
        spins += 1;
    }
    return false;
}

@system
fn ahci_runtime_write64_pair(base: u64, low_offset: u64, high_offset: u64, value: u64) -> bool {
    x86_mmio_write32(base + low_offset, (value & 0xFFFFFFFF) as u32);
    x86_mmio_write32(base + high_offset, ((value >> 32) & 0xFFFFFFFF) as u32);
    let low = x86_mmio_read32(base + low_offset) as u64;
    let high = x86_mmio_read32(base + high_offset) as u64;
    return (low | (high << 32)) == value;
}

@system
fn ahci_runtime_bind_dma_port(port: u32) -> bool {
    unsafe {
        if port >= 32 || AHCI_RUNTIME_HBA == 0 { return false; }
        // A single DMA arena is reused: quiesce its previous owner first.
        if port != AHCI_RUNTIME_PORT {
            if !ahci_runtime_stop_port(ahci_runtime_port_base(AHCI_RUNTIME_HBA,
                                                            AHCI_RUNTIME_PORT)) { return false; }
        }
        let port_base = ahci_runtime_port_base(AHCI_RUNTIME_HBA, port);
        if !ahci_runtime_stop_port(port_base) { return false; }
        if !ahci_runtime_write64_pair(port_base, AHCI_PX_CLB, AHCI_PX_CLBU,
                                      AHCI_COMMAND_LIST_PHYSICAL) { return false; }
        if !ahci_runtime_write64_pair(port_base, AHCI_PX_FB, AHCI_PX_FBU,
                                      AHCI_RECEIVED_FIS_PHYSICAL) { return false; }
        let ci = x86_mmio_read32(port_base + AHCI_PX_CI);
        if ci == 0xFFFFFFFF || ci != 0 { return false; }
        AHCI_RUNTIME_PORT = port;
        return true;
    }
}

@system
pub fn ahci_runtime_prepare_dma(hba: u64, bus: u8, slot: u8, func: u8, pi: u32) -> bool {
    unsafe {
        AHCI_RUNTIME_READY = false;
        AHCI_IDENTIFY_READY = false;
    }
    if hba == 0 || pi == 0 || !dma_allocator_available() { return false; }

    let port = ahci_runtime_first_implemented_port(pi);
    if port >= 32 { return false; }
    let port_base = ahci_runtime_port_base(hba, port);
    if !ahci_runtime_stop_port(port_base) { return false; }

    let mut arena = dma_alloc(AHCI_RUNTIME_ARENA_PAGES * AHCI_RUNTIME_PAGE_SIZE,
                              AHCI_RUNTIME_PAGE_SIZE);
    if !dma_buffer_cpu_owned(&arena) { return false; }
    if !ahci_runtime_zero(arena.virtual_address, arena.size) { return false; }

    let command_list = arena.physical_address + AHCI_COMMAND_LIST_PAGE * AHCI_RUNTIME_PAGE_SIZE;
    let received_fis = arena.physical_address + AHCI_RECEIVED_FIS_PAGE * AHCI_RUNTIME_PAGE_SIZE;
    let command_table = arena.physical_address + AHCI_COMMAND_TABLE_PAGE * AHCI_RUNTIME_PAGE_SIZE;
    let identify_data = arena.physical_address + AHCI_IDENTIFY_DATA_PAGE * AHCI_RUNTIME_PAGE_SIZE;
    if (command_list & 0x3FF) != 0 || (received_fis & 0xFF) != 0 ||
       (command_table & 0x7F) != 0 || (identify_data & 0x1FF) != 0 { return false; }

    if !ahci_runtime_write64_pair(port_base, AHCI_PX_CLB, AHCI_PX_CLBU, command_list) { return false; }
    if !ahci_runtime_write64_pair(port_base, AHCI_PX_FB, AHCI_PX_FBU, received_fis) { return false; }

    unsafe {
        let header = arena.virtual_address as *mut u32;
        *header = 5;
        let ctba_low = ((arena.virtual_address as usize) + 8) as *mut u32;
        let ctba_high = ((arena.virtual_address as usize) + 12) as *mut u32;
        *ctba_low = (command_table & 0xFFFFFFFF) as u32;
        *ctba_high = ((command_table >> 32) & 0xFFFFFFFF) as u32;
    }

    if !dma_share_with_device(&mut arena) { return false; }
    pci_enable_command_bits(bus, slot, func, PCI_COMMAND_BUS_MASTER);
    let command = pci_read_config16(bus, slot, func, 0x04);
    if (command & PCI_COMMAND_MEMORY_SPACE) == 0 || (command & PCI_COMMAND_BUS_MASTER) == 0 {
        return false;
    }

    let cmd_verify = x86_mmio_read32(port_base + AHCI_PX_CMD);
    let ci_verify = x86_mmio_read32(port_base + AHCI_PX_CI);
    if cmd_verify == 0xFFFFFFFF || ci_verify == 0xFFFFFFFF || ci_verify != 0 { return false; }
    if (cmd_verify & (AHCI_PXCMD_ST | AHCI_PXCMD_FRE | AHCI_PXCMD_CR | AHCI_PXCMD_FR)) != 0 {
        return false;
    }

    unsafe {
        AHCI_RUNTIME_ARENA = arena;
        AHCI_RUNTIME_PORT = port;
        AHCI_RUNTIME_HBA = hba;
        AHCI_COMMAND_LIST_PHYSICAL = command_list;
        AHCI_RECEIVED_FIS_PHYSICAL = received_fis;
        AHCI_COMMAND_TABLE_PHYSICAL = command_table;
        AHCI_IDENTIFY_DATA_PHYSICAL = identify_data;
        AHCI_RUNTIME_READY = true;
    }
    x86_serial_write_stage_marker('c' as u8);
    return true;
}

@system
pub fn ahci_runtime_identify_device() -> bool {
    unsafe { AHCI_IDENTIFY_READY = false; }
    if !ahci_runtime_is_ready() { return false; }

    unsafe {
        let pi = x86_mmio_read32(AHCI_RUNTIME_HBA + AHCI_REG_PI);
        if pi == 0 || pi == 0xFFFFFFFF { return false; }
        let ata_port = ahci_runtime_wait_ata_port(AHCI_RUNTIME_HBA, pi);
        if ata_port >= 32 { return false; }
        if ata_port != AHCI_RUNTIME_PORT {
            if !ahci_runtime_bind_dma_port(ata_port) { return false; }
        }

        let port_base = ahci_runtime_port_base(AHCI_RUNTIME_HBA, AHCI_RUNTIME_PORT);
        let arena_base = AHCI_RUNTIME_ARENA.virtual_address;
        if arena_base == (null as *mut u8) { return false; }

        let table = ((arena_base as usize) +
            ((AHCI_COMMAND_TABLE_PAGE * AHCI_RUNTIME_PAGE_SIZE) as usize)) as *mut u8;
        let identify = ((arena_base as usize) +
            ((AHCI_IDENTIFY_DATA_PAGE * AHCI_RUNTIME_PAGE_SIZE) as usize)) as *mut u8;
        if !ahci_runtime_zero(table, AHCI_RUNTIME_PAGE_SIZE) ||
           !ahci_runtime_zero(identify, 512) { return false; }

        let header0 = arena_base as *mut u32;
        *header0 = 5 | (1 << 16);
        let prdbc = ((arena_base as usize) + 4) as *mut u32;
        *prdbc = 0;

        *table = AHCI_FIS_TYPE_REG_H2D;
        *(((table as usize) + 1) as *mut u8) = 0x80;
        *(((table as usize) + 2) as *mut u8) = AHCI_ATA_IDENTIFY_DEVICE;

        let prdt = ((table as usize) + 0x80) as *mut u32;
        *prdt = (AHCI_IDENTIFY_DATA_PHYSICAL & 0xFFFFFFFF) as u32;
        *(((prdt as usize) + 4) as *mut u32) =
            ((AHCI_IDENTIFY_DATA_PHYSICAL >> 32) & 0xFFFFFFFF) as u32;
        *(((prdt as usize) + 8) as *mut u32) = 0;
        *(((prdt as usize) + 12) as *mut u32) = (511 as u32) | (1 << 31);

        x86_mmio_write32(port_base + AHCI_PX_IS, 0xFFFFFFFF);
        let mut cmd = x86_mmio_read32(port_base + AHCI_PX_CMD);
        if cmd == 0xFFFFFFFF { return false; }
        cmd |= AHCI_PXCMD_FRE;
        x86_mmio_write32(port_base + AHCI_PX_CMD, cmd);
        cmd |= AHCI_PXCMD_ST;
        x86_mmio_write32(port_base + AHCI_PX_CMD, cmd);

        let mut spins: u64 = 0;
        while spins < AHCI_IDENTIFY_SPIN_LIMIT {
            let tfd = x86_mmio_read32(port_base + AHCI_PX_TFD);
            if tfd == 0xFFFFFFFF { return false; }
            if (tfd & (AHCI_TFD_BSY | AHCI_TFD_DRQ)) == 0 { break; }
            spins += 1;
        }
        if spins >= AHCI_IDENTIFY_SPIN_LIMIT { return false; }

        x86_mmio_write32(port_base + AHCI_PX_CI, 1);
        spins = 0;
        while spins < AHCI_IDENTIFY_SPIN_LIMIT {
            let isr = x86_mmio_read32(port_base + AHCI_PX_IS);
            let ci = x86_mmio_read32(port_base + AHCI_PX_CI);
            if isr == 0xFFFFFFFF || ci == 0xFFFFFFFF { return false; }
            if (isr & AHCI_PXIS_TFES) != 0 { return false; }
            if (ci & 1) == 0 {
                let tfd = x86_mmio_read32(port_base + AHCI_PX_TFD);
                if (tfd & AHCI_TFD_ERR) != 0 { return false; }
                let word0 = *(identify as *const u16);
                if word0 == 0 || word0 == 0xFFFF { return false; }
                AHCI_IDENTIFY_READY = true;
                x86_serial_write_stage_marker('d' as u8);
                return true;
            }
            spins += 1;
        }
    }
    return false;
}

@system
pub fn ahci_runtime_is_ready() -> bool { unsafe { return AHCI_RUNTIME_READY; } }
@system
pub fn ahci_identify_is_ready() -> bool { unsafe { return AHCI_IDENTIFY_READY; } }
@system
pub fn ahci_runtime_port() -> u32 { unsafe { return AHCI_RUNTIME_PORT; } }
@system
pub fn ahci_runtime_command_list_physical() -> u64 { unsafe { return AHCI_COMMAND_LIST_PHYSICAL; } }
@system
pub fn ahci_runtime_received_fis_physical() -> u64 { unsafe { return AHCI_RECEIVED_FIS_PHYSICAL; } }
@system
pub fn ahci_runtime_command_table_physical() -> u64 { unsafe { return AHCI_COMMAND_TABLE_PHYSICAL; } }
@system
pub fn ahci_identify_data_physical() -> u64 { unsafe { return AHCI_IDENTIFY_DATA_PHYSICAL; } }
