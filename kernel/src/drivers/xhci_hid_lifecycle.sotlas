// Baken OS — HID-4d.1/4d.2b/4d.3b/4d.3c2: detach e teardown seguro.
//
// DETACH_PENDING permanece generation-safe. HID-4d.2b para apenas o endpoint
// HID do mesmo slot+epoch, drena o TD outstanding e registra endpoint_stopped.
// HID-4d.3b abre uma transacao logica idempotente somente depois do drain e
// conclui identity/descriptor/report/transfer state em ordem exact-epoch.
// HID-4d.3c2 autoriza o release do HID Transfer Ring somente depois de 3c1 ter
// provado Drop Endpoint + Output Endpoint Context Disabled para o mesmo epoch.
// Device/Input Context, EP0 ring, DCBAA e Slot ID continuam fora desta etapa.

module kernel::drivers::xhci_hid_lifecycle;

import kernel::arch::x86_64::cpu::*;
import kernel::sync::spinlock::*;
import kernel::drivers::xhci_port::*;
import kernel::drivers::xhci_device_table::*;
import kernel::drivers::xhci_hid_context::*;
import kernel::drivers::xhci_hid_descriptor::*;
import kernel::drivers::xhci_hid_report::*;
import kernel::drivers::xhci_transfer::*;
import kernel::drivers::xhci_command::*;
import kernel::drivers::xhci_configure_endpoint::*;
import kernel::drivers::xhci_trb::*;

pub const XHCI_HID_LIFECYCLE_SLOT_CAPACITY: usize = XHCI_DEVICE_SLOT_CAPACITY;

pub struct XhciHidLifecycleState {
    pub valid: bool;
    pub epoch: u32;
    pub detach_detected: bool;
    pub endpoint_stopped: bool;
    pub logical_teardown_started: bool;
    pub logical_teardown_complete: bool;
}

static mut XHCI_HID_LIFECYCLE_STATES: [XhciHidLifecycleState; XHCI_HID_LIFECYCLE_SLOT_CAPACITY] = [
    XhciHidLifecycleState {
        valid: false,
        epoch: 0,
        detach_detected: false,
        endpoint_stopped: false,
        logical_teardown_started: false,
        logical_teardown_complete: false
    };
    XHCI_HID_LIFECYCLE_SLOT_CAPACITY
];
static mut XHCI_HID_LIFECYCLE_LAST_SCAN_OK: bool = false;
static mut XHCI_HID_LIFECYCLE_DETACH_PENDING_COUNT: u16 = 0;
static mut XHCI_HID_LIFECYCLE_TEARDOWN_LOCK: SpinLock = SpinLock { state: SPINLOCK_UNLOCKED };

@system
fn xhci_hid_lifecycle_index(slot_id: u8) -> usize {
    if slot_id == 0 { return XHCI_HID_LIFECYCLE_SLOT_CAPACITY; }
    return slot_id as usize;
}

// Serializa a sequência que pode chegar a dma_release. O lock é global nesta
// etapa porque teardown é raro e isso evita dois CPUs desmontarem o mesmo slot
// simultaneamente. IRQ save/restore segue o padrão dos registries SMP-safe.
@system
fn xhci_hid_lifecycle_teardown_lock_irq() -> u64 {
    let flags = x86_irq_save_disable();
    unsafe {
        if !spinlock_lock(&mut XHCI_HID_LIFECYCLE_TEARDOWN_LOCK) {
            x86_irq_restore(flags);
            return 0;
        }
    }
    return flags;
}

@system
fn xhci_hid_lifecycle_teardown_unlock_irq(flags: u64) -> void {
    let mut released = false;
    unsafe { released = spinlock_unlock(&mut XHCI_HID_LIFECYCLE_TEARDOWN_LOCK); }
    if !released { loop { x86_cpu_pause(); } }
    x86_irq_restore(flags);
}

@system
fn xhci_hid_lifecycle_publish_detach(slot_id: u8, epoch: u32) -> bool {
    let index = xhci_hid_lifecycle_index(slot_id);
    if index >= XHCI_HID_LIFECYCLE_SLOT_CAPACITY || epoch == 0 { return false; }
    unsafe {
        if XHCI_HID_LIFECYCLE_STATES[index].valid &&
           XHCI_HID_LIFECYCLE_STATES[index].epoch == epoch {
            XHCI_HID_LIFECYCLE_STATES[index].detach_detected = true;
            return true;
        }
        XHCI_HID_LIFECYCLE_STATES[index].valid = true;
        XHCI_HID_LIFECYCLE_STATES[index].epoch = epoch;
        XHCI_HID_LIFECYCLE_STATES[index].detach_detected = true;
        XHCI_HID_LIFECYCLE_STATES[index].endpoint_stopped = false;
        XHCI_HID_LIFECYCLE_STATES[index].logical_teardown_started = false;
        XHCI_HID_LIFECYCLE_STATES[index].logical_teardown_complete = false;
    }
    return true;
}

@system
pub fn xhci_hid_lifecycle_is_detach_pending_for(slot_id: u8, epoch: u32) -> bool {
    if slot_id == 0 || epoch == 0 || !xhci_device_table_slot_is_valid(slot_id) ||
       xhci_device_table_slot_epoch(slot_id) != epoch {
        return false;
    }
    return xhci_device_table_state(slot_id) == XHCI_DEVICE_STATE_DETACH_PENDING;
}

// HID-4d.3b prerequisite: report pending e transfer mailbox sao consultados
// pela identidade exata slot+epoch. As revalidacoes de DETACH_PENDING antes,
// entre e depois das consultas continuam como barreira TOCTOU fail-closed.
@system
fn xhci_hid_lifecycle_quiescent_for(slot_id: u8, epoch: u32) -> bool {
    if !xhci_hid_lifecycle_is_detach_pending_for(slot_id, epoch) { return false; }
    if xhci_hid_report_transfer_pending_for_epoch(slot_id, epoch) { return false; }
    if !xhci_hid_lifecycle_is_detach_pending_for(slot_id, epoch) { return false; }
    if xhci_transfer_pending_is_ready_for_epoch(slot_id, epoch) { return false; }
    return xhci_hid_lifecycle_is_detach_pending_for(slot_id, epoch);
}

@system
pub fn xhci_hid_lifecycle_mark_detached_for(slot_id: u8, epoch: u32) -> bool {
    if slot_id == 0 || epoch == 0 || !xhci_device_table_slot_is_valid(slot_id) ||
       xhci_device_table_slot_epoch(slot_id) != epoch {
        return false;
    }
    let state = xhci_device_table_state(slot_id);
    if state != XHCI_DEVICE_STATE_HID_READY &&
       state != XHCI_DEVICE_STATE_DETACH_PENDING {
        return false;
    }
    let port_id = xhci_device_table_port_id(slot_id);
    if port_id == 0 { return false; }
    let snapshot = xhci_port_snapshot(port_id);
    if snapshot == (null as *const XhciPortSnapshot) { return false; }
    unsafe {
        if !(*snapshot).valid || (*snapshot).port_id != port_id || (*snapshot).connected {
            return false;
        }
    }
    if !xhci_device_table_mark_detach_pending(slot_id, epoch) { return false; }
    return xhci_hid_lifecycle_publish_detach(slot_id, epoch);
}

@system
pub fn xhci_hid_lifecycle_scan_detached() -> bool {
    unsafe {
        XHCI_HID_LIFECYCLE_LAST_SCAN_OK = false;
        XHCI_HID_LIFECYCLE_DETACH_PENDING_COUNT = 0;
    }
    if xhci_port_scan() == 0 { return false; }

    let mut pending_count: u16 = 0;
    let mut index: usize = 1;
    while index < XHCI_DEVICE_SLOT_CAPACITY {
        let slot_id = index as u8;
        if xhci_device_table_slot_is_valid(slot_id) {
            let epoch = xhci_device_table_slot_epoch(slot_id);
            let state = xhci_device_table_state(slot_id);
            if epoch == 0 { return false; }
            if state == XHCI_DEVICE_STATE_HID_READY ||
               state == XHCI_DEVICE_STATE_DETACH_PENDING {
                let port_id = xhci_device_table_port_id(slot_id);
                if port_id == 0 { return false; }
                let snapshot = xhci_port_snapshot(port_id);
                if snapshot == (null as *const XhciPortSnapshot) { return false; }
                unsafe {
                    if !(*snapshot).valid || (*snapshot).port_id != port_id {
                        return false;
                    }
                    if !(*snapshot).connected {
                        if !xhci_hid_lifecycle_mark_detached_for(slot_id, epoch) {
                            return false;
                        }
                        pending_count += 1;
                    } else if state == XHCI_DEVICE_STATE_DETACH_PENDING {
                        if !xhci_hid_lifecycle_publish_detach(slot_id, epoch) {
                            return false;
                        }
                        pending_count += 1;
                    }
                }
            }
        }
        index += 1;
    }

    unsafe {
        XHCI_HID_LIFECYCLE_DETACH_PENDING_COUNT = pending_count;
        XHCI_HID_LIFECYCLE_LAST_SCAN_OK = true;
    }
    return true;
}

@system
pub fn xhci_hid_lifecycle_endpoint_stopped_for(slot_id: u8, epoch: u32) -> bool {
    if !xhci_hid_lifecycle_is_detach_pending_for(slot_id, epoch) { return false; }
    let index = xhci_hid_lifecycle_index(slot_id);
    if index >= XHCI_HID_LIFECYCLE_SLOT_CAPACITY { return false; }
    unsafe {
        return XHCI_HID_LIFECYCLE_STATES[index].valid &&
               XHCI_HID_LIFECYCLE_STATES[index].epoch == epoch &&
               XHCI_HID_LIFECYCLE_STATES[index].detach_detected &&
               XHCI_HID_LIFECYCLE_STATES[index].endpoint_stopped;
    }
}

@system
pub fn xhci_hid_lifecycle_stop_endpoint_for(slot_id: u8, epoch: u32) -> bool {
    if !xhci_hid_lifecycle_is_detach_pending_for(slot_id, epoch) ||
       !xhci_hid_context_is_ready_for(slot_id) || !xhci_command_is_ready() {
        return false;
    }
    let index = xhci_hid_lifecycle_index(slot_id);
    if index >= XHCI_HID_LIFECYCLE_SLOT_CAPACITY { return false; }
    unsafe {
        if !XHCI_HID_LIFECYCLE_STATES[index].valid ||
           XHCI_HID_LIFECYCLE_STATES[index].epoch != epoch ||
           !XHCI_HID_LIFECYCLE_STATES[index].detach_detected {
            return false;
        }
        if XHCI_HID_LIFECYCLE_STATES[index].endpoint_stopped { return true; }
    }

    let dci = xhci_hid_context_dci_for(slot_id);
    if dci <= 1 { return false; }
    if !xhci_hid_lifecycle_is_detach_pending_for(slot_id, epoch) { return false; }
    let had_pending = xhci_hid_report_transfer_pending_for_epoch(slot_id, epoch);
    if !xhci_hid_lifecycle_is_detach_pending_for(slot_id, epoch) { return false; }

    let command = xhci_trb_stop_endpoint(
        slot_id, dci, xhci_command_producer_cycle()
    );
    if !xhci_command_execute(command, slot_id) { return false; }
    if !xhci_hid_lifecycle_is_detach_pending_for(slot_id, epoch) { return false; }

    if had_pending {
        if !xhci_hid_lifecycle_is_detach_pending_for(slot_id, epoch) { return false; }
        if !xhci_hid_report_drain_cancelled_for_slot(slot_id) { return false; }
        if !xhci_hid_lifecycle_is_detach_pending_for(slot_id, epoch) { return false; }
    }
    if !xhci_hid_lifecycle_quiescent_for(slot_id, epoch) { return false; }

    unsafe { XHCI_HID_LIFECYCLE_STATES[index].endpoint_stopped = true; }
    return true;
}

@system
pub fn xhci_hid_lifecycle_can_finalize_for(slot_id: u8, epoch: u32) -> bool {
    if !xhci_hid_lifecycle_endpoint_stopped_for(slot_id, epoch) { return false; }
    return xhci_hid_lifecycle_quiescent_for(slot_id, epoch);
}

// HID-4d.3b1: abre a transacao de teardown logico somente para a geracao
// corrente, depois de Stop Endpoint + drain. Nenhum recurso e liberado aqui.
// Chamadas repetidas para o mesmo slot+epoch sao idempotentes; um epoch antigo
// falha fechado antes de alterar o estado da geracao nova.
@system
pub fn xhci_hid_lifecycle_begin_logical_teardown_for(slot_id: u8, epoch: u32) -> bool {
    if !xhci_hid_lifecycle_can_finalize_for(slot_id, epoch) { return false; }
    let index = xhci_hid_lifecycle_index(slot_id);
    if index >= XHCI_HID_LIFECYCLE_SLOT_CAPACITY { return false; }
    unsafe {
        if !XHCI_HID_LIFECYCLE_STATES[index].valid ||
           XHCI_HID_LIFECYCLE_STATES[index].epoch != epoch ||
           !XHCI_HID_LIFECYCLE_STATES[index].detach_detected ||
           !XHCI_HID_LIFECYCLE_STATES[index].endpoint_stopped {
            return false;
        }
        if XHCI_HID_LIFECYCLE_STATES[index].logical_teardown_started { return true; }
        XHCI_HID_LIFECYCLE_STATES[index].logical_teardown_started = true;
    }
    return true;
}

@system
pub fn xhci_hid_lifecycle_logical_teardown_started_for(slot_id: u8, epoch: u32) -> bool {
    if !xhci_hid_lifecycle_is_detach_pending_for(slot_id, epoch) { return false; }
    let index = xhci_hid_lifecycle_index(slot_id);
    if index >= XHCI_HID_LIFECYCLE_SLOT_CAPACITY { return false; }
    unsafe {
        return XHCI_HID_LIFECYCLE_STATES[index].valid &&
               XHCI_HID_LIFECYCLE_STATES[index].epoch == epoch &&
               XHCI_HID_LIFECYCLE_STATES[index].detach_detected &&
               XHCI_HID_LIFECYCLE_STATES[index].endpoint_stopped &&
               XHCI_HID_LIFECYCLE_STATES[index].logical_teardown_started;
    }
}

// HID-4d.3b: fecha a transacao logica somente depois de todos os sub-cleanups
// generation-safe. O lock cobre toda a sequência que pode chegar a dma_release,
// eliminando double-free entre CPUs. Antes de qualquer cleanup, o preflight de
// transfer rejeita mailbox ainda válida e qualquer resultado de epoch estranho.
@system
pub fn xhci_hid_lifecycle_complete_logical_teardown_for(slot_id: u8, epoch: u32) -> bool {
    let index = xhci_hid_lifecycle_index(slot_id);
    if index >= XHCI_HID_LIFECYCLE_SLOT_CAPACITY || epoch == 0 { return false; }

    let flags = xhci_hid_lifecycle_teardown_lock_irq();
    if flags == 0 { return false; }

    let mut complete_ok = xhci_hid_lifecycle_logical_teardown_started_for(slot_id, epoch);
    let mut already_complete = false;
    unsafe {
        if complete_ok {
            already_complete = XHCI_HID_LIFECYCLE_STATES[index].logical_teardown_complete;
        }
    }

    if complete_ok && !already_complete {
        complete_ok = xhci_transfer_teardown_state_safe_for_epoch(slot_id, epoch);
    }
    if complete_ok && !already_complete {
        complete_ok = xhci_hid_descriptor_teardown_input_device_for_epoch(slot_id, epoch);
    }
    if complete_ok && !already_complete {
        complete_ok = xhci_hid_lifecycle_logical_teardown_started_for(slot_id, epoch);
    }

    if complete_ok && !already_complete {
        complete_ok = xhci_hid_descriptor_teardown_dma_for_epoch(slot_id, epoch);
    }
    if complete_ok && !already_complete {
        complete_ok = xhci_hid_lifecycle_logical_teardown_started_for(slot_id, epoch);
    }

    if complete_ok && !already_complete {
        complete_ok = xhci_hid_report_teardown_dma_for_epoch(slot_id, epoch);
    }
    if complete_ok && !already_complete {
        complete_ok = xhci_hid_lifecycle_logical_teardown_started_for(slot_id, epoch);
    }

    if complete_ok && !already_complete {
        complete_ok = xhci_transfer_clear_slot_state_for_epoch(slot_id, epoch);
    }
    if complete_ok && !already_complete {
        complete_ok = xhci_hid_lifecycle_logical_teardown_started_for(slot_id, epoch) &&
                      xhci_hid_lifecycle_quiescent_for(slot_id, epoch);
    }

    if complete_ok && !already_complete {
        unsafe {
            if !XHCI_HID_LIFECYCLE_STATES[index].valid ||
               XHCI_HID_LIFECYCLE_STATES[index].epoch != epoch ||
               !XHCI_HID_LIFECYCLE_STATES[index].detach_detected ||
               !XHCI_HID_LIFECYCLE_STATES[index].endpoint_stopped ||
               !XHCI_HID_LIFECYCLE_STATES[index].logical_teardown_started {
                complete_ok = false;
            } else {
                XHCI_HID_LIFECYCLE_STATES[index].logical_teardown_complete = true;
            }
        }
    }

    xhci_hid_lifecycle_teardown_unlock_irq(flags);
    return complete_ok;
}

@system
pub fn xhci_hid_lifecycle_logical_teardown_complete_for(slot_id: u8, epoch: u32) -> bool {
    if !xhci_hid_lifecycle_logical_teardown_started_for(slot_id, epoch) { return false; }
    let index = xhci_hid_lifecycle_index(slot_id);
    if index >= XHCI_HID_LIFECYCLE_SLOT_CAPACITY { return false; }
    unsafe {
        return XHCI_HID_LIFECYCLE_STATES[index].valid &&
               XHCI_HID_LIFECYCLE_STATES[index].epoch == epoch &&
               XHCI_HID_LIFECYCLE_STATES[index].detach_detected &&
               XHCI_HID_LIFECYCLE_STATES[index].endpoint_stopped &&
               XHCI_HID_LIFECYCLE_STATES[index].logical_teardown_started &&
               XHCI_HID_LIFECYCLE_STATES[index].logical_teardown_complete;
    }
}

// HID-4d.3c2: libera somente o HID Transfer Ring do mesmo slot+epoch. O mesmo
// teardown lock de 3b cobre a transição de ownership e impede double-free entre
// CPUs. 3c1 deve ter sido concluído antes desta chamada; esta função não emite
// Configure Endpoint e portanto não antecipa a orquestração reservada a 3c3.
@system
pub fn xhci_hid_lifecycle_release_transfer_ring_for(slot_id: u8, epoch: u32) -> bool {
    let index = xhci_hid_lifecycle_index(slot_id);
    if index >= XHCI_HID_LIFECYCLE_SLOT_CAPACITY || epoch == 0 { return false; }

    let flags = xhci_hid_lifecycle_teardown_lock_irq();
    if flags == 0 { return false; }

    let mut release_ok = xhci_hid_lifecycle_is_detach_pending_for(slot_id, epoch) &&
        xhci_hid_lifecycle_logical_teardown_complete_for(slot_id, epoch);

    if release_ok {
        release_ok = xhci_configure_endpoint_drop_complete_for(slot_id, epoch);
    }
    if release_ok && !xhci_hid_context_ring_release_complete_for(slot_id, epoch) {
        release_ok = xhci_hid_context_release_ring_for_epoch(slot_id, epoch);
    }
    if release_ok {
        release_ok = xhci_hid_lifecycle_is_detach_pending_for(slot_id, epoch) &&
                     xhci_hid_lifecycle_logical_teardown_complete_for(slot_id, epoch) &&
                     xhci_configure_endpoint_drop_complete_for(slot_id, epoch) &&
                     xhci_hid_context_ring_release_complete_for(slot_id, epoch);
    }

    xhci_hid_lifecycle_teardown_unlock_irq(flags);
    return release_ok;
}

@system
pub fn xhci_hid_lifecycle_last_scan_ok() -> bool {
    unsafe { return XHCI_HID_LIFECYCLE_LAST_SCAN_OK; }
}

@system
pub fn xhci_hid_lifecycle_detach_pending_count() -> u16 {
    unsafe { return XHCI_HID_LIFECYCLE_DETACH_PENDING_COUNT; }
}
