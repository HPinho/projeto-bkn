// Baken OS - enumeracao PCI legada por Configuration Mechanism #1.
//
// A varredura e deliberadamente READ-ONLY. Enumerar um dispositivo nao deve
// habilitar Bus Master, I/O Space ou Memory Space, nem escrever 0xFFFFFFFF em
// BARs ativos. Drivers proprietarios do dispositivo fazem essas transicoes
// explicitamente depois de validar classe, recursos, DMA e MMIO.

module kernel::drivers::pci_bus;

pub const PCI_CONFIG_ADDRESS_PORT: u16 = 0x0CF8;
pub const PCI_CONFIG_DATA_PORT: u16    = 0x0CFC;

pub const PCI_MAX_BUSES: u16 = 256;
pub const PCI_MAX_SLOTS: u8  = 32;
pub const PCI_MAX_FUNCS: u8  = 8;
pub const PCI_MAX_DISCOVERED: usize = 64;

pub const PCI_CLASS_DISPLAY: u8 = 0x03;
pub const PCI_SUBCLASS_VGA: u8   = 0x00;
pub const PCI_SUBCLASS_XGA: u8   = 0x01;
pub const PCI_SUBCLASS_3D: u8    = 0x02;
pub const PCI_SUBCLASS_OTHER: u8 = 0x80;

pub const PCI_COMMAND_IO_SPACE: u16     = 1;
pub const PCI_COMMAND_MEMORY_SPACE: u16 = 2;
pub const PCI_COMMAND_BUS_MASTER: u16   = 4;

pub struct PciBar {
    pub base_address: u64;
    // size=0 significa "ainda nao dimensionado". O sizing destrutivo de BAR
    // nao faz parte da enumeracao global.
    pub size: u64;
    pub is_io: bool;
    pub is_64bit: bool;
    pub is_prefetchable: bool;
}

pub struct PciDevice {
    pub bus: u8;
    pub slot: u8;
    pub func: u8;
    pub vendor_id: u16;
    pub device_id: u16;
    pub class_code: u8;
    pub subclass: u8;
    pub prog_if: u8;
    pub revision_id: u8;
    pub subsystem_vendor: u16;
    pub subsystem_id: u16;
    pub header_type: u8;
    pub command: u16;
    pub bars: [PciBar; 6];
}

static mut PCI_DEVICES: [PciDevice; PCI_MAX_DISCOVERED] = [
    PciDevice {
        bus: 0, slot: 0, func: 0,
        vendor_id: 0, device_id: 0,
        class_code: 0, subclass: 0, prog_if: 0, revision_id: 0,
        subsystem_vendor: 0, subsystem_id: 0,
        header_type: 0, command: 0,
        bars: [
            PciBar { base_address: 0, size: 0, is_io: false, is_64bit: false, is_prefetchable: false },
            PciBar { base_address: 0, size: 0, is_io: false, is_64bit: false, is_prefetchable: false },
            PciBar { base_address: 0, size: 0, is_io: false, is_64bit: false, is_prefetchable: false },
            PciBar { base_address: 0, size: 0, is_io: false, is_64bit: false, is_prefetchable: false },
            PciBar { base_address: 0, size: 0, is_io: false, is_64bit: false, is_prefetchable: false },
            PciBar { base_address: 0, size: 0, is_io: false, is_64bit: false, is_prefetchable: false }
        ]
    }; PCI_MAX_DISCOVERED
];

static mut PCI_DEVICE_COUNT: u32 = 0;
static mut PCI_DISPLAY_DEVICE_INDEX: i32 = -1;

@system
pub fn pci_read_config32(bus: u8, slot: u8, func: u8, offset: u8) -> u32 {
    let address: u32 = 0x80000000 |
        ((bus as u32) << 16) |
        (((slot & 0x1F) as u32) << 11) |
        (((func & 0x07) as u32) << 8) |
        ((offset & 0xFC) as u32);
    baken_pci_out32(PCI_CONFIG_ADDRESS_PORT, address);
    return baken_pci_in32(PCI_CONFIG_DATA_PORT);
}

@system
pub fn pci_write_config32(bus: u8, slot: u8, func: u8, offset: u8, value: u32) -> void {
    let address: u32 = 0x80000000 |
        ((bus as u32) << 16) |
        (((slot & 0x1F) as u32) << 11) |
        (((func & 0x07) as u32) << 8) |
        ((offset & 0xFC) as u32);
    baken_pci_out32(PCI_CONFIG_ADDRESS_PORT, address);
    baken_pci_out32(PCI_CONFIG_DATA_PORT, value);
}

@system
pub fn pci_read_config16(bus: u8, slot: u8, func: u8, offset: u8) -> u16 {
    let dword = pci_read_config32(bus, slot, func, offset);
    let shift: u32 = ((offset & 2) as u32) * 8;
    return ((dword >> shift) & 0xFFFF) as u16;
}

@system
pub fn pci_read_config8(bus: u8, slot: u8, func: u8, offset: u8) -> u8 {
    let dword = pci_read_config32(bus, slot, func, offset);
    let shift: u32 = ((offset & 3) as u32) * 8;
    return ((dword >> shift) & 0xFF) as u8;
}

@system
pub fn pci_write_command(bus: u8, slot: u8, func: u8, command: u16) -> void {
    let current = pci_read_config32(bus, slot, func, 0x04);
    let updated = (current & 0xFFFF0000) | (command as u32);
    pci_write_config32(bus, slot, func, 0x04, updated);
}

// Compatibilidade de API: habilita somente Memory Space + Bus Master.
// I/O Space nao e ativado automaticamente. Drivers devem preferir
// pci_enable_command_bits() e solicitar apenas capacidades que utilizam.
@system
pub fn pci_enable_device(bus: u8, slot: u8, func: u8) -> void {
    pci_enable_command_bits(bus, slot, func,
        PCI_COMMAND_MEMORY_SPACE | PCI_COMMAND_BUS_MASTER);
}

@system
pub fn pci_enable_command_bits(bus: u8, slot: u8, func: u8, bits: u16) -> void {
    let allowed: u16 = PCI_COMMAND_IO_SPACE | PCI_COMMAND_MEMORY_SPACE | PCI_COMMAND_BUS_MASTER;
    let requested: u16 = bits & allowed;
    let current: u16 = pci_read_config16(bus, slot, func, 0x04);
    pci_write_command(bus, slot, func, current | requested);
}

// Decodifica o valor ATUAL do BAR sem alterar o dispositivo. size permanece
// zero ate um driver fazer sizing controlado com o dispositivo quiescente.
@system
pub fn pci_probe_bar(bus: u8, slot: u8, func: u8, bar_index: u8, out_bar: *mut PciBar) -> u8 {
    if out_bar == (null as *mut PciBar) || bar_index >= 6 { return 1; }

    let offset: u8 = 0x10 + (bar_index * 4);
    let low: u32 = pci_read_config32(bus, slot, func, offset);

    unsafe {
        (*out_bar).base_address = 0;
        (*out_bar).size = 0;
        (*out_bar).is_io = false;
        (*out_bar).is_64bit = false;
        (*out_bar).is_prefetchable = false;
    }

    if low == 0 || low == 0xFFFFFFFF { return 1; }

    if (low & 1) != 0 {
        unsafe {
            (*out_bar).base_address = (low & 0xFFFFFFFC) as u64;
            (*out_bar).is_io = true;
        }
        return 1;
    }

    let bar_type: u32 = (low >> 1) & 3;
    let is_64bit: bool = bar_type == 2;
    let prefetchable: bool = (low & 8) != 0;
    let mut base: u64 = (low & 0xFFFFFFF0) as u64;

    if is_64bit && bar_index < 5 {
        let high = pci_read_config32(bus, slot, func, offset + 4);
        base = base | ((high as u64) << 32);
        unsafe {
            (*out_bar).base_address = base;
            (*out_bar).is_64bit = true;
            (*out_bar).is_prefetchable = prefetchable;
        }
        return 2;
    }

    unsafe {
        (*out_bar).base_address = base;
        (*out_bar).is_prefetchable = prefetchable;
    }
    return 1;
}

@system
pub fn pci_scan_all() -> u32 {
    unsafe {
        PCI_DEVICE_COUNT = 0;
        PCI_DISPLAY_DEVICE_INDEX = -1;

        for mut bus in 0..256 {
            for mut slot in 0..32 {
                let vendor0 = pci_read_config16(bus as u8, slot as u8, 0, 0x00);
                if vendor0 == 0xFFFF || vendor0 == 0 { continue; }

                let header0 = pci_read_config8(bus as u8, slot as u8, 0, 0x0E);
                let functions: u8 = if (header0 & 0x80) != 0 { 8 } else { 1 };

                for mut func in 0..functions {
                    let vendor = pci_read_config16(bus as u8, slot as u8, func as u8, 0x00);
                    if vendor == 0xFFFF || vendor == 0 { continue; }
                    if PCI_DEVICE_COUNT >= (PCI_MAX_DISCOVERED as u32) { continue; }

                    let idx: usize = PCI_DEVICE_COUNT as usize;
                    let device = pci_read_config16(bus as u8, slot as u8, func as u8, 0x02);
                    let class_word = pci_read_config32(bus as u8, slot as u8, func as u8, 0x08);
                    let sub_info = pci_read_config32(bus as u8, slot as u8, func as u8, 0x2C);
                    let header = pci_read_config8(bus as u8, slot as u8, func as u8, 0x0E);

                    PCI_DEVICES[idx].bus = bus as u8;
                    PCI_DEVICES[idx].slot = slot as u8;
                    PCI_DEVICES[idx].func = func as u8;
                    PCI_DEVICES[idx].vendor_id = vendor;
                    PCI_DEVICES[idx].device_id = device;
                    PCI_DEVICES[idx].revision_id = (class_word & 0xFF) as u8;
                    PCI_DEVICES[idx].prog_if = ((class_word >> 8) & 0xFF) as u8;
                    PCI_DEVICES[idx].subclass = ((class_word >> 16) & 0xFF) as u8;
                    PCI_DEVICES[idx].class_code = ((class_word >> 24) & 0xFF) as u8;
                    PCI_DEVICES[idx].subsystem_vendor = (sub_info & 0xFFFF) as u16;
                    PCI_DEVICES[idx].subsystem_id = ((sub_info >> 16) & 0xFFFF) as u16;
                    PCI_DEVICES[idx].header_type = header & 0x7F;
                    PCI_DEVICES[idx].command = pci_read_config16(bus as u8, slot as u8, func as u8, 0x04);

                    // Le somente os BARs atuais. Nenhuma escrita ocorre aqui.
                    let mut bar: u8 = 0;
                    while bar < 6 {
                        let step = pci_probe_bar(bus as u8, slot as u8, func as u8,
                            bar, &mut PCI_DEVICES[idx].bars[bar as usize]);
                        if step > 1 { bar += step; } else { bar += 1; }
                    }

                    if PCI_DEVICES[idx].class_code == PCI_CLASS_DISPLAY &&
                       PCI_DISPLAY_DEVICE_INDEX < 0 {
                        PCI_DISPLAY_DEVICE_INDEX = idx as i32;
                    }

                    PCI_DEVICE_COUNT += 1;
                }
            }
        }
        return PCI_DEVICE_COUNT;
    }
}

@system
pub fn pci_get_device_count() -> u32 {
    unsafe { return PCI_DEVICE_COUNT; }
}

@system
pub fn pci_get_device(index: u32) -> *const PciDevice {
    unsafe {
        if index < PCI_DEVICE_COUNT { return &PCI_DEVICES[index as usize]; }
        return null as *const PciDevice;
    }
}

@system
pub fn pci_find_display_device() -> *const PciDevice {
    unsafe {
        if PCI_DISPLAY_DEVICE_INDEX >= 0 &&
           (PCI_DISPLAY_DEVICE_INDEX as u32) < PCI_DEVICE_COUNT {
            return &PCI_DEVICES[PCI_DISPLAY_DEVICE_INDEX as usize];
        }
        return null as *const PciDevice;
    }
}

@system
pub fn pci_get_vendor_name(vendor_id: u16) -> *const u8 {
    if vendor_id == 0x8086 { return "Intel Corporation\0".as_ptr(); }
    if vendor_id == 0x1002 { return "AMD / ATI Technologies\0".as_ptr(); }
    if vendor_id == 0x10DE { return "NVIDIA Corporation\0".as_ptr(); }
    if vendor_id == 0x1AF4 { return "VirtIO / Red Hat\0".as_ptr(); }
    if vendor_id == 0x15AD { return "VMware\0".as_ptr(); }
    if vendor_id == 0x1234 { return "QEMU\0".as_ptr(); }
    if vendor_id == 0x80EE { return "VirtualBox\0".as_ptr(); }
    return "Unknown PCI vendor\0".as_ptr();
}
