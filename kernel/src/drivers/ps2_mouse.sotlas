// Baken OS — Driver PS/2 de mouse/touchpad sobre o controlador i8042 comum.
//
// Este módulo não acessa mais 0x60/0x64 diretamente. O i8042 roteia bytes de
// teclado e AUX para filas diferentes, impedindo perda cruzada de eventos.

module kernel::drivers::ps2_mouse;

import kernel::drivers::i8042::*;

static mut PS2_INITIALIZED: bool = false;
static mut PS2_MOUSE_PRESENT: bool = false;
static mut PS2_PACKET_BUFFER: [u8; 4] = [0, 0, 0, 0];
static mut PS2_PACKET_INDEX: u32 = 0;
static mut PS2_LAST_BUTTON_STATE: u8 = 0;

@system
pub fn ps2_mouse_init() -> void {
    unsafe {
        PS2_PACKET_INDEX = 0;
        PS2_LAST_BUTTON_STATE = 0;
        PS2_MOUSE_PRESENT = false;

        if !i8042_initialize_polling() {
            PS2_INITIALIZED = true;
            return;
        }
        if !i8042_second_port_present() {
            PS2_INITIALIZED = true;
            return;
        }

        // Defaults -> sample rate 200 Hz -> resolução 8 counts/mm -> streaming.
        if !i8042_aux_command(0xF6) {
            PS2_INITIALIZED = true;
            return;
        }
        if !i8042_aux_command(0xF3) {
            PS2_INITIALIZED = true;
            return;
        }
        if !i8042_aux_command(200) {
            PS2_INITIALIZED = true;
            return;
        }
        if !i8042_aux_command(0xE8) {
            PS2_INITIALIZED = true;
            return;
        }
        if !i8042_aux_command(0x03) {
            PS2_INITIALIZED = true;
            return;
        }
        if !i8042_aux_command(0xF4) {
            PS2_INITIALIZED = true;
            return;
        }

        PS2_MOUSE_PRESENT = true;
        PS2_INITIALIZED = true;
    }
}

@system
pub fn ps2_mouse_is_present() -> bool {
    unsafe { return PS2_INITIALIZED && PS2_MOUSE_PRESENT; }
}

@system
pub fn ps2_mouse_poll(out_dx: *mut i32, out_dy: *mut i32, out_btn: *mut u8) -> u8 {
    unsafe {
        if !PS2_INITIALIZED { ps2_mouse_init(); }
        if !PS2_MOUSE_PRESENT { return 0; }

        // Consome exclusivamente a fila AUX; bytes de teclado permanecem na
        // fila KBD do controlador compartilhado.
        for mut attempt in 0..16 {
            let mut data: u8 = 0;
            if !i8042_pop_aux(&mut data) { break; }

            let idx = PS2_PACKET_INDEX;
            if idx == 0 && (data & 0x08) == 0 {
                PS2_PACKET_INDEX = 0;
                continue;
            }

            PS2_PACKET_BUFFER[idx as usize] = data;
            PS2_PACKET_INDEX += 1;

            if PS2_PACKET_INDEX >= 3 {
                let b0 = PS2_PACKET_BUFFER[0];
                let b1 = PS2_PACKET_BUFFER[1];
                let b2 = PS2_PACKET_BUFFER[2];
                PS2_PACKET_INDEX = 0;

                if (b0 & 0x40) != 0 || (b0 & 0x80) != 0 { continue; }

                let left_btn: u8 = b0 & 0x01;

                let mut dx: i32 = b1 as i32;
                if (b0 & 0x10) != 0 { dx = dx - 256; }

                let mut dy: i32 = b2 as i32;
                if (b0 & 0x20) != 0 { dy = dy - 256; }

                let mag2 = dx * dx + dy * dy;
                let scale: i32 = if (mag2 > 64) { 2 } else { 1 };
                let final_dx: i32 = (dx * scale) / 2;
                let final_dy: i32 = -((dy * scale) / 2);

                if final_dx != 0 || final_dy != 0 || left_btn != PS2_LAST_BUTTON_STATE {
                    PS2_LAST_BUTTON_STATE = left_btn;
                    if out_dx != (null as *mut i32) { *out_dx = final_dx; }
                    if out_dy != (null as *mut i32) { *out_dy = final_dy; }
                    if out_btn != (null as *mut u8) { *out_btn = left_btn; }
                    return 1;
                }
            }
        }
        return 0;
    }
}
