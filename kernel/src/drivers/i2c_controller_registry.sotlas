// Baken OS — I2C-2a: registry/lifecycle generation-safe de controllers.
//
// Este modulo passa a possuir os slots logicos de controller. O registry e
// bounded, sem heap, protegido por spinlock com IRQ save/restore e invalida
// handles antigos por controller_id + generation. Discovery fisico continua fora.
module kernel::drivers::i2c_controller_registry;

import kernel::arch::x86_64::cpu::*;
import kernel::sync::spinlock::*;
import kernel::acpi::aml_namespace::*;
import kernel::drivers::i2c_core::*;
import kernel::drivers::i2c_controller::*;

pub const I2C_CONTROLLER_CAPACITY: usize = 16;

pub const I2C_CONTROLLER_STATE_EMPTY: u8 = 0;
pub const I2C_CONTROLLER_STATE_ATTACHED: u8 = 1;
pub const I2C_CONTROLLER_STATE_ACTIVE: u8 = 2;
pub const I2C_CONTROLLER_STATE_FAILED: u8 = 3;
pub const I2C_CONTROLLER_STATE_DETACHED: u8 = 4;

@repr(C)
pub struct I2cControllerRecord {
    pub controller_id: u32;
    pub generation: u32;
    pub state: u8;
    pub acpi_namespace_index: usize;
    pub capabilities: I2cControllerCapabilities;
    pub backend_instance: u32;
    pub backend_ready: bool;
    pub valid: bool;
}

static mut I2C_CONTROLLER_RECORDS: [I2cControllerRecord; I2C_CONTROLLER_CAPACITY] = [
    I2cControllerRecord {
        controller_id: I2C_CONTROLLER_ID_NONE,
        generation: I2C_CONTROLLER_GENERATION_INVALID,
        state: I2C_CONTROLLER_STATE_EMPTY,
        acpi_namespace_index: AML_NAMESPACE_INVALID_INDEX,
        capabilities: I2cControllerCapabilities {
            supports_7bit: false,
            supports_10bit: false,
            supports_repeated_start: false,
            max_messages: 0,
            max_message_bytes: 0,
            max_transaction_bytes: 0,
            max_speed_hz: 0,
            valid: false
        },
        backend_instance: I2C_CONTROLLER_BACKEND_INSTANCE_NONE,
        backend_ready: false,
        valid: false
    };
    I2C_CONTROLLER_CAPACITY
];
static mut I2C_CONTROLLER_REGISTRY_READY: bool = false;
static mut I2C_CONTROLLER_REGISTRY_LOCK: SpinLock = SpinLock { state: SPINLOCK_UNLOCKED };
static mut I2C_CONTROLLER_REGISTRY_LOCK_READY: bool = false;
static mut I2C_CONTROLLER_ACTIVE_COUNT: usize = 0;

@system
fn i2c_controller_registry_empty_capabilities() -> I2cControllerCapabilities {
    return I2cControllerCapabilities {
        supports_7bit: false,
        supports_10bit: false,
        supports_repeated_start: false,
        max_messages: 0,
        max_message_bytes: 0,
        max_transaction_bytes: 0,
        max_speed_hz: 0,
        valid: false
    };
}

@system
pub fn i2c_controller_registry_invalid_record() -> I2cControllerRecord {
    return I2cControllerRecord {
        controller_id: I2C_CONTROLLER_ID_NONE,
        generation: I2C_CONTROLLER_GENERATION_INVALID,
        state: I2C_CONTROLLER_STATE_EMPTY,
        acpi_namespace_index: AML_NAMESPACE_INVALID_INDEX,
        capabilities: i2c_controller_registry_empty_capabilities(),
        backend_instance: I2C_CONTROLLER_BACKEND_INSTANCE_NONE,
        backend_ready: false,
        valid: false
    };
}

@system
fn i2c_controller_registry_invalid_descriptor() -> I2cControllerDescriptor {
    return I2cControllerDescriptor {
        controller_id: I2C_CONTROLLER_ID_NONE,
        generation: I2C_CONTROLLER_GENERATION_INVALID,
        acpi_namespace_index: AML_NAMESPACE_INVALID_INDEX,
        capabilities: i2c_controller_registry_empty_capabilities(),
        backend_instance: I2C_CONTROLLER_BACKEND_INSTANCE_NONE,
        backend_ready: false,
        valid: false
    };
}

@system
fn i2c_controller_registry_slot(controller_id: u32) -> usize {
    if controller_id == I2C_CONTROLLER_ID_NONE ||
       controller_id > I2C_CONTROLLER_CAPACITY as u32 {
        return I2C_CONTROLLER_CAPACITY;
    }
    return (controller_id - 1) as usize;
}

@system
fn i2c_controller_registry_generation_next(current: u32) -> u32 {
    let mut next = current + 1;
    if next == I2C_CONTROLLER_GENERATION_INVALID { next = 1; }
    return next;
}

@system
pub fn i2c_controller_registry_init() -> bool {
    let flags = x86_irq_save_disable();
    unsafe {
        if !I2C_CONTROLLER_REGISTRY_LOCK_READY {
            if !spinlock_init(&mut I2C_CONTROLLER_REGISTRY_LOCK) {
                x86_irq_restore(flags);
                return false;
            }
            I2C_CONTROLLER_REGISTRY_LOCK_READY = true;
        }
        if !spinlock_lock(&mut I2C_CONTROLLER_REGISTRY_LOCK) {
            x86_irq_restore(flags);
            return false;
        }
        if I2C_CONTROLLER_REGISTRY_READY {
            spinlock_unlock(&mut I2C_CONTROLLER_REGISTRY_LOCK);
            x86_irq_restore(flags);
            return true;
        }

        let mut index: usize = 0;
        while index < I2C_CONTROLLER_CAPACITY {
            I2C_CONTROLLER_RECORDS[index] = i2c_controller_registry_invalid_record();
            I2C_CONTROLLER_RECORDS[index].controller_id = (index + 1) as u32;
            I2C_CONTROLLER_RECORDS[index].generation = 1;
            index += 1;
        }
        I2C_CONTROLLER_ACTIVE_COUNT = 0;
        I2C_CONTROLLER_REGISTRY_READY = true;
        spinlock_unlock(&mut I2C_CONTROLLER_REGISTRY_LOCK);
    }
    x86_irq_restore(flags);
    return true;
}

@system
pub fn i2c_controller_registry_is_ready() -> bool {
    unsafe { return I2C_CONTROLLER_REGISTRY_READY; }
}

@system
pub fn i2c_controller_registry_attach(acpi_namespace_index: usize,
                                      capabilities: *const I2cControllerCapabilities) -> I2cControllerHandle {
    if acpi_namespace_index == AML_NAMESPACE_INVALID_INDEX ||
       !i2c_controller_capabilities_valid(capabilities) {
        return i2c_controller_invalid_handle();
    }

    let flags = x86_irq_save_disable();
    let mut result = i2c_controller_invalid_handle();
    unsafe {
        if !I2C_CONTROLLER_REGISTRY_LOCK_READY ||
           !spinlock_lock(&mut I2C_CONTROLLER_REGISTRY_LOCK) {
            x86_irq_restore(flags);
            return result;
        }
        if !I2C_CONTROLLER_REGISTRY_READY {
            spinlock_unlock(&mut I2C_CONTROLLER_REGISTRY_LOCK);
            x86_irq_restore(flags);
            return result;
        }

        // Um node ACPI possui no maximo um owner logico vivo no registry.
        let mut duplicate: usize = 0;
        while duplicate < I2C_CONTROLLER_CAPACITY {
            if I2C_CONTROLLER_RECORDS[duplicate].valid &&
               I2C_CONTROLLER_RECORDS[duplicate].acpi_namespace_index == acpi_namespace_index {
                spinlock_unlock(&mut I2C_CONTROLLER_REGISTRY_LOCK);
                x86_irq_restore(flags);
                return result;
            }
            duplicate += 1;
        }

        let mut index: usize = 0;
        while index < I2C_CONTROLLER_CAPACITY {
            let state = I2C_CONTROLLER_RECORDS[index].state;
            if !I2C_CONTROLLER_RECORDS[index].valid &&
               (state == I2C_CONTROLLER_STATE_EMPTY || state == I2C_CONTROLLER_STATE_DETACHED) {
                if I2C_CONTROLLER_RECORDS[index].generation == I2C_CONTROLLER_GENERATION_INVALID {
                    I2C_CONTROLLER_RECORDS[index].generation = 1;
                }
                I2C_CONTROLLER_RECORDS[index].state = I2C_CONTROLLER_STATE_ATTACHED;
                I2C_CONTROLLER_RECORDS[index].acpi_namespace_index = acpi_namespace_index;
                I2C_CONTROLLER_RECORDS[index].capabilities.supports_7bit = (*capabilities).supports_7bit;
                I2C_CONTROLLER_RECORDS[index].capabilities.supports_10bit = (*capabilities).supports_10bit;
                I2C_CONTROLLER_RECORDS[index].capabilities.supports_repeated_start = (*capabilities).supports_repeated_start;
                I2C_CONTROLLER_RECORDS[index].capabilities.max_messages = (*capabilities).max_messages;
                I2C_CONTROLLER_RECORDS[index].capabilities.max_message_bytes = (*capabilities).max_message_bytes;
                I2C_CONTROLLER_RECORDS[index].capabilities.max_transaction_bytes = (*capabilities).max_transaction_bytes;
                I2C_CONTROLLER_RECORDS[index].capabilities.max_speed_hz = (*capabilities).max_speed_hz;
                I2C_CONTROLLER_RECORDS[index].capabilities.valid = true;
                I2C_CONTROLLER_RECORDS[index].backend_instance = I2C_CONTROLLER_BACKEND_INSTANCE_NONE;
                I2C_CONTROLLER_RECORDS[index].backend_ready = false;
                I2C_CONTROLLER_RECORDS[index].valid = true;
                result.controller_id = I2C_CONTROLLER_RECORDS[index].controller_id;
                result.generation = I2C_CONTROLLER_RECORDS[index].generation;
                result.valid = true;
                break;
            }
            index += 1;
        }
        spinlock_unlock(&mut I2C_CONTROLLER_REGISTRY_LOCK);
    }
    x86_irq_restore(flags);
    return result;
}

@system
pub fn i2c_controller_registry_publish_backend(controller_id: u32,
                                               generation: u32,
                                               backend_instance: u32) -> bool {
    if generation == I2C_CONTROLLER_GENERATION_INVALID ||
       backend_instance == I2C_CONTROLLER_BACKEND_INSTANCE_NONE {
        return false;
    }
    let slot = i2c_controller_registry_slot(controller_id);
    if slot >= I2C_CONTROLLER_CAPACITY { return false; }

    let flags = x86_irq_save_disable();
    let mut published = false;
    unsafe {
        if !I2C_CONTROLLER_REGISTRY_LOCK_READY ||
           !spinlock_lock(&mut I2C_CONTROLLER_REGISTRY_LOCK) {
            x86_irq_restore(flags);
            return false;
        }
        if I2C_CONTROLLER_REGISTRY_READY &&
           I2C_CONTROLLER_RECORDS[slot].valid &&
           I2C_CONTROLLER_RECORDS[slot].controller_id == controller_id &&
           I2C_CONTROLLER_RECORDS[slot].generation == generation &&
           I2C_CONTROLLER_RECORDS[slot].state == I2C_CONTROLLER_STATE_ATTACHED &&
           !I2C_CONTROLLER_RECORDS[slot].backend_ready &&
           I2C_CONTROLLER_RECORDS[slot].backend_instance == I2C_CONTROLLER_BACKEND_INSTANCE_NONE {
            I2C_CONTROLLER_RECORDS[slot].backend_instance = backend_instance;
            I2C_CONTROLLER_RECORDS[slot].backend_ready = true;
            published = true;
        }
        spinlock_unlock(&mut I2C_CONTROLLER_REGISTRY_LOCK);
    }
    x86_irq_restore(flags);
    return published;
}

@system
pub fn i2c_controller_registry_activate(controller_id: u32, generation: u32) -> bool {
    if generation == I2C_CONTROLLER_GENERATION_INVALID { return false; }
    let slot = i2c_controller_registry_slot(controller_id);
    if slot >= I2C_CONTROLLER_CAPACITY { return false; }

    let flags = x86_irq_save_disable();
    let mut activated = false;
    unsafe {
        if !I2C_CONTROLLER_REGISTRY_LOCK_READY ||
           !spinlock_lock(&mut I2C_CONTROLLER_REGISTRY_LOCK) {
            x86_irq_restore(flags);
            return false;
        }
        if I2C_CONTROLLER_REGISTRY_READY &&
           I2C_CONTROLLER_RECORDS[slot].valid &&
           I2C_CONTROLLER_RECORDS[slot].controller_id == controller_id &&
           I2C_CONTROLLER_RECORDS[slot].generation == generation &&
           I2C_CONTROLLER_RECORDS[slot].state == I2C_CONTROLLER_STATE_ATTACHED &&
           I2C_CONTROLLER_RECORDS[slot].backend_ready &&
           I2C_CONTROLLER_RECORDS[slot].backend_instance != I2C_CONTROLLER_BACKEND_INSTANCE_NONE {
            I2C_CONTROLLER_RECORDS[slot].state = I2C_CONTROLLER_STATE_ACTIVE;
            I2C_CONTROLLER_ACTIVE_COUNT += 1;
            activated = true;
        }
        spinlock_unlock(&mut I2C_CONTROLLER_REGISTRY_LOCK);
    }
    x86_irq_restore(flags);
    return activated;
}

@system
pub fn i2c_controller_registry_mark_failed(controller_id: u32, generation: u32) -> bool {
    if generation == I2C_CONTROLLER_GENERATION_INVALID { return false; }
    let slot = i2c_controller_registry_slot(controller_id);
    if slot >= I2C_CONTROLLER_CAPACITY { return false; }

    let flags = x86_irq_save_disable();
    let mut changed = false;
    unsafe {
        if !I2C_CONTROLLER_REGISTRY_LOCK_READY ||
           !spinlock_lock(&mut I2C_CONTROLLER_REGISTRY_LOCK) {
            x86_irq_restore(flags);
            return false;
        }
        if I2C_CONTROLLER_REGISTRY_READY &&
           I2C_CONTROLLER_RECORDS[slot].valid &&
           I2C_CONTROLLER_RECORDS[slot].controller_id == controller_id &&
           I2C_CONTROLLER_RECORDS[slot].generation == generation &&
           (I2C_CONTROLLER_RECORDS[slot].state == I2C_CONTROLLER_STATE_ATTACHED ||
            I2C_CONTROLLER_RECORDS[slot].state == I2C_CONTROLLER_STATE_ACTIVE) {
            if I2C_CONTROLLER_RECORDS[slot].state == I2C_CONTROLLER_STATE_ACTIVE &&
               I2C_CONTROLLER_ACTIVE_COUNT != 0 {
                I2C_CONTROLLER_ACTIVE_COUNT -= 1;
            }
            I2C_CONTROLLER_RECORDS[slot].state = I2C_CONTROLLER_STATE_FAILED;
            // FAILED revoga a autorizacao do backend na mesma generation.
            I2C_CONTROLLER_RECORDS[slot].backend_instance = I2C_CONTROLLER_BACKEND_INSTANCE_NONE;
            I2C_CONTROLLER_RECORDS[slot].backend_ready = false;
            changed = true;
        }
        spinlock_unlock(&mut I2C_CONTROLLER_REGISTRY_LOCK);
    }
    x86_irq_restore(flags);
    return changed;
}

@system
pub fn i2c_controller_registry_detach(controller_id: u32, generation: u32) -> bool {
    if generation == I2C_CONTROLLER_GENERATION_INVALID { return false; }
    let slot = i2c_controller_registry_slot(controller_id);
    if slot >= I2C_CONTROLLER_CAPACITY { return false; }

    let flags = x86_irq_save_disable();
    let mut detached = false;
    unsafe {
        if !I2C_CONTROLLER_REGISTRY_LOCK_READY ||
           !spinlock_lock(&mut I2C_CONTROLLER_REGISTRY_LOCK) {
            x86_irq_restore(flags);
            return false;
        }
        if I2C_CONTROLLER_REGISTRY_READY &&
           I2C_CONTROLLER_RECORDS[slot].valid &&
           I2C_CONTROLLER_RECORDS[slot].controller_id == controller_id &&
           I2C_CONTROLLER_RECORDS[slot].generation == generation &&
           (I2C_CONTROLLER_RECORDS[slot].state == I2C_CONTROLLER_STATE_ATTACHED ||
            I2C_CONTROLLER_RECORDS[slot].state == I2C_CONTROLLER_STATE_ACTIVE ||
            I2C_CONTROLLER_RECORDS[slot].state == I2C_CONTROLLER_STATE_FAILED) {
            if I2C_CONTROLLER_RECORDS[slot].state == I2C_CONTROLLER_STATE_ACTIVE &&
               I2C_CONTROLLER_ACTIVE_COUNT != 0 {
                I2C_CONTROLLER_ACTIVE_COUNT -= 1;
            }
            I2C_CONTROLLER_RECORDS[slot].state = I2C_CONTROLLER_STATE_DETACHED;
            I2C_CONTROLLER_RECORDS[slot].acpi_namespace_index = AML_NAMESPACE_INVALID_INDEX;
            I2C_CONTROLLER_RECORDS[slot].capabilities = i2c_controller_registry_empty_capabilities();
            I2C_CONTROLLER_RECORDS[slot].backend_instance = I2C_CONTROLLER_BACKEND_INSTANCE_NONE;
            I2C_CONTROLLER_RECORDS[slot].backend_ready = false;
            I2C_CONTROLLER_RECORDS[slot].valid = false;
            I2C_CONTROLLER_RECORDS[slot].generation =
                i2c_controller_registry_generation_next(generation);
            detached = true;
        }
        spinlock_unlock(&mut I2C_CONTROLLER_REGISTRY_LOCK);
    }
    x86_irq_restore(flags);
    return detached;
}

@system
pub fn i2c_controller_registry_generation_for_id(controller_id: u32) -> u32 {
    let slot = i2c_controller_registry_slot(controller_id);
    if slot >= I2C_CONTROLLER_CAPACITY { return I2C_CONTROLLER_GENERATION_INVALID; }

    let flags = x86_irq_save_disable();
    let mut generation = I2C_CONTROLLER_GENERATION_INVALID;
    unsafe {
        if !I2C_CONTROLLER_REGISTRY_LOCK_READY ||
           !spinlock_lock(&mut I2C_CONTROLLER_REGISTRY_LOCK) {
            x86_irq_restore(flags);
            return generation;
        }
        if I2C_CONTROLLER_REGISTRY_READY &&
           I2C_CONTROLLER_RECORDS[slot].controller_id == controller_id {
            generation = I2C_CONTROLLER_RECORDS[slot].generation;
        }
        spinlock_unlock(&mut I2C_CONTROLLER_REGISTRY_LOCK);
    }
    x86_irq_restore(flags);
    return generation;
}

@system
pub fn i2c_controller_registry_handle_is_current(handle: *const I2cControllerHandle) -> bool {
    if !i2c_controller_handle_valid(handle) { return false; }
    let mut controller_id: u32 = I2C_CONTROLLER_ID_NONE;
    let mut generation: u32 = I2C_CONTROLLER_GENERATION_INVALID;
    unsafe {
        controller_id = (*handle).controller_id;
        generation = (*handle).generation;
    }
    let slot = i2c_controller_registry_slot(controller_id);
    if slot >= I2C_CONTROLLER_CAPACITY { return false; }

    let flags = x86_irq_save_disable();
    let mut current = false;
    unsafe {
        if !I2C_CONTROLLER_REGISTRY_LOCK_READY ||
           !spinlock_lock(&mut I2C_CONTROLLER_REGISTRY_LOCK) {
            x86_irq_restore(flags);
            return false;
        }
        current = I2C_CONTROLLER_REGISTRY_READY &&
            I2C_CONTROLLER_RECORDS[slot].valid &&
            I2C_CONTROLLER_RECORDS[slot].controller_id == controller_id &&
            I2C_CONTROLLER_RECORDS[slot].generation == generation;
        spinlock_unlock(&mut I2C_CONTROLLER_REGISTRY_LOCK);
    }
    x86_irq_restore(flags);
    return current;
}

@system
pub fn i2c_controller_registry_is_active(controller_id: u32, generation: u32) -> bool {
    let slot = i2c_controller_registry_slot(controller_id);
    if slot >= I2C_CONTROLLER_CAPACITY || generation == I2C_CONTROLLER_GENERATION_INVALID {
        return false;
    }

    let flags = x86_irq_save_disable();
    let mut active = false;
    unsafe {
        if !I2C_CONTROLLER_REGISTRY_LOCK_READY ||
           !spinlock_lock(&mut I2C_CONTROLLER_REGISTRY_LOCK) {
            x86_irq_restore(flags);
            return false;
        }
        active = I2C_CONTROLLER_REGISTRY_READY &&
            I2C_CONTROLLER_RECORDS[slot].valid &&
            I2C_CONTROLLER_RECORDS[slot].controller_id == controller_id &&
            I2C_CONTROLLER_RECORDS[slot].generation == generation &&
            I2C_CONTROLLER_RECORDS[slot].state == I2C_CONTROLLER_STATE_ACTIVE &&
            I2C_CONTROLLER_RECORDS[slot].backend_ready &&
            I2C_CONTROLLER_RECORDS[slot].backend_instance != I2C_CONTROLLER_BACKEND_INSTANCE_NONE;
        spinlock_unlock(&mut I2C_CONTROLLER_REGISTRY_LOCK);
    }
    x86_irq_restore(flags);
    return active;
}

@system
pub fn i2c_controller_registry_snapshot(controller_id: u32,
                                        generation: u32) -> I2cControllerRecord {
    let slot = i2c_controller_registry_slot(controller_id);
    if slot >= I2C_CONTROLLER_CAPACITY || generation == I2C_CONTROLLER_GENERATION_INVALID {
        return i2c_controller_registry_invalid_record();
    }

    let flags = x86_irq_save_disable();
    let mut result = i2c_controller_registry_invalid_record();
    unsafe {
        if !I2C_CONTROLLER_REGISTRY_LOCK_READY ||
           !spinlock_lock(&mut I2C_CONTROLLER_REGISTRY_LOCK) {
            x86_irq_restore(flags);
            return result;
        }
        if I2C_CONTROLLER_REGISTRY_READY &&
           I2C_CONTROLLER_RECORDS[slot].valid &&
           I2C_CONTROLLER_RECORDS[slot].controller_id == controller_id &&
           I2C_CONTROLLER_RECORDS[slot].generation == generation {
            result = I2C_CONTROLLER_RECORDS[slot];
        }
        spinlock_unlock(&mut I2C_CONTROLLER_REGISTRY_LOCK);
    }
    x86_irq_restore(flags);
    return result;
}

@system
pub fn i2c_controller_registry_descriptor(controller_id: u32,
                                          generation: u32) -> I2cControllerDescriptor {
    let slot = i2c_controller_registry_slot(controller_id);
    if slot >= I2C_CONTROLLER_CAPACITY || generation == I2C_CONTROLLER_GENERATION_INVALID {
        return i2c_controller_registry_invalid_descriptor();
    }

    let flags = x86_irq_save_disable();
    let mut result = i2c_controller_registry_invalid_descriptor();
    unsafe {
        if !I2C_CONTROLLER_REGISTRY_LOCK_READY ||
           !spinlock_lock(&mut I2C_CONTROLLER_REGISTRY_LOCK) {
            x86_irq_restore(flags);
            return result;
        }
        if I2C_CONTROLLER_REGISTRY_READY &&
           I2C_CONTROLLER_RECORDS[slot].valid &&
           I2C_CONTROLLER_RECORDS[slot].controller_id == controller_id &&
           I2C_CONTROLLER_RECORDS[slot].generation == generation {
            result = I2cControllerDescriptor {
                controller_id: I2C_CONTROLLER_RECORDS[slot].controller_id,
                generation: I2C_CONTROLLER_RECORDS[slot].generation,
                acpi_namespace_index: I2C_CONTROLLER_RECORDS[slot].acpi_namespace_index,
                capabilities: I2C_CONTROLLER_RECORDS[slot].capabilities,
                backend_instance: I2C_CONTROLLER_RECORDS[slot].backend_instance,
                backend_ready: I2C_CONTROLLER_RECORDS[slot].backend_ready,
                valid: true
            };
        }
        spinlock_unlock(&mut I2C_CONTROLLER_REGISTRY_LOCK);
    }
    x86_irq_restore(flags);
    return result;
}

@system
pub fn i2c_controller_registry_active_count() -> usize {
    let flags = x86_irq_save_disable();
    let mut count: usize = 0;
    unsafe {
        if !I2C_CONTROLLER_REGISTRY_LOCK_READY ||
           !spinlock_lock(&mut I2C_CONTROLLER_REGISTRY_LOCK) {
            x86_irq_restore(flags);
            return 0;
        }
        if I2C_CONTROLLER_REGISTRY_READY { count = I2C_CONTROLLER_ACTIVE_COUNT; }
        spinlock_unlock(&mut I2C_CONTROLLER_REGISTRY_LOCK);
    }
    x86_irq_restore(flags);
    return count;
}
