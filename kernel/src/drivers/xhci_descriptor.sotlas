// Baken OS — HID-4c.3: transferências de controle USB para Device Descriptor por Slot ID.
//
// O primeiro gate lê somente os 8 bytes iniciais para descobrir bMaxPacketSize0.
// A leitura completa de 18 bytes permanece separada e só deve ser usada depois
// que o EP0 estiver com o Max Packet Size correto. Cada slot mantém descriptor,
// probe e epoch próprios; wrappers legados preservam o bring-up do primeiro device.

module kernel::drivers::xhci_descriptor;

import kernel::memory::dma::*;
import kernel::drivers::xhci_context::*;
import kernel::drivers::xhci_address::*;
import kernel::drivers::xhci_device_table::*;
import kernel::drivers::xhci_ep0::*;
import kernel::drivers::xhci_trb::*;
import kernel::drivers::xhci_transfer::*;

pub const USB_REQUEST_GET_DESCRIPTOR: u8 = 6;
pub const USB_REQUEST_TYPE_DEVICE_TO_HOST_STANDARD_DEVICE: u8 = 0x80;
pub const USB_DESCRIPTOR_TYPE_DEVICE: u8 = 1;
pub const USB_DEVICE_DESCRIPTOR_PROBE_LENGTH: u16 = 8;
pub const USB_DEVICE_DESCRIPTOR_LENGTH: u16 = 18;
pub const USB_DEVICE_DESCRIPTOR_VALUE: u16 = 0x0100;
pub const XHCI_DESCRIPTOR_DMA_SIZE: u64 = 4096;
pub const XHCI_DESCRIPTOR_SLOT_CAPACITY: usize = XHCI_DEVICE_SLOT_CAPACITY;

pub struct XhciDeviceDescriptorState {
    pub epoch: u32;
    pub probe_ready: bool;
    pub probe_max_packet0: u8;
    pub ready: bool;
    pub usb_version: u16;
    pub vendor_id: u16;
    pub product_id: u16;
    pub device_class: u8;
    pub device_subclass: u8;
    pub device_protocol: u8;
    pub max_packet0: u8;
    pub buffer: DmaBuffer;
}

static mut XHCI_DEVICE_DESCRIPTOR_STATES: [XhciDeviceDescriptorState; XHCI_DESCRIPTOR_SLOT_CAPACITY] = [
    XhciDeviceDescriptorState {
        epoch: 0,
        probe_ready: false,
        probe_max_packet0: 0,
        ready: false,
        usb_version: 0,
        vendor_id: 0,
        product_id: 0,
        device_class: 0,
        device_subclass: 0,
        device_protocol: 0,
        max_packet0: 0,
        buffer: DmaBuffer {
            virtual_address: null as *mut u8,
            physical_address: 0,
            size: 0,
            alignment: 0,
            owner: DMA_OWNER_CPU,
            fence: 0,
            valid: false
        }
    };
    XHCI_DESCRIPTOR_SLOT_CAPACITY
];

@system
fn xhci_descriptor_index(slot_id: u8) -> usize {
    if slot_id == 0 { return XHCI_DESCRIPTOR_SLOT_CAPACITY; }
    return slot_id as usize;
}

@system
fn xhci_descriptor_prepare_state(slot_id: u8) -> bool {
    let index = xhci_descriptor_index(slot_id);
    if index >= XHCI_DESCRIPTOR_SLOT_CAPACITY ||
       !xhci_device_table_slot_is_valid(slot_id) ||
       !xhci_address_is_ready_for(slot_id) ||
       !xhci_context_is_ready_for(slot_id) ||
       !xhci_ep0_is_ready_for(slot_id) {
        return false;
    }
    let epoch = xhci_device_table_slot_epoch(slot_id);
    if epoch == 0 { return false; }
    unsafe {
        if XHCI_DEVICE_DESCRIPTOR_STATES[index].epoch != epoch {
            XHCI_DEVICE_DESCRIPTOR_STATES[index].epoch = epoch;
            XHCI_DEVICE_DESCRIPTOR_STATES[index].probe_ready = false;
            XHCI_DEVICE_DESCRIPTOR_STATES[index].probe_max_packet0 = 0;
            XHCI_DEVICE_DESCRIPTOR_STATES[index].ready = false;
            XHCI_DEVICE_DESCRIPTOR_STATES[index].usb_version = 0;
            XHCI_DEVICE_DESCRIPTOR_STATES[index].vendor_id = 0;
            XHCI_DEVICE_DESCRIPTOR_STATES[index].product_id = 0;
            XHCI_DEVICE_DESCRIPTOR_STATES[index].device_class = 0;
            XHCI_DEVICE_DESCRIPTOR_STATES[index].device_subclass = 0;
            XHCI_DEVICE_DESCRIPTOR_STATES[index].device_protocol = 0;
            XHCI_DEVICE_DESCRIPTOR_STATES[index].max_packet0 = 0;
            XHCI_DEVICE_DESCRIPTOR_STATES[index].buffer = dma_invalid_buffer();
        }
    }
    return true;
}

@system
fn xhci_descriptor_state_is_current(slot_id: u8) -> bool {
    let index = xhci_descriptor_index(slot_id);
    if index >= XHCI_DESCRIPTOR_SLOT_CAPACITY || !xhci_device_table_slot_is_valid(slot_id) {
        return false;
    }
    let epoch = xhci_device_table_slot_epoch(slot_id);
    unsafe {
        return epoch != 0 && XHCI_DEVICE_DESCRIPTOR_STATES[index].epoch == epoch;
    }
}

@system
fn xhci_descriptor_zero(buffer: *mut u8, size: u64) -> bool {
    if buffer == (null as *mut u8) || size == 0 { return false; }
    unsafe {
        let mut i: u64 = 0;
        while i < size {
            let slot = ((buffer as usize) + (i as usize)) as *mut u8;
            *slot = 0;
            i += 1;
        }
    }
    return true;
}

@system
fn xhci_descriptor_read8(base: *const u8, offset: u64) -> u8 {
    if base == (null as *const u8) { return 0; }
    unsafe { return *(((base as usize) + (offset as usize)) as *const u8); }
}

@system
fn xhci_descriptor_read16(base: *const u8, offset: u64) -> u16 {
    let lo = xhci_descriptor_read8(base, offset) as u16;
    let hi = xhci_descriptor_read8(base, offset + 1) as u16;
    return lo | (hi << 8);
}

// GET_DESCRIPTOR(Device) curto para um slot específico. O buffer, o EP0 e o
// resultado de transferência pertencem ao mesmo slot+epoch do início ao fim.
@system
pub fn xhci_probe_device_descriptor_8_for_slot(slot_id: u8) -> bool {
    if !xhci_descriptor_prepare_state(slot_id) { return false; }
    let index = xhci_descriptor_index(slot_id);
    unsafe {
        XHCI_DEVICE_DESCRIPTOR_STATES[index].probe_ready = false;
        XHCI_DEVICE_DESCRIPTOR_STATES[index].probe_max_packet0 = 0;
    }

    let mut buffer = dma_alloc(XHCI_DESCRIPTOR_DMA_SIZE, XHCI_DESCRIPTOR_DMA_SIZE);
    if !dma_buffer_cpu_owned(&buffer) { return false; }
    if !xhci_descriptor_zero(buffer.virtual_address, USB_DEVICE_DESCRIPTOR_PROBE_LENGTH as u64) {
        return false;
    }
    if !dma_share_with_device(&mut buffer) { return false; }

    let setup = xhci_trb_setup_stage(
        USB_REQUEST_TYPE_DEVICE_TO_HOST_STANDARD_DEVICE,
        USB_REQUEST_GET_DESCRIPTOR,
        USB_DEVICE_DESCRIPTOR_VALUE,
        0,
        USB_DEVICE_DESCRIPTOR_PROBE_LENGTH,
        XHCI_SETUP_TRT_IN_DATA,
        xhci_ep0_producer_cycle_for(slot_id)
    );
    let data = xhci_trb_data_stage(
        buffer.physical_address,
        USB_DEVICE_DESCRIPTOR_PROBE_LENGTH as u32,
        0,
        true,
        false,
        xhci_ep0_producer_cycle_for(slot_id)
    );
    let status = xhci_trb_status_stage(false, true, xhci_ep0_producer_cycle_for(slot_id));

    let status_physical = xhci_ep0_submit_control_td_for_slot(slot_id, setup, data, status, true);
    if status_physical == 0 { return false; }
    if !xhci_transfer_wait_ep0_completion(slot_id, status_physical) { return false; }
    if xhci_transfer_last_residual_length_for(slot_id) != 0 { return false; }

    let base = buffer.virtual_address as *const u8;
    let length = xhci_descriptor_read8(base, 0);
    let descriptor_type = xhci_descriptor_read8(base, 1);
    let max_packet0 = xhci_descriptor_read8(base, 7);
    if length != (USB_DEVICE_DESCRIPTOR_LENGTH as u8) ||
       descriptor_type != USB_DESCRIPTOR_TYPE_DEVICE || max_packet0 == 0 {
        return false;
    }

    if !xhci_descriptor_state_is_current(slot_id) { return false; }
    unsafe {
        XHCI_DEVICE_DESCRIPTOR_STATES[index].probe_max_packet0 = max_packet0;
        XHCI_DEVICE_DESCRIPTOR_STATES[index].probe_ready = true;
    }
    return true;
}

@system
pub fn xhci_probe_first_device_descriptor_8() -> bool {
    let slot_id = xhci_address_slot_id();
    if slot_id == 0 { return false; }
    return xhci_probe_device_descriptor_8_for_slot(slot_id);
}

@system
pub fn xhci_device_descriptor_probe_is_ready_for(slot_id: u8) -> bool {
    if !xhci_descriptor_state_is_current(slot_id) { return false; }
    unsafe {
        return XHCI_DEVICE_DESCRIPTOR_STATES[xhci_descriptor_index(slot_id)].probe_ready;
    }
}

@system
pub fn xhci_device_descriptor_probe_is_ready() -> bool {
    return xhci_device_descriptor_probe_is_ready_for(xhci_address_slot_id());
}

@system
pub fn xhci_device_descriptor_probe_max_packet0_for(slot_id: u8) -> u8 {
    if !xhci_device_descriptor_probe_is_ready_for(slot_id) { return 0; }
    unsafe {
        return XHCI_DEVICE_DESCRIPTOR_STATES[xhci_descriptor_index(slot_id)].probe_max_packet0;
    }
}

@system
pub fn xhci_device_descriptor_probe_max_packet0() -> u8 {
    return xhci_device_descriptor_probe_max_packet0_for(xhci_address_slot_id());
}

// Leitura completa do Device Descriptor para um slot específico, após o EP0
// ter sido reconciliado com o bMaxPacketSize0 descoberto no probe curto.
@system
pub fn xhci_get_device_descriptor_for_slot(slot_id: u8) -> bool {
    if !xhci_descriptor_prepare_state(slot_id) { return false; }
    let index = xhci_descriptor_index(slot_id);
    unsafe {
        XHCI_DEVICE_DESCRIPTOR_STATES[index].ready = false;
        XHCI_DEVICE_DESCRIPTOR_STATES[index].usb_version = 0;
        XHCI_DEVICE_DESCRIPTOR_STATES[index].vendor_id = 0;
        XHCI_DEVICE_DESCRIPTOR_STATES[index].product_id = 0;
        XHCI_DEVICE_DESCRIPTOR_STATES[index].device_class = 0;
        XHCI_DEVICE_DESCRIPTOR_STATES[index].device_subclass = 0;
        XHCI_DEVICE_DESCRIPTOR_STATES[index].device_protocol = 0;
        XHCI_DEVICE_DESCRIPTOR_STATES[index].max_packet0 = 0;
        XHCI_DEVICE_DESCRIPTOR_STATES[index].buffer = dma_invalid_buffer();
    }

    let mut buffer = dma_alloc(XHCI_DESCRIPTOR_DMA_SIZE, XHCI_DESCRIPTOR_DMA_SIZE);
    if !dma_buffer_cpu_owned(&buffer) { return false; }
    if !xhci_descriptor_zero(buffer.virtual_address, USB_DEVICE_DESCRIPTOR_LENGTH as u64) {
        return false;
    }
    if !dma_share_with_device(&mut buffer) { return false; }

    let setup = xhci_trb_setup_stage(
        USB_REQUEST_TYPE_DEVICE_TO_HOST_STANDARD_DEVICE,
        USB_REQUEST_GET_DESCRIPTOR,
        USB_DEVICE_DESCRIPTOR_VALUE,
        0,
        USB_DEVICE_DESCRIPTOR_LENGTH,
        XHCI_SETUP_TRT_IN_DATA,
        xhci_ep0_producer_cycle_for(slot_id)
    );
    let data = xhci_trb_data_stage(
        buffer.physical_address,
        USB_DEVICE_DESCRIPTOR_LENGTH as u32,
        0,
        true,
        false,
        xhci_ep0_producer_cycle_for(slot_id)
    );
    let status = xhci_trb_status_stage(false, true, xhci_ep0_producer_cycle_for(slot_id));

    let status_physical = xhci_ep0_submit_control_td_for_slot(slot_id, setup, data, status, true);
    if status_physical == 0 { return false; }
    if !xhci_transfer_wait_ep0_completion(slot_id, status_physical) { return false; }
    if xhci_transfer_last_residual_length_for(slot_id) != 0 { return false; }

    let base = buffer.virtual_address as *const u8;
    let length = xhci_descriptor_read8(base, 0);
    let descriptor_type = xhci_descriptor_read8(base, 1);
    if length != (USB_DEVICE_DESCRIPTOR_LENGTH as u8) ||
       descriptor_type != USB_DESCRIPTOR_TYPE_DEVICE { return false; }

    if !xhci_descriptor_state_is_current(slot_id) { return false; }
    unsafe {
        XHCI_DEVICE_DESCRIPTOR_STATES[index].usb_version = xhci_descriptor_read16(base, 2);
        XHCI_DEVICE_DESCRIPTOR_STATES[index].device_class = xhci_descriptor_read8(base, 4);
        XHCI_DEVICE_DESCRIPTOR_STATES[index].device_subclass = xhci_descriptor_read8(base, 5);
        XHCI_DEVICE_DESCRIPTOR_STATES[index].device_protocol = xhci_descriptor_read8(base, 6);
        XHCI_DEVICE_DESCRIPTOR_STATES[index].max_packet0 = xhci_descriptor_read8(base, 7);
        XHCI_DEVICE_DESCRIPTOR_STATES[index].vendor_id = xhci_descriptor_read16(base, 8);
        XHCI_DEVICE_DESCRIPTOR_STATES[index].product_id = xhci_descriptor_read16(base, 10);
        XHCI_DEVICE_DESCRIPTOR_STATES[index].buffer = buffer;
        XHCI_DEVICE_DESCRIPTOR_STATES[index].ready = true;
    }
    return true;
}

@system
pub fn xhci_get_first_device_descriptor() -> bool {
    let slot_id = xhci_address_slot_id();
    if slot_id == 0 { return false; }
    return xhci_get_device_descriptor_for_slot(slot_id);
}

@system
pub fn xhci_device_descriptor_is_ready_for(slot_id: u8) -> bool {
    if !xhci_descriptor_state_is_current(slot_id) { return false; }
    unsafe {
        return XHCI_DEVICE_DESCRIPTOR_STATES[xhci_descriptor_index(slot_id)].ready;
    }
}

@system
pub fn xhci_device_descriptor_is_ready() -> bool {
    return xhci_device_descriptor_is_ready_for(xhci_address_slot_id());
}

@system
pub fn xhci_device_usb_version_for(slot_id: u8) -> u16 {
    if !xhci_device_descriptor_is_ready_for(slot_id) { return 0; }
    unsafe { return XHCI_DEVICE_DESCRIPTOR_STATES[xhci_descriptor_index(slot_id)].usb_version; }
}

@system
pub fn xhci_device_vendor_id_for(slot_id: u8) -> u16 {
    if !xhci_device_descriptor_is_ready_for(slot_id) { return 0; }
    unsafe { return XHCI_DEVICE_DESCRIPTOR_STATES[xhci_descriptor_index(slot_id)].vendor_id; }
}

@system
pub fn xhci_device_product_id_for(slot_id: u8) -> u16 {
    if !xhci_device_descriptor_is_ready_for(slot_id) { return 0; }
    unsafe { return XHCI_DEVICE_DESCRIPTOR_STATES[xhci_descriptor_index(slot_id)].product_id; }
}

@system
pub fn xhci_device_class_for(slot_id: u8) -> u8 {
    if !xhci_device_descriptor_is_ready_for(slot_id) { return 0; }
    unsafe { return XHCI_DEVICE_DESCRIPTOR_STATES[xhci_descriptor_index(slot_id)].device_class; }
}

@system
pub fn xhci_device_subclass_for(slot_id: u8) -> u8 {
    if !xhci_device_descriptor_is_ready_for(slot_id) { return 0; }
    unsafe { return XHCI_DEVICE_DESCRIPTOR_STATES[xhci_descriptor_index(slot_id)].device_subclass; }
}

@system
pub fn xhci_device_protocol_for(slot_id: u8) -> u8 {
    if !xhci_device_descriptor_is_ready_for(slot_id) { return 0; }
    unsafe { return XHCI_DEVICE_DESCRIPTOR_STATES[xhci_descriptor_index(slot_id)].device_protocol; }
}

@system
pub fn xhci_device_max_packet0_for(slot_id: u8) -> u8 {
    if !xhci_device_descriptor_is_ready_for(slot_id) { return 0; }
    unsafe { return XHCI_DEVICE_DESCRIPTOR_STATES[xhci_descriptor_index(slot_id)].max_packet0; }
}

@system
pub fn xhci_device_usb_version() -> u16 { return xhci_device_usb_version_for(xhci_address_slot_id()); }
@system
pub fn xhci_device_vendor_id() -> u16 { return xhci_device_vendor_id_for(xhci_address_slot_id()); }
@system
pub fn xhci_device_product_id() -> u16 { return xhci_device_product_id_for(xhci_address_slot_id()); }
@system
pub fn xhci_device_class() -> u8 { return xhci_device_class_for(xhci_address_slot_id()); }
@system
pub fn xhci_device_subclass() -> u8 { return xhci_device_subclass_for(xhci_address_slot_id()); }
@system
pub fn xhci_device_protocol() -> u8 { return xhci_device_protocol_for(xhci_address_slot_id()); }
@system
pub fn xhci_device_max_packet0() -> u8 { return xhci_device_max_packet0_for(xhci_address_slot_id()); }
