// Baken OS — primeira transferência de controle USB real: GET_DESCRIPTOR(Device).
//
// Aloca um buffer DMA de 18 bytes (arena mínima de uma página), publica
// Setup+Data+Status no EP0, espera Transfer Event pelo consumidor compartilhado
// e valida os campos básicos do Device Descriptor. Não enumera Configuration/HID.

module kernel::drivers::xhci_descriptor;

import kernel::memory::dma::*;
import kernel::drivers::xhci_context::*;
import kernel::drivers::xhci_address::*;
import kernel::drivers::xhci_ep0::*;
import kernel::drivers::xhci_trb::*;
import kernel::drivers::xhci_transfer::*;

pub const USB_REQUEST_GET_DESCRIPTOR: u8 = 6;
pub const USB_REQUEST_TYPE_DEVICE_TO_HOST_STANDARD_DEVICE: u8 = 0x80;
pub const USB_DESCRIPTOR_TYPE_DEVICE: u8 = 1;
pub const USB_DEVICE_DESCRIPTOR_LENGTH: u16 = 18;
pub const USB_DEVICE_DESCRIPTOR_VALUE: u16 = 0x0100;
pub const XHCI_DESCRIPTOR_DMA_SIZE: u64 = 4096;

static mut XHCI_DEVICE_DESCRIPTOR_READY: bool = false;
static mut XHCI_DEVICE_USB_VERSION: u16 = 0;
static mut XHCI_DEVICE_VENDOR_ID: u16 = 0;
static mut XHCI_DEVICE_PRODUCT_ID: u16 = 0;
static mut XHCI_DEVICE_CLASS: u8 = 0;
static mut XHCI_DEVICE_SUBCLASS: u8 = 0;
static mut XHCI_DEVICE_PROTOCOL: u8 = 0;
static mut XHCI_DEVICE_MAX_PACKET0: u8 = 0;
static mut XHCI_DEVICE_DESCRIPTOR_BUFFER: DmaBuffer = DmaBuffer {
    virtual_address: null as *mut u8,
    physical_address: 0,
    size: 0,
    alignment: 0,
    owner: DMA_OWNER_CPU,
    fence: 0,
    valid: false
};

@system
fn xhci_descriptor_zero(buffer: *mut u8, size: u64) -> bool {
    if buffer == (null as *mut u8) || size == 0 { return false; }
    unsafe {
        let mut i: u64 = 0;
        while i < size {
            let slot = ((buffer as usize) + (i as usize)) as *mut u8;
            *slot = 0;
            i += 1;
        }
    }
    return true;
}

@system
fn xhci_descriptor_read8(base: *const u8, offset: u64) -> u8 {
    if base == (null as *const u8) { return 0; }
    unsafe { return *(((base as usize) + (offset as usize)) as *const u8); }
}

@system
fn xhci_descriptor_read16(base: *const u8, offset: u64) -> u16 {
    let lo = xhci_descriptor_read8(base, offset) as u16;
    let hi = xhci_descriptor_read8(base, offset + 1) as u16;
    return lo | (hi << 8);
}

@system
pub fn xhci_get_first_device_descriptor() -> bool {
    unsafe {
        XHCI_DEVICE_DESCRIPTOR_READY = false;
        XHCI_DEVICE_USB_VERSION = 0;
        XHCI_DEVICE_VENDOR_ID = 0;
        XHCI_DEVICE_PRODUCT_ID = 0;
        XHCI_DEVICE_CLASS = 0;
        XHCI_DEVICE_SUBCLASS = 0;
        XHCI_DEVICE_PROTOCOL = 0;
        XHCI_DEVICE_MAX_PACKET0 = 0;
        XHCI_DEVICE_DESCRIPTOR_BUFFER = dma_invalid_buffer();
    }
    if !xhci_address_is_ready() || !xhci_ep0_is_ready() { return false; }
    let slot_id = xhci_address_slot_id();
    if slot_id == 0 || slot_id != xhci_context_slot_id() { return false; }

    let mut buffer = dma_alloc(XHCI_DESCRIPTOR_DMA_SIZE, XHCI_DESCRIPTOR_DMA_SIZE);
    if !dma_buffer_cpu_owned(&buffer) { return false; }
    if !xhci_descriptor_zero(buffer.virtual_address, USB_DEVICE_DESCRIPTOR_LENGTH as u64) {
        return false;
    }
    if !dma_share_with_device(&mut buffer) { return false; }

    let setup = xhci_trb_setup_stage(
        USB_REQUEST_TYPE_DEVICE_TO_HOST_STANDARD_DEVICE,
        USB_REQUEST_GET_DESCRIPTOR,
        USB_DEVICE_DESCRIPTOR_VALUE,
        0,
        USB_DEVICE_DESCRIPTOR_LENGTH,
        XHCI_SETUP_TRT_IN_DATA,
        xhci_ep0_producer_cycle()
    );
    let data = xhci_trb_data_stage(
        buffer.physical_address,
        USB_DEVICE_DESCRIPTOR_LENGTH as u32,
        0,
        true,
        false,
        xhci_ep0_producer_cycle()
    );
    let status = xhci_trb_status_stage(false, true, xhci_ep0_producer_cycle());

    let status_physical = xhci_ep0_submit_control_td(setup, data, status, true);
    if status_physical == 0 { return false; }
    if !xhci_transfer_wait_ep0_completion(slot_id, status_physical) { return false; }
    if xhci_transfer_last_residual_length() != 0 { return false; }

    let base = buffer.virtual_address as *const u8;
    let length = xhci_descriptor_read8(base, 0);
    let descriptor_type = xhci_descriptor_read8(base, 1);
    if length != (USB_DEVICE_DESCRIPTOR_LENGTH as u8) ||
       descriptor_type != USB_DESCRIPTOR_TYPE_DEVICE { return false; }

    unsafe {
        XHCI_DEVICE_USB_VERSION = xhci_descriptor_read16(base, 2);
        XHCI_DEVICE_CLASS = xhci_descriptor_read8(base, 4);
        XHCI_DEVICE_SUBCLASS = xhci_descriptor_read8(base, 5);
        XHCI_DEVICE_PROTOCOL = xhci_descriptor_read8(base, 6);
        XHCI_DEVICE_MAX_PACKET0 = xhci_descriptor_read8(base, 7);
        XHCI_DEVICE_VENDOR_ID = xhci_descriptor_read16(base, 8);
        XHCI_DEVICE_PRODUCT_ID = xhci_descriptor_read16(base, 10);
        XHCI_DEVICE_DESCRIPTOR_BUFFER = buffer;
        XHCI_DEVICE_DESCRIPTOR_READY = true;
    }
    return true;
}

@system
pub fn xhci_device_descriptor_is_ready() -> bool {
    unsafe { return XHCI_DEVICE_DESCRIPTOR_READY; }
}

@system
pub fn xhci_device_usb_version() -> u16 { unsafe { return XHCI_DEVICE_USB_VERSION; } }
@system
pub fn xhci_device_vendor_id() -> u16 { unsafe { return XHCI_DEVICE_VENDOR_ID; } }
@system
pub fn xhci_device_product_id() -> u16 { unsafe { return XHCI_DEVICE_PRODUCT_ID; } }
@system
pub fn xhci_device_class() -> u8 { unsafe { return XHCI_DEVICE_CLASS; } }
@system
pub fn xhci_device_subclass() -> u8 { unsafe { return XHCI_DEVICE_SUBCLASS; } }
@system
pub fn xhci_device_protocol() -> u8 { unsafe { return XHCI_DEVICE_PROTOCOL; } }
@system
pub fn xhci_device_max_packet0() -> u8 { unsafe { return XHCI_DEVICE_MAX_PACKET0; } }
