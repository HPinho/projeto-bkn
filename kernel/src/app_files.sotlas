// Baken OS - BakenFS Graphical File Manager (Tema Claro)
// 100% Implementado na linguagem Sotlas (@system)

module kernel::app_files;

import kernel::graphics_engine::*;
import kernel::bakenfx::*;

pub struct FileItem {
    pub name: [u8; 32];
    pub size_str: [u8; 16];
    pub is_dir: bool;
    pub icon_id: u32;
}

pub struct FilesState {
    pub current_path: [u8; 64];
    pub selected_index: i32;
    pub item_count: usize;
    pub total_storage_gb: u32;
    pub free_storage_gb: u32;
}

static mut FILES_STATE: FilesState = FilesState {
    current_path: [0; 64],
    selected_index: 0,
    item_count: 6,
    total_storage_gb: 32,
    free_storage_gb: 14,
};

static mut ITEMS: [FileItem; 8] = [
    FileItem { name: [0; 32], size_str: [0; 16], is_dir: true, icon_id: 8 },
    FileItem { name: [0; 32], size_str: [0; 16], is_dir: true, icon_id: 8 },
    FileItem { name: [0; 32], size_str: [0; 16], is_dir: true, icon_id: 8 },
    FileItem { name: [0; 32], size_str: [0; 16], is_dir: false, icon_id: 6 },
    FileItem { name: [0; 32], size_str: [0; 16], is_dir: false, icon_id: 6 },
    FileItem { name: [0; 32], size_str: [0; 16], is_dir: false, icon_id: 10 },
    FileItem { name: [0; 32], size_str: [0; 16], is_dir: false, icon_id: 0 },
    FileItem { name: [0; 32], size_str: [0; 16], is_dir: false, icon_id: 0 },
];

@system
pub fn app_files_init() -> void {
    unsafe {
        let path = "/home/documentos";
        for mut i in 0..16 {
            FILES_STATE.current_path[i] = *path.add(i);
        }

        copy_str(ITEMS[0].name.as_ptr(), "Documentos");
        copy_str(ITEMS[0].size_str.as_ptr(), "4 itens");
        ITEMS[0].is_dir = true; ITEMS[0].icon_id = 8;

        copy_str(ITEMS[1].name.as_ptr(), "Projetos_Sotlas");
        copy_str(ITEMS[1].size_str.as_ptr(), "12 itens");
        ITEMS[1].is_dir = true; ITEMS[1].icon_id = 8;

        copy_str(ITEMS[2].name.as_ptr(), "Imagens");
        copy_str(ITEMS[2].size_str.as_ptr(), "8 itens");
        ITEMS[2].is_dir = true; ITEMS[2].icon_id = 10;

        copy_str(ITEMS[3].name.as_ptr(), "kernel_main.sotlas");
        copy_str(ITEMS[3].size_str.as_ptr(), "4.2 KB");
        ITEMS[3].is_dir = false; ITEMS[3].icon_id = 6;

        copy_str(ITEMS[4].name.as_ptr(), "notas_sistema.txt");
        copy_str(ITEMS[4].size_str.as_ptr(), "1.8 KB");
        ITEMS[4].is_dir = false; ITEMS[4].icon_id = 6;

        copy_str(ITEMS[5].name.as_ptr(), "wallpaper_aurora.png");
        copy_str(ITEMS[5].size_str.as_ptr(), "2.4 MB");
        ITEMS[5].is_dir = false; ITEMS[5].icon_id = 10;

        FILES_STATE.item_count = 6;
        FILES_STATE.selected_index = 0;
    }
}

@inline
fn copy_str(dst: *mut u8, src: *const u8) -> void {
    unsafe {
        for mut i in 0..31 {
            let ch = *src.add(i);
            dst[i] = ch;
            if ch == 0 { break; }
        }
    }
}

@system
pub fn app_files_render(x: u32, y: u32, w: u32, h: u32) -> void {
    unsafe {
        if FILES_STATE.item_count == 0 {
            app_files_init();
        }

        // Fundo da Janela de Arquivos (Tema Claro - Branco Cristal)
        bakenfx_fill_rect_alpha(x, y, w, h, 0x00FFFFFF, 250);

        // 1. Barra de Ferramentas Superior
        let bar_h: u32 = 40;
        bakenfx_fill_rect_alpha(x, y, w, bar_h, 0x00F1F5F9, 230);
        bakenfx_draw_hline(x, y + bar_h, w, 0x00CBD5E1, 180);

        // Breadcrumb Path Box
        let box_x = x + 12;
        let box_y = y + 8;
        let box_w = w - 160;
        let box_h: u32 = 24;
        bakenfx_draw_panel(box_x, box_y, box_w, box_h, 0x00FFFFFF, 220, 0x00CBD5E1, 6);
        bakenfx_draw_text_alpha(box_x + 8, box_y + 5, "/home/documentos", 0x000284C7, 1, 255);

        // Botões de Ação na barra superior
        let btn_x = x + w - 135;
        bakenfx_draw_panel(btn_x, box_y, 60, box_h, 0x00FFFFFF, 220, 0x00CBD5E1, 6);
        bakenfx_draw_text_alpha(btn_x + 8, box_y + 5, "+ Pasta", 0x00334155, 1, 240);

        let ref_x = btn_x + 68;
        bakenfx_draw_panel(ref_x, box_y, 55, box_h, 0x00FFFFFF, 220, 0x00CBD5E1, 6);
        bakenfx_draw_text_alpha(ref_x + 8, box_y + 5, "Recarregar", 0x0064748B, 1, 230);

        // 2. Barra Lateral de Acesso Rápido (Sidebar)
        let sidebar_w: u32 = 130;
        let body_y = y + bar_h + 1;
        let body_h = h - bar_h - 32;
        bakenfx_fill_rect_alpha(x, body_y, sidebar_w, body_h, 0x00F8FAFC, 230);
        bakenfx_draw_hline(x + sidebar_w, body_y, 1, 0x00CBD5E1, 150);

        let side_items = ["Inicio", "Documentos", "Projetos", "Sistema", "Midias"];
        for mut si in 0..5 {
            let sy = body_y + 12 + (si * 28) as u32;
            let is_sel = si == 1;
            if is_sel {
                bakenfx_draw_panel(x + 6, sy - 2, sidebar_w - 12, 22, 0x00E0F2FE, 220, 0x000284C7, 6);
                bakenfx_draw_text_alpha(x + 16, sy + 2, side_items[si], 0x000369A1, 1, 255);
            } else {
                bakenfx_draw_text_alpha(x + 16, sy + 2, side_items[si], 0x0064748B, 1, 220);
            }
        }

        // 3. Grid Principal de Arquivos e Pastas
        let content_x = x + sidebar_w + 12;
        let content_y = body_y + 12;
        let cols: u32 = 3;
        let card_w: u32 = (w - sidebar_w - 36) / cols;
        let card_h: u32 = 58;

        for mut i in 0..FILES_STATE.item_count {
            let col = (i as u32) % cols;
            let row = (i as u32) / cols;
            let cx = content_x + col * (card_w + 8);
            let cy = content_y + row * (card_h + 8);

            let is_active = (i as i32) == FILES_STATE.selected_index;
            let bg_c = if is_active { 0x00E0F2FE } else { 0x00F8FAFC };
            let border_c = if is_active { 0x000284C7 } else { 0x00E2E8F0 };

            bakenfx_draw_panel(cx, cy, card_w, card_h, bg_c, 220, border_c, 8);

            let is_folder = ITEMS[i].is_dir;
            let icon_col = if is_folder { 0x00D97706 } else { 0x000284C7 };
            bakenfx_draw_icon(ITEMS[i].icon_id, cx + 8, cy + 18, 20, icon_col, 255);

            let name_ptr = ITEMS[i].name.as_ptr();
            let size_ptr = ITEMS[i].size_str.as_ptr();
            bakenfx_draw_text_alpha(cx + 36, cy + 14, name_ptr, 0x000F172A, 1, 255);
            bakenfx_draw_text_alpha(cx + 36, cy + 32, size_ptr, 0x0064748B, 1, 220);
        }

        // 4. Rodapé de Status do Armazenamento
        let foot_y = y + h - 28;
        bakenfx_fill_rect_alpha(x, foot_y, w, 28, 0x00F1F5F9, 240);
        bakenfx_draw_hline(x, foot_y, w, 0x00CBD5E1, 150);

        bakenfx_draw_text_alpha(x + 12, foot_y + 8, "BakenFS: 14.2 GB livres de 32.0 GB (44% usado)", 0x0064748B, 1, 240);

        // Barra de Progresso do Disco
        let bar_bg_x = x + w - 160;
        let bar_bg_y = foot_y + 10;
        let bar_len: u32 = 140;
        let bar_thick: u32 = 8;
        bakenfx_draw_panel(bar_bg_x, bar_bg_y, bar_len, bar_thick, 0x00E2E8F0, 200, 0x00CBD5E1, 4);
        let used_len = (bar_len * 44) / 100;
        bakenfx_fill_rect_alpha(bar_bg_x, bar_bg_y, used_len, bar_thick, 0x000284C7, 255);
    }
}

@system
pub fn app_files_handle_click(rel_x: i32, rel_y: i32) -> void {
    unsafe {
        if rel_y > 40 && rel_x > 130 {
            let grid_x = (rel_x - 142) as u32;
            let grid_y = (rel_y - 52) as u32;
            let col = grid_x / 110;
            let row = grid_y / 66;
            let idx = (row * 3 + col) as i32;
            if idx >= 0 && (idx as usize) < FILES_STATE.item_count {
                FILES_STATE.selected_index = idx;
            }
        }
    }
}
