// Baken OS - Área de Transferência Global (System Clipboard) em BKN Puro (@system)
// Mecanismo IPC para Copiar e Colar Textos, Arquivos e Dados Entre Janelas

module kernel::clipboard;

pub const CLIPBOARD_MAX_BYTES: usize = 4096;

pub enum ClipboardFormat {
    PlainText = 1,
    FilePath = 2,
    BinaryData = 3,
}

pub struct SystemClipboard {
    pub buffer: [u8; CLIPBOARD_MAX_BYTES],
    pub length: usize,
    pub format: ClipboardFormat,
    pub sequence_num: u32,
}

static mut CLIPBOARD: SystemClipboard = SystemClipboard {
    buffer: [0; CLIPBOARD_MAX_BYTES],
    length: 0,
    format: ClipboardFormat::PlainText,
    sequence_num: 0,
};

@system
pub fn clipboard_init() {
    unsafe {
        CLIPBOARD.length = 0;
        CLIPBOARD.sequence_num = 0;
    }
}

// Copia texto para a Área de Transferência Global
@system
pub fn clipboard_set_text(text_ptr: *const u8, len: usize) -> bool {
    unsafe {
        let copy_len = if len < CLIPBOARD_MAX_BYTES { len } else { CLIPBOARD_MAX_BYTES - 1 };
        for i in 0..copy_len {
            CLIPBOARD.buffer[i] = *text_ptr.add(i);
        }
        CLIPBOARD.buffer[copy_len] = 0;
        CLIPBOARD.length = copy_len;
        CLIPBOARD.format = ClipboardFormat::PlainText;
        CLIPBOARD.sequence_num += 1;
        return true;
    }
}

// Cola texto da Área de Transferência para a aplicação solicitante
@system
pub fn clipboard_get_text(out_ptr: *mut u8, max_len: usize) -> usize {
    unsafe {
        if CLIPBOARD.length == 0 { return 0; }
        let copy_len = if CLIPBOARD.length < max_len { CLIPBOARD.length } else { max_len - 1 };
        for i in 0..copy_len {
            *out_ptr.add(i) = CLIPBOARD.buffer[i];
        }
        *out_ptr.add(copy_len) = 0;
        return copy_len;
    }
}

@system
pub fn clipboard_has_content() -> bool {
    unsafe { return CLIPBOARD.length > 0; }
}
