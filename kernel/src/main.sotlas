// Baken OS - entrada canônica do kernel modular em Sotlas (@system).
// O frontend reduz o grafo para objetos independentes; nenhum módulo auxiliar
// deve declarar outra função baken_kernel_main.

module kernel::main;

import kernel::graphics_engine::*;
import kernel::desktop_compositor::*;
import kernel::baken_runtime::*;
import kernel::sotlas_graphics::*;
import kernel::sotlas_ui::*;
import kernel::memory::pmm::*;
import kernel::memory::dma::*;
import kernel::acpi::tables::*;
import kernel::acpi::madt::*;
import kernel::acpi::mcfg::*;
import kernel::acpi::hpet::*;
import kernel::acpi::fadt::*;
import kernel::interrupts::route::*;
import kernel::drivers::pci_bus::*;
import kernel::drivers::xhci_discovery::*;
import kernel::drivers::xhci_ring::*;
import kernel::drivers::xhci_trb::*;
import kernel::drivers::xhci_event::*;
import kernel::arch::x86_64::gdt::*;
import kernel::arch::x86_64::tss::*;
import kernel::arch::x86_64::idt::*;
import kernel::arch::x86_64::cpu::*;
import kernel::arch::x86_64::timer::*;
import kernel::arch::x86_64::exceptions::*;

// Envelope de transição BakenBootInfo v2.
// Os primeiros campos preservam o ABI legado enquanto input/storage/timing
// ainda usam pontes UEFI. Os campos finais já carregam metadados necessários
// ao futuro handoff pós-ExitBootServices.
pub struct BakenBootInfo {
    pub framebuffer_base: *mut u32;
    pub framebuffer_size: usize;
    pub screen_width: u32;
    pub screen_height: u32;
    pub pixels_per_scanline: u32;
    pub memory_map_base: *const u8;
    pub memory_map_size: usize;
    pub system_table: *mut u8;
    pub pointer_protocol: *mut u8;
    pub block_io_protocol: *mut u8;
    pub install_target_block_io_protocol: *mut u8;

    pub version: u32;
    pub struct_size: u32;
    pub flags: u64;
    pub memory_descriptor_size: u64;
    pub memory_descriptor_version: u32;
    pub pixel_format: u32;
    pub acpi_rsdp: *const u8;
}

@system
pub fn baken_bootinfo_v2_valid(boot_info: *const BakenBootInfo) -> bool {
    if (boot_info == (null as *const BakenBootInfo)) { return false; }
    if (boot_info.version != 2) { return false; }
    if (boot_info.struct_size < 120) { return false; }
    if (boot_info.framebuffer_base == (null as *mut u32)) { return false; }
    if (boot_info.screen_width == 0 || boot_info.screen_height == 0) { return false; }
    if (boot_info.pixels_per_scanline < boot_info.screen_width) { return false; }
    return true;
}

// Entrada inicial do kernel Sotlas. Durante a migração, a sessão gráfica ainda
// usa o adaptador UEFI do runtime; nenhum código novo deve aumentar essa dívida.
@system
@export
pub fn baken_kernel_main(boot_info: *const BakenBootInfo) -> ! {
    if (!baken_bootinfo_v2_valid(boot_info)) {
        loop {}
    }

    // Prepara estruturas x86-64 concretas em memória antes das demais camadas.
    // Os gates 0..31 recebem endereços reais dos stubs, mas LGDT/LIDT/LTR
    // continuam proibidos enquanto Boot Services ainda é usado.
    exception_state_reset();
    tss_prepare_default_stacks();
    gdt_prepare();
    gdt_set_tss_descriptor(tss_base(), tss_limit());
    if !idt_prepare_exceptions() {
        loop {}
    }

    // O bit 1 indica que o bootloader entregou um snapshot real do UEFI
    // Memory Map. Por enquanto o PMM apenas inventaria/classifica as regiões:
    // nenhuma EfiConventionalMemory é reutilizada enquanto Boot Services vive.
    if ((boot_info.flags & 2) != 0 &&
        boot_info.memory_map_base != (null as *const u8) &&
        boot_info.memory_descriptor_size >= 40) {
        pmm_inventory_init(
            boot_info.memory_map_base,
            boot_info.memory_map_size,
            boot_info.memory_descriptor_size as usize
        );
    }

    // Os contratos DMA/xHCI ring/TRB/event já fazem parte do grafo, mas
    // permanecem fail-closed enquanto o PMM não possuir allocator físico.
    dma_allocator_available();

    // ACPI é validada por assinatura/checksum antes de qualquer consumidor
    // usar MADT/MCFG/HPET/FADT. Falha de ACPI não é fatal nesta fase híbrida;
    // apenas mantém essas capacidades indisponíveis.
    if boot_info.acpi_rsdp != (null as *const u8) {
        if acpi_init(boot_info.acpi_rsdp) {
            // Inventários passivos: nenhum LAPIC/IOAPIC/HPET/PM timer é
            // ativado e nenhum endereço ECAM/MMIO é acessado enquanto
            // VMM/page tables próprios ainda não existem. O módulo de rotas
            // consome MADT apenas quando um IRQ for planejado futuramente.
            madt_init();
            mcfg_init();
            hpet_init();
            fadt_pm_timer_init();
        }
    }

    // Descoberta PCI é somente leitura. Ela registra hardware real, mas não
    // habilita Bus Master, I/O/Memory Space nem promove dispositivos para
    // "drivers prontos". O mechanism #1 continua temporário; MCFG apenas
    // inventaria ECAM por ora.
    pci_scan_all();

    // xHCI discovery apenas registra candidatos PCI 0C/03/30 e BAR0. Nenhum
    // reset de controlador, MMIO, DMA, MSI/MSI-X ou ring é criado aqui.
    xhci_discovery_scan();

    // O framebuffer GOP é transportado como endereço físico/passivo no handoff.
    display_init(
        boot_info.framebuffer_base,
        boot_info.screen_width,
        boot_info.screen_height,
        boot_info.pixels_per_scanline
    );
    baken_runtime_init_assets();

    // A composição é dona do ciclo visual; nenhum aplicativo grava no GOP.
    desktop_compositor_init(boot_info.screen_width, boot_info.screen_height);

    // Compatibilidade temporária: baken_runtime ainda interpreta o prefixo
    // legado do BootInfo. Isso será removido quando Input HAL, timer e storage
    // nativos permitirem ExitBootServices antes da entrada normal do kernel.
    baken_runtime_run(boot_info as *const void, boot_info.screen_width, boot_info.screen_height);
    loop {}
}
