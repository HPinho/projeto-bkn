// Baken OS — loader userspace mínimo, nativo e W^X.
// Materializa um programa de prova em frames PMM antes de publicar os PTEs.
// Código USER+RX; dados USER+NX; stack USER+RW+NX; guard page não mapeada.
module kernel::process::userspace_loader;

import kernel::arch::x86_64::cpu::*;
import kernel::arch::x86_64::paging::*;
import kernel::arch::x86_64::serial::*;
import kernel::arch::x86_64::smp::*;
import kernel::arch::x86_64::tss::*;
import kernel::arch::x86_64::exceptions::*;
import kernel::interrupts::irq::*;
import kernel::interrupts::lapic::*;
import kernel::memory::direct_map::*;
import kernel::memory::pmm_allocator::*;
import kernel::memory::tlb_shootdown::*;
import kernel::process::address_space::*;
import kernel::process::registry::*;
import kernel::scheduler::core::*;
import kernel::scheduler::yield::*;
import kernel::syscall::dispatch::*;

pub const USERSPACE_CODE_ADDRESS: u64 = PROCESS_USER_BASE;
pub const USERSPACE_DATA_ADDRESS: u64 = PROCESS_USER_BASE + 0x1000;
pub const USERSPACE_STACK_GUARD: u64 = PROCESS_USER_BASE + PROCESS_USER_WINDOW_SIZE - 0x2000;
pub const USERSPACE_STACK_ADDRESS: u64 = PROCESS_USER_BASE + PROCESS_USER_WINDOW_SIZE - 0x1000;
pub const USERSPACE_STACK_TOP: u64 = PROCESS_USER_BASE + PROCESS_USER_WINDOW_SIZE;
pub const USERSPACE_PROBE_CODE_BYTES: usize = 39;
pub const USERSPACE_PROBE_DATA_BYTES: usize = 20;
pub const USERSPACE_FAULT_PROBE_CODE_BYTES: usize = 12;
pub const USERSPACE_MIGRATION_CPU_SLOT: usize = 1;
pub const USERSPACE_MIGRATION_CODE_BYTES: usize = 90;
pub const USERSPACE_MIGRATION_STARTED_OFFSET: u64 = 0;
pub const USERSPACE_MIGRATION_RELEASE_OFFSET: u64 = 4;
pub const USERSPACE_MIGRATION_PASSED_OFFSET: u64 = 8;
pub const USERSPACE_MIGRATION_FAILED_OFFSET: u64 = 12;
pub const USERSPACE_MIGRATION_PATTERN_OFFSET: u64 = 64;
pub const USERSPACE_MIGRATION_PATTERN_BYTES: usize = 16;

static mut USERSPACE_PID: u64 = 0;
static mut USERSPACE_TID: u64 = 0;
static mut USERSPACE_CODE_FRAME: u64 = 0;
static mut USERSPACE_DATA_FRAME: u64 = 0;
static mut USERSPACE_STACK_FRAME: u64 = 0;
static mut USERSPACE_STARTED: bool = false;
static mut USERSPACE_FINISHED: bool = false;
static mut USERSPACE_FAULT_PID: u64 = 0;
static mut USERSPACE_FAULT_CODE_FRAME: u64 = 0;
static mut USERSPACE_FAULT_DATA_FRAME: u64 = 0;
static mut USERSPACE_FAULT_STACK_FRAME: u64 = 0;
static mut USERSPACE_FAULT_STARTED: bool = false;
static mut USERSPACE_FAULT_FINISHED: bool = false;
static mut USERSPACE_FAULT_CPU_SLOT: usize = SCHEDULER_INVALID_CPU_SLOT;

@system
fn userspace_diag(stage: u32) -> void {
    if x86_serial_is_ready() { x86_serial_write_hex32_marker('U' as u8, stage); }
}

@system
fn userspace_migration_diag(stage: u32) -> void {
    if x86_serial_is_ready() { x86_serial_write_hex32_marker('M' as u8, stage); }
}

@system
fn userspace_zero_frame(physical: u64) -> bool {
    let virtual_address = direct_map_virtual_address(physical);
    if virtual_address == 0 { return false; }
    unsafe {
        let mut index: u64 = 0;
        while index < X86_PAGE_SIZE {
            *((virtual_address + index) as *mut u8) = 0;
            index += 1;
        }
    }
    return true;
}

@system
fn userspace_materialize_probe(code_physical: u64, data_physical: u64) -> bool {
    let code_virtual = direct_map_virtual_address(code_physical);
    let data_virtual = direct_map_virtual_address(data_physical);
    if code_virtual == 0 || data_virtual == 0 { return false; }
    // mov rax,1; movabs rdi,0x0000200000001000; mov rsi,20; int 43h;
    // mov rax,2; xor edi,edi; int 43h; ud2.
    let code: [u8; USERSPACE_PROBE_CODE_BYTES] = [
        72,199,192,1,0,0,0,
        72,191,0,16,0,0,0,32,0,0,
        72,199,198,20,0,0,0,
        205,67,
        72,199,192,2,0,0,0,
        49,255,205,67,15,11
    ];
    let data: [u8; USERSPACE_PROBE_DATA_BYTES] = [
        66,65,75,69,78,58,82,73,78,71,51,95,69,78,84,69,82,69,68,10
    ];
    unsafe {
        let mut index: usize = 0;
        while index < USERSPACE_PROBE_CODE_BYTES {
            *((code_virtual + index as u64) as *mut u8) = code[index];
            index += 1;
        }
        index = 0;
        while index < USERSPACE_PROBE_DATA_BYTES {
            *((data_virtual + index as u64) as *mut u8) = data[index];
            index += 1;
        }
    }
    return true;
}

@system
fn userspace_materialize_fault_probe(code_physical: u64) -> bool {
    let code_virtual = direct_map_virtual_address(code_physical);
    if code_virtual == 0 { return false; }
    // mov rax, USERSPACE_STACK_GUARD; mov al, [rax]. A guard page não existe,
    // portanto a leitura produz #PF com origem CPL3 e bit USER definido.
    let code: [u8; USERSPACE_FAULT_PROBE_CODE_BYTES] = [
        72,184,0,224,31,0,0,0,32,0,138,0
    ];
    unsafe {
        let mut index: usize = 0;
        while index < USERSPACE_FAULT_PROBE_CODE_BYTES {
            *((code_virtual + index as u64) as *mut u8) = code[index];
            index += 1;
        }
    }
    return true;
}

@system
fn userspace_materialize_migration_probe(code_physical: u64, data_physical: u64) -> bool {
    let code_virtual = direct_map_virtual_address(code_physical);
    let data_virtual = direct_map_virtual_address(data_physical);
    if code_virtual == 0 || data_virtual == 0 { return false; }
    // Ring 3: carrega XMM0, publica started, aguarda o kernel migrar o mesmo
    // TID para o AP, compara os 128 bits restaurados e encerra por syscall.
    let code: [u8; USERSPACE_MIGRATION_CODE_BYTES] = [
        72,187,0,16,0,0,0,32,0,0,
        243,15,111,67,64,
        199,3,1,0,0,0,
        131,123,4,1,117,250,
        243,15,111,75,64,
        102,15,116,200,
        102,15,215,193,
        61,255,255,0,0,
        117,20,
        199,67,8,1,0,0,0,
        72,199,192,2,0,0,0,
        49,255,205,67,15,11,
        199,67,12,1,0,0,0,
        72,199,192,2,0,0,0,
        191,1,0,0,0,
        205,67,15,11
    ];
    let pattern: [u8; USERSPACE_MIGRATION_PATTERN_BYTES] = [
        17,34,51,68,85,102,119,136,
        153,170,187,204,221,238,15,240
    ];
    unsafe {
        let mut index: usize = 0;
        while index < USERSPACE_MIGRATION_CODE_BYTES {
            *((code_virtual + index as u64) as *mut u8) = code[index];
            index += 1;
        }
        index = 0;
        while index < USERSPACE_MIGRATION_PATTERN_BYTES {
            *((data_virtual + USERSPACE_MIGRATION_PATTERN_OFFSET + index as u64) as *mut u8) = pattern[index];
            index += 1;
        }
    }
    return true;
}

@system
fn userspace_release_frames(code: u64, data: u64, stack: u64) -> bool {
    let mut ok = true;
    if code != 0 && !pmm_free_pages(code, 1) { ok = false; }
    if data != 0 && !pmm_free_pages(data, 1) { ok = false; }
    if stack != 0 && !pmm_free_pages(stack, 1) { ok = false; }
    return ok;
}

@system
fn userspace_teardown_mapping(pid: u64, code: u64, data: u64, stack: u64) -> bool {
    let mapped_code = process_unmap_user_page(pid, USERSPACE_CODE_ADDRESS);
    let mapped_data = process_unmap_user_page(pid, USERSPACE_DATA_ADDRESS);
    let mapped_stack = process_unmap_user_page(pid, USERSPACE_STACK_ADDRESS);
    let release_code = if mapped_code != 0 { mapped_code } else { code };
    let release_data = if mapped_data != 0 { mapped_data } else { data };
    let release_stack = if mapped_stack != 0 { mapped_stack } else { stack };
    let released = userspace_release_frames(release_code, release_data, release_stack);
    let destroyed = process_destroy(pid);
    return released && destroyed;
}

@system
@export
pub fn sotlas_x86_userspace_bootstrap_entry() -> ! {
    userspace_diag(0x10);
    let cpu_slot = scheduler_current_cpu_slot();
    if cpu_slot == SCHEDULER_INVALID_CPU_SLOT { loop { x86_cpu_pause(); } }
    userspace_diag(0x11);
    let pid = process_current_id();
    unsafe {
        if pid == 0 || pid != USERSPACE_PID { loop { x86_cpu_pause(); } }
    }
    userspace_diag(0x12);
    let current_rsp = __current_rsp();
    if current_rsp > 0xFFFFFFFFFFFFFFD7 { loop { x86_cpu_pause(); } }
    // Scheduler trampoline: stack_top - 32 bytes de home space - return address.
    let kernel_stack_top = (current_rsp + 40) & 0xFFFFFFFFFFFFFFF0;
    if !tss_set_rsp0_for_cpu(cpu_slot, kernel_stack_top) { loop { x86_cpu_pause(); } }
    userspace_diag(0x13);
    __enter_user(USERSPACE_CODE_ADDRESS, USERSPACE_STACK_TOP);
    loop { x86_cpu_pause(); }
}

@system
pub fn userspace_loader_start_probe() -> bool {
    userspace_diag(1);
    unsafe { if USERSPACE_STARTED { return false; } }
    let pid = process_create();
    if pid == 0 { return false; }
    userspace_diag(2);
    let code = pmm_alloc_page();
    let data = pmm_alloc_page();
    let stack = pmm_alloc_page();
    if code == 0 || data == 0 || stack == 0 {
        userspace_release_frames(code, data, stack);
        process_destroy(pid);
        return false;
    }
    if !userspace_zero_frame(code) || !userspace_zero_frame(data) ||
       !userspace_zero_frame(stack) || !userspace_materialize_probe(code, data) {
        userspace_release_frames(code, data, stack);
        process_destroy(pid);
        return false;
    }
    userspace_diag(3);
    // Sem janela W+X: os bytes já estão prontos quando as folhas são publicadas.
    if !process_map_user_page(pid, USERSPACE_CODE_ADDRESS, code, false, true) ||
       !process_map_user_page(pid, USERSPACE_DATA_ADDRESS, data, false, false) ||
       !process_map_user_page(pid, USERSPACE_STACK_ADDRESS, stack, true, false) {
        userspace_teardown_mapping(pid, code, data, stack);
        return false;
    }
    userspace_diag(4);
    if process_user_pte(pid, USERSPACE_STACK_GUARD) != 0 {
        userspace_teardown_mapping(pid, code, data, stack);
        return false;
    }
    let code_pte = process_user_pte(pid, USERSPACE_CODE_ADDRESS);
    let data_pte = process_user_pte(pid, USERSPACE_DATA_ADDRESS);
    let stack_pte = process_user_pte(pid, USERSPACE_STACK_ADDRESS);
    if (code_pte & (X86_PTE_PRESENT | X86_PTE_USER | X86_PTE_WRITABLE | X86_PTE_NX)) !=
       (X86_PTE_PRESENT | X86_PTE_USER) ||
       (data_pte & (X86_PTE_PRESENT | X86_PTE_USER | X86_PTE_WRITABLE | X86_PTE_NX)) !=
       (X86_PTE_PRESENT | X86_PTE_USER | X86_PTE_NX) ||
       (stack_pte & (X86_PTE_PRESENT | X86_PTE_USER | X86_PTE_WRITABLE | X86_PTE_NX)) !=
       (X86_PTE_PRESENT | X86_PTE_USER | X86_PTE_WRITABLE | X86_PTE_NX) {
        userspace_teardown_mapping(pid, code, data, stack);
        return false;
    }
    userspace_diag(5);
    let entry = __userspace_bootstrap_entry_address();
    if entry == 0 {
        userspace_teardown_mapping(pid, code, data, stack);
        return false;
    }
    unsafe {
        USERSPACE_PID = pid;
        USERSPACE_CODE_FRAME = code;
        USERSPACE_DATA_FRAME = data;
        USERSPACE_STACK_FRAME = stack;
    }
    userspace_diag(6);
    let tid = scheduler_create_process_thread(pid, entry, SCHEDULER_DEFAULT_THREAD_STACK_PAGES);
    if tid == 0 {
        unsafe { USERSPACE_PID = 0; }
        userspace_teardown_mapping(pid, code, data, stack);
        return false;
    }
    userspace_diag(7);
    unsafe {
        USERSPACE_TID = tid;
        USERSPACE_STARTED = true;
    }
    return true;
}

@system
pub fn userspace_loader_wait_probe() -> bool {
    unsafe { if !USERSPACE_STARTED || USERSPACE_PID == 0 { return false; } }
    let mut spins: u64 = 0;
    while spins < SCHEDULER_ROUND_TRIP_SPIN_LIMIT {
        unsafe {
            if process_reference_count(USERSPACE_PID) == 0 && syscall_exit_count() != 0 {
                return true;
            }
        }
        if !scheduler_yield() { return false; }
        spins += 1;
    }
    return false;
}

@system
pub fn userspace_loader_finish_probe() -> bool {
    unsafe {
        if !USERSPACE_STARTED || USERSPACE_PID == 0 ||
           process_reference_count(USERSPACE_PID) != 0 { return false; }
        if syscall_last_exit_code() != 0 { return false; }
        let code = process_unmap_user_page(USERSPACE_PID, USERSPACE_CODE_ADDRESS);
        let data = process_unmap_user_page(USERSPACE_PID, USERSPACE_DATA_ADDRESS);
        let stack = process_unmap_user_page(USERSPACE_PID, USERSPACE_STACK_ADDRESS);
        if code != USERSPACE_CODE_FRAME || data != USERSPACE_DATA_FRAME ||
           stack != USERSPACE_STACK_FRAME { return false; }
        if process_user_pte(USERSPACE_PID, USERSPACE_STACK_GUARD) != 0 { return false; }
        if !userspace_release_frames(code, data, stack) { return false; }
        if !process_destroy(USERSPACE_PID) { return false; }
        USERSPACE_FINISHED = true;
        USERSPACE_PID = 0;
    }
    return true;
}

@system
fn userspace_loader_start_fault_probe_on_cpu(cpu_slot: usize) -> bool {
    unsafe { if !USERSPACE_FINISHED || USERSPACE_FAULT_STARTED { return false; } }
    if cpu_slot >= SCHEDULER_CPU_SLOT_COUNT { return false; }
    if cpu_slot != 0 && smp_scheduler_active_ap_count() == 0 { return false; }
    exception_state_reset_for_cpu(cpu_slot);
    let pid = process_create();
    if pid == 0 { return false; }
    let code = pmm_alloc_page();
    let data = pmm_alloc_page();
    let stack = pmm_alloc_page();
    if code == 0 || data == 0 || stack == 0 {
        userspace_release_frames(code, data, stack);
        process_destroy(pid);
        return false;
    }
    if !userspace_zero_frame(code) || !userspace_zero_frame(data) ||
       !userspace_zero_frame(stack) || !userspace_materialize_fault_probe(code) {
        userspace_release_frames(code, data, stack);
        process_destroy(pid);
        return false;
    }
    if !process_map_user_page(pid, USERSPACE_CODE_ADDRESS, code, false, true) ||
       !process_map_user_page(pid, USERSPACE_DATA_ADDRESS, data, true, false) ||
       !process_map_user_page(pid, USERSPACE_STACK_ADDRESS, stack, true, false) {
        userspace_teardown_mapping(pid, code, data, stack);
        return false;
    }
    if process_user_pte(pid, USERSPACE_STACK_GUARD) != 0 {
        userspace_teardown_mapping(pid, code, data, stack);
        return false;
    }
    let entry = __userspace_bootstrap_entry_address();
    if entry == 0 { userspace_teardown_mapping(pid, code, data, stack); return false; }
    unsafe {
        USERSPACE_PID = pid;
        USERSPACE_FAULT_PID = pid;
        USERSPACE_FAULT_CODE_FRAME = code;
        USERSPACE_FAULT_DATA_FRAME = data;
        USERSPACE_FAULT_STACK_FRAME = stack;
    }
    let mut tid: u64 = 0;
    if cpu_slot == 0 {
        tid = scheduler_create_process_thread(pid, entry, SCHEDULER_DEFAULT_THREAD_STACK_PAGES);
    } else {
        tid = scheduler_create_process_thread_on_cpu(
            pid, entry, SCHEDULER_DEFAULT_THREAD_STACK_PAGES, cpu_slot
        );
    }
    if tid == 0 {
        unsafe { USERSPACE_PID = 0; USERSPACE_FAULT_PID = 0; }
        userspace_teardown_mapping(pid, code, data, stack);
        return false;
    }
    unsafe {
        USERSPACE_TID = tid;
        USERSPACE_STARTED = true;
        USERSPACE_FAULT_STARTED = true;
        USERSPACE_FAULT_FINISHED = false;
        USERSPACE_FAULT_CPU_SLOT = cpu_slot;
    }
    return true;
}

@system
pub fn userspace_loader_start_fault_probe() -> bool {
    return userspace_loader_start_fault_probe_on_cpu(0);
}

@system
pub fn userspace_loader_wait_fault_probe() -> bool {
    let mut cpu_slot: usize = SCHEDULER_INVALID_CPU_SLOT;
    unsafe { cpu_slot = USERSPACE_FAULT_CPU_SLOT; }
    if cpu_slot >= SCHEDULER_CPU_SLOT_COUNT { return false; }
    let mut spins: u64 = 0;
    while spins < SCHEDULER_ROUND_TRIP_SPIN_LIMIT {
        unsafe {
            if USERSPACE_FAULT_STARTED && USERSPACE_FAULT_PID != 0 &&
               exception_cpu_has_snapshot(cpu_slot) &&
               exception_cpu_last_was_user(cpu_slot) &&
               exception_cpu_last_vector(cpu_slot) == EXCEPTION_PAGE_FAULT &&
               page_fault_was_user(exception_cpu_last_error_code(cpu_slot)) &&
               exception_cpu_last_process_id(cpu_slot) == USERSPACE_FAULT_PID &&
               process_reference_count(USERSPACE_FAULT_PID) == 0 {
                return true;
            }
        }
        if !scheduler_yield() { return false; }
        spins += 1;
    }
    return false;
}

@system
pub fn userspace_loader_finish_fault_probe() -> bool {
    unsafe {
        if !USERSPACE_FAULT_STARTED || USERSPACE_FAULT_PID == 0 ||
           process_reference_count(USERSPACE_FAULT_PID) != 0 { return false; }
        let code = process_unmap_user_page(USERSPACE_FAULT_PID, USERSPACE_CODE_ADDRESS);
        let data = process_unmap_user_page(USERSPACE_FAULT_PID, USERSPACE_DATA_ADDRESS);
        let stack = process_unmap_user_page(USERSPACE_FAULT_PID, USERSPACE_STACK_ADDRESS);
        if code != USERSPACE_FAULT_CODE_FRAME || data != USERSPACE_FAULT_DATA_FRAME ||
           stack != USERSPACE_FAULT_STACK_FRAME ||
           !userspace_release_frames(code, data, stack) || !process_destroy(USERSPACE_FAULT_PID) {
            return false;
        }
        USERSPACE_PID = 0;
        USERSPACE_TID = 0;
        USERSPACE_STARTED = false;
        USERSPACE_FAULT_STARTED = false;
        USERSPACE_FAULT_FINISHED = true;
        USERSPACE_FAULT_PID = 0;
        USERSPACE_FAULT_CPU_SLOT = SCHEDULER_INVALID_CPU_SLOT;
    }
    return true;
}

@system
fn userspace_emit(marker: *const u8, length: usize) -> bool {
    if marker == (null as *const u8) { return false; }
    unsafe {
        let mut index: usize = 0;
        while index < length {
            if !x86_serial_write_byte(marker[index]) { return false; }
            index += 1;
        }
    }
    return true;
}

@system
pub fn userspace_loader_emit_ready_markers() -> bool {
    unsafe { if !USERSPACE_FINISHED { return false; } }
    let ring3: [u8; 18] = [66,65,75,69,78,58,82,73,78,71,51,95,82,69,65,68,89,10];
    let syscall: [u8; 20] = [66,65,75,69,78,58,83,89,83,67,65,76,76,95,82,69,65,68,89,10];
    let copy: [u8; 22] = [66,65,75,69,78,58,85,83,69,82,95,67,79,80,89,95,82,69,65,68,89,10];
    let loader: [u8; 29] = [66,65,75,69,78,58,85,83,69,82,83,80,65,67,69,95,76,79,65,68,69,82,95,82,69,65,68,89,10];
    return userspace_emit(&ring3[0], 18) && userspace_emit(&syscall[0], 20) &&
           userspace_emit(&copy[0], 22) && userspace_emit(&loader[0], 29);
}

@system
pub fn userspace_loader_emit_fault_isolation_marker() -> bool {
    unsafe { if !USERSPACE_FAULT_FINISHED { return false; } }
    let marker: [u8; 32] = [
        66,65,75,69,78,58,85,83,69,82,95,70,65,85,76,84,95,73,83,79,76,65,84,69,68,95,82,69,65,68,89,10
    ];
    return userspace_emit(&marker[0], 32);
}

@system
fn userspace_loader_emit_ap_fault_isolation_marker() -> bool {
    unsafe { if !USERSPACE_FAULT_FINISHED { return false; } }
    let marker: [u8; 36] = [
        66,65,75,69,78,58,83,77,80,95,85,83,69,82,95,70,65,85,76,84,95,
        73,83,79,76,65,84,69,68,95,82,69,65,68,89,10
    ];
    return userspace_emit(&marker[0], 36);
}

// Prova a mesma política de isolamento em Ring 3 no primeiro AP. O processo
// nasce pinned no CPU 1, recebe reschedule IPI, causa #PF na guard page e deve
// ser encerrado/reaped sem afetar o BSP nem o runtime do AP.
@system
pub fn userspace_loader_run_ap_fault_probe() -> bool {
    if smp_runtime_ap_count() == 0 { return true; }
    if USERSPACE_MIGRATION_CPU_SLOT >= SCHEDULER_CPU_SLOT_COUNT ||
       smp_scheduler_active_ap_count() == 0 { return false; }
    if !userspace_loader_start_fault_probe_on_cpu(USERSPACE_MIGRATION_CPU_SLOT) {
        return false;
    }
    let apic_id = smp_cpu_apic_id(USERSPACE_MIGRATION_CPU_SLOT);
    if !lapic_send_fixed(apic_id, IRQ_VECTOR_RESCHEDULE_IPI as u8) { return false; }
    if !userspace_loader_wait_fault_probe() || !userspace_loader_finish_fault_probe() {
        return false;
    }
    return userspace_loader_emit_ap_fault_isolation_marker();
}

@system
fn userspace_migration_wait_ap(thread_id: u64, root: u64) -> bool {
    if thread_id == 0 || root == 0 { return false; }
    let mut spins: u64 = 0;
    while spins < SCHEDULER_ROUND_TRIP_SPIN_LIMIT {
        __dma_fence();
        if scheduler_thread_owner_cpu(thread_id) == USERSPACE_MIGRATION_CPU_SLOT as u32 &&
           scheduler_thread_affinity_cpu(thread_id) == USERSPACE_MIGRATION_CPU_SLOT as u32 &&
           tlb_shootdown_cpu_root(USERSPACE_MIGRATION_CPU_SLOT) == root {
            return true;
        }
        x86_cpu_pause();
        spins += 1;
    }
    return false;
}

@system
fn userspace_migration_wait_result(passed_address: u64, failed_address: u64) -> bool {
    if passed_address == 0 || failed_address == 0 { return false; }
    let mut spins: u64 = 0;
    while spins < SCHEDULER_ROUND_TRIP_SPIN_LIMIT {
        __dma_fence();
        if x86_mmio_read32(failed_address) != 0 { return false; }
        if x86_mmio_read32(passed_address) == 1 { return true; }
        x86_cpu_pause();
        spins += 1;
    }
    return false;
}

@system
fn userspace_migration_wait_reaped(pid: u64, reap_before: u64) -> bool {
    if pid == 0 { return false; }
    let mut spins: u64 = 0;
    while spins < SCHEDULER_ROUND_TRIP_SPIN_LIMIT {
        __dma_fence();
        if process_reference_count(pid) == 0 && scheduler_reap_count() > reap_before {
            return true;
        }
        x86_cpu_pause();
        spins += 1;
    }
    return false;
}

@system
fn userspace_emit_migration_markers() -> bool {
    let migrated: [u8; 27] = [
        66,65,75,69,78,58,83,77,80,95,80,82,79,67,69,83,83,95,77,73,71,82,65,84,69,68,10
    ];
    let fpu: [u8; 30] = [
        66,65,75,69,78,58,83,77,80,95,70,80,85,95,77,73,71,82,65,84,73,79,78,95,82,69,65,68,89,10
    ];
    return userspace_emit(&migrated[0], 27) && userspace_emit(&fpu[0], 30);
}

@system
pub fn userspace_loader_run_migration_probe() -> bool {
    userspace_migration_diag(1);
    unsafe { if !USERSPACE_FINISHED || USERSPACE_PID != 0 { return false; } }
    if smp_runtime_ap_count() == 0 { return true; }
    if USERSPACE_MIGRATION_CPU_SLOT >= SCHEDULER_CPU_SLOT_COUNT ||
       smp_scheduler_active_ap_count() == 0 { return false; }

    let pid = process_create();
    if pid == 0 { return false; }
    userspace_migration_diag(2);
    let code = pmm_alloc_page();
    let data = pmm_alloc_page();
    let stack = pmm_alloc_page();
    if code == 0 || data == 0 || stack == 0 {
        userspace_release_frames(code, data, stack);
        process_destroy(pid);
        return false;
    }
    if !userspace_zero_frame(code) || !userspace_zero_frame(data) ||
       !userspace_zero_frame(stack) ||
       !userspace_materialize_migration_probe(code, data) {
        userspace_release_frames(code, data, stack);
        process_destroy(pid);
        return false;
    }
    if !process_map_user_page(pid, USERSPACE_CODE_ADDRESS, code, false, true) ||
       !process_map_user_page(pid, USERSPACE_DATA_ADDRESS, data, true, false) ||
       !process_map_user_page(pid, USERSPACE_STACK_ADDRESS, stack, true, false) {
        userspace_teardown_mapping(pid, code, data, stack);
        return false;
    }
    if process_user_pte(pid, USERSPACE_STACK_GUARD) != 0 {
        userspace_teardown_mapping(pid, code, data, stack);
        return false;
    }
    userspace_migration_diag(3);

    let data_virtual = direct_map_virtual_address(data);
    if data_virtual == 0 {
        userspace_teardown_mapping(pid, code, data, stack);
        return false;
    }
    let started_address = data_virtual + USERSPACE_MIGRATION_STARTED_OFFSET;
    let release_address = data_virtual + USERSPACE_MIGRATION_RELEASE_OFFSET;
    let passed_address = data_virtual + USERSPACE_MIGRATION_PASSED_OFFSET;
    let failed_address = data_virtual + USERSPACE_MIGRATION_FAILED_OFFSET;
    x86_mmio_write32(started_address, 0);
    x86_mmio_write32(release_address, 0);
    x86_mmio_write32(passed_address, 0);
    x86_mmio_write32(failed_address, 0);
    __dma_fence();

    // process_borrow_root() exige uma referência viva. O probe adquire uma
    // referência temporária própria; a process thread adquirirá a referência de
    // scheduler e, após a criação, esta referência temporária é descartada.
    if !process_retain(pid) {
        userspace_teardown_mapping(pid, code, data, stack);
        return false;
    }
    let root = process_borrow_root(pid);
    let entry = __userspace_bootstrap_entry_address();
    if root == 0 || entry == 0 {
        if !process_release(pid) { loop { x86_cpu_pause(); } }
        userspace_teardown_mapping(pid, code, data, stack);
        return false;
    }
    unsafe { USERSPACE_PID = pid; }
    let tid = scheduler_create_process_thread(pid, entry, SCHEDULER_DEFAULT_THREAD_STACK_PAGES);
    if tid == 0 {
        unsafe { USERSPACE_PID = 0; }
        if !process_release(pid) { loop { x86_cpu_pause(); } }
        userspace_teardown_mapping(pid, code, data, stack);
        return false;
    }
    // A partir daqui a referência da thread mantém a address space viva.
    if !process_release(pid) { loop { x86_cpu_pause(); } }
    unsafe { USERSPACE_TID = tid; }
    if scheduler_thread_affinity_cpu(tid) != 0 { return false; }
    userspace_migration_diag(4);

    let reap_before = scheduler_reap_count();
    let mut handoffs: u64 = 0;
    let mut repinned = false;
    while handoffs < SCHEDULER_ROUND_TRIP_SPIN_LIMIT && !repinned {
        if !scheduler_yield() { return false; }
        let flags = x86_irq_save_disable();
        if x86_mmio_read32(started_address) == 1 {
            repinned = scheduler_set_thread_affinity(tid, USERSPACE_MIGRATION_CPU_SLOT);
        }
        x86_irq_restore(flags);
        // `started == 1` pode ser observado enquanto a thread ainda pertence ao
        // BSP. Nesse caso o repin deve falhar atomicamente e ser repetido depois
        // de outro yield, quando o timer a devolver a READY/unowned. Contenção
        // transitória não é falha do contrato de migração.
        if repinned { break; }
        handoffs += 1;
    }
    if !repinned ||
       scheduler_thread_affinity_cpu(tid) != USERSPACE_MIGRATION_CPU_SLOT as u32 ||
       scheduler_thread_owner_cpu(tid) != SCHEDULER_CPU_NONE { return false; }
    userspace_migration_diag(5);

    let apic_id = smp_cpu_apic_id(USERSPACE_MIGRATION_CPU_SLOT);
    if !lapic_send_fixed(apic_id, IRQ_VECTOR_RESCHEDULE_IPI as u8) { return false; }
    userspace_migration_diag(6);
    if !userspace_migration_wait_ap(tid, root) { return false; }
    userspace_migration_diag(7);

    x86_mmio_write32(release_address, 1);
    __dma_fence();
    if !userspace_migration_wait_result(passed_address, failed_address) { return false; }
    userspace_migration_diag(8);
    if !userspace_migration_wait_reaped(pid, reap_before) { return false; }
    userspace_migration_diag(9);
    if syscall_last_exit_code() != 0 { return false; }

    if !userspace_teardown_mapping(pid, code, data, stack) { return false; }
    unsafe {
        USERSPACE_PID = 0;
        USERSPACE_TID = 0;
    }
    userspace_migration_diag(10);
    return userspace_emit_migration_markers();
}
