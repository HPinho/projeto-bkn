// Registro SMP de processos: ownership das tabelas e lifetime por referências.
// PID 0 é reservado ao kernel. Não expõe cópias owning de ProcessAddressSpace.
// IRQ-off bloqueia reentrada local e o spinlock serializa BSP/APs.
module kernel::process::registry;

import kernel::process::address_space::*;
import kernel::arch::x86_64::cpu::*;
import kernel::arch::x86_64::paging::*;
import kernel::arch::x86_64::serial::*;
import kernel::memory::pmm_allocator::*;
import kernel::sync::spinlock::*;

pub const PROCESS_SLOT_COUNT: usize = 16;
pub const PROCESS_INVALID_SLOT: usize = PROCESS_SLOT_COUNT;
pub const PROCESS_ID_MAX: u64 = 0xFFFFFFFFFFFFFFFF;

static mut PROCESS_IDS: [u64; PROCESS_SLOT_COUNT] = [0; PROCESS_SLOT_COUNT];
static mut PROCESS_REFERENCES: [u64; PROCESS_SLOT_COUNT] = [0; PROCESS_SLOT_COUNT];
static mut PROCESS_SPACES: [ProcessAddressSpace; PROCESS_SLOT_COUNT] = [
    ProcessAddressSpace { table_base_physical: 0, root_physical: 0, user_pdpt_physical: 0,
        user_pd_physical: 0, user_pt_physical: 0, valid: false }; PROCESS_SLOT_COUNT
];
static mut PROCESS_NEXT_ID: u64 = 1;
static mut PROCESS_REGISTRY_READY: bool = false;

// Hierarquia obrigatória: PROCESS_REGISTRY_LOCK -> PMM_ALLOCATOR_LOCK.
// Criação/destruição de address spaces alcança o PMM sob este lock; o PMM não
// pode chamar o registro. Isso mantém lifetime, PID e page tables atômicos.
static mut PROCESS_REGISTRY_LOCK: SpinLock = SpinLock { state: 0 };
static mut PROCESS_REGISTRY_LOCK_READY: bool = false;

@system
fn process_registry_lock_irq() -> u64 {
    let flags = x86_irq_save_disable();
    unsafe {
        if !PROCESS_REGISTRY_LOCK_READY {
            x86_irq_restore(flags);
            return 0;
        }
        if !spinlock_lock(&mut PROCESS_REGISTRY_LOCK) {
            x86_irq_restore(flags);
            return 0;
        }
    }
    return flags;
}

@system
fn process_registry_unlock_irq(flags: u64) -> void {
    let mut released = false;
    unsafe { released = spinlock_unlock(&mut PROCESS_REGISTRY_LOCK); }
    if !released { loop { x86_cpu_pause(); } }
    x86_irq_restore(flags);
}

@system
fn process_find_locked(pid: u64) -> usize {
    if pid == 0 { return PROCESS_INVALID_SLOT; }
    unsafe {
        let mut slot: usize = 0;
        while slot < PROCESS_SLOT_COUNT {
            if PROCESS_IDS[slot] == pid { return slot; }
            slot += 1;
        }
    }
    return PROCESS_INVALID_SLOT;
}

@system
fn process_create_locked() -> u64 {
    unsafe {
        if PROCESS_NEXT_ID == 0 || PROCESS_NEXT_ID == PROCESS_ID_MAX { return 0; }
        let mut slot: usize = 0;
        while slot < PROCESS_SLOT_COUNT {
            if PROCESS_IDS[slot] == 0 {
                let space = process_address_space_create();
                if !process_address_space_valid(&space) { return 0; }
                let pid = PROCESS_NEXT_ID;
                PROCESS_NEXT_ID += 1;
                PROCESS_SPACES[slot] = space;
                PROCESS_REFERENCES[slot] = 0;
                PROCESS_IDS[slot] = pid;
                return pid;
            }
            slot += 1;
        }
    }
    return 0;
}

@system
fn process_destroy_locked(pid: u64) -> bool {
    let slot = process_find_locked(pid);
    if slot == PROCESS_INVALID_SLOT { return false; }
    unsafe {
        if PROCESS_REFERENCES[slot] != 0 { return false; }
        if !process_address_space_destroy(&mut PROCESS_SPACES[slot]) { return false; }
        PROCESS_IDS[slot] = 0;
    }
    return true;
}

@system
fn process_retain_locked(pid: u64) -> bool {
    let slot = process_find_locked(pid);
    if slot == PROCESS_INVALID_SLOT { return false; }
    unsafe {
        if PROCESS_REFERENCES[slot] == PROCESS_ID_MAX { return false; }
        PROCESS_REFERENCES[slot] += 1;
    }
    return true;
}

@system
fn process_release_locked(pid: u64) -> bool {
    let slot = process_find_locked(pid);
    if slot == PROCESS_INVALID_SLOT { return false; }
    unsafe {
        if PROCESS_REFERENCES[slot] == 0 { return false; }
        PROCESS_REFERENCES[slot] -= 1;
    }
    return true;
}

@system
pub fn process_create() -> u64 {
    let flags = process_registry_lock_irq();
    if flags == 0 { return 0; }
    let mut pid: u64 = 0;
    unsafe { if PROCESS_REGISTRY_READY { pid = process_create_locked(); } }
    process_registry_unlock_irq(flags);
    return pid;
}

@system
pub fn process_destroy(pid: u64) -> bool {
    let flags = process_registry_lock_irq();
    if flags == 0 { return false; }
    let mut result = false;
    unsafe { if PROCESS_REGISTRY_READY { result = process_destroy_locked(pid); } }
    process_registry_unlock_irq(flags);
    return result;
}

@system
pub fn process_retain(pid: u64) -> bool {
    let flags = process_registry_lock_irq();
    if flags == 0 { return false; }
    let mut result = false;
    unsafe { if PROCESS_REGISTRY_READY { result = process_retain_locked(pid); } }
    process_registry_unlock_irq(flags);
    return result;
}

@system
pub fn process_release(pid: u64) -> bool {
    let flags = process_registry_lock_irq();
    if flags == 0 { return false; }
    let mut result = false;
    unsafe { if PROCESS_REGISTRY_READY { result = process_release_locked(pid); } }
    process_registry_unlock_irq(flags);
    return result;
}

@system
pub fn process_borrow_root(pid: u64) -> u64 {
    let flags = process_registry_lock_irq();
    if flags == 0 { return 0; }
    let slot = process_find_locked(pid);
    let mut root: u64 = 0;
    unsafe {
        if slot != PROCESS_INVALID_SLOT && PROCESS_REFERENCES[slot] != 0 {
            root = PROCESS_SPACES[slot].root_physical;
        }
    }
    process_registry_unlock_irq(flags);
    return root;
}

@system
pub fn process_reference_count(pid: u64) -> u64 {
    let flags = process_registry_lock_irq();
    if flags == 0 { return 0; }
    let slot = process_find_locked(pid);
    let mut count: u64 = 0;
    unsafe { if slot != PROCESS_INVALID_SLOT { count = PROCESS_REFERENCES[slot]; } }
    process_registry_unlock_irq(flags);
    return count;
}

@system
pub fn process_current_id() -> u64 {
    let root = x86_read_cr3_raw() & X86_PAGE_ADDRESS_MASK;
    let flags = process_registry_lock_irq();
    if flags == 0 { return 0; }
    let mut pid: u64 = 0;
    unsafe {
        let mut slot: usize = 0;
        while slot < PROCESS_SLOT_COUNT {
            if PROCESS_IDS[slot] != 0 && PROCESS_SPACES[slot].valid &&
               PROCESS_SPACES[slot].root_physical == root {
                pid = PROCESS_IDS[slot];
                break;
            }
            slot += 1;
        }
    }
    process_registry_unlock_irq(flags);
    return pid;
}

@system
pub fn process_user_pte(pid: u64, address: u64) -> u64 {
    let flags = process_registry_lock_irq();
    if flags == 0 { return 0; }
    let slot = process_find_locked(pid);
    let mut pte: u64 = 0;
    unsafe {
        if slot != PROCESS_INVALID_SLOT {
            pte = process_address_space_user_pte(&PROCESS_SPACES[slot], address);
        }
    }
    process_registry_unlock_irq(flags);
    return pte;
}

@system
pub fn process_map_user_page(pid: u64, address: u64, physical: u64,
                             writable: bool, executable: bool) -> bool {
    let flags = process_registry_lock_irq();
    if flags == 0 { return false; }
    let slot = process_find_locked(pid);
    let mut result = false;
    unsafe {
        if slot != PROCESS_INVALID_SLOT {
            result = process_address_space_map_user_page(&mut PROCESS_SPACES[slot], address,
                                                         physical, writable, executable);
        }
    }
    process_registry_unlock_irq(flags);
    return result;
}

@system
pub fn process_unmap_user_page(pid: u64, address: u64) -> u64 {
    let flags = process_registry_lock_irq();
    if flags == 0 { return 0; }
    let slot = process_find_locked(pid);
    let mut physical: u64 = 0;
    unsafe {
        if slot != PROCESS_INVALID_SLOT {
            physical = process_address_space_unmap_user_page(&mut PROCESS_SPACES[slot], address);
        }
    }
    process_registry_unlock_irq(flags);
    return physical;
}

@system
fn process_registry_self_test_locked() -> bool {
    let before = pmm_allocator_allocated_pages();
    let mut ids: [u64; PROCESS_SLOT_COUNT] = [0; PROCESS_SLOT_COUNT];
    let mut slot: usize = 0;
    let mut passed = true;
    while slot < PROCESS_SLOT_COUNT {
        ids[slot] = process_create_locked();
        if ids[slot] == 0 { passed = false; break; }
        if slot > 0 && ids[slot] <= ids[slot - 1] { passed = false; }
        slot += 1;
    }
    let unexpected = process_create_locked();
    if unexpected != 0 { passed = false; process_destroy_locked(unexpected); }
    if passed {
        let first = ids[0];
        if process_release_locked(first) { passed = false; }
        if !process_retain_locked(first) { passed = false; }
        if process_destroy_locked(first) { passed = false; }
        if !process_release_locked(first) { passed = false; }
        if !process_destroy_locked(first) { passed = false; }
        ids[0] = process_create_locked();
        if ids[0] == 0 || ids[0] <= ids[PROCESS_SLOT_COUNT - 1] { passed = false; }
        if process_retain_locked(first) || process_release_locked(first) || process_destroy_locked(first) { passed = false; }
        if process_retain_locked(0) || process_destroy_locked(0) { passed = false; }
    }
    slot = 0;
    while slot < PROCESS_SLOT_COUNT {
        if ids[slot] != 0 && !process_destroy_locked(ids[slot]) { passed = false; }
        slot += 1;
    }
    return passed && pmm_allocator_allocated_pages() == before;
}

@system
pub fn process_registry_activate() -> bool {
    if !process_address_space_is_ready() { return false; }
    let flags = x86_irq_save_disable();
    unsafe {
        if !PROCESS_REGISTRY_LOCK_READY {
            if !spinlock_init(&mut PROCESS_REGISTRY_LOCK) {
                x86_irq_restore(flags);
                return false;
            }
            PROCESS_REGISTRY_LOCK_READY = true;
        }
        if !spinlock_lock(&mut PROCESS_REGISTRY_LOCK) {
            x86_irq_restore(flags);
            return false;
        }
        if PROCESS_REGISTRY_READY {
            spinlock_unlock(&mut PROCESS_REGISTRY_LOCK);
            x86_irq_restore(flags);
            return true;
        }
    }
    let passed = process_registry_self_test_locked();
    unsafe { PROCESS_REGISTRY_READY = passed; }
    unsafe { spinlock_unlock(&mut PROCESS_REGISTRY_LOCK); }
    x86_irq_restore(flags);
    return passed;
}

@system
pub fn process_registry_emit_ready_marker() -> bool {
    let flags = process_registry_lock_irq();
    if flags == 0 { return false; }
    let mut ready = false;
    unsafe { ready = PROCESS_REGISTRY_READY; }
    process_registry_unlock_irq(flags);
    if !ready { return false; }
    let marker: [u8; 29] = [
        66,65,75,69,78,58,80,82,79,67,69,83,83,95,82,69,71,73,83,84,82,89,95,82,69,65,68,89,10
    ];
    let mut index: usize = 0;
    while index < 29 {
        if !x86_serial_write_byte(marker[index]) { return false; }
        index += 1;
    }
    return true;
}
