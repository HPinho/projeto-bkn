// Baken OS - Driver Gráfico Direto no Framebuffer em BKN (@system)

module kernel::framebuffer;

static mut FB_BASE: *mut u32 = 0 as *mut u32;
static mut FB_WIDTH: u32 = 0;
static mut FB_HEIGHT: u32 = 0;
static mut FB_PITCH: u32 = 0;

@system
pub fn fb_init(base: *mut u32, width: u32, height: u32, pitch: u32) {
    unsafe {
        FB_BASE = base;
        FB_WIDTH = width;
        FB_HEIGHT = height;
        FB_PITCH = pitch;
    }
}

@system
pub fn fb_put_pixel(x: u32, y: u32, color: u32) {
    unsafe {
        if x < FB_WIDTH && y < FB_HEIGHT {
            let offset = (y * FB_PITCH + x) as usize;
            *FB_BASE.add(offset) = color;
        }
    }
}

@system
pub fn fb_clear(color: u32) {
    unsafe {
        let total_pixels = (FB_HEIGHT * FB_PITCH) as usize;
        for i in 0..total_pixels {
            *FB_BASE.add(i) = color;
        }
    }
}

@system
pub fn fb_draw_rect(x: u32, y: u32, w: u32, h: u32, color: u32) {
    for py in y..(y + h) {
        for px in x..(x + w) {
            fb_put_pixel(px, py, color);
        }
    }
}

// Renderizador de Caracteres 8x16 Bitmap Font
@system
pub fn fb_draw_char(x: u32, y: u32, c: char, color: u32) {
    // Matriz simples para blocos de caracteres ASCII
    let ascii_code = c as u32;
    for row in 0..16 {
        for col in 0..8 {
            // Desenha contorno ou preenchimento básico
            if (row == 0 || row == 15 || col == 0 || col == 7) && ascii_code != 32 {
                fb_put_pixel(x + col, y + row, color);
            }
        }
    }
}

@system
pub fn fb_draw_string(x: u32, y: u32, text: &str, color: u32) {
    let mut cursor_x = x;
    for c in text.chars() {
        fb_draw_char(cursor_x, y, c, color);
        cursor_x += 10;
    }
}
