// Baken OS - Kernel Principal Escrito Nativamente em BKN (@system)
// Zero dependencia de codigo C legado, Unix ou POSIX.

module kernel::main;

import libbkn::core::*;
import libbkn::crypto::*;
import kernel::hal_x86_64::*;
import kernel::pmm::*;
import kernel::vmm::*;
import kernel::scheduler::*;
import kernel::ipc::*;
import kernel::qhal::*;
import kernel::bakenfs::*;
import kernel::pci::*;
import kernel::rtc::*;
import kernel::cpu_info::*;
import kernel::acpi::*;
import kernel::xhci::*;
import kernel::panic::*;
import kernel::shell_cli::*;
import kernel::bkn_exec_loader::*;
import kernel::apic::*;
import kernel::peripherals::*;
import kernel::mouse::*;
import kernel::nvme::*;
import kernel::audio::*;
import kernel::graphics_engine::*;
import kernel::baken3d::*;
import kernel::bakenvm::*;
import kernel::bakendb::*;
import kernel::baken_p2p::*;
import kernel::baken_ui::*;
import kernel::window_manager::*;
import kernel::desktop_shell::*;

// Estrutura de Informações de Inicialização repassada pelo Bootloader UEFI
pub struct BakenBootInfo {
    pub framebuffer_base: *mut u32,
    pub framebuffer_size: usize,
    pub screen_width: u32,
    pub screen_height: u32,
    pub pixels_per_scanline: u32,
    pub memory_map_base: *const u8,
    pub memory_map_size: usize,
    pub memory_descriptor_size: usize,
}

// Entry Point Mestre do Microkernel Baken no Ring 0
@system
@export
pub fn baken_kernel_main(boot_info: *const BakenBootInfo) -> ! {
    // 1. Inicializa o Motor Grafico Linear no Framebuffer GOP
    gfx_init(
        (*boot_info).framebuffer_base,
        (*boot_info).screen_width,
        (*boot_info).screen_height,
        (*boot_info).pixels_per_scanline
    );

    // 2. Inicializa o HAL (GDT, IDT, APIC)
    hal_init_cpu();

    // 3. Inicializa Gerenciador de Memoria Fisica (Buddy Allocator)
    pmm_init(0x1000000, 1024 * 1024 * 1024); // 1GB inicial

    // 4. Inicializa Gerenciador de Memoria Virtual (Paginacao de 4 Niveis)
    vmm_init();

    // 5. Varredura Real de Barramento PCI/PCIe (Descobre Hardware Real e BARs)
    pci_scan_all_buses();

    // 6. Inicializa Relógio Real de Hardware da Placa-Mãe (CMOS/RTC)
    rtc_init();

    // 7. Identificação Real de Processador (CPUID & Sensores Térmicos)
    cpu_info_init();

    // 8. Parser de Tabelas ACPI e Telemetria Real de Energia/Bateria
    acpi_init(0);

    // 9. Inicializa Subsistema de Perifericos e Entrada (Mouse & Teclado)
    peripherals_init();
    mouse_init((*boot_info).screen_width as i32 / 2, (*boot_info).screen_height as i32 / 2);

    // 10. Inicializa Controlador Host USB 3.0 Real (xHCI)
    xhci_init(0);

    // 11. Inicializa Controlador NVMe de Armazenamento com BAR0 Descoberto via PCI
    nvme_init(pci_get_nvme_bar0());

    // 12. Inicializa Subsistema de Audio Intel HDA com BAR0 Descoberto via PCI
    audio_init(pci_get_hda_bar0());
    audio_play_startup_chime();

    // 13. Inicializa Barramento IPC por Capacidades
    ipc_init();

    // 14. Inicializa Simulador Vetorial Quantico Q-HAL
    qhal_init();

    // 15. Inicializa o Sistema de Arquivos BakenFS
    bakenfs_init();

    // 11. Inicializa Motor Gráfico 3D (Baken3D) e Z-Buffer
    baken3d_init((*boot_info).screen_width, (*boot_info).screen_height);

    // 12. Inicializa Hypervisor Nativo (BakenVM)
    bakenvm_init();

    // 13. Inicializa Banco de Dados Embutido ACID (BakenDB)
    bakendb_init();

    // 14. Inicializa Rede P2P Descentralizada (BakenCloud)
    baken_p2p_init();

    // 15. Inicializa Framework Declarativo BakenUI
    baken_ui_init();

    // 16. Inicializa o Temporizador de Alta Resolução APIC Local (1000 Hz)
    lapic_init();

    // 17. Inicializa o Interpretador de Comandos do Baken Shell CLI
    shell_cli_init();

    // 18. Inicializa o Gerenciador de Janelas e Composicao
    wm_init();

    // 19. Inicializa o Desktop Shell Soberano (Top bar, Dock, Widgets, Icons)
    desktop_shell_init((*boot_info).screen_width, (*boot_info).screen_height);

    // 10. Registra e Inicia o Escalonador Preemptivo Hibrido
    scheduler_init();

    // Cria a thread de composicao grafica do desktop
    scheduler_create_thread(
        b"desktop_compositor\0".as_ptr(),
        desktop_shell_render_frame as u64,
        PriorityLevel::High,
        8192
    );

    // Loop de Execucao do Kernel
    loop {
        desktop_shell_render_frame();
        scheduler_yield();
    }
}
