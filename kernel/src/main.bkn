// Baken OS - Kernel Principal Escrito Nativamente em BKN (@system)
// Zero dependencia de codigo C legado, Unix ou POSIX.

module kernel::main;

import libbkn::core::*;
import libbkn::crypto::*;
import kernel::hal_x86_64::*;
import kernel::pmm::*;
import kernel::vmm::*;
import kernel::scheduler::*;
import kernel::ipc::*;
import kernel::qhal::*;
import kernel::bakenfs::*;
import kernel::pci::*;
import kernel::rtc::*;
import kernel::cpu_info::*;
import kernel::acpi::*;
import kernel::xhci::*;
import kernel::panic::*;
import kernel::shell_cli::*;
import kernel::bkn_exec_loader::*;
import kernel::apic::*;
import kernel::sata_ahci::*;
import kernel::block_dev::*;
import kernel::toast_notification::*;
import kernel::baken_auth::*;
import kernel::vector_font::*;
import kernel::peripherals::*;
import kernel::mouse::*;
import kernel::nvme::*;
import kernel::audio::*;
import kernel::graphics_engine::*;
import kernel::baken3d::*;
import kernel::bakenvm::*;
import kernel::bakendb::*;
import kernel::baken_p2p::*;
import kernel::baken_ui::*;
import kernel::splash_screen::*;
import kernel::boot_manager::*;
import kernel::control_center::*;
import kernel::kernel_selftest::*;
import kernel::window_manager::*;
import kernel::desktop_shell::*;

// Estrutura de Informações de Inicialização repassada pelo Bootloader UEFI
pub struct BakenBootInfo {
    pub framebuffer_base: *mut u32,
    pub framebuffer_size: usize,
    pub screen_width: u32,
    pub screen_height: u32,
    pub pixels_per_scanline: u32,
    pub memory_map_base: *const u8,
    pub memory_map_size: usize,
    pub memory_descriptor_size: usize,
}

// Entry Point Mestre do Microkernel Baken no Ring 0
@system
@export
pub fn baken_kernel_main(boot_info: *const BakenBootInfo) -> ! {
    // 1. Inicializa o Motor Grafico Linear no Framebuffer GOP
    gfx_init(
        (*boot_info).framebuffer_base,
        (*boot_info).screen_width,
        (*boot_info).screen_height,
        (*boot_info).pixels_per_scanline
    );

    // 2. Inicia Tela de Carregamento Ultra-Moderna (Splash Screen)
    splash_screen_init((*boot_info).screen_width, (*boot_info).screen_height);

    // 3. Inicializa o HAL (GDT, IDT, APIC) e PMM
    splash_screen_render_step(10, b"Inicializando HAL x86_64 e Memoria Fisica PMM (Buddy Allocator)...\0".as_ptr());
    hal_init_cpu();
    pmm_init(0x1000000, 1024 * 1024 * 1024); // 1GB inicial

    // 4. Inicializa Gerenciador de Memoria Virtual (Paginacao de 4 Niveis)
    splash_screen_render_step(25, b"Configurando Espaco de Enderecamento Virtual VMM (PML4)...\0".as_ptr());
    vmm_init();

    // 5. Varredura Real de Barramento PCI/PCIe
    splash_screen_render_step(40, b"Varrendo Barramento PCI/PCIe e detectando discos NVMe/SATA...\0".as_ptr());
    pci_scan_all_buses();

    // 6. Inicializa Relógio Real de Hardware e ACPI
    splash_screen_render_step(55, b"Inicializando Relogio RTC e tabelas ACPI da placa-mae...\0".as_ptr());
    rtc_init();
    cpu_info_init();
    acpi_init(0);

    // 7. Inicializa Subsistema de Entrada e Controladores de Armazenamento
    splash_screen_render_step(70, b"Inicializando Controladores NVMe, SATA AHCI e Audio Intel HDA...\0".as_ptr());
    peripherals_init();
    mouse_init((*boot_info).screen_width as i32 / 2, (*boot_info).screen_height as i32 / 2);
    xhci_init(0);
    nvme_init(pci_get_nvme_bar0());
    ahci_init(0xFEB80000);
    block_dev_init();
    auth_init();
    toast_init();
    audio_init(pci_get_hda_bar0());

    // 8. Inicializa BakenFS, 3D Engine e Q-HAL
    splash_screen_render_step(85, b"Carregando Sistema de Arquivos BakenFS e Motor Grafico Baken3D...\0".as_ptr());
    ipc_init();
    qhal_init();
    bakenfs_init();
    baken3d_init((*boot_info).screen_width, (*boot_info).screen_height);
    bakenvm_init();
    bakendb_init();
    baken_p2p_init();
    baken_ui_init();

    // 9. Executa Suíte de Auto-Testes Integrada do Kernel
    splash_screen_render_step(90, b"Executando Auto-Testes de Integridade (PMM, VMM, BakenFS, Q-HAL)...\0".as_ptr());
    kernel_run_all_selftests();

    // 10. Inicializa o Temporizador APIC Local e CLI
    splash_screen_render_step(95, b"Iniciando Temporizador APIC Local e Interpretador Shell CLI...\0".as_ptr());
    lapic_init();
    shell_cli_init();
    wm_init();

    // 11. Conclui Boot e Carrega Desktop Shell Soberano
    splash_screen_render_step(100, b"Iniciando Desktop Shell Soberano...\0".as_ptr());
    desktop_shell_init((*boot_info).screen_width, (*boot_info).screen_height);

    // 11. Registra e Inicia o Escalonador Preemptivo Hibrido
    scheduler_init();

    // Cria a thread de composicao grafica do desktop
    scheduler_create_thread(
        b"desktop_compositor\0".as_ptr(),
        desktop_shell_render_frame as u64,
        PriorityLevel::High,
        8192
    );

    // Toca som de inicialização do SO
    audio_play_startup_chime();

    // Loop de Execucao do Kernel
    loop {
        desktop_shell_render_frame();
        scheduler_yield();
    }
}
