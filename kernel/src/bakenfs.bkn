// Baken OS - Sistema de Arquivos BakenFS em BKN Puro (@system)
// Sistema de Arquivos Estruturado em Extents e Inodes com Integridade Merkle

module kernel::bakenfs;

import kernel::pmm::*;

pub const BAKENFS_MAGIC: u64 = 0x3153464E4B427F; // \x7fBKNFS01
pub const BLOCK_SIZE: usize  = 4096;
pub const MAX_INODES: usize  = 512;
pub const DIRECT_BLOCKS_COUNT: usize = 12;

pub enum FileType {
    Regular = 1,
    Directory = 2,
    Executable = 3,
    QuantumCircuit = 4,
    DeviceNode = 5,
}

pub struct Inode {
    pub id: u64,
    pub file_type: FileType,
    pub permissions: u16, // rwxrwxrwx
    pub size_bytes: u64,
    pub created_time: u64,
    pub modified_time: u64,
    pub direct_blocks: [u64; DIRECT_BLOCKS_COUNT],
    pub indirect_block: u64,
    pub integrity_hash: [u8; 32],
    pub name: [u8; 64],
    pub is_allocated: bool,
}

pub struct SuperBlock {
    pub magic: u64,
    pub version: u32,
    pub block_size: u32,
    pub total_blocks: u64,
    pub free_blocks: u64,
    pub inode_count: u64,
    pub root_inode_id: u64,
    pub block_bitmap_start: u64,
    pub inode_table_start: u64,
    pub data_blocks_start: u64,
}

pub struct FileHandle {
    pub inode_id: u64,
    pub seek_pos: u64,
    pub flags: u32,
    pub is_open: bool,
}

static mut SUPERBLOCK: SuperBlock = SuperBlock {
    magic: BAKENFS_MAGIC,
    version: 0x00010000,
    block_size: 4096,
    total_blocks: 65536, // 256MB
    free_blocks: 65000,
    inode_count: 0,
    root_inode_id: 1,
    block_bitmap_start: 1,
    inode_table_start: 10,
    data_blocks_start: 100,
};

static mut INODE_TABLE: [Inode; MAX_INODES] = [Inode {
    id: 0,
    file_type: FileType::Regular,
    permissions: 0o644,
    size_bytes: 0,
    created_time: 0,
    modified_time: 0,
    direct_blocks: [0; DIRECT_BLOCKS_COUNT],
    indirect_block: 0,
    integrity_hash: [0; 32],
    name: [0; 64],
    is_allocated: false,
}; MAX_INODES];

static mut OPEN_FILES: [FileHandle; 64] = [FileHandle {
    inode_id: 0,
    seek_pos: 0,
    flags: 0,
    is_open: false,
}; 64];

@system
pub fn bakenfs_init() {
    unsafe {
        SUPERBLOCK.inode_count = 0;

        for i in 0..MAX_INODES {
            INODE_TABLE[i].is_allocated = false;
        }

        for i in 0..64 {
            OPEN_FILES[i].is_open = false;
        }

        // Cria estrutura basica de arquivos e diretorios
        bakenfs_create_file(b"root\0".as_ptr(), FileType::Directory, 0o755);
        bakenfs_create_file(b"kernel_core.bkn\0".as_ptr(), FileType::Regular, 0o644);
        bakenfs_create_file(b"quantum_teleport.bkn\0".as_ptr(), FileType::QuantumCircuit, 0o644);
        bakenfs_create_file(b"bknc.bkn_exec\0".as_ptr(), FileType::Executable, 0o755);
        bakenfs_create_file(b"libbkn.a\0".as_ptr(), FileType::Regular, 0o644);
    }
}

@system
pub fn bakenfs_create_file(name_ptr: *const u8, ftype: FileType, perms: u16) -> u64 {
    unsafe {
        // Encontra inode livre
        let mut slot_idx: usize = MAX_INODES;
        for i in 0..MAX_INODES {
            if !INODE_TABLE[i].is_allocated {
                slot_idx = i;
                break;
            }
        }

        if slot_idx == MAX_INODES {
            return 0; // Tabela de inodes cheia
        }

        let inode = &mut INODE_TABLE[slot_idx];
        let new_id = (slot_idx + 1) as u64;

        inode.id = new_id;
        inode.file_type = ftype;
        inode.permissions = perms;
        inode.size_bytes = 0;
        inode.created_time = 1000;
        inode.modified_time = 1000;
        inode.is_allocated = true;

        for i in 0..DIRECT_BLOCKS_COUNT {
            inode.direct_blocks[i] = 0;
        }
        inode.indirect_block = 0;

        // Copia nome
        let mut i: usize = 0;
        while i < 63 {
            let ch = *name_ptr.add(i);
            if ch == 0 { break; }
            inode.name[i] = ch;
            i += 1;
        }
        inode.name[i] = 0;

        SUPERBLOCK.inode_count += 1;
        return new_id;
    }
}

@system
pub fn bakenfs_open(name_ptr: *const u8, flags: u32) -> i32 {
    unsafe {
        // Busca o inode correspondente ao nome
        let mut target_inode_id: u64 = 0;
        for i in 0..MAX_INODES {
            if INODE_TABLE[i].is_allocated {
                let mut match_found = true;
                let mut c: usize = 0;
                while c < 64 {
                    let ch1 = *name_ptr.add(c);
                    let ch2 = INODE_TABLE[i].name[c];
                    if ch1 != ch2 {
                        match_found = false;
                        break;
                    }
                    if ch1 == 0 { break; }
                    c += 1;
                }
                if match_found {
                    target_inode_id = INODE_TABLE[i].id;
                    break;
                }
            }
        }

        if target_inode_id == 0 {
            return -1; // Arquivo nao encontrado
        }

        // Aloca file handle
        for i in 0..64 {
            if !OPEN_FILES[i].is_open {
                OPEN_FILES[i].inode_id = target_inode_id;
                OPEN_FILES[i].seek_pos = 0;
                OPEN_FILES[i].flags = flags;
                OPEN_FILES[i].is_open = true;
                return i as i32;
            }
        }

        return -2; // Limite de descritores de arquivo atingido
    }
}

@system
pub fn bakenfs_write(fd: i32, buffer: *const u8, count: usize) -> isize {
    unsafe {
        if fd < 0 || fd >= 64 || !OPEN_FILES[fd as usize].is_open {
            return -1;
        }

        let handle = &mut OPEN_FILES[fd as usize];
        let inode_idx = (handle.inode_id - 1) as usize;
        let inode = &mut INODE_TABLE[inode_idx];

        let mut bytes_written: usize = 0;

        while bytes_written < count {
            let block_index = (handle.seek_pos / (BLOCK_SIZE as u64)) as usize;
            let block_offset = (handle.seek_pos % (BLOCK_SIZE as u64)) as usize;

            if block_index >= DIRECT_BLOCKS_COUNT {
                break; // Limite de blocos diretos atingido
            }

            // Aloca bloco se necessario
            if inode.direct_blocks[block_index] == 0 {
                let new_page = pmm_alloc_pages(0);
                if new_page == (0 as *mut u8) { break; }
                inode.direct_blocks[block_index] = new_page as u64;
            }

            let dest_ptr = (inode.direct_blocks[block_index] as *mut u8).add(block_offset);
            let to_write = (BLOCK_SIZE - block_offset).min(count - bytes_written);

            for b in 0..to_write {
                *dest_ptr.add(b) = *buffer.add(bytes_written + b);
            }

            bytes_written += to_write;
            handle.seek_pos += to_write as u64;
            if handle.seek_pos > inode.size_bytes {
                inode.size_bytes = handle.seek_pos;
            }
        }

        return bytes_written as isize;
    }
}

@system
pub fn bakenfs_read(fd: i32, buffer: *mut u8, count: usize) -> isize {
    unsafe {
        if fd < 0 || fd >= 64 || !OPEN_FILES[fd as usize].is_open {
            return -1;
        }

        let handle = &mut OPEN_FILES[fd as usize];
        let inode_idx = (handle.inode_id - 1) as usize;
        let inode = &INODE_TABLE[inode_idx];

        if handle.seek_pos >= inode.size_bytes {
            return 0; // EOF
        }

        let available = (inode.size_bytes - handle.seek_pos) as usize;
        let bytes_to_read = count.min(available);
        let mut bytes_read: usize = 0;

        while bytes_read < bytes_to_read {
            let block_index = (handle.seek_pos / (BLOCK_SIZE as u64)) as usize;
            let block_offset = (handle.seek_pos % (BLOCK_SIZE as u64)) as usize;

            if block_index >= DIRECT_BLOCKS_COUNT || inode.direct_blocks[block_index] == 0 {
                break;
            }

            let src_ptr = (inode.direct_blocks[block_index] as *const u8).add(block_offset);
            let to_copy = (BLOCK_SIZE - block_offset).min(bytes_to_read - bytes_read);

            for b in 0..to_copy {
                *buffer.add(bytes_read + b) = *src_ptr.add(b);
            }

            bytes_read += to_copy;
            handle.seek_pos += to_copy as u64;
        }

        return bytes_read as isize;
    }
}

@system
pub fn bakenfs_close(fd: i32) -> bool {
    unsafe {
        if fd >= 0 && fd < 64 && OPEN_FILES[fd as usize].is_open {
            OPEN_FILES[fd as usize].is_open = false;
            return true;
        }
        return false;
    }
}

@system
pub fn bakenfs_get_inode(idx: usize) -> *const Inode {
    unsafe {
        if idx < MAX_INODES && INODE_TABLE[idx].is_allocated {
            return &INODE_TABLE[idx] as *const Inode;
        }
        return 0 as *const Inode;
    }
}
