module kernel::baken_animation;

pub struct SpringState {
    pub current_val: f32;
    pub target_val: f32;
    pub velocity: f32;
    pub stiffness: f32;
    pub damping: f32;
}

@system
pub fn spring_update(spring: *mut SpringState, dt: f32) -> void {
    if spring == (null as *mut SpringState) { return; }
    let safe_dt = if (dt > 0.05) { 0.05 } else if (dt < 0.001) { 0.001 } else { dt };
    unsafe {
        let force = -(*spring).stiffness * ((*spring).current_val - (*spring).target_val);
        let damping_force = -(*spring).damping * (*spring).velocity;
        let acceleration = force + damping_force;
        (*spring).velocity += acceleration * safe_dt;
        (*spring).current_val += (*spring).velocity * safe_dt;
    }
}

@system
pub fn ease_smooth_surface(t: f32) -> f32 {
    let safe_t = if t < 0.0 { 0.0 } else if t > 1.0 { 1.0 } else { t };
    return safe_t * safe_t * (3.0 - 2.0 * safe_t);
}

// Avaliador Analítico de Mola Apple (CASpringAnimation - QuartzCore/Metal)
// Modela rigidez=300.0, amortecimento=30.0 e massa=1.0 com disparo rápido,
// leve overshoot elástico (107-109%) e assentamento perfeito em 1.0 (settling duration).
@system
pub fn anim_caspring_f32(t: f32) -> f32 {
    if t <= 0.0 { return 0.0; }
    if t >= 1.0 { return 1.0; }

    let lut: [f32; 33] = [
        0.0, 0.1245, 0.2568, 0.3890, 0.5152, 0.6315, 0.7351, 0.8245,
        0.8994, 0.9600, 1.0073, 1.0424, 1.0669, 1.0823, 1.0902, 1.0921,
        1.0894, 1.0835, 1.0753, 1.0658, 1.0558, 1.0458, 1.0363, 1.0275,
        1.0197, 1.0130, 1.0074, 1.0028, 0.9993, 0.9967, 0.9949, 0.9937,
        1.0
    ];

    let scaled = t * 32.0;
    let idx = scaled as usize;
    if idx >= 32 { return 1.0; }
    let frac = scaled - (idx as f32);
    let v0 = lut[idx];
    let v1 = lut[idx + 1];
    return v0 + frac * (v1 - v0);
}

@system
pub fn anim_caspring_shift_i32(progress: u32, max_progress: u32, distance: i32) -> i32 {
    if max_progress == 0 { return 0; }
    let norm_t = (progress as f32) / (max_progress as f32);
    let spring_val = anim_caspring_f32(norm_t);
    let residual = 1.0 - spring_val;
    return (residual * (distance as f32)) as i32;
}

@system
pub fn calculate_dock_magnify(cursor_x: i32, icon_center_x: i32, radius: i32) -> f32 {
    let diff = if cursor_x > icon_center_x { cursor_x - icon_center_x } else { icon_center_x - cursor_x };
    if (diff >= radius || radius <= 0) {
        return 1.0;
    }
    let norm = (diff as f32) / (radius as f32);
    let factor = 1.0 - (norm * norm);
    return 1.0 + (0.35 * factor);
}

@system
pub fn anim_smoothstep_u8(val: u32, max_val: u32) -> u8 {
    if (val >= max_val || max_val == 0) { return 255; }
    let v = (val * 255) / max_val;
    let v2 = (v * v) / 255;
    let v3 = (v2 * (3 * 255 - 2 * v)) / (255 * 255);
    return if (v3 > 255) { 255 } else { v3 as u8 };
}

@system
pub fn anim_wave_i32(tick: u32, period: u32, amp: i32) -> i32 {
    if (period == 0 || amp == 0) { return 0; }
    let phase = tick % period;
    let half = period / 2;
    if (half == 0) { return 0; }
    if (phase < half) {
        let p = (phase * 255) / half;
        let s = anim_smoothstep_u8(p, 255) as i32;
        return ((s * 2 - 255) * amp) / 255;
    } else {
        let p = ((phase - half) * 255) / half;
        let s = anim_smoothstep_u8(p, 255) as i32;
        return ((255 - s * 2) * amp) / 255;
    }
}

@system
pub fn anim_breathe_alpha(tick: u32, period: u32, min_a: u8, max_a: u8) -> u8 {
    if (max_a <= min_a) { return min_a; }
    let diff = (max_a - min_a) as i32;
    let w = anim_wave_i32(tick, period, diff / 2);
    let mid = (min_a as i32) + (diff / 2);
    let res = mid + w;
    if (res < 0) { return 0; }
    if (res > 255) { return 255; }
    return res as u8;
}

@system
pub fn anim_orbit_cos(phase: u32, radius: i32) -> i32 {
    let cos_phase = (phase + 64) % 256;
    if (cos_phase < 128) {
        let p = (cos_phase * 255) / 128;
        let s = anim_smoothstep_u8(p, 255) as i32;
        return ((s * 2 - 255) * radius) / 255;
    } else {
        let p = ((cos_phase - 128) * 255) / 128;
        let s = anim_smoothstep_u8(p, 255) as i32;
        return ((255 - s * 2) * radius) / 255;
    }
}

@system
pub fn anim_orbit_sin(phase: u32, radius: i32) -> i32 {
    if (phase < 128) {
        let p = (phase * 255) / 128;
        let s = anim_smoothstep_u8(p, 255) as i32;
        return ((s * 2 - 255) * radius) / 255;
    } else {
        let p = ((phase - 128) * 255) / 128;
        let s = anim_smoothstep_u8(p, 255) as i32;
        return ((255 - s * 2) * radius) / 255;
    }
}

// Curva elástica com overshoot configurável (cards que "saltam" ao entrar).
// overshoot_pct: 5 = 5% de overshoot, 12 = 12%, etc.
@system
pub fn anim_elastic_overshoot(t: f32, overshoot_pct: u32) -> f32 {
    if t <= 0.0 { return 0.0; }
    if t >= 1.0 { return 1.0; }
    let base = anim_caspring_f32(t);
    let ov = (overshoot_pct as f32) / 100.0;
    // Amplifica o overshoot natural da CASpring proporcionalmente
    if base > 1.0 {
        return 1.0 + (base - 1.0) * (1.0 + ov * 3.0);
    }
    return base;
}

// Alpha e deslocamento para fade-in sequencial escalonado (staggered entry).
// tick: contador de animação atual
// duration: duração total do fade em ticks (ex: 18 = ~300ms a 60Hz)
// delay: delay deste item em ticks (ex: item 0=0, item 1=4, item 2=8...)
// Retorna alpha 0..255. Use com slide_y = (255 - alpha) * dist / 255.
@system
pub fn anim_fade_slide_alpha(tick: u32, duration: u32, delay: u32) -> u8 {
    if duration == 0 { return 255; }
    if tick < delay { return 0; }
    let elapsed = tick - delay;
    if elapsed >= duration { return 255; }
    let prog = anim_caspring_f32((elapsed as f32) / (duration as f32));
    let a = (prog * 255.0) as i32;
    return if a < 0 { 0 } else if a > 255 { 255 } else { a as u8 };
}

// Pulso de brilho suave cíclico para elementos interativos.
// Retorna alpha variando entre min_a e max_a com curva smooth.
@system
pub fn anim_pulse_glow(tick: u32, period: u32, min_a: u8, max_a: u8) -> u8 {
    if period == 0 || max_a <= min_a { return min_a; }
    let phase = tick % period;
    let half = period / 2;
    if half == 0 { return min_a; }
    let t = if phase < half {
        (phase as f32) / (half as f32)
    } else {
        1.0 - (((phase - half) as f32) / (half as f32))
    };
    let smooth = ease_smooth_surface(t);
    let range = (max_a - min_a) as f32;
    let result = (min_a as f32) + smooth * range;
    return if result < 0.0 { 0 } else if result > 255.0 { 255 } else { result as u8 };
}

// Variante de CASpring com bounce mais pronunciado para entrada de cards.
// Maior overshoot (~15%) e settling mais expressivo.
@system
pub fn anim_spring_bounce(t: f32) -> f32 {
    if t <= 0.0 { return 0.0; }
    if t >= 1.0 { return 1.0; }
    let lut: [f32; 17] = [
        0.0, 0.185, 0.420, 0.665, 0.870, 1.040, 1.150, 1.145,
        1.095, 1.040, 1.010, 0.990, 0.985, 0.992, 0.998, 1.000,
        1.0
    ];
    let scaled = t * 16.0;
    let idx = scaled as usize;
    if idx >= 16 { return 1.0; }
    let frac = scaled - (idx as f32);
    let v0 = lut[idx];
    let v1 = lut[idx + 1];
    return v0 + frac * (v1 - v0);
}

// Offset horizontal para efeito shimmer (faixa de luz que percorre um botão).
// Retorna posição normalizada 0..width do shimmer highlight.
@system
pub fn anim_shimmer_offset(tick: u32, period: u32, width: u32) -> u32 {
    if period == 0 || width == 0 { return 0; }
    let phase = tick % period;
    // A faixa percorre de -width/4 a width+width/4 para sair suavemente
    let total_travel = width + width / 2;
    let pos = (phase * total_travel) / period;
    if pos < width / 4 { return 0; }
    let adjusted = pos - width / 4;
    return if adjusted > width { width } else { adjusted };
}
