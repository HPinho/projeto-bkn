// Baken OS - Motor de Animação e Física em Sotlas (@system)
// Interpolação Bézier, Spring Physics para Dock Magnify e Transições de Janela

module kernel::baken_animation;

pub struct SpringState {
    pub current_val: f32;
    pub target_val: f32;
    pub velocity: f32;
    pub stiffness: f32;
    pub damping: f32;
}

pub struct DockIconAnim {
    pub scale: f32;
    pub glow_intensity: u8;
    pub bounce_offset: i16;
}

// Funcao auxiliar abs
@inline
fn abs_i32(x: i32) -> i32 {
    if (x < 0) { return -x; }
    return x;
}

@inline
pub fn animation_clamp01(t: f32) -> f32 {
    if (t < 0.0) { return 0.0; }
    if (t > 1.0) { return 1.0; }
    return t;
}

// Curva quintica com velocidade e aceleracao nulas nas duas extremidades.
// Evita o pequeno tranco visual que curvas apenas cubicas deixam no encontro.
@system
pub fn ease_smootherstep(t: f32) -> f32 {
    let x = animation_clamp01(t);
    return x * x * x * (x * (x * 6.0 - 15.0) + 10.0);
}

// Alias semantico usado por superficies, paineis e transicoes de tela.
@system
pub fn ease_smooth_surface(t: f32) -> f32 {
    return ease_smootherstep(t);
}

// Fluent Design Easing: Fast Out, Slow In (Entrada) - cubic-bezier(0, 0, 0, 1)
// Aproximação polinomial para t em [0, 1]
@system
pub fn ease_fast_out_slow_in(t: f32) -> f32 {
    let inv = 1.0 - animation_clamp01(t);
    return 1.0 - (inv * inv * inv * inv); // 1 - (1-t)^4 (Fricção forte no final)
}

// Fluent Design Easing: Slow Out, Fast In (Saída) - cubic-bezier(1, 0, 1, 1)
// Aproximação polinomial para t em [0, 1]
@system
pub fn ease_slow_out_fast_in(t: f32) -> f32 {
    let x = animation_clamp01(t);
    return x * x * x * x; // t^4 (Acelera rapidamente no final)
}

@system
pub fn spring_update(spring: *mut SpringState, dt: f32) -> f32 {
    unsafe {
        // Subpassos mantem a mola estavel em quadros atrasados no QEMU.
        let safe_dt = if (dt < 0.0) { 0.0 } else if (dt > 0.05) { 0.05 } else { dt };
        let step = safe_dt / 4.0;
        for mut i in 0..4 {
            let force = -(*spring).stiffness * ((*spring).current_val - (*spring).target_val);
            let damping_force = -(*spring).damping * (*spring).velocity;
            let acceleration = force + damping_force;
            (*spring).velocity += acceleration * step;
            (*spring).current_val += (*spring).velocity * step;
        }
        // Encerra a cauda subpixel da mola para evitar repinturas eternas e
        // tremor de um pixel perto do alvo.
        if (abs_i32((((*spring).target_val - (*spring).current_val) * 10000.0) as i32) <= 1 &&
            abs_i32(((*spring).velocity * 10000.0) as i32) <= 1) {
            (*spring).current_val = (*spring).target_val;
            (*spring).velocity = 0.0;
        }
        return (*spring).current_val;
    }
}

@system
pub fn calculate_dock_magnify(cursor_x: i32, icon_center_x: i32, max_radius: i32) -> f32 {
    let dist = abs_i32(cursor_x - icon_center_x);
    if (dist >= max_radius) {
        return 1.0;
    }
    let ratio = (max_radius - dist) as f32 / max_radius as f32;
    // Interpolação suave em sino (Gaussian Bell Curve aproximada)
    return 1.0 + (ratio * ratio * 0.45);
}
