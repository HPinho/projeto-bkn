// Baken OS - Subsistema de Periféricos Universais em BKN Puro (@system)
// Barramento Unificado de Eventos para USB 3/4 (XHCI), Bluetooth BLE, Touchpads e Teclados NKRO

module kernel::peripherals;

pub enum DeviceKind {
    MouseRel = 1,
    MouseAbs = 2,
    Keyboard = 3,
    Touchpad = 4,
    Gamepad  = 5,
}

pub struct UnifiedInputEvent {
    pub device_kind: DeviceKind,
    pub device_id: u8,
    pub buttons: u16,
    pub x: i32,
    pub y: i32,
    pub dx: i32,
    pub dy: i32,
    pub scroll: i16,
    pub keycode: u16,
    pub timestamp_ns: u64,
}

static mut EVENT_QUEUE: [UnifiedInputEvent; 64] = [UnifiedInputEvent {
    device_kind: DeviceKind::MouseRel,
    device_id: 0,
    buttons: 0,
    x: 0, y: 0, dx: 0, dy: 0,
    scroll: 0,
    keycode: 0,
    timestamp_ns: 0,
}; 64];

static mut QUEUE_HEAD: usize = 0;
static mut QUEUE_TAIL: usize = 0;

@system
pub fn peripherals_init() {
    unsafe {
        QUEUE_HEAD = 0;
        QUEUE_TAIL = 0;
    }
}

@system
pub fn peripherals_push_event(ev: UnifiedInputEvent) -> bool {
    unsafe {
        let next = (QUEUE_HEAD + 1) % 64;
        if next == QUEUE_TAIL {
            return false; // Fila cheia
        }
        EVENT_QUEUE[QUEUE_HEAD] = ev;
        QUEUE_HEAD = next;
        return true;
    }
}

@system
pub fn peripherals_pop_event(out_ev: &mut UnifiedInputEvent) -> bool {
    unsafe {
        if QUEUE_TAIL == QUEUE_HEAD {
            return false; // Fila vazia
        }
        *out_ev = EVENT_QUEUE[QUEUE_TAIL];
        QUEUE_TAIL = (QUEUE_TAIL + 1) % 64;
        return true;
    }
}
