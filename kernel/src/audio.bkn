// Baken OS - Subsistema de Audio e Multimidia em BKN Puro (@system)
// Driver Intel HD Audio & VirtIO Sound com DMA Ring Buffers e Sintetizador Harmônico

module kernel::audio;

import kernel::pmm::*;

pub const AUDIO_SAMPLE_RATE: u32 = 48000;
pub const AUDIO_CHANNELS: u8 = 2; // Stereo
pub const AUDIO_BUFFER_SAMPLES: usize = 2048;

// Estrutura de Entrada da Lista de Descritores de Buffer (BDL - Buffer Descriptor List)
pub struct HdaBdlEntry {
    pub buffer_phys_addr: u64,
    pub length_bytes: u32,
    pub flags: u32, // Bit 0: Interrupt on Completion (IOC)
}

pub struct AudioDevice {
    pub bar0_base: *mut u32,
    pub sample_rate: u32,
    pub channels: u8,
    pub volume: u8,
    pub is_playing: bool,
    pub bdl_phys: u64,
    pub dma_buf0_phys: u64,
    pub dma_buf1_phys: u64,
    pub dma_buf0_virt: *mut i16,
    pub dma_buf1_virt: *mut i16,
    pub active_buffer: u8,
}

static mut AUDIO_DEV: AudioDevice = AudioDevice {
    bar0_base: 0 as *mut u32,
    sample_rate: AUDIO_SAMPLE_RATE,
    channels: AUDIO_CHANNELS,
    volume: 85,
    is_playing: false,
    bdl_phys: 0,
    dma_buf0_phys: 0,
    dma_buf1_phys: 0,
    dma_buf0_virt: 0 as *mut i16,
    dma_buf1_virt: 0 as *mut i16,
    active_buffer: 0,
};

@system
pub fn audio_init(pci_bar0_phys: u64) {
    unsafe {
        AUDIO_DEV.bar0_base = pci_bar0_phys as *mut u32;

        // 1. Aloca BDL e buffers duplos de DMA (Order 0 = 4KB cada)
        let bdl_page = pmm_alloc_pages(0);
        let buf0_page = pmm_alloc_pages(0);
        let buf1_page = pmm_alloc_pages(0);

        AUDIO_DEV.bdl_phys = bdl_page as u64;
        AUDIO_DEV.dma_buf0_phys = buf0_page as u64;
        AUDIO_DEV.dma_buf1_phys = buf1_page as u64;
        AUDIO_DEV.dma_buf0_virt = buf0_page as *mut i16;
        AUDIO_DEV.dma_buf1_virt = buf1_page as *mut i16;

        let bdl = bdl_page as *mut HdaBdlEntry;
        // BDL Entry 0
        (*bdl).buffer_phys_addr = AUDIO_DEV.dma_buf0_phys;
        (*bdl).length_bytes = (AUDIO_BUFFER_SAMPLES * 2 * 2) as u32;
        (*bdl).flags = 1; // IOC

        // BDL Entry 1
        (*bdl.add(1)).buffer_phys_addr = AUDIO_DEV.dma_buf1_phys;
        (*bdl.add(1)).length_bytes = (AUDIO_BUFFER_SAMPLES * 2 * 2) as u32;
        (*bdl.add(1)).flags = 1;

        AUDIO_DEV.volume = 85;
        AUDIO_DEV.is_playing = true;
    }
}

@system
pub fn audio_set_volume(vol: u8) {
    unsafe {
        AUDIO_DEV.volume = if vol > 100 { 100 } else { vol };
    }
}

// Sintetizador senoidal direto no Buffer DMA (48 kHz Stereo 16-bit)
@system
pub fn audio_play_tone_hz(freq: u32, duration_ms: u32) {
    unsafe {
        if !AUDIO_DEV.is_playing || AUDIO_DEV.dma_buf0_virt == (0 as *mut i16) { return; }

        let buf = if AUDIO_DEV.active_buffer == 0 { AUDIO_DEV.dma_buf0_virt } else { AUDIO_DEV.dma_buf1_virt };
        let total_samples = (AUDIO_SAMPLE_RATE * duration_ms) / 1000;
        let samples_to_render = (total_samples as usize).min(AUDIO_BUFFER_SAMPLES);

        let phase_inc = (freq as f32 * 6.28318) / (AUDIO_SAMPLE_RATE as f32);
        let amp = (16000.0 * (AUDIO_DEV.volume as f32 / 100.0)) as i16;

        for i in 0..samples_to_render {
            let phase = (i as f32) * phase_inc;
            let sample_val = (phase.sin() * (amp as f32)) as i16;

            // Stereo: Left + Right
            *buf.add(i * 2) = sample_val;
            *buf.add(i * 2 + 1) = sample_val;
        }

        // Alterna buffer ativo
        AUDIO_DEV.active_buffer = 1 - AUDIO_DEV.active_buffer;
    }
}

// Jingle Harmônico de Inicialização do Baken OS (Acorde Maior C-E-G-C)
@system
pub fn audio_play_startup_chime() {
    audio_play_tone_hz(523, 120); // C5 (523 Hz)
    audio_play_tone_hz(659, 120); // E5 (659 Hz)
    audio_play_tone_hz(783, 120); // G5 (783 Hz)
    audio_play_tone_hz(1046, 250); // C6 (1046 Hz)
}

// Efeito Sonoro de Clique na Interface
@system
pub fn audio_play_ui_click() {
    audio_play_tone_hz(1200, 15);
}
