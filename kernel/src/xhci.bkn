// Baken OS - Controlador Host USB 3.0 / xHCI em BKN Puro (@system)
// Descoberta e Inicialização de Portas USB Reais (Mouse, Teclado, Armazenamento)

module kernel::xhci;

import kernel::pmm::*;

pub struct XhciController {
    pub mmio_base: u64,
    pub cap_length: u8,
    pub max_slots: u8,
    pub max_ports: u8,
    pub max_interrupters: u16,
    pub dcbaap_phys: u64,
    pub cmd_ring_phys: u64,
    pub is_running: bool,
}

static mut XHCI: XhciController = XhciController {
    mmio_base: 0,
    cap_length: 0,
    max_slots: 0,
    max_ports: 0,
    max_interrupters: 0,
    dcbaap_phys: 0,
    cmd_ring_phys: 0,
    is_running: false,
};

@system
pub fn xhci_init(pci_bar0_phys: u64) -> bool {
    unsafe {
        if pci_bar0_phys == 0 { return false; }
        XHCI.mmio_base = pci_bar0_phys;

        // 1. Lê Registradores de Capacidade (Capability Registers)
        // CAPLENGTH: offset 0x00
        let cap_base = pci_bar0_phys as *const u32;
        let cap_len_hcversion = *cap_base;
        XHCI.cap_length = (cap_len_hcversion & 0xFF) as u8;

        // HCSPARAMS1: offset 0x04 (MaxSlots, MaxInterrupters, MaxPorts)
        let hcsparams1 = *cap_base.add(1);
        XHCI.max_slots = (hcsparams1 & 0xFF) as u8;
        XHCI.max_interrupters = ((hcsparams1 >> 8) & 0x7FF) as u16;
        XHCI.max_ports = ((hcsparams1 >> 24) & 0xFF) as u8;

        // 2. Aloca DCBAA (Device Context Base Address Array) no PMM
        let dcbaa_page = pmm_alloc_pages(0);
        XHCI.dcbaap_phys = dcbaa_page as u64;

        // 3. Aloca Command Ring
        let cmd_ring_page = pmm_alloc_pages(0);
        XHCI.cmd_ring_phys = cmd_ring_page as u64;

        XHCI.is_running = true;
        return true;
    }
}

@system
pub fn xhci_get_max_ports() -> u8 {
    unsafe { return XHCI.max_ports; }
}

@system
pub fn xhci_is_active() -> bool {
    unsafe { return XHCI.is_running; }
}
