// Baken OS — política conservadora para o snapshot de memória do bootstrap.
//
// O bootstrap entrega os códigos de tipo/atributo do mapa final como dados POD.
// Este módulo é puro: não percorre serviços de firmware, não aloca páginas, não
// escreve page tables e não chama firmware. Os nomes internos são do Baken para
// que nenhuma declaração EFI faça parte da API do kernel.

module kernel::memory::memory_map_policy;

// Códigos preservados no contrato de boot. Os valores são os do mapa recebido
// antes de ExitBootServices, mas a API pós-cutover pertence exclusivamente ao Baken.
pub const BAKEN_BOOT_MEMORY_RESERVED: u32 = 0;
pub const BAKEN_BOOT_MEMORY_LOADER_CODE: u32 = 1;
pub const BAKEN_BOOT_MEMORY_LOADER_DATA: u32 = 2;
pub const BAKEN_BOOT_MEMORY_BOOT_SERVICES_CODE: u32 = 3;
pub const BAKEN_BOOT_MEMORY_BOOT_SERVICES_DATA: u32 = 4;
pub const BAKEN_BOOT_MEMORY_RUNTIME_SERVICES_CODE: u32 = 5;
pub const BAKEN_BOOT_MEMORY_RUNTIME_SERVICES_DATA: u32 = 6;
pub const BAKEN_BOOT_MEMORY_CONVENTIONAL: u32 = 7;
pub const BAKEN_BOOT_MEMORY_UNUSABLE: u32 = 8;
pub const BAKEN_BOOT_MEMORY_ACPI_RECLAIM: u32 = 9;
pub const BAKEN_BOOT_MEMORY_ACPI_NVS: u32 = 10;
pub const BAKEN_BOOT_MEMORY_MMIO: u32 = 11;
pub const BAKEN_BOOT_MEMORY_MMIO_PORT_SPACE: u32 = 12;
pub const BAKEN_BOOT_MEMORY_PAL_CODE: u32 = 13;
pub const BAKEN_BOOT_MEMORY_PERSISTENT: u32 = 14;
pub const BAKEN_BOOT_MEMORY_UNACCEPTED: u32 = 15;

pub const BAKEN_BOOT_MEMORY_ATTR_UC: u64 = 0x0000000000000001;
pub const BAKEN_BOOT_MEMORY_ATTR_WC: u64 = 0x0000000000000002;
pub const BAKEN_BOOT_MEMORY_ATTR_WT: u64 = 0x0000000000000004;
pub const BAKEN_BOOT_MEMORY_ATTR_WB: u64 = 0x0000000000000008;
pub const BAKEN_BOOT_MEMORY_ATTR_RUNTIME: u64 = 0x8000000000000000;

@system
pub fn boot_memory_type_is_mmio(type_code: u32) -> bool {
    return type_code == BAKEN_BOOT_MEMORY_MMIO ||
        type_code == BAKEN_BOOT_MEMORY_MMIO_PORT_SPACE;
}

// Ranges que podem receber alias alto do kernel depois de ExitBootServices.
// Ranges de runtime do firmware são excluídos deliberadamente; Reserved,
// Unusable, MMIO, PAL e Unaccepted também não entram automaticamente.
@system
pub fn boot_memory_type_is_direct_map_ram(type_code: u32) -> bool {
    return type_code == BAKEN_BOOT_MEMORY_LOADER_CODE ||
        type_code == BAKEN_BOOT_MEMORY_LOADER_DATA ||
        type_code == BAKEN_BOOT_MEMORY_BOOT_SERVICES_CODE ||
        type_code == BAKEN_BOOT_MEMORY_BOOT_SERVICES_DATA ||
        type_code == BAKEN_BOOT_MEMORY_CONVENTIONAL ||
        type_code == BAKEN_BOOT_MEMORY_ACPI_RECLAIM ||
        type_code == BAKEN_BOOT_MEMORY_ACPI_NVS;
}

// O primeiro direct-map usa somente WB. WC/UC/WT ficam para mappings explícitos
// depois que o kernel possui política PAT/MTRR própria. Exigir WB evita tornar
// um range MMIO/firmware cacheável por inferência.
@system
pub fn boot_memory_descriptor_is_direct_map_wb(type_code: u32,
                                               attribute: u64) -> bool {
    if !boot_memory_type_is_direct_map_ram(type_code) { return false; }
    if (attribute & BAKEN_BOOT_MEMORY_ATTR_RUNTIME) != 0 { return false; }
    return (attribute & BAKEN_BOOT_MEMORY_ATTR_WB) != 0;
}

// Memória que pode alimentar o PMM imediatamente após ExitBootServices. ACPI
// Reclaim só pode ser liberada depois que as tabelas necessárias forem
// copiadas/consumidas; NVS permanece reservada.
@system
pub fn boot_memory_type_is_immediately_reclaimable(type_code: u32) -> bool {
    return type_code == BAKEN_BOOT_MEMORY_LOADER_CODE ||
        type_code == BAKEN_BOOT_MEMORY_LOADER_DATA ||
        type_code == BAKEN_BOOT_MEMORY_BOOT_SERVICES_CODE ||
        type_code == BAKEN_BOOT_MEMORY_BOOT_SERVICES_DATA ||
        type_code == BAKEN_BOOT_MEMORY_CONVENTIONAL;
}

@system
pub fn boot_memory_type_is_acpi_reclaimable_later(type_code: u32) -> bool {
    return type_code == BAKEN_BOOT_MEMORY_ACPI_RECLAIM;
}
