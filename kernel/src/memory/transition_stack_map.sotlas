// Baken OS — materialização segura do contexto e stack de transição.
//
// A guard page calculada por transition_stack_layout() permanece sem mapping.
// A página de contexto e as páginas de stack são mapeadas RW+NX. O contexto
// fica abaixo da base utilizável da pilha e não pode ser sobrescrito pelo
// crescimento descendente normal da stack.

module kernel::memory::transition_stack_map;

import kernel::memory::transition_stack::*;
import kernel::memory::transition_map::*;
import kernel::memory::page_table_arena::*;
import kernel::arch::x86_64::paging::*;

@system
pub fn transition_stack_map(arena: *mut PageTableArena,
                            root: PageTablePage,
                            layout: TransitionStackLayout) -> TransitionMapStats {
    if !layout.valid { return transition_map_stats_invalid(); }
    if layout.context_virtual_base == 0 || layout.context_physical_base == 0 {
        return transition_map_stats_invalid();
    }
    if layout.usable_page_count == 0 { return transition_map_stats_invalid(); }

    let mapped_page_count = layout.usable_page_count + 1;
    if mapped_page_count <= layout.usable_page_count { return transition_map_stats_invalid(); }
    let mapped_size = mapped_page_count * X86_PAGE_SIZE;
    if (mapped_size / X86_PAGE_SIZE) != mapped_page_count {
        return transition_map_stats_invalid();
    }

    let flags = X86_PTE_PRESENT | X86_PTE_WRITABLE | X86_PTE_NX;
    return transition_map_range(
        arena,
        root,
        layout.context_virtual_base,
        layout.context_physical_base,
        mapped_size,
        flags
    );
}
