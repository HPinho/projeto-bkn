// Baken OS — retomada segura da arena de page tables depois do cutover.
//
// A arena foi reservada como EfiLoaderData e está no direct-map. Após CR3,
// retomamos exatamente do número de páginas já consumidas pelo construtor de
// transição. Mutações da raiz ativa são serializadas entre CPUs e, depois que
// APs entram no scheduler, toda alteração global termina em TLB shootdown.

module kernel::memory::active_page_tables;

import kernel::memory::page_table_arena::*;
import kernel::memory::page_table_writer::*;
import kernel::memory::page_table_mapper::*;
import kernel::memory::direct_map::*;
import kernel::memory::tlb_shootdown::*;
import kernel::arch::x86_64::paging::*;
import kernel::arch::x86_64::cpu::*;
import kernel::sync::spinlock::*;

static mut ACTIVE_PAGE_TABLE_ARENA: PageTableArena = PageTableArena {
    physical_base: 0,
    virtual_base: 0,
    page_count: 0,
    next_page_index: 0,
    valid: false
};
static mut ACTIVE_PAGE_TABLE_ROOT: PageTablePage = PageTablePage {
    physical_address: 0,
    virtual_address: 0,
    valid: false
};
static mut ACTIVE_PAGE_TABLES_READY: bool = false;
static mut ACTIVE_PAGE_TABLE_LOCK: SpinLock = SpinLock { state: 0 };
static mut ACTIVE_PAGE_TABLE_LOCK_READY: bool = false;

// Dedicated runtime window, disjoint from identity/direct-map/kernel mappings.
pub const VMM_RUNTIME_BASE: u64 = 0x0000400000000000;
pub const VMM_RUNTIME_SIZE: u64 = 0x40000000;

@system
fn active_page_tables_lock_irq() -> u64 {
    unsafe { if !ACTIVE_PAGE_TABLE_LOCK_READY { return 0; } }
    // Não manter IF=0 enquanto outra CPU pode estar concluindo um shootdown.
    loop {
        let flags = x86_irq_save_disable();
        let mut acquired = false;
        unsafe { acquired = spinlock_try_lock(&mut ACTIVE_PAGE_TABLE_LOCK); }
        if acquired { return flags; }
        x86_irq_restore(flags);
        x86_cpu_pause();
    }
}

@system
fn active_page_tables_unlock_irq(flags: u64) -> void {
    let mut released = false;
    unsafe { released = spinlock_unlock(&mut ACTIVE_PAGE_TABLE_LOCK); }
    if !released { loop { x86_cpu_pause(); } }
    x86_irq_restore(flags);
}

@system
fn active_runtime_address_valid(address: u64) -> bool {
    return address >= VMM_RUNTIME_BASE && address - VMM_RUNTIME_BASE < VMM_RUNTIME_SIZE && x86_page_aligned(address);
}

@system
fn active_runtime_leaf_locked(address: u64) -> PageTablePage {
    unsafe {
        let mut page = ACTIVE_PAGE_TABLE_ROOT;
        let pml4_entry = page_table_read_entry(page, x86_pml4_index(address));
        if !x86_pte_present(pml4_entry) || (pml4_entry & X86_PTE_HUGE) != 0 { return page_table_page_invalid(); }
        page = page_table_arena_page_from_physical(&ACTIVE_PAGE_TABLE_ARENA, x86_pte_address(pml4_entry));
        if !page.valid { return page_table_page_invalid(); }
        let pdpt_entry = page_table_read_entry(page, x86_pdpt_index(address));
        if !x86_pte_present(pdpt_entry) || (pdpt_entry & X86_PTE_HUGE) != 0 { return page_table_page_invalid(); }
        page = page_table_arena_page_from_physical(&ACTIVE_PAGE_TABLE_ARENA, x86_pte_address(pdpt_entry));
        if !page.valid { return page_table_page_invalid(); }
        let pd_entry = page_table_read_entry(page, x86_pd_index(address));
        if !x86_pte_present(pd_entry) || (pd_entry & X86_PTE_HUGE) != 0 { return page_table_page_invalid(); }
        page = page_table_arena_page_from_physical(&ACTIVE_PAGE_TABLE_ARENA, x86_pte_address(pd_entry));
        if !page.valid { return page_table_page_invalid(); }
        return page;
    }
}

@system
fn active_runtime_pte_locked(address: u64) -> u64 {
    let leaf = active_runtime_leaf_locked(address);
    if !leaf.valid { return 0; }
    return page_table_read_entry(leaf, x86_pt_index(address));
}

@system
pub fn active_runtime_pte(address: u64) -> u64 {
    if !active_page_tables_is_ready() || !x86_page_aligned(address) { return 0; }
    let flags = active_page_tables_lock_irq();
    if flags == 0 { return 0; }
    let value = active_runtime_pte_locked(address);
    active_page_tables_unlock_irq(flags);
    return value;
}

@system
fn active_page_tables_publish_locked(address: u64) -> bool {
    return tlb_shootdown_kernel_page(address);
}

@system
pub fn active_runtime_map(address: u64, physical: u64, writable: bool, executable: bool) -> bool {
    if !active_runtime_address_valid(address) || !x86_page_aligned(physical) || physical == 0 ||
       (writable && executable) || !active_page_tables_is_ready() { return false; }
    let flags_irq = active_page_tables_lock_irq();
    if flags_irq == 0 { return false; }
    let mut pte_flags = X86_PTE_PRESENT;
    if writable { pte_flags |= X86_PTE_WRITABLE; }
    if !executable { pte_flags |= X86_PTE_NX; }
    let mut mapped = false;
    unsafe {
        mapped = page_table_map_4k(&mut ACTIVE_PAGE_TABLE_ARENA, ACTIVE_PAGE_TABLE_ROOT,
                                   address, physical, pte_flags);
    }
    if mapped { mapped = active_page_tables_publish_locked(address); }
    active_page_tables_unlock_irq(flags_irq);
    return mapped;
}

@system
pub fn active_runtime_remap(address: u64, physical: u64, writable: bool, executable: bool) -> bool {
    if !active_runtime_address_valid(address) || physical == 0 || !x86_page_aligned(physical) ||
       (writable && executable) || !active_page_tables_is_ready() { return false; }
    let flags_irq = active_page_tables_lock_irq();
    if flags_irq == 0 { return false; }
    let old = active_runtime_pte_locked(address);
    if !x86_pte_present(old) {
        active_page_tables_unlock_irq(flags_irq);
        return false;
    }
    let mut pte_flags = X86_PTE_PRESENT;
    if writable { pte_flags |= X86_PTE_WRITABLE; }
    if !executable { pte_flags |= X86_PTE_NX; }
    let leaf = active_runtime_leaf_locked(address);
    let desired = x86_pte_make(physical, pte_flags);
    let mut changed = leaf.valid && desired != 0 &&
        page_table_write_entry(leaf, x86_pt_index(address), desired);
    if changed { changed = active_page_tables_publish_locked(address); }
    active_page_tables_unlock_irq(flags_irq);
    return changed;
}

@system
pub fn active_runtime_protect(address: u64, writable: bool, executable: bool) -> bool {
    if !active_runtime_address_valid(address) || (writable && executable) || !active_page_tables_is_ready() { return false; }
    let flags_irq = active_page_tables_lock_irq();
    if flags_irq == 0 { return false; }
    let old = active_runtime_pte_locked(address);
    if !x86_pte_present(old) {
        active_page_tables_unlock_irq(flags_irq);
        return false;
    }
    let mut pte_flags = X86_PTE_PRESENT;
    if writable { pte_flags |= X86_PTE_WRITABLE; }
    if !executable { pte_flags |= X86_PTE_NX; }
    let leaf = active_runtime_leaf_locked(address);
    let mut changed = leaf.valid && page_table_write_entry(
        leaf, x86_pt_index(address), x86_pte_make(x86_pte_address(old), pte_flags));
    if changed { changed = active_page_tables_publish_locked(address); }
    active_page_tables_unlock_irq(flags_irq);
    return changed;
}

@system
pub fn active_runtime_unmap(address: u64) -> bool {
    if !active_runtime_address_valid(address) || !active_page_tables_is_ready() { return false; }
    let flags_irq = active_page_tables_lock_irq();
    if flags_irq == 0 { return false; }
    let old = active_runtime_pte_locked(address);
    let leaf = active_runtime_leaf_locked(address);
    let mut changed = x86_pte_present(old) && leaf.valid &&
        page_table_write_entry(leaf, x86_pt_index(address), 0);
    if changed { changed = active_page_tables_publish_locked(address); }
    active_page_tables_unlock_irq(flags_irq);
    return changed;
}

@system
pub fn active_page_tables_map_ram_identity_4k(physical_address: u64,
                                               writable: bool,
                                               executable: bool) -> bool {
    if !active_page_tables_is_ready() || physical_address == 0 ||
       !x86_page_aligned(physical_address) || (writable && executable) { return false; }
    let flags_irq = active_page_tables_lock_irq();
    if flags_irq == 0 { return false; }
    let mut pte_flags = X86_PTE_PRESENT;
    if writable { pte_flags |= X86_PTE_WRITABLE; }
    if !executable { pte_flags |= X86_PTE_NX; }
    let desired = x86_pte_make(physical_address, pte_flags);
    if desired == 0 {
        active_page_tables_unlock_irq(flags_irq);
        return false;
    }
    let leaf = active_runtime_leaf_locked(physical_address);
    let mut changed = false;
    if leaf.valid {
        let current = page_table_read_entry(leaf, x86_pt_index(physical_address));
        if x86_pte_present(current) {
            if x86_pte_address(current) != physical_address {
                active_page_tables_unlock_irq(flags_irq);
                return false;
            }
            changed = page_table_write_entry(leaf, x86_pt_index(physical_address), desired);
        }
    }
    if !changed {
        unsafe {
            changed = page_table_map_4k(&mut ACTIVE_PAGE_TABLE_ARENA, ACTIVE_PAGE_TABLE_ROOT,
                                        physical_address, physical_address, pte_flags);
        }
    }
    if changed { changed = active_page_tables_publish_locked(physical_address); }
    active_page_tables_unlock_irq(flags_irq);
    return changed;
}

@system
fn active_mmio_identity_uc_pte_locked(page: u64) -> bool {
    if page == 0 || !x86_page_aligned(page) { return false; }
    let pte = active_runtime_pte_locked(page);
    if !x86_pte_present(pte) || x86_pte_address(pte) != page {
        return false;
    }
    let required = X86_PTE_WRITABLE | X86_PTE_NX |
        X86_PTE_WRITE_THROUGH | X86_PTE_CACHE_DISABLE;
    if (pte & required) != required { return false; }
    if (pte & X86_PTE_USER) != 0 { return false; }
    // UC identity backend atual seleciona PAT index 3: PWT=1, PCD=1, PAT=0.
    return (pte & 0x98) == (X86_PTE_WRITE_THROUGH | X86_PTE_CACHE_DISABLE);
}

@system
pub fn active_mmio_identity_uc_range_ready(page_base: u64, page_count: u64) -> bool {
    if !active_page_tables_is_ready() || page_base == 0 ||
       !x86_page_aligned(page_base) || page_count == 0 ||
       page_count > (0xFFFFFFFFFFFFFFFF / 4096) {
        return false;
    }
    let span = page_count * 4096;
    if page_base + span <= page_base { return false; }

    let flags_irq = active_page_tables_lock_irq();
    if flags_irq == 0 { return false; }
    let mut page = page_base;
    let mut index: u64 = 0;
    let mut ready = true;
    while index < page_count {
        if !active_mmio_identity_uc_pte_locked(page) {
            ready = false;
            break;
        }
        page += 4096;
        index += 1;
    }
    active_page_tables_unlock_irq(flags_irq);
    return ready;
}

@system
fn active_mmio_restore_uc_locked(page_base: u64, page_count: u64) -> bool {
    let mut page = page_base;
    let mut index: u64 = 0;
    while index < page_count {
        let leaf = active_runtime_leaf_locked(page);
        if !leaf.valid { return false; }
        let old = page_table_read_entry(leaf, x86_pt_index(page));
        if !x86_pte_present(old) || x86_pte_address(old) != page { return false; }
        let desired = (old & ~0x98) |
            X86_PTE_WRITE_THROUGH | X86_PTE_CACHE_DISABLE;
        if !page_table_write_entry(leaf, x86_pt_index(page), desired) ||
           !active_page_tables_publish_locked(page) {
            return false;
        }
        let observed = page_table_read_entry(leaf, x86_pt_index(page));
        if (observed & 0x98) !=
           (X86_PTE_WRITE_THROUGH | X86_PTE_CACHE_DISABLE) {
            return false;
        }
        page += 4096;
        index += 1;
    }
    __dma_fence();
    return true;
}

@system
pub fn active_mmio_restore_identity_uc(page_base: u64, page_count: u64) -> bool {
    if !active_page_tables_is_ready() || page_base == 0 ||
       !x86_page_aligned(page_base) || page_count == 0 ||
       page_count > (0xFFFFFFFFFFFFFFFF / 4096) {
        return false;
    }
    let span = page_count * 4096;
    if page_base + span <= page_base { return false; }

    let flags_irq = active_page_tables_lock_irq();
    if flags_irq == 0 { return false; }
    let restored = active_mmio_restore_uc_locked(page_base, page_count);
    active_page_tables_unlock_irq(flags_irq);
    return restored;
}

@system
pub fn active_mmio_promote_identity_wc(page_base: u64, page_count: u64) -> bool {
    if !active_page_tables_is_ready() || page_base == 0 ||
       !x86_page_aligned(page_base) || page_count == 0 ||
       page_count > (0xFFFFFFFFFFFFFFFF / 4096) {
        return false;
    }
    let span = page_count * 4096;
    if page_base + span <= page_base { return false; }

    let flags_irq = active_page_tables_lock_irq();
    if flags_irq == 0 { return false; }

    // Preflight completo sob o mesmo lock: nenhuma pagina muda antes de todas
    // provarem identity + RW + NX + supervisor + UC.
    let mut page = page_base;
    let mut index: u64 = 0;
    let mut ready = true;
    while index < page_count {
        if !active_mmio_identity_uc_pte_locked(page) {
            ready = false;
            break;
        }
        page += 4096;
        index += 1;
    }
    if !ready || !__pat_install_wc() {
        active_page_tables_unlock_irq(flags_irq);
        return false;
    }

    page = page_base;
    index = 0;
    let mut promoted = true;
    while index < page_count {
        let leaf = active_runtime_leaf_locked(page);
        if !leaf.valid {
            promoted = false;
            break;
        }
        let old = page_table_read_entry(leaf, x86_pt_index(page));
        if !x86_pte_present(old) || x86_pte_address(old) != page {
            promoted = false;
            break;
        }

        // PAT index 7 = PAT|PCD|PWT. __pat_install_wc() garante WC nesse indice.
        let desired = (old & ~0x98) | 0x98;
        if !page_table_write_entry(leaf, x86_pt_index(page), desired) ||
           !active_page_tables_publish_locked(page) {
            promoted = false;
            break;
        }
        let observed = page_table_read_entry(leaf, x86_pt_index(page));
        if (observed & 0x98) != 0x98 {
            promoted = false;
            break;
        }
        page += 4096;
        index += 1;
    }

    if !promoted {
        // O preflight provou que todo o range era UC antes da primeira escrita.
        // Normalizar o range inteiro e mais simples e mais seguro que rastrear
        // apenas as paginas potencialmente modificadas.
        active_mmio_restore_uc_locked(page_base, page_count);
        active_page_tables_unlock_irq(flags_irq);
        return false;
    }

    __dma_fence();
    active_page_tables_unlock_irq(flags_irq);
    return true;
}

@system
pub fn active_framebuffer_write_combining(base: u64, size: u64) -> bool {
    if !active_page_tables_is_ready() || base == 0 || size == 0 || size > 268435456 { return false; }
    let end = base + size;
    if end <= base { return false; }
    let first = x86_page_align_down(base);
    let limit = x86_page_align_up(end);
    if limit < end { return false; }
    let flags_irq = active_page_tables_lock_irq();
    if flags_irq == 0 { return false; }
    let mut page = first;
    while page < limit {
        let pte = active_runtime_pte_locked(page);
        if !x86_pte_present(pte) || x86_pte_address(pte) != page ||
           (pte & (X86_PTE_WRITABLE | X86_PTE_NX)) != (X86_PTE_WRITABLE | X86_PTE_NX) {
            active_page_tables_unlock_irq(flags_irq);
            return false;
        }
        page += 4096;
    }
    if !__pat_install_wc() {
        active_page_tables_unlock_irq(flags_irq);
        return false;
    }
    page = first;
    while page < limit {
        let leaf = active_runtime_leaf_locked(page);
        let old = page_table_read_entry(leaf, x86_pt_index(page));
        if !page_table_write_entry(leaf, x86_pt_index(page), old | 0x98) ||
           !active_page_tables_publish_locked(page) ||
           (page_table_read_entry(leaf, x86_pt_index(page)) & 0x98) != 0x98 {
            active_page_tables_unlock_irq(flags_irq);
            return false;
        }
        page += 4096;
    }
    __dma_fence();
    active_page_tables_unlock_irq(flags_irq);
    return true;
}

@system
pub fn active_page_tables_resume(root_physical: u64,
                                 arena_physical_base: u64,
                                 arena_page_count: u64,
                                 pages_used: u64) -> bool {
    if root_physical == 0 || arena_physical_base == 0 { return false; }
    if !x86_page_aligned(root_physical) || !x86_page_aligned(arena_physical_base) { return false; }
    if arena_page_count == 0 || pages_used == 0 || pages_used > arena_page_count { return false; }
    let arena_virtual_base = direct_map_virtual_address(arena_physical_base);
    let root_virtual = direct_map_virtual_address(root_physical);
    if arena_virtual_base == 0 || root_virtual == 0 { return false; }
    let mut arena = page_table_arena_make(arena_physical_base, arena_virtual_base, arena_page_count);
    if !arena.valid { return false; }
    unsafe { arena.next_page_index = pages_used; }
    let root = page_table_arena_page_from_physical(&arena, root_physical);
    if !root.valid || !page_table_page_writable(root) || root.virtual_address != root_virtual { return false; }
    unsafe {
        if !spinlock_init(&mut ACTIVE_PAGE_TABLE_LOCK) { return false; }
        ACTIVE_PAGE_TABLE_LOCK_READY = true;
        ACTIVE_PAGE_TABLE_ARENA = arena;
        ACTIVE_PAGE_TABLE_ROOT = root;
    }
    if !tlb_shootdown_initialize() { return false; }
    unsafe { ACTIVE_PAGE_TABLES_READY = true; }
    return true;
}

@system
pub fn active_page_tables_is_ready() -> bool { unsafe { return ACTIVE_PAGE_TABLES_READY; } }

@system
pub fn active_page_tables_remaining_pages() -> u64 {
    if !active_page_tables_is_ready() { return 0; }
    let flags_irq = active_page_tables_lock_irq();
    if flags_irq == 0 { return 0; }
    let mut remaining: u64 = 0;
    unsafe { remaining = page_table_arena_remaining(&ACTIVE_PAGE_TABLE_ARENA); }
    active_page_tables_unlock_irq(flags_irq);
    return remaining;
}

@system
pub fn active_page_tables_map_mmio_identity_4k(physical_address: u64) -> bool {
    if !x86_page_aligned(physical_address) || physical_address == 0 || !active_page_tables_is_ready() { return false; }
    let flags_irq = active_page_tables_lock_irq();
    if flags_irq == 0 { return false; }
    let pte_flags = X86_PTE_PRESENT | X86_PTE_WRITABLE | X86_PTE_NX |
        X86_PTE_WRITE_THROUGH | X86_PTE_CACHE_DISABLE;
    let mut mapped = false;
    unsafe {
        mapped = page_table_map_4k(&mut ACTIVE_PAGE_TABLE_ARENA, ACTIVE_PAGE_TABLE_ROOT,
                                   physical_address, physical_address, pte_flags);
    }
    if mapped { mapped = active_page_tables_publish_locked(physical_address); }
    active_page_tables_unlock_irq(flags_irq);
    return mapped;
}
