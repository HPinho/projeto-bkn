// Baken OS — mapping temporário da imagem PE/COFF durante a futura troca de CR3.
//
// A imagem precisa continuar executável E gravável porque ainda não separamos
// as seções PE em RX/RW. Portanto esta fase usa RWX deliberadamente e somente
// durante o cutover. O hardening por seção (W^X) é obrigatório antes de tratar
// esta política como VMM final.
//
// Este módulo não toca CR3, UEFI ou PMM.

module kernel::memory::transition_image_map;

import kernel::memory::transition_map::*;
import kernel::memory::page_table_arena::*;
import kernel::arch::x86_64::paging::*;

pub struct TransitionImageLayout {
    pub physical_base: u64;
    pub virtual_base: u64;
    pub size: u64;
    pub valid: bool;
}

@system
pub fn transition_image_invalid() -> TransitionImageLayout {
    return TransitionImageLayout {
        physical_base: 0,
        virtual_base: 0,
        size: 0,
        valid: false
    };
}

@system
pub fn transition_image_layout(physical_base: u64,
                               virtual_base: u64,
                               size: u64) -> TransitionImageLayout {
    if physical_base == 0 || virtual_base == 0 || size == 0 {
        return transition_image_invalid();
    }
    if (physical_base % X86_PAGE_SIZE) != (virtual_base % X86_PAGE_SIZE) {
        return transition_image_invalid();
    }
    let end = virtual_base + size;
    if end <= virtual_base { return transition_image_invalid(); }

    return TransitionImageLayout {
        physical_base: physical_base,
        virtual_base: virtual_base,
        size: size,
        valid: true
    };
}

@system
pub fn transition_image_map(arena: *mut PageTableArena,
                            root: PageTablePage,
                            layout: TransitionImageLayout) -> TransitionMapStats {
    if !layout.valid { return transition_map_stats_invalid(); }

    // TRANSITÓRIO: executável + gravável. Não é política final de VMM.
    let flags = X86_PTE_PRESENT | X86_PTE_WRITABLE;
    return transition_map_range(
        arena,
        root,
        layout.virtual_base,
        layout.physical_base,
        layout.size,
        flags
    );
}
