// Baken OS — shootdown de TLB SMP para mappings globais e address spaces.
//
// Sem dependencia de scheduler/SMP de alto nivel: a topologia e registrada pelo
// bring-up e o handler identifica a CPU pelo APIC ID. O caminho de interrupcao
// nao aloca, nao adquire locks e so executa INVLPG + acknowledgement volatil.
// O protocolo e simetrico: BSP e APs podem iniciar uma invalidacao depois de
// entrarem no conjunto ativo. Root 0 significa mapping compartilhado por todas
// as raizes; root != 0 usa tracking do CR3 ativo para dirigir somente as CPUs
// que podem possuir uma traducao daquele address space.
module kernel::memory::tlb_shootdown;

import kernel::arch::x86_64::cpu::*;
import kernel::arch::x86_64::paging::*;
import kernel::interrupts::xapic_ipi::*;
import kernel::sync::spinlock::*;

pub const TLB_SHOOTDOWN_VECTOR: u16 = 0x45;
pub const TLB_SHOOTDOWN_MAX_CPUS: usize = 32;
pub const TLB_SHOOTDOWN_SPIN_LIMIT: u64 = 10000000;
pub const TLB_SHOOTDOWN_TARGET_FAILURE: u32 = 0xFFFFFFFF;

static mut TLB_SHOOTDOWN_LOCK: SpinLock = SpinLock { state: 0 };
static mut TLB_SHOOTDOWN_READY: bool = false;
static mut TLB_SHOOTDOWN_CPU_REGISTERED: [bool; TLB_SHOOTDOWN_MAX_CPUS] = [false; TLB_SHOOTDOWN_MAX_CPUS];
static mut TLB_SHOOTDOWN_CPU_ACTIVE: [bool; TLB_SHOOTDOWN_MAX_CPUS] = [false; TLB_SHOOTDOWN_MAX_CPUS];
static mut TLB_SHOOTDOWN_CPU_APIC_ID: [u8; TLB_SHOOTDOWN_MAX_CPUS] = [0; TLB_SHOOTDOWN_MAX_CPUS];
// Root realmente carregado em cada CPU na ultima decisao de scheduling. Zero
// significa desconhecido e deve ser tratado conservadoramente como possivel
// portador da traducao no shootdown seletivo.
static mut TLB_SHOOTDOWN_CPU_ROOT: [u64; TLB_SHOOTDOWN_MAX_CPUS] = [0; TLB_SHOOTDOWN_MAX_CPUS];
static mut TLB_SHOOTDOWN_ADDRESS_LO: u32 = 0;
static mut TLB_SHOOTDOWN_ADDRESS_HI: u32 = 0;
static mut TLB_SHOOTDOWN_ROOT_LO: u32 = 0;
static mut TLB_SHOOTDOWN_ROOT_HI: u32 = 0;
static mut TLB_SHOOTDOWN_GENERATION: u32 = 0;
static mut TLB_SHOOTDOWN_ACK: [u32; TLB_SHOOTDOWN_MAX_CPUS] = [0; TLB_SHOOTDOWN_MAX_CPUS];

@system
fn tlb_u32_address(value: *mut u32) -> u64 { return value as u64; }

@system
pub fn tlb_shootdown_initialize() -> bool {
    unsafe {
        if TLB_SHOOTDOWN_READY { return true; }
        if !spinlock_init(&mut TLB_SHOOTDOWN_LOCK) { return false; }
        let mut slot: usize = 0;
        while slot < TLB_SHOOTDOWN_MAX_CPUS {
            TLB_SHOOTDOWN_CPU_REGISTERED[slot] = false;
            TLB_SHOOTDOWN_CPU_ACTIVE[slot] = false;
            TLB_SHOOTDOWN_CPU_APIC_ID[slot] = 0;
            TLB_SHOOTDOWN_CPU_ROOT[slot] = 0;
            TLB_SHOOTDOWN_ACK[slot] = 0;
            slot += 1;
        }
        TLB_SHOOTDOWN_ADDRESS_LO = 0;
        TLB_SHOOTDOWN_ADDRESS_HI = 0;
        TLB_SHOOTDOWN_ROOT_LO = 0;
        TLB_SHOOTDOWN_ROOT_HI = 0;
        TLB_SHOOTDOWN_GENERATION = 0;
        TLB_SHOOTDOWN_READY = true;
    }
    __dma_fence();
    return true;
}

@system
pub fn tlb_shootdown_is_ready() -> bool { unsafe { return TLB_SHOOTDOWN_READY; } }

@system
pub fn tlb_shootdown_register_cpu(slot: usize, apic_id: u8) -> bool {
    if !tlb_shootdown_is_ready() || slot >= TLB_SHOOTDOWN_MAX_CPUS { return false; }
    unsafe {
        if TLB_SHOOTDOWN_CPU_REGISTERED[slot] {
            return TLB_SHOOTDOWN_CPU_APIC_ID[slot] == apic_id;
        }
        let mut probe: usize = 0;
        while probe < TLB_SHOOTDOWN_MAX_CPUS {
            if TLB_SHOOTDOWN_CPU_REGISTERED[probe] && TLB_SHOOTDOWN_CPU_APIC_ID[probe] == apic_id {
                return false;
            }
            probe += 1;
        }
        TLB_SHOOTDOWN_CPU_APIC_ID[slot] = apic_id;
        TLB_SHOOTDOWN_CPU_ROOT[slot] = 0;
        TLB_SHOOTDOWN_CPU_REGISTERED[slot] = true;
        // O BSP ja esta executando com IRQ/IDT/LAPIC prontos quando o bring-up
        // SMP registra o slot 0. APs so entram no conjunto apos release.
        if slot == 0 { TLB_SHOOTDOWN_CPU_ACTIVE[slot] = true; }
    }
    __dma_fence();
    return true;
}

@system
pub fn tlb_shootdown_activate_cpu(slot: usize) -> bool {
    if !tlb_shootdown_is_ready() || slot >= TLB_SHOOTDOWN_MAX_CPUS { return false; }
    unsafe {
        if !TLB_SHOOTDOWN_CPU_REGISTERED[slot] { return false; }
        TLB_SHOOTDOWN_CPU_ACTIVE[slot] = true;
    }
    __dma_fence();
    return true;
}

@system
pub fn tlb_shootdown_active_cpu_count() -> u32 {
    let mut count: u32 = 0;
    unsafe {
        let mut slot: usize = 0;
        while slot < TLB_SHOOTDOWN_MAX_CPUS {
            if TLB_SHOOTDOWN_CPU_REGISTERED[slot] && TLB_SHOOTDOWN_CPU_ACTIVE[slot] { count += 1; }
            slot += 1;
        }
    }
    return count;
}

@system
pub fn tlb_shootdown_active_ap_count() -> u32 {
    let mut count: u32 = 0;
    unsafe {
        let mut slot: usize = 1;
        while slot < TLB_SHOOTDOWN_MAX_CPUS {
            if TLB_SHOOTDOWN_CPU_REGISTERED[slot] && TLB_SHOOTDOWN_CPU_ACTIVE[slot] { count += 1; }
            slot += 1;
        }
    }
    return count;
}

@system
fn tlb_shootdown_slot_for_current_cpu() -> usize {
    let apic_id = xapic_ipi_current_id();
    unsafe {
        let mut slot: usize = 0;
        while slot < TLB_SHOOTDOWN_MAX_CPUS {
            if TLB_SHOOTDOWN_CPU_REGISTERED[slot] && TLB_SHOOTDOWN_CPU_APIC_ID[slot] == apic_id {
                return slot;
            }
            slot += 1;
        }
    }
    return TLB_SHOOTDOWN_MAX_CPUS;
}

// Publicado depois que o scheduler terminou de selecionar o frame/CR3.
@system
pub fn tlb_shootdown_publish_current_root() -> bool {
    if !tlb_shootdown_is_ready() { return false; }
    let slot = tlb_shootdown_slot_for_current_cpu();
    if slot >= TLB_SHOOTDOWN_MAX_CPUS { return false; }
    let root = x86_read_cr3_raw() & X86_PAGE_ADDRESS_MASK;
    if root == 0 || !x86_page_aligned(root) { return false; }
    unsafe {
        if !TLB_SHOOTDOWN_CPU_REGISTERED[slot] || !TLB_SHOOTDOWN_CPU_ACTIVE[slot] { return false; }
        TLB_SHOOTDOWN_CPU_ROOT[slot] = root;
    }
    __dma_fence();
    return true;
}

@system
pub fn tlb_shootdown_cpu_root(slot: usize) -> u64 {
    if !tlb_shootdown_is_ready() || slot >= TLB_SHOOTDOWN_MAX_CPUS { return 0; }
    unsafe {
        if !TLB_SHOOTDOWN_CPU_REGISTERED[slot] || !TLB_SHOOTDOWN_CPU_ACTIVE[slot] { return 0; }
        return TLB_SHOOTDOWN_CPU_ROOT[slot];
    }
}

@system
fn tlb_shootdown_lock_irq() -> u64 {
    if !tlb_shootdown_is_ready() { return 0; }
    loop {
        let flags = x86_irq_save_disable();
        let mut acquired = false;
        unsafe { acquired = spinlock_try_lock(&mut TLB_SHOOTDOWN_LOCK); }
        if acquired { return flags; }
        x86_irq_restore(flags);
        x86_cpu_pause();
    }
}

@system
fn tlb_shootdown_unlock_irq(flags: u64) -> void {
    let mut released = false;
    unsafe { released = spinlock_unlock(&mut TLB_SHOOTDOWN_LOCK); }
    if !released { loop { x86_cpu_pause(); } }
    x86_irq_restore(flags);
}

@system
fn tlb_shootdown_next_generation() -> u32 {
    unsafe {
        TLB_SHOOTDOWN_GENERATION += 1;
        if TLB_SHOOTDOWN_GENERATION == 0 {
            TLB_SHOOTDOWN_GENERATION = 1;
            let mut slot: usize = 0;
            while slot < TLB_SHOOTDOWN_MAX_CPUS {
                TLB_SHOOTDOWN_ACK[slot] = 0;
                slot += 1;
            }
        }
        return TLB_SHOOTDOWN_GENERATION;
    }
}

@system
fn tlb_shootdown_publish(address: u64, root: u64, generation: u32) -> void {
    unsafe {
        let lo: *mut u32 = &mut TLB_SHOOTDOWN_ADDRESS_LO;
        let hi: *mut u32 = &mut TLB_SHOOTDOWN_ADDRESS_HI;
        let root_lo: *mut u32 = &mut TLB_SHOOTDOWN_ROOT_LO;
        let root_hi: *mut u32 = &mut TLB_SHOOTDOWN_ROOT_HI;
        let gen: *mut u32 = &mut TLB_SHOOTDOWN_GENERATION;
        x86_mmio_write32(tlb_u32_address(lo), address as u32);
        x86_mmio_write32(tlb_u32_address(hi), (address >> 32) as u32);
        x86_mmio_write32(tlb_u32_address(root_lo), root as u32);
        x86_mmio_write32(tlb_u32_address(root_hi), (root >> 32) as u32);
        __dma_fence();
        x86_mmio_write32(tlb_u32_address(gen), generation);
    }
    __dma_fence();
}

@system
fn tlb_shootdown_ack_value(slot: usize) -> u32 {
    if slot >= TLB_SHOOTDOWN_MAX_CPUS { return 0; }
    unsafe {
        let ack: *mut u32 = &mut TLB_SHOOTDOWN_ACK[slot];
        return x86_mmio_read32(tlb_u32_address(ack));
    }
}

@system
fn tlb_shootdown_wait_ack(generation: u32, requester_slot: usize, expected: u32) -> bool {
    if expected == 0 { return true; }
    let mut spins: u64 = 0;
    while spins < TLB_SHOOTDOWN_SPIN_LIMIT {
        let mut matched: u32 = 0;
        unsafe {
            let mut slot: usize = 0;
            while slot < TLB_SHOOTDOWN_MAX_CPUS {
                if slot != requester_slot && TLB_SHOOTDOWN_CPU_REGISTERED[slot] &&
                   TLB_SHOOTDOWN_CPU_ACTIVE[slot] &&
                   tlb_shootdown_ack_value(slot) == generation { matched += 1; }
                slot += 1;
            }
        }
        if matched == expected { return true; }
        x86_cpu_pause();
        spins += 1;
    }
    return false;
}

// Decide o conjunto remoto uma unica vez por slot. Root desconhecido (0) entra
// sempre no conjunto: a seletividade pode gerar trabalho extra, nunca falso
// negativo. Sem PCID, uma futura carga de CR3 descarta traducoes non-global de
// CPUs que nao estavam executando o root no instante desta publicacao.
@system
fn tlb_shootdown_send_address_space_targets(root: u64, requester_slot: usize) -> u32 {
    if root == 0 || requester_slot >= TLB_SHOOTDOWN_MAX_CPUS { return TLB_SHOOTDOWN_TARGET_FAILURE; }
    let mut expected: u32 = 0;
    unsafe {
        let mut slot: usize = 0;
        while slot < TLB_SHOOTDOWN_MAX_CPUS {
            if slot != requester_slot && TLB_SHOOTDOWN_CPU_REGISTERED[slot] &&
               TLB_SHOOTDOWN_CPU_ACTIVE[slot] {
                let published_root = TLB_SHOOTDOWN_CPU_ROOT[slot];
                if published_root == 0 || published_root == root {
                    if !xapic_ipi_send_fixed(
                        TLB_SHOOTDOWN_CPU_APIC_ID[slot],
                        TLB_SHOOTDOWN_VECTOR as u8
                    ) { return TLB_SHOOTDOWN_TARGET_FAILURE; }
                    expected += 1;
                }
            }
            slot += 1;
        }
    }
    return expected;
}

@system
fn tlb_shootdown_page(address: u64, root: u64) -> bool {
    if !tlb_shootdown_is_ready() || !x86_page_aligned(address) { return false; }
    if root != 0 && !x86_page_aligned(root) { return false; }
    let flags = tlb_shootdown_lock_irq();
    if flags == 0 { return false; }

    let active_count = tlb_shootdown_active_cpu_count();
    let generation = tlb_shootdown_next_generation();
    tlb_shootdown_publish(address, root, generation);
    let current_root = x86_read_cr3_raw() & X86_PAGE_ADDRESS_MASK;
    if root == 0 || current_root == root { x86_invlpg(address); }

    if active_count > 1 {
        let requester_slot = tlb_shootdown_slot_for_current_cpu();
        if requester_slot >= TLB_SHOOTDOWN_MAX_CPUS {
            tlb_shootdown_unlock_irq(flags);
            return false;
        }
        unsafe {
            if !TLB_SHOOTDOWN_CPU_ACTIVE[requester_slot] {
                tlb_shootdown_unlock_irq(flags);
                return false;
            }
            // O requester tambem refresca seu snapshot com o CR3 observado na
            // operacao, reduzindo estados desconhecidos sem depender do scheduler.
            TLB_SHOOTDOWN_CPU_ROOT[requester_slot] = current_root;
        }
        __dma_fence();

        let mut expected: u32 = 0;
        if root == 0 {
            expected = active_count - 1;
            if !xapic_ipi_is_ready() ||
               !xapic_ipi_send_fixed_all_excluding_self(TLB_SHOOTDOWN_VECTOR as u8) {
                tlb_shootdown_unlock_irq(flags);
                return false;
            }
        } else {
            expected = tlb_shootdown_send_address_space_targets(root, requester_slot);
            if expected == TLB_SHOOTDOWN_TARGET_FAILURE {
                tlb_shootdown_unlock_irq(flags);
                return false;
            }
        }
        if !tlb_shootdown_wait_ack(generation, requester_slot, expected) {
            tlb_shootdown_unlock_irq(flags);
            return false;
        }
    }
    tlb_shootdown_unlock_irq(flags);
    return true;
}

// Mapping compartilhado pela raiz do kernel e pelas copias supervisor herdadas.
// Continua broadcast: qualquer CPU ativa pode possuir uma traducao global.
@system
pub fn tlb_shootdown_kernel_page(address: u64) -> bool {
    return tlb_shootdown_page(address, 0);
}

// Mapping privado de processo. O transporte consulta o root publicado por CPU e
// envia IPI apenas para quem executa o root alvo ou ainda esta desconhecido.
@system
pub fn tlb_shootdown_address_space_page(root: u64, address: u64) -> bool {
    if root == 0 || !x86_page_aligned(root) { return false; }
    return tlb_shootdown_page(address, root);
}

@system
pub fn tlb_shootdown_handle_ipi() -> bool {
    if !tlb_shootdown_is_ready() { return false; }
    let slot = tlb_shootdown_slot_for_current_cpu();
    if slot >= TLB_SHOOTDOWN_MAX_CPUS { return false; }
    unsafe {
        if !TLB_SHOOTDOWN_CPU_ACTIVE[slot] { return false; }
        let lo: *mut u32 = &mut TLB_SHOOTDOWN_ADDRESS_LO;
        let hi: *mut u32 = &mut TLB_SHOOTDOWN_ADDRESS_HI;
        let root_lo: *mut u32 = &mut TLB_SHOOTDOWN_ROOT_LO;
        let root_hi: *mut u32 = &mut TLB_SHOOTDOWN_ROOT_HI;
        let gen: *mut u32 = &mut TLB_SHOOTDOWN_GENERATION;
        let address_lo = x86_mmio_read32(tlb_u32_address(lo)) as u64;
        let address_hi = x86_mmio_read32(tlb_u32_address(hi)) as u64;
        let target_root_lo = x86_mmio_read32(tlb_u32_address(root_lo)) as u64;
        let target_root_hi = x86_mmio_read32(tlb_u32_address(root_hi)) as u64;
        let generation = x86_mmio_read32(tlb_u32_address(gen));
        let address = address_lo | (address_hi << 32);
        let target_root = target_root_lo | (target_root_hi << 32);
        if address == 0 || generation == 0 || !x86_page_aligned(address) { return false; }
        if target_root != 0 && !x86_page_aligned(target_root) { return false; }
        let current_root = x86_read_cr3_raw() & X86_PAGE_ADDRESS_MASK;
        TLB_SHOOTDOWN_CPU_ROOT[slot] = current_root;
        if target_root == 0 || current_root == target_root { x86_invlpg(address); }
        __dma_fence();
        let ack: *mut u32 = &mut TLB_SHOOTDOWN_ACK[slot];
        x86_mmio_write32(tlb_u32_address(ack), generation);
    }
    __dma_fence();
    return true;
}
