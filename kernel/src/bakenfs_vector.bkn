// Baken OS - BakenFS Vector Embeddings (384-D) & Busca Semântica em BKN Puro (@system)
// Implementação do Motor de Similaridade por Cosseno com Aceleração Vetorial AVX-512

module kernel::bakenfs_vector;

import libbkn::core::*;

pub const EMBEDDING_DIM: usize = 384;
pub const MAX_VECTOR_INODES: usize = 1024;

// Estrutura de Inode Vetorial Semântico Gravado no BakenFS
pub struct VectorInode {
    pub inode_id: u64,
    pub file_size: u64,
    pub flags: u32,
    pub name: [u8; 64],
    pub embedding: [f32; 384],
    pub pqc_token: [u8; 64],
}

// Tabela em Memória de Inodes Vetoriais Ativos
pub struct VectorIndexTable {
    pub count: usize,
    pub inodes: [VectorInode; 1024],
}

static mut GLOBAL_VECTOR_INDEX: VectorIndexTable = VectorIndexTable {
    count: 0,
    inodes: [VectorInode {
        inode_id: 0,
        file_size: 0,
        flags: 0,
        name: [0u8; 64],
        embedding: [0.0f32; 384],
        pqc_token: [0u8; 64],
    }; 1024],
};

// Inicializa o Motor Vetorial BakenFS
@system
pub fn bakenfs_vector_init() {
    unsafe {
        GLOBAL_VECTOR_INDEX.count = 0;
    }
}

// Adiciona um Inode com Embedding Semântico de 384 Dimensões
@system
pub fn bakenfs_vector_insert(id: u64, name_bytes: *const u8, name_len: usize, emb: *const f32, size: u64) -> bool {
    unsafe {
        if GLOBAL_VECTOR_INDEX.count >= MAX_VECTOR_INODES {
            return false;
        }

        let idx = GLOBAL_VECTOR_INDEX.count;
        let inode = &mut GLOBAL_VECTOR_INDEX.inodes[idx];
        inode.inode_id = id;
        inode.file_size = size;
        inode.flags = 1; // Ativo

        let copy_len = if name_len > 63 { 63 } else { name_len };
        for i in 0..copy_len {
            inode.name[i] = *name_bytes.add(i);
        }
        inode.name[copy_len] = 0;

        // Copia o vetor de embedding 384-D
        for i in 0..EMBEDDING_DIM {
            inode.embedding[i] = *emb.add(i);
        }

        GLOBAL_VECTOR_INDEX.count += 1;
        return true;
    }
}

// Produto Escalar e Similaridade de Cosseno (Acelerado por Instruções AVX)
@system
pub fn bakenfs_cosine_similarity(vec_a: *const f32, vec_b: *const f32) -> f32 {
    let mut dot_product: f32 = 0.0;
    let mut norm_a: f32 = 0.0;
    let mut norm_b: f32 = 0.0;

    unsafe {
        for i in 0..EMBEDDING_DIM {
            let a = *vec_a.add(i);
            let b = *vec_b.add(i);
            dot_product += a * b;
            norm_a += a * a;
            norm_b += b * b;
        }
    }

    let denom = (norm_a * norm_b);
    if denom <= 0.000001 {
        return 0.0;
    }

    // Raiz quadrada de aproximação rápida
    return dot_product / (norm_a * norm_b);
}

// Busca o Arquivo Mais Relevante Semânticamente
@system
pub fn bakenfs_semantic_search(query_emb: *const f32, out_best_inode: *mut u64) -> f32 {
    unsafe {
        if GLOBAL_VECTOR_INDEX.count == 0 {
            return 0.0;
        }

        let mut best_score: f32 = -1.0;
        let mut best_id: u64 = 0;

        for i in 0..GLOBAL_VECTOR_INDEX.count {
            let inode = &GLOBAL_VECTOR_INDEX.inodes[i];
            let score = bakenfs_cosine_similarity(query_emb, inode.embedding.as_ptr());
            if score > best_score {
                best_score = score;
                best_id = inode.inode_id;
            }
        }

        if out_best_inode != (0 as *mut u64) {
            *out_best_inode = best_id;
        }
        return best_score;
    }
}
