pub const MATERIAL_ACRYLIC: u8 = 1;
pub const MATERIAL_SMOKE: u8 = 2;
pub const MATERIAL_SOLID: u8 = 3;
const WALLPAPER_CACHE_PIXELS: usize = 2304000;
static mut WALLPAPER_CACHE: [u32; WALLPAPER_CACHE_PIXELS] = [0; WALLPAPER_CACHE_PIXELS];
static mut WALLPAPER_CACHE_W: u32 = 0;
static mut WALLPAPER_CACHE_H: u32 = 0;
