@system
pub fn gfx_bind_font_atlas(advances: *const u8, alpha: *const u8,
                           cell_w: u32, cell_h: u32, px: u32) -> u8 {
    if (advances == (null as *const u8) || alpha == (null as *const u8) ||
        cell_w == 0 || cell_h == 0 || px == 0) { return 0; }
    unsafe {
        FONT_ADVANCES = advances;
        FONT_ALPHA = alpha;
        FONT_CELL_W = cell_w;
        FONT_CELL_H = cell_h;
        FONT_PX = px;
    }
    return 1;
}

@system
pub fn gfx_bind_logo_atlas(pixels: *const u32, size: u32) -> u8 {
    if (pixels == (null as *const u32) || size == 0) { return 0; }
    unsafe {
        LOGO_PIXELS = pixels;
        LOGO_SIZE = size;
    }
    return 1;
}

@inline
fn bilerp_channel(p00: u32, p10: u32, p01: u32, p11: u32,
                  shift: u32, wx: u32, wy: u32) -> u32 {
    let a = ((((p00 >> shift) & 255) * (256 - wx)) + (((p10 >> shift) & 255) * wx)) >> 8;
    let b = ((((p01 >> shift) & 255) * (256 - wx)) + (((p11 >> shift) & 255) * wx)) >> 8;
    return ((a * (256 - wy)) + (b * wy)) >> 8;
}

@system
pub fn gfx_draw_baken_logo(x: u32, y: u32, size: u32, opacity: u8) -> void {
    if (size == 0 || opacity == 0) { return; }
    unsafe {
        if (LOGO_PIXELS == (null as *const u32) || LOGO_SIZE == 0) {
            // Vetor procedural elegante com gradiente concentrico neon Baken OS
            let r = size / 2;
            gfx_draw_circle_alpha(x + r, y + r, r, 0x007C6CFF, opacity / 4);
            gfx_draw_circle_alpha(x + r - r / 5, y + r - r / 6, (r * 2) / 3, 0x004CC9F0, opacity);
            gfx_draw_circle_alpha(x + r + r / 4, y + r + r / 5, r / 2, 0x007C6CFF, opacity);
            gfx_draw_circle_alpha(x + r, y + r, r / 3, 0x000F172A, opacity);
            return;
        }
        let denom = if (size > 1) { size - 1 } else { 1 };
        for mut dy in 0..size {
            let fy = (dy * (LOGO_SIZE - 1) * 256) / denom;
            let sy = fy >> 8;
            let wy = fy & 255;
            let sy1 = if (sy + 1 < LOGO_SIZE) { sy + 1 } else { sy };
            for mut dx in 0..size {
                let fx = (dx * (LOGO_SIZE - 1) * 256) / denom;
                let sx = fx >> 8;
                let wx = fx & 255;
                let sx1 = if (sx + 1 < LOGO_SIZE) { sx + 1 } else { sx };
                let p00 = *LOGO_PIXELS.add((sy * LOGO_SIZE + sx) as usize);
                let p10 = *LOGO_PIXELS.add((sy * LOGO_SIZE + sx1) as usize);
                let p01 = *LOGO_PIXELS.add((sy1 * LOGO_SIZE + sx) as usize);
                let p11 = *LOGO_PIXELS.add((sy1 * LOGO_SIZE + sx1) as usize);
                let src_a = bilerp_channel(p00, p10, p01, p11, 24, wx, wy) as u8;
                if (src_a != 0) {
                    let final_a = (((src_a as u32) * (opacity as u32)) / 255) as u8;
                    let rgb = (bilerp_channel(p00, p10, p01, p11, 16, wx, wy) << 16) |
                              (bilerp_channel(p00, p10, p01, p11, 8, wx, wy) << 8) |
                               bilerp_channel(p00, p10, p01, p11, 0, wx, wy);
                    gfx_put_pixel_alpha(x + dx, y + dy, rgb, final_a);
                }
            }
        }
    }
}

// Funcoes auxiliares matematicas
@inline
fn abs_i32(x: i32) -> i32 {
    if (x < 0) { return -x; }
    return x;
}

@inline
fn max_f32(a: f32, b: f32) -> f32 {
    if (a > b) { return a; }
    return b;
}

@system
pub fn gfx_blend_color(bg: u32, fg: u32, alpha: u8) -> u32 {
    let a: u32 = alpha as u32;
    let inv_a: u32 = 255 - a;

    let bg_r: u32 = (bg >> 16) & 0xFF;
    let bg_g: u32 = (bg >> 8) & 0xFF;
    let bg_b: u32 = bg & 0xFF;

    let fg_r: u32 = (fg >> 16) & 0xFF;
    let fg_g: u32 = (fg >> 8) & 0xFF;
    let fg_b: u32 = fg & 0xFF;

    let out_r: u32 = ((fg_r * a) + (bg_r * inv_a)) / 255;
    let out_g: u32 = ((fg_g * a) + (bg_g * inv_a)) / 255;
    let out_b: u32 = ((fg_b * a) + (bg_b * inv_a)) / 255;

    return (0xFF << 24) | (out_r << 16) | (out_g << 8) | out_b;
}

@system
pub fn gfx_put_pixel_alpha(x: u32, y: u32, color: u32, alpha: u8) -> void {
    if (alpha == 0) { return; }
    if (x >= gfx_get_width() || y >= gfx_get_height()) { return; }
    if (alpha == 255) {
        gfx_put_pixel(x, y, color);
        return;
    }
    let current = gfx_get_pixel(x, y);
    let blended = gfx_blend_color(current, color, alpha);
    gfx_put_pixel(x, y, blended);
}

@system
pub fn gfx_fill_rect(x: u32, y: u32, w: u32, h: u32, color: u32) -> void {
    let sw = gfx_get_width();
    let sh = gfx_get_height();
    let max_x = if (x + w > sw) { sw } else { x + w };
    let max_y = if (y + h > sh) { sh } else { y + h };

    for mut py in y..max_y {
        for mut px in x..max_x {
            gfx_put_pixel(px, py, color);
        }
    }
}

@system
pub fn gfx_fill_rect_alpha(x: u32, y: u32, w: u32, h: u32, color: u32, alpha: u8) -> void {
    if (alpha == 0) { return; }
    let sw = gfx_get_width();
    let sh = gfx_get_height();
    let max_x = if (x + w > sw) { sw } else { x + w };
    let max_y = if (y + h > sh) { sh } else { y + h };

    for mut py in y..max_y {
        for mut px in x..max_x {
            gfx_put_pixel_alpha(px, py, color, alpha);
        }
    }
}

@system
pub fn gfx_draw_hline(x: u32, y: u32, width: u32, color: u32, alpha: u8) -> void {
    gfx_fill_rect_alpha(x, y, width, 1, color, alpha);
}

// Sombra Suave Volumetrica (Drop Shadow) com Gravidade (Y-Offset)
@system
pub fn gfx_draw_drop_shadow(x: u32, y: u32, w: u32, h: u32, blur: u32, spread: u32, offset_y: i32, max_alpha_factor: f32) -> void {
    let sw = gfx_get_width();
    let sh = gfx_get_height();
    let base_y = (y as i32 + offset_y) as u32;
    let sx = if (x > blur + spread) { x - blur - spread } else { 0 };
    let sy = if (base_y > blur + spread) { base_y - blur - spread } else { 0 };
    let ex = if (x + w + blur + spread > sw) { sw } else { x + w + blur + spread };
    let ey = if (base_y + h + blur + spread > sh) { sh } else { base_y + h + blur + spread };

    let total_rad = blur + spread;
    let max_dist_sq = (total_rad * total_rad) as i32;
    if (max_dist_sq <= 0) { return; }

    for mut py in sy..ey {
        for mut px in sx..ex {
            let qx = if (px < x) { (x - px) as i32 } else if (px > x + w) { (px - (x + w)) as i32 } else { 0 };
            let qy = if (py < base_y) { (base_y - py) as i32 } else if (py > base_y + h) { (py - (base_y + h)) as i32 } else { 0 };
            let dist_sq = (qx * qx + qy * qy);
            
            if (dist_sq < max_dist_sq && dist_sq > 0) {
                let falloff_num = max_dist_sq - dist_sq;
                let alpha = (((falloff_num * 90) / max_dist_sq) as u32);
                let final_a = (((alpha as f32) * max_alpha_factor) as u8);
                if (final_a > 4) {
                    gfx_put_pixel_alpha(px, py, 0x00000000, final_a);
                }
            }
        }
    }
}

// Sombra Fisica calculada pelo Eixo-Z
@system
pub fn gfx_draw_physical_shadow(x: u32, y: u32, w: u32, h: u32, elevation: u32) -> void {
    if (elevation == 0) { return; }
    let blur = elevation;
    let spread = elevation / 4;
    let offset_y = (elevation / 3) as i32; 
    let max_alpha = 1.0 - ((elevation as f32) / 100.0);
    let final_alpha = if (max_alpha < 0.2) { 0.2 } else { max_alpha };
    
    gfx_draw_drop_shadow(x, y, w, h, blur, spread, offset_y, final_alpha);
}

// Retangulo com vidro fosco acrilico, cantos arredondados e borda com destaque especular superior
@system
pub fn gfx_draw_glass_rect(x: u32, y: u32, w: u32, h: u32, bg_color: u32, alpha: u8, border_color: u32, radius: u32) -> void {
    let sw = gfx_get_width();
    let sh = gfx_get_height();
    if (x >= sw || y >= sh || w == 0 || h == 0) { return; }

    let max_x = if (x + w > sw) { sw } else { x + w };
    let max_y = if (y + h > sh) { sh } else { y + h };
    let r2 = (radius * radius) as i32;
    let inner_r = if (radius > 1) { radius - 1 } else { 0 };
    let inner_r2 = (inner_r * inner_r) as i32;
    let glass_a = if (alpha > 245) { 240 } else { alpha };

    for mut py in y..max_y {
        let rel_y_pct = ((py - y) * 255) / (if (h > 0) { h } else { 1 });

        for mut px in x..max_x {
            let mut is_corner = false;
            let mut inside = true;

            let cx = if (px < x + radius) { x + radius } else if (px > x + w - radius) { x + w - radius } else { px };
            let cy = if (py < y + radius) { y + radius } else if (py > y + h - radius) { y + h - radius } else { py };

            if (cx != px || cy != py) {
                is_corner = true;
                let dx = px as i32 - cx as i32;
                let dy = py as i32 - cy as i32;
                if ((dx * dx + dy * dy) > r2) {
                    inside = false;
                }
            }

            if (inside) {
                let mut is_border = (px == x || px == x + w - 1 || py == y || py == y + h - 1);
                if (is_corner) {
                    let dx = px as i32 - cx as i32;
                    let dy = py as i32 - cy as i32;
                    if ((dx * dx + dy * dy) >= inner_r2) {
                        is_border = true;
                    }
                }

                if (is_border) {
                    // Gradiente especular sutil na borda superior (Liquid Glass)
                    let spec = (255 - rel_y_pct);
                    let b_col = if (spec > 180) { 0x00FFFFFF } else { border_color };
                    let b_alpha = (140 + (spec / 3)) as u8;
                    gfx_put_pixel_alpha(px, py, b_col, b_alpha);
                } else {
                    gfx_put_pixel_alpha(px, py, bg_color, glass_a);
                }
            }
        }
    }
}

// Adaptador canonico para paineis liquidos usados pelo WindowManager.
@system
pub fn sdf_render_liquid_glass_panel(framebuffer: *mut u32, pitch: u32,
                                     x: u32, y: u32, w: u32, h: u32, radius: u32,
                                     bg_color: u32, alpha: u8, border_color: u32,
                                     glow: u8, outline: u32) -> void {
    if (framebuffer == (null as *mut u32) || pitch == 0) { return; }
    gfx_draw_physical_shadow(x, y, w, h, ELEVATION_WINDOW_INACTIVE);
    gfx_draw_glass_rect(x, y, w, h, bg_color, alpha, border_color, radius);
    if (outline > 1 && w > 2 && h > 2 && radius > 0) {
        gfx_draw_glass_rect(x + 1, y + 1, w - 2, h - 2, bg_color, 0, border_color, radius - 1);
    }
}

// Renderiza Materiais Inteligentes com base no Z-Axis (Elevacao)
@system
pub fn gfx_draw_smart_material(x: u32, y: u32, w: u32, h: u32, material: u8, elevation: u32, radius: u32) -> void {
    // 1. Projeta a sombra fisica com gravidade baseada na elevacao
    gfx_draw_physical_shadow(x, y, w, h, elevation);

    // 2. Renderiza o material correto
    if (material == MATERIAL_MICA) {
        let is_active = (elevation == ELEVATION_WINDOW_ACTIVE);
        let mica_bg = if (is_active) { 0x001E293B } else { 0x000F172A };
        let border = if (is_active) { 0x0000E5FF } else { 0x00334155 };
        gfx_draw_glass_rect(x, y, w, h, mica_bg, 245, border, radius);
    } else if (material == MATERIAL_ACRYLIC) {
        let acrylic_bg = 0x00172232; 
        gfx_draw_glass_rect(x, y, w, h, acrylic_bg, 180, 0x0038BDF8, radius);
    } else if (material == MATERIAL_SMOKE) {
        gfx_fill_rect_alpha(x, y, w, h, 0x00000000, 140);
    } else {
        gfx_fill_rect(x, y, w, h, 0x00FFFFFF);
    }
}

// Circulo com antialiasing
@system
pub fn gfx_draw_circle_alpha(cx: u32, cy: u32, radius: u32, color: u32, alpha: u8) -> void {
    if (alpha == 0) { return; }
    let r2 = (radius * radius) as i32;
    for mut dy in 0 .. (radius * 2 + 1) {
        for mut dx in 0 .. (radius * 2 + 1) {
            if (cx + dx < radius || cy + dy < radius) { continue; }
            let px = cx + dx - radius;
            let py = cy + dy - radius;
            let ix = dx as i32 - radius as i32;
            let iy = dy as i32 - radius as i32;
            let dist = (ix * ix) + (iy * iy);
            if (dist <= r2) {
                gfx_put_pixel_alpha(px, py, color, alpha);
            }
        }
    }
}

@system
pub fn gfx_draw_circle_button(cx: u32, cy: u32, radius: u32, color: u32) -> void {
    gfx_draw_circle_alpha(cx, cy, radius, color, 255);
    if (radius > 2) { gfx_draw_circle_alpha(cx, cy, radius - 2, 0x00FFFFFF, 70); }
}

// Desenha um caractere com suavizacao ou bitmap fallback
@system
pub fn gfx_draw_char_aa(x: u32, y: u32, ch: u8, color: u32) -> void {
    gfx_draw_char_atlas(x, y, ch, color, 255, 1);
}

@system
fn gfx_draw_char_atlas(x: u32, y: u32, ch: u8, color: u32,
                       opacity: u8, scale: u32) -> void {
    if (opacity == 0 || scale == 0) { return; }
    unsafe {
        if (FONT_ALPHA != (null as *const u8) && FONT_CELL_W > 0 && FONT_CELL_H > 0) {
            let glyph_base = (ch as u32) * FONT_CELL_W * FONT_CELL_H;
            for mut gy in 0..FONT_CELL_H {
                for mut gx in 0..FONT_CELL_W {
                    let coverage = *FONT_ALPHA.add((glyph_base + gy * FONT_CELL_W + gx) as usize);
                    if (coverage != 0) {
                        let a = (((coverage as u32) * (opacity as u32)) / 255) as u8;
                        gfx_fill_rect_alpha(x + gx * scale, y + gy * scale, scale, scale, color, a);
                    }
                }
            }
            return;
        }

        // Fallback 100% legivel usando tabela bitmap de alta precisao
        if (ch >= 32 && ch <= 126) {
            let idx = ((ch - 32) as usize) * 8;
            for mut row in 0..8 {
                let row_bits = FONT_FALLBACK_GLYPHS[idx + row as usize];
                if (row_bits != 0) {
                    for mut col in 0..8 {
                        if ((row_bits & (0x80 >> col)) != 0) {
                            gfx_fill_rect_alpha(x + col * scale, y + row * scale, scale, scale, color, opacity);
                        }
                    }
                }
            }
        } else {
            // Caractere desconhecido / retangulo discreto
            gfx_draw_glass_rect(x, y, 6 * scale, 8 * scale, 0x00000000, 0, color, 1);
        }
    }
}

@inline
fn glyph_advance(ch: u8) -> u32 {
    unsafe {
        if (FONT_ADVANCES != (null as *const u8)) {
            let a = (*FONT_ADVANCES.add(ch as usize)) as u32;
            if (a > 0) { return a; }
        }
    }
    return 7;
}

// Desenha uma sombra suave gaussiana multicamada baseada em SDF
@system
pub fn gfx_draw_smooth_shadow(x: i32, y: i32, w: i32, h: i32, radius: i32, blur: i32, max_alpha: u8) -> void {
    if (w <= 0 || h <= 0 || blur <= 0 || max_alpha == 0) { return; }
    let ux = if (x < 0) { 0 } else { x as u32 };
    let uy = if (y < 0) { 0 } else { y as u32 };
    gfx_draw_drop_shadow(ux, uy, w as u32, h as u32, blur as u32, 0, 0, (max_alpha as f32) / 255.0);
}

// Desenha Textos usando renderizacao proporcional suavizada
@system
pub fn gfx_draw_text_proportional(x: u32, y: u32, text_ptr: *const u8, color: u32) -> void {
    gfx_draw_text(x, y, text_ptr, color);
}

// Desenha Textos usando decodificacao UTF-8 nativa para Portugues, Espanhol, Alemao, etc.
@system
pub fn gfx_draw_text(x: u32, y: u32, text_ptr: *const u8, color: u32) -> void {
    if (text_ptr == (null as *const u8)) { return; }
    let mut px = x;
    let mut i = 0;
    unsafe {
        while (*text_ptr.add(i) != 0) {
            let b0 = *text_ptr.add(i);
            if (b0 == 0xC3 && *text_ptr.add(i + 1) != 0) {
                let b1 = *text_ptr.add(i + 1);
                let glyph_code = 128 + (b1 & 0x3F);
                gfx_draw_char_atlas(px, y, glyph_code, color, 255, 1);
                i += 2;
                px += glyph_advance(glyph_code);
            } else {
                gfx_draw_char_atlas(px, y, b0, color, 255, 1);
                i += 1;
                px += glyph_advance(b0);
            }
        }
    }
}

@system
pub fn gfx_draw_text_alpha(x: u32, y: u32, text_ptr: *const u8, color: u32, scale: u32, alpha: u8) -> void {
    if (alpha == 0 || scale == 0 || text_ptr == (null as *const u8)) { return; }
    let mut px = x;
    let mut i = 0;
    unsafe {
        while (*text_ptr.add(i) != 0) {
            let b0 = *text_ptr.add(i);
            if (b0 == 0xC3 && *text_ptr.add(i + 1) != 0) {
                let glyph_code = 128 + (*text_ptr.add(i + 1) & 0x3F);
                gfx_draw_char_atlas(px, y, glyph_code, color, alpha, scale);
                px += glyph_advance(glyph_code) * scale;
                i += 2;
            } else {
                gfx_draw_char_atlas(px, y, b0, color, alpha, scale);
                px += glyph_advance(b0) * scale;
                i += 1;
            }
        }
    }
}

// Papel de parede em malha de cores do Baken OS
@system
pub fn gfx_draw_mesh_wallpaper() -> void {
    let sw = gfx_get_width();
    let sh = gfx_get_height();

    // O gradiente com ponto flutuante é calculado uma vez. Nos quadros
    // seguintes, uma cópia linear restaura o fundo sem picos de frame time.
    unsafe {
        if WALLPAPER_CACHE_W == sw && WALLPAPER_CACHE_H == sh {
            let target = gfx_get_backbuffer();
            let pitch = gfx_get_pitch();
            for mut cache_y in 0..sh {
                for mut cache_x in 0..sw {
                    *(target + (cache_y * pitch + cache_x) as usize) = WALLPAPER_CACHE[(cache_y * sw + cache_x) as usize];
                }
            }
            return;
        }
    }

    for mut py in 0..sh {
        let ny = (py as f32) / (sh as f32);
        for mut px in 0..sw {
            let nx = (px as f32) / (sw as f32);

            let w_cyan = (1.0 - nx) * (1.0 - ny);
            let w_pink = (nx * 0.75 + ny * 0.55) * (1.0 - (nx * ny * 0.8));
            let mut w_gold = nx * ny * 1.35;
            if (w_gold > 1.0) { w_gold = 1.0; }

            let mut r = (0x00 as f32 * w_cyan) + (0xE8 as f32 * w_pink) + (0xFD as f32 * w_gold);
            let mut g = (0xD2 as f32 * w_cyan) + (0x79 as f32 * w_pink) + (0xC4 as f32 * w_gold);
            let mut b = (0xFF as f32 * w_cyan) + (0xF9 as f32 * w_pink) + (0x67 as f32 * w_gold);

            if (r > 255.0) { r = 255.0; }
            if (g > 255.0) { g = 255.0; }
            if (b > 255.0) { b = 255.0; }

            let color = (0xFF << 24) | ((r as u32) << 16) | ((g as u32) << 8) | (b as u32);
            gfx_put_pixel(px, py, color);
            unsafe { WALLPAPER_CACHE[(py * sw + px) as usize] = color; }
        }
    }
    unsafe { WALLPAPER_CACHE_W = sw; WALLPAPER_CACHE_H = sh; }
}

// Fundo Espacial com Gradiente Aurora Dinamico e Orbes em Parallax
@system
pub fn gfx_draw_aurora_parallax_bg(x: u32, y: u32, w: u32, h: u32, tick: u32) -> void {
    // 1. Base Profunda Midnight Slate
    gfx_fill_rect_alpha(x, y, w, h, 0x00070B14, 255);

    // 2. Orbe 1: Ciano Polar em Orbita (Superior Esquerdo)
    let ox1 = (x as i32) + (w as i32 / 4) + gfx_wave_i32(tick, 260, (w / 14) as i32);
    let oy1 = (y as i32) + (h as i32 / 3) + gfx_wave_i32(tick + 70, 220, (h / 12) as i32);
    if (ox1 > 0 && oy1 > 0) {
        gfx_draw_circle_alpha(ox1 as u32, oy1 as u32, 160, 0x000284C7, 36);
        gfx_draw_circle_alpha(ox1 as u32, oy1 as u32, 95, 0x0038BDF8, 55);
        gfx_draw_circle_alpha(ox1 as u32, oy1 as u32, 40, 0x0000E5FF, 80);
    }

    // 3. Orbe 2: Violeta Aurora Nebular em Orbita (Superior Direito)
    let ox2 = (x as i32) + ((w as i32 * 3) / 4) + gfx_wave_i32(tick + 130, 300, (w / 12) as i32);
    let oy2 = (y as i32) + (h as i32 / 4) + gfx_wave_i32(tick + 20, 240, (h / 10) as i32);
    if (ox2 > 0 && oy2 > 0) {
        gfx_draw_circle_alpha(ox2 as u32, oy2 as u32, 175, 0x004F46E5, 32);
        gfx_draw_circle_alpha(ox2 as u32, oy2 as u32, 110, 0x007C6CFF, 48);
        gfx_draw_circle_alpha(ox2 as u32, oy2 as u32, 50, 0x00A855F7, 70);
    }

    // 4. Orbe 3: Esmeralda Suave em Parallax (Inferior Esquerdo/Centro)
    let ox3 = (x as i32) + (w as i32 / 3) + gfx_wave_i32(tick + 190, 280, (w / 10) as i32);
    let oy3 = (y as i32) + ((h as i32 * 3) / 4) + gfx_wave_i32(tick + 110, 230, (h / 14) as i32);
    if (ox3 > 0 && oy3 > 0) {
        gfx_draw_circle_alpha(ox3 as u32, oy3 as u32, 140, 0x00065F46, 28);
        gfx_draw_circle_alpha(ox3 as u32, oy3 as u32, 80, 0x0010B981, 45);
    }

    // 5. Orbe 4: Ciano Brilhante (Inferior Direito)
    let ox4 = (x as i32) + ((w as i32 * 4) / 5) + gfx_wave_i32(tick + 50, 200, (w / 16) as i32);
    let oy4 = (y as i32) + ((h as i32 * 2) / 3) + gfx_wave_i32(tick + 150, 210, (h / 15) as i32);
    if (ox4 > 0 && oy4 > 0) {
        gfx_draw_circle_alpha(ox4 as u32, oy4 as u32, 120, 0x000369A1, 30);
        gfx_draw_circle_alpha(ox4 as u32, oy4 as u32, 65, 0x0038BDF8, 50);
    }
}

// Renderiza Icones Vetoriais/SDF para os Aplicativos Nativos do Sistema
@system
pub fn gfx_draw_app_icon_hd(x: u32, y: u32, size: u32, app_id: u32) -> void {
    let id = app_id % 6;
    if (id == 0) {
        // App 0: Arquivos (Pasta macOS com bolso frontal e chanfro)
        gfx_draw_glass_rect_material(x + 2, y + 2, 14, 8, 0x000284C7, 255, 0x00FFFFFF, 3);
        gfx_draw_glass_rect_material(x + 2, y + 6, 28, 22, 0x0038BDF8, 255, 0x00E0F2FE, 5);
        gfx_draw_glass_rect_material(x + 2, y + 12, 28, 16, 0x00BAE6FD, 230, 0x00FFFFFF, 4);
    } else if (id == 1) {
        // App 1: Notas (Folha acetinada com canto dobrado e linhas)
        gfx_draw_glass_rect_material(x + 5, y + 2, 22, 28, 0x00F8FAFC, 255, 0x00CBD5E1, 4);
        gfx_draw_glass_rect_material(x + 19, y + 2, 8, 8, 0x00E2E8F0, 255, 0x0094A3B8, 2);
        gfx_draw_glass_rect_material(x + 9, y + 12, 14, 2, 0x00334155, 220, 0x0064748B, 1);
        gfx_draw_glass_rect_material(x + 9, y + 17, 14, 2, 0x00334155, 220, 0x0064748B, 1);
        gfx_draw_glass_rect_material(x + 9, y + 22, 10, 2, 0x0038BDF8, 240, 0x000284C7, 1);
    } else if (id == 2) {
        // App 2: Ajustes (Painel indigo com sliders de ajuste)
        gfx_draw_glass_rect_material(x + 2, y + 2, 28, 28, 0x006366F1, 255, 0x00A5B4FC, 6);
        gfx_draw_glass_rect_material(x + 6, y + 10, 20, 3, 0x00312E81, 255, 0x001E1B4B, 1);
        gfx_draw_glass_rect_material(x + 6, y + 19, 20, 3, 0x00312E81, 255, 0x001E1B4B, 1);
        gfx_draw_circle_alpha(x + 12, y + 11, 4, 0x00FFFFFF, 255);
        gfx_draw_circle_alpha(x + 12, y + 11, 2, 0x006366F1, 255);
        gfx_draw_circle_alpha(x + 20, y + 20, 4, 0x00FFFFFF, 255);
        gfx_draw_circle_alpha(x + 20, y + 20, 2, 0x006366F1, 255);
    } else if (id == 3) {
        // App 3: Midia / Camera (Chassi verde esmeralda com lente concentrica)
        gfx_draw_glass_rect_material(x + 2, y + 2, 28, 28, 0x0010B981, 255, 0x006EE7B7, 6);
        gfx_draw_circle_alpha(x + 16, y + 16, 9, 0x00064E3B, 255);
        gfx_draw_circle_alpha(x + 16, y + 16, 6, 0x000F172A, 255);
        gfx_draw_circle_alpha(x + 16, y + 16, 3, 0x0038BDF8, 255);
        gfx_draw_circle_alpha(x + 13, y + 13, 2, 0x00FFFFFF, 255);
    } else if (id == 4) {
        // App 4: Sobre / Info
        gfx_draw_glass_rect_material(x + 2, y + 2, 28, 28, 0x000284C7, 255, 0x0038BDF8, 6);
        gfx_draw_circle_alpha(x + 16, y + 9, 3, 0x00FFFFFF, 255);
        gfx_draw_glass_rect_material(x + 14, y + 14, 4, 11, 0x00FFFFFF, 255, 0x00FFFFFF, 2);
    } else {
        gfx_draw_glass_rect_material(x + 2, y + 2, 28, 28, 0x008B5CF6, 255, 0x00C4B5FD, 6);
        gfx_draw_circle_alpha(x + 16, y + 16, 7, 0x00FFFFFF, 255);
    }
}

@system
pub fn gfx_draw_app_icon(x: u32, y: u32, size: u32, app_id: u32) -> void {
    gfx_draw_app_icon_hd(x, y, size, app_id);
}

@system
pub fn gfx_draw_glass_rect_material(x: u32, y: u32, w: u32, h: u32, bg: u32, a: u8, border: u32, radius: u32) -> void {
    gfx_draw_glass_rect(x, y, w, h, bg, a, border, radius);
}

@system
pub fn gfx_measure_text(str: *const u8) -> u32 {
    if (str == (null as *const u8)) { return 0; }
    let mut width: u32 = 0;
    let mut i: usize = 0;
    unsafe {
        while (*str.add(i) != 0) {
            let b0 = *str.add(i);
            if (b0 == 0xC3 && *str.add(i + 1) != 0) {
                width += glyph_advance(128 + (*str.add(i + 1) & 0x3F));
                i += 2;
            } else {
                width += glyph_advance(b0);
                i += 1;
            }
        }
    }
    return width;
}

@system
pub fn gfx_measure_text_role(str: *const u8, role: u32) -> u32 {
    return gfx_measure_text(str);
}
