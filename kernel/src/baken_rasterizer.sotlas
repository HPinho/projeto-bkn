// Baken OS - Rasterizador Vetorial e Efeitos Visuais (BakenFX)
// Renderizacao Linear 32-bit ARGB8888, SDF Anti-Aliasing, Glassmorphism, Sombras e Gradientes Mesh

module kernel::baken_rasterizer;

import kernel::graphics_engine::*;

// --- Constantes Fisicas do Baken OS (Fluent/HIG) ---
pub const ELEVATION_WALLPAPER: u32 = 0;
pub const ELEVATION_DESKTOP: u32 = 1;
pub const ELEVATION_DOCK: u32 = 8;
pub const ELEVATION_CARD: u32 = 12;
pub const ELEVATION_WINDOW_INACTIVE: u32 = 16;
pub const ELEVATION_WINDOW_ACTIVE: u32 = 24;
pub const ELEVATION_MODAL_MENU: u32 = 32;

pub const MATERIAL_MICA: u8 = 0;
pub const MATERIAL_ACRYLIC: u8 = 1;
pub const MATERIAL_SMOKE: u8 = 2;
pub const MATERIAL_SOLID: u8 = 3;
pub const WALLPAPER_CACHE_PIXELS: usize = 1;
pub static mut WALLPAPER_CACHE: [u32; 1] = [0; 1];
pub static mut WALLPAPER_CACHE_W: u32 = 0;
pub static mut WALLPAPER_CACHE_H: u32 = 0;
// ----------------------------------------------------

// Interpolador inteiro para efeitos do rasterizador sem depender de libm.
// Retorna smoothstep(phase / duration) no intervalo 0..255.
@inline
pub fn raster_smoothstep_u8(phase: u32, duration: u32) -> u8 {
    if (duration == 0 || phase >= duration) { return 255; }
    let t = (phase * 255) / duration;
    return ((t * t * (765 - 2 * t)) / 65025) as u8;
}

// Onda senoidal/triangular suave em aritmética inteira no intervalo [-amp, +amp]
@inline
pub fn raster_wave_i32(phase: u32, period: u32, amp: i32) -> i32 {
    if (period == 0 || amp == 0) { return 0; }
    let p = phase % period;
    let half = period / 2;
    if (half == 0) { return 0; }
    if (p < half) {
        let s = raster_smoothstep_u8(p, half) as i32;
        return -amp + ((2 * amp * s) / 255);
    } else {
        let s = raster_smoothstep_u8(p - half, half) as i32;
        return amp - ((2 * amp * s) / 255);
    }
}

