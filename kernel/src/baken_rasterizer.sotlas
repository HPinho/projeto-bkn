// Interpolador inteiro para efeitos do rasterizador sem depender de libm.
// Retorna smoothstep(phase / duration) no intervalo 0..255.
@inline
pub fn gfx_smoothstep_u8(phase: u32, duration: u32) -> u8 {
    if (duration == 0 || phase >= duration) { return 255; }
    let t = (phase * 255) / duration;
    return ((t * t * (765 - 2 * t)) / 65025) as u8;
}

// Onda senoidal/triangular suave em aritmética inteira no intervalo [-amp, +amp]
@inline
pub fn gfx_wave_i32(phase: u32, period: u32, amp: i32) -> i32 {
    if (period == 0 || amp == 0) { return 0; }
    let p = phase % period;
    let half = period / 2;
    if (half == 0) { return 0; }
    if (p < half) {
        let s = gfx_smoothstep_u8(p, half) as i32;
        return -amp + ((2 * amp * s) / 255);
    } else {
        let s = gfx_smoothstep_u8(p - half, half) as i32;
        return amp - ((2 * amp * s) / 255);
    }
}

