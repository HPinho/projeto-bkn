// Baken OS - Motor Gráfico de Pixels de Alta Definição em Sotlas (@system)
// Renderização Linear 32-bit ARGB8888.
// A rota gráfica inicial usa o framebuffer GOP diretamente. Double buffering
// só pode ser ligado após o PMM ser inicializado com um mapa de memória UEFI
// válido; alocar páginas antes disso corrompe a inicialização.

module kernel::graphics_engine;

const GFX_MAX_WIDTH: u32 = 1920;
const GFX_MAX_HEIGHT: u32 = 1200;
const GFX_BUFFER_PIXELS: usize = 2304000;

static mut BACKBUFFER_STORAGE: [u32; GFX_BUFFER_PIXELS] = [0; GFX_BUFFER_PIXELS];
static mut TRANSITION_SNAPSHOT: [u32; GFX_BUFFER_PIXELS] = [0; GFX_BUFFER_PIXELS];


pub struct FramebufferConfig {
    pub base: *mut u32;
    pub backbuffer: *mut u32;
    pub width: u32;
    pub height: u32;
    pub pitch: u32;
    pub use_double_buffering: bool;
}

static mut FB: FramebufferConfig = FramebufferConfig {
    base: null as *mut u32,
    backbuffer: null as *mut u32,
    width: 1920,
    height: 1080,
    pitch: 1920,
    use_double_buffering: false
};

@system
pub fn gfx_init(base: *mut u32, width: u32, height: u32, pitch: u32) -> void {
    unsafe {
        FB.base = base;
        FB.width = width;
        FB.height = height;
        FB.pitch = pitch;

        FB.use_double_buffering = width <= GFX_MAX_WIDTH && height <= GFX_MAX_HEIGHT && pitch <= GFX_MAX_WIDTH;
        FB.backbuffer = if FB.use_double_buffering { BACKBUFFER_STORAGE.as_ptr() } else { base };
    }
}

@system
pub fn gfx_get_backbuffer() -> *mut u32 {
    unsafe {
        return FB.backbuffer;
    }
}

@system
pub fn gfx_get_pitch() -> u32 {
    unsafe {
        return FB.pitch;
    }
}

@system
pub fn gfx_get_width() -> u32 {
    unsafe {
        return FB.width;
    }
}

@system
pub fn gfx_get_height() -> u32 {
    unsafe {
        return FB.height;
    }
}

// Mantém o contrato da API. Na fase GOP direta não há buffer secundário.
@system
pub fn gfx_swap_buffers() -> void {
    unsafe {
        if (!FB.use_double_buffering || FB.backbuffer == null as *mut u32 || FB.base == null as *mut u32) { return; }
        
        let total_u64 = (FB.pitch * FB.height * 4 / 8) as usize;
        let src_u64 = FB.backbuffer as *const u64;
        let dst_u64 = FB.base as *mut u64;

        for mut i in 0 .. total_u64 {
            *(dst_u64 + i) = *(src_u64 + i);
        }
    }
}

@system
pub fn gfx_transition_capture() -> void {
    unsafe {
        if !FB.use_double_buffering || FB.backbuffer == (null as *mut u32) { return; }
        let total = (FB.pitch * FB.height) as usize;
        for mut i in 0..total { TRANSITION_SNAPSHOT[i] = *(FB.backbuffer + i); }
    }
}

@system
pub fn gfx_transition_composite(old_alpha: u8, slide_x: i32) -> void {
    unsafe {
        if old_alpha == 0 || !FB.use_double_buffering || FB.backbuffer == (null as *mut u32) { return; }
        let inv = 255 - old_alpha as u32;
        for mut y in 0..FB.height {
            for mut x in 0..FB.width {
                let sx = x as i32 - slide_x;
                if sx >= 0 && sx < FB.width as i32 {
                    let old = TRANSITION_SNAPSHOT[(y * FB.pitch + sx as u32) as usize];
                    let now = *(FB.backbuffer + (y * FB.pitch + x) as usize);
                    let rb = ((((old & 0x00FF00FF) * old_alpha as u32) + ((now & 0x00FF00FF) * inv)) >> 8) & 0x00FF00FF;
                    let green = ((((old & 0x0000FF00) * old_alpha as u32) + ((now & 0x0000FF00) * inv)) >> 8) & 0x0000FF00;
                    *(FB.backbuffer + (y * FB.pitch + x) as usize) = rb | green;
                }
            }
        }
    }
}

@system
pub fn gfx_put_pixel(x: u32, y: u32, color: u32) -> void {
    unsafe {
        if (x < FB.width && y < FB.height) {
            let offset = (y * FB.pitch + x) as usize;
            *(FB.backbuffer + offset) = color;
        }
    }
}

@system
pub fn gfx_get_pixel(x: u32, y: u32) -> u32 {
    unsafe {
        if (x < FB.width && y < FB.height) {
            let offset = (y * FB.pitch + x) as usize;
            return *(FB.backbuffer + offset);
        }
        return 0;
    }
}
