// Baken OS - Utilitários de Disco e Formatação (mkfs.bakenfs & bkn_fsck) em BKN Puro (@system)
// Formatação de Partições Brutas e Verificação de Integridade de Inodes/Blocos

module kernel::bkn_mkfs;

import kernel::block_dev::*;
import kernel::bakenfs::*;
import kernel::pmm::*;

pub struct BakenFsSuperblock {
    pub magic: u32,             // 0x424B4E46 ("BKNF")
    pub version: u16,
    pub block_size: u32,        // 4096 bytes
    pub total_blocks: u64,
    pub free_blocks: u64,
    pub total_inodes: u64,
    pub free_inodes: u64,
    pub inode_table_lba: u64,
    pub root_dir_inode: u64,
}

// Formata um dispositivo de bloco (NVMe ou SATA) com o sistema de arquivos BakenFS
@system
pub fn mkfs_bakenfs(dev_id: u32) -> bool {
    unsafe {
        let dev_count = block_get_device_count();
        if dev_id == 0 || dev_id > (dev_count as u32) { return false; }

        let sb_page = pmm_alloc_pages(0);
        if sb_page == (0 as *mut u8) { return false; }

        let sb = sb_page as *mut BakenFsSuperblock;
        (*sb).magic = 0x424B4E46;
        (*sb).version = 1;
        (*sb).block_size = 4096;
        (*sb).total_blocks = 262144; // 1GB
        (*sb).free_blocks = 260000;
        (*sb).total_inodes = 4096;
        (*sb).free_inodes = 4095;
        (*sb).inode_table_lba = 16;
        (*sb).root_dir_inode = 1;

        // Escreve o Superbloco no LBA 0 do dispositivo
        let success = block_write(dev_id, 0, 1, sb_page as u64);
        return success;
    }
}

// Verificador de Integridade do Sistema de Arquivos (Baken FSCK)
@system
pub fn bkn_fsck(dev_id: u32) -> bool {
    unsafe {
        let sb_page = pmm_alloc_pages(0);
        if sb_page == (0 as *mut u8) { return false; }

        let success = block_read(dev_id, 0, 1, sb_page as u64);
        if !success { return false; }

        let sb = sb_page as *const BakenFsSuperblock;
        if (*sb).magic != 0x424B4E46 {
            return false; // Magia inválida / partição corrompida
        }

        return true;
    }
}
