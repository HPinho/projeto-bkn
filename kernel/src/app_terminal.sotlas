// Baken OS - BakenTerminal & BakenShell Console
// 100% Implementado na linguagem Sotlas (@system)

module kernel::app_terminal;

import kernel::graphics_engine::*;
import kernel::bakenfx::*;

pub struct TerminalState {
    pub cursor_tick: u32;
    pub scroll_offset: u32;
}

static mut TERM_STATE: TerminalState = TerminalState {
    cursor_tick: 0,
    scroll_offset: 0,
};

@system
pub fn app_terminal_render(x: u32, y: u32, w: u32, h: u32) -> void {
    unsafe {
        TERM_STATE.cursor_tick = (TERM_STATE.cursor_tick + 1) % 60;

        // Fundo estilo Terminal Matrix / Obsidian Dark
        bakenfx_fill_rect_alpha(x, y, w, h, 0x00050811, 245);

        // Barra Superior do Terminal (Mini Header)
        let bar_h: u32 = 28;
        bakenfx_fill_rect_alpha(x, y, w, bar_h, 0x000D1322, 230);
        bakenfx_draw_hline(x, y + bar_h, w, 0x001E293B, 180);

        // Abas do Terminal
        bakenfx_draw_panel(x + 10, y + 4, 150, 20, 0x00050811, 220, 0x00334155, 4);
        bakenfx_draw_text_alpha(x + 20, y + 7, "root@baken: ~", 0x0038BDF8, 1, 255);

        let text_x = x + 16;
        let start_y = y + bar_h + 12;
        let line_h: u32 = 18;

        // Linha 1: Execução do Fetch
        bakenfx_draw_text_alpha(text_x, start_y, "root@baken-os:~$ baken-fetch", 0x0010B981, 1, 255);

        // Logo ASCII e Informações
        let logo_y = start_y + line_h + 4;
        bakenfx_draw_text_alpha(text_x, logo_y, "   /\\___/\\   ", 0x0038BDF8, 1, 255);
        bakenfx_draw_text_alpha(text_x + 120, logo_y, "OS: Baken OS Desktop Edition (x86_64)", 0x00F8FAFC, 1, 240);

        bakenfx_draw_text_alpha(text_x, logo_y + line_h, "  (  o   o  )  ", 0x0038BDF8, 1, 255);
        bakenfx_draw_text_alpha(text_x + 120, logo_y + line_h, "Kernel: Sotlas Modular Micro-Core 0.2.0", 0x0094A3B8, 1, 220);

        bakenfx_draw_text_alpha(text_x, logo_y + line_h * 2, "  (  =^=  )   ", 0x0038BDF8, 1, 255);
        bakenfx_draw_text_alpha(text_x + 120, logo_y + line_h * 2, "Firmware: UEFI 2.8+ / GOP Direct Video", 0x0094A3B8, 1, 220);

        bakenfx_draw_text_alpha(text_x, logo_y + line_h * 3, "   (______)   ", 0x0038BDF8, 1, 255);
        bakenfx_draw_text_alpha(text_x + 120, logo_y + line_h * 3, "Shell: BakenShell Native (Sotlas runtime)", 0x0094A3B8, 1, 220);

        bakenfx_draw_text_alpha(text_x + 120, logo_y + line_h * 4, "Memoria: 840 MB / 4096 MB (DDR4)", 0x0094A3B8, 1, 220);

        // Linha de Comando Seguinte
        let cmd2_y = logo_y + line_h * 5 + 12;
        bakenfx_draw_text_alpha(text_x, cmd2_y, "root@baken-os:~$ sotlas --version", 0x0010B981, 1, 255);
        bakenfx_draw_text_alpha(text_x, cmd2_y + line_h, "Sotlas Unified Toolchain v0.2.0 (Target: barecore, native)", 0x00E2E8F0, 1, 230);

        // Prompt Ativo Atual
        let active_y = cmd2_y + line_h * 2 + 10;
        bakenfx_draw_text_alpha(text_x, active_y, "root@baken-os:~$ ", 0x0010B981, 1, 255);
        bakenfx_draw_text_alpha(text_x + 130, active_y, "help", 0x00F8FAFC, 1, 240);

        // Cursor Bloco Piscante
        if TERM_STATE.cursor_tick < 35 {
            bakenfx_fill_rect(text_x + 168, active_y - 1, 8, 14, 0x0010B981);
        }
    }
}

@system
pub fn app_terminal_handle_click(rel_x: i32, rel_y: i32) -> void {
    // Foco e comandos no terminal
}
