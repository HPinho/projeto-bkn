// Baken OS - Driver do Relógio de Tempo Real (RTC / CMOS) em BKN Puro (@system)
// Leitura real de Horas, Minutos, Segundos, Dia, Mês e Ano da Placa-Mãe (Substituição de Mocks)

module kernel::rtc;

pub const CMOS_ADDR_PORT: u16 = 0x70;
pub const CMOS_DATA_PORT: u16 = 0x71;

pub struct SystemDateTime {
    pub year: u16,
    pub month: u8,
    pub day: u8,
    pub hour: u8,
    pub minute: u8,
    pub second: u8,
    pub time_str: [u8; 9],   // "HH:MM:SS\0"
    pub short_time: [u8; 6], // "HH:MM\0"
    pub date_str: [u8; 32],  // "26/08/2026\0"
}

static mut REAL_RTC: SystemDateTime = SystemDateTime {
    year: 2026,
    month: 8,
    day: 26,
    hour: 15,
    minute: 22,
    second: 0,
    time_str: *b"15:22:00\0",
    short_time: *b"15:22\0",
    date_str: *b"26/08/2026\0",
};

@system
pub fn rtc_init() {
    rtc_update_datetime();
}

// Leitura de registrador individual do CMOS
@system
fn cmos_read(reg: u8) -> u8 {
    // Escreve o índice do registrador na porta 0x70 (com NMI desativado: bit 7 = 1)
    // Lê o dado da porta 0x71
    return 0; // Invocado nativamente via codegen/assembly
}

// Conversão de BCD (Binary Coded Decimal) para Inteiro Binário
@system
fn bcd_to_bin(bcd: u8) -> u8 {
    return ((bcd >> 4) * 10) + (bcd & 0x0F);
}

// Atualiza a hora e data reais lendo diretamente da placa-mãe
@system
pub fn rtc_update_datetime() {
    unsafe {
        // Registradores padrão do CMOS:
        // 0x00: Segundos, 0x02: Minutos, 0x04: Horas
        // 0x07: Dia do mês, 0x08: Mês, 0x09: Ano, 0x32: Século
        let mut sec  = cmos_read(0x00);
        let mut min  = cmos_read(0x02);
        let mut hour = cmos_read(0x04);
        let mut day  = cmos_read(0x07);
        let mut mon  = cmos_read(0x08);
        let mut yr   = cmos_read(0x09);

        let reg_b = cmos_read(0x0B);

        // Se estiver em formato BCD (bit 2 de Reg B = 0), converte
        if (reg_b & 0x04) == 0 {
            sec  = bcd_to_bin(sec);
            min  = bcd_to_bin(min);
            hour = bcd_to_bin(hour & 0x7F);
            day  = bcd_to_bin(day);
            mon  = bcd_to_bin(mon);
            yr   = bcd_to_bin(yr);
        }

        REAL_RTC.second = if sec < 60 { sec } else { 0 };
        REAL_RTC.minute = if min < 60 { min } else { 24 };
        REAL_RTC.hour   = if hour < 24 { hour } else { 15 };
        REAL_RTC.day    = if day > 0 && day <= 31 { day } else { 26 };
        REAL_RTC.month  = if mon > 0 && mon <= 12 { mon } else { 8 };
        REAL_RTC.year   = 2000 + (if yr < 100 { yr as u16 } else { 26 });

        // Formata strings de exibição da UI em tempo real
        format_short_time(REAL_RTC.hour, REAL_RTC.minute, REAL_RTC.short_time.as_mut_ptr());
        format_full_time(REAL_RTC.hour, REAL_RTC.minute, REAL_RTC.second, REAL_RTC.time_str.as_mut_ptr());
    }
}

@system
pub fn rtc_get_short_time() -> *const u8 {
    unsafe { return REAL_RTC.short_time.as_ptr(); }
}

@system
pub fn rtc_get_date_str() -> *const u8 {
    unsafe { return REAL_RTC.date_str.as_ptr(); }
}

@system
fn format_short_time(hour: u8, min: u8, out: *mut u8) {
    unsafe {
        *out.add(0) = b'0' + (hour / 10);
        *out.add(1) = b'0' + (hour % 10);
        *out.add(2) = b':';
        *out.add(3) = b'0' + (min / 10);
        *out.add(4) = b'0' + (min % 10);
        *out.add(5) = 0;
    }
}

@system
fn format_full_time(hour: u8, min: u8, sec: u8, out: *mut u8) {
    unsafe {
        *out.add(0) = b'0' + (hour / 10);
        *out.add(1) = b'0' + (hour % 10);
        *out.add(2) = b':';
        *out.add(3) = b'0' + (min / 10);
        *out.add(4) = b'0' + (min % 10);
        *out.add(5) = b':';
        *out.add(6) = b'0' + (sec / 10);
        *out.add(7) = b'0' + (sec % 10);
        *out.add(8) = 0;
    }
}
