static mut NATIVE_LAST_FRAME_TSC: u64 = 0;
static mut EARLY_BOOT_DIAGNOSTICS_READY: bool = false;

// Diagnóstico visual disponível imediatamente após o trampoline pós-cutover.
// Usa somente o framebuffer GOP já mapeado e assets embutidos; não depende de
// ACPI, heap de runtime, IRQ, scheduler, USB ou storage.
@system
pub fn baken_early_boot_begin(framebuffer: *mut u32, width: u32,
                              height: u32, pitch: u32) -> bool {
    if framebuffer == (null as *mut u32) || width < 320 || height < 230 || pitch < width {
        return false;
    }
    display_init(framebuffer, width, height, pitch);
    baken_native_bind_assets();
    unsafe { EARLY_BOOT_DIAGNOSTICS_READY = true; }
    raster_fill_rect(0, 0, width, 190, 0x0008111F);
    raster_draw_text(28, 24, "BAKEN OS EARLY BOOT\0".as_ptr(), 0x00FFFFFF);
    raster_draw_text(28, 58, "Hardware diagnostics active\0".as_ptr(), 0x008FB8FF);
    raster_draw_text(28, 142, "Do not power off while a stage is running\0".as_ptr(), 0x008B9AAF);
    display_swap_buffers_rect(0, 0, width, 190);
    return true;
}

@system
pub fn baken_early_boot_stage(stage: *const u8) -> void {
    unsafe { if !EARLY_BOOT_DIAGNOSTICS_READY { return; } }
    raster_fill_rect(24, 92, display_get_width() - 48, 38, 0x00142435);
    raster_fill_rect(24, 92, 8, 38, 0x00F5B942);
    raster_draw_text(48, 101, "TESTING: \0".as_ptr(), 0x00F5B942);
    raster_draw_text(158, 101, stage, 0x00FFFFFF);
    display_swap_buffers_rect(0, 88, display_get_width(), 48);
}

@system
pub fn baken_early_boot_pass(stage: *const u8) -> void {
    unsafe { if !EARLY_BOOT_DIAGNOSTICS_READY { return; } }
    raster_fill_rect(24, 92, display_get_width() - 48, 38, 0x0011242A);
    raster_fill_rect(24, 92, 8, 38, 0x0034D399);
    raster_draw_text(48, 101, "OK: \0".as_ptr(), 0x0034D399);
    raster_draw_text(96, 101, stage, 0x00FFFFFF);
    display_swap_buffers_rect(0, 88, display_get_width(), 48);
}

@system
pub fn baken_early_boot_fail(code: *const u8, stage: *const u8) -> ! {
    unsafe {
        if EARLY_BOOT_DIAGNOSTICS_READY {
            raster_fill_rect(0, 0, display_get_width(), 230, 0x002A0D14);
            raster_draw_text(28, 24, "BAKEN OS COULD NOT CONTINUE\0".as_ptr(), 0x00FFFFFF);
            raster_draw_text(28, 66, "FAILED: \0".as_ptr(), 0x00FB7185);
            raster_draw_text(116, 66, stage, 0x00FFFFFF);
            raster_draw_text(28, 104, "CODE: \0".as_ptr(), 0x00FB7185);
            raster_draw_text(96, 104, code, 0x00FFFFFF);
            raster_draw_text(28, 152, "Photograph this screen and report the code.\0".as_ptr(), 0x00FFFFFF);
            raster_draw_text(28, 184, "The machine is halted safely; disk data was not changed.\0".as_ptr(), 0x00CBD5E1);
            display_swap_buffers_rect(0, 0, display_get_width(), 230);
        }
    }
    loop { x86_cpu_pause(); }
}

@system
pub fn baken_native_bind_assets() -> void {
    let font_adv = baken_get_font_advances(2);
    let font_alpha = baken_get_font_alpha(2);
    if font_alpha != (null as *const u8) {
        raster_bind_font_atlas(font_adv, font_alpha, baken_get_font_width(2),
                               baken_get_font_height(2), baken_get_font_px(2));
    }
    let title_adv = baken_get_font_advances(5);
    let title_alpha = baken_get_font_alpha(5);
    if title_alpha != (null as *const u8) {
        raster_bind_title_font_atlas(title_adv, title_alpha, baken_get_font_width(5),
                                     baken_get_font_height(5), baken_get_font_px(5));
    }
    for mut index in 0..3 {
        let alpha = baken_get_cjk_alpha(index as u32);
        if alpha != (null as *const u8) {
            raster_bind_cjk_item(index as u32, baken_get_cjk_width(index as u32),
                                 baken_get_cjk_height(index as u32), alpha);
        }
    }
    let logo = baken_get_logo_pixels();
    if logo != (null as *const u32) {
        raster_bind_logo_atlas(logo, baken_get_logo_size());
    }
}

@system
pub fn baken_native_runtime_prepare() -> bool {
    if !x86_timer_is_calibrated() {
        if !x86_timer_calibrate_from_acpi_pm() { return false; }
    }
    ps2_keyboard_init();
    ps2_mouse_init();
    return true;
}

@system
pub fn baken_native_runtime_input_ready() -> bool {
    return ps2_keyboard_is_present() || ps2_mouse_is_present();
}

@system
pub fn baken_native_runtime_timer_ready() -> bool {
    return x86_timer_is_calibrated() && x86_timer_cycles_per_us() > 0;
}

@system
fn baken_native_frame_wait(frame_start: u64) -> void {
    let frame_end = x86_timer_read_tsc();
    let cycles_per_us = x86_timer_cycles_per_us();
    let reported_refresh = display_get_refresh_hz();
    let refresh_hz: u32 = if reported_refresh < 30 { 60 } else if reported_refresh > 240 { 240 } else { reported_refresh };
    let target_us: u64 = 1000000 / (refresh_hz as u64);
    if cycles_per_us > 0 && frame_end > frame_start {
        let work_us = x86_timer_elapsed_us(frame_start, frame_end);
        if work_us < target_us { x86_timer_spin_wait_us(target_us - work_us); }
    }
    let now_tsc = x86_timer_read_tsc();
    let mut dt: f32 = 0.0166667;
    unsafe {
        if NATIVE_LAST_FRAME_TSC > 0 && now_tsc > NATIVE_LAST_FRAME_TSC && cycles_per_us > 0 {
            let total_us = x86_timer_elapsed_us(NATIVE_LAST_FRAME_TSC, now_tsc);
            dt = (total_us as f32) / 1000000.0;
            if dt < 0.001 { dt = 0.001; }
            if dt > 0.066 { dt = 0.066; }
        }
        NATIVE_LAST_FRAME_TSC = now_tsc;
    }
    desktop_compositor_set_frame_delta(dt);
}

@system
fn baken_native_dispatch_click(mx: i32, my: i32, w: u32, h: u32) -> void {
    let session = desktop_compositor_get_session();
    if session == 0 { baken_installer_handle_click(mx, my, w, h); }
    else if session == 1 { baken_oobe_handle_click(mx, my, w, h); }
    else { if !wm_handle_mouse_down(mx, my) { desktop_shell_handle_click(mx, my); } }
}

@system
fn baken_native_dispatch_move(mx: i32, my: i32) -> void {
    baken_cursor_set_pos(mx, my);
    desktop_shell_set_cursor(mx, my);
    raster_set_cursor_parallax(mx, my);
    if desktop_compositor_get_session() == 2 { wm_handle_mouse_move(mx, my); }
}

@system
fn baken_native_dispatch_up() -> void {
    if desktop_compositor_get_session() == 2 { wm_handle_mouse_up(); }
}

@system
pub fn baken_native_runtime_run(width: u32, height: u32) -> ! {
    if width == 0 || height == 0 { loop {} }
    if !baken_native_runtime_prepare() { loop {} }
    let mut mouse_x: i32 = (width / 2) as i32;
    let mut mouse_y: i32 = (height / 2) as i32;
    let mut left_down: u8 = 0;
    baken_native_dispatch_move(mouse_x, mouse_y);
    loop {
        let frame_start = x86_timer_read_tsc();
        // HID-4d.6 é oportunista: falha/transiente em um frame é retomado pelos
        // tombstones no próximo, sem transformar ausência de xHCI em falha do UI.
        platform_hid_hotplug_service_once();
        i2c_hid_manager_service_once();
        let mut scancode: u16 = 0;
        let mut unicode: u16 = 0;
        while ps2_keyboard_poll(&mut scancode, &mut unicode) == 1 {
            let session = desktop_compositor_get_session();
            if session == 0 {
                let key = if unicode != 0 { unicode as u32 } else { scancode as u32 };
                baken_installer_handle_key(key);
            } else if session == 1 {
                if unicode == 13 || unicode == 32 || unicode == 110 || unicode == 78 {
                    baken_oobe_handle_click(mouse_x, mouse_y, width, height);
                }
            } else if session == 2 {
                if unicode >= 49 && unicode <= 53 { desktop_shell_open_app((unicode - 49) as u32); }
                else if unicode == 105 || unicode == 73 { desktop_compositor_set_session(0); }
            }
        }
        let mut dx: i32 = 0;
        let mut dy: i32 = 0;
        let mut curr_btn: u8 = left_down;
        let mut mouse_btn: u8 = 0;
        if ps2_mouse_poll(&mut dx, &mut dy, &mut mouse_btn) == 1 {
            mouse_x += dx; mouse_y += dy;
            if mouse_x < 0 { mouse_x = 0; }
            if mouse_y < 0 { mouse_y = 0; }
            if mouse_x >= (width as i32) { mouse_x = (width as i32) - 1; }
            if mouse_y >= (height as i32) { mouse_y = (height as i32) - 1; }
            curr_btn = mouse_btn;
            baken_native_dispatch_move(mouse_x, mouse_y);
        }
        if curr_btn == 1 && left_down == 0 { baken_native_dispatch_click(mouse_x, mouse_y, width, height); }
        else if curr_btn == 1 { if desktop_compositor_get_session() == 2 { wm_handle_mouse_move(mouse_x, mouse_y); } }
        else if left_down == 1 { baken_native_dispatch_up(); }
        left_down = curr_btn;
        desktop_compositor_render_frame();
        baken_native_frame_wait(frame_start);
    }
}

@system
pub fn baken_native_kernel_run(framebuffer: *mut u32, width: u32,
                               height: u32, pixels_per_scanline: u32) -> ! {
    if framebuffer == (null as *mut u32) || width == 0 || height == 0 ||
       pixels_per_scanline < width { loop {} }

    baken_early_boot_stage("AML NAMESPACE / DISCOVERY\0".as_ptr());

    // HID-4c.4d: late attach é oportunista e não fatal. O proof legado do
    // primeiro teclado já terminou em post_cutover; hardware sem segundo HID
    // continua inicializando normalmente. O workflow dual exige o marker real.
    platform_hid_late_attach_second_mouse();

    // Fase 2/AML: catálogo -> decoder/data -> namespace -> loader -> discovery.
    // AML-5 apenas consulta objetos estáticos; Method/OperationRegion não são executados.
    if !aml_tables_init() || !aml_tables_emit_ready_marker() { baken_early_boot_fail("E-AML-001\0".as_ptr(), "AML TABLE CATALOG\0".as_ptr()); }
    if !aml_decoder_self_test() || !aml_decoder_emit_ready_marker() { baken_early_boot_fail("E-AML-002\0".as_ptr(), "AML DECODER\0".as_ptr()); }
    if !aml_namespace_foundation_init() || !aml_namespace_emit_ready_marker() { baken_early_boot_fail("E-AML-003\0".as_ptr(), "AML NAMESPACE\0".as_ptr()); }
    if !aml_loader_init() {
        aml_loader_emit_failure_markers();
        baken_early_boot_fail("E-AML-004\0".as_ptr(), "AML LOADER\0".as_ptr());
    }
    if !aml_loader_emit_ready_marker() { baken_early_boot_fail("E-AML-005\0".as_ptr(), "AML LOADER MARKER\0".as_ptr()); }
    if !aml_discovery_init() {
        aml_discovery_emit_failure_markers();
        baken_early_boot_fail("E-AML-006\0".as_ptr(), "AML DISCOVERY\0".as_ptr());
    }
    if !aml_discovery_emit_ready_marker() { baken_early_boot_fail("E-AML-007\0".as_ptr(), "AML DISCOVERY MARKER\0".as_ptr()); }

    // Consolida ACPI/APIC/PCI antes de liberar APs ou inicializar serviços.
    baken_early_boot_stage("PCI PLATFORM INVENTORY\0".as_ptr());
    if !platform_inventory_init() || !platform_inventory_emit_ready_marker() { baken_early_boot_fail("E-PLAT-001\0".as_ptr(), "PCI PLATFORM INVENTORY\0".as_ptr()); }
    if !platform_device_catalog_init() || !platform_device_catalog_emit_ready_marker() { baken_early_boot_fail("E-PLAT-002\0".as_ptr(), "DEVICE CATALOG\0".as_ptr()); }
    // AUDIO-0: descoberta PCI read-only. Ausência de HDA ou BAR inválido não
    // impede o boot; nenhum controller é habilitado antes do backend MMIO/DMA.
    hda_discover_pci();
    if platform_storage_binding_required() {
        if !platform_storage_bind_active_driver() || !platform_storage_emit_bound_marker() { baken_early_boot_fail("E-STOR-001\0".as_ptr(), "STORAGE DRIVER BIND\0".as_ptr()); }
    }

    // Inicialização oportunista da plataforma I2C (controladores ACPI, backends físicos PCI e dispositivos HID).
    // O escaneamento é não-bloqueante e fail-safe: plataformas sem hardware I2C continuam normalmente.
    i2c_compatibility_diagnostics_init();
    amd_psp_i2c_transport_init();
    i2c_bus_arbitration_init();
    i2c_discovery_scan_acpi_controllers();
    i2c_physical_probe_pci();
    i2c_physical_probe_acpi_platform();
    i2c_compatibility_emit_serial_report();
    i2c_hid_acpi_scan_devices();
    i2c_hid_manager_init();

    // APs chegam ate runtime per-CPU com IF=0 e permanecem estacionados.
    baken_early_boot_stage("SMP APPLICATION PROCESSORS\0".as_ptr());
    if !smp_initialize_base() || !smp_emit_ready_markers() { baken_early_boot_fail("E-SMP-001\0".as_ptr(), "SMP APPLICATION PROCESSORS\0".as_ptr()); }

    baken_early_boot_stage("PROCESS ADDRESS SPACES\0".as_ptr());
    if !process_address_space_activate_foundation() ||
       !process_address_space_is_ready() ||
       !process_address_space_self_test_passed() { baken_early_boot_fail("E-PROC-001\0".as_ptr(), "PROCESS ADDRESS SPACES\0".as_ptr()); }
    if !process_address_space_emit_ready_marker() { baken_early_boot_fail("E-PROC-002\0".as_ptr(), "ADDRESS SPACE MARKER\0".as_ptr()); }
    if !process_registry_activate() { baken_early_boot_fail("E-PROC-003\0".as_ptr(), "PROCESS REGISTRY\0".as_ptr()); }
    if !process_registry_emit_ready_marker() { baken_early_boot_fail("E-PROC-004\0".as_ptr(), "PROCESS REGISTRY MARKER\0".as_ptr()); }

    // FPU_READY altera o caminho do IRQ de timer. Mantenha IF=0 desde antes da
    // publicação desse estado até o scheduler estar integralmente ativo, para
    // que nenhum tick observe FPU pronta com SCHEDULER_ACTIVE ainda falso.
    x86_cli_raw();
    baken_early_boot_stage("FPU AND SCHEDULER\0".as_ptr());
    if !fpu_initialize() || !fpu_emit_ready_marker() { baken_early_boot_fail("E-FPU-001\0".as_ptr(), "FPU CONTEXT\0".as_ptr()); }
    let scheduler_ready = scheduler_initialize();
    x86_sti_raw();
    if !scheduler_ready { x86_serial_write_hex32_marker('J' as u8, 1); baken_early_boot_fail("E-SCHED-001\0".as_ptr(), "SCHEDULER INITIALIZE\0".as_ptr()); }
    scheduler_diag_initialized();
    if !scheduler_wait_first_round_trip() { x86_serial_write_hex32_marker('J' as u8, 2); baken_early_boot_fail("E-SCHED-002\0".as_ptr(), "SCHEDULER ROUND TRIP\0".as_ptr()); }
    scheduler_diag_round_trip();

    x86_cli_raw();
    let run_queue_ready = scheduler_start_run_queue_probe();
    x86_sti_raw();
    if !run_queue_ready { baken_early_boot_fail("E-SCHED-003\0".as_ptr(), "RUN QUEUE\0".as_ptr()); }
    scheduler_diag_run_queue_created();
    if !scheduler_yield() { baken_early_boot_fail("E-SCHED-004\0".as_ptr(), "SCHEDULER YIELD\0".as_ptr()); }
    scheduler_diag_yield_round_trip();
    if !scheduler_wait_run_queue_probe() { baken_early_boot_fail("E-SCHED-005\0".as_ptr(), "RUN QUEUE PROBE\0".as_ptr()); }
    if !scheduler_wait_reaper_probe() { baken_early_boot_fail("E-SCHED-006\0".as_ptr(), "THREAD REAPER\0".as_ptr()); }
    if !scheduler_finish_process_probe() { baken_early_boot_fail("E-SCHED-007\0".as_ptr(), "PROCESS SCHEDULER\0".as_ptr()); }

    // O handoff wait/wake é uma prova de troca por INT 0x43, enquanto o sleep
    // subsequente é a prova de preempção por LAPIC. Não deixe o timer periódico
    // competir com a janela waiter -> bootstrap -> waiter: ele fica mascarado
    // até a mesma waiter registrar o deadline e bloquear em SLEEP_BLOCKED.
    lapic_timer_mask();
    x86_serial_write_hex32_marker('W' as u8, 1);
    if !scheduler_wait_probe_start() {
        x86_serial_write_hex32_marker('W' as u8, 0x80000001);
        loop {}
    }
    if !scheduler_yield() {
        x86_serial_write_hex32_marker('W' as u8, 0x80000002);
        loop {}
    }
    x86_serial_write_hex32_marker('W' as u8, 2);
    if !scheduler_wait_probe_blocked() {
        x86_serial_write_hex32_marker('W' as u8, 0x80000003);
        loop {}
    }
    if !scheduler_wait_probe_wake() {
        x86_serial_write_hex32_marker('W' as u8, 0x80000004);
        loop {}
    }
    x86_serial_write_hex32_marker('W' as u8, 3);
    if !scheduler_yield() {
        x86_serial_write_hex32_marker('W' as u8, 0x80000005);
        loop {}
    }
    // O segundo yield só retorna ao bootstrap depois de a waiter retomar,
    // publicar WAIT_RESUME e entrar em scheduler_sleep_ticks(), que emite
    // SLEEP_BLOCKED antes do seu próprio block-switch.
    x86_serial_write_hex32_marker('W' as u8, 4);
    if !lapic_timer_unmask_periodic() {
        x86_serial_write_hex32_marker('W' as u8, 0x80000006);
        loop {}
    }
    x86_serial_write_hex32_marker('W' as u8, 5);
    if !scheduler_wait_probe_wait_complete() {
        x86_serial_write_hex32_marker('W' as u8, 0x80000007);
        loop {}
    }
    x86_serial_write_hex32_marker('W' as u8, 6);

    // Prova real CPL3 -> syscall -> exit -> reaper -> teardown do address space.
    if !userspace_loader_start_probe() { loop {} }
    if !userspace_loader_wait_probe() { loop {} }
    if !userspace_loader_finish_probe() { loop {} }
    if !userspace_loader_emit_ready_markers() { loop {} }

    // A última fronteira do Kernel Core: #PF vindo de CPL3 encerra somente o
    // processo culpado, retorna ao scheduler e libera a address space.
    if !userspace_loader_start_fault_probe() { loop {} }
    if !userspace_loader_wait_fault_probe() { loop {} }
    if !userspace_loader_finish_fault_probe() { loop {} }
    if !userspace_loader_emit_fault_isolation_marker() { loop {} }

    // So agora, com os contratos BSP/Ring3 encerrados, uma kernel thread pinned
    // e realmente despachada para o primeiro AP via IPI 0x44.
    baken_early_boot_stage("SMP SCHEDULER MIGRATION\0".as_ptr());
    if !scheduler_smp_probe_run() { baken_early_boot_fail("E-SMP-002\0".as_ptr(), "SMP SCHEDULER MIGRATION\0".as_ptr()); }

    // A política de exceções também precisa sobreviver no AP: uma segunda
    // aplicação pinned no CPU 1 toca sua guard page e deve morrer isoladamente.
    if !userspace_loader_run_ap_fault_probe() { baken_early_boot_fail("E-SMP-003\0".as_ptr(), "AP USER FAULT ISOLATION\0".as_ptr()); }

    // O AP já executou Ring3 e TLB root-aware. A prova final faz o mesmo TID
    // nascer no BSP, ser preemptado, repinado e retomar no AP com XMM0 intacto.
    if !userspace_loader_run_migration_probe() { baken_early_boot_fail("E-SMP-004\0".as_ptr(), "BSP TO AP MIGRATION\0".as_ptr()); }

    baken_early_boot_pass("ALL KERNEL BOOT GATES\0".as_ptr());
    display_init(framebuffer, width, height, pixels_per_scanline);
    baken_native_bind_assets();
    desktop_compositor_init(width, height);
    baken_native_runtime_run(width, height);
}
