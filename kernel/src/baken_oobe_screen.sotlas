// Baken OS first-boot experience (OOBE). No disk/partition privileges by design.
module kernel::baken_oobe_screen;

import kernel::graphics_engine::*;
import kernel::baken_rasterizer::*;

const REGION: u32 = 0;
const NETWORK: u32 = 1;
const PROFILE: u32 = 2;
const PRIVACY: u32 = 3;
const STYLE: u32 = 4;
const READY: u32 = 5;

const BG: u32 = 0x00070B14;
const CARD: u32 = 0x00101825;
const CARD2: u32 = 0x00172232;
const LINE: u32 = 0x00283A51;
const TEXT: u32 = 0x00F7FAFC;
const MUTED: u32 = 0x009AA9BC;
const BLUE: u32 = 0x004CC9F0;
const VIOLET: u32 = 0x007C6CFF;
const GREEN: u32 = 0x003DDC97;

pub struct OobeState {
    pub step: u32;
    pub region: u32;
    pub network: u32;
    pub diagnostics: u8;
    pub location: u8;
    pub theme: u32;
    pub tick: u32;
    pub completed: u8;
    pub previous_step: u32;
    pub transition_tick: u32;
    pub transition_direction: i32;
}

static mut O: OobeState = OobeState {
    step: REGION,
    region: 0,
    network: 0,
    diagnostics: 0,
    location: 0,
    theme: 0,
    tick: 0,
    completed: 0,
    previous_step: REGION,
    transition_tick: 24,
    transition_direction: 1,
};

@system
fn oobe_go_to(next: u32, direction: i32) -> void {
    unsafe {
        if (next == O.step) { return; }
        O.previous_step = O.step;
        O.step = next;
        O.transition_tick = 0;
        O.transition_direction = direction;
    }
}

@system
pub fn baken_oobe_init() -> void {
    unsafe {
        O.step = REGION;
        O.region = 0;
        O.network = 0;
        O.diagnostics = 0;
        O.location = 0;
        O.theme = 0;
        O.tick = 0;
        O.completed = 0;
        O.previous_step = REGION;
        O.transition_tick = 24;
        O.transition_direction = 1;
    }
}

@inline
fn draw_specular_box(x: u32, y: u32, w: u32, h: u32, bg: u32, a: u8, brd: u32, rad: u32) -> void {
    gfx_draw_glass_rect(x, y, w, h, bg, a, brd, rad);
    if (w > 20 && h > 10) {
        gfx_fill_rect_alpha(x + rad / 2, y + 1, w - rad, 1, 0x00FFFFFF, 75);
        gfx_fill_rect_alpha(x + rad / 2, y + h - 2, w - rad, 1, 0x00000000, 45);
    }
}

@system
fn btn(x: u32, y: u32, w: u32, s: *const u8, p: u8) -> void {
    draw_specular_box(x, y, w, 42, if (p == 1) { 0x000284C7 } else { CARD2 }, 245, if (p == 1) { BLUE } else { LINE }, 12);
    let tw = gfx_measure_text(s);
    gfx_draw_text_alpha(x + (w - tw) / 2, y + 13, s, TEXT, 1, 255);
}

@system
fn option(x: u32, y: u32, w: u32, a: *const u8, b: *const u8, on: u8) -> void {
    draw_specular_box(x, y, w, 58, if (on == 1) { 0x00132338 } else { CARD2 }, 235, if (on == 1) { BLUE } else { LINE }, 11);
    gfx_draw_text_alpha(x + 16, y + 10, a, TEXT, 1, 255);
    gfx_draw_text_alpha(x + 16, y + 32, b, MUTED, 1, 230);
    gfx_draw_circle_alpha(x + w - 22, y + 20, 6, if (on == 1) { BLUE } else { LINE }, 255);
}

@system
fn toggle(x: u32, y: u32, on: u8) -> void {
    gfx_draw_glass_rect(x, y, 42, 22, if (on == 1) { GREEN } else { LINE }, 255, LINE, 11);
    gfx_draw_circle_alpha(if (on == 1) { x + 31 } else { x + 11 }, y + 11, 8, TEXT, 255);
}

@inline
fn get_bounds_cx(x: u32, w: u32) -> u32 {
    let q = if (w > 760) { 680 } else { w - 32 };
    return x + (w - q) / 2 + 34;
}

@inline
fn get_bounds_cw(w: u32) -> u32 {
    let q = if (w > 760) { 680 } else { w - 32 };
    return q - 68;
}

@system
fn frame(x: u32, y: u32, w: u32, h: u32) -> void {
    gfx_draw_aurora_parallax_bg(x, y, w, h, unsafe { O.tick });
    let q = if (w > 760) { 680 } else { w - 32 };
    let px = x + (w - q) / 2;
    draw_specular_box(px, y + 18, q, h - 36, CARD, 232, LINE, 20);
    gfx_draw_baken_logo(px + 24, y + 32, 28, 255);
    gfx_draw_text_alpha(px + 60, y + 38, "BAKEN OS".as_ptr(), TEXT, 1, 255);
    let s = unsafe { O.step };
    for mut i in 0..6 {
        gfx_draw_circle_alpha(px + q - 104 + (i as u32 * 16), y + 44, 4, if (i as u32 <= s) { BLUE } else { LINE }, 255);
    }
}

@system
pub fn baken_oobe_render(x: u32, y: u32, w: u32, h: u32) -> void {
    unsafe {
        O.tick = (O.tick + 1) % 3600;
        if (O.transition_tick < 24) { O.transition_tick += 1; }
    }
    frame(x, y, w, h);

    let prog = gfx_smoothstep_u8(unsafe { O.transition_tick }, 24) as u32;
    let slide_ox = if (unsafe { O.transition_tick } < 24) {
        unsafe { O.transition_direction } * (((255 - prog as i32) * 32) / 255)
    } else {
        0
    };
    let target_x = (x as i32 + slide_ox) as u32;

    let s = unsafe { O.step };
    if (s == REGION) { region(target_x, y, w, h); }
    else if (s == NETWORK) { network(target_x, y, w, h); }
    else if (s == PROFILE) { profile(target_x, y, w, h); }
    else if (s == PRIVACY) { privacy(target_x, y, w, h); }
    else if (s == STYLE) { style(target_x, y, w, h); }
    else { ready(target_x, y, w, h); }
}

@system
fn region(x: u32, y: u32, w: u32, h: u32) -> void {
    let cx = get_bounds_cx(x, w);
    let cw = get_bounds_cw(w);
    let t = y + 82;
    gfx_draw_text_alpha(cx, t, "Boas-vindas ao Baken OS".as_ptr(), TEXT, 1, 255);
    gfx_draw_text_alpha(cx, t + 26, "Confirme sua regiao e o layout do teclado.".as_ptr(), MUTED, 1, 235);
    option(cx, t + 68, cw, "Brasil".as_ptr(), "Portugues (Brasil) / ABNT2".as_ptr(), 1);
    option(cx, t + 134, cw, "Estados Unidos".as_ptr(), "English / US International".as_ptr(), 0);
    option(cx, t + 200, cw, "America Latina".as_ptr(), "Espanol / Latinoamericano".as_ptr(), 0);
    btn(cx + cw - 150, y + h - 78, 150, "Continuar  >".as_ptr(), 1);
}

@system
fn network(x: u32, y: u32, w: u32, h: u32) -> void {
    let cx = get_bounds_cx(x, w);
    let cw = get_bounds_cw(w);
    let t = y + 82;
    gfx_draw_text_alpha(cx, t, "Conecte-se quando quiser".as_ptr(), TEXT, 1, 255);
    gfx_draw_text_alpha(cx, t + 26, "A configuracao offline continua disponivel.".as_ptr(), MUTED, 1, 235);
    option(cx, t + 70, cw, "BakenNet-5G".as_ptr(), "Sinal excelente / WPA3 Seguro".as_ptr(), 1);
    option(cx, t + 138, cw, "Rede residencial".as_ptr(), "Sinal bom / WPA2".as_ptr(), 0);
    gfx_draw_text_alpha(cx, t + 218, "Configurar offline (Zero Conexao Externa)".as_ptr(), BLUE, 1, 245);
    btn(cx, y + h - 78, 110, "<  Voltar".as_ptr(), 0);
    btn(cx + cw - 150, y + h - 78, 150, "Conectar  >".as_ptr(), 1);
}

@system
fn profile(x: u32, y: u32, w: u32, h: u32) -> void {
    let cx = get_bounds_cx(x, w);
    let cw = get_bounds_cw(w);
    let t = y + 82;
    gfx_draw_text_alpha(cx, t, "Criacao de Conta e Perfil Local".as_ptr(), TEXT, 1, 255);
    gfx_draw_text_alpha(cx, t + 26, "Crie um perfil local protegido. BakenID e opcional.".as_ptr(), MUTED, 1, 235);
    
    // Avatar Picker Preview
    gfx_draw_circle_alpha(cx + 32, t + 82, 22, 0x000284C7, 240);
    gfx_draw_circle_alpha(cx + 32, t + 82, 10, 0x0000E5FF, 255);
    gfx_draw_text_alpha(cx + 68, t + 72, "Avatar: Aurora Cosmos (Personalizavel)".as_ptr(), BLUE, 1, 245);

    gfx_draw_text_alpha(cx, t + 116, "Nome de exibicao".as_ptr(), MUTED, 1, 230);
    draw_specular_box(cx, t + 138, cw, 38, CARD2, 240, BLUE, 8);
    gfx_draw_text_alpha(cx + 14, t + 148, "Usuario Baken".as_ptr(), TEXT, 1, 255);
    
    gfx_draw_text_alpha(cx, t + 188, "Senha do dispositivo / PIN".as_ptr(), MUTED, 1, 230);
    draw_specular_box(cx, t + 210, cw, 38, CARD2, 240, LINE, 8);
    gfx_draw_text_alpha(cx + 14, t + 220, "••••••••".as_ptr(), TEXT, 1, 255);
    
    btn(cx, y + h - 78, 110, "<  Voltar".as_ptr(), 0);
    btn(cx + cw - 150, y + h - 78, 150, "Continuar  >".as_ptr(), 1);
}

@system
fn privacy(x: u32, y: u32, w: u32, h: u32) -> void {
    let cx = get_bounds_cx(x, w);
    let cw = get_bounds_cw(w);
    let t = y + 78;
    gfx_draw_text_alpha(cx, t, "Privacidade Total por Padrao".as_ptr(), TEXT, 1, 255);
    gfx_draw_text_alpha(cx, t + 26, "Tudo comeca desligado. Voce tem controle absoluto.".as_ptr(), MUTED, 1, 235);
    draw_specular_box(cx, t + 70, cw, 66, CARD2, 235, LINE, 11);
    gfx_draw_text_alpha(cx + 16, t + 82, "Diagnostico anonimo".as_ptr(), TEXT, 1, 255);
    gfx_draw_text_alpha(cx + 16, t + 106, "Encontra falhas sem coletar dados pessoais".as_ptr(), MUTED, 1, 225);
    toggle(cx + cw - 58, t + 90, unsafe { O.diagnostics });
    draw_specular_box(cx, t + 144, cw, 66, CARD2, 235, LINE, 11);
    gfx_draw_text_alpha(cx + 16, t + 156, "Servicos de localizacao".as_ptr(), TEXT, 1, 255);
    gfx_draw_text_alpha(cx + 16, t + 180, "Permissao individual por aplicativo".as_ptr(), MUTED, 1, 225);
    toggle(cx + cw - 58, t + 164, unsafe { O.location });
    btn(cx, y + h - 78, 110, "<  Voltar".as_ptr(), 0);
    btn(cx + cw - 150, y + h - 78, 150, "Continuar  >".as_ptr(), 1);
}

@system
fn style(x: u32, y: u32, w: u32, h: u32) -> void {
    let cx = get_bounds_cx(x, w);
    let cw = get_bounds_cw(w);
    let t = y + 78;
    gfx_draw_text_alpha(cx, t, "Escolha a Atmosfera Visual".as_ptr(), TEXT, 1, 255);
    gfx_draw_text_alpha(cx, t + 26, "A aparencia pode ser alterada a qualquer momento nos Ajustes.".as_ptr(), MUTED, 1, 235);
    let gap: u32 = 12;
    let tile = (cw - gap * 2) / 3;
    let names = ["Aurora Glass".as_ptr(), "Mica Claro".as_ptr(), "Cyber Neon".as_ptr()];
    for mut i in 0..3 {
        let tx = cx + (i as u32 * (tile + gap));
        draw_specular_box(tx, t + 72, tile, 128, if (i == 0) { 0x00132338 } else { CARD2 }, 240, if (i == 0) { BLUE } else { LINE }, 12);
        // Mini Desktop Live Mockup Preview
        let mock_y = t + 84;
        let mock_w = tile - 20;
        let mock_x = tx + 10;
        gfx_fill_rect_alpha(mock_x, mock_y, mock_w, 48, if (i == 0) { 0x000F172A } else if (i == 1) { 0x00E2E8F0 } else { 0x00050505 }, 255);
        // Mock Topbar
        gfx_fill_rect_alpha(mock_x, mock_y, mock_w, 5, if (i == 1) { 0x00CBD5E1 } else { 0x001E293B }, 255);
        // Mock Dock
        let dk_w = mock_w * 60 / 100;
        gfx_fill_rect_alpha(mock_x + (mock_w - dk_w) / 2, mock_y + 40, dk_w, 4, if (i == 0) { 0x0000E5FF } else { 0x0038BDF8 }, 255);

        gfx_draw_text_alpha(tx + 12, t + 168, names[i], TEXT, 1, 245);
    }
    btn(cx, y + h - 78, 110, "<  Voltar".as_ptr(), 0);
    btn(cx + cw - 150, y + h - 78, 150, "Continuar  >".as_ptr(), 1);
}

@system
fn ready(x: u32, y: u32, w: u32, h: u32) -> void {
    let cx = get_bounds_cx(x, w);
    let cw = get_bounds_cw(w);
    let t = y + 108;
    let pulse_phase = unsafe { O.tick } % 120;
    let pulse_leg = if (pulse_phase < 60) { pulse_phase } else { 120 - pulse_phase };
    let p = 34 + ((gfx_smoothstep_u8(pulse_leg, 60) as u32 * 3) / 255);
    gfx_draw_circle_alpha(cx + cw / 2, t + 48, p + 16, VIOLET, 28);
    gfx_draw_circle_alpha(cx + cw / 2, t + 48, p, BLUE, 210);
    gfx_draw_circle_alpha(cx + cw / 2, t + 48, p / 3, BG, 255);
    let a = "Pronto para Explorar!";
    gfx_draw_text_alpha(cx + (cw - gfx_measure_text(a.as_ptr())) / 2, t + 112, a.as_ptr(), TEXT, 1, 255);
    let b = "Seu ambiente Baken OS foi configurado com sucesso.";
    gfx_draw_text_alpha(cx + (cw - gfx_measure_text(b.as_ptr())) / 2, t + 140, b.as_ptr(), MUTED, 1, 235);
    btn(cx + (cw - 220) / 2, t + 192, 220, "Abrir meu Baken OS >".as_ptr(), 1);
}

@system
pub fn baken_oobe_handle_click(rx: i32, ry: i32, w: u32, h: u32) -> void {
    unsafe {
        let q = if (w > 760) { 680 } else { w - 32 };
        let cx = (w - q) / 2 + 34;
        let cw = q - 68;
        if (O.step == PRIVACY && ry >= 148 && ry < 300 && rx > (cx + cw - 90) as i32) {
            if (ry < 226) {
                O.diagnostics = 1 - O.diagnostics;
            } else {
                O.location = 1 - O.location;
            }
            return;
        }
        if (ry > (h as i32) - 96) {
            if (rx < (cx as i32) + 130 && O.step > REGION) {
                oobe_go_to(O.step - 1, -1);
                return;
            }
            if (rx > (cx + cw - 180) as i32) {
                if (O.step < READY) {
                    oobe_go_to(O.step + 1, 1);
                } else {
                    O.completed = 1;
                }
            }
        }
    }
}

@system
pub fn baken_oobe_is_complete() -> u8 {
    unsafe {
        return O.completed;
    }
}
