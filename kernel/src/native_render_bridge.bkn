// Baken OS - Native Render Bridge (C to BKN)
// Centraliza todas as chamadas do motor gráfico nativo (C) e as expõe como funções BKN puras e seguras.
// Isso elimina a necessidade de declarar `extern "C"` e usar blocos `unsafe` espalhados pelo sistema.

module kernel::native_render_bridge;

extern "C" {
    // ----------------------------------------------------
    // GPU Core e Blending
    // ----------------------------------------------------
    pub fn bkn_put_pixel(x: u32, y: u32, color: u32);
    pub fn bkn_put_pixel_alpha(x: u32, y: u32, color: u32, alpha: u8);
    pub fn bkn_draw_rect(x: u32, y: u32, w: u32, h: u32, color: u32);
    pub fn bkn_draw_rect_alpha(x: u32, y: u32, w: u32, h: u32, color: u32, alpha: u8);
    pub fn bkn_dual_kawase_blur(x: u32, y: u32, w: u32, h: u32, passes: u32);
    
    // ----------------------------------------------------
    // SDF (Squircles, Glassmorphism, Círculos Vetoriais)
    // ----------------------------------------------------
    pub fn bkn_draw_sdf_glass_card(x: u32, y: u32, w: u32, h: u32, radius: f32, bg_color: u32, bg_alpha: u8, border_color: u32, border_width: f32);
    pub fn bkn_draw_sdf_circle(cx: u32, cy: u32, radius: f32, color: u32, alpha: u8);
    
    // ----------------------------------------------------
    // Motor de Tipografia Proporcional Exata
    // ----------------------------------------------------
    pub fn bkn_get_text_width(str: *const u8) -> u32;
    pub fn bkn_draw_text(x: u32, y: u32, str: *const u8, color: u32);
    pub fn bkn_draw_text_bold(x: u32, y: u32, str: *const u8, color: u32);
    pub fn bkn_draw_text_large(x: u32, y: u32, str: *const u8, color: u32);
    pub fn bkn_draw_text_centered(cx: u32, y: u32, str: *const u8, color: u32);
    pub fn bkn_draw_text_shadow(x: u32, y: u32, str: *const u8, color: u32, shadow_color: u32);
    
    // ----------------------------------------------------
    // UI Vetorial e Ícones Hardcoded
    // ----------------------------------------------------
    pub fn bkn_draw_vector_folder(x: u32, y: u32, label: *const u8, color: u32);
    pub fn bkn_draw_system_core_card(x: u32, y: u32);
    pub fn bkn_draw_vortex_icon(cx: u32, cy: u32, radius: f32);
    pub fn bkn_draw_weather_sun(cx: u32, cy: u32);
    pub fn bkn_draw_dock_app_glyph(cx: u32, cy: u32, app_id: i32);
}

// ============================================================================
// WRAPPERS BKN PUROS - Chamadas seguras para o resto do sistema
// ============================================================================

@system
pub fn native_blur(x: u32, y: u32, w: u32, h: u32, passes: u32) {
    unsafe { bkn_dual_kawase_blur(x, y, w, h, passes); }
}

@system
pub fn native_glass_card(x: u32, y: u32, w: u32, h: u32, radius: f32, bg_color: u32, bg_alpha: u8, border_color: u32, border_width: f32) {
    unsafe { bkn_draw_sdf_glass_card(x, y, w, h, radius, bg_color, bg_alpha, border_color, border_width); }
}

@system
pub fn native_circle(cx: u32, cy: u32, radius: f32, color: u32, alpha: u8) {
    unsafe { bkn_draw_sdf_circle(cx, cy, radius, color, alpha); }
}

@system
pub fn native_text(x: u32, y: u32, text: *const u8, color: u32) {
    unsafe { bkn_draw_text(x, y, text, color); }
}

@system
pub fn native_text_centered(cx: u32, y: u32, text: *const u8, color: u32) {
    unsafe { bkn_draw_text_centered(cx, y, text, color); }
}

@system
pub fn native_icon_folder(x: u32, y: u32, label: *const u8, color: u32) {
    unsafe { bkn_draw_vector_folder(x, y, label, color); }
}

@system
pub fn native_icon_dock_glyph(cx: u32, cy: u32, app_id: i32) {
    unsafe { bkn_draw_dock_app_glyph(cx, cy, app_id); }
}
