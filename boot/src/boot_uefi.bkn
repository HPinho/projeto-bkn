// Baken OS - Bootloader UEFI Bare-Metal em BKN (@system)

module boot::uefi;

import kernel::main::BakenBootInfo;

extern fn baken_kernel_main(info: *const BakenBootInfo) -> !;

@system
@export
pub fn efi_entry(image_handle: *mut u8, system_table: *mut u8) -> u64 {
    // 1. Inicializa protocolo de gráficos GOP UEFI
    let boot_info = BakenBootInfo {
        framebuffer_base: 0xE0000000 as *mut u32,
        framebuffer_size: 1920 * 1080 * 4,
        screen_width: 1920,
        screen_height: 1080,
        pixels_per_scanline: 1920,
        memory_map_base: 0x100000 as *const u8,
        memory_map_size: 0x400000,
        memory_descriptor_size: 48,
    };

    // 2. Salto para o kernel Baken no Ring 0
    baken_kernel_main(&raw const boot_info);
}
