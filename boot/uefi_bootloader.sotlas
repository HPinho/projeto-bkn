/*
 * Baken OS — UEFI bootstrap / handoff loader (x86_64)
 *
 * UEFI prepara somente o terreno. O corte final usa o Memory Map definitivo,
 * monta as page tables Baken, encerra Boot Services e salta para a entrada
 * pós-cutover Sotlas numa stack própria. Nenhuma UI pertence aqui.
 */

#include <stdint.h>
#include <stddef.h>
#include "baken_boot_info.h"
#include "kernel__memory__cutover_prepare.h"
#include "kernel__arch__x86_64__post_cutover.h"

typedef uint16_t CHAR16;
typedef uint64_t UINTN;
typedef uint64_t EFI_PHYSICAL_ADDRESS;
typedef void* EFI_HANDLE;
typedef UINTN EFI_STATUS;

#define EFI_SUCCESS 0
#define EFI_ERROR(code) (0x8000000000000000ULL | (code))
#define EFI_INVALID_PARAMETER EFI_ERROR(2)
#define EFI_UNSUPPORTED EFI_ERROR(3)
#define EFI_BUFFER_TOO_SMALL EFI_ERROR(5)
#define EFI_OUT_OF_RESOURCES EFI_ERROR(9)
#define EFI_ABORTED EFI_ERROR(21)
#define UEFI_LOADER_DATA 2U
#define ALLOCATE_ANY_PAGES 0U
#define PIXEL_BLUE_GREEN_RED_RESERVED_8BIT_PER_COLOR 1U
#define BAKEN_PAGE_TABLE_ARENA_PAGES 1024ULL
#define BAKEN_TRANSITION_STACK_PAGES 64ULL

typedef struct {
    uint32_t Data1;
    uint16_t Data2;
    uint16_t Data3;
    uint8_t Data4[8];
} EFI_GUID;

static EFI_GUID EFI_GRAPHICS_OUTPUT_PROTOCOL_GUID = {
    0x9042a9de, 0x23dc, 0x4a38, {0x96, 0xfb, 0x7a, 0xde, 0xd0, 0x80, 0x51, 0x6a}
};
static EFI_GUID EFI_ACPI_20_TABLE_GUID = {
    0x8868e871, 0xe4f1, 0x11d3, {0xbc, 0x22, 0x00, 0x80, 0xc7, 0x3c, 0x88, 0x81}
};
static EFI_GUID EFI_ACPI_10_TABLE_GUID = {
    0xeb9d2d30, 0x2d88, 0x11d3, {0x9a, 0x16, 0x00, 0x90, 0x27, 0x3f, 0xc1, 0x4d}
};
static EFI_GUID EFI_LOADED_IMAGE_PROTOCOL_GUID = {
    0x5b1b31a1, 0x9562, 0x11d2, {0x8e, 0x3f, 0x00, 0xa0, 0xc9, 0x69, 0x72, 0x3b}
};

typedef struct {
    uint32_t Version;
    uint32_t HorizontalResolution;
    uint32_t VerticalResolution;
    uint32_t PixelFormat;
    uint32_t RedMask;
    uint32_t GreenMask;
    uint32_t BlueMask;
    uint32_t ReservedMask;
    uint32_t PixelsPerScanLine;
} EFI_GRAPHICS_OUTPUT_MODE_INFORMATION;

typedef struct {
    uint32_t MaxMode;
    uint32_t Mode;
    EFI_GRAPHICS_OUTPUT_MODE_INFORMATION *Info;
    UINTN SizeOfInfo;
    uint64_t FrameBufferBase;
    UINTN FrameBufferSize;
} EFI_GRAPHICS_OUTPUT_PROTOCOL_MODE;

typedef struct _EFI_GRAPHICS_OUTPUT_PROTOCOL {
    void *QueryMode;
    EFI_STATUS (*SetMode)(struct _EFI_GRAPHICS_OUTPUT_PROTOCOL *This, uint32_t ModeNumber);
    void *Blt;
    EFI_GRAPHICS_OUTPUT_PROTOCOL_MODE *Mode;
} EFI_GRAPHICS_OUTPUT_PROTOCOL;

typedef EFI_STATUS (*EFI_GOP_QUERY_MODE)(EFI_GRAPHICS_OUTPUT_PROTOCOL*, uint32_t, UINTN*, EFI_GRAPHICS_OUTPUT_MODE_INFORMATION**);

typedef struct _EFI_BOOT_SERVICES {
    uint8_t Hdr[24];
    void *RaiseTPL;
    void *RestoreTPL;
    void *AllocatePages;
    void *FreePages;
    void *GetMemoryMap;
    void *AllocatePool;
    void *FreePool;
    void *CreateEvent;
    void *SetTimer;
    void *WaitForEvent;
    void *SignalEvent;
    void *CloseEvent;
    void *CheckEvent;
    void *InstallProtocolInterface;
    void *ReinstallProtocolInterface;
    void *UninstallProtocolInterface;
    void *HandleProtocol;
    void *Reserved;
    void *RegisterProtocolNotify;
    void *LocateHandle;
    void *LocateDevicePath;
    void *InstallConfigurationTable;
    void *LoadImage;
    void *StartImage;
    void *Exit;
    void *UnloadImage;
    void *ExitBootServices;
    void *GetNextMonotonicCount;
    void *Stall;
    void *SetWatchdogTimer;
    void *ConnectController;
    void *DisconnectController;
    void *OpenProtocol;
    void *CloseProtocol;
    void *OpenProtocolInformation;
    void *ProtocolsPerHandle;
    void *LocateHandleBuffer;
    EFI_STATUS (*LocateProtocol)(const EFI_GUID*, void*, void**);
} EFI_BOOT_SERVICES;

typedef struct {
    EFI_GUID VendorGuid;
    void *VendorTable;
} EFI_CONFIGURATION_TABLE;

typedef struct {
    uint8_t Hdr[24];
    CHAR16 *FirmwareVendor;
    uint32_t FirmwareRevision;
    EFI_HANDLE ConsoleInHandle;
    void *ConIn;
    EFI_HANDLE ConsoleOutHandle;
    void *ConOut;
    EFI_HANDLE StandardErrorHandle;
    void *StdErr;
    void *RuntimeServices;
    EFI_BOOT_SERVICES *BootServices;
    UINTN NumberOfTableEntries;
    EFI_CONFIGURATION_TABLE *ConfigurationTable;
} EFI_SYSTEM_TABLE;

typedef struct _EFI_LOADED_IMAGE_PROTOCOL {
    uint32_t Revision;
    EFI_HANDLE ParentHandle;
    EFI_SYSTEM_TABLE *SystemTable;
    EFI_HANDLE DeviceHandle;
    void *FilePath;
    void *Reserved;
    uint32_t LoadOptionsSize;
    void *LoadOptions;
    void *ImageBase;
    uint64_t ImageSize;
    uint32_t ImageCodeType;
    uint32_t ImageDataType;
    EFI_STATUS (*Unload)(EFI_HANDLE ImageHandle);
} EFI_LOADED_IMAGE_PROTOCOL;

typedef EFI_STATUS (*EFI_HANDLE_PROTOCOL)(EFI_HANDLE, const EFI_GUID*, void**);
typedef EFI_STATUS (*EFI_ALLOCATE_PAGES)(uint32_t, uint32_t, UINTN, EFI_PHYSICAL_ADDRESS*);
typedef EFI_STATUS (*EFI_GET_MEMORY_MAP)(UINTN*, void*, UINTN*, UINTN*, uint32_t*);
typedef EFI_STATUS (*EFI_ALLOCATE_POOL)(uint32_t, UINTN, void**);
typedef EFI_STATUS (*EFI_FREE_POOL)(void*);

#include "uefi_exit_boot_services.h"

typedef struct {
    BakenBootInfo *boot_info;
    uint64_t stack_top;
    uint64_t post_context_address;
} BAKEN_CUTOVER_BRIDGE_CONTEXT;

static int guid_equal(const EFI_GUID *a, const EFI_GUID *b) {
    if (!a || !b || a->Data1 != b->Data1 || a->Data2 != b->Data2 || a->Data3 != b->Data3) return 0;
    for (UINTN i = 0; i < 8; ++i) if (a->Data4[i] != b->Data4[i]) return 0;
    return 1;
}

static void *find_acpi_rsdp(const EFI_SYSTEM_TABLE *st) {
    if (!st || !st->ConfigurationTable) return NULL;
    void *rsdp_10 = NULL;
    for (UINTN i = 0; i < st->NumberOfTableEntries; ++i) {
        const EFI_CONFIGURATION_TABLE *entry = &st->ConfigurationTable[i];
        if (guid_equal(&entry->VendorGuid, &EFI_ACPI_20_TABLE_GUID)) return entry->VendorTable;
        if (guid_equal(&entry->VendorGuid, &EFI_ACPI_10_TABLE_GUID)) rsdp_10 = entry->VendorTable;
    }
    return rsdp_10;
}

static EFI_STATUS reserve_page_table_arena(EFI_BOOT_SERVICES *bs,
                                           BakenBootInfo *boot_info) {
    if (!bs || !bs->AllocatePages || !boot_info) return EFI_INVALID_PARAMETER;

    EFI_ALLOCATE_PAGES allocate_pages = (EFI_ALLOCATE_PAGES)bs->AllocatePages;
    EFI_PHYSICAL_ADDRESS physical_base = 0;
    EFI_STATUS status = allocate_pages(
        ALLOCATE_ANY_PAGES,
        UEFI_LOADER_DATA,
        BAKEN_PAGE_TABLE_ARENA_PAGES,
        &physical_base
    );
    if (status != EFI_SUCCESS || physical_base == 0 || (physical_base & 0xFFFULL) != 0) {
        return status == EFI_SUCCESS ? EFI_OUT_OF_RESOURCES : status;
    }

    boot_info->page_table_arena_physical_base = physical_base;
    boot_info->page_table_arena_virtual_base = (void*)(uintptr_t)physical_base;
    boot_info->page_table_arena_page_count = BAKEN_PAGE_TABLE_ARENA_PAGES;
    boot_info->flags |= BAKEN_BOOT_INFO_FLAG_PAGE_TABLE_ARENA_VALID;
    return EFI_SUCCESS;
}

static EFI_STATUS capture_loaded_image(EFI_BOOT_SERVICES *bs,
                                       EFI_HANDLE image_handle,
                                       BakenBootInfo *boot_info) {
    if (!bs || !bs->HandleProtocol || !image_handle || !boot_info) return EFI_INVALID_PARAMETER;

    EFI_HANDLE_PROTOCOL handle_protocol = (EFI_HANDLE_PROTOCOL)bs->HandleProtocol;
    EFI_LOADED_IMAGE_PROTOCOL *loaded = NULL;
    EFI_STATUS status = handle_protocol(
        image_handle,
        &EFI_LOADED_IMAGE_PROTOCOL_GUID,
        (void**)&loaded
    );
    if (status != EFI_SUCCESS || !loaded || !loaded->ImageBase || loaded->ImageSize == 0) {
        return status == EFI_SUCCESS ? EFI_UNSUPPORTED : status;
    }

    /* O endereço físico real será revalidado contra o Memory Map final antes
     * de construir as page tables; estes campos preservam o alias de execução. */
    boot_info->loaded_image_physical_base = (uint64_t)(uintptr_t)loaded->ImageBase;
    boot_info->loaded_image_virtual_base = loaded->ImageBase;
    boot_info->loaded_image_size = loaded->ImageSize;
    boot_info->flags |= BAKEN_BOOT_INFO_FLAG_LOADED_IMAGE_VALID;
    return EFI_SUCCESS;
}

static EFI_STATUS reserve_transition_stack(EFI_BOOT_SERVICES *bs,
                                           BakenBootInfo *boot_info) {
    if (!bs || !bs->AllocatePages || !boot_info) return EFI_INVALID_PARAMETER;

    EFI_ALLOCATE_PAGES allocate_pages = (EFI_ALLOCATE_PAGES)bs->AllocatePages;
    EFI_PHYSICAL_ADDRESS physical_base = 0;
    EFI_STATUS status = allocate_pages(
        ALLOCATE_ANY_PAGES,
        UEFI_LOADER_DATA,
        BAKEN_TRANSITION_STACK_PAGES,
        &physical_base
    );
    if (status != EFI_SUCCESS || physical_base == 0 || (physical_base & 0xFFFULL) != 0) {
        return status == EFI_SUCCESS ? EFI_OUT_OF_RESOURCES : status;
    }

    boot_info->transition_stack_physical_base = physical_base;
    boot_info->transition_stack_virtual_base = (void*)(uintptr_t)physical_base;
    boot_info->transition_stack_page_count = BAKEN_TRANSITION_STACK_PAGES;
    boot_info->flags |= BAKEN_BOOT_INFO_FLAG_TRANSITION_STACK_VALID;
    return EFI_SUCCESS;
}

/* Snapshot inicial para inventário/diagnóstico do handoff v2. O corte real usa
 * BAKEN_FINAL_MEMORY_MAP, obtido novamente imediatamente antes de ExitBootServices. */
static EFI_STATUS capture_memory_map(EFI_BOOT_SERVICES *bs,
                                     void **out_map,
                                     UINTN *out_size,
                                     UINTN *out_descriptor_size,
                                     uint32_t *out_descriptor_version) {
    if (!bs || !bs->GetMemoryMap || !bs->AllocatePool || !out_map || !out_size ||
        !out_descriptor_size || !out_descriptor_version) return EFI_INVALID_PARAMETER;

    EFI_GET_MEMORY_MAP get_map = (EFI_GET_MEMORY_MAP)bs->GetMemoryMap;
    EFI_ALLOCATE_POOL allocate_pool = (EFI_ALLOCATE_POOL)bs->AllocatePool;
    EFI_FREE_POOL free_pool = (EFI_FREE_POOL)bs->FreePool;

    UINTN size = 0;
    UINTN map_key = 0;
    UINTN descriptor_size = 0;
    uint32_t descriptor_version = 0;
    EFI_STATUS status = get_map(&size, NULL, &map_key, &descriptor_size, &descriptor_version);
    if (status != EFI_BUFFER_TOO_SMALL || descriptor_size == 0) return status;

    UINTN capacity = size + (descriptor_size * 16U) + 4096U;
    void *map = NULL;
    status = allocate_pool(UEFI_LOADER_DATA, capacity, &map);
    if (status != EFI_SUCCESS || !map) return status == EFI_SUCCESS ? EFI_OUT_OF_RESOURCES : status;

    size = capacity;
    status = get_map(&size, map, &map_key, &descriptor_size, &descriptor_version);
    if (status != EFI_SUCCESS) {
        if (free_pool) (void)free_pool(map);
        return status;
    }

    *out_map = map;
    *out_size = size;
    *out_descriptor_size = descriptor_size;
    *out_descriptor_version = descriptor_version;
    return EFI_SUCCESS;
}

static void choose_high_density_gop_mode(EFI_GRAPHICS_OUTPUT_PROTOCOL *gop,
                                         EFI_BOOT_SERVICES *bs) {
    if (!gop || !gop->Mode || !gop->Mode->Info || !gop->QueryMode || !gop->SetMode) return;
    EFI_GOP_QUERY_MODE query = (EFI_GOP_QUERY_MODE)gop->QueryMode;
    uint32_t best_mode = gop->Mode->Mode;
    uint64_t best_score = 0;
    uint8_t found = 0;

    for (uint32_t mode = 0; mode < gop->Mode->MaxMode; ++mode) {
        UINTN info_size = 0;
        EFI_GRAPHICS_OUTPUT_MODE_INFORMATION *info = NULL;
        if (query(gop, mode, &info_size, &info) != EFI_SUCCESS || !info) continue;

        uint64_t area = (uint64_t)info->HorizontalResolution * info->VerticalResolution;
        uint64_t score = area;
        if ((info->HorizontalResolution * 9 == info->VerticalResolution * 16) ||
            (info->HorizontalResolution * 10 == info->VerticalResolution * 16)) score += 5000000ULL;
        if (info->HorizontalResolution == 1920 && info->VerticalResolution == 1080) score += 15000000ULL;

        if (info->PixelFormat == PIXEL_BLUE_GREEN_RED_RESERVED_8BIT_PER_COLOR &&
            info->HorizontalResolution <= 1920 && info->VerticalResolution <= 1200 &&
            score >= best_score) {
            best_mode = mode;
            best_score = score;
            found = 1;
        }
        if (bs && bs->FreePool) ((EFI_FREE_POOL)bs->FreePool)(info);
    }
    if (found && best_mode != gop->Mode->Mode) (void)gop->SetMode(gop, best_mode);
}

/* Callback estritamente pré-exit: não recebe EFI_BOOT_SERVICES e não chama
 * firmware. Ela reconstrói as page tables a partir do Memory Map que gerou o
 * MapKey da tentativa corrente e materializa o PostCutoverContext. */
static EFI_STATUS baken_prepare_cutover_from_final_map(
    const BAKEN_FINAL_MEMORY_MAP *state,
    void *opaque_context
) {
    BAKEN_CUTOVER_BRIDGE_CONTEXT *bridge =
        (BAKEN_CUTOVER_BRIDGE_CONTEXT*)opaque_context;
    if (!state || !bridge || !bridge->boot_info) return EFI_INVALID_PARAMETER;

    BakenBootInfo *boot_info = bridge->boot_info;
    uint64_t map_physical = baken_final_map_physical_address(
        state, (uint64_t)(uintptr_t)state->memory_map);
    uint64_t image_physical = baken_final_map_physical_address(
        state, (uint64_t)(uintptr_t)boot_info->loaded_image_virtual_base);
    if (map_physical == 0 || image_physical == 0) return EFI_ABORTED;

    uint64_t acpi_physical = 0;
    if (boot_info->acpi_rsdp) {
        acpi_physical = baken_final_map_physical_address(
            state, (uint64_t)(uintptr_t)boot_info->acpi_rsdp);
        if (acpi_physical == 0) return EFI_ABORTED;
    }

    CutoverPrepareInput input = {0};
    input.memory_map_base = (const uint8_t*)state->memory_map;
    input.memory_map_size = state->memory_map_size;
    input.descriptor_size = state->descriptor_size;
    input.arena_physical_base = boot_info->page_table_arena_physical_base;
    input.arena_virtual_base = (uint64_t)(uintptr_t)boot_info->page_table_arena_virtual_base;
    input.arena_page_count = boot_info->page_table_arena_page_count;
    input.image_physical_base = image_physical;
    input.image_virtual_base = (uint64_t)(uintptr_t)boot_info->loaded_image_virtual_base;
    input.image_size = boot_info->loaded_image_size;
    input.framebuffer_physical_base = (uint64_t)(uintptr_t)boot_info->framebuffer_base;
    input.framebuffer_size = boot_info->framebuffer_size;
    input.stack_physical_base = boot_info->transition_stack_physical_base;
    input.stack_virtual_base = (uint64_t)(uintptr_t)boot_info->transition_stack_virtual_base;
    input.stack_page_count = boot_info->transition_stack_page_count;

    CutoverPrepareResult prepared = cutover_prepare(&input);
    if (!prepared.valid || prepared.root_physical == 0 ||
        prepared.context_virtual_base == 0 || prepared.stack_top == 0) {
        return EFI_ABORTED;
    }

    PostCutoverContext *post =
        (PostCutoverContext*)(uintptr_t)prepared.context_virtual_base;
    *post = (PostCutoverContext){0};
    post->root_physical = prepared.root_physical;
    post->stack_top = prepared.stack_top;
    post->framebuffer_base = (uint64_t)(uintptr_t)boot_info->framebuffer_base;
    post->framebuffer_size = boot_info->framebuffer_size;
    post->screen_width = boot_info->screen_width;
    post->screen_height = boot_info->screen_height;
    post->pixels_per_scanline = boot_info->pixels_per_scanline;
    post->memory_map_base = map_physical;
    post->memory_map_size = state->memory_map_size;
    post->memory_descriptor_size = state->descriptor_size;
    post->acpi_rsdp = acpi_physical;
    // A arena de tabelas já existe antes do mapa final. O runtime pós-exit a
    // reabre pelo direct map, sem solicitar memória ao firmware encerrado.
    post->page_table_arena_physical_base = boot_info->page_table_arena_physical_base;
    post->page_table_arena_page_count = boot_info->page_table_arena_page_count;
    post->page_table_pages_used = prepared.table_pages_used;
    post->valid = true;

    bridge->stack_top = prepared.stack_top;
    bridge->post_context_address = prepared.context_virtual_base;
    return EFI_SUCCESS;
}

EFI_STATUS efi_main(EFI_HANDLE ImageHandle, EFI_SYSTEM_TABLE *SystemTable) {
    if (!SystemTable || !SystemTable->BootServices) return EFI_INVALID_PARAMETER;

    EFI_BOOT_SERVICES *bs = SystemTable->BootServices;
    if (bs->SetWatchdogTimer) {
        ((EFI_STATUS (*)(UINTN, uint64_t, UINTN, CHAR16*))bs->SetWatchdogTimer)(0, 0, 0, NULL);
    }

    EFI_GRAPHICS_OUTPUT_PROTOCOL *gop = NULL;
    if (bs->LocateProtocol) {
        (void)bs->LocateProtocol(&EFI_GRAPHICS_OUTPUT_PROTOCOL_GUID, NULL, (void**)&gop);
    }
    choose_high_density_gop_mode(gop, bs);

    if (!gop || !gop->Mode || !gop->Mode->Info || !gop->Mode->FrameBufferBase ||
        gop->Mode->Info->PixelFormat != PIXEL_BLUE_GREEN_RED_RESERVED_8BIT_PER_COLOR ||
        gop->Mode->Info->PixelsPerScanLine < gop->Mode->Info->HorizontalResolution) return EFI_UNSUPPORTED;

    BakenBootInfo boot_info = {0};
    boot_info.framebuffer_base = (uint32_t*)gop->Mode->FrameBufferBase;
    boot_info.framebuffer_size = gop->Mode->FrameBufferSize;
    boot_info.screen_width = gop->Mode->Info->HorizontalResolution;
    boot_info.screen_height = gop->Mode->Info->VerticalResolution;
    boot_info.pixels_per_scanline = gop->Mode->Info->PixelsPerScanLine;

    boot_info.version = BAKEN_BOOT_INFO_VERSION;
    boot_info.struct_size = (uint32_t)sizeof(BakenBootInfo);
    boot_info.flags = 0;
    boot_info.pixel_format = gop->Mode->Info->PixelFormat;
    boot_info.acpi_rsdp = find_acpi_rsdp(SystemTable);
    if (boot_info.acpi_rsdp) boot_info.flags |= BAKEN_BOOT_INFO_FLAG_ACPI_RSDP_VALID;

    /* Toda memória que o cutover usa é reservada antes do mapa final. */
    if (reserve_page_table_arena(bs, &boot_info) != EFI_SUCCESS) {
        return EFI_OUT_OF_RESOURCES;
    }
    if (capture_loaded_image(bs, ImageHandle, &boot_info) != EFI_SUCCESS) {
        return EFI_UNSUPPORTED;
    }
    if (reserve_transition_stack(bs, &boot_info) != EFI_SUCCESS) {
        return EFI_OUT_OF_RESOURCES;
    }

    /* Snapshot v2 inicial: preservado para auditoria/compatibilidade do contrato.
     * O callback de ExitBootServices usa outro mapa, final e com MapKey atual. */
    UINTN map_size = 0;
    UINTN descriptor_size = 0;
    uint32_t descriptor_version = 0;
    void *memory_map = NULL;
    if (capture_memory_map(bs, &memory_map, &map_size, &descriptor_size, &descriptor_version) == EFI_SUCCESS) {
        boot_info.memory_map_base = memory_map;
        boot_info.memory_map_size = map_size;
        boot_info.memory_descriptor_size = descriptor_size;
        boot_info.memory_descriptor_version = descriptor_version;
        boot_info.flags |= BAKEN_BOOT_INFO_FLAG_MEMORY_MAP_VALID;
    }

    /* Input e armazenamento são responsabilidade dos drivers nativos Baken.
     * O loader não descobre nem transporta Pointer Protocol ou Block I/O. */

    BAKEN_FINAL_MEMORY_MAP final_map = {0};
    BAKEN_CUTOVER_BRIDGE_CONTEXT bridge = {0};
    bridge.boot_info = &boot_info;

    EFI_STATUS status = baken_exit_boot_services_final(
        ImageHandle,
        bs,
        &final_map,
        baken_prepare_cutover_from_final_map,
        &bridge
    );
    if (status != EFI_SUCCESS) return status;

    /* Boot Services terminou. Daqui em diante é proibido tocar em `bs`,
     * SystemTable, protocolos UEFI ou no snapshot legado. Troca a stack e a
     * continuação Sotlas assume CR3/GDT/TSS/IDT. Esta chamada não retorna. */
    x86_stack_switch_to_post_cutover_raw(
        bridge.stack_top,
        bridge.post_context_address
    );

    for (;;) {
        __asm__ __volatile__("cli; hlt");
    }
}
