/*
 * Baken OS — UEFI Hardware Bootloader & Handoff Loader (x86_64)
 * Papel: Diálogo com firmware UEFI, ativação GOP Framebuffer, Memory Map e Handoff direto para o Microkernel.
 * ZERO código de UI no bootloader (Arquitetura Modular Nativa).
 */

#include <stdint.h>
#include <stddef.h>
#include "baken_boot_info.h"

typedef uint16_t CHAR16;
typedef uint64_t UINTN;
typedef void* EFI_HANDLE;
typedef UINTN EFI_STATUS;
#define EFI_SUCCESS 0
#define EFI_ERROR(code) (0x8000000000000000ULL | (code))
#define EFI_INVALID_PARAMETER EFI_ERROR(2)
#define EFI_UNSUPPORTED EFI_ERROR(3)
#define EFI_ABORTED EFI_ERROR(21)

typedef struct {
    uint32_t Data1;
    uint16_t Data2;
    uint16_t Data3;
    uint8_t  Data4[8];
} EFI_GUID;

static EFI_GUID EFI_GRAPHICS_OUTPUT_PROTOCOL_GUID = {
    0x9042a9de, 0x23dc, 0x4a38, {0x96, 0xfb, 0x7a, 0xde, 0xd0, 0x80, 0x51, 0x6a}
};

static EFI_GUID EFI_ACPI_20_TABLE_GUID = {
    0x8868e871, 0xe4f1, 0x11d3, {0xbc, 0x22, 0x00, 0x80, 0xc7, 0x3c, 0x88, 0x81}
};

static EFI_GUID EFI_ACPI_10_TABLE_GUID = {
    0xeb9d2d30, 0x2d88, 0x11d3, {0x9a, 0x16, 0x00, 0x90, 0x27, 0x3f, 0xc1, 0x4d}
};

typedef struct {
    uint32_t Version;
    uint32_t HorizontalResolution;
    uint32_t VerticalResolution;
    uint32_t PixelFormat;
    uint32_t RedMask;
    uint32_t GreenMask;
    uint32_t BlueMask;
    uint32_t ReservedMask;
    uint32_t PixelsPerScanLine;
} EFI_GRAPHICS_OUTPUT_MODE_INFORMATION;

/* O compositor usa pixels 0x00RRGGBB em memória little-endian, isto é,
 * PixelBlueGreenRedReserved8BitPerColor no GOP. Outros formatos exigem um
 * conversor no compositor e não podem ser aceitos silenciosamente. */
#define PIXEL_BLUE_GREEN_RED_RESERVED_8BIT_PER_COLOR 1U

typedef struct {
    uint32_t MaxMode;
    uint32_t Mode;
    EFI_GRAPHICS_OUTPUT_MODE_INFORMATION *Info;
    UINTN SizeOfInfo;
    uint64_t FrameBufferBase;
    UINTN FrameBufferSize;
} EFI_GRAPHICS_OUTPUT_PROTOCOL_MODE;

typedef struct _EFI_GRAPHICS_OUTPUT_PROTOCOL {
    void *QueryMode;
    EFI_STATUS (*SetMode)(struct _EFI_GRAPHICS_OUTPUT_PROTOCOL *This, uint32_t ModeNumber);
    void *Blt;
    EFI_GRAPHICS_OUTPUT_PROTOCOL_MODE *Mode;
} EFI_GRAPHICS_OUTPUT_PROTOCOL;

typedef EFI_STATUS (*EFI_GOP_QUERY_MODE)(EFI_GRAPHICS_OUTPUT_PROTOCOL *This,
                                         uint32_t ModeNumber, UINTN *SizeOfInfo,
                                         EFI_GRAPHICS_OUTPUT_MODE_INFORMATION **Info);

typedef struct _EFI_BOOT_SERVICES {
    uint8_t Hdr[24];
    void *RaiseTPL;
    void *RestoreTPL;
    void *AllocatePages;
    void *FreePages;
    void *GetMemoryMap;
    void *AllocatePool;
    void *FreePool;
    void *CreateEvent;
    void *SetTimer;
    void *WaitForEvent;
    void *SignalEvent;
    void *CloseEvent;
    void *CheckEvent;
    void *InstallProtocolInterface;
    void *ReinstallProtocolInterface;
    void *UninstallProtocolInterface;
    void *HandleProtocol;
    void *Reserved;
    void *RegisterProtocolNotify;
    void *LocateHandle;
    void *LocateDevicePath;
    void *InstallConfigurationTable;
    void *LoadImage;
    void *StartImage;
    void *Exit;
    void *UnloadImage;
    void *ExitBootServices;
    void *GetNextMonotonicCount;
    void *Stall;
    void *SetWatchdogTimer;
    void *ConnectController;
    void *DisconnectController;
    void *OpenProtocol;
    void *CloseProtocol;
    void *OpenProtocolInformation;
    void *ProtocolsPerHandle;
    void *LocateHandleBuffer;
    EFI_STATUS (*LocateProtocol)(const EFI_GUID *Protocol, void *Registration, void **Interface);
} EFI_BOOT_SERVICES;

typedef struct {
    EFI_GUID VendorGuid;
    void *VendorTable;
} EFI_CONFIGURATION_TABLE;

typedef struct {
    uint8_t Hdr[24];
    CHAR16 *FirmwareVendor;
    uint32_t FirmwareRevision;
    EFI_HANDLE ConsoleInHandle;
    void *ConIn;
    EFI_HANDLE ConsoleOutHandle;
    void *ConOut;
    EFI_HANDLE StandardErrorHandle;
    void *StdErr;
    void *RuntimeServices;
    EFI_BOOT_SERVICES *BootServices;
    UINTN NumberOfTableEntries;
    EFI_CONFIGURATION_TABLE *ConfigurationTable;
} EFI_SYSTEM_TABLE;

static EFI_GUID EFI_SIMPLE_POINTER_PROTOCOL_GUID = {
    0x31878c87, 0x0b75, 0x11d5, {0x9a, 0x4f, 0x00, 0x90, 0x27, 0x3f, 0xc1, 0x4d}
};

static EFI_GUID EFI_ABSOLUTE_POINTER_PROTOCOL_GUID = {
    0x8d59d32b, 0xc655, 0x4ae9, {0x9b, 0x15, 0xf2, 0x59, 0x04, 0x99, 0x2a, 0x43}
};

/* UEFI Block I/O é a ponte temporária de persistência enquanto o driver Sotlas
 * NVMe/AHCI é migrado. O kernel nunca recebe um caminho de host, só esta API
 * de blocos validada pelo firmware. */
static EFI_GUID EFI_BLOCK_IO_PROTOCOL_GUID = {
    0x964e5b21, 0x6459, 0x11d2, {0x8e, 0x39, 0x00, 0xa0, 0xc9, 0x69, 0x72, 0x3b}
};

typedef struct {
    uint32_t MediaId;
    uint8_t RemovableMedia, MediaPresent, LogicalPartition, ReadOnly, WriteCaching;
    uint32_t BlockSize, IoAlign;
    uint64_t LastBlock, LowestAlignedLba;
    uint32_t LogicalBlocksPerPhysicalBlock, OptimalTransferLengthGranularity;
} EFI_BLOCK_IO_MEDIA;

typedef struct _EFI_BLOCK_IO_PROTOCOL {
    uint64_t Revision;
    EFI_BLOCK_IO_MEDIA *Media;
    EFI_STATUS (*Reset)(struct _EFI_BLOCK_IO_PROTOCOL*, uint8_t);
    EFI_STATUS (*ReadBlocks)(struct _EFI_BLOCK_IO_PROTOCOL*, uint32_t, uint64_t, UINTN, void*);
    EFI_STATUS (*WriteBlocks)(struct _EFI_BLOCK_IO_PROTOCOL*, uint32_t, uint64_t, UINTN, void*);
    EFI_STATUS (*FlushBlocks)(struct _EFI_BLOCK_IO_PROTOCOL*);
} EFI_BLOCK_IO_PROTOCOL;

typedef EFI_STATUS (*EFI_HANDLE_PROTOCOL)(EFI_HANDLE Handle, const EFI_GUID *Protocol, void **Interface);
typedef EFI_STATUS (*EFI_LOCATE_HANDLE_BUFFER)(uint32_t SearchType, const EFI_GUID *Protocol,
                                                void *SearchKey, UINTN *NoHandles, EFI_HANDLE **Buffer);
#define BY_PROTOCOL 2U

/* Escolhe apenas um segundo disco bruto, presente e gravável. A mídia usada
 * para o boot permanece fora do alvo; a rotina de instalação recebe
 * este ponteiro explicitamente, nunca um nome de unidade do Windows. */
static EFI_BLOCK_IO_PROTOCOL *find_install_target(EFI_BOOT_SERVICES *bs,
                                                   EFI_BLOCK_IO_PROTOCOL *boot_media) {
    if (!bs || !bs->LocateHandleBuffer || !bs->HandleProtocol) return NULL;
    EFI_HANDLE *handles = NULL;
    UINTN count = 0;
    EFI_LOCATE_HANDLE_BUFFER locate = (EFI_LOCATE_HANDLE_BUFFER)bs->LocateHandleBuffer;
    EFI_HANDLE_PROTOCOL handle_protocol = (EFI_HANDLE_PROTOCOL)bs->HandleProtocol;
    if (locate(BY_PROTOCOL, &EFI_BLOCK_IO_PROTOCOL_GUID, NULL, &count, &handles) != EFI_SUCCESS) return NULL;
    EFI_BLOCK_IO_PROTOCOL *target = NULL;
    for (UINTN i = 0; i < count; ++i) {
        EFI_BLOCK_IO_PROTOCOL *candidate = NULL;
        if (handle_protocol(handles[i], &EFI_BLOCK_IO_PROTOCOL_GUID, (void**)&candidate) != EFI_SUCCESS ||
            !candidate || candidate == boot_media || !candidate->Media) continue;
        if (candidate->Media->MediaPresent && !candidate->Media->ReadOnly &&
            !candidate->Media->LogicalPartition && candidate->Media->BlockSize == 512 &&
            candidate->Media->LastBlock >= 131071ULL) {
            target = candidate;
            break;
        }
    }
    if (handles && bs->FreePool) ((EFI_STATUS (*)(void*))bs->FreePool)(handles);
    return target;
}

/* Localiza a tabela ACPI RSDP (versão 2.0 com fallback para 1.0) */
static void *find_acpi_rsdp(const EFI_SYSTEM_TABLE *st) {
    if (!st || !st->ConfigurationTable) return NULL;
    void *rsdp_10 = NULL;
    for (UINTN i = 0; i < st->NumberOfTableEntries; ++i) {
        const EFI_CONFIGURATION_TABLE *entry = &st->ConfigurationTable[i];
        if (entry->VendorGuid.Data1 == EFI_ACPI_20_TABLE_GUID.Data1 &&
            entry->VendorGuid.Data2 == EFI_ACPI_20_TABLE_GUID.Data2 &&
            entry->VendorGuid.Data3 == EFI_ACPI_20_TABLE_GUID.Data3) {
            return entry->VendorTable;
        }
        if (entry->VendorGuid.Data1 == EFI_ACPI_10_TABLE_GUID.Data1 &&
            entry->VendorGuid.Data2 == EFI_ACPI_10_TABLE_GUID.Data2 &&
            entry->VendorGuid.Data3 == EFI_ACPI_10_TABLE_GUID.Data3) {
            rsdp_10 = entry->VendorTable;
        }
    }
    return rsdp_10;
}

static int is_baken_boot_media(EFI_BLOCK_IO_PROTOCOL *io) {
    uint8_t sector[512];
    if (!io || !io->Media || !io->ReadBlocks || io->Media->BlockSize != 512 ||
        io->Media->LastBlock < 4096 || io->ReadBlocks(io, io->Media->MediaId, 0, 512, sector) != EFI_SUCCESS) return 0;
    
    /* MBR híbrido / partição com assinatura Baken */
    uint32_t start = (uint32_t)sector[454] | ((uint32_t)sector[455]<<8) | ((uint32_t)sector[456]<<16) | ((uint32_t)sector[457]<<24);
    if (sector[450] == 0xEF && start != 0 &&
        io->ReadBlocks(io, io->Media->MediaId, start, 512, sector) == EFI_SUCCESS) {
        if (sector[3]=='B' && sector[4]=='A' && sector[5]=='K' && sector[6]=='E' && sector[7]=='N') return 1;
    }

    /* A instalação final usa GPT/FAT32, portanto o disco bruto também deve
     * ser reconhecido como mídia de origem. Isto é essencial para o kernel
     * acessar a partição Baken Data por LBA absoluto, e evita montar apenas
     * a ESP lógica encontrada pelo firmware. */
    if (io->ReadBlocks(io, io->Media->MediaId, 1, 512, sector) != EFI_SUCCESS ||
        sector[0]!='E' || sector[1]!='F' || sector[2]!='I' || sector[3]!=' ' ||
        sector[4]!='P' || sector[5]!='A' || sector[6]!='R' || sector[7]!='T') return 0;
    
    /* GUID de tipo Baken Data: 7F3C7258-2F1C-4E03-BF20-42414B454E31. */
    static const uint8_t data_guid[16] = {
        0x58, 0x72, 0x3C, 0x7F, 0x1C, 0x2F, 0x03, 0x4E, 0xBF, 0x20, 0x42, 0x41, 0x4B, 0x45, 0x4E, 0x31
    };

    /* Varredura completa da tabela de partições GPT (LBAs 2 a 33 = até 128 partições) */
    for (uint64_t lba = 2; lba <= 33 && lba <= io->Media->LastBlock; ++lba) {
        if (io->ReadBlocks(io, io->Media->MediaId, lba, 512, sector) != EFI_SUCCESS) break;
        for (UINTN off = 0; off + 16 <= 512; off += 128) {
            UINTN i = 0;
            for (; i < 16 && sector[off + i] == data_guid[i]; ++i) {}
            if (i == 16) return 1;
        }
    }
    return 0;
}

static EFI_BLOCK_IO_PROTOCOL *find_boot_media(EFI_BOOT_SERVICES *bs, EFI_BLOCK_IO_PROTOCOL *fallback) {
    if (!bs || !bs->LocateHandleBuffer || !bs->HandleProtocol) return fallback;
    EFI_HANDLE *handles = NULL;
    UINTN count = 0;
    EFI_BLOCK_IO_PROTOCOL *result = fallback;
    EFI_LOCATE_HANDLE_BUFFER locate = (EFI_LOCATE_HANDLE_BUFFER)bs->LocateHandleBuffer;
    EFI_HANDLE_PROTOCOL hp = (EFI_HANDLE_PROTOCOL)bs->HandleProtocol;
    if (locate(BY_PROTOCOL, &EFI_BLOCK_IO_PROTOCOL_GUID, NULL, &count, &handles) == EFI_SUCCESS) {
        for (UINTN i = 0; i < count; ++i) {
            EFI_BLOCK_IO_PROTOCOL *candidate = NULL;
            if (hp(handles[i], &EFI_BLOCK_IO_PROTOCOL_GUID, (void**)&candidate) == EFI_SUCCESS &&
                candidate && candidate->Media && !candidate->Media->LogicalPartition &&
                is_baken_boot_media(candidate)) {
                result = candidate;
                break;
            }
        }
        if (handles && bs->FreePool) ((EFI_STATUS (*)(void*))bs->FreePool)(handles);
    }
    return result;
}

/* O GOP é a fonte de verdade para a resolução da VM ou do painel. Selecionamos
 * o melhor modo nativo de alta densidade no formato 32-bit BGRX (0x00RRGGBB). */
static void choose_high_density_gop_mode(EFI_GRAPHICS_OUTPUT_PROTOCOL *gop,
                                         EFI_BOOT_SERVICES *bs) {
    if (!gop || !gop->Mode || !gop->Mode->Info || !gop->QueryMode || !gop->SetMode) return;
    EFI_GOP_QUERY_MODE query = (EFI_GOP_QUERY_MODE)gop->QueryMode;
    uint32_t best_mode = gop->Mode->Mode;
    uint64_t best_area = 0;
    uint8_t found_budget_mode = 0;

    for (uint32_t mode = 0; mode < gop->Mode->MaxMode; ++mode) {
        UINTN info_size = 0;
        EFI_GRAPHICS_OUTPUT_MODE_INFORMATION *info = NULL;
        if (query(gop, mode, &info_size, &info) != EFI_SUCCESS || !info) continue;

        uint64_t area = (uint64_t)info->HorizontalResolution * info->VerticalResolution;
        uint64_t score = area;
        // Bônus para telas Widescreen modernas (16:9 e 16:10), eliminando barras pretas
        if ((info->HorizontalResolution * 9 == info->VerticalResolution * 16) ||
            (info->HorizontalResolution * 10 == info->VerticalResolution * 16)) {
            score += 5000000ULL;
        }
        if (info->HorizontalResolution == 1920 && info->VerticalResolution == 1080) {
            score += 15000000ULL;
        }

        if (info->PixelFormat == PIXEL_BLUE_GREEN_RED_RESERVED_8BIT_PER_COLOR &&
            info->HorizontalResolution <= 1920 && info->VerticalResolution <= 1200 &&
            score >= best_area) {
            best_mode = mode;
            best_area = score;
            found_budget_mode = 1;
        }
        if (bs && bs->FreePool) ((EFI_STATUS (*)(void*))bs->FreePool)(info);
    }
    if (found_budget_mode && best_mode != gop->Mode->Mode) (void)gop->SetMode(gop, best_mode);
}

static void *find_pointer_protocol(EFI_BOOT_SERVICES *bs) {
    if (!bs) return NULL;
    void *ptr = NULL;
    if (bs->LocateProtocol) {
        if (bs->LocateProtocol(&EFI_SIMPLE_POINTER_PROTOCOL_GUID, NULL, &ptr) == EFI_SUCCESS && ptr) return ptr;
        if (bs->LocateProtocol(&EFI_ABSOLUTE_POINTER_PROTOCOL_GUID, NULL, &ptr) == EFI_SUCCESS && ptr) return ptr;
    }
    if (bs->LocateHandleBuffer && bs->HandleProtocol) {
        EFI_HANDLE *handles = NULL;
        UINTN count = 0;
        EFI_LOCATE_HANDLE_BUFFER locate = (EFI_LOCATE_HANDLE_BUFFER)bs->LocateHandleBuffer;
        EFI_HANDLE_PROTOCOL hp = (EFI_HANDLE_PROTOCOL)bs->HandleProtocol;
        if (locate(BY_PROTOCOL, &EFI_SIMPLE_POINTER_PROTOCOL_GUID, NULL, &count, &handles) == EFI_SUCCESS && handles) {
            for (UINTN i = 0; i < count; ++i) {
                if (hp(handles[i], &EFI_SIMPLE_POINTER_PROTOCOL_GUID, &ptr) == EFI_SUCCESS && ptr) break;
            }
            if (handles && bs->FreePool) ((EFI_STATUS (*)(void*))bs->FreePool)(handles);
            if (ptr) return ptr;
        }
        if (locate(BY_PROTOCOL, &EFI_ABSOLUTE_POINTER_PROTOCOL_GUID, NULL, &count, &handles) == EFI_SUCCESS && handles) {
            for (UINTN i = 0; i < count; ++i) {
                if (hp(handles[i], &EFI_ABSOLUTE_POINTER_PROTOCOL_GUID, &ptr) == EFI_SUCCESS && ptr) break;
            }
            if (handles && bs->FreePool) ((EFI_STATUS (*)(void*))bs->FreePool)(handles);
        }
    }
    return ptr;
}

// Declaração do Ponto de Entrada do Microkernel Baken OS
extern void baken_kernel_main(const BakenBootInfo *boot_info);

// Ponto de Entrada UEFI do Bootloader (BOOTX64.EFI)
EFI_STATUS efi_main(EFI_HANDLE ImageHandle, EFI_SYSTEM_TABLE *SystemTable) {
    (void)ImageHandle;
    if (!SystemTable || !SystemTable->BootServices) return EFI_INVALID_PARAMETER;

    EFI_BOOT_SERVICES *bs = SystemTable->BootServices;
    /* O runtime gráfico continua usando GOP e entrada UEFI. Desliga o watchdog
       padrão do firmware para que animações longas/OOBE não reiniciem a VM. */
    if (bs->SetWatchdogTimer) {
        ((EFI_STATUS (*)(UINTN, uint64_t, UINTN, CHAR16*))bs->SetWatchdogTimer)(0, 0, 0, NULL);
    }
    EFI_GRAPHICS_OUTPUT_PROTOCOL *gop = NULL;
    void *pointer = NULL;
    void *block_io = NULL;
    EFI_BLOCK_IO_PROTOCOL *install_target = NULL;

    // 1. Localiza o Protocolo Gráfico do Hardware (UEFI GOP) e ponteiros de entrada
    if (bs->LocateProtocol) {
        bs->LocateProtocol(&EFI_GRAPHICS_OUTPUT_PROTOCOL_GUID, NULL, (void**)&gop);
        bs->LocateProtocol(&EFI_BLOCK_IO_PROTOCOL_GUID, NULL, (void**)&block_io);
        block_io = find_boot_media(bs, (EFI_BLOCK_IO_PROTOCOL*)block_io);
        install_target = find_install_target(bs, (EFI_BLOCK_IO_PROTOCOL*)block_io);
    }
    pointer = find_pointer_protocol(bs);

    choose_high_density_gop_mode(gop, bs);

    // Validação estrita do frame de vídeo
    if (gop && gop->Mode && gop->Mode->Info && gop->Mode->FrameBufferBase &&
        gop->Mode->Info->PixelFormat == PIXEL_BLUE_GREEN_RED_RESERVED_8BIT_PER_COLOR &&
        gop->Mode->Info->PixelsPerScanLine >= gop->Mode->Info->HorizontalResolution) {
        
        // 2. Prepara o pacote BakenBootInfo com os parâmetros do hardware
        BakenBootInfo boot_info;
        boot_info.framebuffer_base    = (uint32_t*)gop->Mode->FrameBufferBase;
        boot_info.framebuffer_size    = gop->Mode->FrameBufferSize;
        boot_info.screen_width        = gop->Mode->Info->HorizontalResolution;
        boot_info.screen_height       = gop->Mode->Info->VerticalResolution;
        boot_info.pixels_per_scanline = gop->Mode->Info->PixelsPerScanLine;
        boot_info.memory_map_base     = NULL;
        boot_info.memory_map_size     = 0;
        boot_info.system_table        = SystemTable;
        boot_info.pointer_protocol    = pointer;
        boot_info.block_io_protocol   = block_io;
        boot_info.install_target_block_io_protocol = install_target;

        // Opcional: validação da tabela ACPI RSDP para inicialização de barramentos
        (void)find_acpi_rsdp(SystemTable);

        // 3. Handoff imediato para o Microkernel do Baken OS
        baken_kernel_main(&boot_info);
        
        // Um kernel gráfico não deve retornar. Se retornar, sinaliza falha ao firmware.
        return EFI_ABORTED;
    }

    return EFI_UNSUPPORTED;
}
